element autodown_editor {
    tag: "autodown_editor"
    category: "form"
    tier: "builtin_widget"
    aliases: ["autodowneditor"]
    backends: { web: "component", iced: "unknown", gpui: "unknown" }
    vue: { component: "AutoDownEditor", import: "@autodown/engine", npm: "@autodown/engine@^0.4.0" }
    props: [
        { name: "key", type: "string", description: "Stable state-storage identity (VM editor shell registry key)" }
        { name: "content", type: "union:string,state_ref", description: "Bound markdown document body" }
        { name: "final", type: "union:bool,state_ref", default: "true", description: "Streaming marker (editor treats document as final)" }
        { name: "can_edit", type: "bool", default: "true", description: "Whether the editor is interactive (vue arm: canEdit)" }
        { name: "show_actions", type: "bool", default: "true", description: "Show editor action bar (vue arm: showActions)" }
        { name: "oninput", type: "msg_ref", description: "Message on document edit (payload via autodown_editor_text(key) on VM)" }
        { name: "onchange", type: "msg_ref", description: "Alias of oninput" }
        { name: "class", type: "union:string,class_binding", description: "CSS class(es)" }
    ]
    allows_children: false
    description: "AutoDown block editor (plan 019 Phase 3 shell; @autodown/engine AutoDownEditor on vue, cosmic-text block buffers on VM)"
}

element avatar {
    tag: "avatar"
