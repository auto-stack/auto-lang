// AURA Schema —— Plan 435 P1:从生产代码提取生成(单一声明源)
//
// 本文件是 AutoUI 内置组件的唯一声明:tag/category/props 来自 schema.rs
// (唯一带类型 props 的来源);aliases 来自派发表臂组(行为等价)与分隔符
// 拼写变体;tier/backends 来自各生产表的成员资格(见围栏测试)。
// 官方/第三方 .at 组件(widget)不在此声明——它们由 ComponentRegistry 注册
// (P4);sub_widgets 字段为组件家族预留(P4 填充,web 家族已按 vue import
// 路径预填)。
//
// tier 语义:native_html=Web 原生直通(类比 HTML_TAGS);builtin_widget=
//   桌面(iced)有实现;web_component=shadcn 家族生成映射;
//   unclassified=P1 提取时尚无归属(待人工归类,P2 消除)。
// backends 语义:web=native|component|none;iced=full|partial|fallback|
//   unsupported|unknown(unknown=有实现但支持级未登记)|none;
//   gpui=unknown(P1 未盘点)。
//
// 再生成(修改生产表后):
//   SCHEMA_DRIFT_GENERATE_AT=1 cargo test -p auto-lang --test schema_drift
// 围栏会强制:生产表 tag ⊆ 本文件(tags ∪ aliases),新增组件必须重生成。
//
// 别名匹配策略(P2 校验器实现):tag 与 aliases 均按折叠键匹配
// (剥 `-`/`_` + 小写),如 alert-dialog-action ≡ alert_dialog_action。
// 依据:widgets-gallery 实际使用 kebab 形态,生产表登记 underscore/concat
// 形态,管线靠隐式归一弥合 —— schema 将该归一显式化为策略。


// ============ tier: builtin_widget ============

element article {
    tag: "article"
    category: "unknown"
    tier: "builtin_widget"
    aliases: ["Article"]
    backends: { web: "native", iced: "unknown", gpui: "unknown" }
    props: []
    allows_children: true
    description: "P1 extracted from production tables; props TBD"
}

