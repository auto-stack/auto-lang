    props: [
        { name: "label", type: "string", description: "Group header label" }
        { name: "collapsible", type: "bool", default: "false", description: "Header is clickable to fold/unfold (chevron indicator)" }
        { name: "open", type: "expr", description: "Fold state binding; defaults true. Unbound + collapsible uses built-in per-group state" }
        { name: "ontoggle", type: "msg_ref", description: "Message on header click (when bound); otherwise built-in state toggles" }
        { name: "indent", type: "bool", default: "false", description: "Indent member items (tree feel, pl-3)" }
        { name: "class", type: "union:string,class_binding", description: "CSS class(es)" }
    ]
    allows_children: true
    description: "Navigation group: label header + item column, optionally collapsible (Plan 482)"
}

element nav-item {
    tag: "nav-item"
    category: "navigation"
    tier: "builtin_widget"
    aliases: ["NavItem", "nav_item", "navitem"]
    backends: { web: "component", iced: "full", gpui: "unknown" }
    vue: { component: "NavItem", import: "@/components/ui/nav" }
    props: [
        { name: "to", type: "string", description: "Route address (router mode): vue RouterLink updates the hash URL; VM dispatches __navigate to __current_route. Wins over onclick when both given" }
        { name: "onclick", type: "msg_ref", description: "Click message (state mode) for store-driven switching" }
        { name: "active", type: "expr", description: "Selected-state override; with to: auto-detected (exact or prefix-segment match, exact: tightens)" }
        { name: "exact", type: "bool", default: "false", description: "Route auto-detection uses exact match only" }
        { name: "icon", type: "string", description: "Left icon: lucide name (svg both ends) or literal emoji text" }
        { name: "label", type: "string", description: "Primary text" }
        { name: "desc", type: "string", description: "Secondary line (two-line layout)" }
        { name: "badge", type: "string", description: "Right-side badge pill" }
        { name: "disabled", type: "bool", default: "false", description: "Grayed out, not clickable" }
        { name: "size", type: "one_of:sm,md,lg", default: "md", description: "md=h-9 single line; lg=py-[10px] two-line; sm=h-7" }
        { name: "class", type: "union:string,class_binding", description: "Extra classes appended after the built-in nav-item classes (escape hatch)" }
    ]
    allows_children: true
    description: "Navigation item with built-in hover/active/disabled states, icon/desc/badge slots (Plan 482); supersedes nav-link"
}

element nav-link {
    tag: "nav-link"
    category: "unknown"
    tier: "builtin_widget"
