/// Process-local image pipeline API (Plan 547).
///
/// Calls return opaque ticket/record values and never expose decoded pixels.
type ImageTicket {
    id str
    revision int
    state str
    uri str
}

type ImageStats {
    queued int
    running int
    completed int
    dropped int
    encoded_bytes int
    decoded_bytes int
}

pub fn queue(path str) ImageTicket;
pub fn open(ticket ImageTicket) ImageTicket;
pub fn scan(path str) []ImageTicket;
pub fn request(ticket ImageTicket, width int, height int) ImageTicket;
pub fn retain(ticket ImageTicket) ImageTicket;
pub fn release(ticket ImageTicket) void;
pub fn close(ticket ImageTicket) void;
pub fn stats() ImageStats;

/// Metadata-only viewer control plane.  Session ids are opaque strings; the
/// host keeps paths, ticket ownership, and decoded bytes outside Auto state.
pub fn open_session(root str) str;
pub fn snapshot(session str) str;
pub fn current_uri(session str) str;
pub fn names(session str) []str;
pub fn navigate(session str, delta int) str;
pub fn request_view(session str, index int, viewport_width int, viewport_height int, quality int) str;
pub fn close_session(session str) bool;
pub fn session_stats(session str) str;
