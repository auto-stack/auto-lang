type File {
    pub path str

    pub static fn open(path str) File;

    pub fn read_text() str;

    pub fn read_line() str;

    pub fn read_char() int;

    pub fn read_buf(buf str, size int) int;

    pub fn write_line(s str);

    pub fn flush();

    pub fn close();
}

pub fn say(msg str);

/// Read one line from standard input (strips trailing newline).
/// Hosted runs receive a finite request-local input stream; CLI callers use stdin.
#[vm]
pub fn read_line() str;

/// Read a line and return None at EOF; a blank line is Some("").
#[vm]
pub fn read_line_opt() Option<str>;
