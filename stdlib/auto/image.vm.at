/// VM declarations for the process-local image pipeline (Plan 547).
/// Implementations live in the auto-lang VM native registry.
#[vm]
fn queue(path str) ImageTicket

#[vm]
fn open(ticket ImageTicket) ImageTicket

#[vm]
fn scan(path str) []ImageTicket

#[vm]
fn request(ticket ImageTicket, width int, height int) ImageTicket

#[vm]
fn retain(ticket ImageTicket) ImageTicket

#[vm]
fn release(ticket ImageTicket) void

#[vm]
fn close(ticket ImageTicket) void

#[vm]
fn stats() ImageStats

#[vm]
fn open_session(root str) str

#[vm]
fn snapshot(session str) str

#[vm]
fn current_uri(session str) str

#[vm]
fn names(session str) []str

#[vm]
fn navigate(session str, delta int) str

#[vm]
fn request_view(session str, index int, viewport_width int, viewport_height int, quality int) str

#[vm]
fn close_session(session str) bool

#[vm]
fn session_stats(session str) str
