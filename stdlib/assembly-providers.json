    { "module": "io", "target": "c", "kind": "c-generated", "status": "supported", "locator": "stdlib/auto/io.c.at", "notes": "cmd_a2c_stdlib 逐文件生成 io.c/io.h/io.c.c/io.c.h；物理 ext 字段属 C 层" },

