// ACE system library — env module (PLAN-973 T-02). Legacy contracts:
// get "" when unset, set/remove 0/-1. Windows is fully live
// (GetEnvironmentVariableW/SetEnvironmentVariableW); Linux get parses the
// /proc/self/environ snapshot while set/remove are named-deferred to
// PLAN-1063 (no syscall for in-process environ mutation).

#in sys is current {
    Windows -> {
        use std.sysplat_win.pf_env_get_opt
        use std.sysplat_win.pf_env_set
        use std.sysplat_win.pf_env_remove
        use std.sysplat_win.pf_home_dir
        use std.sysplat_win.pf_local_data_dir
    }
    Linux -> {
        use std.sysplat_lnx.pf_env_get_opt
        use std.sysplat_lnx.pf_env_set
        use std.sysplat_lnx.pf_env_remove
        use std.sysplat_lnx.pf_home_dir
        use std.sysplat_lnx.pf_local_data_dir
    }
}

pub fn get(key Str) Str {
    var out = ""
    let r = pf_env_get_opt(key)
    is r {
        Some(v) -> { out = v }
        None -> {}
    }
    return out
}

pub fn get_or(key Str, default Str) Str {
    var out = default
    let r = pf_env_get_opt(key)
    is r {
        Some(v) -> { out = v }
        None -> {}
    }
    return out
}

pub fn home_dir() Str {
    return pf_home_dir()
}

pub fn local_data_dir() Str {
    return pf_local_data_dir()
}

pub fn set(key Str, value Str) int {
    return pf_env_set(key, value)
}

pub fn remove(key Str) int {
    return pf_env_remove(key)
}
