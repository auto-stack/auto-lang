// ---- env -------------------------------------------------------------------------

pub fn pf_env_set(name Str, value Str) int {
    let nregion = buf_alloc((name.len() * 2 + 2) * 2)
    if (nregion < 0) {
        return nregion
    }
    let vregion = buf_alloc((value.len() * 2 + 2) * 2)
    if (vregion <= 0) {
        let d33_buf_free = buf_free(nregion)
        return vregion
    }
    let n = stage_w16(name, nregion, 0)
    let v = stage_w16(value, vregion, 0)
    var r = -4
    if (n > 0) {
        r = env_set_w16(nregion, 0, n, vregion, 0, v)
    }
    let d34_buf_free = buf_free(nregion)
    let d35_buf_free = buf_free(vregion)
    return r
}

pub fn pf_env_remove(name Str) int {
    let nregion = buf_alloc((name.len() * 2 + 2) * 2)
    if (nregion < 0) {
        return nregion
    }
    let n = stage_w16(name, nregion, 0)
    var r = -4
    if (n > 0) {
        r = env_remove_w16(nregion, 0, n)
    }
    let d36_buf_free = buf_free(nregion)
    return r
}

// ---- clock / entropy ----------------------------------------------------------------

pub fn pf_now_ms() i64 {
    let lo = clock_unix_ms()
    let hi = clock_hi()
    return join64(hi, lo)
}

pub fn pf_mono_ms() i64 {
    let lo = clock_mono_ms()
    let hi = clock_hi()
    return join64(hi, lo)
}

pub fn pf_sleep_ms(ms int) int {
    return sleep_ms(ms)
}

// rand_fill(region, off, len) -> 0 or negative error (CSPRNG).
pub fn pf_rand_fill(region int, off int, len int) int {
    return rand_fill(region, off, len)
}

// ---- processes ------------------------------------------------------------------------

// pf_spawn_cps(cps, capture 0/1) -> process handle or negative error.
// The command line arrives as CODEPOINTS (ints) — the UTF-16 staging is
// the same put_scalar walk over the list.
pub fn pf_spawn_cps(cps List<int>, capture int) int {
    if cps.len() == 0 {
        return -4
    }
    let cap = (cps.len() + 2) * 2
    let region = buf_alloc(cap + 8)
    if (region < 0) {
        return region
    }
    let units = stage_cps(cps, 0, region, 0)
    if (units <= 0) {
        buf_free(region)
        return units
    }
    let ph = proc_spawn_w16(region, 0, units, capture)
    buf_free(region)
    return ph
}

fn stage_cps(cps List<int>, i int, region int, units int) int {
    if (i >= cps.len()) {
        return units
    }
    let stop = min_i(cps.len(), i + INNER())
    let staged = stage_cps_chunk(cps, i, stop, region, units)
    is staged {
        Some(next_units) -> {
            return stage_cps(cps, stop, region, next_units)
        }
        None -> {
            return -8
        }
    }
}

fn stage_cps_chunk(cps List<int>, i int, stop int, region int, units int) ?int {
    if (i >= stop) {
        return Some(units)
    }
    let cp = cps.get(i)
    let r = put_scalar(region, units * 2, cp)
    if (r != 0) {
        return None
    }
    return stage_cps_chunk(cps, i + 1, stop, region, units + utf16_len(cp))
}

pub fn pf_pipe_read(ph int, which int, region int, off int, cap int, timeout_ms int) int {
    return proc_pipe_read(ph, which, region, off, cap, timeout_ms)
}

pub fn pf_wait(ph int, timeout_ms int) int {
    return proc_wait(ph, timeout_ms)
}

pub fn pf_release(ph int) int {
    return proc_release(ph)
}

pub fn pf_exit(code int) int {
    return proc_exit(code)
}

pub fn pf_chdir(path Str) int {
    let cap = (path.len() * 2 + 2) * 2
    let region = buf_alloc(cap)
    if (region < 0) {
        return region
    }
    let n = stage_w16(path, region, 0)
    var r = -4
    if (n > 0) {
        r = proc_chdir_w16(region, 0, n)
    }
    let d43_buf_free = buf_free(region)
    return r
}

// ---- UTF-16LE decoding & D-02..D-05 platform implementations --------------------

pub fn decode_w16_region(region int, off int, n_units int) ?Str {
    if (n_units < 0) { return None }
    if (n_units == 0) { return Some("") }
    var bytes = List<int>.new()
    let t16 = ticks16()
    let t64 = ticks64()
    var i = 0
    var bad = false
    for a in t16 {
        if (i >= n_units || bad) { break }
        for b in t64 {
            if (i >= n_units || bad) { break }
            for c in t64 {
                if (i >= n_units || bad) { break }
                let pos = off + i * 2
                let b0 = mem_read_u8(region, pos)
                let b1 = mem_read_u8(region, pos + 1)
                if (b0 < 0 || b1 < 0) {
                    bad = true
                    break
                }
                let u = b0 + b1 * 256
                if (u < 128) {
                    bytes.push(u)
                    i = i + 1
                } else {
                    if (u < 2048) {
                        bytes.push(192 + u / 64)
                        bytes.push(128 + u % 64)
                        i = i + 1
                    } else {
                        if (u >= 55296 && u <= 56319) {
                            if (i + 1 >= n_units) {
                                bad = true
                                break
                            }
                            let c0 = mem_read_u8(region, pos + 2)
                            let c1 = mem_read_u8(region, pos + 3)
                            if (c0 < 0 || c1 < 0) {
                                bad = true
                                break
                            }
                            let lo = c0 + c1 * 256
                            if (lo < 56320 || lo > 57343) {
                                bad = true
                                break
                            }
                            let cp = 65536 + (u - 55296) * 1024 + (lo - 56320)
                            bytes.push(240 + cp / 262144)
                            bytes.push(128 + (cp / 4096) % 64)
                            bytes.push(128 + (cp / 64) % 64)
                            bytes.push(128 + cp % 64)
                            i = i + 2
                        } else {
                            if (u >= 56320 && u <= 57343) {
                                bad = true
                                break
                            }
                            bytes.push(224 + u / 4096)
                            bytes.push(128 + (u / 64) % 64)
                            bytes.push(128 + u % 64)
                            i = i + 1
                        }
                    }
                }
            }
        }
    }
    if (bad || i < n_units) { return None }
    return decode_utf8(bytes)
}

pub fn pf_dir_names(path Str) List<Str> {
    var out = List<Str>.new()
    if (path.len() == 0) { return out }
    let cap = (path.len() * 2 + 2) * 2
    let preg = buf_alloc(cap)
    if (preg < 0) { return out }
    let pn = stage_w16(path, preg, 0)
    if (pn <= 0) {
        let df1 = buf_free(preg)
        return out
    }
    let dh = dir_open_w16(preg, 0, pn)
    let df2 = buf_free(preg)
    if (dh <= 0) { return out }
    let nreg = buf_alloc(1284)
    if (nreg < 0) {
        let dc1 = dir_close(dh)
        return out
    }
    let t16 = ticks16()
    let t64 = ticks64()
    var done = false
    for a in t16 {
        if (done) { break }
        for b in t64 {
            if (done) { break }
            for c in t64 {
                let nu = dir_next_w16(dh, nreg, 640)
                if (nu <= 0) {
                    done = true
                    break
                }
                let dec = decode_w16_region(nreg, 0, nu)
                is dec {
                    Some(name) -> {
                        if (name == "." || name == "..") {
                        } else {
                            out.push(name.move)
                        }
                    }
                    None -> {}
                }
            }
        }
    }
    let dc2 = dir_close(dh)
    let df3 = buf_free(nreg)
    return out
}

pub fn pf_env_get_opt(key Str) ?Str {
    if (key.len() == 0) { return None }
    let nreg = buf_alloc((key.len() * 2 + 2) * 2)
    if (nreg < 0) { return None }
    let nn = stage_w16(key, nreg, 0)
    if (nn <= 0) {
        let df1 = buf_free(nreg)
        return None
    }
    let vreg = buf_alloc(65540)
    if (vreg < 0) {
        let df2 = buf_free(nreg)
        return None
    }
    let r = env_get_w16(nreg, 0, nn, vreg, 32768)
    let df3 = buf_free(nreg)
    if (r < 0) {
        let df4 = buf_free(vreg)
        return None
    }
    if (r == 0) {
        let df5 = buf_free(vreg)
        return Some("")
    }
    let dec = decode_w16_region(vreg, 0, r)
    let df6 = buf_free(vreg)
    return dec
}

pub fn pf_home_dir() Str {
    var out = "."
    let r = pf_env_get_opt("USERPROFILE")
    is r {
        Some(v) -> { out = v }
        None -> {}
    }
    return out
}

pub fn pf_local_data_dir() Str {
    var out = "."
    let r = pf_env_get_opt("APPDATA")
    is r {
        Some(v) -> { out = v }
        None -> {}
    }
    return out
}

pub fn pf_canonical(path Str) Str {
    if (path.len() == 0) { return "" }
    let ireg = buf_alloc((path.len() * 2 + 2) * 2)
    if (ireg < 0) { return "" }
    let n = stage_w16(path, ireg, 0)
    if (n <= 0) {
        let df1 = buf_free(ireg)
        return ""
    }
    let oreg = buf_alloc(8196)
    if (oreg < 0) {
        let df2 = buf_free(ireg)
        return ""
    }
    let r = canonical_w16(ireg, 0, n, oreg, 4096)
    let df3 = buf_free(ireg)
    if (r <= 0) {
        let df4 = buf_free(oreg)
        return ""
    }
    let dec = decode_w16_region(oreg, 0, r)
    let df5 = buf_free(oreg)
    var out = ""
    is dec {
        Some(s) -> { out = s }
        None -> {}
    }
    return out
}

pub fn pf_current_dir() Str {
    let reg = buf_alloc(8196)
    if (reg < 0) { return "" }
    let r = proc_cwd_w16(reg, 4096)
    if (r <= 0) {
        let df1 = buf_free(reg)
        return ""
    }
    let dec = decode_w16_region(reg, 0, r)
    let df2 = buf_free(reg)
    var out = ""
    is dec {
        Some(s) -> { out = s }
        None -> {}
    }
    return out
}

pub fn pf_args() List<Str> {
    let reg = buf_alloc(65540)
    if (reg < 0) { return List<Str>.new() }
    let r = proc_cmdline_w16(reg, 32768)
    if (r <= 0) {
        let df1 = buf_free(reg)
        return List<Str>.new()
    }
    let dec = decode_w16_region(reg, 0, r)
    let df2 = buf_free(reg)
    var out = List<Str>.new()
    is dec {
        Some(s) -> { out = parse_win32_cmdline(s) }
        None -> {}
    }
    return out
}
