}

pub fn pf_replace(src Str, dst Str) int {
    let scap = (src.len() * 2 + 2) * 2
    let dcap = (dst.len() * 2 + 2) * 2
    let sregion = buf_alloc(scap)
    if (sregion <= 0) {
        return sregion
    }
    let dregion = buf_alloc(dcap)
    if (dregion <= 0) {
        let d11_buf_free = buf_free(sregion)
        return dregion
    }
    let sn = stage_w16(src, sregion, 0)
    let dn = stage_w16(dst, dregion, 0)
    var r = -4
    if (sn > 0 && dn > 0) {
        r = file_replace_w16(sregion, 0, sn, dregion, 0, dn)
    }
    let d12_buf_free = buf_free(sregion)
    let d13_buf_free = buf_free(dregion)
    return r
}

