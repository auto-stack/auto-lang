// ACE system library — process module (PLAN-973 T-02). Legacy contracts:
// spawn WAITS and returns the child's exit code (-1 on spawn failure);
// spawn_with_output captures stdout/stderr with 64 KiB caps per stream and
// returns the {"exit_code","stdout","stderr"} JSON envelope; args() is the
// argv list (argv[0] = the program); exit terminates the program with a
// code (a controlled VM outcome on AV — never kills the host). Timeout
// kills the whole child tree (job object / process group) and returns -11.
// Counted walks are bounded recursions (no while/conditional-for on this
// face; AV frame cap 1024 — see std.syscommon; command lines are
// path-scale so single-level bounded walks suffice).

#in sys is current {
    Windows -> {
        use std.sysplat_win.pf_spawn_cps
        use std.sysplat_win.pf_pipe_read
        use std.sysplat_win.pf_wait
        use std.sysplat_win.pf_release
        use std.sysplat_win.pf_exit
        use std.sysplat_win.pf_chdir
        use std.sysplat_win.pf_args
        use std.sysplat_win.pf_current_dir
        use std.sysplat_win.buf_alloc
        use std.sysplat_win.buf_free
    }
    Linux -> {
        use std.sysplat_lnx.pf_spawn_cps
        use std.sysplat_lnx.pf_pipe_read
        use std.sysplat_lnx.pf_wait
        use std.sysplat_lnx.pf_release
        use std.sysplat_lnx.pf_exit
        use std.sysplat_lnx.pf_chdir
        use std.sysplat_lnx.pf_args
        use std.sysplat_lnx.pf_current_dir
        use std.sysplat_lnx.buf_alloc
        use std.sysplat_lnx.buf_free
    }
}

use std.bytes.decode_utf8
use std.syscommon.escape
use std.syscommon.from_i64
use std.syscommon.min_i
use std.syscommon.json_escape
use std.syscommon.read_region_bytes
use std.syscommon.ticks16
use std.syscommon.ticks64

// ---- argv / cwd (D-05) ----------------------------------------------------------

pub fn args() List<Str> {
    return pf_args()
}

pub fn current_dir() Str {
    return pf_current_dir()
}

pub fn set_current_dir(path Str) int {
    return pf_chdir(path)
}

// ---- cmdline building ------------------------------------------------------------

// NAMED LANE GAP: argv List<Str> staging — element views on this face
// allow only no-argument method reads (len), so per-char walks over list
// elements are impossible; the spawn API takes OWNED string params
// (spawn5) or a raw codepoint list (spawn_wait_cps) instead. The list
// form is SUPERSEDED by those APIs (final PLAN-973 decision — no
// list-staging increment is planned; T-05 review finding F4).

fn append_str_cps(a Str, i int, cps List<int>) int {
    if (i >= a.len()) {
        return 0
    }
    let c = a.char_at(i)
    let cp = c.to_codepoint()
    cps.push(cp)
    return append_str_cps(a, i + 1, cps)
}

// quote ONLY when needed (spaces/tabs/quotes): cmd.exe and other legacy
// parsers mishandle unconditional quoting. The decision scan tail-passes
//  into the emit step (single-move discipline).
fn append_quoted(a Str, cps List<int>) int {
    if (a.len() == 0) {
        return 0
    }
    return quote_scan(a, cps, 0, 0)
}

fn quote_scan(a Str, cps List<int>, j int, need int) int {
    if (j >= a.len()) {
        return quote_emit(a, cps, need)
    }
    let p = a.char_at(j).to_codepoint()
    var nq = need
    if (p == 32 || p == 9 || p == 34) {
        nq = 1
    }
    return quote_scan(a, cps, j + 1, nq)
}

fn quote_emit(a Str, cps List<int>, need int) int {
    if (need == 1) {
        cps.push(34)
        let d2 = append_str_cps(a, 0, cps)
        cps.push(34)
        return 0
    }
    return append_str_cps(a, 0, cps)
}

// ---- spawn ------------------------------------------------------------------------

// spawn_wait_cps(cps, timeout_ms): spawn a fully-staged command line
// (codepoints) and wait; -11 on timeout-kill (the V-03 tree kill).
pub fn spawn_wait_cps(cps List<int>, timeout_ms int) int {
    if (cps.len() == 0) {
        return -1
    }
    let ph = pf_spawn_cps(cps, 0)
    if (ph <= 0) {
        return -1
    }
    let code = pf_wait(ph, timeout_ms)
    let d1_release = pf_release(ph)
    return code
}

// spawn5: up to four string arguments after the program ("" = absent),
// always-quoted (valid Windows form; args containing a double quote are
// a named v1 limit).
pub fn spawn5(prog Str, a1 Str, a2 Str, a3 Str, a4 Str, timeout_ms int) int {
    let cps = List<int>.new()
    return spawn_chain5(prog, a1, a2, a3, a4, cps, timeout_ms)
}

// the owned cps local moves ONCE into this frame; params borrow freely
fn spawn_chain5(prog Str, a1 Str, a2 Str, a3 Str, a4 Str, cps List<int>, timeout_ms int) int {
    let d0 = append_quoted(prog, cps)
    let d1 = sep_arg(a1, cps)
    let d2 = sep_arg(a2, cps)
    let d3 = sep_arg(a3, cps)
    let d4 = sep_arg(a4, cps)
    return spawn_wait_cps(cps, timeout_ms)
}

fn sep_arg(a Str, cps List<int>) int {
    if (a.len() == 0) {
        return 0
    }
    cps.push(32)
    return append_quoted(a, cps)
}

// spawn_capture_counts5: same shape with capture pipes; the returned
// composite is code*1000000 + stdout_bytes*1000 + stderr_bytes (legacy
// 64 KiB caps; the TEXT of captured output is the byte→Str lane gap).
pub fn spawn_capture_counts5(prog Str, a1 Str, a2 Str, a3 Str, a4 Str) int {
    let cps = List<int>.new()
    return capture_chain5(prog, a1, a2, a3, a4, cps)
}

fn capture_chain5(prog Str, a1 Str, a2 Str, a3 Str, a4 Str, cps List<int>) int {
    let d0 = append_quoted(prog, cps)
    let d1 = sep_arg(a1, cps)
    let d2 = sep_arg(a2, cps)
    let d3 = sep_arg(a3, cps)
    let d4 = sep_arg(a4, cps)
    if (cps.len() == 0) {
        return -1
    }
    let ph = pf_spawn_cps(cps, 1)
    if (ph <= 0) {
        return -1
    }
    let out_n = drain_count(ph, 1, 0)
    let err_n = drain_count(ph, 2, 0)
    let code = pf_wait(ph, -1)
    let d5_release = pf_release(ph)
    return code * 1000000 + out_n * 1000 + err_n
}

// drain one capture pipe counting bytes to EOF with the 64 KiB legacy cap.
fn drain_count(ph int, which int, total int) int {
    if (total >= 65536) {
        return total
    }
    let region = buf_alloc(32768)
    if (region < 0) {
        return total
    }
    let n = pf_pipe_read(ph, which, region, 0, 32768, -1)
    let d1_buf_free = buf_free(region)
    if (n <= 0) {
        return total
    }
    return drain_count(ph, which, total + n)
}

// exit(code): terminate the running program with the given exit code.
pub fn exit(code int) int {
    return pf_exit(code)
}

// ---- spawn_with_output (D-06) --------------------------------------------------

fn is_json_ws(cp int) bool {
    return cp == 32 || cp == 9 || cp == 10 || cp == 13
}

fn hex_val(cp int) int {
    if (cp >= 48 && cp <= 57) { return cp - 48 }
    if (cp >= 65 && cp <= 70) { return cp - 55 }
    if (cp >= 97 && cp <= 102) { return cp - 87 }
    return -1
}

fn push_cp_utf8_local(cp int, out List<int>) int {
    if (cp < 0 || cp > 1114111) { return -1 }
    if (cp >= 55296 && cp <= 57343) { return -1 }
    if (cp < 128) {
        out.push(cp)
        return 0
    }
    if (cp < 2048) {
        out.push(192 + cp / 64)
        out.push(128 + cp % 64)
        return 0
    }
    if (cp < 65536) {
        out.push(224 + cp / 4096)
        out.push(128 + (cp / 64) % 64)
        out.push(128 + cp % 64)
        return 0
    }
    out.push(240 + cp / 262144)
    out.push(128 + (cp / 4096) % 64)
    out.push(128 + (cp / 64) % 64)
    out.push(128 + cp % 64)
    return 0
}

type JsonStrStep {
    next int
    value Str
}

fn skip_json_ws(s Str, start int) int {
    let n = s.len()
    var i = start
    let t16 = ticks16()
    for a in t16 {
        if (i >= n) { return i }
        if (is_json_ws(s.char_at(i).to_codepoint())) {
            i = i + 1
        } else {
            return i
        }
    }
    if (i < n && is_json_ws(s.char_at(i).to_codepoint())) {
        return skip_json_ws(s, i)
    }
    return i
}

fn parse_hex4(s Str, at int) int {
    if (at + 4 > s.len()) { return -1 }
    let h0 = hex_val(s.char_at(at).to_codepoint())
    let h1 = hex_val(s.char_at(at + 1).to_codepoint())
    let h2 = hex_val(s.char_at(at + 2).to_codepoint())
    let h3 = hex_val(s.char_at(at + 3).to_codepoint())
    if (h0 < 0 || h1 < 0 || h2 < 0 || h3 < 0) { return -1 }
    return h0 * 4096 + h1 * 256 + h2 * 16 + h3
}

fn parse_json_u_escape(s Str, slash_pos int) JsonStrStep {
    let n = s.len()
    let u1 = parse_hex4(s.clone(), slash_pos + 2)
    if (u1 < 0) { return JsonStrStep(-1, "") }
    var ucp = u1
    var next_pos = slash_pos + 6
    if (u1 >= 55296 && u1 <= 56319) {
        if (slash_pos + 12 > n || s.char_at(slash_pos + 6).to_codepoint() != 92 || s.char_at(slash_pos + 7).to_codepoint() != 117) {
            return JsonStrStep(-1, "")
        }
        let u2 = parse_hex4(s, slash_pos + 8)
        if (u2 < 56320 || u2 > 57343) { return JsonStrStep(-1, "") }
        ucp = 65536 + (u1 - 55296) * 1024 + (u2 - 56320)
        next_pos = slash_pos + 12
    }
    var ub = List<int>.new()
    if (push_cp_utf8_local(ucp, ub) != 0) { return JsonStrStep(-1, "") }
    let ud = decode_utf8(ub)
    var out = ""
    var ok = false
    is ud {
        Some(us) -> { out = us; ok = true }
        None -> {}
    }
    if (ok == false) { return JsonStrStep(-1, "") }
    return JsonStrStep(next_pos, out.move)
}

fn decode_simple_escape(esc int) JsonStrStep {
    if (esc == 34) { return JsonStrStep(2, "\"") }
    if (esc == 92) { return JsonStrStep(2, "\\") }
    if (esc == 47) { return JsonStrStep(2, "/") }
    if (esc == 110) { return JsonStrStep(2, "\n") }
    if (esc == 114) { return JsonStrStep(2, "\r") }
    if (esc == 116) { return JsonStrStep(2, "\t") }
    if (esc == 98 || esc == 102) {
        var cb = List<int>.new()
        if (esc == 98) { cb.push(8) } else { cb.push(12) }
        var chs = ""
        var ok = false
        let dc = decode_utf8(cb)
        is dc {
            Some(cs) -> { chs = cs; ok = true }
            None -> {}
        }
        if (ok) { return JsonStrStep(2, chs.move) }
    }
    return JsonStrStep(-1, "")
}

fn parse_json_str_at(s Str, qpos int) JsonStrStep {
    let n = s.len()
    if (qpos >= n || s.char_at(qpos).to_codepoint() != 34) { return JsonStrStep(-1, "") }
    var i = qpos + 1
    var run_start = i
    var acc = ""
    let t16 = ticks16()
    let t64 = ticks64()
    for a in t16 {
        if (i >= n) { break }
        for b in t64 {
            if (i >= n) { break }
            let cp = s.char_at(i).to_codepoint()
            if (cp < 32) { return JsonStrStep(-1, "") }
            if (cp == 34) {
                if (i > run_start) { acc = acc + s.slice(run_start, i).clone() }
                return JsonStrStep(i + 1, acc.move)
            }
            if (cp == 92) {
                if (i > run_start) { acc = acc + s.slice(run_start, i).clone() }
                if (i + 1 >= n) { return JsonStrStep(-1, "") }
                let esc = s.char_at(i + 1).to_codepoint()
                if (esc == 117) {
                    let st = parse_json_u_escape(s.clone(), i)
                    if (st.next < 0) { return JsonStrStep(-1, "") }
                    acc = acc + st.value.clone()
                    i = st.next
                    run_start = i
                } else {
                    let st = decode_simple_escape(esc)
                    if (st.next < 0) { return JsonStrStep(-1, "") }
                    acc = acc + st.value.clone()
                    i = i + st.next
                    run_start = i
                }
            } else {
                i = i + 1
            }
        }
    }
    return JsonStrStep(-1, "")
}

// Parse JSON string array `["cmd", "arg1", ...]` -> ?List<Str>.
fn parse_json_args_list(s Str) ?List<Str> {
    var out = List<Str>.new()
    let n = s.len()
    var i = skip_json_ws(s.clone(), 0)
    if (i >= n || s.char_at(i).to_codepoint() != 91) { return None }
    i = skip_json_ws(s.clone(), i + 1)
    if (i < n && s.char_at(i).to_codepoint() == 93) {
        if (skip_json_ws(s.clone(), i + 1) == n) { return Some(out.move) }
        return None
    }
    let t16 = ticks16()
    let t64 = ticks64()
    for a in t16 {
        for b in t64 {
            let st = parse_json_str_at(s.clone(), i)
            if (st.next < 0) { return None }
            var piece = st.value.clone()
            out.push(piece.move)
            i = skip_json_ws(s.clone(), st.next)
            if (i >= n) { return None }
            let sep = s.char_at(i).to_codepoint()
            if (sep == 93) {
                if (skip_json_ws(s.clone(), i + 1) == n) { return Some(out.move) }
                return None
            }
            if (sep != 44) { return None }
            i = skip_json_ws(s.clone(), i + 1)
        }
    }
    return None
}

fn push_backslashes(cps List<int>, count int) int {
    if (count <= 0) { return 0 }
    cps.push(92)
    return push_backslashes(cps, count - 1)
}

fn append_win32_arg_cps(a Str, cps List<int>) int {
    let n = a.len()
    if (n == 0) {
        cps.push(34)
        cps.push(34)
        return 0
    }
    var need = false
    let t64 = ticks64()
    var k = 0
    for g in t64 {
        if (k >= n || need) { break }
        for h in t64 {
            if (k >= n) { break }
            let cp = a.char_at(k).to_codepoint()
            if (cp == 32 || cp == 9 || cp == 10 || cp == 34) {
                need = true
                break
            }
            k = k + 1
        }
    }
    if (need == false) { return append_str_cps(a, 0, cps) }
    cps.push(34)
    var i = 0
    var bs = 0
    for g in t64 {
        if (i >= n) { break }
        for h in t64 {
            if (i >= n) { break }
            let cp = a.char_at(i).to_codepoint()
            if (cp == 92) {
                bs = bs + 1
            } else {
                if (cp == 34) {
                    let pb1 = push_backslashes(cps, bs * 2 + 1)
                    cps.push(34)
                    bs = 0
                } else {
                    if (bs > 0) {
                        let pb2 = push_backslashes(cps, bs)
                        bs = 0
                    }
                    cps.push(cp)
                }
            }
            i = i + 1
        }
    }
    if (bs > 0) { let pb3 = push_backslashes(cps, bs * 2) }
    cps.push(34)
    return 0
}

fn drain_pipe_capped(ph int, which int, reg int, cap int) ?List<int> {
    var out = List<int>.new()
    let t16 = ticks16()
    var done = false
    for a in t16 {
        if (done) { break }
        for b in t16 {
            let n = pf_pipe_read(ph, which, reg, 0, 4096, 10000)
            if (n == 0) {
                done = true
                break
            }
            if (n < 0) { return None }
            if (out.len() + n > cap) { return None }
            if (read_region_bytes(reg, 0, n, out) != 0) { return None }
        }
    }
    if (done == false) { return None }
    return Some(out.move)
}

// D-06: spawn process from JSON argv array `["cmd", ...]`, capturing stdout/stderr
// (64 KiB cap per stream). Returns `{"exit_code":i32,"stdout":"...","stderr":"..."}`
// or "" on spawn/JSON/cap/timeout/UTF-8 error (kills & releases process tree cleanly).
pub fn spawn_with_output(args_json Str) Str {
    let parsed = parse_json_args_list(args_json)
    var argv = List<Str>.new()
    is parsed {
        Some(xs) -> { argv = xs }
        None -> { return "" }
    }
    if (argv.len() == 0) { return "" }
    var cps = List<int>.new()
    let t64 = ticks64()
    var first = true
    for g in t64 {
        if (argv.len() == 0) { break }
        for h in t64 {
            if (argv.len() == 0) { break }
            if (first == false) { cps.push(32) }
            first = false
            let a Str = argv.remove(0)
            let ap = append_win32_arg_cps(a, cps)
        }
    }
    if (cps.len() == 0) { return "" }
    let ph = pf_spawn_cps(cps, 1)
    if (ph <= 0) { return "" }
    let reg = buf_alloc(4096)
    if (reg < 0) {
        let dr1 = pf_release(ph)
        return ""
    }
    let out_res = drain_pipe_capped(ph, 1, reg, 65536)
    var out_b = List<int>.new()
    is out_res {
        Some(xs) -> { out_b = xs }
        None -> {
            let df1 = buf_free(reg)
            let dr2 = pf_release(ph)
            return ""
        }
    }
    let err_res = drain_pipe_capped(ph, 2, reg, 65536)
    let df2 = buf_free(reg)
    var err_b = List<int>.new()
    is err_res {
        Some(xs) -> { err_b = xs }
        None -> {
            let dr3 = pf_release(ph)
            return ""
        }
    }
    let ec = pf_wait(ph, 30000)
    let dr4 = pf_release(ph)
    if (ec < 0 && ec >= -20) { return "" }
    let out_dec = decode_utf8(out_b)
    var out_s = ""
    is out_dec {
        Some(s) -> { out_s = s }
        None -> { return "" }
    }
    let err_dec = decode_utf8(err_b)
    var err_s = ""
    is err_dec {
        Some(s) -> { err_s = s }
        None -> { return "" }
    }
    return "{\"exit_code\":" + from_i64(ec.to(i64)) + ",\"stdout\":\"" + json_escape(out_s) + "\",\"stderr\":\"" + json_escape(err_s) + "\"}"
}
