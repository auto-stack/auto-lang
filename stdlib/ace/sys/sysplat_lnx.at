pub fn pf_replace(src Str, dst Str) int {
    return file_replace_bytes(src, dst)
}

// dirent64 record layout: ino u64, off u64, reclen u16 (LE), d_type u8,
// name bytes (NUL-terminated). Parsed with div/mod arithmetic only.
fn u16_at(region int, off int) int {
    let b0 = mem_read_u8(region, off)
    let b1 = mem_read_u8(region, off + 1)
    if (b0 < 0 || b1 < 0) {
        return -1
    }
    return b0 + b1 * 256
}

fn u32_at(region int, off int) int {
    let b0 = mem_read_u8(region, off)
    let b1 = mem_read_u8(region, off + 1)
    let b2 = mem_read_u8(region, off + 2)
    let b3 = mem_read_u8(region, off + 3)
    if (b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0) {
        return -1
    }
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

// list_dir(dir) -> entry names incl. "." / "."." (the caller filters);
// empty list on error. The getdents64 batches parse via bounded record
// recursion inside each batch.

// Parse dirent64 records from pos; returns the advanced position.

// A non-UTF-8 entry name is skipped, not silently lossy (the byte-path
// API that preserves it lands with 1063).

// env snapshot: NUL-separated KEY=VALUE bytes from /proc/self/environ.

// entry starts with `name=`?

fn key_matches(entry Str, name Str, i int) bool {
    if (i >= name.len()) {
        return true
    }
    if (entry.char_at(i).to_codepoint() != name.char_at(i).to_codepoint()) {
        return false
    }
    return key_matches(entry, name, i + 1)
}

// strip `name=` off a matched entry, keeping the value verbatim.

// env set/remove on Linux is a named-deferred gap: no syscall exists for
// in-process environ mutation; the entry-captured envp increment is owned
// by PLAN-1063 (frozen in the plan T-01 record).
pub fn pf_env_set(name Str, value Str) int {
    return err_deferred_env()
}

fn err_deferred_env() int {
    return -10
}

pub fn pf_env_remove(name Str) int {
    return err_deferred_env()
}

pub fn pf_now_ms() i64 {
    let lo = clock_unix_ms()
    return join64(clock_hi(), lo)
}

pub fn pf_mono_ms() i64 {
    let lo = clock_mono_ms()
    return join64(clock_hi(), lo)
}

pub fn pf_sleep_ms(ms int) int {
    return sleep_ms(ms)
}

pub fn pf_rand_fill(region int, off int, len int) int {
    return rand_fill(region, off, len)
}

// Linux spawn (clone+vfork shim) is a named-deferred gap owned by 1063;
// callers map -10 to their error contract (never a silent fallback).
pub fn pf_spawn_cps(cps List<int>, capture int) int {
    // Linux spawn is named-deferred to 1063; the cps form reports the
    // same named-unsupported state as the blob form.
    return err_deferred_spawn(cps, capture)
}

fn err_deferred_spawn(cps List<int>, capture int) int {
    return -10
}

pub fn pf_spawn(argv_blob Str, capture int) int {
    return proc_spawn_bytes(argv_blob, capture)
}

