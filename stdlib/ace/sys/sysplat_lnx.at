// ACE system library — Linux platform module (PLAN-973 T-02). Pure Auto
// wrappers over the frozen Linux-side platform ops: paths are raw bytes
// (no UTF-16 staging), directory batches parse linux_dirent64 records in
// THIS Auto source, and the env snapshot parses /proc/self/environ. The
// Linux arms are CODE-ONLY from Windows development per the 2026-11-15
// ruling (deferred-required / NOT_RUN, owner PLAN-1063) — selected by
// `#in sys is current { Linux -> ... }` at assembly time.

use std.bytes.decode_utf8
use std.syscommon.decode_utf8_region
use std.syscommon.encode_into
use std.syscommon.str_bytes_len
use std.syscommon.max_i
use std.syscommon.ticks16
use std.syscommon.ticks64

pub fn buf_alloc(bytes int) int {
    return mem_alloc(bytes)
}

pub fn buf_free(region int) int {
    return mem_free(region)
}

