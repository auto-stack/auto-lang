// Composed under `avrs/1`.
// auto-ffi fn env_get_len symbol=avrs.env.get_len.v1 form=pure ret=i32
pub fn env_get_len(name: &str) -> i32 {
    match std::env::var(name) {
        Ok(value) => value.as_bytes().len() as i32,
        Err(_) => -203,
    }
}
// auto-ffi fn env_has symbol=avrs.env.has.v1 form=pure ret=bool
pub fn env_has(name: &str) -> bool {
    std::env::var_os(name).is_some()
}
// auto-ffi fn env_remove symbol=avrs.env.remove.v1 form=pure ret=i32
pub fn env_remove(name: &str) -> i32 {
    std::env::remove_var(name);
    0
}
