// ACE assembled stdlib conv module (PLAN-972 T-02): the S-05 parse family
// as pure Auto algorithms (scalar-indexed, codepoint arithmetic; i64
// accumulator with explicit range checks — never a silent trap).
// Errors are Option-valued (V-DETAIL-02): invalid digit, empty input,
// lone sign, and out-of-i32-range all return None; "-2147483648" (i32::MIN)
// parses. int→Str formatting needs char→Str construction (named later
// batch); byte-level encodings (hex/base64) need byte indexing (named
// boundary of the scalar surface).
pub fn to_int(s Str) ?int {
    if (s.len() == 0) {
        return None
    }
    var i = 0
    var neg = false
    let c0 = s.char_at(0)
    if (c0.to_codepoint() == 45) {
        neg = true
        i = 1
    }
    if (i == s.len()) {
        return None
    }
    return parse_at(s, i, neg, 0i64)
}

fn parse_at(s Str, i int, neg bool, acc i64) ?int {
    if (i == s.len()) {
        if (neg) {
            if (acc > 2147483648i64) {
                return None
            }
            let n = -acc
            return Some(n.to(i32))
        }
        if (acc > 2147483647i64) {
            return None
        }
        return Some(acc.to(i32))
    }
    let c = s.char_at(i)
    let p = c.to_codepoint()
    if (p < 48) {
        return None
    }
    if (p > 57) {
        return None
    }
    let d = p - 48
    return parse_at(s, i + 1, neg, acc * 10i64 + d.to(i64))
}

pub fn is_uint(s Str) bool {
    if (s.len() == 0) {
        return false
    }
    return digits_at(s, 0)
}

fn digits_at(s Str, i int) bool {
    if (i == s.len()) {
        return true
    }
    let c = s.char_at(i)
    let p = c.to_codepoint()
    if (p < 48) {
        return false
    }
    if (p > 57) {
        return false
    }
    return digits_at(s, i + 1)
}
