// ACE assembled stdlib bytes module (PLAN-972 T-02): the S-03 byte-access
// surface as pure Auto single-source algorithms over the scalar-indexed
// face. UTF-8 bytes are reconstructed by walking scalars (char_at /
// to_codepoint) and encoding each codepoint with div/mod arithmetic only —
// bit ops stay out of the default algorithms even though the infix
// ^/&/| grammar gate is open on this face: the mn/C emitters name bit-op
// lowering as a follow-up unit, and the defaults must lower on every end.
// byte_hash is the byte-domain default hash (S-06 ruling 2026-11-15: the
// byte domain rides the S-03 batch); the codepoint-domain default lives in
// std.hash. NUL is an ordinary byte (explicit lengths, no C-string cuts).
pub fn byte_at(s Str, i int) ?int {
    if (i < 0) {
        return None
    }
    return byte_at_walk(s, 0, i)
}

fn byte_at_walk(s Str, ci int, bi int) ?int {
    if (ci == s.len()) {
        return None
    }
    let c = s.char_at(ci)
    let p = c.to_codepoint()
    let n = utf8_len(p)
    if (bi < n) {
        return Some(byte_of(p, bi))
    }
    return byte_at_walk(s, ci + 1, bi - n)
}

pub fn utf8_len(p int) int {
    if (p < 128) {
        return 1
    }
    if (p < 2048) {
        return 2
    }
    if (p < 65536) {
        return 3
    }
    return 4
}

// The k-th byte (0-based) of p's UTF-8 encoding, reconstructed with div/mod
// (p>>6 == p/64 and p&0x3F == p%64 for non-negative codepoints).
pub fn byte_of(p int, k int) int {
    if (p < 128) {
        return p
    }
    if (p < 2048) {
        if (k == 0) {
            return 192 + p / 64
        }
        return 128 + p % 64
    }
    if (p < 65536) {
        if (k == 0) {
            return 224 + p / 4096
        }
        if (k == 1) {
            return 128 + (p / 64) % 64
        }
        return 128 + p % 64
    }
    if (k == 0) {
        return 240 + p / 262144
    }
    if (k == 1) {
        return 128 + (p / 4096) % 64
    }
    if (k == 2) {
        return 128 + (p / 64) % 64
    }
    return 128 + p % 64
}

// S-03/S-06: the byte-domain default hash — deterministic, order-sensitive,
// i64 result. UTF-8 bytes fold through the polynomial multiply-add mix;
// the mod 2^31-1 reduction at every step keeps the whole computation
// inside checked i64 arithmetic (no wrapping ops on this surface).
pub fn byte_hash(s Str) i64 {
    return byte_hash_at(s, 0, 1469598103i64)
}

fn byte_hash_at(s Str, i int, h i64) i64 {
    if (i == s.len()) {
        return h
    }
    let c = s.char_at(i)
    let p = c.to_codepoint()
    let n = utf8_len(p)
    let b0 = byte_of(p, 0)
    let h1 = mix_byte(h, b0)
    let h2 = step_if(n, 1, h1, p)
    let h3 = step_if(n, 2, h2, p)
    let h4 = step_if(n, 3, h3, p)
    return byte_hash_at(s, i + 1, h4)
}

fn step_if(n int, k int, h i64, p int) i64 {
    if (k < n) {
        return mix_byte(h, byte_of(p, k))
    }
    return h
}

fn mix_byte(h i64, b int) i64 {
    return (h * 1000003i64 + b.to(i64)) % 2147483647i64
}

// S-03 encodings: hex and base64 ENCODE over the reconstructed UTF-8 bytes
// (6-bit groups via div/mod arithmetic — no bit ops; digits come from the
// alphabet tables via slice construction). base64 walks (scalar index,
// byte-in-scalar, pending group b0/b1, pending count, emitted prefix) so
// groups align across scalar boundaries without buffering. DECODE is a
// named boundary: building a Str from arbitrary byte values needs a
// byte→Str construction this surface does not expose.
pub fn to_hex(s Str) Str {
    return hex_at(s, 0, "")
}

fn hex_at(s Str, i int, acc Str) Str {
    if (i == s.len()) {
        return acc.clone()
    }
    let c = s.char_at(i)
    let p = c.to_codepoint()
    let n = utf8_len(p)
    let acc1 = hex_byte(acc, byte_of(p, 0))
    let acc2 = hex_step(n, 1, acc1, p)
    let acc3 = hex_step(n, 2, acc2, p)
    return hex_at(s, i + 1, hex_step(n, 3, acc3, p))
}

fn hex_step(n int, k int, acc Str, p int) Str {
    if (k < n) {
        return hex_byte(acc, byte_of(p, k))
    }
    return acc.clone()
}

fn hex_byte(acc Str, b int) Str {
    let table Str = "0123456789abcdef"
    let hi = b / 16
    let lo = b % 16
    let h Str = table.slice(hi, hi + 1).clone()
    let l Str = table.slice(lo, lo + 1).clone()
    let mid Str = acc + h
    return mid + l
}

pub fn to_base64(s Str) Str {
    return b64_at(s, 0, 0, 0, 0, 0, "")
}

fn b64_at(s Str, ci int, kb int, b0 int, b1 int, k int, acc Str) Str {
    if (ci == s.len()) {
        if (k == 0) {
            return acc.clone()
        }
        if (k == 1) {
            let head Str = acc + b64_pair(b0)
            return head + "=="
        }
        let head Str = acc + b64_triple(b0, b1)
        return head + "="
    }
    let c = s.char_at(ci)
    let p = c.to_codepoint()
    let n = utf8_len(p)
    if (kb >= n) {
        return b64_at(s, ci + 1, 0, b0, b1, k, acc)
    }
    let b = byte_of(p, kb)
    if (k == 0) {
        return b64_at(s, ci, kb + 1, b, b1, 1, acc)
    }
    if (k == 1) {
        return b64_at(s, ci, kb + 1, b0, b, 2, acc)
    }
    let with_group Str = acc + b64_quad(b0, b1, b)
    return b64_at(s, ci, kb + 1, 0, 0, 0, with_group)
}

fn b64_digit(g int) Str {
    let table Str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    return table.slice(g, g + 1).clone()
}

fn b64_quad(b0 int, b1 int, b2 int) Str {
    let g0 = b0 / 4
    let g1 = (b0 % 4) * 16 + b1 / 16
    let g2 = (b1 % 16) * 4 + b2 / 64
    let g3 = b2 % 64
    let a Str = b64_digit(g0)
    let b Str = b64_digit(g1)
    let c2 Str = b64_digit(g2)
    let d Str = b64_digit(g3)
    let ab Str = a + b
    let cd Str = c2 + d
    return ab + cd
}

fn b64_pair(b0 int) Str {
    let g0 = b0 / 4
    let g1 = (b0 % 4) * 16
    let a Str = b64_digit(g0)
    let b Str = b64_digit(g1)
    return a + b
}

fn b64_triple(b0 int, b1 int) Str {
    let g0 = b0 / 4
    let g1 = (b0 % 4) * 16 + b1 / 16
    let g2 = (b1 % 16) * 4
    let a Str = b64_digit(g0)
    let b Str = b64_digit(g1)
    let c2 Str = b64_digit(g2)
    let ab Str = a + b
    return ab + c2
}
