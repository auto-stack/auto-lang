// ACE assembled stdlib math module (PLAN-972 T-02): the S-01 int/i64 domain
// as pure Auto single-source algorithms. The i64 public family abs/min/max
// keeps the frozen i64 signatures (no narrowing adapter — PLAN-945 policy).
// abs of i64::MIN traps IntOverflow under the checked-arithmetic contract
// (PLAN-961); the boundary is independently asserted by the 972 conformance.
// The double family (sqrt/abs_f/powf/sin/cos) needs the intrinsic ABI with
// per-intrinsic semantics verification (T-09 batch) — not in this module.
pub fn abs(n i64) i64 {
    if (n < 0i64) {
        return -n
    }
    return n
}

pub fn min(a i64, b i64) i64 {
    if (a < b) {
        return a
    }
    return b
}

pub fn max(a i64, b i64) i64 {
    if (a > b) {
        return a
    }
    return b
}

pub fn square(x int) int {
    return x * x
}

pub fn cube(x int) int {
    return x * x * x
}
