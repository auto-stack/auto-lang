// ACE assembled stdlib list module (PLAN-972 T-02): the PLAN-946 frozen
// slice superset (sum/find_first_gt/pop/total_len over the frozen collections
// method table new/push/get/set/remove/len/clear) plus the closure-HOF family
// (reduce/find/any/all/filter/map over instantiated List<int>) — the
// HOF composition 946 explicitly deferred to 972. Signatures stay
// instantiated (List<int>/List<Str>); generic stdlib APIs belong to the
// 963 full-generics consumption slice, not this module.
//
// Lane: packages-aggregates-ct (assembled aggregates) — same identity rules
// as the frozen slice (anti-shadow: only this repo file can be `std.list`
// on this lane). `pop` keeps the ORIGINAL empty contract (None, not a trap).
pub fn sum(xs List<int>) int {
    var total = 0
    for x in xs {
        total = total + x
    }
    return total
}

pub fn find_first_gt(xs List<int>, threshold int) ?int {
    for x in xs {
        if (x > threshold) {
            return Some(x)
        }
    }
    return None
}

pub fn pop(xs List<int>) ?int {
    if xs.len() == 0 {
        return None
    }
    return Some(xs.remove(xs.len() - 1))
}

pub fn total_len(xs List<Str>) int {
    var total = 0
    for s in xs {
        total = total + s.len()
    }
    return total
}

pub fn reduce(xs List<int>, init int, f fn(int, int) -> int) int {
    var acc = init
    for x in xs {
        acc = f(acc, x)
    }
    return acc
}

pub fn find(xs List<int>, p fn(int) -> bool) ?int {
    for x in xs {
        if p(x) {
            return Some(x)
        }
    }
    return None
}

pub fn any(xs List<int>, p fn(int) -> bool) bool {
    for x in xs {
        if p(x) {
            return true
        }
    }
    return false
}

pub fn all(xs List<int>, p fn(int) -> bool) bool {
    for x in xs {
        if !p(x) {
            return false
        }
    }
    return true
}

pub fn filter(xs List<int>, p fn(int) -> bool) List<int> {
    var ys = List<int>.new()
    for x in xs {
        if p(x) {
            ys.push(x)
        }
    }
    return ys
}

pub fn map(xs List<int>, f fn(int) -> int) List<int> {
    var ys = List<int>.new()
    for x in xs {
        ys.push(f(x))
    }
    return ys
}
