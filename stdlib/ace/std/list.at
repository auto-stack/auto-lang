// ACE finite stdlib list slice (PLAN-946): the public scalar-List and
// owned-Str algorithms over the frozen collections method table
// (new/push/insert/get/set/remove/len/clear — T-01 freeze). Reduce/find
// run as for-in folds: closure HOF composition belongs to 964/972.
// `pop` wraps remove(len-1) with the ORIGINAL empty contract — the old
// VM's ListStorage::pop returned None on an empty list (Option, not a
// trap). No container-level clone exists in source: elements clone
// explicitly (T-01 freeze boundary).
pub fn sum(xs List<int>) int {
    var total = 0
    for x in xs {
        total = total + x
    }
    return total
}

pub fn find_first_gt(xs List<int>, threshold int) ?int {
    for x in xs {
        if (x > threshold) {
            return Some(x)
        }
    }
    return None
}

pub fn pop(xs List<int>) ?int {
    if xs.len() == 0 {
        return None
    }
    return Some(xs.remove(xs.len() - 1))
}

pub fn total_len(xs List<Str>) int {
    var total = 0
    for s in xs {
        total = total + s.len()
    }
    return total
}
