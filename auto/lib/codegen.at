// ╔═══════════════════════════════════════════════════════════╗
// ║ AAVM v2 Sync Snapshot                                     ║
// ║ Component: codegen.at (Plan 432 S4 / D28: codegen_dump)   ║
// ║ Rust ref:  vm/codegen.rs(Stmt 发射)+ vm/loader.rs(链接) ║
// ║ Gate:      M4 —— corpus_m4 字节码与 Rust codegen 结构一致  ║
// ╚═══════════════════════════════════════════════════════════╝
//           447-③ 终局收账:I.op → enum OpCode(C1)/cg 中缀环 is(P2)/
//           break-continue 占位回填/cg_fstr build.fstr(11.2a);
//           布局等价策略保留(D28 余项)
// Coverage:  脚本 wrapper(FN_PROLOG args=0 locals=16 + RESERVE 16);
//            fn 编译(每 fn 一个 jmp-over、FN_PROLOG/RESERVE 占位回填、
//            体块弹出的槽释放组、epilogue RET、jmp-over patch);
//            语句(let/var 存储无 dup-pop、赋值表达式语句 load-rhs-op-
//            dup-store-pop、复合赋值同型、if/else-if/else(含 return 后
//            死 jmp)、while(back-jmp 不含语句 .line)、for-in-range
//            增量循环(循环域弹出发释放)、return);表达式(Int/Str/bool
//            字面量、标识符寻址[param 0x80+rel / loc.0 / loc.1 /
//            local N]、二元算术/比较/逻辑、一元 !、用户 fn 调用(符号
//            表解析)、print CALL_NAT nat#10、str.cat);字符串池内容
//            寻址去重;.line 由语句步行者按语句首行发射;跳转 patch
//            (目标指令索引 → 字节偏移);
//            [M4 扩]数组字面量(elems+create.arr count=N)、下标读
//            (arr,idx,get.elem)与下标写(rhs,arr,idx,set.elem——value
//            展栈底,Rust quick-fix 栈序镜像)、.len()→arr.len(仅数组
//            接收者,镜像 Rust infer_object_type==Array 闸,7177)、顶层
//            非 fn 语句(wrapper 内步行,.line 同 cg_stmts);let/var 的
//            数组性绑定跟踪(CGVar.arr,供 .len() 接收者判定)
// Missing:   对象/元组字面量与方法调用(.str() 等 CALL_NAT 家族)、
//            字符串下标(get.elem 的 str→码点分支)、闭包/捕获、
//            浮点(CONST_F32/PROMOTE)、全局变量(LOAD_GLOBAL/
//            STORE_GLOBAL)、下标复合赋值、一元负号(NEG)、嵌套赋值、
//            #[vm] stub、生成器、多模块链接
// DIVERGE:   D28: Vec<u8> 字节码 + 链接重定位 → 指令 List(I{op,s,n})+
//            序列化直出 —— 发射顺序/操作数逐字对齐;FN_PROLOG/RESERVE
//            由 Rust 的"体后插入+地址平移"改为"占位+回填"(布局等价);
//            CALL 的链接重定位改为符号表(FnEntry)序列化期解析;槽释放
//            组按槽位升序(Rust pop_scope 按 HashMap 迭代序不定,m4 闸门
//            Rust 侧 dumper 同步规范化)。作用域栈 depth 计数(List 只增
//            不减,D25 写法)。D22 同款错误短路;复用 parser.at 的 token
//            游标/优先级表与 typeinfo.at 的 p_text_at。

// ── 载体 ──────────────────────────────────────────────────────

// 指令:op=助记符(空=已删除占位);s=序列化操作数文本;n=patch 载荷
// (jmp/jmp.z:目标指令索引;call:FnEntry 索引;load.str:池索引)
type I {
    op OpCode
    s str
    n int
}

type FnEntry {
    name str
    ins int
}

type CGVar {
    name str
    idx int
    arr int
    // 447-③ 11.2a:build.fstr 段类型 tag 用(""=int/未知,宿主默认同;
    // "str" → tag 1;仅 str 需显式识别,其余值域 tag 0)
    ty str
}

type CG {
    ins List<I>
    pool List<str>
    fns List<FnEntry>
    scopes List<List<CGVar>>
    depth int
    n_args int
    max_idx int
    err str
    str_flag int
    arr_flag int
    // Plan 447 部分②:枚举注册表(镜像宿主 enum_values + generic_registry
    // 载荷模板)。consts:"Enum.Variant"→判别值(scalar 链;载荷变体按
    // 位序,镜像 scalar_value.unwrap_or(i));ctors:"Enum.Variant"→字段数
    consts List<CGEnum>
    ctors List<CGEnum>
    // P2:循环 break/continue 占位回填(镜像宿主 H2 patch_jump_to;aavm
    // 侧首实现)。帧按层深 append-only(engine.at args_stack 同款,无
    // List.pop opcode);cont_tg 为各层 continue 落点(while=条件顶,
    // for=步进位)
    brk_js List<List<int>>
    cont_js List<List<int>>
    cont_tg List<int>
    loop_depth int
    // Plan 495: 镜像宿主 emit_source_line 的 current_source_line ——
    // 相邻同线 .line 去重状态(0=未发过)
    cur_line int
    // W1(Plan 511):struct 类型注册表(name→声明序字段名;镜像宿主
    // generic_registry 的 field_names/field_index 面);inst_ty=构造字面量
    // 绑定的类型名(str_flag/arr_flag 同款单值回传,let 绑定用)
    tys List<CGType>
    inst_ty str
    // W2(Plan 511):全局变量(镜像宿主 global_vars/global_inits——仅顶层
    // var/const;inits 记 init 表达式的 token 区间,fn main 体首重放用)
    global_vars List<str>
    global_inits List<CGInit>
    // W2:hi_idx=本 fn 槽位高 watermark(prolog locals 用;宿主 pop_scope
    // 释放槽位供姊妹作用域复用,但 fn locals 取分配高水位——两值分离);
    // scope_saves=各层入口 max_idx(弹出恢复)
    hi_idx int
    scope_saves List<int>
    // W3(Plan 511):use 记录(mod 名/逗号 items/通配);mod_name=本编译
    // 单元的模块名(""=主模块——全局键裸名,否则 mod. 前缀);defers=跨模块
    // 调用延迟解析(ins 指针+符号);mod_bases=链接后各 dep 模块起始
    // ins 下标(ev_run_files 初始化序用)
    uses List<CGUse>
    mod_name str
    defers List<CGDefer>
    mod_bases List<int>
    // W3:fn→模块名平行表(链接期符号定址用;单文件路径恒空)
    fn_mods List<str>
}

// W3:use 语句记录(kind:auto|rs|py|c)
type CGUse {
    kind str
    module str
    items str
    wildcard int
}

// W3:跨模块调用延迟解析条目(链接期定址)
type CGDefer {
    ins_idx int
    symbol str
}

// W3:名字是否在 use items(逗号连接串)中
fn cg_items_has(items str, name str) bool {
    var i = 0
    var start = 0
    var n = items.len()
    while i <= n {
        var at_end = i == n
        var is_sep = false
        if !at_end {
            if items.char_at(i) == ',' {
                is_sep = true
            }
        }
        if at_end || is_sep {
            if items.slice(start, i) == name {
                return true
            }
            start = i + 1
        }
        i = i + 1
    }
    return false
}

// W3:裸名 → 导入符号(遍历 uses:定向 items 命中或通配;返回 "mod.name",
// 未命中返回 "")
fn cg_import_symbol(c CG, name str) str {
    var i = 0
    while i < c.uses.len() {
        var u = c.uses.get(i)
        if u.kind == "auto" {
            if u.wildcard == 1 || cg_items_has(u.items, name) {
                return u.module + "." + name
            }
        }
        i = i + 1
    }
    return ""
}

// W3:名字是否为已 use 的模块名(限定调用 db.fn 判定)
fn cg_is_module(c CG, name str) bool {
    var i = 0
    while i < c.uses.len() {
        if c.uses.get(i).module == name {
            return true
        }
        i = i + 1
    }
    return false
}

// W2:全局初始化重放条目(name + init 表达式 token 闭区间)
type CGInit {
    name str
    from int
    to int
}

// W3:全局键限名(模块编译单元内 mod. 前缀;主模块裸名——镜像宿主
// current_module/qualified_global_name)
fn cg_gkey(c CG, name str) str {
    if c.mod_name == "" {
        return name
    }
    return c.mod_name + "." + name
}

// W2:名字是否已入全局集
fn cg_is_global(c CG, name str) bool {
    var i = 0
    while i < c.global_vars.len() {
        if c.global_vars.get(i) == name {
            return true
        }
        i = i + 1
    }
    return false
}

type CGEnum {
    key str
    val int
}

type CGType {
    name str
    fields List<str>
}

// W1:按类型名查注册表下标(-1=未注册)
fn cg_tys_lookup(c CG, name str) int {
    var i = 0
    while i < c.tys.len() {
        if c.tys.get(i).name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

// W1:字段在类型声明序中的下标(-1=无该字段)
fn cg_field_idx(c CG, tyname str, field str) int {
    var ti = cg_tys_lookup(c, tyname)
    if ti < 0 {
        return -1
    }
    var fl = c.tys.get(ti).fields
    var j = 0
    while j < fl.len() {
        if fl.get(j) == field {
            return j
        }
        j = j + 1
    }
    return -1
}

fn cg_const_lookup(c CG, key str) int {
    var i = 0
    while i < c.consts.len() {
        if c.consts.get(i).key == key {
            return c.consts.get(i).val
        }
        i = i + 1
    }
    return -999999
}

fn cg_ctor_lookup(c CG, key str) int {
    var i = 0
    while i < c.ctors.len() {
        if c.ctors.get(i).key == key {
            return c.ctors.get(i).val
        }
        i = i + 1
    }
    return -999999
}

fn cg_new() CG {
    var scs List<List<CGVar>> = List.new()
    var base List<CGVar> = List.new()
    scs.push(base)
    var ins_l List<I> = List.new()
    var pool List<str> = List.new()
    var fns List<FnEntry> = List.new()
    var consts_l List<CGEnum> = List.new()
    var ctors_l List<CGEnum> = List.new()
    var brk_l List<List<int>> = List.new()
    var cont_l List<List<int>> = List.new()
    var ctg_l List<int> = List.new()
    var tys_l List<CGType> = List.new()
    var gv_l List<str> = List.new()
    var gi_l List<CGInit> = List.new()
    var saves_l List<int> = List.new()
    var uses_l List<CGUse> = List.new()
    var defers_l List<CGDefer> = List.new()
    var bases_l List<int> = List.new()
    var fmods_l List<str> = List.new()
    return CG(ins_l, pool, fns, scs, 1, 0, -1, "", 0, 0, consts_l, ctors_l, brk_l, cont_l, ctg_l, 0, 0, tys_l, "", gv_l, gi_l, -1, saves_l, uses_l, "", defers_l, bases_l, fmods_l)
}

// P2:进循环层——帧占位列表 + continue 落点(读改写回填,VM 引用语义
// 与 a2r 值语义两可;镜像 ev_arr_write 写回注释)
fn cg_loop_enter(mut c CG, cont_target int) {
    var bl List<int> = List.new()
    c.brk_js.push(bl)
    var cl List<int> = List.new()
    c.cont_js.push(cl)
    c.cont_tg.push(cont_target)
    c.loop_depth = c.loop_depth + 1
}

// P2:出循环层——continue 占位 → 本层落点;break 占位 → 循环后
fn cg_loop_exit(mut c CG, brk_target int) {
    var d = c.loop_depth - 1
    if d < 0 {
        cg_err(c, "loop exit without enter")
        return
    }
    var cj = c.cont_js.get(d)
    var j = 0
    while j < cj.len() {
        c.ins.get(cj.get(j)).n = c.cont_tg.get(d)
        j = j + 1
    }
    var bj = c.brk_js.get(d)
    var b = 0
    while b < bj.len() {
        c.ins.get(bj.get(b)).n = brk_target
        b = b + 1
    }
    c.loop_depth = d
}

// P2:break/continue 语句发射(占位 Jmp 入本层帧;层外报错)
fn cg_loop_jump(mut c CG, k TokenKind) {
    if c.loop_depth == 0 {
        cg_err(c, "break/continue outside loop")
        return
    }
    var j = emit(c, OpCode.Jmp, "", -1)
    if k == TokenKind.Continue {
        var fr = c.cont_js.get(c.loop_depth - 1)
        fr.push(j)
        c.cont_js.set(c.loop_depth - 1, fr)
    } else {
        var fr2 = c.brk_js.get(c.loop_depth - 1)
        fr2.push(j)
        c.brk_js.set(c.loop_depth - 1, fr2)
    }
}

fn cg_err(mut c CG, msg str) {
    if c.err == "" {
        c.err = "CODEGEN-ERROR:" + msg
    }
}

// 前瞻 token 文本(原始,不跳注释;corpus 括号内无注释)
fn p_peek_text(p P, n int) str {
    var i = p.pos + n
    if i >= p.toks.len() {
        return ""
    }
    return p.toks.get(i).text
}

// 指令字节宽度(与 Rust opcode 编码一致;S4 子集)。new.instance/
// is.variant 的名字内联字节随名长(Plan 447 部分②);get.generic.field
// 的 u32 操作数在 Rust 侧按 1B 操作数+3B 残留(nop)错位展示,照抄
enum OpCode {
    Line
    Add
    Sub
    Mul
    Div
    Mod
    Eq
    Ne
    Lt
    Gt
    Le
    Ge
    And
    Or
    Not
    Neg
    StrCat
    ConstI32
    LoadStr
    LoadLoc0
    LoadLoc1
    LoadLoc2
    LoadLocal
    StoreLoc0
    StoreLoc1
    StoreLocal
    FnProlog
    Reserve
    Ret
    Call
    CallNat
    Jmp
    JmpZ
    JmpNz
    PushBool
    PushNil
    Dup
    Pop
    ArrLen
    CreateArr
    GetElem
    SetElem
    IsVariant
    NewInstance
    ConstructInstance
    GetGenericField
    BuildFstr
    Halt
    Nop
    Blank
    GetField
    SetField
    SetGenericField
    Const0
    LoadGlobal
    StoreGlobal
}

// 助记符文本(M4 dump 序列化的唯一口径;447-③C1:载体 str → OpCode)
fn op_name(op OpCode) str {
    is op {
        OpCode.Line -> ".line"
        OpCode.Add -> "add"
        OpCode.Sub -> "sub"
        OpCode.Mul -> "mul"
        OpCode.Div -> "div"
        OpCode.Mod -> "mod"
        OpCode.Eq -> "eq"
        OpCode.Ne -> "ne"
        OpCode.Lt -> "lt"
        OpCode.Gt -> "gt"
        OpCode.Le -> "le"
        OpCode.Ge -> "ge"
        OpCode.And -> "and"
        OpCode.Or -> "or"
        OpCode.Not -> "not"
        OpCode.Neg -> "neg"
        OpCode.StrCat -> "str.cat"
        OpCode.ConstI32 -> "const.i32"
        OpCode.LoadStr -> "load.str"
        OpCode.LoadLoc0 -> "load.loc.0"
        OpCode.LoadLoc1 -> "load.loc.1"
        OpCode.LoadLoc2 -> "load.loc.2"
        OpCode.LoadLocal -> "load.local"
        OpCode.StoreLoc0 -> "store.loc.0"
        OpCode.StoreLoc1 -> "store.loc.1"
        OpCode.StoreLocal -> "store.local"
        OpCode.FnProlog -> "fn.prolog"
        OpCode.Reserve -> "reserve"
        OpCode.Ret -> "ret"
        OpCode.Call -> "call"
        OpCode.CallNat -> "call.nat"
        OpCode.Jmp -> "jmp"
        OpCode.JmpZ -> "jmp.z"
        OpCode.JmpNz -> "jmp.nz"
        OpCode.PushBool -> "push.bool"
        OpCode.PushNil -> "push.nil"
        OpCode.Dup -> "dup"
        OpCode.Pop -> "pop"
        OpCode.ArrLen -> "arr.len"
        OpCode.CreateArr -> "create.arr"
        OpCode.GetElem -> "get.elem"
        OpCode.SetElem -> "set.elem"
        OpCode.IsVariant -> "is.variant"
        OpCode.NewInstance -> "new.instance"
        OpCode.ConstructInstance -> "construct.instance"
        OpCode.GetGenericField -> "get.generic.field"
        OpCode.BuildFstr -> "build.fstr"
        OpCode.Halt -> "halt"
        OpCode.Nop -> "nop"
        OpCode.GetField -> "get.field"
        OpCode.SetField -> "set.field"
        OpCode.SetGenericField -> "set.generic.field"
        OpCode.Const0 -> "const.0"
        OpCode.LoadGlobal -> "load.global"
        OpCode.StoreGlobal -> "store.global"
        else -> ""
    }
}

fn i_size(op OpCode) int {
    is op {
        OpCode.FnProlog -> 3
        OpCode.Reserve -> 2
        OpCode.Jmp | OpCode.JmpZ | OpCode.JmpNz -> 3
        OpCode.Line -> 3
        OpCode.LoadStr -> 5
        OpCode.Call -> 5
        OpCode.CallNat -> 3
        OpCode.ConstI32 -> 5
        OpCode.PushBool -> 2
        OpCode.Ret -> 2
        OpCode.LoadLocal | OpCode.StoreLocal -> 2
        OpCode.CreateArr -> 2
        OpCode.GetGenericField -> 2
        // W1:get.field 真宽 u32(5);set.generic.field 同 get.generic.field
        // 的 u8 读宽形态(2+幽灵 nop);set.field 无操作数(1)
        OpCode.GetField -> 5
        OpCode.SetField -> 1
        OpCode.SetGenericField -> 2
        OpCode.Const0 -> 1
        OpCode.LoadGlobal -> 5
        OpCode.StoreGlobal -> 5
        else -> 1
    }
}

// 名字内联指令的字节宽(new.instance=1+名长;is.variant=3+名长:
// 操作码+u16 名长+名字节,镜像宿主 emit_u16 + bytes)
fn i_size_named(op OpCode, s str, n int) int {
    var name = s
    // s 形如 "\"Val.VI\"" —— 剥引号
    if name.len() >= 2 && name.char_at(0) == '"' {
        name = name.slice(1, name.len() - 1)
    }
    if op == OpCode.NewInstance {
        return 1 + name.len()
    }
    if op == OpCode.IsVariant {
        return 3 + name.len()
    }
    // build.fstr:操作码+u8 段数+每段 u8 tag(镜像宿主 BUILD_FSTR)
    if op == OpCode.BuildFstr {
        return 2 + n
    }
    return i_size(op)
}

// 发射一条指令,返回其指令索引
fn emit(mut c CG, op OpCode, s str, n int) int {
    c.ins.push(I(op, s, n))
    return c.ins.len() - 1
}

// Plan 495: 镜像宿主 emit_source_line —— line>0 且异于当前已发行才发
// SOURCE_LINE(相邻同线去重,与宿主 current_source_line 同款状态机)
fn cg_line(mut c CG, ln int) {
    if ln > 0 && ln != c.cur_line {
        c.cur_line = ln
        emit(c, OpCode.Line, ln.str(), 0)
    }
}

// ── 作用域(depth 计数;深度≥3 弹出时发槽释放组) ───────────────

fn cg_push_scope(mut c CG) {
    // W2:记录本层入口 max_idx(弹出恢复——宿主 pop_scope 释放槽位,
    // 姊妹作用域复用槽号;b38 三循环实证)
    if c.scope_saves.len() < c.depth + 1 {
        c.scope_saves.push(c.max_idx)
    } else {
        c.scope_saves.set(c.depth, c.max_idx)
    }
    // Plan 447 部分②修复:多 fn 复用槽位时必须换新空表——旧实现无条件
    // push,第二個 fn 按深度取到前一 fn 的残留作用域(其体内变量泄漏进
    // 后续 fn 的释放组/查找域;is 的 _is_target 首次暴露)。表长仍只增
    // 不减(D25 写法保持)
    if c.depth == c.scopes.len() {
        var sc List<CGVar> = List.new()
        c.scopes.push(sc)
    } else {
        var fresh List<CGVar> = List.new()
        c.scopes.set(c.depth, fresh)
    }
    c.depth = c.depth + 1
}

// 弹出作用域:depth>2 时对栈顶域的槽按升序发 push.nil+store
fn cg_pop_scope(mut c CG) {
    if c.depth > 1 {
        if c.depth > 2 {
            var sc = c.scopes.get(c.depth - 1)
            var slots = cg_sort_ints_of_vars(sc)
            var m = 0
            while m < slots.len() {
                emit(c, OpCode.PushNil, "", 0)
                cg_emit_store(c, slots.get(m))
                m = m + 1
            }
        }
        c.depth = c.depth - 1
        // W2:恢复槽位分配游标(本层槽号可复用;hi_idx 高水位不受影响)
        if c.scope_saves.len() >= c.depth + 1 {
            c.max_idx = c.scope_saves.get(c.depth)
        }
    }
}

// W2:静默弹出(无释放组)——Call 迭代器协议通道专用:宿主 2747-2829
// 的 _iterator/循环变量不入释放组(实测 b38:循环尾无 push.nil+store)
fn cg_pop_scope_silent(mut c CG) {
    if c.depth > 1 {
        c.depth = c.depth - 1
        if c.scope_saves.len() >= c.depth + 1 {
            c.max_idx = c.scope_saves.get(c.depth)
        }
    }
}

// 域内变量 idx 升序收集
fn cg_sort_ints_of_vars(sc List<CGVar>) List<int> {
    var out List<int> = List.new()
    var k = 0
    while k < sc.len() {
        out.push(sc.get(k).idx)
        k = k + 1
    }
    var a = 0
    while a < out.len() {
        var b = a + 1
        while b < out.len() {
            if out.get(b) < out.get(a) {
                var t = out.get(a)
                out.set(a, out.get(b))
                out.set(b, t)
            }
            b = b + 1
        }
        a = a + 1
    }
    return out
}

fn cg_add_var(mut c CG, name str, arr int, ty str) int {
    var next = c.max_idx + 1
    c.max_idx = next
    if next > c.hi_idx {
        c.hi_idx = next
    }
    // 提升+写回(VM 引用语义同写回;a2r 值语义写回修改副本)
    var sc = c.scopes.get(c.depth - 1)
    // Plan 447 部分②:同名重登记按名覆盖(镜像宿主 add_var 的 HashMap
    // 按名 insert——旧槽从表中消失:不再释放也不被查找;多次 is 的
    // _is_target 首次暴露该差异)。max_idx 单调计数 = 宿主高水位
    var replaced = false
    var ri = 0
    while ri < sc.len() {
        if sc.get(ri).name == name {
            sc.set(ri, CGVar(name, next, arr, ty))
            replaced = true
        }
        ri = ri + 1
    }
    if !replaced {
        sc.push(CGVar(name, next, arr, ty))
    }
    c.scopes.set(c.depth - 1, sc)
    return next
}

// 按 idx 反查变量的数组性(.len() 接收者判定)
fn cg_var_arr(mut c CG, idx int) int {
    var s = c.depth - 1
    while s >= 0 {
        var sc = c.scopes.get(s)
        var i = sc.len() - 1
        while i >= 0 {
            if sc.get(i).idx == idx {
                return sc.get(i).arr
            }
            i = i - 1
        }
        s = s - 1
    }
    return 0
}

// 按名查变量类型(11.2a:build.fstr 段 tag;""=int/未知,宿主默认同)
fn cg_var_ty(mut c CG, name str) str {
    var s = c.depth - 1
    while s >= 0 {
        var sc = c.scopes.get(s)
        var i = sc.len() - 1
        while i >= 0 {
            if sc.get(i).name == name {
                return sc.get(i).ty
            }
            i = i - 1
        }
        s = s - 1
    }
    return ""
}

fn cg_lookup(mut c CG, name str) int {
    var s = c.depth - 1
    while s >= 0 {
        var sc = c.scopes.get(s)
        var i = sc.len() - 1
        while i >= 0 {
            if sc.get(i).name == name {
                return sc.get(i).idx
            }
            i = i - 1
        }
        s = s - 1
    }
    return -1
}

// ── 寻址发射(param:0x80+rel;局部 rel 0/1 → loc.0/loc.1,否则 local N) ──

fn cg_emit_store(mut c CG, idx int) {
    if idx < c.n_args {
        var sv = (128 + idx).str()
        emit(c, OpCode.StoreLocal, sv, 128 + idx)
        return
    }
    var rel = idx - c.n_args
    if rel == 0 {
        emit(c, OpCode.StoreLoc0, "0", 0)
    } else if rel == 1 {
        emit(c, OpCode.StoreLoc1, "1", 1)
    } else {
        var sv2 = rel.str()
        emit(c, OpCode.StoreLocal, sv2, rel)
    }
}

fn cg_emit_load(mut c CG, idx int) {
    if idx < c.n_args {
        var lv = (128 + idx).str()
        emit(c, OpCode.LoadLocal, lv, 128 + idx)
        return
    }
    var rel = idx - c.n_args
    if rel == 0 {
        emit(c, OpCode.LoadLoc0, "0", 0)
    } else if rel == 1 {
        emit(c, OpCode.LoadLoc1, "1", 1)
    } else if rel == 2 {
        emit(c, OpCode.LoadLoc2, "2", 2)
    } else {
        var lv2 = rel.str()
        emit(c, OpCode.LoadLocal, lv2, rel)
    }
}

// ── 字符串池(内容寻址去重) ────────────────────────────────────

fn cg_pool_add(mut c CG, s str) int {
    var i = 0
    while i < c.pool.len() {
        if c.pool.get(i) == s {
            return i
        }
        i = i + 1
    }
    c.pool.push(s)
    return c.pool.len() - 1
}

// W1:名字池非去重追加(get.field 操作数专用——镜像宿主 5842-5848 的
// 直接 strings.push,不去重;load.str/set.field 路径仍走 cg_pool_add)
fn cg_pool_push(mut c CG, s str) int {
    c.pool.push(s)
    return c.pool.len() - 1
}

// ── 表达式发射 ────────────────────────────────────────────────

fn cg_binop_mnem(k Op) OpCode {
    if k == Op.Add || k == Op.AddEq {
        return OpCode.Add
    }
    if k == Op.Sub || k == Op.SubEq {
        return OpCode.Sub
    }
    if k == Op.Mul || k == Op.MulEq {
        return OpCode.Mul
    }
    if k == Op.Div || k == Op.DivEq {
        return OpCode.Div
    }
    if k == Op.Mod || k == Op.ModEq {
        return OpCode.Mod
    }
    if k == Op.Eq {
        return OpCode.Eq
    }
    if k == Op.Neq {
        return OpCode.Ne
    }
    if k == Op.Lt {
        return OpCode.Lt
    }
    if k == Op.Gt {
        return OpCode.Gt
    }
    if k == Op.Le {
        return OpCode.Le
    }
    if k == Op.Ge {
        return OpCode.Ge
    }
    if k == Op.And {
        return OpCode.And
    }
    if k == Op.Or {
        return OpCode.Or
    }
    return OpCode.Blank
}

fn cg_is_assign_op(k Op) bool {
    is k {
        Op.Asn | Op.AddEq | Op.SubEq | Op.MulEq | Op.DivEq | Op.ModEq -> true
        else -> false
    }
}

// 值表达式发射(优先级爬升;复用 parser.at 的 infix_l/infix_r/is_op_kind)
// f-string 发射(447-③ 11.2a;镜像宿主 codegen.rs 4990 BUILD_FSTR):
// 逐段先发射(字面段 load.str;$Ident 变量加载;${expr} 子 tokenize +
// cg_expr 直走),再发 build.fstr(count + tags;tag:1=str 0=int,
// 镜像宿主 expr_type_hint——Ident 查变量表,非 str 即 int/未知 0)
fn cg_fstr(mut c CG, mut p P) {
    p_next(p)
    var content = p_text(p)
    p_next(p)
    p_next(p)
    var tags = ""
    var n_parts = 0
    var lit = ""
    var i = 0
    var n = content.len()
    while i < n {
        var ch = content.char_at(i)
        if ch == 36 {
            if lit != "" {
                var pi = cg_pool_add(c, lit)
                emit(c, OpCode.LoadStr, "", pi)
                tags = f"${tags}1"
                n_parts = n_parts + 1
                lit = ""
            }
            if i + 1 < n && content.char_at(i + 1) == 123 {
                var depth = 1
                var j = i + 2
                while j < n && depth > 0 {
                    var cj = content.char_at(j)
                    if cj == 123 {
                        depth = depth + 1
                    } else if cj == 125 {
                        depth = depth - 1
                    }
                    j = j + 1
                }
                if depth != 0 {
                    cg_err(c, "fstr: unterminated interpolation ")
                    return
                }
                var inner = content.slice(i + 2, j - 1)
                var subtoks = tokenize(inner)
                var subp = parse_new(subtoks)
                cg_expr(c, subp, 0)
                if c.err != "" || subp.err != "" {
                    return
                }
                var tg = 0
                if subp.pos < subtoks.len() {
                    var ftk = subtoks.get(0)
                    if ftk.kind == TokenKind.Ident && cg_var_ty(c, ftk.text) == "str" {
                        tg = 1
                    }
                }
                tags = tags + tg.str()
                n_parts = n_parts + 1
                i = j
            } else {
                var j2 = i + 1
                var stop = false
                while j2 < n && !stop {
                    var cj2 = content.char_at(j2)
                    var ok2 = (cj2 >= 97 && cj2 <= 122) || (cj2 >= 65 && cj2 <= 90) || (cj2 >= 48 && cj2 <= 57) || cj2 == 95
                    if !ok2 {
                        stop = true
                    } else {
                        j2 = j2 + 1
                    }
                }
                var nm = content.slice(i + 1, j2)
                var vi = cg_lookup(c, nm)
                if vi < 0 {
                    cg_err(c, "fstr: unknown ident $" + nm)
                    return
                }
                cg_emit_load(c, vi)
                var tg2 = 0
                if cg_var_ty(c, nm) == "str" {
                    tg2 = 1
                }
                tags = tags + tg2.str()
                n_parts = n_parts + 1
                i = j2
            }
        } else {
            lit = lit + content.slice(i, i + 1)
            i = i + 1
        }
    }
    if lit != "" {
        var pi2 = cg_pool_add(c, lit)
        emit(c, OpCode.LoadStr, "", pi2)
        tags = f"${tags}1"
        n_parts = n_parts + 1
    }
    // tags 文本对齐宿主 disasm:parts=N, tags=[0, 1]
    var txt = f"parts=${n_parts.str()}, tags=["
    var t3 = 0
    while t3 < n_parts {
        if t3 > 0 {
            txt = f"${txt}, "
        }
        txt = txt + tags.slice(t3, t3 + 1)
        t3 = t3 + 1
    }
    txt = f"${txt}]"
    emit(c, OpCode.BuildFstr, txt, n_parts)
    c.str_flag = 1
    c.arr_flag = 0
}

fn cg_expr(mut c CG, mut p P, min int) {
    if c.err != "" {
        return
    }
    var k = p_kind(p)
    // 每次表达式求值从干净 flag 起;原子按需置位(str/arr/inst_ty)
    c.str_flag = 0
    c.arr_flag = 0
    c.inst_ty = ""
    if k == TokenKind.Not {
        p_next(p)
        cg_expr(c, p, 28)
        emit(c, OpCode.Not, "", 0)
        c.str_flag = 0
        c.arr_flag = 0
    } else if k == TokenKind.Sub || k == TokenKind.Add {
        // 一元符号:operand 后发 neg(镜像 Rust 6414;一元 + 为 no-op)
        p_next(p)
        cg_expr(c, p, 28)
        if k == TokenKind.Sub {
            emit(c, OpCode.Neg, "", 0)
        }
        c.str_flag = 0
        c.arr_flag = 0
    } else if k == TokenKind.FStrStart {
        cg_fstr(c, p)
    } else if k == TokenKind.Int {
        var t = p_text(p)
        p_next(p)
        var cv = int_val(t).str()
        emit(c, OpCode.ConstI32, cv, int_val(t))
    } else if k == TokenKind.Str {
        var s = p_text(p)
        p_next(p)
        var idx = cg_pool_add(c, s)
        emit(c, OpCode.LoadStr, "", idx)
        c.str_flag = 1
    } else if k == TokenKind.True {
        p_next(p)
        emit(c, OpCode.PushBool, "true", 0)
    } else if k == TokenKind.False {
        p_next(p)
        emit(c, OpCode.PushBool, "false", 0)
    } else if k == TokenKind.Char {
        // Plan 447 部分②:字符字面量 → const.i32 码点(镜像宿主 Char 编译)
        var t = p_text(p)
        p_next(p)
        var cp = t.char_at(0)
        emit(c, OpCode.ConstI32, cp.str(), cp)
    } else if k == TokenKind.Ident {
        var name = p_text(p)
        // Plan 447 部分②:枚举路径前瞻判定(不消费)——注册命中才拦截,
        // 否则落回原标识符路径(方法调用 a.len() 等不受影响)。
        // Enum.Variant → const.i32 判别值;Enum.Variant(args) → 载荷
        // 构造(值…, const 名长, new.instance, const 字段数,
        // construct.instance —— 镜像宿主 generic_registry 路径 5128-5147)
        var is_enum_path = false
        var variant = ""
        if p_peek(p, 1) == TokenKind.Dot {
            var seg = p_peek_text(p, 2)
            var dk = f"${name}.${seg}"
            if cg_const_lookup(c, dk) != -999999 || cg_ctor_lookup(c, dk) >= 0 {
                is_enum_path = true
                variant = seg
            }
        }
        if is_enum_path {
            p_next(p)
            p_next(p)
            p_next(p)
            var key = f"${name}.${variant}"
            if p_kind(p) == TokenKind.LParen {
                var fc = cg_ctor_lookup(c, key)
                if fc < 0 {
                    cg_err(c, "unknown enum ctor: " + key)
                    return
                }
                cg_call_args(c, p)
                var nm = key.len()
                emit(c, OpCode.ConstI32, nm.str(), nm)
                emit(c, OpCode.NewInstance, "\"" + key + "\"", 0)
                emit(c, OpCode.ConstI32, fc.str(), fc)
                emit(c, OpCode.ConstructInstance, "", 0)
            } else {
                var dv = cg_const_lookup(c, key)
                emit(c, OpCode.ConstI32, dv.str(), dv)
            }
        } else {
        p_next(p)
        // W1 构造字面量:已注册类型紧随 { → NEW_INSTANCE 族发射;
        // inst_ty 回传类型名(let 绑定记 var_types 用)
        if p_kind(p) == TokenKind.LBrace && cg_tys_lookup(c, name) >= 0 {
            cg_ctor_emit(c, p, name)
            c.inst_ty = name
            return
        }
        // W3:模块限定调用 db.fn(...)(db 为已 use 模块名;镜像宿主
        // auto_modules + mod.fn reloc 符号——链接期定址;调用后可接
        // 后缀/中缀,故 call_done 包裹而非 return)
        var call_done = false
        if p_kind(p) == TokenKind.Dot && (p_peek(p, 1) == TokenKind.Ident || is_soft_ident_kind(p_peek(p, 1))) && p_peek(p, 2) == TokenKind.LParen && cg_is_module(c, name) {
            p_next(p)
            var qfn = p_text(p)
            p_next(p)
            // 接收者占位:宿主 Ident 模块兜底推 const.i32 0(Plan 437
            // 注记的已知占位泄漏——镜像;帧 bp 锚定下无害)
            emit(c, OpCode.ConstI32, "0", 0)
            cg_call_args(c, p)
            var qdi = emit(c, OpCode.Call, "", -1)
            c.defers.push(CGDefer(qdi, name + "." + qfn))
            call_done = true
        }
        if !call_done && name == "print" && p_kind(p) == TokenKind.LParen {
            cg_call_args(c, p)
            emit(c, OpCode.CallNat, "nat#10", 10)
        } else if !call_done && p_kind(p) == TokenKind.LParen {
            var fe = -1
            var fi = 0
            while fi < c.fns.len() {
                if c.fns.get(fi).name == name {
                    fe = fi
                }
                fi = fi + 1
            }
            if fe < 0 {
                // W3:导入名(use mod: item / 通配)→ 延迟调用,链接期定址
                // (无 return:调用结果可接后缀/中缀,如 get_base() * 2)
                var isym = cg_import_symbol(c, name)
                if isym != "" {
                    cg_call_args(c, p)
                    var idi = emit(c, OpCode.Call, "", -1)
                    c.defers.push(CGDefer(idi, isym))
                } else {
                    cg_err(c, "unknown fn: " + name)
                    return
                }
            } else {
                cg_call_args(c, p)
                emit(c, OpCode.Call, "", fe)
            }
        } else if !call_done {
            var idx = cg_lookup(c, name)
            if idx < 0 {
                // W2:全局读(镜像宿主读链 局部>全局 优先序;W3 模块限名)
                if cg_is_global(c, cg_gkey(c, name)) {
                    var gidx = cg_pool_add(c, cg_gkey(c, name))
                    emit(c, OpCode.LoadGlobal, gidx.str(), gidx)
                    c.arr_flag = 0
                } else {
                    cg_err(c, "unknown ident: " + name)
                    return
                }
            } else {
                cg_emit_load(c, idx)
                c.arr_flag = cg_var_arr(c, idx)
                // W2:str 型变量加载置 str_flag(镜像宿主 var_types 的
                // String 性——s[i]+s[j] 发 str.cat;b39 实证)
                if cg_var_ty(c, name) == "str" {
                    c.str_flag = 1
                }
            }
        }
        }
    } else if k == TokenKind.LParen {
        // W2:括号 group 透明(镜像宿主 group();-(x+y) 形态经此)
        p_next(p)
        cg_expr(c, p, 0)
        p_expect(p, TokenKind.RParen)
    } else if k == TokenKind.LSquare {
        // 数组字面量:elems 依次入栈,create.arr count=N(Rust 4865)
        p_next(p)
        skip_empty_lines(p)
        var n = 0
        if p_kind(p) != TokenKind.RSquare {
            cg_expr(c, p, 0)
            n = 1
            while p_kind(p) == TokenKind.Comma || p_kind(p) == TokenKind.Newline {
                p_next(p)
                skip_empty_lines(p)
                cg_expr(c, p, 0)
                n = n + 1
            }
        }
        p_expect(p, TokenKind.RSquare)
        emit(c, OpCode.CreateArr, "count=" + n.str(), n)
        c.arr_flag = 1
    } else {
        cg_err(c, "unsupported expr atom: " + kind_name(k))
        return
    }
    // 后缀链:下标读(get.elem);.len()(仅数组接收者,镜像 Rust 7177 闸)
    // W2:str_flag 保留——宿主字符串性穿透下标(b39:s[i]+s[j] 发 str.cat)
    while c.err == "" && p_kind(p) == TokenKind.LSquare {
        p_next(p)
        skip_empty_lines(p)
        // W2:str_flag 穿透下标——下标子表达式的 cg_expr 头部会清位,
        // 此处保存/恢复(宿主字符串性穿透;b39:s[i]+s[j] 发 str.cat)
        var save_str = c.str_flag
        cg_expr(c, p, 0)
        c.str_flag = save_str
        skip_empty_lines(p)
        p_expect(p, TokenKind.RSquare)
        emit(c, OpCode.GetElem, "", 0)
        c.arr_flag = 0
    }
    if c.err == "" && p_kind(p) == TokenKind.Dot && p_peek_text(p, 1) == "len" && p_peek(p, 2) == TokenKind.LParen && p_peek(p, 3) == TokenKind.RParen {
        if c.arr_flag != 1 {
            cg_err(c, ".len() receiver is not an array")
            return
        }
        p_next(p)
        p_next(p)
        p_next(p)
        p_next(p)
        emit(c, OpCode.ArrLen, "", 0)
        c.str_flag = 0
        c.arr_flag = 0
    }
    // W1:点访问链深(0=原子直连首跳 → get.field;>0 链式后续跳 →
    // get.generic.field field=0 幽灵 nop 形态)
    var dot_seq = 0
    while c.err == "" {
        var opk = p_kind(p)
        // P2:循环顶 token 分派 is 化(11 种界符臂内 break;镜像 Rust
        // parser.rs:2425 的 match kind)
        is opk {
            TokenKind.EOF | TokenKind.Newline | TokenKind.Semi | TokenKind.LBrace | TokenKind.RBrace | TokenKind.Comma | TokenKind.Arrow | TokenKind.DoubleArrow | TokenKind.VBar | TokenKind.RSquare | TokenKind.RParen -> {
                break
            }
            else -> {
                if opk == TokenKind.Dot && t_is_type_prop(p) {
                    break
                }
                // W1 字段读:Dot+名(非 .type/非方法调用)→ 接收者已在
                // 栈,get.field field[N](名字池非去重追加——镜像宿主
                // 5842-5848 直接 push;读路径不分 var_types 形态,
                // 宿主非泛型与 fallback 同一发射);字段访问消费完直接
                // 回循环顶,不走通用中缀
                var dot_done = false
                if opk == TokenKind.Dot {
                    var fk2 = p_peek(p, 1)
                    if fk2 == TokenKind.Ident || is_soft_ident_kind(fk2) {
                        if p_peek(p, 2) == TokenKind.LParen {
                            cg_err(c, "unsupported method call: ." + p_peek_text(p, 1))
                            break
                        }
                        var fname2 = p_peek_text(p, 1)
                        p_next(p)
                        p_next(p)
                        if dot_seq == 0 {
                            // 首跳(原子直连,宿主 Ident 接收者 var_types 命中/
                            // User 型):get.field field[N](名字池非去重追加)
                            var fidx4 = cg_pool_push(c, fname2)
                            emit(c, OpCode.GetField, "field[" + fidx4.str() + "]", fidx4)
                        } else {
                            // 链式后续跳(接收者已是表达式,宿主 untyped
                            // fallback):get.generic.field field=0 + 3 幽灵 nop
                            emit(c, OpCode.GetGenericField, "field=0", 0)
                            emit(c, OpCode.Nop, "", 0)
                            emit(c, OpCode.Nop, "", 0)
                            emit(c, OpCode.Nop, "", 0)
                        }
                        dot_seq = dot_seq + 1
                        c.str_flag = 0
                        c.arr_flag = 0
                        c.inst_ty = ""
                        dot_done = true
                    } else {
                        cg_err(c, "unsupported dot access: ." + p_peek_text(p, 1))
                        break
                    }
                }
                if !dot_done {
                if !is_op_kind(opk) {
                    cg_err(c, "expected infix op, got " + kind_name(opk))
                    break
                }
                var l = infix_l(p_op(opk))
                if l == 0 || l < min {
                    break
                }
                if cg_is_assign_op(p_op(opk)) {
                    cg_err(c, "nested assignment unsupported")
                    break
                }
                p_next(p)
                if opk == TokenKind.Or || opk == TokenKind.And {
                    skip_empty_lines(p)
                }
                var lhs_str = c.str_flag
                c.str_flag = 0
                cg_expr(c, p, infix_r(p_op(opk)))
                var rhs_str = c.str_flag
                var mn = cg_binop_mnem(p_op(opk))
                if opk == TokenKind.Add && (lhs_str == 1 || rhs_str == 1) {
                    mn = OpCode.StrCat
                    c.str_flag = 1
                } else {
                    c.str_flag = 0
                }
                c.arr_flag = 0
                if mn != OpCode.Blank {
                    emit(c, mn, "", 0)
                }
                }
            }
        }
    }
}

// 调用实参:( 已在 cur;消费至 RParen
fn cg_call_args(mut c CG, mut p P) {
    p_next(p)
    skip_empty_lines(p)
    if p_kind(p) != TokenKind.RParen {
        cg_expr(c, p, 0)
        while p_kind(p) == TokenKind.Comma || p_kind(p) == TokenKind.Newline {
            p_next(p)
            skip_empty_lines(p)
            cg_expr(c, p, 0)
        }
    }
    p_expect(p, TokenKind.RParen)
}

// ── 语句发射(.line 由语句步行者发,见 cg_stmts) ────────────────

// ── 枚举声明注册(Plan 447 部分② Phase 6:镜像宿主 Stmt::EnumDecl 的
// enum_values + generic_registry 注册,零字节码)────────────────

fn cg_enum_decl(mut c CG, mut p P) {
    p_next(p)
    if !is_name_kind(p_kind(p)) {
        cg_err(c, "expected enum name")
        return
    }
    var name = p_text(p)
    p_next(p)
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    var next_val = 0
    var idx = 0
    while c.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RBrace {
        if !is_name_kind(p_kind(p)) {
            cg_err(c, "expected variant name")
            return
        }
        var vname = p_text(p)
        p_next(p)
        var key = f"${name}.${vname}"
        var nfields = 0
        var has_payload = false
        if p_kind(p) == TokenKind.LParen {
            p_next(p)
            skip_empty_lines(p)
            has_payload = true
            if p_kind(p) != TokenKind.RParen {
                var more = true
                while more {
                    parse_type(p)
                    nfields = nfields + 1
                    if p_kind(p) == TokenKind.Comma {
                        p_next(p)
                        skip_empty_lines(p)
                    } else {
                        more = false
                    }
                }
            }
            p_expect(p, TokenKind.RParen)
        } else if p_kind(p) == TokenKind.LBrace {
            p_next(p)
            skip_empty_lines(p)
            has_payload = true
            while c.err == "" && p_kind(p) != TokenKind.RBrace && p_kind(p) != TokenKind.EOF {
                if !is_name_kind(p_kind(p)) {
                    cg_err(c, "expected variant field name")
                    return
                }
                p_next(p)
                if p_kind(p) == TokenKind.Colon {
                    p_next(p)
                }
                parse_type(p)
                nfields = nfields + 1
                if p_kind(p) == TokenKind.Comma {
                    p_next(p)
                    skip_empty_lines(p)
                }
                skip_empty_lines(p)
            }
            p_expect(p, TokenKind.RBrace)
        }
        // 判别值:scalar 链(auto/显式 = N)或载荷变体按位序(镜像宿主
        // scalar_value.unwrap_or(i);载荷不入 Display 值链)
        var val = next_val
        if has_payload {
            val = idx
        }
        if p_kind(p) == TokenKind.Asn {
            p_next(p)
            if p_kind(p) != TokenKind.Int {
                cg_err(c, "unsupported enum value")
                return
            }
            val = int_val(p_text(p))
            p_next(p)
            next_val = val + 1
        } else if !has_payload {
            next_val = val + 1
        }
        c.consts.push(CGEnum(key, val))
        if has_payload {
            c.ctors.push(CGEnum(key, nfields))
        }
        idx = idx + 1
        // 变体间空行:静默跳过
        while p_kind(p) == TokenKind.Semi || p_kind(p) == TokenKind.Newline || p_kind(p) == TokenKind.Comma {
            p_next(p)
        }
        skip_empty_lines(p)
    }
    p_expect(p, TokenKind.RBrace)
}

// ── is 语句发射(Plan 447 部分② Phase 6:镜像宿主 Stmt::Is 3417-3800)──

// 臂体:{...} 块(compile_body_inline,不推作用域);return 单语句;
// 其余单表达式(无 pop,镜像 Stmt::Expr 语句)
fn cg_is_arm_body(mut c CG, mut p P) {
    if p_kind(p) == TokenKind.LBrace {
        cg_body_inline(c, p)
        return
    }
    // Plan 495: 非块体 arm 体镜像宿主 parse_expr_or_body 的 stmt_line——
    // arm 体首 token 行经 cg_line 发射(块体由 cg_stmts 按体内语句发)
    cg_line(c, p_line(p))
    if p_kind(p) == TokenKind.Return {
        cg_stmt(c, p)
        return
    }
    if p_kind(p) == TokenKind.Break || p_kind(p) == TokenKind.Continue {
        cg_stmt(c, p)
        return
    }
    cg_expr(c, p, 0)
}

// 单模式比较发射:load t;<pattern 表达式>;eq —— 标量枚举判别值直接
// const.i32,字面量按各自形态
// W3(Plan 511)use 语句消费+记录(词法形态镜像 parser.at parse_use;
// use.rs/py 的域外报错归模块解析器 cg_resolve——此处仅消费)
fn cg_use(mut c CG, mut p P) {
    p_next(p)
    if p_kind(p) == TokenKind.Dot {
        var lang = p_peek_text(p, 1)
        p_next(p)
        p_next(p)
        var path = p_text(p)
        p_next(p)
        while p_kind(p) == TokenKind.Colon && p_peek(p, 1) == TokenKind.Colon {
            p_next(p)
            p_next(p)
            path = path + "." + p_text(p)
            p_next(p)
        }
        var kind = "rs"
        if lang == "py" {
            kind = "py"
        } else if lang == "c" {
            kind = "c"
        }
        c.uses.push(CGUse(kind, path, "", 0))
        return
    }
    if !is_name_kind(p_kind(p)) {
        cg_err(c, "expected module name after use")
        return
    }
    var name = p_text(p)
    p_next(p)
    while p_kind(p) == TokenKind.Dot {
        p_next(p)
        if !is_name_kind(p_kind(p)) {
            cg_err(c, "expected path segment after dot")
            return
        }
        name = name + "." + p_text(p)
        p_next(p)
    }
    var items = ""
    var wildcard = 0
    if p_kind(p) == TokenKind.Colon {
        p_next(p)
        if p_kind(p) == TokenKind.Star {
            p_next(p)
            wildcard = 1
        } else {
            if !is_name_kind(p_kind(p)) {
                cg_err(c, "expected identifier or *")
                return
            }
            items = p_text(p)
            p_next(p)
            while p_kind(p) == TokenKind.Comma {
                p_next(p)
                if !is_name_kind(p_kind(p)) {
                    cg_err(c, "expected identifier")
                    return
                }
                items = items + "," + p_text(p)
                p_next(p)
            }
        }
    }
    c.uses.push(CGUse("auto", name, items, wildcard))
}

// ── W1 struct 声明注册(Plan 511:镜像宿主 Stmt::TypeDecl 的
// register_type——零字节码,字段名表入 c.tys)─────────────────

fn cg_type_decl(mut c CG, mut p P) {
    p_next(p)
    if !is_name_kind(p_kind(p)) {
        cg_err(c, "expected type name")
        return
    }
    var name = p_text(p)
    p_next(p)
    // 裁剪面同 parser.at parse_type_decl(v2 unsupported 族)
    if p_kind(p) == TokenKind.Lt {
        cg_err(c, "v2 unsupported: type generic params")
        return
    }
    if p_kind(p) == TokenKind.Asn {
        cg_err(c, "v2 unsupported: type alias")
        return
    }
    if p_kind(p) == TokenKind.Is {
        cg_err(c, "v2 unsupported: type inheritance")
        return
    }
    if p_kind(p) == TokenKind.As {
        cg_err(c, "v2 unsupported: type as")
        return
    }
    if p_kind(p) == TokenKind.Has {
        cg_err(c, "v2 unsupported: type has")
        return
    }
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    var fields List<str> = List.new()
    while c.err == "" && p.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RBrace {
        if p_kind(p) == TokenKind.Fn || p_kind(p) == TokenKind.Static {
            cg_err(c, "v2 unsupported: method in type")
            return
        }
        if p_kind(p) == TokenKind.Hash {
            cg_err(c, "v2 unsupported: member attr")
            return
        }
        if !is_name_kind(p_kind(p)) {
            cg_err(c, "expected member name")
            return
        }
        var fname = p_text(p)
        p_next(p)
        if p_kind(p) == TokenKind.Colon {
            p_next(p)
        }
        parse_type(p)
        if p_kind(p) == TokenKind.Asn {
            cg_err(c, "v2 unsupported: member default value")
            return
        }
        fields.push(fname)
        // 成员间空行:静默跳过
        expect_eos(p)
        skip_empty_lines(p)
    }
    p_expect(p, TokenKind.RBrace)
    c.tys.push(CGType(name, fields))
}

// W1 构造字面量发射 X { a: e1, b: e2 }:( 已在 cur 由调用方判别;
// 镜像宿主 NEW_INSTANCE 族 5270-5319:字段值按字面量序 → const.i32
// 名长 → new.instance → const.i32 字段数 → construct.instance)
fn cg_ctor_emit(mut c CG, mut p P, name str) {
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    var n = 0
    while c.err == "" && p.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RBrace {
        var k = p_kind(p)
        if k != TokenKind.Ident && !is_soft_ident_kind(k) {
            cg_err(c, "expected field name in struct ctor")
            return
        }
        p_next(p)
        p_expect(p, TokenKind.Colon)
        cg_expr(c, p, 0)
        n = n + 1
        var sk = p_kind(p)
        if sk == TokenKind.Comma || sk == TokenKind.Newline {
            p_next(p)
            skip_empty_lines(p)
        } else if sk != TokenKind.RBrace {
            cg_err(c, "expected pair separator")
        }
    }
    p_expect(p, TokenKind.RBrace)
    var nm = name.len()
    emit(c, OpCode.ConstI32, nm.str(), nm)
    emit(c, OpCode.NewInstance, "\"" + name + "\"", 0)
    emit(c, OpCode.ConstI32, n.str(), n)
    emit(c, OpCode.ConstructInstance, "", 0)
    c.arr_flag = 0
    c.str_flag = 0
}

// 单模式比较发射:load t;<pattern 表达式>;eq —— 标量枚举判别值直接
// const.i32,字面量按各自形态
fn cg_is_pattern_expr(mut c CG, pat E) {
    if pat.kind == "tag-cover" {
        var dv = cg_const_lookup(c, pat.name + "." + pat.word)
        if dv == -999999 {
            cg_err(c, "unknown enum variant: " + pat.name + "." + pat.word)
            return
        }
        emit(c, OpCode.ConstI32, dv.str(), dv)
    } else if pat.kind == "str" {
        var idx = cg_pool_add(c, pat.name)
        emit(c, OpCode.LoadStr, "", idx)
    } else if pat.kind == "char" {
        var cp = pat.name.char_at(0)
        emit(c, OpCode.ConstI32, cp.str(), cp)
    } else if pat.kind == "int" {
        emit(c, OpCode.ConstI32, pat.name, int_val(pat.name))
    } else {
        cg_err(c, "unsupported is pattern: " + pat.kind)
    }
}

// EqBranch 臂:模式收集(is_pattern 复用)→ 按形态三路发射:
// ① 载荷变体+实绑定 → is.variant + jmp.z next + 逐槽 get.generic.field
//   绑定 + 体 + jmp end(continue 式,无共享尾)
// ② 载荷变体无绑定 → load t;is.variant;共享尾(jmp.z next;体;jmp end)
// ③ 标量/字面量 → 单模式:load t;pat;eq;共享尾;多模式:or 链
fn cg_is(mut c CG, mut p P) {
    p_next(p)
    cg_expr(c, p, 0)
    var t = cg_add_var(c, "_is_target", 0, "")
    cg_emit_store(c, t)
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    var end_jmps List<int> = List.new()
    while c.err == "" && p_kind(p) != TokenKind.RBrace && p_kind(p) != TokenKind.EOF {
        var k = p_kind(p)
        if k == TokenKind.If {
            p_next(p)
            cg_expr(c, p, 0)
            var jz = emit(c, OpCode.JmpZ, "", -1)
            p_expect(p, TokenKind.Arrow)
            cg_is_arm_body(c, p)
            var je = emit(c, OpCode.Jmp, "", -1)
            end_jmps.push(je)
            c.ins.get(jz).n = c.ins.len()
        } else if k == TokenKind.Else {
            p_next(p)
            p_expect(p, TokenKind.Arrow)
            cg_is_arm_body(c, p)
            // 宿主 Else 臂体后同样发 jmp→end(end 即紧邻指令,无害跳转)
            var jej = emit(c, OpCode.Jmp, "", -1)
            end_jmps.push(jej)
        } else {
            var pat = is_pattern(p)
            var extras List<E> = List.new()
            while c.err == "" && p_kind(p) == TokenKind.VBar {
                p_next(p)
                skip_empty_lines(p)
                var np = is_pattern(p)
                extras.push(np)
                skip_empty_lines(p)
            }
            p_expect(p, TokenKind.Arrow)
            skip_empty_lines(p)
            var fc = -1
            if pat.kind == "tag-cover" {
                fc = cg_ctor_lookup(c, pat.name + "." + pat.word)
            }
            var has_real_bind = false
            if fc >= 0 && pat.args != "" && pat.args != "_" {
                var binds = split_commas(pat.args)
                var bi = 0
                while bi < binds.len() {
                    if binds.get(bi) != "_" {
                        has_real_bind = true
                    }
                    bi = bi + 1
                }
            }
            if fc >= 0 && has_real_bind {
                // ① 载荷 + 绑定
                var key = f"${pat.name}.${pat.word}"
                cg_emit_load(c, t)
                emit(c, OpCode.IsVariant, "\"" + key + "\"", 0)
                var jz2 = emit(c, OpCode.JmpZ, "", -1)
                var binds2 = split_commas(pat.args)
                var si = 0
                while si < binds2.len() {
                    if binds2.get(si) != "_" {
                        cg_emit_load(c, t)
                        emit(c, OpCode.GetGenericField, "field=" + si.str(), si)
                        emit(c, OpCode.Nop, "", 0)
                        emit(c, OpCode.Nop, "", 0)
                        emit(c, OpCode.Nop, "", 0)
                        var bidx = cg_add_var(c, binds2.get(si), 0, "")
                        cg_emit_store(c, bidx)
                    }
                    si = si + 1
                }
                cg_is_arm_body(c, p)
                var je2 = emit(c, OpCode.Jmp, "", -1)
                end_jmps.push(je2)
                c.ins.get(jz2).n = c.ins.len()
            } else {
                var shared_jz = -1
                if fc >= 0 {
                    // ② 载荷无实绑定:is.variant 后走共享尾
                    var key2 = f"${pat.name}.${pat.word}"
                    cg_emit_load(c, t)
                    emit(c, OpCode.IsVariant, "\"" + key2 + "\"", 0)
                } else if extras.len() == 0 {
                    // ③a 单模式:load t;pat;eq
                    cg_emit_load(c, t)
                    cg_is_pattern_expr(c, pat)
                    emit(c, OpCode.Eq, "", 0)
                } else {
                    // ③b or 链:逐模式 eq + jmp.nz 匹配标号;全落空 jmp next
                    var nz_jmps List<int> = List.new()
                    cg_emit_load(c, t)
                    cg_is_pattern_expr(c, pat)
                    emit(c, OpCode.Eq, "", 0)
                    var nz = emit(c, OpCode.JmpNz, "", -1)
                    nz_jmps.push(nz)
                    var ei = 0
                    while ei < extras.len() {
                        cg_emit_load(c, t)
                        cg_is_pattern_expr(c, extras.get(ei))
                        emit(c, OpCode.Eq, "", 0)
                        var nz2 = emit(c, OpCode.JmpNz, "", -1)
                        nz_jmps.push(nz2)
                        ei = ei + 1
                    }
                    var jmp_next = emit(c, OpCode.Jmp, "", -1)
                    var mi = 0
                    while mi < nz_jmps.len() {
                        c.ins.get(nz_jmps.get(mi)).n = c.ins.len()
                        mi = mi + 1
                    }
                    cg_is_arm_body(c, p)
                    var je3 = emit(c, OpCode.Jmp, "", -1)
                    end_jmps.push(je3)
                    c.ins.get(jmp_next).n = c.ins.len()
                    skip_empty_lines(p)
                    if p_kind(p) == TokenKind.Comma {
                        p_next(p)
                        skip_empty_lines(p)
                    }
                    skip_empty_lines(p)
                    continue
                }
                // 共享尾:jmp.z next;体;jmp end;patch next
                shared_jz = emit(c, OpCode.JmpZ, "", -1)
                cg_is_arm_body(c, p)
                var je4 = emit(c, OpCode.Jmp, "", -1)
                end_jmps.push(je4)
                c.ins.get(shared_jz).n = c.ins.len()
            }
        }
        if p_kind(p) == TokenKind.Comma {
            p_next(p)
            skip_empty_lines(p)
        }
        skip_empty_lines(p)
    }
    p_expect(p, TokenKind.RBrace)
    var e = 0
    while e < end_jmps.len() {
        c.ins.get(end_jmps.get(e)).n = c.ins.len()
        e = e + 1
    }
}

fn cg_stmt(mut c CG, mut p P) {
    if c.err != "" {
        return
    }
    var k = p_kind(p)
    if k == TokenKind.Enum {
        cg_enum_decl(c, p)
        return
    }
    if k == TokenKind.Type {
        cg_type_decl(c, p)
        return
    }
    if k == TokenKind.Use {
        cg_use(c, p)
        return
    }
    if k == TokenKind.Ident && p_text(p) == "pub" {
        // W3:pub 前缀跳过(D3:VM 链路无导出过滤)
        p_next(p)
        if p_kind(p) == TokenKind.Fn {
            cg_fn(c, p)
        } else {
            cg_stmt(c, p)
        }
        return
    }
    if k == TokenKind.Break || k == TokenKind.Continue {
        p_next(p)
        cg_loop_jump(c, k)
        return
    }
    if k == TokenKind.Is {
        cg_is(c, p)
        return
    }
    if k == TokenKind.Let || k == TokenKind.Var || k == TokenKind.Const || k == TokenKind.Shared {
        p_next(p)
        var name = p_text(p)
        p_next(p)
        var vty = ""
        if is_type_name(p) {
            var vt = parse_type(p)
            if vt == "str" {
                vty = "str"
            }
        }
        var is_arr = 0
        // W2(Plan 511):全局路径(镜像宿主 Plan 317/322——顶层 var/const
        // 注册进 global_vars 且无 scope 守卫:fn 体内同名声明也走全局;
        // W3:模块编译单元内键带 mod. 前缀 cg_gkey)
        var gk = cg_gkey(c, name)
        if (k == TokenKind.Var || k == TokenKind.Const) && c.depth == 1 {
            if !cg_is_global(c, gk) {
                c.global_vars.push(gk)
            }
        }
        if p_kind(p) == TokenKind.Asn {
            p_next(p)
            if cg_is_global(c, gk) {
                // init token 区间登记(fn main 体首重放用;首次声明记;
                // W3:仅主模块重放——dep 模块经模块初始化序执行 init)
                var from2 = p.pos
                cg_expr(c, p, 0)
                var to2 = p.pos
                if c.mod_name == "" {
                    var seen2 = false
                    var si2 = 0
                    while si2 < c.global_inits.len() {
                        if c.global_inits.get(si2).name == gk {
                            seen2 = true
                        }
                        si2 = si2 + 1
                    }
                    if !seen2 {
                        c.global_inits.push(CGInit(gk, from2, to2))
                    }
                }
                var gidx2 = cg_pool_add(c, gk)
                emit(c, OpCode.StoreGlobal, gidx2.str(), gidx2)
                return
            }
            cg_expr(c, p, 0)
            is_arr = c.arr_flag
            if c.str_flag == 1 {
                vty = "str"
            }
            // W1:构造字面量绑定记类型名(镜像宿主 var_types=GenericInstance
            // 的可观察面——写字段走 set.generic.field;注解/调用源不记,
            // 写走 load.str+set.field,与宿主 User 路径一致)
            if c.inst_ty != "" {
                vty = c.inst_ty
            }
        }
        var idx = cg_add_var(c, name, is_arr, vty)
        cg_emit_store(c, idx)
        return
    }
    if k == TokenKind.Return {
        p_next(p)
        var kk = p_kind(p)
        if kk == TokenKind.Newline || kk == TokenKind.Semi || kk == TokenKind.RBrace || kk == TokenKind.EOF {
            emit(c, OpCode.PushNil, "", 0)
        } else {
            cg_expr(c, p, 0)
        }
        var na = c.n_args
        var rs2 = f"n_args=${na.str()}"
        emit(c, OpCode.Ret, rs2, na)
        return
    }
    if k == TokenKind.If {
        cg_if(c, p)
        return
    }
    if k == TokenKind.While {
        cg_while(c, p)
        return
    }
    if k == TokenKind.For {
        cg_for(c, p)
        return
    }
    if k == TokenKind.Fn {
        cg_err(c, "nested fn unsupported")
        return
    }
    // 下标赋值 a[idx] = rhs:Rust 发射序为 rhs→arr→idx→set.elem
    // (value 展栈底,Rust 5954 quick-fix 栈序);单遍步行以游标
    // 快照两段解析——先越前扫到匹配 ] 后的 Asn,先发 rhs 再回头发 arr/idx
    if k == TokenKind.Ident && p_peek(p, 1) == TokenKind.LSquare {
        var arr_name = p_text(p)
        var aidx = cg_lookup(c, arr_name)
        if aidx < 0 {
            cg_err(c, "unknown ident: " + arr_name)
            return
        }
        var start = p.pos
        var scan = start + 2
        var depth = 1
        var ok = false
        while scan < p.toks.len() && !ok {
            var sk = p.toks.get(scan).kind
            if is_comment_kind(sk) {
                scan = scan + 1
            } else {
                if sk == TokenKind.LSquare {
                    depth = depth + 1
                } else if sk == TokenKind.RSquare {
                    depth = depth - 1
                    if depth == 0 {
                        ok = true
                    }
                }
                scan = scan + 1
            }
        }
        if ok && scan < p.toks.len() && p.toks.get(scan).kind != TokenKind.Asn && cg_is_assign_op(p_op(p.toks.get(scan).kind)) {
            // W2/D1(Plan 511):宿主对非 Ident LHS 复合赋值的拒绝文本同款
            cg_err(c, "Compound assignment requires a variable on left side")
            return
        }
        if ok && scan < p.toks.len() && p.toks.get(scan).kind == TokenKind.Asn {
            p.pos = scan + 1
            skip_empty_lines(p)
            cg_expr(c, p, 0)
            var end_pos = p.pos
            cg_emit_load(c, aidx)
            p.pos = start
            p_next(p)
            p_next(p)
            skip_empty_lines(p)
            cg_expr(c, p, 0)
            skip_empty_lines(p)
            p_expect(p, TokenKind.RSquare)
            emit(c, OpCode.SetElem, "", 0)
            p.pos = end_pos
            return
        }
        p.pos = start
    }
    // W1 字段赋值 x.f = rhs / x.a.b = rhs:两段游标快照(镜像 a[idx]= 模式)
    // —— 先前瞻扫字段链至 Asn,先发 rhs 再回头发对象/字段
    if k == TokenKind.Ident && p_peek(p, 1) == TokenKind.Dot {
        var recv2 = p_text(p)
        var ridx2 = cg_lookup(c, recv2)
        if ridx2 < 0 {
            cg_err(c, "unknown ident: " + recv2)
            return
        }
        var start3 = p.pos
        // 前瞻:Ident (Dot 名)+ Asn;名后不是 Dot/Asn 即非本形态
        var scan3 = start3 + 1
        var fields3 List<str> = List.new()
        var shape_ok = true
        while shape_ok && p.toks.get(scan3).kind == TokenKind.Dot {
            var fk3 = p.toks.get(scan3 + 1).kind
            if fk3 != TokenKind.Ident && !is_soft_ident_kind(fk3) {
                shape_ok = false
                break
            }
            fields3.push(p.toks.get(scan3 + 1).text)
            scan3 = scan3 + 2
            var after3 = p.toks.get(scan3).kind
            if after3 == TokenKind.Dot {
                // 链继续
            } else if after3 == TokenKind.Asn {
                break
            } else if cg_is_assign_op(p_op(after3)) {
                // 复合赋值:镜像宿主非 Ident LHS 的拒绝文本(D1 同族)
                cg_err(c, "Compound assignment requires a variable on left side")
                return
            } else {
                shape_ok = false
            }
        }
        if shape_ok && p.toks.get(scan3).kind == TokenKind.Asn {
            // 发射:rhs 先行
            p.pos = scan3 + 1
            skip_empty_lines(p)
            cg_expr(c, p, 0)
            var end_pos3 = p.pos
            var recv_ty = cg_var_ty(c, recv2)
            if fields3.len() == 1 && cg_tys_lookup(c, recv_ty) >= 0 {
                // 构造字面量源变量(宿主 GenericInstance 路径):
                // value,instance_id → set.generic.field <u32 字段下标>
                // (+3 幽灵 nop,镜像宿主 disasm u8 读宽形态)
                var fidx3 = cg_field_idx(c, recv_ty, fields3.get(0))
                if fidx3 < 0 {
                    cg_err(c, "unknown field: " + recv_ty + "." + fields3.get(0))
                    return
                }
                cg_emit_load(c, ridx2)
                emit(c, OpCode.SetGenericField, "field=" + fidx3.str(), fidx3)
                emit(c, OpCode.Nop, "", 0)
                emit(c, OpCode.Nop, "", 0)
                emit(c, OpCode.Nop, "", 0)
            } else {
                // 嵌套/非构造源(宿主 User/fallback 路径):value → 对象
                // 表达式 → load.str 字段名(栈顶)→ set.field
                cg_emit_load(c, ridx2)
                var fi3 = 0
                while fi3 < fields3.len() - 1 {
                    var mid3 = cg_pool_push(c, fields3.get(fi3))
                    emit(c, OpCode.GetField, "field[" + mid3.str() + "]", mid3)
                    fi3 = fi3 + 1
                }
                var last3 = cg_pool_add(c, fields3.get(fields3.len() - 1))
                emit(c, OpCode.LoadStr, "", last3)
                emit(c, OpCode.SetField, "", 0)
            }
            p.pos = end_pos3
            return
        }
        p.pos = start3
    }
    // 表达式语句:赋值特判
    if k == TokenKind.Ident {
        var name = p_text(p)
        var nk = p_peek(p, 1)
        if cg_is_assign_op(p_op(nk)) {
            // W2:全局写优先于局部查找(镜像宿主 6189-6192 的 check-BEFORE)
            if cg_is_global(c, cg_gkey(c, name)) {
                p_next(p)
                var gopk = p_kind(p)
                p_next(p)
                if gopk != TokenKind.Asn {
                    var gg = cg_pool_add(c, cg_gkey(c, name))
                    emit(c, OpCode.LoadGlobal, gg.str(), gg)
                }
                cg_expr(c, p, 0)
                var gmn = cg_binop_mnem(p_op(gopk))
                if gmn != OpCode.Blank {
                    emit(c, gmn, "", 0)
                }
                emit(c, OpCode.Dup, "", 0)
                var gidx3 = cg_pool_add(c, cg_gkey(c, name))
                emit(c, OpCode.StoreGlobal, gidx3.str(), gidx3)
                emit(c, OpCode.Pop, "", 0)
                return
            }
            var idx = cg_lookup(c, name)
            if idx < 0 {
                cg_err(c, "unknown ident: " + name)
                return
            }
            p_next(p)
            var opk = p_kind(p)
            p_next(p)
            if opk != TokenKind.Asn {
                cg_emit_load(c, idx)
            }
            cg_expr(c, p, 0)
            var mn = cg_binop_mnem(p_op(opk))
            if mn != OpCode.Blank {
                emit(c, mn, "", 0)
            }
            emit(c, OpCode.Dup, "", 0)
            cg_emit_store(c, idx)
            emit(c, OpCode.Pop, "", 0)
            return
        }
    }
    // W3:表达式语句——用户 fn 调用语句尾补 pop 弃值(镜像宿主
    // Stmt::Expr 的非 void 结果丢弃;call.nat print 为 void 无 pop)
    var before_len = c.ins.len()
    cg_expr(c, p, 0)
    if c.err == "" && c.depth > 1 && c.ins.len() > before_len {
        if c.ins.get(c.ins.len() - 1).op == OpCode.Call {
            emit(c, OpCode.Pop, "", 0)
        }
    }
}

// 语句序列步行:.line(语句首 token 行,经 cg_line 同线去重)→ cg_stmt → eos
fn cg_stmts(mut c CG, mut p P) {
    while c.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RBrace {
        cg_line(c, p_line(p))
        cg_stmt(c, p)
        if c.err == "" {
            cg_eos(c, p)
        }
    }
}

// if/else-if/else:每分支 cond,jz→下一;体;jmp→end(含 return 后死 jmp)
fn cg_if(mut c CG, mut p P) {
    var jzs List<int> = List.new()
    var jends List<int> = List.new()
    var more = true
    while more {
        p_next(p)
        cg_expr(c, p, 0)
        var jz = emit(c, OpCode.JmpZ, "", -1)
        jzs.push(jz)
        cg_body_inline(c, p)
        var je = emit(c, OpCode.Jmp, "", -1)
        jends.push(je)
        if p_kind(p) == TokenKind.Else {
            p_next(p)
            if p_kind(p) != TokenKind.If {
                var z = 0
                while z < jzs.len() {
                    c.ins.get(jzs.get(z)).n = c.ins.len()
                    z = z + 1
                }
                cg_body_inline(c, p)
                more = false
            }
        } else {
            var z2 = 0
            while z2 < jzs.len() {
                c.ins.get(jzs.get(z2)).n = c.ins.len()
                z2 = z2 + 1
            }
            more = false
        }
    }
    var e = 0
    while e < jends.len() {
        c.ins.get(jends.get(e)).n = c.ins.len()
        e = e + 1
    }
}

// 分支/循环体(compile_body_inline:不推作用域)
fn cg_body_inline(mut c CG, mut p P) {
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    cg_stmts(c, p)
    p_expect(p, TokenKind.RBrace)
}

fn cg_eos(mut c CG, mut p P) {
    var has_sep = false
    while p_kind(p) == TokenKind.Semi || p_kind(p) == TokenKind.Newline || p_kind(p) == TokenKind.Comma {
        has_sep = true
        p_next(p)
    }
    if p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RBrace && !has_sep {
        cg_err(c, "expected eos, got " + kind_name(p_kind(p)))
    }
}

// while:top(在语句 .line 之后):cond;jmp.z end;体;jmp top;end
fn cg_while(mut c CG, mut p P) {
    p_next(p)
    var top = c.ins.len()
    cg_expr(c, p, 0)
    var jz = emit(c, OpCode.JmpZ, "", -1)
    // P2:continue 落点 = 条件顶(while 语义:重判条件);体作用域与
    // for 同构(体内变量每迭代释放,cg_pop_scope depth>2 发释放组)
    cg_push_scope(c)
    cg_loop_enter(c, top)
    cg_body_inline(c, p)
    // 宿主布局:体 → 体内变量释放组 → 回跳;break 越过释放组直达 end
    cg_pop_scope(c)
    emit(c, OpCode.Jmp, "", top)
    var end = c.ins.len()
    c.ins.get(jz).n = end
    cg_loop_exit(c, end)
}

// for-in-range:start;store var;top:load var;end;lt;jmp.z end;
// 体;load var;const 1;add;store var;jmp top;end;循环域弹出(释放)
fn cg_for(mut c CG, mut p P) {
    p_next(p)
    if p_kind(p) != TokenKind.Ident {
        cg_err(c, "for: expected ident")
        return
    }
    var name = p_text(p)
    p_next(p)
    if p_kind(p) != TokenKind.In {
        cg_err(c, "for: expected in")
        return
    }
    p_next(p)
    // Call 迭代器通道不推作用域(宿主 2747-2829 无 push_scope——_iterator/
    // 循环变量落 fn 层作用域,fn 尾统一释放;b38 实证)
    if p_kind(p) == TokenKind.Ident && p_peek(p, 1) == TokenKind.LParen {
        // —— Call 迭代器协议 ——
        cg_expr(c, p, 0)
        var it_idx = cg_add_var(c, "_iterator", 0, "")
        cg_emit_store(c, it_idx)
        var it_v = cg_add_var(c, name, 0, "")
        var it_top = c.ins.len()
        cg_emit_load(c, it_idx)
        emit(c, OpCode.CallNat, "nat#112", 112)
        emit(c, OpCode.Dup, "", 0)
        emit(c, OpCode.ConstI32, "-1", -1)
        emit(c, OpCode.Eq, "", 0)
        var it_jnz = emit(c, OpCode.JmpNz, "", -1)
        cg_emit_store(c, it_v)
        cg_loop_enter(c, 0)
        cg_body_inline(c, p)
        // continue 也回循环顶(重新 next),无增量段(宿主同款)
        c.cont_tg.set(c.loop_depth - 1, it_top)
        emit(c, OpCode.Jmp, "", it_top)
        var it_end = c.ins.len()
        c.ins.get(it_jnz).n = it_end
        cg_loop_exit(c, it_end)
        return
    }
    cg_push_scope(c)
    // start 以 min=18 界定(不吞 .. 的中缀绑定);显式吃 Range/RangeEq 再取 end
    cg_expr(c, p, 18)
    if p_kind(p) == TokenKind.Range || p_kind(p) == TokenKind.RangeEq {
        p_next(p)
    } else {
        // —— 数组/表达式通道(Plan 511 W2)——
        // <对象> 求值一次;dup/arr.len 缓存;const.0 计数器;三隐藏槽
        // (_counter/_array_len/_array_ref)+ 循环变量;continue 落点=增量段
        emit(c, OpCode.Dup, "", 0)
        emit(c, OpCode.ArrLen, "", 0)
        emit(c, OpCode.Const0, "", 0)
        var cnt = cg_add_var(c, "_counter", 0, "")
        cg_emit_store(c, cnt)
        var aln = cg_add_var(c, "_array_len", 0, "")
        cg_emit_store(c, aln)
        var aref = cg_add_var(c, "_array_ref", 0, "")
        cg_emit_store(c, aref)
        var av = cg_add_var(c, name, 0, "")
        var atop = c.ins.len()
        cg_emit_load(c, cnt)
        cg_emit_load(c, aln)
        emit(c, OpCode.Lt, "", 0)
        var ajz = emit(c, OpCode.JmpZ, "", -1)
        cg_emit_load(c, aref)
        cg_emit_load(c, cnt)
        emit(c, OpCode.GetElem, "", 0)
        cg_emit_store(c, av)
        cg_loop_enter(c, 0)
        cg_body_inline(c, p)
        c.cont_tg.set(c.loop_depth - 1, c.ins.len())
        cg_emit_load(c, cnt)
        emit(c, OpCode.ConstI32, "1", 1)
        emit(c, OpCode.Add, "", 0)
        cg_emit_store(c, cnt)
        emit(c, OpCode.Jmp, "", atop)
        var aend = c.ins.len()
        c.ins.get(ajz).n = aend
        cg_loop_exit(c, aend)
        cg_pop_scope(c)
        return
    }
    var idx = cg_add_var(c, name, 0, "")
    cg_emit_store(c, idx)
    var top = c.ins.len()
    cg_emit_load(c, idx)
    cg_expr(c, p, 0)
    emit(c, OpCode.Lt, "", 0)
    var jz = emit(c, OpCode.JmpZ, "", -1)
    // P2:continue 落点 = 步进位(循环变量自增;宿主 range-for 同口径)
    cg_loop_enter(c, 0)
    cg_body_inline(c, p)
    c.cont_tg.set(c.loop_depth - 1, c.ins.len())
    cg_emit_load(c, idx)
    emit(c, OpCode.ConstI32, "1", 1)
    emit(c, OpCode.Add, "", 0)
    cg_emit_store(c, idx)
    emit(c, OpCode.Jmp, "", top)
    var end = c.ins.len()
    c.ins.get(jz).n = end
    cg_loop_exit(c, end)
    cg_pop_scope(c)
}

// ── fn 编译 ──────────────────────────────────────────────────

fn cg_fn(mut c CG, mut p P) {
    p_next(p)
    if p_kind(p) != TokenKind.Ident {
        cg_err(c, "fn: expected name")
        return
    }
    var name = p_text(p)
    p_next(p)
    var jover = emit(c, OpCode.Jmp, "", -1)
    var entry = c.ins.len()
    c.fns.push(FnEntry(name, entry))
    var saved_args = c.n_args
    var saved_max = c.max_idx
    c.max_idx = -1
    var saved_hi = c.hi_idx
    c.hi_idx = -1
    cg_push_scope(c)
    var prolog = emit(c, OpCode.FnProlog, "", 0)
    var reserve = emit(c, OpCode.Reserve, "", 0)
    var n_args = 0
    p_expect(p, TokenKind.LParen)
    skip_empty_lines(p)
    var running = true
    while running && c.err == "" {
        var k = p_kind(p)
        if k == TokenKind.View || k == TokenKind.Mut || k == TokenKind.Move || k == TokenKind.Take || k == TokenKind.Copy {
            p_next(p)
        }
        if p_kind(p) != TokenKind.Ident {
            running = false
        } else {
            var pname = p_text(p)
            p_next(p)
            if p_kind(p) == TokenKind.Colon {
                p_next(p)
            }
            // W2:List 型参数记 arr(447 收账缺口①——.len() 接收者跟踪)
            var parr = 0
            if is_type_name(p) {
                if p_text(p) == "List" && p_peek(p, 1) == TokenKind.Lt {
                    parr = 1
                }
                parse_type(p)
            }
            if p_kind(p) == TokenKind.Asn {
                p_next(p)
                expr_pratt(p, 0)
            }
            cg_add_var(c, pname, parr, "")
            n_args = n_args + 1
            if p_kind(p) == TokenKind.Comma {
                p_next(p)
            } else {
                running = false
            }
        }
    }
    p_expect(p, TokenKind.RParen)
    c.n_args = n_args
    if p_kind(p) == TokenKind.Arrow {
        p_next(p)
        parse_type(p)
        skip_empty_lines(p)
    } else if is_type_name(p) {
        parse_type(p)
        skip_empty_lines(p)
    }
    // W2:fn main 体首重放全局初始化(镜像宿主 codegen 1339-1348——入口
    // 直接 spawn main 跳过 wrapper 顶层,故在 main 体首按声明序重放
    // init token 区间;语料约定 fn main 声明于顶层 var 之后)
    if name == "main" && c.mod_name == "" && c.global_inits.len() > 0 {
        var gi = 0
        while gi < c.global_inits.len() && c.err == "" {
            var ent = c.global_inits.get(gi)
            var saved_pos = p.pos
            p.pos = ent.from
            cg_expr(c, p, 0)
            p.pos = saved_pos
            var rgidx = cg_pool_add(c, ent.name)
            emit(c, OpCode.StoreGlobal, rgidx.str(), rgidx)
            gi = gi + 1
        }
    }
    // 体块(Stmt::Block:推作用域;语句 .line 由 cg_stmts 发)
    cg_push_scope(c)
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    cg_stmts(c, p)
    p_expect(p, TokenKind.RBrace)
    cg_pop_scope(c)
    // epilogue RET
    var rs = f"n_args=${n_args.str()}"
    emit(c, OpCode.Ret, rs, n_args)
    // 回填 prolog/reserve(Rust:n_locals = max_locals - n_args)
    var n_locals = 0
    if c.hi_idx >= n_args {
        n_locals = c.hi_idx + 1 - n_args
    }
    c.ins.get(prolog).s = "args=" + n_args.str() + ", locals=" + n_locals.str()
    c.ins.get(prolog).n = n_args
    if n_locals > 0 {
        c.ins.get(reserve).s = n_locals.str()
        c.ins.get(reserve).n = n_locals
    } else {
        c.ins.get(reserve).op = OpCode.Blank
    }
    c.ins.get(jover).n = c.ins.len()
    cg_pop_scope(c)
    c.n_args = saved_args
    c.max_idx = saved_max
    c.hi_idx = saved_hi
}

// ── 序列化 ──────────────────────────────────────────────────

fn hex4(n int) str {
    var digits = "0123456789abcdef"
    var out = ""
    var v = n
    var k = 0
    while k < 4 {
        var d = v % 16
        out = digits.slice(d, d + 1) + out
        v = v / 16
        k = k + 1
    }
    return out
}

fn cg_serialize(mut c CG) str {
    var offs List<int> = List.new()
    var acc = 0
    var i = 0
    while i < c.ins.len() {
        offs.push(acc)
        var ii = c.ins.get(i)
        if ii.op != OpCode.Blank {
            acc = acc + i_size_named(ii.op, ii.s, ii.n)
        }
        i = i + 1
    }
    var out = ""
    var j = 0
    while j < c.ins.len() {
        var ins = c.ins.get(j)
        if ins.op != OpCode.Blank {
            var ops = ins.s
            if ins.op == OpCode.Jmp || ins.op == OpCode.JmpZ || ins.op == OpCode.JmpNz {
                ops = f"-> 0x${hex4(offs.get(ins.n))}"
            } else if ins.op == OpCode.Call {
                var fe = c.fns.get(ins.n)
                ops = f"0x${hex4(offs.get(fe.ins))}"
            } else if ins.op == OpCode.LoadStr {
                ops = "\"" + c.pool.get(ins.n) + "\""
            } else if ins.op == OpCode.LoadGlobal || ins.op == OpCode.StoreGlobal {
                // W3:链接后 ins.n 为合并池索引(s 为模块本地旧值,弃用)
                ops = ins.n.str()
            } else if ins.op == OpCode.GetField {
                ops = "field[" + ins.n.str() + "]"
            }
            if out != "" {
                out = out + "\n"
            }
            out = f"${out}${hex4(offs.get(j))}  ${op_name(ins.op)} ${ops}"
        }
        j = j + 1
    }
    return out
}

// ── W3(Plan 511):use 模块化——解析器/多编译单元/链接器 ────────

// 模块记录(name=use 路径,source=文件文本)
type CGMod {
    name str
    source str
}

// 路径目录部分(最后 / 或 \ 之前;无分隔符返回 "")
fn cg_dir_of(path str) str {
    var i = 0
    var last = -1
    while i < path.len() {
        var ch = path.char_at(i)
        if ch == 47 || ch == 92 {
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        return ""
    }
    return path.slice(0, last)
}

// use 语句轻扫(复用 cg_use 的消费逻辑,记录进临时 CG 的 uses)
fn cg_use_scan(source str) List<CGUse> {
    var out List<CGUse> = List.new()
    var toks = tokenize(source)
    var p = parse_new(toks)
    var scratch = cg_new()
    skip_empty_lines(p)
    while p.err == "" && p_kind(p) != TokenKind.EOF {
        if p_kind(p) == TokenKind.Use {
            cg_use(scratch, p)
        } else if p_kind(p) == TokenKind.Ident && p_text(p) == "pub" {
            p_next(p)
        } else {
            // 越过其余语句:保守步进到行尾
            while p.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.Newline && p_kind(p) != TokenKind.Semi {
                p_next(p)
            }
        }
        if p.err == "" {
            var k2 = p_kind(p)
            while k2 == TokenKind.Newline || k2 == TokenKind.Semi || k2 == TokenKind.Comma {
                p_next(p)
                k2 = p_kind(p)
            }
        }
    }
    var i = 0
    while i < scratch.uses.len() {
        out.push(scratch.uses.get(i))
        i = i + 1
    }
    return out
}

// 模块路径 . → /(slice 拼接——char_at 为码点整数值)
fn cg_mod_fs_path(module str) str {
    var out = ""
    var start = 0
    var i = 0
    while i < module.len() {
        if module.char_at(i) == 46 {
            out = out + module.slice(start, i) + "/"
            start = i + 1
        }
        i = i + 1
    }
    return out + module.slice(start, module.len())
}

// 递归解析:file 的 use 依赖先行入列(DFS 后序 = deps 先于依赖者;
// 环静默跳过 D2;按名去重)。返回错误文本(""=成功,宿主文本为规范)。
fn cg_resolve_into(file str, mut mods List<CGMod>, mut loading List<str>, mut done List<str>) str {
    var src = File.read_text(file)
    if src == "" {
        return "Module not found: " + file + " (module_path=" + file + ", parent_dirs=[])"
    }
    var uses = cg_use_scan(src)
    var dir = cg_dir_of(file)
    var i = 0
    while i < uses.len() {
        var u = uses.get(i)
        if u.kind == "rs" {
            var crate = u.module
            var dot = crate.char_at(0)
            var di = 0
            while di < crate.len() {
                if crate.char_at(di) == 46 {
                    crate = crate.slice(0, di)
                    di = crate.len()
                }
                di = di + 1
            }
            return "Crate '" + crate + "' not declared. Add `dep " + crate + "` before `use.rs`."
        }
        if u.kind == "py" {
            return "Python FFI not enabled. Rebuild with `--features python` to use `use.py`."
        }
        if u.kind == "c" {
            return "Expected <lib> or \"lib\", got Ident"
        }
        // auto 模块
        var m = u.module
        var already = false
        var j = 0
        while j < done.len() {
            if done.get(j) == m {
                already = true
            }
            j = j + 1
        }
        var in_stack = false
        var j2 = 0
        while j2 < loading.len() {
            if loading.get(j2) == m {
                in_stack = true
            }
            j2 = j2 + 1
        }
        if !already && !in_stack {
            var mfile = dir + "/" + cg_mod_fs_path(m) + ".at"
            var msrc = File.read_text(mfile)
            if msrc == "" {
                return "Module not found: " + m + " (module_path=" + cg_mod_fs_path(m) + ", parent_dirs=[])"
            }
            loading.push(m)
            var rerr = cg_resolve_into(mfile, mods, loading, done)
            if rerr != "" {
                return rerr
            }
            var li = 0
            while li < loading.len() {
                if loading.get(li) == m {
                    loading.set(li, "")
                }
                li = li + 1
            }
            mods.push(CGMod(m, msrc))
            done.push(m)
        }
        i = i + 1
    }
    return ""
}

// 入口:main_path → 有序模块列(deps DFS 后序 + main 末位)。错误文本直返
fn cg_resolve(main_path str) AutoResult2 {
    var mods List<CGMod> = List.new()
    var loading List<str> = List.new()
    var done List<str> = List.new()
    var err = cg_resolve_into(main_path, mods, loading, done)
    if err != "" {
        return AutoResult2(mods, err)
    }
    var main_src = File.read_text(main_path)
    mods.push(CGMod("", main_src))
    return AutoResult2(mods, "")
}

// 多值返回载体(mods + err)
type AutoResult2 {
    mods List<CGMod>
    err str
}

// ── 编译入口(S5 engine 复用;返回 CG 结构) ────────────────────

fn cg_compile(source str) CG {
    // W3:主模块经 cg_compile_mod(mod_name="" → wrapper 形态)
    return cg_compile_mod(source, "")
}

// W3:多编译单元入口。主模块(mod_name=""):wrapper 形态(既有口径);
// dep 模块(mod_name≠""):裸形态——Type/Use 消费、顶层 var/const 走
// 限名全局、fn 直接发射(各自 jmp-over),尾 HALT,无 wrapper(镜像
// 宿主 compile_module_to_bytecode;语料声明序=Type→Store→Fn 单趟步行)
fn cg_compile_mod(source str, mod_name str) CG {
    var toks = tokenize(source)
    var p = parse_new(toks)
    var c = cg_new()
    c.mod_name = mod_name
    if mod_name == "" {
        emit(c, OpCode.FnProlog, "args=0, locals=16", 16)
        emit(c, OpCode.Reserve, "16", 16)
    }
    skip_empty_lines(p)
    while c.err == "" && p.err == "" && p_kind(p) != TokenKind.EOF {
        if p_kind(p) == TokenKind.Fn {
            cg_fn(c, p)
        } else if p_kind(p) == TokenKind.Ident && p_text(p) == "pub" {
            p_next(p)
            if p_kind(p) == TokenKind.Fn {
                cg_fn(c, p)
            } else {
                cg_stmt(c, p)
            }
        } else {
            // 顶层非 fn 语句:主模块 wrapper 内步行(镜像 Rust
            // compile_and_link 的 other_stmts 路径);该路径不发 .line;
            // dep 模块顶层语句同口径(005 实测:模块 init store 无 .line)
            cg_stmt(c, p)
        }
        if c.err == "" {
            cg_eos(c, p)
        }
    }
    if c.err == "" {
        emit(c, OpCode.Halt, "", 0)
    }
    return c
}

// W3:符号定址(bare 首到首胜 + mod.fn 限定;host loader 264-312 镜像)
fn cg_link_symbol(c CG, symbol str) int {
    var i = 0
    while i < c.fns.len() {
        if c.fns.get(i).name == symbol {
            return i
        }
        i = i + 1
    }
    // 限定:前缀逐模块试(模块名可含点,tools.helper.fn)
    var mi2 = 0
    while mi2 < c.fn_mods.len() {
        var m = c.fn_mods.get(mi2)
        if m != "" && symbol.len() > m.len() + 1 {
            var head = symbol.slice(0, m.len())
            var tail = symbol.slice(m.len() + 1, symbol.len())
            var sep = symbol.char_at(m.len())
            if head == m && sep == 46 && c.fns.get(mi2).name == tail {
                return mi2
            }
        }
        mi2 = mi2 + 1
    }
    // 兜底:剥前缀裸名(host loader strip-prefix fallback)
    var li2 = 0
    while li2 < c.fns.len() {
        if c.fns.get(li2).name == symbol {
            return li2
        }
        li2 = li2 + 1
    }
    return -1
}

// W3:链接器——cgs(deps DFS 后序 + main 末位)→ 合并 CG:
// 指令平移(jmp 目标 +base / Call fn 索引 +fnbase / 池操作数 remap 去重
// 并池)、fns/fn_mods 合并、defers 定址(mod_bases 记 dep 起始)。
// 返回 CG.err 非空即链接失败(宿主文本)
fn cg_link_modules(mut cgs List<CG>) CG {
    var m = cg_new()
    var fn_base = 0
    var mi = 0
    while mi < cgs.len() {
        var mc = cgs.get(mi)
        var ins_base = m.ins.len()
        if mi < cgs.len() - 1 {
            m.mod_bases.push(ins_base)
        }
        // 池去重合并 + remap 表
        var remap List<int> = List.new()
        var pi = 0
        while pi < mc.pool.len() {
            var ps = mc.pool.get(pi)
            var found = -1
            var pj = 0
            while pj < m.pool.len() {
                if m.pool.get(pj) == ps {
                    found = pj
                }
                pj = pj + 1
            }
            if found < 0 {
                m.pool.push(ps)
                found = m.pool.len() - 1
            }
            remap.push(found)
            pi = pi + 1
        }
        // 指令迁移
        var ii = 0
        while ii < mc.ins.len() {
            var ins = mc.ins.get(ii)
            if ins.op == OpCode.Jmp || ins.op == OpCode.JmpZ || ins.op == OpCode.JmpNz {
                ins.n = ins.n + ins_base
            } else if ins.op == OpCode.Call && ins.n >= 0 {
                ins.n = ins.n + fn_base
            } else if ins.op == OpCode.LoadStr || ins.op == OpCode.GetField || ins.op == OpCode.LoadGlobal || ins.op == OpCode.StoreGlobal {
                if ins.n >= 0 && ins.n < remap.len() {
                    ins.n = remap.get(ins.n)
                }
            }
            m.ins.push(ins)
            ii = ii + 1
        }
        // fns + fn_mods
        var fi = 0
        while fi < mc.fns.len() {
            var fe = mc.fns.get(fi)
            m.fns.push(FnEntry(fe.name, fe.ins + ins_base))
            m.fn_mods.push(mc.mod_name)
            fi = fi + 1
        }
        // defers(绝对化 ins 指针)
        var di = 0
        while di < mc.defers.len() {
            var d = mc.defers.get(di)
            m.defers.push(CGDefer(d.ins_idx + ins_base, d.symbol))
            di = di + 1
        }
        fn_base = fn_base + mc.fns.len()
        if mc.err != "" && m.err == "" {
            m.err = mc.err
        }
        mi = mi + 1
    }
    // defer 定址
    var ri = 0
    while ri < m.defers.len() {
        var d2 = m.defers.get(ri)
        var target = cg_link_symbol(m, d2.symbol)
        if target < 0 {
            m.err = "Undefined symbol: " + d2.symbol + " in module <main>"
            return m
        }
        m.ins.get(d2.ins_idx).n = target
        ri = ri + 1
    }
    return m
}

// W3 多文件编译主入口:main_path → 合并 CG(err 语义同 cg_compile)
fn cg_compile_files(main_path str) CG {
    var res = cg_resolve(main_path)
    if res.err != "" {
        var e = cg_new()
        e.err = res.err
        return e
    }
    var cgs List<CG> = List.new()
    var i = 0
    while i < res.mods.len() {
        var mod = res.mods.get(i)
        cgs.push(cg_compile_mod(mod.source, mod.name))
        i = i + 1
    }
    return cg_link_modules(cgs)
}

// W3 M4 多文件闸门入口
fn codegen_dump_files(main_path str) str {
    var c = cg_compile_files(main_path)
    if c.err != "" {
        return c.err
    }
    return cg_serialize(c)
}

// M4 闸门入口
fn codegen_dump(source str) str {
    var c = cg_compile(source)
    if c.err != "" {
        return c.err
    }
    return cg_serialize(c)
}
