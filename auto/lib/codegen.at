// ╔═══════════════════════════════════════════════════════════╗
// ║ AAVM v2 Sync Snapshot                                     ║
// ║ Component: codegen.at (Plan 432 S4 / D28: codegen_dump)   ║
// ║ Rust ref:  vm/codegen.rs(Stmt 发射)+ vm/loader.rs(链接) ║
// ║ Gate:      M4 —— corpus_m4 字节码与 Rust codegen 结构一致  ║
// ╚═══════════════════════════════════════════════════════════╝
//           447-③ 终局收账:I.op → enum OpCode(C1)/cg 中缀环 is(P2)/
//           break-continue 占位回填/cg_fstr build.fstr(11.2a);
//           布局等价策略保留(D28 余项)
// Coverage:  脚本 wrapper(FN_PROLOG args=0 locals=16 + RESERVE 16);
//            fn 编译(每 fn 一个 jmp-over、FN_PROLOG/RESERVE 占位回填、
//            体块弹出的槽释放组、epilogue RET、jmp-over patch);
//            语句(let/var 存储无 dup-pop、赋值表达式语句 load-rhs-op-
//            dup-store-pop、复合赋值同型、if/else-if/else(含 return 后
//            死 jmp)、while(back-jmp 不含语句 .line)、for-in-range
//            增量循环(循环域弹出发释放)、return);表达式(Int/Str/bool
//            字面量、标识符寻址[param 0x80+rel / loc.0 / loc.1 /
//            local N]、二元算术/比较/逻辑、一元 !、用户 fn 调用(符号
//            表解析)、print CALL_NAT nat#10、str.cat);字符串池内容
//            寻址去重;.line 由语句步行者按语句首行发射;跳转 patch
//            (目标指令索引 → 字节偏移);
//            [M4 扩]数组字面量(elems+create.arr count=N)、下标读
//            (arr,idx,get.elem)与下标写(rhs,arr,idx,set.elem——value
//            展栈底,Rust quick-fix 栈序镜像)、.len()→arr.len(仅数组
//            接收者,镜像 Rust infer_object_type==Array 闸,7177)、顶层
//            非 fn 语句(wrapper 内步行,.line 同 cg_stmts);let/var 的
//            数组性绑定跟踪(CGVar.arr,供 .len() 接收者判定)
// Missing:   对象/元组字面量与方法调用(.str() 等 CALL_NAT 家族)、
//            字符串下标(get.elem 的 str→码点分支)、闭包/捕获、
//            浮点(CONST_F32/PROMOTE)、全局变量(LOAD_GLOBAL/
//            STORE_GLOBAL)、下标复合赋值、一元负号(NEG)、嵌套赋值、
//            #[vm] stub、生成器、多模块链接
// DIVERGE:   D28: Vec<u8> 字节码 + 链接重定位 → 指令 List(I{op,s,n})+
//            序列化直出 —— 发射顺序/操作数逐字对齐;FN_PROLOG/RESERVE
//            由 Rust 的"体后插入+地址平移"改为"占位+回填"(布局等价);
//            CALL 的链接重定位改为符号表(FnEntry)序列化期解析;槽释放
//            组按槽位升序(Rust pop_scope 按 HashMap 迭代序不定,m4 闸门
//            Rust 侧 dumper 同步规范化)。作用域栈 depth 计数(List 只增
//            不减,D25 写法)。D22 同款错误短路;复用 parser.at 的 token
//            游标/优先级表与 typeinfo.at 的 p_text_at。

// ── 载体 ──────────────────────────────────────────────────────

// 指令:op=助记符(空=已删除占位);s=序列化操作数文本;n=patch 载荷
// (jmp/jmp.z:目标指令索引;call:FnEntry 索引;load.str:池索引)
// Plan 517 W2:模块化互引(拼接消费面由双轨剥离消化;P 方法族随类型导入)
use auto.lib.token: TokenKind, kind_name
use auto.lib.lexer: tokenize
use auto.lib.parser: E, Op, P, expect_eos, expr_pratt, find_sub, infix_l, infix_r, int_val, is_comment_kind, is_name_kind, is_op_kind, is_pattern, is_soft_ident_kind, is_type_name, p_op, parse_new, parse_type, split_commas
use auto.lib.typeinfo: t_is_type_prop

type I {
    op OpCode
    s str
    n int
}

type FnEntry {
    name str
    ins int
}

type CGVar {
    name str
    idx int
    arr int
    // 447-③ 11.2a:build.fstr 段类型 tag 用(""=int/未知,宿主默认同;
    // "str" → tag 1;仅 str 需显式识别,其余值域 tag 0)
    ty str
}

pub type CG {
    ins List<I>
    pool List<str>
    fns List<FnEntry>
    scopes List<List<CGVar>>
    depth int
    n_args int
    max_idx int
    err str
    str_flag int
    arr_flag int
    // Plan 447 部分②:枚举注册表(镜像宿主 enum_values + generic_registry
    // 载荷模板)。consts:"Enum.Variant"→判别值(scalar 链;载荷变体按
    // 位序,镜像 scalar_value.unwrap_or(i));ctors:"Enum.Variant"→字段数
    consts List<CGEnum>
    ctors List<CGEnum>
    // P2:循环 break/continue 占位回填(镜像宿主 H2 patch_jump_to;aavm
    // 侧首实现)。帧按层深 append-only(engine.at args_stack 同款,无
    // List.pop opcode);cont_tg 为各层 continue 落点(while=条件顶,
    // for=步进位)
    brk_js List<List<int>>
    cont_js List<List<int>>
    cont_tg List<int>
    loop_depth int
    // Plan 495: 镜像宿主 emit_source_line 的 current_source_line ——
    // 相邻同线 .line 去重状态(0=未发过)
    cur_line int
    // W1(Plan 511):struct 类型注册表(name→声明序字段名;镜像宿主
    // generic_registry 的 field_names/field_index 面);inst_ty=构造字面量
    // 绑定的类型名(str_flag/arr_flag 同款单值回传,let 绑定用)
    tys List<CGType>
    inst_ty str
    // W2(Plan 511):全局变量(镜像宿主 global_vars/global_inits——仅顶层
    // var/const;inits 记 init 表达式的 token 区间,fn main 体首重放用)
    global_vars List<str>
    global_inits List<CGInit>
    // W2:hi_idx=本 fn 槽位高 watermark(prolog locals 用;宿主 pop_scope
    // 释放槽位供姊妹作用域复用,但 fn locals 取分配高水位——两值分离);
    // scope_saves=各层入口 max_idx(弹出恢复)
    hi_idx int
    scope_saves List<int>
    // W3(Plan 511):use 记录(mod 名/逗号 items/通配);mod_name=本编译
    // 单元的模块名(""=主模块——全局键裸名,否则 mod. 前缀);defers=跨模块
    // 调用延迟解析(ins 指针+符号);mod_bases=链接后各 dep 模块起始
    // ins 下标(ev_run_files 初始化序用)
    uses List<CGUse>
    mod_name str
    defers List<CGDefer>
    mod_bases List<int>
    // W3:fn→模块名平行表(链接期符号定址用;单文件路径恒空)
    fn_mods List<str>
    // ── W2(Plan 525):方法族编译上下文 ──
    // method_ty≠"":cg_fn 正在编译类型体方法 → fn 名重整 "Type.method"
    // (镜像宿主 codegen.rs 2301 独立 fn + self 首参注入);
    // method_self=1:非 static 方法注入 self 首参(add_var idx=0);
    // wrapper_started=0:wrapper prolog 懒发射(镜像宿主 compile_and_link
    // 分区序:Type/Ext 方法先于 wrapper——Type 声明位零字节码,首个
    // 非 Type/Ext 语句才发 wrapper prolog)
    method_ty str
    method_self int
    wrapper_started int
    // W2(525):recv_ty——刚编译完的主式接收者类型名(Ident 变量位的
    // CGVar.ty / 前导点 self 的类型;后缀方法调用解析用;每跳后缀清位)
    recv_ty str
    // W2(525):primary_tyname——主式是裸类型名(非变量;静态调用
    // Type.m(args) 的探测载体)
    primary_tyname str
    // W2(525):fn_rets——c.fns 平行表(方法/函数返回类型名;链式
    // 调用接收者类型解析:Box.new(7) 的结果类型)
    fn_rets List<str>

    // ── Plan 514 W3-15(γ4):CG 自有操作族入 type 体 ──
    // 映射:cg_* c-only 操作族(产生式 cg_expr/stmt/if/while/fn 族
    // 与纯表函数 op_name/i_size/... 保留自由函数);cg_err→fail
    // (避 err 字段撞名);cg_new→static new。

    static fn new() CG {
    var scs List<List<CGVar>> = List.new()
    var base List<CGVar> = List.new()
    scs.push(base)
    var ins_l List<I> = List.new()
    var pool List<str> = List.new()
    var fns List<FnEntry> = List.new()
    var consts_l List<CGEnum> = List.new()
    var ctors_l List<CGEnum> = List.new()
    var brk_l List<List<int>> = List.new()
    var cont_l List<List<int>> = List.new()
    var ctg_l List<int> = List.new()
    var tys_l List<CGType> = List.new()
    var gv_l List<str> = List.new()
    var gi_l List<CGInit> = List.new()
    var saves_l List<int> = List.new()
    var uses_l List<CGUse> = List.new()
    var defers_l List<CGDefer> = List.new()
    var bases_l List<int> = List.new()
    var fmods_l List<str> = List.new()
    var frets_l List<str> = List.new()
    return CG(ins_l, pool, fns, scs, 1, 0, -1, "", 0, 0, consts_l, ctors_l, brk_l, cont_l, ctg_l, 0, 0, tys_l, "", gv_l, gi_l, -1, saves_l, uses_l, "", defers_l, bases_l, fmods_l, "", 0, 0, "", "", frets_l)
}

    // W3:裸名 → 导入符号(遍历 uses:定向 items 命中或通配;返回 "mod.name",
    // 未命中返回 "")
    fn import_symbol(name str) str {
    var i = 0
    while i < self.uses.len() {
        var u = self.uses.get(i)
        if u.kind == "auto" {
            if u.wildcard == 1 || cg_items_has(u.items, name) {
                return u.module + "." + name
            }
        }
        i = i + 1
    }
    return ""
}

    // W3:名字是否为已 use 的模块名(限定调用 db.fn 判定)
    fn is_module(name str) bool {
    var i = 0
    while i < self.uses.len() {
        if self.uses.get(i).module == name {
            return true
        }
        i = i + 1
    }
    return false
}

    // W3:全局键限名(模块编译单元内 mod. 前缀;主模块裸名——镜像宿主
    // current_module/qualified_global_name)
    fn gkey(name str) str {
    if self.mod_name == "" {
        return name
    }
    return self.mod_name + "." + name
}

    // W2:名字是否已入全局集
    fn is_global(name str) bool {
    var i = 0
    while i < self.global_vars.len() {
        if self.global_vars.get(i) == name {
            return true
        }
        i = i + 1
    }
    return false
}

    // W1:按类型名查注册表下标(-1=未注册)
    fn tys_lookup(name str) int {
    var i = 0
    while i < self.tys.len() {
        if self.tys.get(i).name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

    // W1:字段在类型声明序中的下标(-1=无该字段)
    fn field_idx(tyname str, field str) int {
    var ti = self.tys_lookup(tyname)
    if ti < 0 {
        return -1
    }
    var fl = self.tys.get(ti).fields
    var j = 0
    while j < fl.len() {
        if fl.get(j) == field {
            return j
        }
        j = j + 1
    }
    return -1
}

    // W3(525):字段类型名(ftys 平行表;未命中 "")
    fn field_ty(tyname str, field str) str {
    var ti = self.tys_lookup(tyname)
    if ti < 0 {
        return ""
    }
    var fl = self.tys.get(ti).fields
    var ft = self.tys.get(ti).ftys
    var j = 0
    while j < fl.len() {
        if fl.get(j) == field {
            if j < ft.len() {
                return ft.get(j)
            }
            return ""
        }
        j = j + 1
    }
    return ""
}

    fn const_lookup(key str) int {
    var i = 0
    while i < self.consts.len() {
        if self.consts.get(i).key == key {
            return self.consts.get(i).val
        }
        i = i + 1
    }
    return -999999
}

    fn ctor_lookup(key str) int {
    var i = 0
    while i < self.ctors.len() {
        if self.ctors.get(i).key == key {
            return self.ctors.get(i).val
        }
        i = i + 1
    }
    return -999999
}

    // W3:符号定址(bare 首到首胜 + mod.fn 限定;host loader 264-312 镜像)
    fn link_symbol(symbol str) int {
    var i = 0
    while i < self.fns.len() {
        if self.fns.get(i).name == symbol {
            return i
        }
        i = i + 1
    }
    // 限定:前缀逐模块试(模块名可含点,tools.helper.fn)
    var mi2 = 0
    while mi2 < self.fn_mods.len() {
        var m = self.fn_mods.get(mi2)
        if m != "" && symbol.len() > m.len() + 1 {
            var head = symbol.slice(0, m.len())
            var tail = symbol.slice(m.len() + 1, symbol.len())
            var sep = symbol.char_at(m.len())
            if head == m && sep == 46 && self.fns.get(mi2).name == tail {
                return mi2
            }
        }
        mi2 = mi2 + 1
    }
    // 兜底:剥前缀裸名(host loader strip-prefix fallback)
    var li2 = 0
    while li2 < self.fns.len() {
        if self.fns.get(li2).name == symbol {
            return li2
        }
        li2 = li2 + 1
    }
    return -1
}

    // P2:进循环层——帧占位列表 + continue 落点(读改写回填,VM 引用语义
    // 与 a2r 值语义两可;镜像 ev_arr_write 写回注释)
    fn loop_enter(cont_target int) {
    var bl List<int> = List.new()
    self.brk_js.push(bl)
    var cl List<int> = List.new()
    self.cont_js.push(cl)
    self.cont_tg.push(cont_target)
    self.loop_depth = self.loop_depth + 1
}

    // P2:出循环层——continue 占位 → 本层落点;break 占位 → 循环后
    fn loop_exit(brk_target int) {
    var d = self.loop_depth - 1
    if d < 0 {
        self.fail("loop exit without enter")
        return
    }
    var cj = self.cont_js.get(d)
    var j = 0
    while j < cj.len() {
        self.ins.get(cj.get(j)).n = self.cont_tg.get(d)
        j = j + 1
    }
    var bj = self.brk_js.get(d)
    var b = 0
    while b < bj.len() {
        self.ins.get(bj.get(b)).n = brk_target
        b = b + 1
    }
    self.loop_depth = d
}

    // P2:break/continue 语句发射(占位 Jmp 入本层帧;层外报错)
    fn loop_jump(k TokenKind) {
    if self.loop_depth == 0 {
        self.fail("break/continue outside loop")
        return
    }
    var j = self.emit(OpCode.Jmp, "", -1)
    if k == TokenKind.Continue {
        var fr = self.cont_js.get(self.loop_depth - 1)
        fr.push(j)
        self.cont_js.set(self.loop_depth - 1, fr)
    } else {
        var fr2 = self.brk_js.get(self.loop_depth - 1)
        fr2.push(j)
        self.brk_js.set(self.loop_depth - 1, fr2)
    }
}

    fn fail(msg str) {
    if self.err == "" {
        self.err = "CODEGEN-ERROR:" + msg
    }
}

    // 发射一条指令,返回其指令索引
    fn emit(op OpCode, s str, n int) int {
    self.ins.push(I(op, s, n))
    return self.ins.len() - 1
}

    // Plan 495: 镜像宿主 emit_source_line —— line>0 且异于当前已发行才发
    // SOURCE_LINE(相邻同线去重,与宿主 current_source_line 同款状态机)
    fn line(ln int) {
    if ln > 0 && ln != self.cur_line {
        self.cur_line = ln
        self.emit(OpCode.Line, ln.str(), 0)
    }
}

    // ── 作用域(depth 计数;深度≥3 弹出时发槽释放组) ───────────────

    fn push_scope() {
    // W2:记录本层入口 max_idx(弹出恢复——宿主 pop_scope 释放槽位,
    // 姊妹作用域复用槽号;b38 三循环实证)
    if self.scope_saves.len() < self.depth + 1 {
        self.scope_saves.push(self.max_idx)
    } else {
        self.scope_saves.set(self.depth, self.max_idx)
    }
    // Plan 447 部分②修复:多 fn 复用槽位时必须换新空表——旧实现无条件
    // push,第二個 fn 按深度取到前一 fn 的残留作用域(其体内变量泄漏进
    // 后续 fn 的释放组/查找域;is 的 _is_target 首次暴露)。表长仍只增
    // 不减(D25 写法保持)
    if self.depth == self.scopes.len() {
        var sc List<CGVar> = List.new()
        self.scopes.push(sc)
    } else {
        var fresh List<CGVar> = List.new()
        self.scopes.set(self.depth, fresh)
    }
    self.depth = self.depth + 1
}

    // 弹出作用域:depth>2 时对栈顶域的槽按升序发 push.nil+store
    fn pop_scope() {
    if self.depth > 1 {
        if self.depth > 2 {
            var sc = self.scopes.get(self.depth - 1)
            var slots = cg_sort_ints_of_vars(sc)
            var m = 0
            while m < slots.len() {
                self.emit(OpCode.PushNil, "", 0)
                self.emit_store(slots.get(m))
                m = m + 1
            }
        }
        self.depth = self.depth - 1
        // W2:恢复槽位分配游标(本层槽号可复用;hi_idx 高水位不受影响)
        if self.scope_saves.len() >= self.depth + 1 {
            self.max_idx = self.scope_saves.get(self.depth)
        }
    }
}

    // W2:静默弹出(无释放组)——Call 迭代器协议通道专用:宿主 2747-2829
    // 的 _iterator/循环变量不入释放组(实测 b38:循环尾无 push.nil+store)
    fn pop_scope_silent() {
    if self.depth > 1 {
        self.depth = self.depth - 1
        if self.scope_saves.len() >= self.depth + 1 {
            self.max_idx = self.scope_saves.get(self.depth)
        }
    }
}

    fn add_var(name str, arr int, ty str) int {
    var next = self.max_idx + 1
    self.max_idx = next
    if next > self.hi_idx {
        self.hi_idx = next
    }
    // 提升+写回(VM 引用语义同写回;a2r 值语义写回修改副本)
    var sc = self.scopes.get(self.depth - 1)
    // Plan 447 部分②:同名重登记按名覆盖(镜像宿主 add_var 的 HashMap
    // 按名 insert——旧槽从表中消失:不再释放也不被查找;多次 is 的
    // _is_target 首次暴露该差异)。max_idx 单调计数 = 宿主高水位
    var replaced = false
    var ri = 0
    while ri < sc.len() {
        if sc.get(ri).name == name {
            sc.set(ri, CGVar(name, next, arr, ty))
            replaced = true
        }
        ri = ri + 1
    }
    if !replaced {
        sc.push(CGVar(name, next, arr, ty))
    }
    self.scopes.set(self.depth - 1, sc)
    return next
}

    // 按 idx 反查变量的数组性(.len() 接收者判定)
    fn var_arr(idx int) int {
    var s = self.depth - 1
    while s >= 0 {
        var sc = self.scopes.get(s)
        var i = sc.len() - 1
        while i >= 0 {
            if sc.get(i).idx == idx {
                return sc.get(i).arr
            }
            i = i - 1
        }
        s = s - 1
    }
    return 0
}

    // 按名查变量类型(11.2a:build.fstr 段 tag;""=int/未知,宿主默认同)
    fn var_ty(name str) str {
    var s = self.depth - 1
    while s >= 0 {
        var sc = self.scopes.get(s)
        var i = sc.len() - 1
        while i >= 0 {
            if sc.get(i).name == name {
                return sc.get(i).ty
            }
            i = i - 1
        }
        s = s - 1
    }
    return ""
}

    fn lookup(name str) int {
    var s = self.depth - 1
    while s >= 0 {
        var sc = self.scopes.get(s)
        var i = sc.len() - 1
        while i >= 0 {
            if sc.get(i).name == name {
                return sc.get(i).idx
            }
            i = i - 1
        }
        s = s - 1
    }
    return -1
}

    // ── 寻址发射(param:0x80+rel;局部 rel 0/1 → loc.0/loc.1,否则 local N) ──

    fn emit_store(idx int) {
    if idx < self.n_args {
        var sv = (128 + idx).str()
        self.emit(OpCode.StoreLocal, sv, 128 + idx)
        return
    }
    var rel = idx - self.n_args
    if rel == 0 {
        self.emit(OpCode.StoreLoc0, "0", 0)
    } else if rel == 1 {
        self.emit(OpCode.StoreLoc1, "1", 1)
    } else {
        var sv2 = rel.str()
        self.emit(OpCode.StoreLocal, sv2, rel)
    }
}

    fn emit_load(idx int) {
    if idx < self.n_args {
        var lv = (128 + idx).str()
        self.emit(OpCode.LoadLocal, lv, 128 + idx)
        return
    }
    var rel = idx - self.n_args
    if rel == 0 {
        self.emit(OpCode.LoadLoc0, "0", 0)
    } else if rel == 1 {
        self.emit(OpCode.LoadLoc1, "1", 1)
    } else if rel == 2 {
        self.emit(OpCode.LoadLoc2, "2", 2)
    } else {
        var lv2 = rel.str()
        self.emit(OpCode.LoadLocal, lv2, rel)
    }
}

    // ── 字符串池(内容寻址去重) ────────────────────────────────────

    fn pool_add(s str) int {
    var i = 0
    while i < self.pool.len() {
        if self.pool.get(i) == s {
            return i
        }
        i = i + 1
    }
    self.pool.push(s)
    return self.pool.len() - 1
}

    // W1:名字池非去重追加(get.field 操作数专用——镜像宿主 5842-5848 的
    // 直接 strings.push,不去重;load.str/set.field 路径仍走 cg_pool_add)
    fn pool_push(s str) int {
    self.pool.push(s)
    return self.pool.len() - 1
}

    fn serialize() str {
    var offs List<int> = List.new()
    var acc = 0
    var i = 0
    while i < self.ins.len() {
        offs.push(acc)
        var ii = self.ins.get(i)
        if ii.op != OpCode.Blank {
            acc = acc + i_size_named(ii.op, ii.s, ii.n)
        }
        i = i + 1
    }
    var out = ""
    var j = 0
    while j < self.ins.len() {
        var ins = self.ins.get(j)
        if ins.op != OpCode.Blank {
            var ops = ins.s
            if ins.op == OpCode.Jmp || ins.op == OpCode.JmpZ || ins.op == OpCode.JmpNz {
                ops = f"-> 0x${hex4(offs.get(ins.n))}"
            } else if ins.op == OpCode.Call {
                var fe = self.fns.get(ins.n)
                ops = f"0x${hex4(offs.get(fe.ins))}"
            } else if ins.op == OpCode.LoadStr {
                ops = "\"" + self.pool.get(ins.n) + "\""
            } else if ins.op == OpCode.LoadGlobal || ins.op == OpCode.StoreGlobal {
                // W3:链接后 ins.n 为合并池索引(s 为模块本地旧值,弃用)
                ops = ins.n.str()
            } else if ins.op == OpCode.GetField {
                ops = "field[" + ins.n.str() + "]"
            }
            if out != "" {
                out = out + "\n"
            }
            out = f"${out}${hex4(offs.get(j))}  ${op_name(ins.op)} ${ops}"
        }
        j = j + 1
    }
    return out
}

}

// W3:use 语句记录(kind:auto|rs|py|c)
type CGUse {
    kind str
    module str
    items str
    wildcard int
}

// W3:跨模块调用延迟解析条目(链接期定址)
type CGDefer {
    ins_idx int
    symbol str
}

// W3:名字是否在 use items(逗号连接串)中
fn cg_items_has(items str, name str) bool {
    var i = 0
    var start = 0
    var n = items.len()
    while i <= n {
        var at_end = i == n
        var is_sep = false
        if !at_end {
            if items.char_at(i) == ',' {
                is_sep = true
            }
        }
        if at_end || is_sep {
            if items.slice(start, i) == name {
                return true
            }
            start = i + 1
        }
        i = i + 1
    }
    return false
}

// W2:全局初始化重放条目(name + init 表达式 token 闭区间)
type CGInit {
    name str
    from int
    to int
}

type CGEnum {
    key str
    val int
}

type CGType {
    name str
    fields List<str>
    // W3(525):字段类型名平行表(recv_ty 链式解析:b.vals.push 的
    // vals:List<int> → 容器方法 CallNat 分派)
    ftys List<str>
}

// 指令字节宽度(与 Rust opcode 编码一致;S4 子集)。new.instance/
// is.variant 的名字内联字节随名长(Plan 447 部分②);get.generic.field
// 的 u32 操作数在 Rust 侧按 1B 操作数+3B 残留(nop)错位展示,照抄
pub enum OpCode {
    Line
    Add
    Sub
    Mul
    Div
    Mod
    Eq
    Ne
    Lt
    Gt
    Le
    Ge
    And
    Or
    Not
    Neg
    StrCat
    ConstI32
    LoadStr
    LoadLoc0
    LoadLoc1
    LoadLoc2
    LoadLocal
    StoreLoc0
    StoreLoc1
    StoreLocal
    FnProlog
    Reserve
    Ret
    Call
    CallNat
    // W4(525):闭包族——D29 谱系自有模型(可观察行为对齐宿主 Direct
    // Capture;宿主 closure 反汇编乱码级不可镜像,m4 层闭包语料迁 g 件)
    MakeClo
    CallClo
    Jmp
    JmpZ
    JmpNz
    PushBool
    PushNil
    Dup
    Pop
    ArrLen
    CreateArr
    GetElem
    SetElem
    IsVariant
    NewInstance
    ConstructInstance
    GetGenericField
    BuildFstr
    Halt
    Nop
    Blank
    GetField
    SetField
    SetGenericField
    Const0
    LoadGlobal
    StoreGlobal
}

// 助记符文本(M4 dump 序列化的唯一口径;447-③C1:载体 str → OpCode)
pub fn op_name(op OpCode) str {
    is op {
        OpCode.Line -> ".line"
        OpCode.Add -> "add"
        OpCode.Sub -> "sub"
        OpCode.Mul -> "mul"
        OpCode.Div -> "div"
        OpCode.Mod -> "mod"
        OpCode.Eq -> "eq"
        OpCode.Ne -> "ne"
        OpCode.Lt -> "lt"
        OpCode.Gt -> "gt"
        OpCode.Le -> "le"
        OpCode.Ge -> "ge"
        OpCode.And -> "and"
        OpCode.Or -> "or"
        OpCode.Not -> "not"
        OpCode.Neg -> "neg"
        OpCode.StrCat -> "str.cat"
        OpCode.ConstI32 -> "const.i32"
        OpCode.LoadStr -> "load.str"
        OpCode.LoadLoc0 -> "load.loc.0"
        OpCode.LoadLoc1 -> "load.loc.1"
        OpCode.LoadLoc2 -> "load.loc.2"
        OpCode.LoadLocal -> "load.local"
        OpCode.StoreLoc0 -> "store.loc.0"
        OpCode.StoreLoc1 -> "store.loc.1"
        OpCode.StoreLocal -> "store.local"
        OpCode.FnProlog -> "fn.prolog"
        OpCode.Reserve -> "reserve"
        OpCode.Ret -> "ret"
        OpCode.Call -> "call"
        OpCode.CallNat -> "call.nat"
        OpCode.MakeClo -> "make.clo"
        OpCode.CallClo -> "call.clo"
        OpCode.Jmp -> "jmp"
        OpCode.JmpZ -> "jmp.z"
        OpCode.JmpNz -> "jmp.nz"
        OpCode.PushBool -> "push.bool"
        OpCode.PushNil -> "push.nil"
        OpCode.Dup -> "dup"
        OpCode.Pop -> "pop"
        OpCode.ArrLen -> "arr.len"
        OpCode.CreateArr -> "create.arr"
        OpCode.GetElem -> "get.elem"
        OpCode.SetElem -> "set.elem"
        OpCode.IsVariant -> "is.variant"
        OpCode.NewInstance -> "new.instance"
        OpCode.ConstructInstance -> "construct.instance"
        OpCode.GetGenericField -> "get.generic.field"
        OpCode.BuildFstr -> "build.fstr"
        OpCode.Halt -> "halt"
        OpCode.Nop -> "nop"
        OpCode.GetField -> "get.field"
        OpCode.SetField -> "set.field"
        OpCode.SetGenericField -> "set.generic.field"
        OpCode.Const0 -> "const.0"
        OpCode.LoadGlobal -> "load.global"
        OpCode.StoreGlobal -> "store.global"
        else -> ""
    }
}

fn i_size(op OpCode) int {
    is op {
        OpCode.FnProlog -> 3
        OpCode.Reserve -> 2
        OpCode.Jmp | OpCode.JmpZ | OpCode.JmpNz -> 3
        OpCode.Line -> 3
        OpCode.LoadStr -> 5
        OpCode.Call -> 5
        OpCode.CallNat -> 3
        OpCode.MakeClo -> 3
        OpCode.CallClo -> 3
        OpCode.ConstI32 -> 5
        OpCode.PushBool -> 2
        OpCode.Ret -> 2
        OpCode.LoadLocal | OpCode.StoreLocal -> 2
        OpCode.CreateArr -> 2
        OpCode.GetGenericField -> 2
        // W1:get.field 真宽 u32(5);set.generic.field 同 get.generic.field
        // 的 u8 读宽形态(2+幽灵 nop);set.field 无操作数(1)
        OpCode.GetField -> 5
        OpCode.SetField -> 1
        OpCode.SetGenericField -> 2
        OpCode.Const0 -> 1
        OpCode.LoadGlobal -> 5
        OpCode.StoreGlobal -> 5
        else -> 1
    }
}

// 名字内联指令的字节宽(new.instance=1+名长;is.variant=3+名长:
// 操作码+u16 名长+名字节,镜像宿主 emit_u16 + bytes)
fn i_size_named(op OpCode, s str, n int) int {
    var name = s
    // s 形如 "\"Val.VI\"" —— 剥引号
    if name.len() >= 2 && name.char_at(0) == '"' {
        name = name.slice(1, name.len() - 1)
    }
    if op == OpCode.NewInstance {
        return 1 + name.len()
    }
    if op == OpCode.IsVariant {
        return 3 + name.len()
    }
    // build.fstr:操作码+u8 段数+每段 u8 tag(镜像宿主 BUILD_FSTR)
    if op == OpCode.BuildFstr {
        return 2 + n
    }
    return i_size(op)
}

// 域内变量 idx 升序收集
fn cg_sort_ints_of_vars(sc List<CGVar>) List<int> {
    var out List<int> = List.new()
    var k = 0
    while k < sc.len() {
        out.push(sc.get(k).idx)
        k = k + 1
    }
    var a = 0
    while a < out.len() {
        var b = a + 1
        while b < out.len() {
            if out.get(b) < out.get(a) {
                var t = out.get(a)
                out.set(a, out.get(b))
                out.set(b, t)
            }
            b = b + 1
        }
        a = a + 1
    }
    return out
}

// ── 表达式发射 ────────────────────────────────────────────────

fn cg_binop_mnem(k Op) OpCode {
    if k == Op.Add || k == Op.AddEq {
        return OpCode.Add
    }
    if k == Op.Sub || k == Op.SubEq {
        return OpCode.Sub
    }
    if k == Op.Mul || k == Op.MulEq {
        return OpCode.Mul
    }
    if k == Op.Div || k == Op.DivEq {
        return OpCode.Div
    }
    if k == Op.Mod || k == Op.ModEq {
        return OpCode.Mod
    }
    if k == Op.Eq {
        return OpCode.Eq
    }
    if k == Op.Neq {
        return OpCode.Ne
    }
    if k == Op.Lt {
        return OpCode.Lt
    }
    if k == Op.Gt {
        return OpCode.Gt
    }
    if k == Op.Le {
        return OpCode.Le
    }
    if k == Op.Ge {
        return OpCode.Ge
    }
    if k == Op.And {
        return OpCode.And
    }
    if k == Op.Or {
        return OpCode.Or
    }
    return OpCode.Blank
}

fn cg_is_assign_op(k Op) bool {
    is k {
        Op.Asn | Op.AddEq | Op.SubEq | Op.MulEq | Op.DivEq | Op.ModEq -> true
        else -> false
    }
}

// 值表达式发射(优先级爬升;复用 parser.at 的 infix_l/infix_r/is_op_kind)
// f-string 发射(447-③ 11.2a;镜像宿主 codegen.rs 4990 BUILD_FSTR):
// 逐段先发射(字面段 load.str;$Ident 变量加载;${expr} 子 tokenize +
// cg_expr 直走),再发 build.fstr(count + tags;tag:1=str 0=int,
// 镜像宿主 expr_type_hint——Ident 查变量表,非 str 即 int/未知 0)
fn cg_fstr(mut c CG, mut p P) {
    p.next()
    var content = p.text()
    p.next()
    p.next()
    var tags = ""
    var n_parts = 0
    var lit = ""
    var i = 0
    var n = content.len()
    while i < n {
        var ch = content.char_at(i)
        if ch == 36 {
            if lit != "" {
                var pi = c.pool_add(lit)
                c.emit(OpCode.LoadStr, "", pi)
                tags = f"${tags}1"
                n_parts = n_parts + 1
                lit = ""
            }
            if i + 1 < n && content.char_at(i + 1) == 123 {
                var depth = 1
                var j = i + 2
                while j < n && depth > 0 {
                    var cj = content.char_at(j)
                    if cj == 123 {
                        depth = depth + 1
                    } else if cj == 125 {
                        depth = depth - 1
                    }
                    j = j + 1
                }
                if depth != 0 {
                    c.fail("fstr: unterminated interpolation ")
                    return
                }
                var inner = content.slice(i + 2, j - 1)
                var subtoks = tokenize(inner)
                var subp = parse_new(subtoks)
                cg_expr(c, subp, 0)
                if c.err != "" || subp.err != "" {
                    return
                }
                var tg = 0
                if subp.pos < subtoks.len() {
                    var ftk = subtoks.get(0)
                    if ftk.kind == TokenKind.Ident && c.var_ty(ftk.text) == "str" {
                        tg = 1
                    }
                }
                tags = tags + tg.str()
                n_parts = n_parts + 1
                i = j
            } else {
                var j2 = i + 1
                var stop = false
                while j2 < n && !stop {
                    var cj2 = content.char_at(j2)
                    var ok2 = (cj2 >= 97 && cj2 <= 122) || (cj2 >= 65 && cj2 <= 90) || (cj2 >= 48 && cj2 <= 57) || cj2 == 95
                    if !ok2 {
                        stop = true
                    } else {
                        j2 = j2 + 1
                    }
                }
                var nm = content.slice(i + 1, j2)
                var vi = c.lookup(nm)
                if vi < 0 {
                    c.fail("fstr: unknown ident $" + nm)
                    return
                }
                c.emit_load(vi)
                var tg2 = 0
                if c.var_ty(nm) == "str" {
                    tg2 = 1
                }
                tags = tags + tg2.str()
                n_parts = n_parts + 1
                i = j2
            }
        } else {
            lit = lit + content.slice(i, i + 1)
            i = i + 1
        }
    }
    if lit != "" {
        var pi2 = c.pool_add(lit)
        c.emit(OpCode.LoadStr, "", pi2)
        tags = f"${tags}1"
        n_parts = n_parts + 1
    }
    // tags 文本对齐宿主 disasm:parts=N, tags=[0, 1]
    var txt = f"parts=${n_parts.str()}, tags=["
    var t3 = 0
    while t3 < n_parts {
        if t3 > 0 {
            txt = f"${txt}, "
        }
        txt = txt + tags.slice(t3, t3 + 1)
        t3 = t3 + 1
    }
    txt = f"${txt}]"
    c.emit(OpCode.BuildFstr, txt, n_parts)
    c.str_flag = 1
    c.arr_flag = 0
}

// W4(525):闭包表达式编译——捕获=体内自由变量∩外层作用域(按值,
// 首引序);隐 fn "$cloN"(参数=捕获(前)+声明参数(后),cg_fn 同款
// 帧/prolog 回填/尾码);创建点=捕获值依序入栈+make.clo n=fnidx
// s=ncap。调闭包变量见 Ident 调用臂(call.clo n=nargs)。
// W4(525):`(params) =>` 前瞻(depth 扫描至配对 RParen,后随 =>)
fn cg_clo_paren_ahead(mut p P) bool {
    var depth = 1
    var i = p.pos + 1
    while i < p.toks.len() {
        var tk = p.toks.get(i).kind
        if tk == TokenKind.LParen || tk == TokenKind.LSquare || tk == TokenKind.LBrace {
            depth = depth + 1
        } else if tk == TokenKind.RParen || tk == TokenKind.RSquare || tk == TokenKind.RBrace {
            depth = depth - 1
            if depth == 0 {
                return i + 1 < p.toks.len() && p.toks.get(i + 1).kind == TokenKind.DoubleArrow
            }
        } else if tk == TokenKind.EOF {
            return false
        }
        i = i + 1
    }
    return false
}

fn cg_closure(mut c CG, mut p P, single bool) {
    var names List<str> = List.new()
    if single {
        names.push(p.text())
        p.next()
    } else {
        p.next()
        p.skip_empty_lines()
        while c.err == "" && p.err == "" && p.kind() != TokenKind.EOF && p.kind() != TokenKind.RParen {
            if !is_name_kind(p.kind()) {
                c.fail("closure: expected param")
                return
            }
            names.push(p.text())
            p.next()
            // W4(525):注解双形态(: T 与空格 T——镜像 parse_fn_params)
            if p.kind() == TokenKind.Colon {
                p.next()
            }
            if is_type_name(p) {
                parse_type(p)
            }
            if p.kind() == TokenKind.Comma {
                p.next()
                p.skip_empty_lines()
            }
        }
        p.expect(TokenKind.RParen)
    }
    p.expect(TokenKind.DoubleArrow)
    p.skip_empty_lines()
    // 捕获分析:体 token 扫描(至深度 0 EOS),自由名命中外层作用域
    var captured List<str> = List.new()
    var bi = p.pos
    var depth = 0
    while bi < p.toks.len() {
        var tk = p.toks.get(bi).kind
        if tk == TokenKind.LParen || tk == TokenKind.LSquare || tk == TokenKind.LBrace {
            depth = depth + 1
        } else if tk == TokenKind.RParen || tk == TokenKind.RSquare || tk == TokenKind.RBrace {
            if depth == 0 {
                break
            }
            depth = depth - 1
        } else if depth == 0 && (tk == TokenKind.Newline || tk == TokenKind.Semi) {
            break
        } else if tk == TokenKind.Ident {
            var w = p.toks.get(bi).text
            var is_param = false
            var pi = 0
            while pi < names.len() {
                if names.get(pi) == w {
                    is_param = true
                }
                pi = pi + 1
            }
            var already = false
            var ci = 0
            while ci < captured.len() {
                if captured.get(ci) == w {
                    already = true
                }
                ci = ci + 1
            }
            if !is_param && !already && w != "print" && c.lookup(w) >= 0 {
                var is_fn = false
                var fi = 0
                while fi < c.fns.len() {
                    if c.fns.get(fi).name == w {
                        is_fn = true
                    }
                    fi = fi + 1
                }
                if !is_fn {
                    captured.push(w)
                }
            }
        }
        bi = bi + 1
    }
    // 隐 fn 编译(cg_fn 骨架:帧/prolog/回填)
    var clo_name = "$clo" + c.fns.len().str()
    var saved_args = c.n_args
    var saved_max = c.max_idx
    var saved_hi = c.hi_idx
    c.max_idx = -1
    c.hi_idx = -1
    var jover = c.emit(OpCode.Jmp, "", -1)
    var entry = c.ins.len()
    c.fns.push(FnEntry(clo_name, entry))
    c.fn_rets.push("")
    c.push_scope()
    var prolog = c.emit(OpCode.FnProlog, "", 0)
    var reserve = c.emit(OpCode.Reserve, "", 0)
    var n_total = 0
    var ci2 = 0
    while ci2 < captured.len() {
        var cty = c.var_ty(captured.get(ci2))
        c.add_var(captured.get(ci2), 0, cty)
        n_total = n_total + 1
        ci2 = ci2 + 1
    }
    var pi2 = 0
    while pi2 < names.len() {
        c.add_var(names.get(pi2), 0, "")
        n_total = n_total + 1
        pi2 = pi2 + 1
    }
    c.n_args = n_total
    cg_expr(c, p, 0)
    var rs = f"n_args=${n_total.str()}"
    c.emit(OpCode.Ret, rs, n_total)
    c.pop_scope()
    var n_locals = 0
    if c.hi_idx >= n_total {
        n_locals = c.hi_idx + 1 - n_total
    }
    c.ins.get(prolog).s = f"args=${n_total.str()}, locals=${n_locals.str()}"
    c.ins.get(prolog).n = n_total
    c.ins.get(reserve).s = n_locals.str()
    c.ins.get(reserve).n = n_locals
    c.ins.get(jover).n = c.ins.len()
    c.n_args = saved_args
    c.max_idx = saved_max
    c.hi_idx = saved_hi
    // 创建点:捕获值依序入栈 → make.clo
    var ci3 = 0
    while ci3 < captured.len() {
        var cidx = c.lookup(captured.get(ci3))
        c.emit_load(cidx)
        ci3 = ci3 + 1
    }
    var fn_idx = -1
    var fi2 = 0
    while fi2 < c.fns.len() {
        if c.fns.get(fi2).name == clo_name {
            fn_idx = fi2
        }
        fi2 = fi2 + 1
    }
    c.emit(OpCode.MakeClo, captured.len().str(), fn_idx)
    c.str_flag = 0
    c.arr_flag = 0
    c.inst_ty = ""
    c.recv_ty = ""
}

fn cg_expr(mut c CG, mut p P, min int) {
    if c.err != "" {
        return
    }
    var k = p.kind()
    // W4(525):闭包表达式前瞻——单参 `x =>` / `(params) =>`(主式位
    // 拦截,镜像宿主 closure 前置判定)
    if k == TokenKind.Ident && p.peek(1) == TokenKind.DoubleArrow {
        cg_closure(c, p, true)
        return
    }
    if k == TokenKind.LParen && cg_clo_paren_ahead(p) {
        cg_closure(c, p, false)
        return
    }
    // 每次表达式求值从干净 flag 起;原子按需置位(str/arr/inst_ty)
    c.str_flag = 0
    c.arr_flag = 0
    c.inst_ty = ""
    c.recv_ty = ""
    c.primary_tyname = ""
    // C3(Plan 447):p_kind 链 is 化——镜像宿主 match 臂形
    is k {
        TokenKind.Not -> {
        p.next()
        cg_expr(c, p, 28)
        c.emit(OpCode.Not, "", 0)
        c.str_flag = 0
        c.arr_flag = 0
        }
        TokenKind.Sub | TokenKind.Add -> {
        // 一元符号:operand 后发 neg(镜像 Rust 6414;一元 + 为 no-op)
        p.next()
        cg_expr(c, p, 28)
        if k == TokenKind.Sub {
            c.emit(OpCode.Neg, "", 0)
        }
        c.str_flag = 0
        c.arr_flag = 0
        }
        TokenKind.FStrStart -> {
        cg_fstr(c, p)
        }
        TokenKind.Int -> {
        var t = p.text()
        p.next()
        var cv = int_val(t).str()
        c.emit(OpCode.ConstI32, cv, int_val(t))
        }
        TokenKind.Str -> {
        var s = p.text()
        p.next()
        var idx = c.pool_add(s)
        c.emit(OpCode.LoadStr, "", idx)
        c.str_flag = 1
        }
        TokenKind.True -> {
        p.next()
        c.emit(OpCode.PushBool, "true", 0)
        }
        TokenKind.False -> {
        p.next()
        c.emit(OpCode.PushBool, "false", 0)
        }
        TokenKind.Char -> {
        // Plan 447 部分②:字符字面量 → const.i32 码点(镜像宿主 Char 编译)
        var t = p.text()
        p.next()
        var cp = t.char_at(0)
        c.emit(OpCode.ConstI32, cp.str(), cp)
        }
        TokenKind.Ident -> {
        var name = p.text()
        // Plan 447 部分②:枚举路径前瞻判定(不消费)——注册命中才拦截,
        // 否则落回原标识符路径(方法调用 a.len() 等不受影响)。
        // Enum.Variant → const.i32 判别值;Enum.Variant(args) → 载荷
        // 构造(值…, const 名长, new.instance, const 字段数,
        // construct.instance —— 镜像宿主 generic_registry 路径 5128-5147)
        var is_enum_path = false
        var variant = ""
        if p.peek(1) == TokenKind.Dot {
            var seg = p.peek_text(2)
            var dk = f"${name}.${seg}"
            if c.const_lookup(dk) != -999999 || c.ctor_lookup(dk) >= 0 {
                is_enum_path = true
                variant = seg
            }
        }
        if is_enum_path {
            p.next()
            p.next()
            p.next()
            var key = f"${name}.${variant}"
            if p.kind() == TokenKind.LParen {
                var fc = c.ctor_lookup(key)
                if fc < 0 {
                    c.fail("unknown enum ctor: " + key)
                    return
                }
                cg_call_args(c, p)
                var nm = key.len()
                c.emit(OpCode.ConstI32, nm.str(), nm)
                c.emit(OpCode.NewInstance, "\"" + key + "\"", 0)
                c.emit(OpCode.ConstI32, fc.str(), fc)
                c.emit(OpCode.ConstructInstance, "", 0)
            } else {
                var dv = c.const_lookup(key)
                c.emit(OpCode.ConstI32, dv.str(), dv)
            }
        } else {
        p.next()
        // W1 构造字面量:已注册类型紧随 { → NEW_INSTANCE 族发射;
        // inst_ty 回传类型名(let 绑定记 var_types 用)
        if p.kind() == TokenKind.LBrace && c.tys_lookup(name) >= 0 {
            cg_ctor_emit(c, p, name)
            c.inst_ty = name
            return
        }
        // W2(525 复审补):位置参构造 T(v1, v2)——已注册类型紧随 ( →
        // 值按位序 + NEW_INSTANCE 族尾(镜像宿主位置参路径,13-methods
        // 样板 `return Counter(v)` 形态;同 cg_ctor_emit 尾序)
        if p.kind() == TokenKind.LParen && c.tys_lookup(name) >= 0 {
            p.next()
            p.skip_empty_lines()
            var pn = 0
            if p.kind() != TokenKind.RParen {
                cg_expr(c, p, 0)
                pn = 1
                while p.kind() == TokenKind.Comma || p.kind() == TokenKind.Newline {
                    p.next()
                    p.skip_empty_lines()
                    cg_expr(c, p, 0)
                    pn = pn + 1
                }
            }
            p.expect(TokenKind.RParen)
            var pnm = name.len()
            c.emit(OpCode.ConstI32, pnm.str(), pnm)
            c.emit(OpCode.NewInstance, "\"" + name + "\"", 0)
            c.emit(OpCode.ConstI32, pn.str(), pn)
            c.emit(OpCode.ConstructInstance, "", 0)
            c.arr_flag = 0
            c.str_flag = 0
            c.inst_ty = name
            return
        }
        // W3:模块限定调用 db.fn(...)(db 为已 use 模块名;镜像宿主
        // auto_modules + mod.fn reloc 符号——链接期定址;调用后可接
        // 后缀/中缀,故 call_done 包裹而非 return)
        var call_done = false
        // 注:括号化 || 不入 && 链(a2r 转译不保括号优先级——提中间变量)
        var qk_name = p.peek(1) == TokenKind.Ident || is_soft_ident_kind(p.peek(1))
        if p.kind() == TokenKind.Dot && qk_name && p.peek(2) == TokenKind.LParen && c.is_module(name) {
            p.next()
            var qfn = p.text()
            p.next()
            // 接收者占位:宿主 Ident 模块兜底推 const.i32 0(Plan 437
            // 注记的已知占位泄漏——镜像;帧 bp 锚定下无害)
            c.emit(OpCode.ConstI32, "0", 0)
            cg_call_args(c, p)
            var qdi = c.emit(OpCode.Call, "", -1)
            c.defers.push(CGDefer(qdi, name + "." + qfn))
            call_done = true
        }
        // W5(525):Some(e) 构造——内值直通(哨兵模型:Some 载体即内值,
        // None=-1 哨兵;镜像宿主 CREATE_SOME 标记 no-op 的可观察面)
        if !call_done && name == "Some" && p.kind() == TokenKind.LParen {
            cg_call_args(c, p)
        } else if !call_done && name == "print" && p.kind() == TokenKind.LParen {
            cg_call_args(c, p)
            c.emit(OpCode.CallNat, "nat#10", 10)
        } else if !call_done && p.kind() == TokenKind.LParen {
            var fe = -1
            var fi = 0
            while fi < c.fns.len() {
                if c.fns.get(fi).name == name {
                    fe = fi
                }
                fi = fi + 1
            }
            if fe < 0 {
                // W4(525):闭包变量调用——局部持有 VClo,call.clo n=nargs
                // (捕获值由引擎从闭包载体回放为首参组)
                if c.lookup(name) >= 0 {
                    var ncl = cg_call_args(c, p)
                    c.emit_load(c.lookup(name))
                    c.emit(OpCode.CallClo, "", ncl)
                    c.str_flag = 0
                    c.arr_flag = 0
                    c.inst_ty = ""
                    c.recv_ty = ""
                    return
                }
                // W3:导入名(use mod: item / 通配)→ 延迟调用,链接期定址
                // (无 return:调用结果可接后缀/中缀,如 get_base() * 2)
                var isym = c.import_symbol(name)
                if isym != "" {
                    cg_call_args(c, p)
                    var idi = c.emit(OpCode.Call, "", -1)
                    c.defers.push(CGDefer(idi, isym))
                } else {
                    c.fail("unknown fn: " + name)
                    return
                }
            } else {
                cg_call_args(c, p)
                c.emit(OpCode.Call, "", fe)
            }
        } else if !call_done && name == "None" && c.lookup("None") < 0 {
            // W5(525):None 哨兵(镜像宿主 CREATE_NONE 推 -1;IS_SOME
            // 判 !=-1——哨兵别名同宿主文档语义)
            c.emit(OpCode.ConstI32, "-1", -1)
        } else if !call_done && p.kind() == TokenKind.Dot && c.lookup(name) < 0 && (c.tys_lookup(name) >= 0 || name == "List") {
            // W2(525):裸类型名 + 后随点——静态调用/静态字段探测位
            // (Type.m(args);类型名无值不发装载,后缀臂按 primary_tyname
            // 解析;宿主 unresolved-static → CALL reloc 同构)。
            // W3(525):内建容器 List 同位(List.new → call.nat nat#100)
            c.primary_tyname = name
        } else if !call_done {
            var idx = c.lookup(name)
            if idx < 0 {
                // W2:全局读(镜像宿主读链 局部>全局 优先序;W3 模块限名)
                if c.is_global(c.gkey(name)) {
                    var gkr = c.gkey(name)
                    var gidx = c.pool_add(gkr)
                    c.emit(OpCode.LoadGlobal, gidx.str(), gidx)
                    c.arr_flag = 0
                } else {
                    c.fail("unknown ident: " + name)
                    return
                }
            } else {
                c.emit_load(idx)
                c.arr_flag = c.var_arr(idx)
                // W2:str 型变量加载置 str_flag(镜像宿主 var_types 的
                // String 性——s[i]+s[j] 发 str.cat;b39 实证)
                if c.var_ty(name) == "str" {
                    c.str_flag = 1
                }
                // W2(525):接收者类型回传(后缀方法调用解析)
                c.recv_ty = c.var_ty(name)
            }
        }
        }
        }
        TokenKind.Dot -> {
        // W2(525):接收者简写 .field/.method——宿主 dot_item 前导点 =
        // Dot(self, name);self=方法首参。本臂仅发 self 装载+类型回传,
        // **不消费 '.'**——后缀首跳臂(dot_seq==0 GetField / 方法调用)
        // 按 `.name` 原样接管
        var self_idx0 = c.lookup("self")
        if self_idx0 < 0 {
            c.fail("'.' shorthand outside method (no self)")
            return
        }
        c.emit_load(self_idx0)
        c.inst_ty = ""
        c.recv_ty = c.var_ty("self")
        }
        TokenKind.LParen -> {
        // W2:括号 group 透明(镜像宿主 group();-(x+y) 形态经此)
        p.next()
        cg_expr(c, p, 0)
        p.expect(TokenKind.RParen)
        }
        TokenKind.LSquare -> {
        // 数组字面量:elems 依次入栈,create.arr count=N(Rust 4865)
        p.next()
        p.skip_empty_lines()
        var n = 0
        if p.kind() != TokenKind.RSquare {
            cg_expr(c, p, 0)
            n = 1
            while p.kind() == TokenKind.Comma || p.kind() == TokenKind.Newline {
                p.next()
                p.skip_empty_lines()
                cg_expr(c, p, 0)
                n = n + 1
            }
        }
        p.expect(TokenKind.RSquare)
        c.emit(OpCode.CreateArr, "count=" + n.str(), n)
        c.arr_flag = 1
        }
        else -> {
        c.fail("unsupported expr atom: " + kind_name(k))
        return
        }
    }
    // 后缀链:下标读(get.elem);.len()(仅数组接收者,镜像 Rust 7177 闸)
    // W2:str_flag 保留——宿主字符串性穿透下标(b39:s[i]+s[j] 发 str.cat)
    while c.err == "" && p.kind() == TokenKind.LSquare {
        p.next()
        p.skip_empty_lines()
        // W2:str_flag 穿透下标——下标子表达式的 cg_expr 头部会清位,
        // 此处保存/恢复(宿主字符串性穿透;b39:s[i]+s[j] 发 str.cat)
        var save_str = c.str_flag
        cg_expr(c, p, 0)
        c.str_flag = save_str
        p.skip_empty_lines()
        p.expect(TokenKind.RSquare)
        c.emit(OpCode.GetElem, "", 0)
        c.arr_flag = 0
    }
    // W3(525):快径仅裸数组(arr_flag=1 且非 List 注解型——List 参数
    // /变量走 nat#103,b46 fn_sig/field 实证);List 接收者落到后缀
    // 方法臂(call.nat nat#103,宿主 List 对象非 raw array)
    if c.err == "" && c.arr_flag == 1 && find_sub(c.recv_ty, "List") != 0 && p.kind() == TokenKind.Dot && p.peek_text(1) == "len" && p.peek(2) == TokenKind.LParen && p.peek(3) == TokenKind.RParen {
        p.next()
        p.next()
        p.next()
        p.next()
        c.emit(OpCode.ArrLen, "", 0)
        c.str_flag = 0
        c.arr_flag = 0
    }
    // W1:点访问链深(0=原子直连首跳 → get.field;>0 链式后续跳 →
    // get.generic.field field=0 幽灵 nop 形态)
    var dot_seq = 0
    while c.err == "" {
        var opk = p.kind()
        // P2:循环顶 token 分派 is 化(11 种界符臂内 break;镜像 Rust
        // parser.rs:2425 的 match kind)
        is opk {
            TokenKind.EOF | TokenKind.Newline | TokenKind.Semi | TokenKind.LBrace | TokenKind.RBrace | TokenKind.Comma | TokenKind.Arrow | TokenKind.DoubleArrow | TokenKind.VBar | TokenKind.RSquare | TokenKind.RParen -> {
                break
            }
            else -> {
                if opk == TokenKind.Dot && t_is_type_prop(p) {
                    break
                }
                // W1 字段读:Dot+名(非 .type/非方法调用)→ 接收者已在
                // 栈,get.field field[N](名字池非去重追加——镜像宿主
                // 5842-5848 直接 push;读路径不分 var_types 形态,
                // 宿主非泛型与 fallback 同一发射);字段访问消费完直接
                // 回循环顶,不走通用中缀
                var dot_done = false
                if opk == TokenKind.Dot {
                    var fk2 = p.peek(1)
                    if fk2 == TokenKind.Ident || is_soft_ident_kind(fk2) {
                        if p.peek(2) == TokenKind.LParen {
                            // W2(525):方法调用 recv.m(args)——三类:
                            // ①recv_ty 命中(实例):接收者已在栈(self 位)
                            //   → 参数 → call fnidx("Type.m";宿主 CALL
                            //   reloc 同构,code.rs 9030 接收者先于参数)
                            // ②主式是类型名(c.tys 命中且非变量):静态
                            //   Type.m(args)——不推接收者(宿主 exports
                            //   已含,直接参数+CALL)
                            // ③其余:宿主 CALL_SPEC 兜底超 v2 裁剪
                            var mname2 = p.peek_text(1)
                            var recv_ty2 = c.recv_ty
                            if recv_ty2 == "" && dot_seq == 0 {
                                // 主式裸类型名静态调用探测:前缀主式记名
                                recv_ty2 = c.primary_tyname
                            }
                            // W3(525):内建容器 List 分派——基名 List →
                            // CallNat(宿主 native auto.list 族;静态
                            // new=100 无接收者,实例=接收者先推+参数;
                            // 发射序 b46 m4 对拍:load l;args;call.nat)
                            if strip_generic(recv_ty2) == "List" {
                                // W3(525):字段链接收者的 .len() 走 arr.len
                                // (宿主 b.vals.len 实证:Ident 变量=nat#103,
                                // 字段访问=ARRAY_LEN 两分支 List/str 分派)
                                if mname2 == "len" && dot_seq > 0 && p.peek(3) == TokenKind.RParen {
                                    p.next()
                                    p.next()
                                    p.next()
                                    p.next()
                                    c.emit(OpCode.ArrLen, "", 0)
                                    dot_done = true
                                    c.str_flag = 0
                                    c.arr_flag = 0
                                    c.inst_ty = ""
                                    c.recv_ty = ""
                                    c.primary_tyname = ""
                                    dot_seq = dot_seq + 1
                                    continue
                                }
                                var nid = list_nat_id(mname2)
                                if nid < 0 {
                                    c.fail("unsupported List method: " + mname2)
                                    return
                                }
                                p.next()
                                p.next()
                                // 接收者(实例)/无(静态 new)——主式装载
                                // 已就位;参数依次
                                cg_call_args(c, p)
                                c.emit(OpCode.CallNat, "nat#" + nid.str(), nid)
                                dot_done = true
                                c.str_flag = 0
                                c.arr_flag = 0
                                // get 的结果类型=接收者注解的元素型
                                // (List<List<int>>.get → List<int>;
                                // let 绑定 r0 的链式容器方法解析)
                                if mname2 == "get" {
                                    if find_sub(recv_ty2, "<") >= 0 && recv_ty2.len() > 5 {
                                        c.inst_ty = recv_ty2.slice(5, recv_ty2.len() - 1)
                                    } else {
                                        c.inst_ty = ""
                                    }
                                } else {
                                    c.inst_ty = ""
                                }
                                // W3(525):结果类型即链式后续跳的接收者型
                                // (rows.get(0).len() 实证;g29 四路 exec)
                                c.recv_ty = c.inst_ty
                                c.primary_tyname = ""
                                dot_seq = dot_seq + 1
                                continue
                            }
                            if recv_ty2 == "str" {
                                var snid = str_nat_id(mname2)
                                if snid >= 0 {
                                    p.next()
                                    p.next()
                                    cg_call_args(c, p)
                                    c.emit(OpCode.CallNat, "nat#" + snid.str(), snid)
                                    dot_done = true
                                    c.str_flag = 0
                                    c.arr_flag = 0
                                    c.inst_ty = ""
                                    // 链式接收者型:slice/replace/trim 回 str,
                                    // len/char_at 回 int(b58 链式 u.slice().trim() 锚)
                                    if snid == 1502 || snid == 1500 {
                                        c.recv_ty = ""
                                    } else {
                                        c.recv_ty = "str"
                                    }
                                    c.primary_tyname = ""
                                    dot_seq = dot_seq + 1
                                    continue
                                }
                            }
                            if recv_ty2 != "" {
                                var sym = recv_ty2 + "." + mname2
                                var fe2 = -1
                                var fi2 = 0
                                while fi2 < c.fns.len() {
                                    if c.fns.get(fi2).name == sym {
                                        fe2 = fi2
                                    }
                                    fi2 = fi2 + 1
                                }
                                if fe2 < 0 {
                                    c.fail("unknown method: " + sym)
                                    return
                                }
                                p.next()
                                p.next()
                                cg_call_args(c, p)
                                c.emit(OpCode.Call, "", fe2)
                                dot_done = true
                                c.str_flag = 0
                                c.arr_flag = 0
                                // W2(525):结果类型回传(fn_rets;let
                                // 绑定/链式接收者解析;W3:兼作链式接收者型)
                                c.inst_ty = c.fn_rets.get(fe2)
                                c.recv_ty = c.inst_ty
                                c.primary_tyname = ""
                                dot_seq = dot_seq + 1
                                continue
                            }
                            c.fail("unsupported method call: ." + mname2)
                            return
                        }
                        var fname2 = p.peek_text(1)
                        // W3(525):首跳前记接收者型(跳后 recv_ty=字段型,
                        // 链式容器方法 b.vals.push 用)
                        var hop_recv_ty = c.recv_ty
                        p.next()
                        p.next()
                        if dot_seq == 0 {
                            // 首跳(原子直连,宿主 Ident 接收者 var_types 命中/
                            // User 型):get.field field[N](名字池非去重追加)
                            var fidx4 = c.pool_push(fname2)
                            c.emit(OpCode.GetField, "field[" + fidx4.str() + "]", fidx4)
                            // W3(525):字段类型回传(注解面;未知型清位)
                            if hop_recv_ty != "" {
                                c.recv_ty = c.field_ty(hop_recv_ty, fname2)
                            }
                        } else {
                            // 链式后续跳(接收者已是表达式,宿主 untyped
                            // fallback):get.generic.field field=0 + 3 幽灵 nop
                            c.emit(OpCode.GetGenericField, "field=0", 0)
                            c.emit(OpCode.Nop, "", 0)
                            c.emit(OpCode.Nop, "", 0)
                            c.emit(OpCode.Nop, "", 0)
                        }
                        dot_seq = dot_seq + 1
                        c.str_flag = 0
                        c.arr_flag = 0
                        c.inst_ty = ""
                        dot_done = true
                    } else {
                        c.fail("unsupported dot access: ." + p.peek_text(1))
                        break
                    }
                }
                if !dot_done {
                if !is_op_kind(opk) {
                    c.fail("expected infix op, got " + kind_name(opk))
                    break
                }
                var l = infix_l(p_op(opk))
                if l == 0 || l < min {
                    break
                }
                if cg_is_assign_op(p_op(opk)) {
                    c.fail("nested assignment unsupported")
                    break
                }
                p.next()
                if opk == TokenKind.Or || opk == TokenKind.And {
                    p.skip_empty_lines()
                }
                var lhs_str = c.str_flag
                c.str_flag = 0
                cg_expr(c, p, infix_r(p_op(opk)))
                var rhs_str = c.str_flag
                var mn = cg_binop_mnem(p_op(opk))
                var str_either = lhs_str == 1 || rhs_str == 1
                if opk == TokenKind.Add && str_either {
                    mn = OpCode.StrCat
                    c.str_flag = 1
                } else {
                    c.str_flag = 0
                }
                c.arr_flag = 0
                if mn != OpCode.Blank {
                    c.emit(mn, "", 0)
                }
                }
            }
        }
    }
}

// 调用实参:( 已在 cur;消费至 RParen
fn cg_call_args(mut c CG, mut p P) int {
    p.next()
    p.skip_empty_lines()
    var n = 0
    if p.kind() != TokenKind.RParen {
        cg_expr(c, p, 0)
        n = 1
        while p.kind() == TokenKind.Comma || p.kind() == TokenKind.Newline {
            p.next()
            p.skip_empty_lines()
            cg_expr(c, p, 0)
            n = n + 1
        }
    }
    p.expect(TokenKind.RParen)
    return n
}

// ── 语句发射(.line 由语句步行者发,见 cg_stmts) ────────────────

// ── 枚举声明注册(Plan 447 部分② Phase 6:镜像宿主 Stmt::EnumDecl 的
// enum_values + generic_registry 注册,零字节码)────────────────

fn cg_enum_decl(mut c CG, mut p P) {
    p.next()
    if !is_name_kind(p.kind()) {
        c.fail("expected enum name")
        return
    }
    var name = p.text()
    p.next()
    p.expect(TokenKind.LBrace)
    p.skip_empty_lines()
    var next_val = 0
    var idx = 0
    while c.err == "" && p.kind() != TokenKind.EOF && p.kind() != TokenKind.RBrace {
        if !is_name_kind(p.kind()) {
            c.fail("expected variant name")
            return
        }
        var vname = p.text()
        p.next()
        var key = f"${name}.${vname}"
        var nfields = 0
        var has_payload = false
        if p.kind() == TokenKind.LParen {
            p.next()
            p.skip_empty_lines()
            has_payload = true
            if p.kind() != TokenKind.RParen {
                var more = true
                while more {
                    parse_type(p)
                    nfields = nfields + 1
                    if p.kind() == TokenKind.Comma {
                        p.next()
                        p.skip_empty_lines()
                    } else {
                        more = false
                    }
                }
            }
            p.expect(TokenKind.RParen)
        } else if p.kind() == TokenKind.LBrace {
            p.next()
            p.skip_empty_lines()
            has_payload = true
            while c.err == "" && p.kind() != TokenKind.RBrace && p.kind() != TokenKind.EOF {
                if !is_name_kind(p.kind()) {
                    c.fail("expected variant field name")
                    return
                }
                p.next()
                if p.kind() == TokenKind.Colon {
                    p.next()
                }
                parse_type(p)
                nfields = nfields + 1
                if p.kind() == TokenKind.Comma {
                    p.next()
                    p.skip_empty_lines()
                }
                p.skip_empty_lines()
            }
            p.expect(TokenKind.RBrace)
        }
        // 判别值:scalar 链(auto/显式 = N)或载荷变体按位序(镜像宿主
        // scalar_value.unwrap_or(i);载荷不入 Display 值链)
        var val = next_val
        if has_payload {
            val = idx
        }
        if p.kind() == TokenKind.Asn {
            p.next()
            if p.kind() != TokenKind.Int {
                c.fail("unsupported enum value")
                return
            }
            val = int_val(p.text())
            p.next()
            next_val = val + 1
        } else if !has_payload {
            next_val = val + 1
        }
        c.consts.push(CGEnum(key, val))
        if has_payload {
            c.ctors.push(CGEnum(key, nfields))
        }
        idx = idx + 1
        // 变体间空行:静默跳过
        while p.kind() == TokenKind.Semi || p.kind() == TokenKind.Newline || p.kind() == TokenKind.Comma {
            p.next()
        }
        p.skip_empty_lines()
    }
    p.expect(TokenKind.RBrace)
}

// ── is 语句发射(Plan 447 部分② Phase 6:镜像宿主 Stmt::Is 3417-3800)──

// 臂体:{...} 块(compile_body_inline,不推作用域);return 单语句;
// 其余单表达式(无 pop,镜像 Stmt::Expr 语句)
fn cg_is_arm_body(mut c CG, mut p P) {
    if p.kind() == TokenKind.LBrace {
        cg_body_inline(c, p)
        return
    }
    // Plan 495: 非块体 arm 体镜像宿主 parse_expr_or_body 的 stmt_line——
    // arm 体首 token 行经 cg_line 发射(块体由 cg_stmts 按体内语句发)
    c.line(p.line())
    if p.kind() == TokenKind.Return {
        cg_stmt(c, p)
        return
    }
    if p.kind() == TokenKind.Break || p.kind() == TokenKind.Continue {
        cg_stmt(c, p)
        return
    }
    cg_expr(c, p, 0)
}

// 单模式比较发射:load t;<pattern 表达式>;eq —— 标量枚举判别值直接
// const.i32,字面量按各自形态
// W3(Plan 511)use 语句消费+记录(词法形态镜像 parser.at parse_use;
// use.rs/py 的域外报错归模块解析器 cg_resolve——此处仅消费)
fn cg_use(mut c CG, mut p P) {
    p.next()
    if p.kind() == TokenKind.Dot {
        var lang = p.peek_text(1)
        p.next()
        p.next()
        var path = p.text()
        p.next()
        while p.kind() == TokenKind.Colon && p.peek(1) == TokenKind.Colon {
            p.next()
            p.next()
            path = path + "." + p.text()
            p.next()
        }
        var kind = "rs"
        if lang == "py" {
            kind = "py"
        } else if lang == "c" {
            kind = "c"
        }
        c.uses.push(CGUse(kind, path, "", 0))
        return
    }
    if !is_name_kind(p.kind()) {
        c.fail("expected module name after use")
        return
    }
    var name = p.text()
    p.next()
    while p.kind() == TokenKind.Dot {
        p.next()
        if !is_name_kind(p.kind()) {
            c.fail("expected path segment after dot")
            return
        }
        name = name + "." + p.text()
        p.next()
    }
    var items = ""
    var wildcard = 0
    if p.kind() == TokenKind.Colon {
        p.next()
        if p.kind() == TokenKind.Star {
            p.next()
            wildcard = 1
        } else {
            if !is_name_kind(p.kind()) {
                c.fail("expected identifier or *")
                return
            }
            items = p.text()
            p.next()
            while p.kind() == TokenKind.Comma {
                p.next()
                if !is_name_kind(p.kind()) {
                    c.fail("expected identifier")
                    return
                }
                items = items + "," + p.text()
                p.next()
            }
        }
    }
    c.uses.push(CGUse("auto", name, items, wildcard))
}

// W2(525):ext 块编译——方法经 cg_fn 名重整通道("Type.method";宿主
// parse 级并入 TypeDecl.methods → 编译位=Type 声明位,本侧由 pass1
// 预扫达成同序);类型须已注册;同名覆盖语义收窄为追加(语料无同名)
fn cg_ext(mut c CG, mut p P) {
    p.next()
    if !is_name_kind(p.kind()) {
        c.fail("ext: expected type name")
        return
    }
    var ty = p.text()
    p.next()
    if p.kind() == TokenKind.Lt {
        c.fail("v2 unsupported: ext generic target")
        return
    }
    if p.kind() == TokenKind.For {
        c.fail("v2 unsupported: ext for trait")
        return
    }
    if c.tys_lookup(ty) < 0 {
        c.fail("ext target type not found: " + ty)
        return
    }
    p.expect(TokenKind.LBrace)
    p.skip_empty_lines()
    while c.err == "" && p.err == "" && p.kind() != TokenKind.EOF && p.kind() != TokenKind.RBrace {
        if p.kind() == TokenKind.Fn || p.kind() == TokenKind.Static {
            var es = 0
            if p.kind() == TokenKind.Static {
                es = 1
                p.next()
            }
            // D25 范式(525-1 族):循环位直赋在转译态 move 掉 ty——ext 体内
            // 第二个方法即 E0382;空串拼接产生新值(借用不移动)。
            c.method_ty = "" + ty
            c.method_self = 1 - es
            cg_fn(c, p)
            c.method_ty = ""
            c.method_self = 0
            if c.err != "" {
                return
            }
            expect_eos(p)
            p.skip_empty_lines()
            continue
        }
        c.fail("v2 unsupported: ext member")
        return
    }
    p.expect(TokenKind.RBrace)
}

// W2(525):语句跨度跳过(pass1 顶层预扫用)——按 {},(),[] 深度计数,
// 深度 0 的 Newline/Semi 即语句尾;EOF/越界 RBrace 兜底返回
fn cg_skip_stmt(mut p P) {
    var depth = 0
    while p.err == "" && p.kind() != TokenKind.EOF {
        var k = p.kind()
        if k == TokenKind.LBrace || k == TokenKind.LParen || k == TokenKind.LSquare {
            depth = depth + 1
        } else if k == TokenKind.RBrace || k == TokenKind.RParen || k == TokenKind.RSquare {
            if depth == 0 {
                return
            }
            depth = depth - 1
        } else if depth == 0 && (k == TokenKind.Newline || k == TokenKind.Semi) {
            return
        }
        p.next()
    }
}

// ── W1 struct 声明注册(Plan 511:镜像宿主 Stmt::TypeDecl 的
// register_type——零字节码,字段名表入 c.tys)─────────────────

fn cg_type_decl(mut c CG, mut p P) {
    p.next()
    if !is_name_kind(p.kind()) {
        c.fail("expected type name")
        return
    }
    var name = p.text()
    p.next()
    // 裁剪面同 parser.at parse_type_decl(v2 unsupported 族)
    if p.kind() == TokenKind.Lt {
        c.fail("v2 unsupported: type generic params")
        return
    }
    if p.kind() == TokenKind.Asn {
        c.fail("v2 unsupported: type alias")
        return
    }
    if p.kind() == TokenKind.Is {
        c.fail("v2 unsupported: type inheritance")
        return
    }
    if p.kind() == TokenKind.As {
        c.fail("v2 unsupported: type as")
        return
    }
    if p.kind() == TokenKind.Has {
        c.fail("v2 unsupported: type has")
        return
    }
    // W2(525):早注册——体内方法(static fn new 的 `return Type {..}`
    // ctor 识别/字段写索引)先于尾态需要 c.tys 命中;方法编译前以
    // 已收集字段刷新本条目(语料约定字段先于方法)
    var ti = c.tys.len()
    var empty_f List<str> = List.new()
    var empty_ft List<str> = List.new()
    c.tys.push(CGType(name, empty_f, empty_ft))
    p.expect(TokenKind.LBrace)
    p.skip_empty_lines()
    var fields List<str> = List.new()
    var ftys List<str> = List.new()
    while c.err == "" && p.err == "" && p.kind() != TokenKind.EOF && p.kind() != TokenKind.RBrace {
        if p.kind() == TokenKind.Fn || p.kind() == TokenKind.Static {
            // W2(525):体内方法编译——cg_fn 名重整通道(镜像宿主独立
            // fn Type.method;方法在 Type 声明位发射,先于 wrapper——
            // m4 分区序对齐);static 不注入 self;编译前刷新类型条目
            // 字段表(早注册条目的字段补充)
            var mis_static = 0
            if p.kind() == TokenKind.Static {
                mis_static = 1
                p.next()
            }
            var fields_snap List<str> = List.new()
            var ftys_snap List<str> = List.new()
            var fs_i = 0
            while fs_i < fields.len() {
                fields_snap.push(fields.get(fs_i))
                ftys_snap.push(ftys.get(fs_i))
                fs_i = fs_i + 1
            }
            c.tys.set(ti, CGType(name, fields_snap, ftys_snap))
            // D25 范式:name 已被 CGType 构造移动,空串拼接拷贝续用
            c.method_ty = "" + name
            c.method_self = 1 - mis_static
            cg_fn(c, p)
            c.method_ty = ""
            c.method_self = 0
            if c.err != "" {
                return
            }
            expect_eos(p)
            p.skip_empty_lines()
            continue
        }
        if p.kind() == TokenKind.Hash {
            c.fail("v2 unsupported: member attr")
            return
        }
        if !is_name_kind(p.kind()) {
            c.fail("expected member name")
            return
        }
        var fname = p.text()
        p.next()
        if p.kind() == TokenKind.Colon {
            p.next()
        }
        var fty_t = parse_type(p)
        if p.kind() == TokenKind.Asn {
            c.fail("v2 unsupported: member default value")
            return
        }
        fields.push(fname)
        ftys.push(fty_t)
        // 成员间空行:静默跳过
        expect_eos(p)
        p.skip_empty_lines()
    }
    p.expect(TokenKind.RBrace)
    // W2(525):尾态刷新早注册条目(完整字段表;去重防护:同名类型
    // 重复声明以后到覆盖——镜像宿主 register_type 按名覆盖语义)
    c.tys.set(ti, CGType(name, fields, ftys))
}

// W1 构造字面量发射 X { a: e1, b: e2 }:( 已在 cur 由调用方判别;
// 镜像宿主 NEW_INSTANCE 族 5270-5319:字段值按字面量序 → const.i32
// 名长 → new.instance → const.i32 字段数 → construct.instance)
fn cg_ctor_emit(mut c CG, mut p P, name str) {
    p.expect(TokenKind.LBrace)
    p.skip_empty_lines()
    var n = 0
    while c.err == "" && p.err == "" && p.kind() != TokenKind.EOF && p.kind() != TokenKind.RBrace {
        var k = p.kind()
        if k != TokenKind.Ident && !is_soft_ident_kind(k) {
            c.fail("expected field name in struct ctor")
            return
        }
        p.next()
        p.expect(TokenKind.Colon)
        cg_expr(c, p, 0)
        n = n + 1
        var sk = p.kind()
        if sk == TokenKind.Comma || sk == TokenKind.Newline {
            p.next()
            p.skip_empty_lines()
        } else if sk != TokenKind.RBrace {
            c.fail("expected pair separator")
        }
    }
    p.expect(TokenKind.RBrace)
    var nm = name.len()
    c.emit(OpCode.ConstI32, nm.str(), nm)
    c.emit(OpCode.NewInstance, "\"" + name + "\"", 0)
    c.emit(OpCode.ConstI32, n.str(), n)
    c.emit(OpCode.ConstructInstance, "", 0)
    c.arr_flag = 0
    c.str_flag = 0
}

// 单模式比较发射:load t;<pattern 表达式>;eq —— 标量枚举判别值直接
// const.i32,字面量按各自形态
fn cg_is_pattern_expr(mut c CG, pat E) {
    if pat.kind == "tag-cover" {
        var dv = c.const_lookup(pat.name + "." + pat.word)
        if dv == -999999 {
            c.fail("unknown enum variant: " + pat.name + "." + pat.word)
            return
        }
        c.emit(OpCode.ConstI32, dv.str(), dv)
    } else if pat.kind == "str" {
        var idx = c.pool_add(pat.name)
        c.emit(OpCode.LoadStr, "", idx)
    } else if pat.kind == "char" {
        var cp = pat.name.char_at(0)
        c.emit(OpCode.ConstI32, cp.str(), cp)
    } else if pat.kind == "int" {
        c.emit(OpCode.ConstI32, pat.name, int_val(pat.name))
    } else if pat.kind == "name" && pat.name == "None" {
        // W5(525):None 哨兵模式(-1;宿主 None 字面量运行期即 -1)
        c.emit(OpCode.ConstI32, "-1", -1)
    } else {
        c.fail("unsupported is pattern: " + pat.kind)
    }
}

// EqBranch 臂:模式收集(is_pattern 复用)→ 按形态三路发射:
// ① 载荷变体+实绑定 → is.variant + jmp.z next + 逐槽 get.generic.field
//   绑定 + 体 + jmp end(continue 式,无共享尾)
// ② 载荷变体无绑定 → load t;is.variant;共享尾(jmp.z next;体;jmp end)
// ③ 标量/字面量 → 单模式:load t;pat;eq;共享尾;多模式:or 链
fn cg_is(mut c CG, mut p P) {
    p.next()
    cg_expr(c, p, 0)
    var t = c.add_var("_is_target", 0, "")
    c.emit_store(t)
    p.expect(TokenKind.LBrace)
    p.skip_empty_lines()
    var end_jmps List<int> = List.new()
    while c.err == "" && p.kind() != TokenKind.RBrace && p.kind() != TokenKind.EOF {
        var k = p.kind()
        if k == TokenKind.If {
            p.next()
            cg_expr(c, p, 0)
            var jz = c.emit(OpCode.JmpZ, "", -1)
            p.expect(TokenKind.Arrow)
            cg_is_arm_body(c, p)
            var je = c.emit(OpCode.Jmp, "", -1)
            end_jmps.push(je)
            c.ins.get(jz).n = c.ins.len()
        } else if k == TokenKind.Else {
            p.next()
            p.expect(TokenKind.Arrow)
            cg_is_arm_body(c, p)
            // 宿主 Else 臂体后同样发 jmp→end(end 即紧邻指令,无害跳转)
            var jej = c.emit(OpCode.Jmp, "", -1)
            end_jmps.push(jej)
        } else {
            var pat = is_pattern(p)
            var extras List<E> = List.new()
            while c.err == "" && p.kind() == TokenKind.VBar {
                p.next()
                p.skip_empty_lines()
                var np = is_pattern(p)
                extras.push(np)
                p.skip_empty_lines()
            }
            p.expect(TokenKind.Arrow)
            p.skip_empty_lines()
            // W5(525):Some(v) 模式臂——t != -1 命中,v=t 绑定(哨兵
            // 模型;绑定名自 args "(name v)" 提取)
            if pat.kind == "call" && pat.word == "Some" {
                var ap = pat.args
                var bstart = find_sub(ap, "(name ")
                var bname = "_"
                if bstart >= 0 {
                    var brest = ap.slice(bstart + 6, ap.len())
                    var bend = find_sub(brest, ")")
                    if bend >= 0 {
                        bname = brest.slice(0, bend)
                    }
                }
                c.emit_load(t)
                c.emit(OpCode.ConstI32, "-1", -1)
                c.emit(OpCode.Ne, "", 0)
                var sjz = c.emit(OpCode.JmpZ, "", -1)
                if bname != "_" {
                    var svidx = c.add_var(bname, 0, "")
                    c.emit_load(t)
                    c.emit_store(svidx)
                }
                cg_is_arm_body(c, p)
                var sje = c.emit(OpCode.Jmp, "", -1)
                end_jmps.push(sje)
                c.ins.get(sjz).n = c.ins.len()
                p.skip_empty_lines()
                continue
            }
            // W2(525):is-struct 解构臂——plain struct 静态恒命中(宿主
            // 语义=match 解构绑定,a2r 规范;变体形超语料面):逐字段
            // load t;get.field [N];store 绑定 → 体 → jmp end。
            // pat.args 为 display 形态(空格分隔的 `f` / `f: alias` 列)
            if pat.kind == "struct-cover" && pat.word == "" {
                // 词切分(display 形态空格分隔;`f: alias` 的冒号黏字段
                // 词——"x:" → 字段 x + 次词为别名)
                var words3 List<str> = List.new()
                var wrest = pat.args
                var wgo = true
                while wgo {
                    var w = wrest
                    var wsp = find_sub(wrest, " ")
                    if wsp >= 0 {
                        w = wrest.slice(0, wsp)
                        wrest = wrest.slice(wsp + 1, wrest.len())
                    } else {
                        wgo = false
                    }
                    if w != "" {
                        words3.push(w)
                    }
                }
                var wi3 = 0
                while wi3 < words3.len() && c.err == "" {
                    var fld3 = words3.get(wi3)
                    var alias3 = fld3
                    if fld3.len() > 1 && fld3.char_at(fld3.len() - 1) == ':' {
                        fld3 = fld3.slice(0, fld3.len() - 1)
                        if wi3 + 1 < words3.len() {
                            wi3 = wi3 + 1
                            alias3 = words3.get(wi3)
                        }
                    }
                    if alias3 != "_" {
                        c.emit_load(t)
                        var fidx5 = c.pool_push(fld3)
                        c.emit(OpCode.GetField, "field[" + fidx5.str() + "]", fidx5)
                        var bidx5 = c.add_var(alias3, 0, "")
                        c.emit_store(bidx5)
                    }
                    wi3 = wi3 + 1
                }
                cg_is_arm_body(c, p)
                var je5 = c.emit(OpCode.Jmp, "", -1)
                end_jmps.push(je5)
                // 臂尾换行消费(continue 跳过循环共享尾,需自带;镜像
                // ③b 臂尾形态)
                p.skip_empty_lines()
                continue
            }
            var fc = -1
            if pat.kind == "tag-cover" {
                fc = c.ctor_lookup(pat.name + "." + pat.word)
            }
            var has_real_bind = false
            if fc >= 0 && pat.args != "" && pat.args != "_" {
                var binds = split_commas(pat.args)
                var bi = 0
                while bi < binds.len() {
                    if binds.get(bi) != "_" {
                        has_real_bind = true
                    }
                    bi = bi + 1
                }
            }
            if fc >= 0 && has_real_bind {
                // ① 载荷 + 绑定
                var key = f"${pat.name}.${pat.word}"
                c.emit_load(t)
                c.emit(OpCode.IsVariant, "\"" + key + "\"", 0)
                var jz2 = c.emit(OpCode.JmpZ, "", -1)
                var binds2 = split_commas(pat.args)
                var si = 0
                while si < binds2.len() {
                    if binds2.get(si) != "_" {
                        c.emit_load(t)
                        c.emit(OpCode.GetGenericField, "field=" + si.str(), si)
                        c.emit(OpCode.Nop, "", 0)
                        c.emit(OpCode.Nop, "", 0)
                        c.emit(OpCode.Nop, "", 0)
                        var bidx = c.add_var(binds2.get(si), 0, "")
                        c.emit_store(bidx)
                    }
                    si = si + 1
                }
                cg_is_arm_body(c, p)
                var je2 = c.emit(OpCode.Jmp, "", -1)
                end_jmps.push(je2)
                c.ins.get(jz2).n = c.ins.len()
            } else {
                var shared_jz = -1
                if fc >= 0 {
                    // ② 载荷无实绑定:is.variant 后走共享尾
                    var key2 = f"${pat.name}.${pat.word}"
                    c.emit_load(t)
                    c.emit(OpCode.IsVariant, "\"" + key2 + "\"", 0)
                } else if extras.len() == 0 {
                    // ③a 单模式:load t;pat;eq
                    c.emit_load(t)
                    cg_is_pattern_expr(c, pat)
                    c.emit(OpCode.Eq, "", 0)
                } else {
                    // ③b or 链:逐模式 eq + jmp.nz 匹配标号;全落空 jmp next
                    var nz_jmps List<int> = List.new()
                    c.emit_load(t)
                    cg_is_pattern_expr(c, pat)
                    c.emit(OpCode.Eq, "", 0)
                    var nz = c.emit(OpCode.JmpNz, "", -1)
                    nz_jmps.push(nz)
                    var ei = 0
                    while ei < extras.len() {
                        c.emit_load(t)
                        cg_is_pattern_expr(c, extras.get(ei))
                        c.emit(OpCode.Eq, "", 0)
                        var nz2 = c.emit(OpCode.JmpNz, "", -1)
                        nz_jmps.push(nz2)
                        ei = ei + 1
                    }
                    var jmp_next = c.emit(OpCode.Jmp, "", -1)
                    var mi = 0
                    while mi < nz_jmps.len() {
                        c.ins.get(nz_jmps.get(mi)).n = c.ins.len()
                        mi = mi + 1
                    }
                    cg_is_arm_body(c, p)
                    var je3 = c.emit(OpCode.Jmp, "", -1)
                    end_jmps.push(je3)
                    c.ins.get(jmp_next).n = c.ins.len()
                    p.skip_empty_lines()
                    if p.kind() == TokenKind.Comma {
                        p.next()
                        p.skip_empty_lines()
                    }
                    p.skip_empty_lines()
                    continue
                }
                // 共享尾:jmp.z next;体;jmp end;patch next
                shared_jz = c.emit(OpCode.JmpZ, "", -1)
                cg_is_arm_body(c, p)
                var je4 = c.emit(OpCode.Jmp, "", -1)
                end_jmps.push(je4)
                c.ins.get(shared_jz).n = c.ins.len()
            }
        }
        if p.kind() == TokenKind.Comma {
            p.next()
            p.skip_empty_lines()
        }
        p.skip_empty_lines()
    }
    p.expect(TokenKind.RBrace)
    var e = 0
    while e < end_jmps.len() {
        c.ins.get(end_jmps.get(e)).n = c.ins.len()
        e = e + 1
    }
}

fn cg_stmt(mut c CG, mut p P) {
    if c.err != "" {
        return
    }
    var k = p.kind()
    // C3(Plan 447):p_kind 链 is 化——简单 kind 臂镜像宿主 match 形;
    // 复合条件(pub 前缀/下标赋值/字段赋值)与表达式语句尾走 else。
    is k {
        TokenKind.Enum -> cg_enum_decl(c, p)
        TokenKind.Type -> cg_type_decl(c, p)
        TokenKind.Use -> cg_use(c, p)
        TokenKind.Break | TokenKind.Continue -> {
            p.next()
            c.loop_jump(k)
        }
        TokenKind.Is -> cg_is(c, p)
        TokenKind.Let | TokenKind.Var | TokenKind.Const | TokenKind.Shared -> {
        p.next()
        var name = p.text()
        p.next()
        var vty = ""
        if is_type_name(p) {
            var vt = parse_type(p)
            if vt == "str" {
                vty = "str"
            }
            // W3(525):容器注解串入 vty(List<..>/裸 List;recv_ty
            // 解析——容器方法 CallNat 分派)
            if find_sub(vt, "List") == 0 {
                vty = vt
            }
        }
        var is_arr = 0
        // W2(Plan 511):全局路径(镜像宿主 Plan 317/322——顶层 var/const
        // 注册进 global_vars 且无 scope 守卫:fn 体内同名声明也走全局;
        // W3:模块编译单元内键带 mod. 前缀 cg_gkey)
        var gk = c.gkey(name)
        if (k == TokenKind.Var || k == TokenKind.Const) && c.depth == 1 {
            if !c.is_global(gk) {
                c.global_vars.push(gk)
            }
        }
        if p.kind() == TokenKind.Asn {
            p.next()
            if c.is_global(gk) {
                // init token 区间登记(fn main 体首重放用;首次声明记;
                // W3:仅主模块重放——dep 模块经模块初始化序执行 init)
                var from2 = p.pos
                cg_expr(c, p, 0)
                var to2 = p.pos
                if c.mod_name == "" {
                    var seen2 = false
                    var si2 = 0
                    while si2 < c.global_inits.len() {
                        if c.global_inits.get(si2).name == gk {
                            seen2 = true
                        }
                        si2 = si2 + 1
                    }
                    if !seen2 {
                        c.global_inits.push(CGInit(gk, from2, to2))
                    }
                }
                var gidx2 = c.pool_add(gk)
                c.emit(OpCode.StoreGlobal, gidx2.str(), gidx2)
                return
            }
            cg_expr(c, p, 0)
            is_arr = c.arr_flag
            if c.str_flag == 1 {
                vty = "str"
            }
            // W1:构造字面量绑定记类型名(镜像宿主 var_types=GenericInstance
            // 的可观察面——写字段走 set.generic.field;注解/调用源不记,
            // 写走 load.str+set.field,与宿主 User 路径一致)
            if c.inst_ty != "" {
                vty = c.inst_ty
            }
        }
        var idx = c.add_var(name, is_arr, vty)
        c.emit_store(idx)
        }
        TokenKind.Return -> {
        p.next()
        var kk = p.kind()
        if kk == TokenKind.Newline || kk == TokenKind.Semi || kk == TokenKind.RBrace || kk == TokenKind.EOF {
            c.emit(OpCode.PushNil, "", 0)
        } else {
            cg_expr(c, p, 0)
        }
        var na = c.n_args
        var rs2 = f"n_args=${na.str()}"
        c.emit(OpCode.Ret, rs2, na)
        }
        TokenKind.If -> cg_if(c, p)
        TokenKind.While -> cg_while(c, p)
        TokenKind.For -> cg_for(c, p)
        // W4(525):嵌套 fn——体内声明按普通 fn 就地编译(jmp-over+
        // 帧;447-旁支②宿主已修,本侧能力承载;作用域链=不捕获外层,
        // 调用按名查 c.fns)
        TokenKind.Fn -> cg_fn(c, p)
        else -> {
    if k == TokenKind.Ident && p.text() == "pub" {
        // W3:pub 前缀跳过(D3:VM 链路无导出过滤)
        p.next()
        if p.kind() == TokenKind.Fn {
            cg_fn(c, p)
        } else {
            cg_stmt(c, p)
        }
        return
    }
    // 下标赋值 a[idx] = rhs:Rust 发射序为 rhs→arr→idx→set.elem
    // (value 展栈底,Rust 5954 quick-fix 栈序);单遍步行以游标
    // 快照两段解析——先越前扫到匹配 ] 后的 Asn,先发 rhs 再回头发 arr/idx
    if k == TokenKind.Ident && p.peek(1) == TokenKind.LSquare {
        var arr_name = p.text()
        var aidx = c.lookup(arr_name)
        if aidx < 0 {
            c.fail("unknown ident: " + arr_name)
            return
        }
        var start = p.pos
        var scan = start + 2
        var depth = 1
        var ok = false
        while scan < p.toks.len() && !ok {
            var sk = p.toks.get(scan).kind
            if is_comment_kind(sk) {
                scan = scan + 1
            } else {
                if sk == TokenKind.LSquare {
                    depth = depth + 1
                } else if sk == TokenKind.RSquare {
                    depth = depth - 1
                    if depth == 0 {
                        ok = true
                    }
                }
                scan = scan + 1
            }
        }
        if ok && scan < p.toks.len() && p.toks.get(scan).kind != TokenKind.Asn && cg_is_assign_op(p_op(p.toks.get(scan).kind)) {
            // W2/D1(Plan 511):宿主对非 Ident LHS 复合赋值的拒绝文本同款
            c.fail("Compound assignment requires a variable on left side")
            return
        }
        if ok && scan < p.toks.len() && p.toks.get(scan).kind == TokenKind.Asn {
            p.pos = scan + 1
            p.skip_empty_lines()
            cg_expr(c, p, 0)
            var end_pos = p.pos
            c.emit_load(aidx)
            p.pos = start
            p.next()
            p.next()
            p.skip_empty_lines()
            cg_expr(c, p, 0)
            p.skip_empty_lines()
            p.expect(TokenKind.RSquare)
            c.emit(OpCode.SetElem, "", 0)
            p.pos = end_pos
            return
        }
        p.pos = start
    }
    // W2(525):接收者简写字段赋值 `.f = rhs`——self 接收者(方法首参);
    // 发射序镜像宿主 self 字段写:**名字基**(rhs → load self → load.str
    // 字段名 → set.field;宿主 self 参数走 User/name-based 写路径,
    // b44_methods_recv_write m4 对拍实证——与构造字面量源变量的
    // set.generic.field 下标基不同)
    if k == TokenKind.Dot {
        var sd0 = p.pos
        var sd1 = sd0 + 1
        if sd1 < p.toks.len() && (p.toks.get(sd1).kind == TokenKind.Ident || is_soft_ident_kind(p.toks.get(sd1).kind)) && sd1 + 1 < p.toks.len() && p.toks.get(sd1 + 1).kind == TokenKind.Asn {
            var self_i3 = c.lookup("self")
            if self_i3 < 0 {
                c.fail("'.' shorthand outside method (no self)")
                return
            }
            var sfld = p.toks.get(sd1).text
            p.pos = sd1 + 2
            p.skip_empty_lines()
            cg_expr(c, p, 0)
            var send_pos = p.pos
            c.emit_load(self_i3)
            // 名字池直推非去重(镜像宿主 self 写路径的 strings.push;
            // b44_recv_write m4 对拍:写/读各自入池,索引对齐)
            var sidx3 = c.pool_push(sfld)
            c.emit(OpCode.LoadStr, "", sidx3)
            c.emit(OpCode.SetField, "", 0)
            p.pos = send_pos
            return
        }
        p.pos = sd0
    }
    // W1 字段赋值 x.f = rhs / x.a.b = rhs:两段游标快照(镜像 a[idx]= 模式)
    // —— 先前瞻扫字段链至 Asn,先发 rhs 再回头发对象/字段
    if k == TokenKind.Ident && p.peek(1) == TokenKind.Dot {
        var recv2 = p.text()
        var ridx2 = c.lookup(recv2)
        if ridx2 < 0 {
            c.fail("unknown ident: " + recv2)
            return
        }
        var start3 = p.pos
        // 前瞻:Ident (Dot 名)+ Asn;名后不是 Dot/Asn 即非本形态
        var scan3 = start3 + 1
        var fields3 List<str> = List.new()
        var shape_ok = true
        while shape_ok && p.toks.get(scan3).kind == TokenKind.Dot {
            var fk3 = p.toks.get(scan3 + 1).kind
            if fk3 != TokenKind.Ident && !is_soft_ident_kind(fk3) {
                shape_ok = false
                break
            }
            fields3.push(p.toks.get(scan3 + 1).text)
            scan3 = scan3 + 2
            var after3 = p.toks.get(scan3).kind
            if after3 == TokenKind.Dot {
                // 链继续
            } else if after3 == TokenKind.Asn {
                break
            } else if cg_is_assign_op(p_op(after3)) {
                // 复合赋值:镜像宿主非 Ident LHS 的拒绝文本(D1 同族)
                c.fail("Compound assignment requires a variable on left side")
                return
            } else {
                shape_ok = false
            }
        }
        if shape_ok && p.toks.get(scan3).kind == TokenKind.Asn {
            // 发射:rhs 先行
            p.pos = scan3 + 1
            p.skip_empty_lines()
            cg_expr(c, p, 0)
            var end_pos3 = p.pos
            var recv_ty = c.var_ty(recv2)
            if fields3.len() == 1 && c.tys_lookup(recv_ty) >= 0 {
                // 构造字面量源变量(宿主 GenericInstance 路径):
                // value,instance_id → set.generic.field <u32 字段下标>
                // (+3 幽灵 nop,镜像宿主 disasm u8 读宽形态)
                var fidx3 = c.field_idx(recv_ty, fields3.get(0))
                if fidx3 < 0 {
                    c.fail("unknown field: " + recv_ty + "." + fields3.get(0))
                    return
                }
                c.emit_load(ridx2)
                c.emit(OpCode.SetGenericField, "field=" + fidx3.str(), fidx3)
                c.emit(OpCode.Nop, "", 0)
                c.emit(OpCode.Nop, "", 0)
                c.emit(OpCode.Nop, "", 0)
            } else {
                // 嵌套/非构造源(宿主 User/fallback 路径):value → 对象
                // 表达式 → load.str 字段名(栈顶)→ set.field
                c.emit_load(ridx2)
                var fi3 = 0
                while fi3 < fields3.len() - 1 {
                    var mid3 = c.pool_push(fields3.get(fi3))
                    c.emit(OpCode.GetField, "field[" + mid3.str() + "]", mid3)
                    fi3 = fi3 + 1
                }
                var last3 = c.pool_add(fields3.get(fields3.len() - 1))
                c.emit(OpCode.LoadStr, "", last3)
                c.emit(OpCode.SetField, "", 0)
            }
            p.pos = end_pos3
            return
        }
        p.pos = start3
    }
    // 表达式语句:赋值特判
    if k == TokenKind.Ident {
        var name = p.text()
        var nk = p.peek(1)
        if cg_is_assign_op(p_op(nk)) {
            // W2:全局写优先于局部查找(镜像宿主 6189-6192 的 check-BEFORE)
            if c.is_global(c.gkey(name)) {
                p.next()
                var gopk = p.kind()
                p.next()
                if gopk != TokenKind.Asn {
                    var gka = c.gkey(name)
                    var gg = c.pool_add(gka)
                    c.emit(OpCode.LoadGlobal, gg.str(), gg)
                }
                cg_expr(c, p, 0)
                var gmn = cg_binop_mnem(p_op(gopk))
                if gmn != OpCode.Blank {
                    c.emit(gmn, "", 0)
                }
                c.emit(OpCode.Dup, "", 0)
                var gkb = c.gkey(name)
                var gidx3 = c.pool_add(gkb)
                c.emit(OpCode.StoreGlobal, gidx3.str(), gidx3)
                c.emit(OpCode.Pop, "", 0)
                return
            }
            var idx = c.lookup(name)
            if idx < 0 {
                c.fail("unknown ident: " + name)
                return
            }
            p.next()
            var opk = p.kind()
            p.next()
            if opk != TokenKind.Asn {
                c.emit_load(idx)
            }
            cg_expr(c, p, 0)
            var mn = cg_binop_mnem(p_op(opk))
            if mn != OpCode.Blank {
                c.emit(mn, "", 0)
            }
            c.emit(OpCode.Dup, "", 0)
            c.emit_store(idx)
            c.emit(OpCode.Pop, "", 0)
            return
        }
    }
    // W3:表达式语句——用户 fn 调用语句尾补 pop 弃值(镜像宿主
    // Stmt::Expr 的非 void 结果丢弃;call.nat print 为 void 无 pop)。
    // W3(525):容器方法 call.nat 同理(nat#10 print void 除外;b46
    // m4 对拍:push/set 语句位 pop)
    var before_len = c.ins.len()
    cg_expr(c, p, 0)
    if c.err == "" && c.depth > 1 && c.ins.len() > before_len {
        var last_i = c.ins.get(c.ins.len() - 1)
        if last_i.op == OpCode.Call {
            c.emit(OpCode.Pop, "", 0)
        } else if last_i.op == OpCode.CallNat && last_i.n != 10 {
            c.emit(OpCode.Pop, "", 0)
        }
    }
        }
    }
}

fn cg_stmts(mut c CG, mut p P) {
    while c.err == "" && p.kind() != TokenKind.EOF && p.kind() != TokenKind.RBrace {
        c.line(p.line())
        cg_stmt(c, p)
        if c.err == "" {
            cg_eos(c, p)
        }
    }
}

// if/else-if/else:每分支 cond,jz→下一;体;jmp→end(含 return 后死 jmp)
fn cg_if(mut c CG, mut p P) {
    var jzs List<int> = List.new()
    var jends List<int> = List.new()
    var more = true
    while more {
        p.next()
        cg_expr(c, p, 0)
        var jz = c.emit(OpCode.JmpZ, "", -1)
        jzs.push(jz)
        cg_body_inline(c, p)
        var je = c.emit(OpCode.Jmp, "", -1)
        jends.push(je)
        if p.kind() == TokenKind.Else {
            p.next()
            if p.kind() != TokenKind.If {
                var z = 0
                while z < jzs.len() {
                    c.ins.get(jzs.get(z)).n = c.ins.len()
                    z = z + 1
                }
                cg_body_inline(c, p)
                more = false
            }
        } else {
            var z2 = 0
            while z2 < jzs.len() {
                c.ins.get(jzs.get(z2)).n = c.ins.len()
                z2 = z2 + 1
            }
            more = false
        }
    }
    var e = 0
    while e < jends.len() {
        c.ins.get(jends.get(e)).n = c.ins.len()
        e = e + 1
    }
}

// 分支/循环体(compile_body_inline:不推作用域)
fn cg_body_inline(mut c CG, mut p P) {
    p.expect(TokenKind.LBrace)
    p.skip_empty_lines()
    cg_stmts(c, p)
    p.expect(TokenKind.RBrace)
}

fn cg_eos(mut c CG, mut p P) {
    var has_sep = false
    while p.kind() == TokenKind.Semi || p.kind() == TokenKind.Newline || p.kind() == TokenKind.Comma {
        has_sep = true
        p.next()
    }
    if p.kind() != TokenKind.EOF && p.kind() != TokenKind.RBrace && !has_sep {
        c.fail("expected eos, got " + kind_name(p.kind()))
    }
}

// while:top(在语句 .line 之后):cond;jmp.z end;体;jmp top;end
fn cg_while(mut c CG, mut p P) {
    p.next()
    var top = c.ins.len()
    cg_expr(c, p, 0)
    var jz = c.emit(OpCode.JmpZ, "", -1)
    // P2:continue 落点 = 条件顶(while 语义:重判条件);体作用域与
    // for 同构(体内变量每迭代释放,cg_pop_scope depth>2 发释放组)
    c.push_scope()
    c.loop_enter(top)
    cg_body_inline(c, p)
    // 宿主布局:体 → 体内变量释放组 → 回跳;break 越过释放组直达 end
    c.pop_scope()
    c.emit(OpCode.Jmp, "", top)
    var end = c.ins.len()
    c.ins.get(jz).n = end
    c.loop_exit(end)
}

// for-in-range:start;store var;top:load var;end;lt;jmp.z end;
// 体;load var;const 1;add;store var;jmp top;end;循环域弹出(释放)
fn cg_for(mut c CG, mut p P) {
    p.next()
    if p.kind() != TokenKind.Ident {
        c.fail("for: expected ident")
        return
    }
    var name = p.text()
    p.next()
    if p.kind() != TokenKind.In {
        c.fail("for: expected in")
        return
    }
    p.next()
    // Plan 523 H6(m5 既有红根因,2026-09-03 根除):裸 Ident 调用源
    // 并回下方通用「数组句柄+索引循环+GET_ELEM」通道——旧 Call 迭代器
    // 通道(nat#112)镜像 511 期宿主缺陷(裸 List 句柄零迭代,
    // engine.at nat#112 注释自证),PLAN-057 T3(e01eeba0b)修宿主后
    // 双侧分歧(b38 第三循环缺失;基线 d54ec540d m5 绿→T3 红,二分
    // 实证)。门禁:m5 corpus 46/46。
    // Call 源(裸 Ident 调用)字节码级镜像宿主 T3 通道:临时句柄+索引循环
    // +GET_ELEM+每迭代 call.nat nat#103(auto.list.len);槽序 arr/w/idx
    // 镜像宿主 add_var 序(m4 字节码闸)。m5 行为闸走同一字节码自洽。
    if p.kind() == TokenKind.Ident && p.peek(1) == TokenKind.LParen {
        cg_expr(c, p, 0)
        var t_arr = c.add_var("_iterarr", 0, "")
        c.emit_store(t_arr)
        var t_v = c.add_var(name, 0, "")
        var t_idx = c.add_var("_iteridx", 0, "")
        c.emit(OpCode.ConstI32, "0", 0)
        c.emit_store(t_idx)
        var t_top = c.ins.len()
        c.emit_load(t_idx)
        c.emit_load(t_arr)
        c.emit(OpCode.CallNat, "nat#103", 103)
        c.emit(OpCode.Lt, "", 0)
        var t_jz = c.emit(OpCode.JmpZ, "", -1)
        c.emit_load(t_arr)
        c.emit_load(t_idx)
        c.emit(OpCode.GetElem, "", 0)
        c.emit_store(t_v)
        c.loop_enter(0)
        cg_body_inline(c, p)
        c.cont_tg.set(c.loop_depth - 1, c.ins.len())
        c.emit_load(t_idx)
        c.emit(OpCode.ConstI32, "1", 1)
        c.emit(OpCode.Add, "", 0)
        c.emit_store(t_idx)
        c.emit(OpCode.Jmp, "", t_top)
        var t_end = c.ins.len()
        c.ins.get(t_jz).n = t_end
        c.loop_exit(t_end)
        return
    }
    c.push_scope()
    // start 以 min=18 界定(不吞 .. 的中缀绑定);显式吃 Range/RangeEq 再取 end
    cg_expr(c, p, 18)
    if p.kind() == TokenKind.Range || p.kind() == TokenKind.RangeEq {
        p.next()
    } else {
        // —— 数组/表达式通道(Plan 511 W2)——
        // <对象> 求值一次;dup/arr.len 缓存;const.0 计数器;三隐藏槽
        // (_counter/_array_len/_array_ref)+ 循环变量;continue 落点=增量段
        c.emit(OpCode.Dup, "", 0)
        c.emit(OpCode.ArrLen, "", 0)
        c.emit(OpCode.Const0, "", 0)
        var cnt = c.add_var("_counter", 0, "")
        c.emit_store(cnt)
        var aln = c.add_var("_array_len", 0, "")
        c.emit_store(aln)
        var aref = c.add_var("_array_ref", 0, "")
        c.emit_store(aref)
        var av = c.add_var(name, 0, "")
        var atop = c.ins.len()
        c.emit_load(cnt)
        c.emit_load(aln)
        c.emit(OpCode.Lt, "", 0)
        var ajz = c.emit(OpCode.JmpZ, "", -1)
        c.emit_load(aref)
        c.emit_load(cnt)
        c.emit(OpCode.GetElem, "", 0)
        c.emit_store(av)
        c.loop_enter(0)
        cg_body_inline(c, p)
        c.cont_tg.set(c.loop_depth - 1, c.ins.len())
        c.emit_load(cnt)
        c.emit(OpCode.ConstI32, "1", 1)
        c.emit(OpCode.Add, "", 0)
        c.emit_store(cnt)
        c.emit(OpCode.Jmp, "", atop)
        var aend = c.ins.len()
        c.ins.get(ajz).n = aend
        c.loop_exit(aend)
        c.pop_scope()
        return
    }
    var idx = c.add_var(name, 0, "")
    c.emit_store(idx)
    var top = c.ins.len()
    c.emit_load(idx)
    cg_expr(c, p, 0)
    c.emit(OpCode.Lt, "", 0)
    var jz = c.emit(OpCode.JmpZ, "", -1)
    // P2:continue 落点 = 步进位(循环变量自增;宿主 range-for 同口径)
    c.loop_enter(0)
    cg_body_inline(c, p)
    c.cont_tg.set(c.loop_depth - 1, c.ins.len())
    c.emit_load(idx)
    c.emit(OpCode.ConstI32, "1", 1)
    c.emit(OpCode.Add, "", 0)
    c.emit_store(idx)
    c.emit(OpCode.Jmp, "", top)
    var end = c.ins.len()
    c.ins.get(jz).n = end
    c.loop_exit(end)
    c.pop_scope()
}

// ── fn 编译 ──────────────────────────────────────────────────

// W3(525):"List<int>" → "List"(首个 '<' 前段;无 '<' 原样)——
// 容器方法分派的基名提取
fn strip_generic(ty str) str {
    var i = 0
    while i < ty.len() {
        if ty.char_at(i) == '<' {
            return ty.slice(0, i)
        }
        i = i + 1
    }
    return ty
}

// W3(525):容器方法 → CallNat id(宿主 native_catalog:auto.list 族;
// 语料面=lib 盘点最小集 5 方法;未命中 -1)
// P532 W1 G1+G2:str 方法族 native id(镜像宿主 native_catalog 运行时
// id;M4 反汇编对拍锚:b58 host 期望 nat#1500/1502/1524/1510/1507)
fn str_nat_id(m str) int {
    is m {
        "len" -> 1500
        "char_at" -> 1502
        "slice" -> 1524
        "replace" -> 1510
        "trim" -> 1507
        else -> -1
    }
}

fn list_nat_id(m str) int {
    is m {
        "new" -> 100
        "push" -> 101
        "len" -> 103
        "get" -> 106
        "set" -> 107
        else -> -1
    }
}

// W2(525):"Type.method" → "Type"(首个 '.' 前段;无点原样)
fn name_dot_head(s str) str {
    var i = 0
    while i < s.len() {
        if s.char_at(i) == '.' {
            return s.slice(0, i)
        }
        i = i + 1
    }
    return s
}

fn cg_fn(mut c CG, mut p P) {
    p.next()
    if p.kind() != TokenKind.Ident {
        c.fail("fn: expected name")
        return
    }
    var name = p.text()
    p.next()
    // W2(525):方法上下文——名重整 "Type.method"(镜像宿主 2301 独立
    // fn;方法体不重放全局 init(name 恒带点号,下方 main 判定天然隔离)
    var self_inject = 0
    if c.method_ty != "" {
        name = c.method_ty + "." + name
        self_inject = c.method_self
        c.method_ty = ""
        c.method_self = 0
    }
    var jover = c.emit(OpCode.Jmp, "", -1)
    var entry = c.ins.len()
    c.fns.push(FnEntry(name, entry))
    // W2(525):fn_rets 平行表占位(返回类型解析后回填)
    var fret_idx = c.fns.len() - 1
    c.fn_rets.push("")
    var saved_args = c.n_args
    var saved_max = c.max_idx
    c.max_idx = -1
    var saved_hi = c.hi_idx
    c.hi_idx = -1
    c.push_scope()
    var prolog = c.emit(OpCode.FnProlog, "", 0)
    var reserve = c.emit(OpCode.Reserve, "", 0)
    var n_args = 0
    p.expect(TokenKind.LParen)
    p.skip_empty_lines()
    // W2(525):非 static 方法注入 self 首参(idx=0,镜像宿主 2321 参数
    // 注入 ParamMode::View;ty=方法所属类型名——.field 简写与方法解析用)
    if self_inject == 1 {
        c.add_var("self", 0, name_dot_head(name))
        n_args = 1
    }
    var running = true
    while running && c.err == "" {
        var k = p.kind()
        if k == TokenKind.View || k == TokenKind.Mut || k == TokenKind.Move || k == TokenKind.Take || k == TokenKind.Copy {
            p.next()
        }
        if p.kind() != TokenKind.Ident {
            running = false
        } else {
            var pname = p.text()
            p.next()
            if p.kind() == TokenKind.Colon {
                p.next()
            }
            // W2:List 型参数记 arr(447 收账缺口①——.len() 接收者跟踪);
            // W3(525):注解串入 CGVar.ty(容器方法 CallNat 分派的
            // recv_ty 解析,b46_list_fn_sig)
            var parr = 0
            var pty_s = ""
            if is_type_name(p) {
                if p.text() == "List" && p.peek(1) == TokenKind.Lt {
                    parr = 1
                }
                pty_s = parse_type(p)
            }
            if p.kind() == TokenKind.Asn {
                p.next()
                expr_pratt(p, 0)
            }
            c.add_var(pname, parr, pty_s)
            n_args = n_args + 1
            if p.kind() == TokenKind.Comma {
                p.next()
            } else {
                running = false
            }
        }
    }
    p.expect(TokenKind.RParen)
    c.n_args = n_args
    // W2(525):返回类型名捕获(裸名;fn_rets 平行表回填——链式方法
    // 调用的接收者类型解析)
    var ret_name = ""
    if p.kind() == TokenKind.Arrow {
        p.next()
        if is_name_kind(p.kind()) {
            ret_name = p.text()
        }
        parse_type(p)
        p.skip_empty_lines()
    } else if is_type_name(p) {
        if is_name_kind(p.kind()) {
            ret_name = p.text()
        }
        parse_type(p)
        p.skip_empty_lines()
    }
    c.fn_rets.set(fret_idx, ret_name)
    // W2:fn main 体首重放全局初始化(镜像宿主 codegen 1339-1348——入口
    // 直接 spawn main 跳过 wrapper 顶层,故在 main 体首按声明序重放
    // init token 区间;语料约定 fn main 声明于顶层 var 之后)
    if name == "main" && c.mod_name == "" && c.global_inits.len() > 0 {
        var gi = 0
        while gi < c.global_inits.len() && c.err == "" {
            var ent = c.global_inits.get(gi)
            var saved_pos = p.pos
            p.pos = ent.from
            cg_expr(c, p, 0)
            p.pos = saved_pos
            var rgidx = c.pool_add(ent.name)
            c.emit(OpCode.StoreGlobal, rgidx.str(), rgidx)
            gi = gi + 1
        }
    }
    // 体块(Stmt::Block:推作用域;语句 .line 由 cg_stmts 发)
    c.push_scope()
    p.expect(TokenKind.LBrace)
    p.skip_empty_lines()
    cg_stmts(c, p)
    p.expect(TokenKind.RBrace)
    c.pop_scope()
    // epilogue RET
    var rs = f"n_args=${n_args.str()}"
    c.emit(OpCode.Ret, rs, n_args)
    // 回填 prolog/reserve(Rust:n_locals = max_locals - n_args)
    var n_locals = 0
    if c.hi_idx >= n_args {
        n_locals = c.hi_idx + 1 - n_args
    }
    c.ins.get(prolog).s = "args=" + n_args.str() + ", locals=" + n_locals.str()
    c.ins.get(prolog).n = n_args
    if n_locals > 0 {
        c.ins.get(reserve).s = n_locals.str()
        c.ins.get(reserve).n = n_locals
    } else {
        c.ins.get(reserve).op = OpCode.Blank
    }
    c.ins.get(jover).n = c.ins.len()
    c.pop_scope()
    c.n_args = saved_args
    c.max_idx = saved_max
    c.hi_idx = saved_hi
}

// ── 序列化 ──────────────────────────────────────────────────

fn hex4(n int) str {
    var digits = "0123456789abcdef"
    var out = ""
    var v = n
    var k = 0
    while k < 4 {
        var d = v % 16
        out = digits.slice(d, d + 1) + out
        v = v / 16
        k = k + 1
    }
    return out
}

// ── W3(Plan 511):use 模块化——解析器/多编译单元/链接器 ────────

// 模块记录(name=use 路径,source=文件文本)
type CGMod {
    name str
    source str
}

// 路径目录部分(最后 / 或 \ 之前;无分隔符返回 "")
fn cg_dir_of(path str) str {
    var i = 0
    var last = -1
    while i < path.len() {
        var ch = path.char_at(i)
        if ch == 47 || ch == 92 {
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        return ""
    }
    return path.slice(0, last)
}

// use 语句轻扫(复用 cg_use 的消费逻辑,记录进临时 CG 的 uses)
fn cg_use_scan(source str) List<CGUse> {
    var out List<CGUse> = List.new()
    var toks = tokenize(source)
    var p = parse_new(toks)
    var scratch = CG.new()
    p.skip_empty_lines()
    while p.err == "" && p.kind() != TokenKind.EOF {
        if p.kind() == TokenKind.Use {
            cg_use(scratch, p)
        } else if p.kind() == TokenKind.Ident && p.text() == "pub" {
            p.next()
        } else {
            // 越过其余语句:保守步进到行尾
            while p.err == "" && p.kind() != TokenKind.EOF && p.kind() != TokenKind.Newline && p.kind() != TokenKind.Semi {
                p.next()
            }
        }
        if p.err == "" {
            var k2 = p.kind()
            while k2 == TokenKind.Newline || k2 == TokenKind.Semi || k2 == TokenKind.Comma {
                p.next()
                k2 = p.kind()
            }
        }
    }
    var i = 0
    while i < scratch.uses.len() {
        out.push(scratch.uses.get(i))
        i = i + 1
    }
    return out
}

// 模块路径 . → /(slice 拼接——char_at 为码点整数值)
fn cg_mod_fs_path(module str) str {
    var out = ""
    var start = 0
    var i = 0
    while i < module.len() {
        if module.char_at(i) == 46 {
            out = out + module.slice(start, i) + "/"
            start = i + 1
        }
        i = i + 1
    }
    return out + module.slice(start, module.len())
}

// 递归解析:file 的 use 依赖先行入列(DFS 后序 = deps 先于依赖者;
// 环静默跳过 D2;按名去重)。返回错误文本(""=成功,宿主文本为规范)。
fn cg_resolve_into(file str, mut mods List<CGMod>, mut loading List<str>, mut done List<str>) str {
    var src = File.read_text(file)
    if src == "" {
        return "Module not found: " + file + " (module_path=" + file + ", parent_dirs=[])"
    }
    var uses = cg_use_scan(src)
    var dir = cg_dir_of(file)
    var i = 0
    while i < uses.len() {
        var u = uses.get(i)
        if u.kind == "rs" {
            var crate_name = u.module
            var di = 0
            while di < crate_name.len() {
                if crate_name.char_at(di) == 46 {
                    crate_name = crate_name.slice(0, di)
                    di = crate_name.len()
                }
                di = di + 1
            }
            return "Crate '" + crate_name + "' not declared. Add `dep " + crate_name + "` before `use.rs`."
        }
        if u.kind == "py" {
            return "Python FFI not enabled. Rebuild with `--features python` to use `use.py`."
        }
        if u.kind == "c" {
            return "Expected <lib> or \"lib\", got Ident"
        }
        // auto 模块
        var m = u.module
        var already = false
        var j = 0
        while j < done.len() {
            if done.get(j) == m {
                already = true
            }
            j = j + 1
        }
        var in_stack = false
        var j2 = 0
        while j2 < loading.len() {
            if loading.get(j2) == m {
                in_stack = true
            }
            j2 = j2 + 1
        }
        if !already && !in_stack {
            var mrel = cg_mod_fs_path(m)
            var mfile = dir + "/" + mrel + ".at"
            var msrc = File.read_text(mfile)
            if msrc == "" {
                // P532 G0:宿主探测序镜像(compile.rs load_module_inner probe1
                // ——CWD 直探):根锚定多段 use(auto.lib.* 形态)自 CWD 命中;
                // 引用文件目录拼接先行未果时回落
                mfile = mrel + ".at"
                msrc = File.read_text(mfile)
            }
            if msrc == "" {
                return "Module not found: " + m + " (module_path=" + mrel + ", parent_dirs=[])"
            }
            loading.push(m)
            var rerr = cg_resolve_into(mfile, mods, loading, done)
            if rerr != "" {
                return rerr
            }
            // loading 免清除:done 表先行判定,链上环检测仅需活动期在栈
            mods.push(CGMod(m, msrc))
            done.push(m)
        }
        i = i + 1
    }
    return ""
}

// 入口:main_path → 有序模块列(deps DFS 后序 + main 末位)。错误文本直返
fn cg_resolve(main_path str) AutoResult2 {
    var mods List<CGMod> = List.new()
    var loading List<str> = List.new()
    var done List<str> = List.new()
    var err = cg_resolve_into(main_path, mods, loading, done)
    if err != "" {
        return AutoResult2(mods, err)
    }
    var main_src = File.read_text(main_path)
    mods.push(CGMod("", main_src))
    return AutoResult2(mods, "")
}

// 多值返回载体(mods + err)
type AutoResult2 {
    mods List<CGMod>
    err str
}

// ── 编译入口(S5 engine 复用;返回 CG 结构) ────────────────────

pub fn cg_compile(source str) CG {
    // W3:主模块经 cg_compile_mod(mod_name="" → wrapper 形态)
    return cg_compile_mod(source, "")
}

// W3:多编译单元入口。主模块(mod_name=""):wrapper 形态(既有口径);
// dep 模块(mod_name≠""):裸形态——Type/Use 消费、顶层 var/const 走
// 限名全局、fn 直接发射(各自 jmp-over),尾 HALT,无 wrapper(镜像
// 宿主 compile_module_to_bytecode;语料声明序=Type→Store→Fn 单趟步行)
fn cg_compile_mod(source str, mod_name str) CG {
    var toks = tokenize(source)
    var p = parse_new(toks)
    var c = CG.new()
    c.mod_name = mod_name
    // W2(525) pass1:Type/Ext 声明位预扫——体内/ext 方法先于 wrapper
    // 编译(镜像宿主 parse 级 ext 并入 + compile_and_link 分区序;非
    // Type/Ext 语句深度感知跨度跳过);类型注册(c.tys)亦在此趟完成
    p.skip_empty_lines()
    while c.err == "" && p.err == "" && p.kind() != TokenKind.EOF {
        if p.kind() == TokenKind.Type {
            cg_type_decl(c, p)
        } else if p.kind() == TokenKind.Ext {
            cg_ext(c, p)
        } else {
            cg_skip_stmt(p)
        }
        if c.err == "" && p.err == "" {
            expect_eos(p)
            p.skip_empty_lines()
        }
    }
    if c.err != "" || p.err != "" {
        return c
    }
    // pass2:游标重置——wrapper + 全语句步行(Type/Ext 已在 pass1 编译,
    // 此处仅跨度跳过;前导注释跳过镜像 parse_new 初始化)
    p.pos = 0
    while p.pos < p.toks.len() && is_comment_kind(p.toks.get(p.pos).kind) {
        p.pos = p.pos + 1
    }
    if mod_name == "" {
        c.emit(OpCode.FnProlog, "args=0, locals=16", 16)
        c.emit(OpCode.Reserve, "16", 16)
    }
    p.skip_empty_lines()
    while c.err == "" && p.err == "" && p.kind() != TokenKind.EOF {
        if p.kind() == TokenKind.Type || p.kind() == TokenKind.Ext {
            cg_skip_stmt(p)
        } else if p.kind() == TokenKind.Fn {
            cg_fn(c, p)
        } else if p.kind() == TokenKind.Ident && p.text() == "pub" {
            p.next()
            if p.kind() == TokenKind.Fn {
                cg_fn(c, p)
            } else {
                cg_stmt(c, p)
            }
        } else {
            // 顶层非 fn 语句:主模块 wrapper 内步行(镜像 Rust
            // compile_and_link 的 other_stmts 路径);该路径不发 .line;
            // dep 模块顶层语句同口径(005 实测:模块 init store 无 .line)
            cg_stmt(c, p)
        }
        if c.err == "" {
            cg_eos(c, p)
        }
    }
    if c.err == "" {
        c.emit(OpCode.Halt, "", 0)
    }
    return c
}

// W3:链接器——cgs(deps DFS 后序 + main 末位)→ 合并 CG:
// 指令平移(jmp 目标 +base / Call fn 索引 +fnbase / 池操作数 remap 去重
// 并池)、fns/fn_mods 合并、defers 定址(mod_bases 记 dep 起始)。
// 返回 CG.err 非空即链接失败(宿主文本)
fn cg_link_modules(mut cgs List<CG>) CG {
    var m = CG.new()
    var fn_base = 0
    var mi = 0
    while mi < cgs.len() {
        var mc = cgs.get(mi)
        var ins_base = m.ins.len()
        if mi < cgs.len() - 1 {
            m.mod_bases.push(ins_base)
        }
        // 池去重合并 + remap 表
        var remap List<int> = List.new()
        var pi = 0
        while pi < mc.pool.len() {
            var ps = mc.pool.get(pi)
            var found = -1
            var pj = 0
            while pj < m.pool.len() {
                if m.pool.get(pj) == ps {
                    found = pj
                }
                pj = pj + 1
            }
            if found < 0 {
                m.pool.push(ps)
                found = m.pool.len() - 1
            }
            remap.push(found)
            pi = pi + 1
        }
        // 指令迁移
        var ii = 0
        while ii < mc.ins.len() {
            var ins = mc.ins.get(ii)
            if ins.op == OpCode.Jmp || ins.op == OpCode.JmpZ || ins.op == OpCode.JmpNz {
                ins.n = ins.n + ins_base
            } else if ins.op == OpCode.Call && ins.n >= 0 {
                ins.n = ins.n + fn_base
            } else if ins.op == OpCode.LoadStr || ins.op == OpCode.GetField || ins.op == OpCode.LoadGlobal || ins.op == OpCode.StoreGlobal {
                if ins.n >= 0 && ins.n < remap.len() {
                    ins.n = remap.get(ins.n)
                }
            }
            m.ins.push(ins)
            ii = ii + 1
        }
        // W4(525):tys 跨单元合并(pub type 跨模块)——按名去重后到
        // 覆盖(镜像宿主链接期类型表共享;field_idx/VInst 名字键跨单元
        // 命中,corpus_use 007)
        var tyi = 0
        while tyi < mc.tys.len() {
            var t2 = mc.tys.get(tyi)
            var hit2 = -1
            var tj2 = 0
            while tj2 < m.tys.len() {
                if m.tys.get(tj2).name == t2.name {
                    hit2 = tj2
                }
                tj2 = tj2 + 1
            }
            if hit2 < 0 {
                m.tys.push(t2)
            } else {
                m.tys.set(hit2, t2)
            }
            tyi = tyi + 1
        }
        // fns + fn_mods(+fn_rets 平行,W2 525)
        var fi = 0
        while fi < mc.fns.len() {
            var fe = mc.fns.get(fi)
            m.fns.push(FnEntry(fe.name, fe.ins + ins_base))
            var mn2 = mc.mod_name
            m.fn_mods.push(mn2)
            if fi < mc.fn_rets.len() {
                m.fn_rets.push(mc.fn_rets.get(fi))
            } else {
                m.fn_rets.push("")
            }
            fi = fi + 1
        }
        // defers(绝对化 ins 指针)
        var di = 0
        while di < mc.defers.len() {
            var d = mc.defers.get(di)
            m.defers.push(CGDefer(d.ins_idx + ins_base, d.symbol))
            di = di + 1
        }
        fn_base = fn_base + mc.fns.len()
        if mc.err != "" && m.err == "" {
            m.err = mc.err
        }
        mi = mi + 1
    }
    // defer 定址
    var ri = 0
    while ri < m.defers.len() {
        var d2 = m.defers.get(ri)
        var target = m.link_symbol(d2.symbol)
        if target < 0 {
            m.err = "Undefined symbol: " + d2.symbol + " in module <main>"
            return m
        }
        m.ins.get(d2.ins_idx).n = target
        ri = ri + 1
    }
    return m
}

// W3 多文件编译主入口:main_path → 合并 CG(err 语义同 cg_compile)
pub fn cg_compile_files(main_path str) CG {
    var res = cg_resolve(main_path)
    if res.err != "" {
        var e = CG.new()
        e.err = res.err
        return e
    }
    var cgs List<CG> = List.new()
    var i = 0
    while i < res.mods.len() - 1 {
        var mod = res.mods.get(i)
        cgs.push(cg_compile_mod(mod.source, mod.name))
        i = i + 1
    }
    // W4(525):pub type 跨模块——main 编译前播种 dep 类型表(ctor
    // 识别/field_idx 在编译期即需命中;链接期合并仅覆执行期查表)
    var seed List<CGType> = List.new()
    var si = 0
    while si < cgs.len() {
        var sc = cgs.get(si)
        var ti = 0
        while ti < sc.tys.len() {
            var st = sc.tys.get(ti)
            // 先查位后置换单独落(内置环只读;环内 set(st) 移动后续读
            // 触发主 a2r 转译 E0382 move 洞,aavm2_bin 自译两度实证)
            var hit_at = -1
            var dj = 0
            while dj < seed.len() {
                if seed.get(dj).name == st.name {
                    hit_at = dj
                    dj = seed.len()
                }
                dj = dj + 1
            }
            if hit_at < 0 {
                seed.push(st)
            } else {
                seed.set(hit_at, st)
            }
            ti = ti + 1
        }
        si = si + 1
    }
    var main_mod = res.mods.get(res.mods.len() - 1)
    cgs.push(cg_compile_mod_seeded(main_mod.source, main_mod.name, seed))
    return cg_link_modules(cgs)
}

// W4(525):带预播种类型表的模块编译(镜像 cg_compile_mod;种子先入
// c.tys——同名本模块声明后到覆盖)
fn cg_compile_mod_seeded(source str, mod_name str, seed List<CGType>) CG {
    var toks = tokenize(source)
    var p = parse_new(toks)
    var c = CG.new()
    c.mod_name = mod_name
    var si2 = 0
    while si2 < seed.len() {
        c.tys.push(seed.get(si2))
        si2 = si2 + 1
    }
    // pass1:Type/Ext 声明位预扫(cg_compile_mod 同款)
    p.skip_empty_lines()
    while c.err == "" && p.err == "" && p.kind() != TokenKind.EOF {
        if p.kind() == TokenKind.Type {
            cg_type_decl(c, p)
        } else if p.kind() == TokenKind.Ext {
            cg_ext(c, p)
        } else {
            cg_skip_stmt(p)
        }
        if c.err == "" && p.err == "" {
            expect_eos(p)
            p.skip_empty_lines()
        }
    }
    if c.err != "" || p.err != "" {
        return c
    }
    p.pos = 0
    while p.pos < p.toks.len() && is_comment_kind(p.toks.get(p.pos).kind) {
        p.pos = p.pos + 1
    }
    if mod_name == "" {
        c.emit(OpCode.FnProlog, "args=0, locals=16", 16)
        c.emit(OpCode.Reserve, "16", 16)
    }
    p.skip_empty_lines()
    while c.err == "" && p.err == "" && p.kind() != TokenKind.EOF {
        if p.kind() == TokenKind.Type || p.kind() == TokenKind.Ext {
            cg_skip_stmt(p)
        } else if p.kind() == TokenKind.Fn {
            cg_fn(c, p)
        } else if p.kind() == TokenKind.Ident && p.text() == "pub" {
            p.next()
            if p.kind() == TokenKind.Fn {
                cg_fn(c, p)
            } else {
                cg_stmt(c, p)
            }
        } else {
            cg_stmt(c, p)
        }
        if c.err == "" {
            cg_eos(c, p)
        }
    }
    if c.err == "" {
        c.emit(OpCode.Halt, "", 0)
    }
    return c
}

// W3 M4 多文件闸门入口
fn codegen_dump_files(main_path str) str {
    var c = cg_compile_files(main_path)
    if c.err != "" {
        return c.err
    }
    return c.serialize()
}

// M4 闸门入口
pub fn codegen_dump(source str) str {
    var c = cg_compile(source)
    if c.err != "" {
        return c.err
    }
    return c.serialize()
}
