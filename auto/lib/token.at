    if k == TokenKind.Comma { return "Comma" }
    if k == TokenKind.Semi { return "Semi" }
    if k == TokenKind.Newline { return "Newline" }
    if k == TokenKind.Add { return "Add" }
    if k == TokenKind.Sub { return "Sub" }
    if k == TokenKind.Star { return "Star" }
