// ╔═══════════════════════════════════════════════════════════╗
// ║ AAVM v2 Sync Snapshot                                     ║
// ║ Component: engine.at (Plan 432 S5 / D29: ev_run)          ║
// ║ Rust ref:  vm/engine.rs(执行循环)+ lib.rs(main 入口查找) ║
// ║ Gate:      M3 主里程碑 —— VM 内全管线跑通 corpus 行为      ║
// ╚═══════════════════════════════════════════════════════════╝
//           447-③ 终局收账:ev_run_t 分派巨链 is(E1)/Val 枚举化
//           VInt|VStr|VArr|VInst(E2,D34)/BuildFstr 执行(11.2a);D36①②
//           提升写法永久保留(正确性保障,rules §4a)
// Coverage:  栈机执行循环(指令 List 直译,无字节码解码);帧语义
//            (CALL:ret-ip+old-bp;RET:result 转移 + new_sp=bp-n_args;
//            fn.prolog 记 n_args;reserve 推 n+1 零槽);main 入口
//            查找(无 main 回落 wrapper=0,镜像 lib.rs 1183);
//            指令子集:const.i32/push.bool/push.nil/load.str/
//            load.loc.0/1/2/load.local(参数 0x80+rel →
//            bp-n_args+rel-1)/store.loc.0/1/store.local/
//            add/sub/mul/div/mod/eq/ne/lt/gt/le/ge/and/or/not/
//            str.cat/dup/pop/jmp/jmp.z/.line(nop)/call/call.nat
//            (nat#10=print → 输出行收集)/ret/halt;
//            [M4 扩]create.arr(元素依次建 Auto List)、get.elem
//            (负下标归一/OOB 推 0,镜像 engine.rs 4403)、set.elem
//            (value 在栈底:idx,arr,value 逆序弹;引用语义原地写)、
//            arr.len(List/str 动态分派,镜像 ARRAY_LEN 的两分支)
// Missing:   浮点/对象/字符串下标(码点取值已含)/方法调用 native、
//            闭包、全局变量、任务/调度/async(debugger/trace 按
//            计划不移植)、值 RC(宿主 AutoVM 自管 .at 值生命周期)
// DIVERGE:   D29: 字节码 Flash + ip 解码 → 指令 List 直译
//            (ip=指令索引;jmp/call 目标即索引);print 输出 →
//            out 字符串收集(run 返回);栈 = Auto List + 手记账 sp
//            (ev_push 兼容 push/set);RET 帧/参数槽位算术
//            与 engine.rs 逐条对齐(参数寻址 bp-n_args+rel-1)。
//            D30(433 重构):负 int 偏置编码保留但收窄到 int 载荷
//            域;D31(433 重构;447-③ E2 收账):值栈异构载体 → 枚举
//            Val{VInt/VStr/VArr/VInst}(对齐 auto-val Value 的 match
//            分派;433 期"枚举载荷跨函数丢标签"以宿主 H3 根治解除);
//            W1(525):bool 加 VBool 载体(P474-旁支收口)——print/
//            比较/逻辑结果 true/false 形态对齐宿主 TAG_BOOL;ADD/
//            STR_CAT 混入 bool 的宿主哨兵退化形态(decode_i32)不
//            镜像,语料不覆盖;nil 仍以 0 整型承载。

// 值栈元素:异构值的显式载体(433:a2r 需要静态元素类型;VM 侧 List
// 本就动态,行为不变)。447-③ E2(D34 收账):判别器结构体 {k,i,s}
// → 枚举载荷 VInt/VStr/VArr/VInst(对齐 auto-val Value 枚举的 match
// 分派形态;433 期的"枚举载荷跨函数传参丢标签"规避以 H3 根治解除,
// probe/b31/g05 三件护航)。VArr/VInst 的 int 载荷 = arena(数组侧表)
// 索引——索引即引用,镜像宿主 VM 的堆 id 设计(D31 续:VM 引用语义
// 与 a2r 值语义在"单一事实源=arena 槽位"上对齐,局部槽/栈位持有的
// 是可自由复制的索引);VInst 双载荷 {arena 字段表槽位, 变体名}
// (部分② 的 k=3 实例形态枚举化)。
// Plan 517 W2:模块化互引(拼接消费面由双轨剥离消化;纯解释器层仅依赖 codegen)
use auto.lib.codegen: CG, OpCode, cg_compile, cg_compile_files, op_name

enum Val {
    VInt(int)
    VStr(str)
    VBool(bool)
    VArr(int)
    VInst(int, str)
}

fn ev_vi(x int) Val {
    return Val.VInt(x)
}

fn ev_vs(t str) Val {
    return Val.VStr(t)
}

// W1(Plan 525):bool 载体——print/比较/逻辑结果的显示形态与宿主
// TAG_BOOL(encode_bool)对齐(true/false;P474-旁支收口)
fn ev_vb(b bool) Val {
    return Val.VBool(b)
}

fn ev_va(ai int) Val {
    return Val.VArr(ai)
}

// 栈写:sp 越界即 push,否则原地 set(镜像 ev_push)
fn ev_push(mut stack List<Val>, sp int, v Val) int {
    if sp == stack.len() {
        stack.push(v)
    } else {
        stack.set(sp, v)
    }
    return sp + 1
}

// 数值视图:int 载荷;其余 0(镜像 VM 对非数值参与 ==0 判定的行为)
fn ev_int(v Val) int {
    is v {
        Val.VInt(n) -> n
        else -> 0
    }
}

// bool 显示形态(宿主 print tag==3 臂):块臂带 return 与表达式臂混排
// 会触发主 a2r is-match 发射破缺(W1 实证:表达式臂被发成 `{...;}` 语句
// 块丢值;登记债)——独立辅助函数规避
fn ev_bool_str(b bool) str {
    if b {
        return "true"
    }
    return "false"
}

// 显示串(print 参数):镜像宿主 ADD-含字符串即拼接的语义;负 int
// 先解偏置(D30 编码);bool 走 true/false(宿主 print tag==3 臂);
// arr 为不可比载体(语料以元素/len 为观察通道,D31),占位输出
fn ev_str(v Val) str {
    is v {
        Val.VStr(t) -> t
        Val.VBool(b) -> ev_bool_str(b)
        Val.VInt(n) -> ev_dec(n).str()
        else -> "[arr]"
    }
}

// 真值:bool 按载荷(宿主 nv_truthy is_bool 权威);int 按 !=0;其余
// (含 str)恒真(镜像 VM `v != 0` 的行为——字符串与 0 比较恒不等)
fn ev_truthy(v Val) bool {
    is v {
        Val.VBool(b) -> b
        Val.VInt(n) -> n != 0
        else -> true
    }
}

// v2 负 int 编码(D30):负 int 偏置 -1e9 入栈(规避宿主无类型
// List 的字符串哨兵别名);非负原样穿透
fn ev_enc(v int) int {
    if v < 0 {
        return v - 1000000000
    }
    return v
}

fn ev_dec(v int) int {
    if v <= -1000000000 {
        return v + 1000000000
    }
    return v
}

// 加法(host ADD 语义):任一侧字符串 → 拼接;双 int → 数值加
// (str.cat 指令与 add 的宿主语义镜像,当前 codegen 仅对已知
// 字符串操作数发 str.cat,双 int 分支为语义保真保留)
fn ev_add(a Val, b Val) Val {
    is a {
        Val.VStr(sa) -> {
            var bs = ev_str(b)
            return ev_vs(sa + bs)
        }
        else -> {
        }
    }
    is b {
        Val.VStr(sb) -> {
            var as2 = ev_str(a)
            return ev_vs(as2 + sb)
        }
        else -> {
        }
    }
    return ev_vi(ev_int(a) + ev_int(b))
}

// 全序比较:int 域比较先解偏置;str 域字典序(VM "b" > "a" 实测);
// bool×bool 按位相等性(宿主 EQ a_nv==b_nv:同值 0、异值 2);
// 混合型/arr 不可比 → 2(eq 取 false、ne 取 true,镜像 VM "x" == 1
// → false);返回 -1/0/1/2
fn ev_cmp(a Val, b Val) int {
    is a {
        Val.VBool(ba) -> {
            // 嵌套 is 用新鲜拷贝(H5;同上)
            var b0 = b
            is b0 {
                Val.VBool(bb) -> {
                    if ba == bb {
                        return 0
                    }
                    return 2
                }
                else -> {
                }
            }
        }
        Val.VInt(ax) -> {
            // 嵌套 is 用新鲜拷贝(同标识符二次 is 会触发主 a2r H5 的
            // match & 引用绑定,载荷变 &i64/&String 不可再入按值调用)
            var b1 = b
            is b1 {
                Val.VInt(bx) -> {
                    var dx = ev_dec(ax)
                    var dy = ev_dec(bx)
                    if dx < dy {
                        return -1
                    }
                    if dx > dy {
                        return 1
                    }
                    return 0
                }
                else -> {
                }
            }
        }
        Val.VStr(sa) -> {
            var b2 = b
            is b2 {
                Val.VStr(sb) -> {
                    if sa < sb {
                        return -1
                    }
                    if sa > sb {
                        return 1
                    }
                    return 0
                }
                else -> {
                }
            }
        }
        else -> {
        }
    }
    return 2
}

// arr 载荷提取(只读用途);非数组值返回空表(长度 0 → OOB 语义)
fn ev_arr_of(mut arena List<List<Val>>, v Val) List<Val> {
    is v {
        Val.VArr(ai) -> {
            return arena.get(ai)
        }
        else -> {
        }
    }
    var none_l List<Val> = List.new()
    return none_l
}

// set.elem 写通道:唯一变异点 = arena 槽位。VM 引用语义下 l2 即
// arena 内同一引用(set 后 arena.set 为无操作写回);a2r 值语义下
// 写回修改副本进 arena——两种语义的可观察状态一致
fn ev_arr_write(mut arena List<List<Val>>, ai int, idx int, val Val) {
    var l2 List<Val> = arena.get(ai)
    l2.set(idx, val)
    arena.set(ai, l2)
}

// 数组/字符串长度动态分派(镜像 ARRAY_LEN 两分支)
fn ev_len(mut arena List<List<Val>>, v Val) int {
    is v {
        Val.VArr(ai) -> {
            var l = arena.get(ai)
            return l.len()
        }
        Val.VStr(t) -> {
            return t.len()
        }
        else -> {
        }
    }
    return 0
}

// ── 执行循环 ──────────────────────────────────────────────────

pub fn ev_run(source str) str {
    return ev_run_t(source, 0)
}

fn ev_run_t(source str, trace int) str {
    var c = cg_compile(source)
    if c.err != "" {
        return c.err
    }
    // main 入口查找(无 main 回落 0 = wrapper,镜像 lib.rs 1183)
    var entry = 0
    var fi = 0
    while fi < c.fns.len() {
        if c.fns.get(fi).name == "main" {
            entry = c.fns.get(fi).ins
        }
        fi = fi + 1
    }
    var gnames List<str> = List.new()
    var gvals List<Val> = List.new()
    return ev_exec(c, entry, trace, gnames, gvals)
}

// W3(Plan 511)多文件执行入口:resolve_uses→多编译单元→链接→初始化序
// (dep 模块链接序逐个执行至各自 HALT,全局区共享)→main 入口。
// 模块解析/编译错误文本直返(宿主为规范)
pub fn ev_run_files(main_path str) str {
    var c = cg_compile_files(main_path)
    if c.err != "" {
        return c.err
    }
    var gnames List<str> = List.new()
    var gvals List<Val> = List.new()
    var out = ""
    var bi = 0
    while bi < c.mod_bases.len() {
        var chunk = ev_exec(c, c.mod_bases.get(bi), 0, gnames, gvals)
        if chunk != "" {
            if out != "" {
                out = out + "
"
            }
            out = out + chunk
        }
        bi = bi + 1
    }
    // main 入口(镜像 lib.rs 1222:main/test 导出,否则主模块起点)
    var entry = 0
    var fi2 = 0
    while fi2 < c.fns.len() {
        if c.fns.get(fi2).name == "main" {
            entry = c.fns.get(fi2).ins
        }
        fi2 = fi2 + 1
    }
    var main_out = ev_exec(c, entry, 0, gnames, gvals)
    if main_out != "" {
        if out != "" {
            out = out + "
"
        }
        out = out + main_out
    }
    return out
}

// 执行核心(自 ev_run_t 抽出:单文件/多模块 init 共用;全局区以
// gnames/gvals 传入共享——VM List 引用语义写回)
fn ev_exec(c CG, entry int, trace int, mut gnames List<str>, mut gvals List<Val>) str {
    var stack List<Val> = List.new()
    var arena List<List<Val>> = List.new()
    var sp = 0
    // 初始帧:[0=ret 哨兵, 0=oldbp 哨兵];bp=1;main 的 RET 触底即 halt
    sp = ev_push(stack, sp, ev_vi(0))
    sp = ev_push(stack, sp, ev_vi(0))
    var bp = 1
    var ip = entry
    var out = ""
    var cur_args = 0
    var args_stack List<int> = List.new()
    var args_depth = 0
    var running = true
    while running {
        var ins = c.ins.get(ip)
        ip = ip + 1
        var op = ins.op
        if trace == 1 {
            if out != "" {
                out = out + "\n"
            }
            out = f"${out}${op_name(op)} sp=${sp.str()} bp=${bp.str()}"
        }
        is op {
            OpCode.Blank -> {
            // 已删除的占位指令(如 n_locals=0 时的 reserve)——跳过
        }
        OpCode.Halt -> {
            running = false
        }
        OpCode.Line | OpCode.FnProlog -> {
            if op == OpCode.FnProlog {
                cur_args = ins.n
            }
        }
        OpCode.Reserve -> {
            var n = ins.n
            var k = 0
            while k < n + 1 {
                sp = ev_push(stack, sp, ev_vi(0))
                k = k + 1
            }
        }
        OpCode.Jmp -> {
            ip = ins.n
        }
        OpCode.JmpZ -> {
            var v = stack.get(sp - 1)
            sp = sp - 1
            if !ev_truthy(v) {
                ip = ins.n
            }
        }
        OpCode.JmpNz -> {
            // Plan 447 部分②:or 臂短路或(H1 修后口径)
            var v0 = stack.get(sp - 1)
            sp = sp - 1
            if ev_truthy(v0) {
                ip = ins.n
            }
        }
        OpCode.NewInstance -> {
            // Plan 447 部分②:弹名长(const.i32 哨兵,名字在操作数);
            // 建空字段表入 arena,推实例(VInst:slot=arena 槽位,
            // name=变体名)
            sp = sp - 1
            var nm = ins.s
            if nm.len() >= 2 && nm.char_at(0) == '"' {
                nm = nm.slice(1, nm.len() - 1)
            }
            var fl List<Val> = List.new()
            arena.push(fl)
            var slot3 = arena.len() - 1
            sp = ev_push(stack, sp, Val.VInst(slot3, nm))
        }
        OpCode.ConstructInstance -> {
            // 栈:[..., 字段值…, 实例, 字段数](镜像宿主弹序:count→
            // instance→count 值);字段自底而上读入 arena 槽,实例回栈
            var n9 = ev_dec(ev_int(stack.get(sp - 1)))
            sp = sp - 1
            var inst9 = stack.get(sp - 1)
            sp = sp - 1
            var fl9 List<Val> = List.new()
            // is 拷贝:VInst 绑定 String 载荷是部分移动,inst9 后续回栈复用
            var inst9c = inst9
            is inst9c {
                Val.VInst(slot9, nm9) -> {
                    fl9 = arena.get(slot9)
                    var ci9 = 0
                    while ci9 < n9 {
                        fl9.push(stack.get(sp - n9 + ci9))
                        ci9 = ci9 + 1
                    }
                    arena.set(slot9, fl9)
                }
                else -> {
                }
            }
            sp = sp - n9
            sp = ev_push(stack, sp, inst9)
        }
        OpCode.IsVariant -> {
            // 弹实例,推命中 bool;VInst 且变体名全等才命中(非实例恒假)
            var v9 = stack.get(sp - 1)
            sp = sp - 1
            var nm9 = ins.s
            if nm9.len() >= 2 && nm9.char_at(0) == '"' {
                nm9 = nm9.slice(1, nm9.len() - 1)
            }
            var hit9 = 0
            is v9 {
                Val.VInst(slot9, name9) -> {
                    if name9 == nm9 {
                        hit9 = 1
                    }
                }
                else -> {
                }
            }
            sp = ev_push(stack, sp, ev_vi(hit9))
        }
        OpCode.GetGenericField -> {
            // 弹实例,推第 n 槽字段(后续 3 条 nop 为 u32 残留形态,直通)
            var v10 = stack.get(sp - 1)
            sp = sp - 1
            var slot10 = 0
            is v10 {
                Val.VInst(s10, nm10) -> {
                    slot10 = s10
                }
                else -> {
                }
            }
            var fl10 List<Val> = arena.get(slot10)
            sp = ev_push(stack, sp, fl10.get(ins.n))
        }
        OpCode.SetGenericField -> {
            // W1(Plan 511):栈 [value, instance_id](镜像宿主 6324-6352);
            // 弹实例→弹值→按声明序下标写 arena 槽(后 3 条 nop 直通)
            var v12 = stack.get(sp - 1)
            sp = sp - 1
            var slot12 = -1
            is v12 {
                Val.VInst(s12, nm12) -> {
                    slot12 = s12
                }
                else -> {
                }
            }
            var val12 = stack.get(sp - 1)
            sp = sp - 1
            if slot12 < 0 {
                out = "RUNTIME-ERROR:set.generic.field on non-instance"
                running = false
            } else {
                var fl12 List<Val> = arena.get(slot12)
                fl12.set(ins.n, val12)
                arena.set(slot12, fl12)
            }
        }
        OpCode.GetField -> {
            // W1:弹实例,按字段名(ins.n=名字池索引)在实例类型声明序中
            // 定位下标取值(镜像宿主 engine 5236 的 field_names.position)
            var v13 = stack.get(sp - 1)
            sp = sp - 1
            var slot13 = -1
            var tname13 = ""
            is v13 {
                Val.VInst(s13, nm13) -> {
                    slot13 = s13
                    tname13 = nm13
                }
                else -> {
                }
            }
            if slot13 < 0 {
                out = "RUNTIME-ERROR:get.field on non-instance"
                running = false
            } else {
                var fname13 = c.pool.get(ins.n)
                var fi13 = c.field_idx(tname13, fname13)
                if fi13 < 0 {
                    out = "RUNTIME-ERROR:no field " + fname13 + " in " + tname13
                    running = false
                } else {
                    var fl13 List<Val> = arena.get(slot13)
                    sp = ev_push(stack, sp, fl13.get(fi13))
                }
            }
        }
        OpCode.SetField -> {
            // W1:栈 [value, object_id, field_name](名字经 load.str 压栈,
            // 镜像宿主 4925-4947 弹序:名→实例→值)
            var vname14 = ev_str(stack.get(sp - 1))
            sp = sp - 1
            var v14 = stack.get(sp - 1)
            sp = sp - 1
            var slot14 = -1
            var tname14 = ""
            is v14 {
                Val.VInst(s14, nm14) -> {
                    slot14 = s14
                    tname14 = nm14
                }
                else -> {
                }
            }
            var val14 = stack.get(sp - 1)
            sp = sp - 1
            if slot14 < 0 {
                out = "RUNTIME-ERROR:set.field on non-instance"
                running = false
            } else {
                var fi14 = c.field_idx(tname14, vname14)
                if fi14 < 0 {
                    out = "RUNTIME-ERROR:no field " + vname14 + " in " + tname14
                    running = false
                } else {
                    var fl14 List<Val> = arena.get(slot14)
                    fl14.set(fi14, val14)
                    arena.set(slot14, fl14)
                }
            }
        }
        OpCode.BuildFstr -> {
            // 447-③ 11.2a:弹 ins.n 段(栈顶为末段,镜像宿主逆序弹),
            // ev_str 逐段转文本(int 解偏置 D30)正序拼接
            var n11 = ins.n
            var segs List<str> = List.new()
            var k11 = 0
            while k11 < n11 {
                segs.push(ev_str(stack.get(sp - 1)))
                sp = sp - 1
                k11 = k11 + 1
            }
            var out11 = ""
            var m11 = segs.len() - 1
            while m11 >= 0 {
                out11 = out11 + segs.get(m11)
                m11 = m11 - 1
            }
            sp = ev_push(stack, sp, ev_vs(out11))
        }
        OpCode.Nop -> {
            // no-op(get.generic.field 的 u32 残留字节形态)
        }
        OpCode.ConstI32 -> {
            sp = ev_push(stack, sp, ev_vi(ev_enc(ins.n)))
        }
        OpCode.Const0 -> {
            // W2:for-in 计数器初值(宿主 CONST_0 0x12)
            sp = ev_push(stack, sp, ev_vi(0))
        }
        OpCode.LoadGlobal -> {
            // W2:名字键全局读;未命中缺省 0(镜像宿主 unwrap_or(0))
            var gname = c.pool.get(ins.n)
            var gv = ev_vi(0)
            var qi = 0
            while qi < gnames.len() {
                if gnames.get(qi) == gname {
                    gv = gvals.get(qi)
                }
                qi = qi + 1
            }
            sp = ev_push(stack, sp, gv)
        }
        OpCode.StoreGlobal -> {
            // W2:弹值覆盖/插入(名字键)
            var gname2 = c.pool.get(ins.n)
            var gval2 = stack.get(sp - 1)
            sp = sp - 1
            // 先定位后单次写(名字键唯一;循环内不移动——a2r 借用检查友好)
            var gpos = -1
            var qi2 = 0
            while qi2 < gnames.len() {
                if gnames.get(qi2) == gname2 {
                    gpos = qi2
                    qi2 = gnames.len()
                }
                qi2 = qi2 + 1
            }
            if gpos >= 0 {
                gvals.set(gpos, gval2)
            } else {
                gnames.push(gname2)
                gvals.push(gval2)
            }
        }
        OpCode.PushBool -> {
            // W1(525):bool 以 VBool 载体入栈——print/传递形态对齐宿主
            // TAG_BOOL(旧 1/0 整型承载为 P474 过渡形态,收口)
            if ins.s == "true" {
                sp = ev_push(stack, sp, ev_vb(true))
            } else {
                sp = ev_push(stack, sp, ev_vb(false))
            }
        }
        OpCode.PushNil -> {
            sp = ev_push(stack, sp, ev_vi(0))
        }
        OpCode.LoadStr -> {
            // D25-① 规避:原生调用(get)不得内联作枚举构造参数,先提升
            var sv = c.pool.get(ins.n)
            sp = ev_push(stack, sp, ev_vs(sv))
        }
        OpCode.LoadLoc0 -> {
            var v0 = stack.get(bp + 1)
            sp = ev_push(stack, sp, v0)
        }
        OpCode.LoadLoc1 -> {
            var v1 = stack.get(bp + 2)
            sp = ev_push(stack, sp, v1)
        }
        OpCode.LoadLoc2 -> {
            var v2 = stack.get(bp + 3)
            sp = ev_push(stack, sp, v2)
        }
        OpCode.LoadLocal -> {
            if ins.n >= 128 {
                // 参数:bp - n_args + rel - 1(engine.rs 7304 同式)
                var rel = ins.n - 128
                var slot = bp - cur_args + rel - 1
                var va = stack.get(slot)
                sp = ev_push(stack, sp, va)
            } else {
                var vb = stack.get(bp + 1 + ins.n)
                sp = ev_push(stack, sp, vb)
            }
        }
        OpCode.StoreLoc0 -> {
            sp = sp - 1
            stack.set(bp + 1, stack.get(sp))
        }
        OpCode.StoreLoc1 -> {
            sp = sp - 1
            stack.set(bp + 2, stack.get(sp))
        }
        OpCode.StoreLocal -> {
            sp = sp - 1
            if ins.n >= 128 {
                var rel2 = ins.n - 128
                stack.set(bp - cur_args + rel2 - 1, stack.get(sp))
            } else {
                stack.set(bp + 1 + ins.n, stack.get(sp))
            }
        }
        OpCode.Dup -> {
            var vd = stack.get(sp - 1)
            sp = ev_push(stack, sp, vd)
        }
        OpCode.Pop -> {
            sp = sp - 1
        }
        OpCode.Call -> {
            var fe = c.fns.get(ins.n)
            args_stack.push(cur_args)
            args_depth = args_depth + 1
            sp = ev_push(stack, sp, ev_vi(ip))
            sp = ev_push(stack, sp, ev_vi(bp))
            bp = sp - 1
            ip = fe.ins
        }
        OpCode.Ret -> {
            var result = stack.get(sp - 1)
            sp = sp - 1
            var old_bp = ev_int(stack.get(bp))
            var ret_ip = ev_int(stack.get(bp - 1))
            var n_args = ins.n
            var new_sp = bp - n_args
            stack.set(new_sp - 1, result)
            sp = new_sp
            if old_bp == 0 && bp == 1 {
                running = false
            } else {
                bp = old_bp
                ip = ret_ip
                if args_depth > 0 {
                    args_depth = args_depth - 1
                    cur_args = args_stack.get(args_depth)
                }
            }
        }
        OpCode.CallNat -> {
            // W3(Plan 525):auto.list 容器族(native_catalog 100/101/
            // 106/107;lib 盘点最小方法集)。宿主发射序:b46 m4 对拍
            // load l → args → call.nat(栈 [list, value..])
            if ins.n == 100 {
                // nat#100 = auto.list.new——空表入 arena,推 VArr 索引
                var nl100 List<Val> = List.new()
                arena.push(nl100)
                sp = ev_push(stack, sp, ev_va(arena.len() - 1))
            } else if ins.n == 101 {
                // nat#101 = auto.list.push——栈 [list, value]:槽位追加,
                // 推 0(语句位 pop 消化)
                var pv101 = stack.get(sp - 1)
                sp = sp - 1
                var pl101 = stack.get(sp - 1)
                sp = sp - 1
                is pl101 {
                    Val.VArr(ai101) -> {
                        var l101 = arena.get(ai101)
                        l101.push(pv101)
                        arena.set(ai101, l101)
                    }
                    else -> {
                    }
                }
                sp = ev_push(stack, sp, ev_vi(0))
            } else if ins.n == 106 {
                // nat#106 = auto.list.get——栈 [list, idx]:OOB 推 0
                // (镜像宿主 shim 缺省面)
                var gi106 = ev_dec(ev_int(stack.get(sp - 1)))
                sp = sp - 1
                var gl106 = stack.get(sp - 1)
                sp = sp - 1
                var gval106 = ev_vi(0)
                is gl106 {
                    Val.VArr(gai106) -> {
                        var glst106 = arena.get(gai106)
                        if gi106 >= 0 && gi106 < glst106.len() {
                            gval106 = glst106.get(gi106)
                        }
                    }
                    else -> {
                    }
                }
                sp = ev_push(stack, sp, gval106)
            } else if ins.n == 107 {
                // nat#107 = auto.list.set——栈 [list, idx, value]:写
                // 槽位(OOB 静默),推 0
                var sv107 = stack.get(sp - 1)
                sp = sp - 1
                var si107 = ev_dec(ev_int(stack.get(sp - 1)))
                sp = sp - 1
                var sl107 = stack.get(sp - 1)
                sp = sp - 1
                is sl107 {
                    Val.VArr(sai107) -> {
                        var slst107 = arena.get(sai107)
                        if si107 >= 0 && si107 < slst107.len() {
                            slst107.set(si107, sv107)
                            arena.set(sai107, slst107)
                        }
                    }
                    else -> {
                    }
                }
                sp = ev_push(stack, sp, ev_vi(0))
            } else if ins.n == 103 {
                // Plan 523 H6:nat#103 = auto.list.len(镜像宿主 shim_list_len;
                // PLAN-057 T3 for-in Call 源通道每迭代求长,m4 字节码镜像配套)
                var larr103 = stack.get(sp - 1)
                sp = sp - 1
                var llen103 = ev_len(arena, larr103)
                sp = ev_push(stack, sp, ev_vi(llen103))
            } else if ins.n == 112 {
                // W2:nat#112 = auto.iterator.next——裸 List 句柄非迭代器
                // 对象,shim 立即 -1(511 期宿主实测零迭代;525 W1 复测宿主
                // for-in 已按元素迭代——Call 源通道走 T3 求长路径不经此臂,
                // 本臂保留为字节码镜像完备位,b38 现行两侧一致)
                var itv = stack.get(sp - 1)
                sp = sp - 1
                var next_v = ev_vi(-1)
                sp = ev_push(stack, sp, next_v)
            } else {
            // nat#10 = print:弹 1 参入输出
            if out != "" {
                out = out + "\n"
            }
            out = out + ev_str(stack.get(sp - 1))
            sp = sp - 1
            sp = ev_push(stack, sp, ev_vi(0))
        }
            }
        OpCode.Add | OpCode.Sub | OpCode.Mul | OpCode.Div | OpCode.Mod -> {
            var b = ev_dec(ev_int(stack.get(sp - 1)))
            var a = ev_dec(ev_int(stack.get(sp - 2)))
            sp = sp - 1
            var r = 0
            if op == OpCode.Add {
                r = a + b
            } else if op == OpCode.Sub {
                r = a - b
            } else if op == OpCode.Mul {
                r = a * b
            } else if op == OpCode.Div {
                r = a / b
            } else {
                r = a % b
            }
            stack.set(sp - 1, ev_vi(ev_enc(r)))
        }
        OpCode.StrCat -> {
            var b2 = stack.get(sp - 1)
            var a2 = stack.get(sp - 2)
            sp = sp - 1
            // W2:STR_CAT 恒字符串拼接(镜像宿主——操作数按显示形态字符串化:
            // s[i]+s[j] 两码点 int 拼成 "6667",非数值加;b39 实证)
            stack.set(sp - 1, ev_vs(ev_str(a2) + ev_str(b2)))
        }
        OpCode.Eq | OpCode.Ne | OpCode.Lt | OpCode.Gt | OpCode.Le | OpCode.Ge -> {
            var bv = stack.get(sp - 1)
            var av = stack.get(sp - 2)
            sp = sp - 1
            var cr = ev_cmp(av, bv)
            var r2 = 0
            if op == OpCode.Eq {
                if cr == 0 {
                    r2 = 1
                }
            } else if op == OpCode.Ne {
                if cr != 0 {
                    r2 = 1
                }
            } else if op == OpCode.Lt {
                if cr == -1 {
                    r2 = 1
                }
            } else if op == OpCode.Gt {
                if cr == 1 {
                    r2 = 1
                }
            } else if op == OpCode.Le {
                if cr == 0 || cr == -1 {
                    r2 = 1
                }
            } else {
                if cr == 0 || cr == 1 {
                    r2 = 1
                }
            }
            // W1(525):比较结果推 VBool(宿主 EQ 族全推 encode_bool)
            stack.set(sp - 1, ev_vb(r2 == 1))
        }
        OpCode.And | OpCode.Or -> {
            var b3 = stack.get(sp - 1)
            var a3 = stack.get(sp - 2)
            sp = sp - 1
            var r3 = 0
            if op == OpCode.And {
                if ev_truthy(a3) && ev_truthy(b3) {
                    r3 = 1
                }
            } else {
                if ev_truthy(a3) || ev_truthy(b3) {
                    r3 = 1
                }
            }
            // W1(525):逻辑结果推 VBool(宿主 AND/OR 推 encode_bool)
            stack.set(sp - 1, ev_vb(r3 == 1))
        }
        OpCode.Not -> {
            var v4 = stack.get(sp - 1)
            // W1(525):非结果推 VBool(宿主 NOT 推 encode_bool)
            if ev_truthy(v4) {
                stack.set(sp - 1, ev_vb(false))
            } else {
                stack.set(sp - 1, ev_vb(true))
            }
        }
        OpCode.Neg -> {
            var v10 = ev_dec(ev_int(stack.get(sp - 1)))
            stack.set(sp - 1, ev_vi(ev_enc(-v10)))
        }
        OpCode.CreateArr -> {
            // 元素已按序压栈;自下而上读入新 List,入 arena 后以索引
            // 为载体(索引即引用,镜像宿主堆 id)
            var n6 = ins.n
            var arr6 List<Val> = List.new()
            var i6 = 0
            while i6 < n6 {
                arr6.push(stack.get(sp - n6 + i6))
                i6 = i6 + 1
            }
            sp = sp - n6
            arena.push(arr6)
            var ai6 = arena.len() - 1
            sp = ev_push(stack, sp, ev_va(ai6))
        }
        OpCode.GetElem -> {
            // 栈:[..., arr, idx];负下标归一,-1=末位;OOB 推 0
            // (engine.rs 4403);str 接收者取码点(Missing→已含)
            var idx7 = ev_dec(ev_int(stack.get(sp - 1)))
            var arrv Val = stack.get(sp - 2)
            var len7 = ev_len(arena, arrv)
            var j7 = idx7
            if j7 < 0 {
                j7 = len7 + j7
            }
            var val7 = ev_vi(0)
            if j7 >= 0 && j7 < len7 {
                is arrv {
                    Val.VArr(ai7) -> {
                        var l7 = ev_arr_of(arena, arrv)
                        val7 = l7.get(j7)
                    }
                    Val.VStr(sv7) -> {
                        // D25-① 规避:char_at 原生调用先提升
                        var cv = sv7.char_at(j7)
                        val7 = ev_vi(cv)
                    }
                    else -> {
                    }
                }
            }
            sp = sp - 2
            sp = ev_push(stack, sp, val7)
        }
        OpCode.SetElem -> {
            // 栈:[..., value, arr, idx](value 展栈底,Rust quick-fix
            // 栈序);写通道 = ev_arr_write + 写回数组槽位(VM 引用
            // 语义下写回同一引用,无操作;a2r 值语义写回修改副本)
            var idx8 = ev_dec(ev_int(stack.get(sp - 1)))
            var arr8 = stack.get(sp - 2)
            var val8 = stack.get(sp - 3)
            is arr8 {
                Val.VArr(ai8) -> {
                    ev_arr_write(arena, ai8, idx8, val8)
                }
                else -> {
                }
            }
            sp = sp - 3
        }
        OpCode.ArrLen -> {
            // 动态分派:List→元素数,str→长度(镜像 ARRAY_LEN 两分支)
            var v9 = stack.get(sp - 1)
            var l9 = ev_len(arena, v9)
            sp = sp - 1
            sp = ev_push(stack, sp, ev_vi(l9))
        }
        else -> {
            return "ENGINE-ERROR:unknown op " + op_name(op)
        }
        }
    }
    return out
}
