// Plan 517 W2:模块化互引(拼接消费面由双轨剥离消化;P 方法族随类型导入)
use auto.lib.token: TokenKind, kind_name
use auto.lib.lexer: Token, tokenize

type Binding {
    name str
    ty str
}

pub type P {
    toks List<Token>
    pos int
    err str
    scopes List<List<Binding>>
    globals List<Binding>
    depth int
    decls List<Binding>

    // ── Plan 514 W3(γ4 试点):P 游标自有操作族入 type 体 ──
    // 映射:原自由函数 p_kind/p_text/.../pop_scope;`err` 字段与
    // p_err 撞名 → 方法名 fail;语法产生式(parse_*)与纯表函数
    // (is_comment_kind/p_op/...)保留自由函数(待澄清①缺省)。

    fn kind() TokenKind {
        if .pos >= .toks.len() {
            return TokenKind.EOF
        }
        return .toks.get(.pos).kind
    }

    fn text() str {
        if .pos >= .toks.len() {
            return ""
        }
        return .toks.get(.pos).text
    }

    fn line() int {
        if .pos >= .toks.len() {
            return 0
        }
        return .toks.get(.pos).line
    }

    // 原始前瞻(不跳注释;与基线 lexer.pushback 前瞻同构,corpus 括号内无注释)
    fn peek(n int) TokenKind {
        var i = .pos + n
        if i >= .toks.len() {
            return TokenKind.EOF
        }
        return .toks.get(i).kind
    }

    // 前瞻文本(n 相对位,越界回 "")——typeinfo/codegen 原重复自由函数
    // p_text_at/p_peek_text 合并入体(γ4:纯 P 操作;P514 W3-14)
    fn peek_text(n int) str {
        var i = .pos + n
        if i >= .toks.len() {
            return ""
        }
        return .toks.get(i).text
    }

    // Parser::next 直译:前进一 token 并跳过注释 token
    fn next() {
        .pos = .pos + 1
        var scanning = true
        for scanning {
            if .pos >= .toks.len() {
                scanning = false
            } else if is_comment_kind(.toks.get(.pos).kind) {
                .pos = .pos + 1
            } else {
                scanning = false
            }
        }
    }

    fn fail(msg str) {
        if .err == "" {
            .err = "PARSE-ERROR:" + .line().str() + ":" + msg + " <" + kind_name(.kind()) + ">"
        }
    }

    fn expect(k TokenKind) {
        if .err != "" {
            return
        }
        if .kind() == k {
            .next()
        } else {
            .fail("expected " + kind_name(k) + ", got ")
        }
    }

    fn skip_empty_lines() int {
        var count = 0
        while .kind() == TokenKind.Newline {
            count = count + 1
            self.next()
        }
        return count
    }

    fn push_scope() {
        var sc List<Binding> = List.new()
        .scopes.push(sc)
        .depth = .depth + 1
    }

    fn pop_scope() {
        .depth = .depth - 1
    }

    fn bind(name str, ty str) {
        if .depth > 0 {
            // 提升+写回:VM 引用语义下 set 写回同一引用(无操作);
            // a2r 值语义下写回修改后的副本(VM/a2r 可观察状态一致)
            var sc = .scopes.get(.depth - 1)
            sc.push(Binding(name, ty))
            .scopes.set(.depth - 1, sc)
        } else {
            .globals.push(Binding(name, ty))
        }
    }

    fn lookup(name str) str {
        var s = .depth - 1
        while s >= 0 {
            var scope List<Binding> = .scopes.get(s)
            var i = scope.len() - 1
            while i >= 0 {
                if scope.get(i).name == name {
                    return scope.get(i).ty
                }
                i = i - 1
            }
            s = s - 1
        }
        var gi = 0
        while gi < .globals.len() {
            if .globals.get(gi).name == name {
                return .globals.get(gi).ty
            }
            gi = gi + 1
        }
        return ""
    }

    // 类型/枚举注册表查询(D38b):name → 声明期 Display 快照
    fn decl_lookup(name str) str {
        var i = 0
        while i < .decls.len() {
            if .decls.get(i).name == name {
                return .decls.get(i).ty
            }
            i = i + 1
        }
        return ""
    }

    fn decl_register(name str, display str) {
        .decls.push(Binding(name, display))
    }
}

// 类型/枚举注册表查询(D38b):name → 声明期 Display 快照
// 表达式结果:dump=S-expr;word=标识符词/方法词/运算符 kind;name=name 的
// 文本或 int/uint 值串或 str/bool 原文(pair key 用);args=call 的
// "(args ...)" 段;ity=构造期推断类型(Display 串,""=Unknown)
pub type E {
    kind str
    word str
    name str
    args str
    dump str
    ity str
}

pub fn parse_new(toks List<Token>) P {
    var scs List<List<Binding>> = List.new()
    var glo List<Binding> = List.new()
    var dcl List<Binding> = List.new()
    var p = P(toks, 0, "", scs, glo, 0, dcl)
    // Parser::from 的 cur 初始化含 skip_comments:起始位置跳过前导注释
    var scanning = true
    for scanning {
        if p.pos >= p.toks.len() {
            scanning = false
        } else if is_comment_kind(p.toks.get(p.pos).kind) {
            p.pos = p.pos + 1
        } else {
            scanning = false
        }
    }
    return p
}

// 447-③9.2:Token.kind 载体已枚举化;p_kind 暂以 kind_name 维持 str 边界
// (P1 步翻转返回 TokenKind 并参数化全部比较位)
// 447-③P1:kind 载体枚举化,返回 TokenKind(错误消息经 kind_name)
// 原始前瞻(不跳注释;与基线 lexer.pushback 前瞻同构,corpus 括号内无注释)
pub fn is_comment_kind(k TokenKind) bool {
    is k {
        TokenKind.DocComment | TokenKind.CommentLine | TokenKind.CommentStart | TokenKind.CommentContent | TokenKind.CommentEnd -> true
        else -> false
    }
}

// Parser::next 直译:前进一 token 并跳过注释 token
// ── 作用域(仅服务 let 无注解时的内联推断,D23) ─────────────────

// ── 数字/浮点值显示(D24) ─────────────────────────────────────

fn digit_val(c int) int {
    if c >= '0' && c <= '9' {
        return c - '0'
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10
    }
    return c - 'A' + 10
}

// parse_int 直译:0x/0b 前缀 + 十进制(下划线 lexer 已剥离)
pub fn int_val(text str) int {
    var base = 10
    var start = 0
    if text.len() >= 2 && text.slice(0, 2) == "0x" {
        base = 16
        start = 2
    } else if text.len() >= 2 && text.slice(0, 2) == "0b" {
        base = 2
        start = 2
    }
    var val = 0
    var i = start
    while i < text.len() {
        val = val * base + digit_val(text.char_at(i))
        i = i + 1
    }
    return val
}

// f32/f64 Display 近似:十进制文本剥分数尾零("1.0"→"1","3.14"→"3.14")
fn float_display(text str) str {
    var dot = -1
    var i = 0
    while i < text.len() {
        if text.char_at(i) == '.' {
            dot = i
        }
        i = i + 1
    }
    if dot < 0 {
        return text
    }
    var int_part = text.slice(0, dot)
    var frac = text.slice(dot + 1, text.len())
    while frac.len() > 0 && frac.char_at(frac.len() - 1) == '0' {
        frac = frac.slice(0, frac.len() - 1)
    }
    if frac.len() == 0 {
        return int_part
    }
    return int_part + "." + frac
}

// ── 类型解析(D23:类型即 Display 串) ──────────────────────────

pub fn builtin_type(name str) str {
    if name == "int" {
        return "int"
    }
    if name == "uint" {
        return "uint"
    }
    if name == "usize" {
        return "usize"
    }
    if name == "i64" {
        return "i64"
    }
    if name == "u64" {
        return "u64"
    }
    if name == "float" {
        return "float"
    }
    if name == "double" {
        return "double"
    }
    if name == "bool" {
        return "bool"
    }
    if name == "char" {
        return "char"
    }
    if name == "str" {
        return "str"
    }
    if name == "String" {
        return "String"
    }
    if name == "byte" {
        return "byte"
    }
    if name == "cstr" {
        return "cstr"
    }
    return ""
}

pub fn is_type_name(mut p P) bool {
    var k = p.kind()
    is k {
        TokenKind.Ident | TokenKind.Question | TokenKind.Not | TokenKind.Tilde | TokenKind.LSquare | TokenKind.Star | TokenKind.At | TokenKind.Fn | TokenKind.Link | TokenKind.Type -> true
        else -> false
    }
}

// parse_type 子集:标量/用户名 + ?T/!T/*T 前后缀;泛型/数组/fn 类型 Missing
pub fn parse_type(mut p P) str {
    if p.err != "" {
        return ""
    }
    var ty = parse_type_base(p)
    while p.kind() == TokenKind.Question {
        p.next()
        ty = f"?${ty}"
    }
    return ty
}

fn parse_type_base(mut p P) str {
    var k = p.kind()
    if k == TokenKind.Question {
        p.next()
        return "?" + parse_type(p)
    }
    if k == TokenKind.Not {
        p.next()
        if is_type_name(p) {
            return "!" + parse_type(p)
        }
        return "!void"
    }
    if k == TokenKind.Star {
        p.next()
        return "*" + parse_type(p)
    }
    if k == TokenKind.Ident {
        var name = p.text()
        var b = builtin_type(name)
        if b == "" {
            // 用户类型(D38b):注册表内联整个声明快照(对齐 Rust
            // Type::User(TypeDecl) 的 Display——已声明 → 完整 decl,
            // 前向引用/未注册 → 空声明 "(type-decl (name X))")
            var snap = p.decl_lookup(name)
            if snap != "" {
                b = snap
            } else {
                b = f"(type-decl (name ${name}))"
            }
        }
        p.next()
        // 泛型实例(Plan 434:AA2R 需解析 lib 自身的 List<T>/Map<K, V>):
        // 基名取裸名(List/Map → Type::List/Map Display 内联参数;未注册
        // 基名 → GenericInstance——Display 亦为裸名,参数侧的 unique_name
        // 差异见 D38a 备注);多参 ", " 连接
        if p.kind() == TokenKind.Lt {
            p.next()
            p.skip_empty_lines()
            var args = ""
            var first = true
            while p.err == "" && p.kind() != TokenKind.EOF && p.kind() != TokenKind.Gt {
                var at = parse_type(p)
                p.skip_empty_lines()
                if !first {
                    args = f"${args}, "
                }
                args = args + at
                first = false
                if p.kind() == TokenKind.Comma {
                    p.next()
                    p.skip_empty_lines()
                } else if p.kind() != TokenKind.Gt {
                    p.fail("expected ',' or '>' in generic args ")
                    return ""
                }
            }
            p.expect(TokenKind.Gt)
            return name + "<" + args + ">"
        }
        return b
    }
    p.fail("expected type, got ")
    return ""
}

// ── Pratt 表直译(parser.rs:28-164) ──────────────────────────

// 运算符枚举(镜像 auto-val value.rs Op 的 lib 子集;447-③P3 杠杆点——
// 六链函数一步收编为 is-on-Op)。NoOp = 非运算符哨兵(镜像 Parser::op 的兜底)
pub enum Op {
    Add
    Sub
    Mul
    Div
    Mod
    AddEq
    SubEq
    MulEq
    DivEq
    ModEq
    Not
    And
    Or
    LSquare
    LParen
    Asn
    Eq
    Neq
    Lt
    Gt
    Le
    Ge
    Range
    RangeEq
    Dot
    Colon
    QuestionQuestion
    NoOp
}

// Parser::op() 直译(parser.rs:2897):TokenKind → Op;非运算符 → NoOp
pub fn p_op(k TokenKind) Op {
    is k {
        TokenKind.Add -> Op.Add
        TokenKind.Sub -> Op.Sub
        TokenKind.Star -> Op.Mul
        TokenKind.Div -> Op.Div
        TokenKind.Mod -> Op.Mod
        TokenKind.AddEq -> Op.AddEq
        TokenKind.SubEq -> Op.SubEq
        TokenKind.MulEq -> Op.MulEq
        TokenKind.DivEq -> Op.DivEq
        TokenKind.ModEq -> Op.ModEq
        TokenKind.LSquare -> Op.LSquare
        TokenKind.LParen -> Op.LParen
        TokenKind.Not -> Op.Not
        TokenKind.Asn -> Op.Asn
        TokenKind.Eq -> Op.Eq
        TokenKind.Neq -> Op.Neq
        TokenKind.Lt -> Op.Lt
        TokenKind.Gt -> Op.Gt
        TokenKind.Le -> Op.Le
        TokenKind.Ge -> Op.Ge
        TokenKind.Range -> Op.Range
        TokenKind.RangeEq -> Op.RangeEq
        TokenKind.Dot -> Op.Dot
        TokenKind.Colon -> Op.Colon
        TokenKind.And -> Op.And
        TokenKind.Or -> Op.Or
        TokenKind.QuestionQuestion -> Op.QuestionQuestion
        else -> Op.NoOp
    }
}

pub fn prefix_power(op Op) int {
    // sign(Add/Sub/Star)=2*13=26;Not=2*14=28
    is op {
        Op.Add | Op.Sub | Op.Mul -> 26
        Op.Not -> 28
        else -> 0
    }
}

fn postfix_power(op Op) int {
    // pair=2*4=8;call=2*15=30;index=2*16=32;bang=2*17=34
    is op {
        Op.Colon -> 8
        Op.LParen -> 30
        Op.LSquare -> 32
        Op.Not -> 34
        else -> 0
    }
}

pub fn infix_l(op Op) int {
    is op {
        Op.Asn -> 1
        Op.AddEq | Op.SubEq -> 3
        Op.MulEq | Op.DivEq | Op.ModEq -> 5
        Op.Or | Op.QuestionQuestion -> 9
        Op.And -> 11
        Op.Eq | Op.Neq -> 13
        Op.Lt | Op.Gt | Op.Le | Op.Ge -> 15
        Op.Range | Op.RangeEq -> 17
        Op.Add | Op.Sub -> 19
        Op.Mul | Op.Div | Op.Mod -> 21
        Op.Dot -> 35
        else -> 0
    }
}

pub fn infix_r(op Op) int {
    is op {
        Op.Asn -> 2
        Op.AddEq | Op.SubEq -> 4
        Op.MulEq | Op.DivEq | Op.ModEq -> 6
        Op.Or | Op.QuestionQuestion -> 10
        Op.And -> 12
        Op.Eq | Op.Neq -> 14
        Op.Lt | Op.Gt | Op.Le | Op.Ge -> 16
        Op.Range | Op.RangeEq -> 18
        Op.Add | Op.Sub -> 20
        Op.Mul | Op.Div | Op.Mod -> 22
        Op.Dot -> 36
        else -> 0
    }
}

pub fn op_display(op Op) str {
    is op {
        Op.Add -> "+"
        Op.Sub -> "-"
        Op.Mul -> "*"
        Op.Div -> "/"
        Op.Mod -> "%"
        Op.AddEq -> "+="
        Op.SubEq -> "-="
        Op.MulEq -> "*="
        Op.DivEq -> "/="
        Op.ModEq -> "%="
        Op.Not -> "!"
        Op.Asn -> "="
        Op.Eq -> "=="
        Op.Neq -> "!="
        Op.Lt -> "<"
        Op.Gt -> ">"
        Op.Le -> "<="
        Op.Ge -> ">="
        Op.Range -> ".."
        Op.RangeEq -> "..="
        Op.Dot -> "."
        Op.Colon -> ":"
        Op.And -> "&&"
        Op.Or -> "||"
        Op.QuestionQuestion -> "??"
        else -> ""
    }
}

// 运算符 token 是否可作 lhs 之后的运算符(infix 或 postfix)
pub fn is_op_kind(k TokenKind) bool {
    return op_display(p_op(k)) != "" || k == TokenKind.LParen || k == TokenKind.LSquare
}

// ── 推断构造期辅助(infer_binop_type/infer_unary_op_type 直译) ─

fn infer_unify(a str, b str) str {
    if a == "" {
        return b
    }
    if b == "" {
        return a
    }
    if a == b {
        return a
    }
    // 基线走 unify_with_coercion;类型不匹配的语料未及,按其错误路径
    // Unknown 传播
    return ""
}

fn binop_result(op Op, l str, r str) str {
    is op {
        Op.Eq | Op.Neq | Op.Lt | Op.Gt | Op.Le | Op.Ge -> "bool"
        Op.Add | Op.Sub | Op.Mul | Op.Div | Op.Mod -> infer_unify(l, r)
        Op.AddEq | Op.SubEq | Op.MulEq | Op.DivEq | Op.ModEq | Op.Asn -> infer_unify(l, r)
        else -> ""
    }
}

// ── 表达式(返回 E;错误短路见 D22) ──────────────────────────

fn bad_e() E {
    return E("bad", "", "", "", "", "")
}

// f-string 解析(447-③ 11.2a;D38c 简化形:FStrStart + FStrPart 整段
// 文本 + FStrEnd,段拆分在此重建——镜像宿主 parser.rs fstr() 的部件
// 序列,dump 对齐 (fstr <part>...):文本段 (str "...")/$Ident (name x)/
// ${expr} 子解析直通 dump)。$Ident 的 .field 链为 D40 校准子集外。
fn fstr_expr(mut p P) E {
    p.next()
    var content = p.text()
    p.next()
    p.next()
    if p.err != "" {
        return bad_e()
    }
    var parts = ""
    var lit = ""
    var i = 0
    var n = content.len()
    while i < n {
        var ch = content.char_at(i)
        if ch == 36 {
            if lit != "" {
                parts = parts + " (str \"" + lit + "\")"
                lit = ""
            }
            if i + 1 < n && content.char_at(i + 1) == 123 {
                // ${expr}:平衡括号定界,子串递归解析直通 dump
                var depth = 1
                var j = i + 2
                while j < n && depth > 0 {
                    var cj = content.char_at(j)
                    if cj == 123 {
                        depth = depth + 1
                    } else if cj == 125 {
                        depth = depth - 1
                    }
                    j = j + 1
                }
                if depth != 0 {
                    p.fail("fstr: unterminated interpolation ")
                    return bad_e()
                }
                var inner = content.slice(i + 2, j - 1)
                var subtoks = tokenize(inner)
                var subp = parse_new(subtoks)
                var sub = expr_pratt(subp, 0)
                if subp.err != "" {
                    p.fail("fstr: bad interpolation ")
                    return bad_e()
                }
                parts = f"${parts} ${sub.dump}"
                i = j
            } else {
                // $Ident
                var j2 = i + 1
                var stop = false
                while j2 < n && !stop {
                    var cj2 = content.char_at(j2)
                    var ok2 = (cj2 >= 97 && cj2 <= 122) || (cj2 >= 65 && cj2 <= 90) || (cj2 >= 48 && cj2 <= 57) || cj2 == 95
                    if !ok2 {
                        stop = true
                    } else {
                        j2 = j2 + 1
                    }
                }
                var nm = content.slice(i + 1, j2)
                if nm == "" {
                    p.fail("fstr: empty interpolation ")
                    return bad_e()
                }
                parts = f"${parts} (name ${nm})"
                i = j2
            }
        } else {
            lit = lit + content.slice(i, i + 1)
            i = i + 1
        }
    }
    if lit != "" {
        parts = parts + " (str \"" + lit + "\")"
    }
    return E("fstr", "", "", "", "(fstr" + parts + ")", "str")
}

fn expr_atom(mut p P) E {
    if p.err != "" {
        return bad_e()
    }
    var k = p.kind()
    if k == TokenKind.LParen {
        // group() 直译
        p.next()
        var inner = expr_pratt(p, 0)
        p.expect(TokenKind.RParen)
        return inner
    }
    if k == TokenKind.Int {
        var v = int_val(p.text()).str()
        p.next()
        return E("int", "", v, "", "(int " + v + ")", "int")
    }
    if k == TokenKind.Uint {
        var v2 = int_val(p.text()).str()
        p.next()
        return E("uint", "", v2, "", "(uint " + v2 + ")", "uint")
    }
    if k == TokenKind.I8 {
        var v3 = int_val(p.text()).str()
        p.next()
        return E("i8", "", v3, "", "(i8 " + v3 + ")", "int")
    }
    if k == TokenKind.U8 {
        var v4 = int_val(p.text()).str()
        p.next()
        return E("u8", "", v4, "", "(u8 " + v4 + ")", "int")
    }
    if k == TokenKind.Float {
        var f1 = float_display(p.text())
        p.next()
        return E("float", "", "", "", "(float " + f1 + ")", "float")
    }
    if k == TokenKind.Double {
        var f2 = float_display(p.text())
        p.next()
        return E("double", "", "", "", "(double " + f2 + ")", "double")
    }
    if k == TokenKind.True {
        p.next()
        return E("bool", "", "true", "", "(true)", "bool")
    }
    if k == TokenKind.False {
        p.next()
        return E("bool", "", "false", "", "(false)", "bool")
    }
    if k == TokenKind.Char {
        var c = p.text()
        p.next()
        return E("char", "", c, "", "(char '" + c + "')", "char")
    }
    if k == TokenKind.Str {
        var s = p.text()
        p.next()
        return E("str", "", s, "", "(str \"" + s + "\")", "str")
    }
    if k == TokenKind.Ident {
        var n = p.text()
        p.next()
        // W1 构造字面量:已注册类型名紧随 {(镜像宿主 atom 的
        // accepts_as_type_construction——scope 命中类型才拦截);
        // 否则回落原标识符路径({ 留给语句层,行为不变)
        if p.kind() == TokenKind.LBrace && p.decl_lookup(n) != "" {
            return ctor_node(p, n)
        }
        return E("name", n, n, "", "(name " + n + ")", p.lookup(n))
    }
    if is_soft_ident_kind(k) {
        // soft-ident(Plan 356 镜像):表达式位按标识符消费
        var n2 = p.text()
        p.next()
        if p.kind() == TokenKind.LBrace && p.decl_lookup(n2) != "" {
            return ctor_node(p, n2)
        }
        return E("name", n2, n2, "", "(name " + n2 + ")", p.lookup(n2))
    }
    if k == TokenKind.Nil {
        p.next()
        return E("nil", "", "", "", "(nil)", "")
    }
    if k == TokenKind.Null {
        p.next()
        return E("null", "", "", "", "(null)", "")
    }
    if k == TokenKind.Is {
        // 表达式位 is(Plan 447 部分②):参考 Expr::Is 的 Display 只出目标
        // "(is-expr target)",分支解析后弃置(quirk 照抄,D18)
        p.next()
        var t = expr_pratt(p, 0)
        p.expect(TokenKind.LBrace)
        p.skip_empty_lines()
        while p.err == "" && p.kind() != TokenKind.RBrace && p.kind() != TokenKind.EOF {
            var discard = parse_is_branch(p)
            if p.kind() == TokenKind.Comma {
                p.next()
                p.skip_empty_lines()
            }
        }
        p.expect(TokenKind.RBrace)
        return E("other", "", "", "", "(is-expr " + t.dump + ")", "")
    }
    p.fail("expected term, got ")
    return bad_e()
}

// args() 直译:Pos/Name 显示相同(D22 备注),统一按 Display 输出
pub fn parse_args(mut p P) str {
    p.expect(TokenKind.LParen)
    p.skip_empty_lines()
    var out = "(args"
    while p.err == "" && p.kind() != TokenKind.EOF && p.kind() != TokenKind.RParen {
        var a = expr_pratt(p, 0)
        if a.kind == "pair" {
            p.fail("v2 unsupported: named call arg ")
            return ""
        }
        out = f"${out} ${a.dump}"
        // sep_args
        var k = p.kind()
        if k == TokenKind.Comma || k == TokenKind.Newline {
            p.next()
            p.skip_empty_lines()
        } else if k != TokenKind.RParen {
            p.fail("expected argument separator, got ")
            return ""
        }
    }
    p.expect(TokenKind.RParen)
    return out + ")"
}

// array() 直译(fmt_array:空数组 "(array )")
fn parse_array(mut p P) E {
    p.expect(TokenKind.LSquare)
    p.skip_empty_lines()
    var elems List<str> = List.new()
    var first_ity = ""
    while p.err == "" && p.kind() != TokenKind.EOF && p.kind() != TokenKind.RSquare {
        var e = expr_pratt(p, 0)
        if elems.len() == 0 {
            first_ity = e.ity
        }
        elems.push(e.dump)
        // sep_array
        var has_sep = false
        while p.kind() == TokenKind.Comma || p.kind() == TokenKind.Newline {
            has_sep = true
            p.next()
        }
        if p.kind() != TokenKind.RSquare && !has_sep {
            p.fail("expected array separator, got ")
        }
    }
    p.expect(TokenKind.RSquare)
    var dump = "(array "
    var i = 0
    while i < elems.len() {
        if i > 0 {
            dump = f"${dump} "
        }
        dump = dump + elems.get(i)
        i = i + 1
    }
    var ity = ""
    if elems.len() > 0 {
        ity = "(array-type (elem " + first_ity + ") (len " + elems.len().str() + "))"
    }
    return E("array", "", "", "", dump + ")", ity)
}

// key() 直译:返回 key 的 Display 形式
fn parse_key(mut p P) str {
    var k = p.kind()
    if k == TokenKind.Ident || k == TokenKind.Type || k == TokenKind.Tag || k == TokenKind.Task {
        var n = p.text()
        p.next()
        return "(name " + n + ")"
    }
    if k == TokenKind.Int {
        var v = int_val(p.text()).str()
        p.next()
        return v
    }
    if k == TokenKind.True {
        p.next()
        return "true"
    }
    if k == TokenKind.False {
        p.next()
        return "false"
    }
    if k == TokenKind.Str {
        var s = p.text()
        p.next()
        return "\"" + s + "\""
    }
    p.fail("expected key, got ")
    return ""
}

// object() 直译
fn parse_object(mut p P) E {
    p.expect(TokenKind.LBrace)
    p.skip_empty_lines()
    var dump = "(object "
    var i = 0
    while p.err == "" && p.kind() != TokenKind.EOF && p.kind() != TokenKind.RBrace {
        if i > 0 {
            dump = f"${dump} "
        }
        var key = parse_key(p)
        p.expect(TokenKind.Colon)
        var val = expr_pratt(p, 0)
        dump = f"${dump}(pair ${key} ${val.dump})"
        i = i + 1
        // sep_obj
        var k = p.kind()
        if k == TokenKind.Comma || k == TokenKind.Newline {
            p.next()
            p.skip_empty_lines()
        } else if k != TokenKind.RBrace {
            p.fail("expected pair separator, got ")
        }
    }
    p.expect(TokenKind.RBrace)
    return E("object", "", "", "", dump + ")", "")
}

// W1 构造字面量 X { a: e1, b: e2 }:宿主 Expr::Node 形态,Pair 落 node 的
// body 段(parse_node_body → Stmt::Expr(Pair)),Display 对齐 ast/node.rs:
// (node (name X) (body (pair (name a) e1) (pair (name b) e2)))
// 键限 NamedKey(宿主 parse_braced_struct_args 只转 NamedKey→Pair);
// ity 空 = Unknown(镜像宿主 infer Node→Unknown)
fn ctor_node(mut p P, name str) E {
    p.expect(TokenKind.LBrace)
    p.skip_empty_lines()
    var body = "(body"
    var n = 0
    while p.err == "" && p.kind() != TokenKind.EOF && p.kind() != TokenKind.RBrace {
        var k = p.kind()
        if k != TokenKind.Ident && k != TokenKind.Type && k != TokenKind.Tag && k != TokenKind.Task {
            p.fail("expected field name in struct ctor, got ")
            return bad_e()
        }
        var key = "(name " + p.text() + ")"
        p.next()
        p.expect(TokenKind.Colon)
        var val = expr_pratt(p, 0)
        body = f"${body} (pair ${key} ${val.dump})"
        n = n + 1
        // sep_obj:逗号/换行
        var sk = p.kind()
        if sk == TokenKind.Comma || sk == TokenKind.Newline {
            p.next()
            p.skip_empty_lines()
        } else if sk != TokenKind.RBrace {
            p.fail("expected pair separator, got ")
        }
    }
    p.expect(TokenKind.RBrace)
    var dump = f"(node (name ${name})"
    if n > 0 {
        dump = f"${dump} ${body}))"
    } else {
        dump = f"${dump})"
    }
    return E("node", name, name, body, dump, "")
}

fn join_dump_list(parts List<str>, sep str) str {
    var out = ""
    var i = 0
    while i < parts.len() {
        if i > 0 {
            out = out + sep
        }
        out = out + parts.get(i)
        i = i + 1
    }
    return out
}

// 元组解析(( 已在 cur):elems 经 expr_pratt(0),ity 为元素 ity 的 ", " 连接
fn tuple_rest(mut p P, first E) E {
    var dumps List<str> = List.new()
    var itys List<str> = List.new()
    dumps.push(first.dump)
    itys.push(first.ity)
    while p.kind() == TokenKind.Comma {
        p.next()
        var e = expr_pratt(p, 0)
        dumps.push(e.dump)
        itys.push(e.ity)
    }
    p.expect(TokenKind.RParen)
    return E("tuple", "", "", "", "(tuple " + join_dump_list(dumps, " ") + ")", "(" + join_dump_list(itys, ", ") + ")")
}

// LParen 前缀的 group/tuple/closure 判定(expr_pratt_inner LParen 臂直译)
fn paren_prefix(mut p P) E {
    var k1 = p.peek(1)
    if k1 == TokenKind.RParen {
        var k2 = p.peek(2)
        if k2 == TokenKind.DoubleArrow {
            p.fail("v2 unsupported: zero-param closure ")
            return bad_e()
        }
        // () 单元 → 空元组(fmt_tuple 空形态)
        p.next()
        p.next()
        return E("tuple", "", "", "", "(tuple )", "()")
    }
    if k1 == TokenKind.Ident {
        // 前瞻扫描闭包/元组判定:depth 追踪 + 闭括号后 => 前瞻
        var found_comma = false
        var found_arrow = false
        var depth = 1
        var i = p.pos + 1
        var scanning = true
        while scanning && i < p.toks.len() {
            var tk = p.toks.get(i).kind
            if tk == TokenKind.LParen || tk == TokenKind.LSquare || tk == TokenKind.LBrace {
                depth = depth + 1
            } else if tk == TokenKind.RParen || tk == TokenKind.RSquare || tk == TokenKind.RBrace {
                depth = depth - 1
                if depth == 0 {
                    if i + 1 < p.toks.len() && p.toks.get(i + 1).kind == TokenKind.DoubleArrow {
                        found_arrow = true
                    }
                    scanning = false
                }
            } else if tk == TokenKind.Comma && depth == 1 {
                found_comma = true
            } else if tk == TokenKind.EOF {
                scanning = false
            }
            i = i + 1
        }
        if found_arrow {
            p.fail("v2 unsupported: multi-param closure ")
            return bad_e()
        }
        if found_comma {
            // 元组:消费 (,首元素后按逗号续
            p.next()
            var first = expr_pratt(p, 0)
            return tuple_rest(p, first)
        }
        // 普通 group
        p.next()
        var inner = expr_pratt(p, 0)
        p.expect(TokenKind.RParen)
        return inner
    }
    // 非标识符起始:group 或元组
    p.next()
    var first2 = expr_pratt(p, 0)
    if p.kind() == TokenKind.Comma {
        return tuple_rest(p, first2)
    }
    p.expect(TokenKind.RParen)
    return first2
}

// expr_pratt_inner 直译:前缀分发 + with_left 循环
pub fn expr_pratt(mut p P, min int) E {
    if p.err != "" {
        return bad_e()
    }
    var k = p.kind()
    var lhs = bad_e()
    // A2:主分派 is 化(镜像 Rust expr_pratt 的 match kind 链)
    is k {
        TokenKind.If -> {
            // if 表达式:复用 if 解析(Display 同 If)
            var d = if_contents(p)
            lhs = E("other", "", "", "", d, "")
        }
        TokenKind.Add | TokenKind.Sub | TokenKind.Not | TokenKind.Star -> {
            var pow = prefix_power(p_op(k))
            p.next()
            var operand = expr_pratt(p, pow)
            var ity = ""
            if k == TokenKind.Not {
                ity = "bool"
            } else {
                ity = operand.ity
            }
            lhs = E("una", k, "", "", "(una (op " + op_display(p_op(k)) + ") " + operand.dump + ")", ity)
        }
        TokenKind.LParen -> {
            lhs = paren_prefix(p)
        }
        TokenKind.LSquare -> {
            lhs = parse_array(p)
        }
        TokenKind.LBrace -> {
            lhs = parse_object(p)
        }
        TokenKind.FStrStart -> {
            lhs = fstr_expr(p)
        }
        TokenKind.Dot -> {
            // W2(525):接收者简写 .field/.method——宿主 dot_item:前导点
            // 表达式 = Dot(Ident self, name)(parser.rs 2231;方法体内隐式
            // self)。链式后续跳走既有 postfix Dot 臂
            p.next()
            if !is_name_kind(p.kind()) {
                p.fail("expected field name after '.', got ")
                return bad_e()
            }
            var fld0 = p.text()
            p.next()
            lhs = E("dot", fld0, "", "", "(dot (name self)." + fld0 + ")", "")
        }
        else -> {
            lhs = expr_atom(p)
        }
    }
    return expr_with_left(p, lhs, min)
}

// expr_pratt_with_left_inner 直译
fn expr_with_left(mut p P, lhs E, min int) E {
    if p.err != "" {
        return lhs
    }
    // 单参闭包 x => e:Missing
    if lhs.kind == "name" && p.kind() == TokenKind.DoubleArrow {
        p.fail("v2 unsupported: single-param closure ")
        return lhs
    }
    var cur = lhs
    while p.err == "" {
        var k = p.kind()
        // P2:循环顶 token 分派(镜像 Rust parser.rs:2425 的 match kind:
        // 11 种界符 break;其余走算符链)
        is k {
            TokenKind.EOF | TokenKind.Newline | TokenKind.Semi | TokenKind.LBrace | TokenKind.RBrace | TokenKind.Comma | TokenKind.Arrow | TokenKind.DoubleArrow | TokenKind.VBar | TokenKind.RSquare | TokenKind.RParen -> {
                break
            }
            else -> {
                if !is_op_kind(k) {
                    p.fail("expected infix operator, got ")
                    break
                }
                var op = p_op(k)
                var post = postfix_power(op)
                if post > 0 {
                    if post < min {
                        break
                    }
                    if op == Op.LSquare {
                        // 下标(切片形态 Missing)
                        p.next()
                        var idx = expr_pratt(p, 18)
                        p.expect(TokenKind.RSquare)
                        cur = E("index", "", "", "", "(index " + cur.dump + " " + idx.dump + ")", "")
                    } else if op == Op.LParen {
                        // 调用:fmt_call —— args 非空才带 args 段;调用 ity=Unknown
                        var args = parse_args(p)
                        var word = ""
                        if cur.kind == "name" {
                            word = cur.word
                        }
                        var d = f"(call ${cur.dump}"
                        if args != "(args)" {
                            d = f"${d} ${args}"
                        }
                        cur = E("call", word, cur.dump, args, d + ")", "")
                    } else if op == Op.Colon {
                        // pair:key 由 lhs 形态决定;直接返回(不回循环)
                        p.next()
                        var key = ""
                        if cur.kind == "name" {
                            key = f"(name ${cur.word})"
                        } else if cur.kind == "int" || cur.kind == "uint" || cur.kind == "bool" {
                            key = cur.name
                        } else if cur.kind == "str" {
                            key = "\"" + cur.name + "\""
                        } else {
                            p.fail("invalid pair key ")
                            break
                        }
                        var val = expr_pratt(p, 0)
                        return E("pair", "", "", "", "(pair " + key + " " + val.dump + ")", "")
                    } else {
                        // Not 后缀(collect!):Missing
                        p.fail("v2 unsupported: postfix bang ")
                        break
                    }
                } else {
                    var l = infix_l(op)
                    if l == 0 || l < min {
                        break
                    }
                    p.next()
                    // || / && 换行续接
                    if op == Op.Or || op == Op.And {
                        p.skip_empty_lines()
                    }
                    var rhs = expr_pratt(p, infix_r(op))
                    if op == Op.Range {
                        cur = E("range", "", "", "", "(range (start " + cur.dump + ") (end " + rhs.dump + ") (eq false))", "")
                    } else if op == Op.RangeEq {
                        cur = E("range", "", "", "", "(range (start " + cur.dump + ") (end " + rhs.dump + ") (eq true))", "")
                    } else if op == Op.Dot {
                        if rhs.kind == "name" {
                            cur = E("dot", rhs.word, "", "", "(dot " + cur.dump + "." + rhs.word + ")", "")
                        } else if rhs.kind == "int" || rhs.kind == "uint" {
                            cur = E("dot", rhs.name, "", "", "(dot " + cur.dump + "." + rhs.name + ")", "")
                        } else if rhs.kind == "call" {
                            // 方法调用重写:Call(name=Dot(obj,method))
                            var d2 = f"(call (dot ${cur.dump}.${rhs.word})"
                            if rhs.args != "(args)" {
                                d2 = f"${d2} ${rhs.args}"
                            }
                            cur = E("call", rhs.word, "(dot " + cur.dump + "." + rhs.word + ")", rhs.args, d2 + ")", "")
                        } else {
                            p.fail("invalid field name after dot ")
                            break
                        }
                    } else if op == Op.QuestionQuestion {
                        cur = E("other", "", "", "", "(?? " + cur.dump + " " + rhs.dump + ")", "")
                    } else {
                        cur = E("bina", op, "", "", "(bina " + cur.dump + " (op " + op_display(op) + ") " + rhs.dump + ")", binop_result(op, cur.ity, rhs.ity))
                    }
                }
            }
        }
    }
    return cur
}

// ── 语句 ──────────────────────────────────────────────────────

fn store_kw_name(kw TokenKind) str {
    if kw == TokenKind.Var {
        return "var"
    }
    if kw == TokenKind.Const {
        return "const"
    }
    if kw == TokenKind.Shared {
        return "shared"
    }
    return "let"
}

fn parse_store(mut p P, kw TokenKind) str {
    p.next()
    // 元组解构 let (a, b) = expr:基础实现
    if p.kind() == TokenKind.LParen {
        p.next()
        var names = ""
        if p.kind() != TokenKind.RParen {
            names = p.text()
            p.next()
            while p.kind() == TokenKind.Comma {
                p.next()
                names = f"${names} ${p.text()}"
                p.next()
            }
        }
        p.expect(TokenKind.RParen)
        p.expect(TokenKind.Asn)
        var de = expr_pratt(p, 0)
        return "(destr (" + names + ") " + de.dump + ")"
    }
    var name = p.text()
    p.next()
    var ty = ""
    if is_type_name(p) {
        ty = parse_type(p)
    }
    var init = E("nil", "", "", "", "(nil)", "")
    if p.kind() == TokenKind.Asn {
        p.next()
        init = expr_pratt(p, 0)
        if ty == "" {
            ty = init.ity
        }
    } else if ty == "" {
        p.fail("store must have type annotation or initializer: " + name)
        return ""
    }
    p.bind(name, ty)
    if kw == TokenKind.Var {
        return "(var (name " + name + ") " + init.dump + ")"
    }
    if ty == "" {
        return "(" + store_kw_name(kw) + " (name " + name + ") " + init.dump + ")"
    }
    return "(" + store_kw_name(kw) + " (name " + name + ") (type " + ty + ") " + init.dump + ")"
}

fn parse_fn_params(mut p P) str {
    var out = ""
    var count = 0
    p.skip_empty_lines()
    var running = true
    while running && p.err == "" {
        var mode = "view"
        var k = p.kind()
        if k == TokenKind.View {
            p.next()
        } else if k == TokenKind.Mut {
            mode = "mut"
            p.next()
        } else if k == TokenKind.Move {
            mode = "move"
            p.next()
        } else if k == TokenKind.Take {
            mode = "move"
            p.next()
        } else if k == TokenKind.Copy {
            mode = "move"
            p.next()
        }
        if p.kind() != TokenKind.Ident {
            if mode != "view" {
                p.fail("expected parameter name after mode ")
            }
            running = false
        } else {
            var pname = p.text()
            p.next()
            var ty = "int"
            if p.kind() == TokenKind.Colon {
                p.next()
            }
            if is_type_name(p) {
                ty = parse_type(p)
            }
            var pdump = f"(param (name ${pname}) (type ${ty}) (mode ${mode})"
            if p.kind() == TokenKind.Asn {
                p.next()
                var def = expr_pratt(p, 0)
                pdump = f"${pdump} (default ${def.dump})"
            }
            pdump = f"${pdump})"
            if count > 0 {
                out = f"${out} "
            }
            out = out + pdump
            count = count + 1
            p.bind(pname, ty)
            if p.kind() == TokenKind.Comma {
                p.next()
            } else {
                running = false
            }
        }
    }
    return out
}

fn parse_fn(mut p P) str {
    p.next()
    if p.kind() == TokenKind.Dot {
        p.fail("v2 unsupported: fn.c/fn.vm ")
        return ""
    }
    if !is_name_kind(p.kind()) {
        p.fail("expected fn name, got ")
        return ""
    }
    var name = p.text()
    p.next()
    if p.kind() == TokenKind.Dot {
        p.fail("v2 unsupported: dotted fn name ")
        return ""
    }
    if p.kind() == TokenKind.Lt {
        p.fail("v2 unsupported: fn generic params ")
        return ""
    }
    p.push_scope()
    p.expect(TokenKind.LParen)
    var params = parse_fn_params(p)
    p.expect(TokenKind.RParen)
    var ret = ""
    if p.kind() == TokenKind.Arrow {
        p.next()
        ret = parse_type(p)
        p.skip_empty_lines()
    } else if is_type_name(p) {
        ret = parse_type(p)
        p.skip_empty_lines()
    } else if p.kind() == TokenKind.LBrace || p.kind() == TokenKind.Semi {
        ret = "void"
    }
    var body = "(body )"
    if p.kind() == TokenKind.Semi {
        p.next()
    } else {
        body = parse_body(p)
    }
    var out = f"(fn (name ${name})"
    if params != "" {
        out = f"${out} (params ${params})"
    }
    if ret != "" {
        out = f"${out} (ret ${ret})"
    }
    p.pop_scope()
    return out + " " + body + ")"
}

fn if_contents(mut p P) str {
    p.next()
    if p.kind() == TokenKind.Let {
        p.fail("v2 unsupported: if-let ")
        return ""
    }
    var out = "(if "
    var cond = expr_pratt(p, 0)
    var body = parse_body(p)
    out = f"${out}(branch ${cond.dump} ${body})"
    while p.kind() == TokenKind.Else {
        p.next()
        if p.kind() == TokenKind.If {
            p.next()
            if p.kind() == TokenKind.Let {
                p.fail("v2 unsupported: else-if-let ")
                return ""
            }
            var c2 = expr_pratt(p, 0)
            var b2 = parse_body(p)
            out = f"${out}(branch ${c2.dump} ${b2})"
        } else {
            var eb = parse_body(p)
            out = f"${out} (else ${eb})"
            break
        }
    }
    return out + ")"
}

fn parse_for(mut p P) str {
    p.next()
    if p.kind() == TokenKind.LBrace {
        var b0 = parse_body(p)
        return "(for (ever) (nil) " + b0 + ")"
    }
    if p.kind() == TokenKind.Let || p.kind() == TokenKind.Var {
        // for let x = 0; cond { }:init 不入 For Display
        parse_store(p, TokenKind.Let)
        p.expect(TokenKind.Semi)
        var c0 = expr_pratt(p, 0)
        var b1 = parse_body(p)
        return "(for (cond) " + c0.dump + " " + b1 + ")"
    }
    if p.kind() == TokenKind.Mut {
        p.fail("'mut' is not supported as a storage modifier ")
        return ""
    }
    if p.kind() == TokenKind.LParen {
        // 解构 for (k, v) in expr:基础实现
        p.next()
        var kn = p.text()
        p.next()
        p.expect(TokenKind.Comma)
        var vn = p.text()
        p.next()
        p.expect(TokenKind.RParen)
        p.expect(TokenKind.In)
        p.push_scope()
        p.bind(kn, "int")
        p.bind(vn, "int")
        var r1 = expr_pratt(p, 0)
        var b2 = parse_body(p)
        p.pop_scope()
        return "(for ((name " + kn + ") (name " + vn + ")) " + r1.dump + " " + b2 + ")"
    }
    if p.kind() == TokenKind.Ident {
        var name = p.text()
        p.next()
        if p.kind() == TokenKind.In {
            p.next()
            p.push_scope()
            p.bind(name, "int")
            var range = expr_pratt(p, 0)
            var body = parse_body(p)
            p.pop_scope()
            return "(for (name " + name + ") " + range.dump + " " + body + ")"
        }
        if p.kind() == TokenKind.Comma {
            p.next()
            var name2 = p.text()
            p.next()
            p.expect(TokenKind.In)
            p.push_scope()
            p.bind(name2, "int")
            var range2 = expr_pratt(p, 0)
            var body2 = parse_body(p)
            p.pop_scope()
            return "(for ((name " + name + ") (name " + name2 + ")) " + range2.dump + " " + body2 + ")"
        }
        if p.kind() == TokenKind.LParen {
            // for call(args) { } 条件循环
            var args = parse_args(p)
            var calle = E("call", name, "(name " + name + ")", args, "(call (name " + name + ") " + args + ")", "")
            if p.kind() == TokenKind.Question {
                p.fail("v2 unsupported: for-iterator call ")
                return ""
            }
            var cond = expr_with_left(p, calle, 0)
            var b3 = parse_body(p)
            return "(for (cond) " + cond.dump + " " + b3 + ")"
        }
        // for i < max { } / 一般条件式:以 Ident 为 lhs 续解析
        var idente = E("name", name, name, "", "(name " + name + ")", p.lookup(name))
        var cond2 = expr_with_left(p, idente, 0)
        var b4 = parse_body(p)
        return "(for (cond) " + cond2.dump + " " + b4 + ")"
    }
    var cond3 = expr_pratt(p, 0)
    var b5 = parse_body(p)
    return "(for (cond) " + cond3.dump + " " + b5 + ")"
}

fn parse_while(mut p P) str {
    p.next()
    var had_paren = false
    if p.kind() == TokenKind.LParen {
        p.next()
        had_paren = true
    }
    p.skip_empty_lines()
    var cond = expr_pratt(p, 0)
    if had_paren {
        p.expect(TokenKind.RParen)
    }
    var body = parse_body(p)
    return "(for (cond) " + cond.dump + " " + body + ")"
}

fn parse_return(mut p P) str {
    p.next()
    var k = p.kind()
    if k == TokenKind.Newline || k == TokenKind.Semi || k == TokenKind.RBrace || k == TokenKind.EOF {
        return "(return (nil))"
    }
    var e = expr_pratt(p, 0)
    return "(return " + e.dump + ")"
}

// 可作名字的 token(对齐 parse_name 盲取文本;结构性分隔符除外——
// 成员/变体名可为关键字,如 UI 方言的 grid)
pub fn is_name_kind(k TokenKind) bool {
    is k {
        TokenKind.EOF | TokenKind.RBrace | TokenKind.Newline | TokenKind.Semi | TokenKind.Comma | TokenKind.Colon | TokenKind.Asn | TokenKind.LParen | TokenKind.LBrace | TokenKind.LSquare | TokenKind.RParen | TokenKind.RSquare | TokenKind.Arrow | TokenKind.Dot | TokenKind.Lt | TokenKind.Gt -> false
        else -> true
    }
}

// 宿主 soft-ident 面(parser.rs:663 Plan 356):词法保留但表达式位合法
// 作标识符的关键字(`o.tag` 的点右值位等);aavm 镜像同名集合
pub fn is_soft_ident_kind(k TokenKind) bool {
    is k {
        TokenKind.Tag | TokenKind.Type | TokenKind.Union | TokenKind.Spec | TokenKind.Super | TokenKind.Has | TokenKind.Copy | TokenKind.Move | TokenKind.Take | TokenKind.Hold | TokenKind.Alias | TokenKind.Ext | TokenKind.Impl | TokenKind.Mod | TokenKind.Enum -> true
        else -> false
    }
}

// W3(Plan 511)use 语句:四形态 Display 对齐 ast/use_.rs——
// `use db` → (use (module_path db));`use db: a, b` → +(items a,b);
// `use db: *` → +(wildcard);点路径 tools.helper 原样;异构 use.rs/py →
// (use (kind rust|py) (path foo.Bar))。注:Auto use 的 {} 花括号形态经
// `::` 不可达(宿主 :: 双冒号被 items-colon 消费后报错,W0 实测),
// parse_use_items 的 LBrace 臂仅服务 use.rs 路径形态。
fn parse_use(mut p P) str {
    p.next()
    // 异构形态:use.rs / use.py(use 已消费,cur 为 Dot)
    if p.kind() == TokenKind.Dot {
        var lang = p.peek_text(1)
        p.next()
        p.next()
        if lang != "rs" && lang != "py" && lang != "c" {
            p.fail("expected language after use., got ")
            return ""
        }
        var kind = "rust"
        if lang == "py" {
            kind = "py"
        } else if lang == "c" {
            kind = "c"
        }
        // 路径段::: 分隔(词法为两个 Colon),Display 以 . 连接
        var path = p.text()
        p.next()
        while p.kind() == TokenKind.Colon && p.peek(1) == TokenKind.Colon {
            p.next()
            p.next()
            path = path + "." + p.text()
            p.next()
        }
        return "(use (kind " + kind + ") (path " + path + "))"
    }
    if !is_name_kind(p.kind()) {
        p.fail("expected module name after use, got ")
        return ""
    }
    var name = p.text()
    p.next()
    while p.kind() == TokenKind.Dot {
        p.next()
        if !is_name_kind(p.kind()) {
            p.fail("expected path segment after dot, got ")
            return ""
        }
        name = name + "." + p.text()
        p.next()
    }
    var items = ""
    var wildcard = false
    if p.kind() == TokenKind.Colon {
        p.next()
        if p.kind() == TokenKind.Star {
            p.next()
            wildcard = true
        } else {
            if !is_name_kind(p.kind()) {
                p.fail("expected identifier or *, got ")
                return ""
            }
            items = p.text()
            p.next()
            while p.kind() == TokenKind.Comma {
                p.next()
                if !is_name_kind(p.kind()) {
                    p.fail("expected identifier, got ")
                    return ""
                }
                items = items + "," + p.text()
                p.next()
            }
        }
    }
    var out = "(use (module_path " + name + ")"
    if items != "" {
        out = out + " (items " + items + ")"
    }
    if wildcard {
        out = out + " (wildcard)"
    }
    return out + ")"
}

// type 声明(Plan 434:AA2R 转译 lib 自身需要)。Display 对齐 ast/types.rs
// 的 TypeDecl:仅 members 路径;泛型参数/别名/is/as/has/方法体/字段默认值
// 遇之报 v2 unsupported(lib 未用,golden 02 组部分留后续)
pub fn parse_type_decl(mut p P) str {
    p.next()
    if !is_name_kind(p.kind()) {
        p.fail("expected type name, got ")
        return ""
    }
    var name = p.text()
    p.next()
    if p.kind() == TokenKind.Lt {
        p.fail("v2 unsupported: type generic params ")
        return ""
    }
    if p.kind() == TokenKind.Asn {
        p.fail("v2 unsupported: type alias ")
        return ""
    }
    if p.kind() == TokenKind.Is {
        p.fail("v2 unsupported: type inheritance ")
        return ""
    }
    if p.kind() == TokenKind.As {
        p.fail("v2 unsupported: type as ")
        return ""
    }
    if p.kind() == TokenKind.Has {
        p.fail("v2 unsupported: type has ")
        return ""
    }
    // W2(525):预注册占位——体内方法先于尾态快照解析,自引用 ctor
    // (`return Point { .. }`)的 decl_lookup 需类型名已入表(宿主
    // scope 先注册后走体);decl_lookup 首中扫描,故尾态按登记位原地
    // 覆写为完整快照(占位不残留)
    var reg_idx = p.decls.len()
    p.decl_register(name, f"(type-decl (name ${name}))")
    p.expect(TokenKind.LBrace)
    p.skip_empty_lines()
    var members = ""
    var methods = ""
    while p.err == "" && p.kind() != TokenKind.EOF && p.kind() != TokenKind.RBrace {
        if p.kind() == TokenKind.Fn || p.kind() == TokenKind.Static {
            // W2(525):体内方法——(methods (fn ...) ...) 镜像宿主 TypeDecl
            // Display(types.rs 745);static 标记不进 Display(宿主 Fn
            // Display 无 static 位);方法 Fn 复用 parse_fn(name/params/
            // ret/body 同形态)
            if p.kind() == TokenKind.Static {
                p.next()
            }
            var m = parse_fn(p)
            if p.err != "" {
                return ""
            }
            if methods != "" {
                methods = f"${methods} "
            }
            methods = methods + m
            expect_eos(p)
            p.skip_empty_lines()
            continue
        }
        if p.kind() == TokenKind.Hash {
            p.fail("v2 unsupported: member attr ")
            return ""
        }
        if !is_name_kind(p.kind()) {
            p.fail("expected member name, got ")
            return ""
        }
        var fname = p.text()
        p.next()
        if p.kind() == TokenKind.Colon {
            p.next()
        }
        var fty = parse_type(p)
        if p.kind() == TokenKind.Asn {
            p.fail("v2 unsupported: member default value ")
            return ""
        }
        if members != "" {
            members = f"${members} "
        }
        members = f"${members}(member (name ${fname}) (type ${fty}))"
        // 成员间空行:Display 无 nl 载体,基线亦忽略——静默跳过
        expect_eos(p)
        p.skip_empty_lines()
    }
    p.expect(TokenKind.RBrace)
    var out = f"(type-decl (name ${name})"
    if members != "" {
        out = f"${out} (members ${members})"
    }
    if methods != "" {
        out = f"${out} (methods ${methods})"
    }
    out = f"${out})"
    // W2(525):尾态完整快照覆写预注册占位(原地,首中查找即中)
    p.decls.set(reg_idx, Binding(name, out))
    return out
}

// W2(525):ext 块——宿主 parser 级并入 TypeDecl.methods(parser.rs 1745
// 合并:同名方法覆盖;字段/常量面超 v2 裁剪)。dump 侧返回 (ext-merge
// TYPE M1 M2) 占位,由 parse_program 终态并入对应 type-decl 行(宿主
// 终 AST 无独立 Ext 语句)
pub fn parse_ext(mut p P) str {
    p.next()
    if !is_name_kind(p.kind()) {
        p.fail("expected type name after ext, got ")
        return ""
    }
    var ty = p.text()
    p.next()
    if p.kind() == TokenKind.Lt {
        p.fail("v2 unsupported: ext generic target ")
        return ""
    }
    if p.kind() == TokenKind.For {
        p.fail("v2 unsupported: ext for trait ")
        return ""
    }
    p.expect(TokenKind.LBrace)
    p.skip_empty_lines()
    var methods = ""
    while p.err == "" && p.kind() != TokenKind.EOF && p.kind() != TokenKind.RBrace {
        if p.kind() == TokenKind.Fn || p.kind() == TokenKind.Static {
            if p.kind() == TokenKind.Static {
                p.next()
            }
            var m = parse_fn(p)
            if p.err != "" {
                return ""
            }
            if methods != "" {
                methods = f"${methods} "
            }
            methods = methods + m
            expect_eos(p)
            p.skip_empty_lines()
            continue
        }
        p.fail("v2 unsupported: ext member ")
        return ""
    }
    p.expect(TokenKind.RBrace)
    return "(ext-merge " + ty + " " + methods + ")"
}

// enum 声明(Plan 434)。Display 对齐 ast/enums.rs 的 EnumDecl:
// (enum (name X) (item (name A) (value 0)) ...);首项 value 0、显式 = N 后
// last_val=N+1(基线 gap-fill);payload/方法/变体属性遇之报 unsupported
pub fn parse_enum_decl(mut p P) str {
    p.next()
    if !is_name_kind(p.kind()) {
        p.fail("expected enum name, got ")
        return ""
    }
    var name = p.text()
    p.next()
    if p.kind() == TokenKind.Lt {
        p.fail("v2 unsupported: enum generic params ")
        return ""
    }
    if p.kind() == TokenKind.Ident || p.kind() == TokenKind.Type {
        p.fail("v2 unsupported: enum repr type ")
        return ""
    }
    p.expect(TokenKind.LBrace)
    p.skip_empty_lines()
    var out = f"(enum (name ${name}) "
    var next_val = 0
    var first = true
    var any_payload = false
    while p.err == "" && p.kind() != TokenKind.EOF && p.kind() != TokenKind.RBrace {
        if p.kind() == TokenKind.Fn || p.kind() == TokenKind.Static {
            p.fail("v2 unsupported: method in enum ")
            return ""
        }
        if p.kind() == TokenKind.Hash {
            p.fail("v2 unsupported: enum variant attr ")
            return ""
        }
        if !is_name_kind(p.kind()) {
            p.fail("expected variant name, got ")
            return ""
        }
        var vname = p.text()
        p.next()
        // Plan 447 部分②:载荷变体 Name(T1, T2)/Name{ f T, ... }。Display 与
        // 单元变体同形(载荷类型不入 dump,value 恒 0 不参与自增);载荷类型
        // 按 Enum.Variant.slot 登记进 decls,供 is 臂绑定推断用
        var has_payload = false
        if p.kind() == TokenKind.LParen {
            p.next()
            p.skip_empty_lines()
            if p.kind() != TokenKind.RParen {
                var more_payload = true
                var slot = 0
                while more_payload {
                    var pt = parse_type(p)
                    p.decl_register(name + "." + vname + "." + slot.str(), pt)
                    slot = slot + 1
                    if p.kind() == TokenKind.Comma {
                        p.next()
                        p.skip_empty_lines()
                    } else {
                        more_payload = false
                    }
                }
            }
            p.expect(TokenKind.RParen)
            has_payload = true
        } else if p.kind() == TokenKind.LBrace {
            p.next()
            p.skip_empty_lines()
            var slot2 = 0
            while p.err == "" && p.kind() != TokenKind.RBrace && p.kind() != TokenKind.EOF {
                if !is_name_kind(p.kind()) {
                    p.fail("expected variant field name, got ")
                    return ""
                }
                p.next()
                if p.kind() == TokenKind.Colon {
                    p.next()
                }
                var ft = parse_type(p)
                p.decl_register(name + "." + vname + "." + slot2.str(), ft)
                slot2 = slot2 + 1
                if p.kind() == TokenKind.Comma {
                    p.next()
                    p.skip_empty_lines()
                }
                p.skip_empty_lines()
            }
            p.expect(TokenKind.RBrace)
            has_payload = true
        }
        any_payload = any_payload || has_payload
        var val = next_val
        if has_payload {
            val = 0
        }
        if p.kind() == TokenKind.Asn {
            p.next()
            if p.kind() != TokenKind.Int {
                p.fail("v2 unsupported: enum value ")
                return ""
            }
            val = int_val(p.text())
            p.next()
        }
        // 载荷变体不推进自增基准(参考实证:Val{VI(int) VS(str) VN} 三项全 0)
        if !has_payload {
            next_val = val + 1
        }
        if !first {
            out = f"${out} "
        }
        out = f"${out}(item (name ${vname}) (value ${val.str()}))"
        first = false
        // 变体间空行同成员:静默跳过
        expect_eos(p)
        p.skip_empty_lines()
    }
    p.expect(TokenKind.RBrace)
    // 注册策略(镜像参考注册面):载荷枚举 → 参数位内联完整 enum 快照;
    // 纯标量枚举 → 不注册,参数位落 (type-decl (name X)) 兜底
    if any_payload {
        p.decl_register(name, out + ")")
    }
    return out + ")"
}

// ── is 语句(Plan 447 部分② Phase 4:镜像宿主 parser.rs parse_is/
// parse_is_branch/is_branch_cond_expr 的决策,Display 对齐 ast/is.rs) ──

// parse_expr_or_body 直译:{...} → parse_body;return/break/continue 单语句;
// 其余单表达式 → "(body e)"
fn parse_expr_or_body(mut p P) str {
    if p.kind() == TokenKind.LBrace {
        return parse_body(p)
    }
    if p.kind() == TokenKind.Return {
        return "(body " + parse_return(p) + ")"
    }
    if p.kind() == TokenKind.Break {
        p.next()
        return "(body (break))"
    }
    if p.kind() == TokenKind.Continue {
        p.next()
        return "(body (continue))"
    }
    var e = expr_pratt(p, 0)
    return "(body " + e.dump + ")"
}

// 逗号切分(char_at/slice 手写,载荷绑定列表解析用)
pub fn split_commas(s str) List<str> {
    var out List<str> = List.new()
    var start = 0
    var i = 0
    while i < s.len() {
        if s.char_at(i) == ',' {
            out.push(s.slice(start, i))
            start = i + 1
        }
        i = i + 1
    }
    out.push(s.slice(start, s.len()))
    return out
}

// is_branch_cond_expr 直译(模式位不走表达式语义,D39):Ident 点路径 →
// tag-cover;其余(字面量/裸名/调用形,含 Some(x)——两侧 lexer 均不产出
// SomeKW,宿主同走 Call 路径)交给表达式机。E 复用约定:kind="tag-cover"
// 时 name=枚举名、word=变体名、args=绑定逗号串
// W2(525):struct-cover 字段绑定段——`{ f1, f2: alias }`(宿主
// parse_struct_cover parser.rs 4294:字段名[:别名],逗号分隔可选;
// Display 对齐 FieldBinding——`f` 或 `f: alias`,空格连接)
pub fn parse_struct_cover_fields(mut p P) str {
    p.expect(TokenKind.LBrace)
    p.skip_empty_lines()
    var out = ""
    while p.err == "" && p.kind() != TokenKind.EOF && p.kind() != TokenKind.RBrace {
        if !is_name_kind(p.kind()) {
            p.fail("expected field name in struct cover, got ")
            return ""
        }
        var f = p.text()
        p.next()
        var fb = f
        if p.kind() == TokenKind.Colon {
            p.next()
            if !is_name_kind(p.kind()) {
                p.fail("expected binding name after ':', got ")
                return ""
            }
            fb = p.text()
            p.next()
        }
        if out != "" {
            out = f"${out} "
        }
        if f == fb {
            out = f"${out}${f}"
        } else {
            out = f"${out}${f}: ${fb}"
        }
        if p.kind() == TokenKind.Comma {
            p.next()
        }
        p.skip_empty_lines()
    }
    p.expect(TokenKind.RBrace)
    return out
}

pub fn is_pattern(mut p P) E {
    var k = p.kind()
    if k == TokenKind.Ident {
        // 仅当 Ident 后随 Dot/LBrace 才拦截(裸名/调用形留给表达式机)
        var nxt = TokenKind.EOF
        if p.pos + 1 < p.toks.len() {
            nxt = p.toks.get(p.pos + 1).kind
        }
        // W2(525):`Type { fields }` plain struct-cover(宿主
        // is_branch_cond_expr 4177:Ident+LBrace → parse_struct_cover)
        if nxt == TokenKind.LBrace {
            var ty0 = p.text()
            p.next()
            var fs0 = parse_struct_cover_fields(p)
            if p.err != "" {
                return bad_e()
            }
            return E("struct-cover", "", ty0, fs0, "(struct-cover " + ty0 + " {" + fs0 + "})", "")
        }
        if nxt == TokenKind.Dot {
            var segs List<str> = List.new()
            segs.push(p.text())
            p.next()
            while p.err == "" && p.kind() == TokenKind.Dot {
                p.next()
                if !is_name_kind(p.kind()) {
                    p.fail("expected variant name after '.', got ")
                    return bad_e()
                }
                segs.push(p.text())
                p.next()
            }
            // 3 段路径剥模块前缀(镜像参考 Call 转换:kind 取倒数第二段)
            var ek = segs.get(segs.len() - 2)
            var tg = segs.get(segs.len() - 1)
            // W2(525):`Type.Variant { fields }` 变体 struct-cover(宿主
            // is_branch_cond_expr 4216:Dot 链尾随 LBrace → parse_struct_cover)
            if p.kind() == TokenKind.LBrace {
                var fsv = parse_struct_cover_fields(p)
                if p.err != "" {
                    return bad_e()
                }
                return E("struct-cover", tg, ek, fsv, "(struct-cover " + ek + "." + tg + " {" + fsv + "})", "")
            }
            var bind_list List<str> = List.new()
            if p.kind() == TokenKind.LParen {
                p.next()
                p.skip_empty_lines()
                if p.kind() != TokenKind.RParen {
                    var more_bind = true
                    while more_bind {
                        if !is_name_kind(p.kind()) {
                            p.fail("expected pattern binding, got ")
                            return bad_e()
                        }
                        bind_list.push(p.text())
                        p.next()
                        if p.kind() == TokenKind.Comma {
                            p.next()
                            p.skip_empty_lines()
                        } else {
                            more_bind = false
                        }
                    }
                }
                p.expect(TokenKind.RParen)
            } else {
                // 无括号单元变体 → bindings ["_"](参考 TagCover 约定)
                bind_list.push("_")
            }
            var bj = ""
            var aj = ""
            var i = 0
            while i < bind_list.len() {
                if i > 0 {
                    bj = f"${bj} "
                    aj = f"${aj},"
                }
                bj = bj + bind_list.get(i)
                aj = aj + bind_list.get(i)
                i = i + 1
            }
            var d = f"(tag-cover (kind ${ek}) (tag ${tg}) (bindings ${bj}))"
            return E("tag-cover", tg, ek, aj, d, "")
        }
    }
    return expr_pratt(p, 0)
}

// parse_is_branch 直译:If → "(if cond body)";Else → "(else body)";
// Eq → "(eq p1 [| p2]... body)";首模式 tag-cover 的载荷绑定入臂体作用域
// (载荷类型查 Enum.Variant.slot 登记)
fn parse_is_branch(mut p P) str {
    var k = p.kind()
    if k == TokenKind.If {
        p.next()
        var c = expr_pratt(p, 0)
        p.expect(TokenKind.Arrow)
        var b = parse_expr_or_body(p)
        p.skip_empty_lines()
        return "(if " + c.dump + " " + b + ")"
    }
    if k == TokenKind.Else {
        p.next()
        p.expect(TokenKind.Arrow)
        var b2 = parse_expr_or_body(p)
        p.skip_empty_lines()
        return "(else " + b2 + ")"
    }
    var pat = is_pattern(p)
    var extra List<str> = List.new()
    while p.err == "" && p.kind() == TokenKind.VBar {
        p.next()
        p.skip_empty_lines()
        var np = is_pattern(p)
        extra.push(np.dump)
        p.skip_empty_lines()
    }
    p.expect(TokenKind.Arrow)
    p.skip_empty_lines()
    var body = ""
    var scoped = false
    // W2(525):struct-cover 臂绑定入臂作用域(宿主 parse_is_branch 7856:
    // 逐字段 define Let 占位;`f` 或 `f: alias` 的别名侧入作用域)
    if pat.kind == "struct-cover" && pat.args != "" {
        var fbnds = split_commas(pat.args)
        p.push_scope()
        scoped = true
        var f0 = 0
        while f0 < fbnds.len() {
            var one = fbnds.get(f0)
            var cname = one
            var csp = find_sub(one, ": ")
            if csp >= 0 {
                cname = one.slice(csp + 2, one.len())
            }
            if cname != "_" {
                p.bind(cname, "")
            }
            f0 = f0 + 1
        }
    }
    if pat.kind == "tag-cover" && pat.args != "" && pat.args != "_" {
        var binds = split_commas(pat.args)
        var real = false
        var i = 0
        while i < binds.len() {
            if binds.get(i) != "_" {
                real = true
            }
            i = i + 1
        }
        if real {
            p.push_scope()
            scoped = true
            var i2 = 0
            while i2 < binds.len() {
                if binds.get(i2) != "_" {
                    var slot_ty = p.decl_lookup(pat.name + "." + pat.word + "." + i2.str())
                    p.bind(binds.get(i2), slot_ty)
                }
                i2 = i2 + 1
            }
        }
    }
    body = parse_expr_or_body(p)
    if scoped {
        p.pop_scope()
    }
    var out = f"(eq ${pat.dump} "
    var j = 0
    while j < extra.len() {
        out = f"${out}| ${extra.get(j)} "
        j = j + 1
    }
    p.skip_empty_lines()
    return out + body + ")"
}

// parse_is 直译:语句位 "(is target br1 br2...)";臂间可选逗号
fn parse_is(mut p P) str {
    p.next()
    var t = expr_pratt(p, 0)
    p.expect(TokenKind.LBrace)
    p.skip_empty_lines()
    var branches = ""
    var first = true
    while p.err == "" && p.kind() != TokenKind.RBrace && p.kind() != TokenKind.EOF {
        var b = parse_is_branch(p)
        if !first {
            branches = f"${branches} "
        }
        branches = branches + b
        first = false
        if p.kind() == TokenKind.Comma {
            p.next()
            p.skip_empty_lines()
        }
    }
    p.expect(TokenKind.RBrace)
    return "(is " + t.dump + " " + branches + ")"
}

pub fn is_unsupported_stmt_kind(k TokenKind) bool {
    is k {
        // W2(525):Ext 移出 unsupported(parse_ext 并入方法;type 体
        // ext-for-trait 仍在 parse_ext 内拒绝)
        TokenKind.Spec | TokenKind.Tag | TokenKind.Union | TokenKind.Impl | TokenKind.Task | TokenKind.On | TokenKind.Dep | TokenKind.Hash | TokenKind.HashIf | TokenKind.HashFor | TokenKind.HashIs | TokenKind.HashBrace | TokenKind.HashIdent | TokenKind.Try | TokenKind.Yield | TokenKind.Reply | TokenKind.View -> true
        else -> false
    }
}

fn parse_stmt(mut p P) str {
    if p.err != "" {
        return ""
    }
    var k = p.kind()
    if k == TokenKind.Let || k == TokenKind.Var || k == TokenKind.Const || k == TokenKind.Shared {
        return parse_store(p, k)
    }
    if k == TokenKind.Mut {
        p.fail("'mut' is not supported as a storage modifier ")
        return ""
    }
    if k == TokenKind.Type {
        return parse_type_decl(p)
    }
    // W2(525):ext 块——方法并入(占位行,parse_program 终态并入)
    if k == TokenKind.Ext {
        return parse_ext(p)
    }
    if k == TokenKind.Enum {
        return parse_enum_decl(p)
    }
    if k == TokenKind.Fn {
        return parse_fn(p)
    }
    if k == TokenKind.If {
        return if_contents(p)
    }
    if k == TokenKind.For {
        return parse_for(p)
    }
    if k == TokenKind.Is {
        return parse_is(p)
    }
    if k == TokenKind.While {
        return parse_while(p)
    }
    if k == TokenKind.Loop {
        p.next()
        var b = parse_body(p)
        return "(for (ever) (nil) " + b + ")"
    }
    if k == TokenKind.Break {
        p.next()
        return "(break)"
    }
    if k == TokenKind.Continue {
        p.next()
        return "(continue)"
    }
    if k == TokenKind.Return {
        return parse_return(p)
    }
    if k == TokenKind.LBrace {
        return parse_body(p)
    }
    if k == TokenKind.Use {
        return parse_use(p)
    }
    if is_unsupported_stmt_kind(k) {
        p.fail("v2 unsupported: " + kind_name(k) + " ")
        return ""
    }
    if k == TokenKind.Ident && p.text() == "pub" {
        // W3:pub 前缀——跳过后递归(pub fn/let/var;D3:VM 链路无过滤,
        // dump 不承载 pub 位)
        p.next()
        return parse_stmt(p)
    }
    var e = expr_pratt(p, 0)
    return e.dump
}

// parse_body_inner 直译(方法链合并 Missing;空 body → "(body )")
fn parse_body(mut p P) str {
    p.expect(TokenKind.LBrace)
    p.push_scope()
    var stmts List<str> = List.new()
    var nl = p.skip_empty_lines()
    if nl > 1 {
        stmts.push("(nl*" + (nl - 1).str() + ")")
    }
    while p.err == "" && p.kind() != TokenKind.EOF && p.kind() != TokenKind.RBrace {
        var s = parse_stmt(p)
        stmts.push(s)
        var n = expect_eos(p)
        if n > 1 {
            stmts.push("(nl*" + (n - 1).str() + ")")
        }
    }
    p.expect(TokenKind.RBrace)
    p.pop_scope()
    return "(body " + join_dump_list(stmts, " ") + ")"
}

// expect_eos 直译(Semi/Newline/Comma 皆可分隔;返回 newline 数)
pub fn expect_eos(mut p P) int {
    var count = 0
    var has_sep = false
    while p.kind() == TokenKind.Semi || p.kind() == TokenKind.Newline || p.kind() == TokenKind.Comma {
        has_sep = true
        if p.kind() == TokenKind.Newline {
            count = count + 1
        }
        p.next()
    }
    if p.kind() == TokenKind.EOF || p.kind() == TokenKind.RBrace {
        return count
    }
    if !has_sep {
        p.fail("expected end of statement, got ")
        return 0
    }
    return count
}

// parse_impl 直译(#section/convert_last_block Missing;空 code → "(code )")
// W2(525):子串查找(首现位置;未命中 -1)——ext-merge 并入 type-decl
// 行的字符串手术用(char_at 循环,无内建 contains)
pub fn find_sub(s str, sub str) int {
    var n = s.len()
    var m = sub.len()
    if m == 0 || n < m {
        return -1
    }
    var i = 0
    while i <= n - m {
        var hit = true
        var j = 0
        while j < m {
            if s.char_at(i + j) != sub.char_at(j) {
                hit = false
                j = m
            }
            j = j + 1
        }
        if hit {
            return i
        }
        i = i + 1
    }
    return -1
}

// W2(525):(ext-merge TY M1 M2) 占位行并入对应 type-decl 行——同名
// 方法覆盖语义收窄为追加(语料无同名;宿主 retain+push 全语义超 v2);
// 无 methods 段则新建,有则在段尾 ")" 前并入
fn ext_merge_lines(stmts List<str>) List<str> {
    var out List<str> = List.new()
    var exts List<str> = List.new()
    var i = 0
    while i < stmts.len() {
        var s = stmts.get(i)
        if find_sub(s, "(ext-merge ") == 0 {
            exts.push(s)
        } else {
            out.push(s)
        }
        i = i + 1
    }
    var e = 0
    while e < exts.len() {
        var ex = exts.get(e)
        // "(ext-merge TY M1 M2)" → ty=首词,methods=余串(前缀 11 字符,
        // 尾部 wrapper ")" 一并剥除——仅剥前缀会把闭合括号混入 methods)
        var body = ex.slice(11, ex.len())
        var sp = find_sub(body, " ")
        var ty = body
        var ms = ""
        if sp >= 0 {
            ty = body.slice(0, sp)
            ms = body.slice(sp + 1, body.len() - 1)
        }
        if ms != "" {
            var r = 0
            while r < out.len() {
                var line = out.get(r)
                if find_sub(line, "(type-decl (name " + ty + ")") == 0 {
                    var patched = ""
                    if find_sub(line, " (methods ") < 0 {
                        patched = line.slice(0, line.len() - 1) + " (methods " + ms + "))"
                    } else {
                        // 已有 (methods M1) 段:并入段内(倒数第二 ")" 前)
                        patched = line.slice(0, line.len() - 2) + " " + ms + "))"
                    }
                    out.set(r, patched)
                    r = out.len()
                }
                r = r + 1
            }
        }
        e = e + 1
    }
    return out
}

fn parse_program(mut p P) str {
    var stmts List<str> = List.new()
    p.skip_empty_lines()
    while p.err == "" && p.kind() != TokenKind.EOF {
        var s = parse_stmt(p)
        stmts.push(s)
        var n = expect_eos(p)
        if n > 1 {
            stmts.push("(nl*" + (n - 1).str() + ")")
        }
    }
    // W2(525):ext-merge 占位行终态并入 type-decl(宿主终 AST 形态)
    stmts = ext_merge_lines(stmts)
    return "(code " + join_dump_list(stmts, " ") + ")"
}

// M2 闸门入口:parse_dump(source) -> str
// 注意:当前 VM 存在字符串池 RC 回归(运行期串 List.push 后读回 UAF,
// 242 tracker)——本入口在 VM 修复前会在含 List push 的循环上 canary。
pub fn parse_dump(source str) str {
    var toks = tokenize(source)
    var p = parse_new(toks)
    var dump = parse_program(p)
    if p.err != "" {
        return p.err
    }
    return dump
}
