// Rust ref: crates/auto-lang/src/lexer.rs @ b3bd64f5 (v0.5 临时基线)
// Baseline: b3bd64f5
// Coverage: 主循环(next_step)核心子集——空白/换行/行注释/块注释/DocComment/
//           标识符(含连字符规则)+keyword 表/数字(十进制/浮点/f/d/u/u8/i/i8 后缀/
//           0x/0b/下划线)/字符串(常见转义)/字符字面量/全部定界符与运算符
//           (含 ..= ?. -> => ?? || && 复合);skip_whitespace/pos 记账语义;
//           S2 起 tokenize() 直出 Token List(parser.at 的输入,D14 落地),
//           lex_dump() 降为 List 上的格式化包装(M1 闸门不变)
// Missing:  f-字符串(`/f")、raw/multi/c 字符串、#comptime、byte 字面量、
//           .view/.mut/.take/.move/.? 属性词、}+换行 else 抑制、LexerState 快照回滚
// DIVERGE:  D12: Peekable<Chars> → char_at(i)+p/at 游标(431 D1 变体,免 Vec 构造);
//           D11b 已收账(447-③):主链/转义链 else-if → is-on-char;
//           kind 载体 str → TokenKind(L1;token.at 增 Unknown 哨兵变体);
//           D13: (S2 已落地)单遍局部变量 → tokenize() List + lex_dump() 包装;
//           D14: (S2 已落地)dump 串直出 → 真实 Token 结构(五字段与 M1 行一致);
//           D15: 注释 buffer 后继(CommentContent/End) → 同序 Token;
//           D16: len 按 char 计(源按 UTF-8 字节;corpus 限定 ASCII);
//           D17: 循环体内一律不用 continue——VM 在"循环体含调用语句"时
//                continue 穿透执行后续语句(probe p11/p12 实证,242 tracker 挂账),
//                全部改写为 else-if 链;break 不受影响;
//           D18: 块注释内容 '*' 后一字符被吞(基线 quirk 照抄,见块注释分支注释);
//           D19: 转义 char 字面量收尾无条件吞一字符('\') 连吞 ')',基线照抄)

// Plan 517 W2:模块化互引(token.at 的判据面;拼接消费面由双轨剥离消化)
use auto.lib.token: TokenKind, keyword_kind, kind_name

// S2 起的公开 token 结构:五字段与 M1 dump 行一致(parser 只用 kind/text/line)
pub type Token {
    kind TokenKind
    text str
    line int
    at int
    len int
}

// lex_* 内部记账结构(len=dump 用长度,adv=推进量)
type Tok {
    kind TokenKind
    text str
    len int
    adv int
}

fn cur_char(source str, p int) int {
    if p >= source.len() {
        return 0
    }
    return source.char_at(p)
}

fn is_digit(c int) bool {
    return c >= '0' && c <= '9'
}

fn is_alpha(c int) bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

fn is_alnum(c int) bool {
    return is_digit(c) || is_alpha(c)
}

fn is_hex_digit(c int) bool {
    return is_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

// number() 直译:后缀与进制判定逐分支对齐(内层扫描不用 continue/break)
fn lex_number(source str, start int) Tok {
    var p = start
    var has_dot = false
    var is_hex = false
    var is_binary = false
    var digits = ""
    if cur_char(source, p) == '0' {
        digits = f"${digits}0"
        p = p + 1
        if cur_char(source, p) == 'x' {
            digits = f"${digits}x"
            p = p + 1
            is_hex = true
        } else if cur_char(source, p) == 'b' {
            digits = f"${digits}b"
            p = p + 1
            is_binary = true
        }
    }
    var scanning = true
    for scanning {
        if p >= source.len() {
            scanning = false
        } else {
            var c = cur_char(source, p)
            if is_digit(c) && !is_binary {
                digits = digits + source.slice(p, p + 1)
                p = p + 1
            } else if c == '_' {
                p = p + 1
            } else if is_binary && (c == '0' || c == '1') {
                digits = digits + source.slice(p, p + 1)
                p = p + 1
            } else if is_hex && is_hex_digit(c) {
                digits = digits + source.slice(p, p + 1)
                p = p + 1
            } else if c == '.' && !has_dot && is_digit(cur_char(source, p + 1)) {
                has_dot = true
                digits = f"${digits}."
                p = p + 1
            } else {
                scanning = false
            }
        }
    }
    var kind = TokenKind.Int
    var c1 = cur_char(source, p)
    if c1 == 'f' {
        p = p + 1
        kind = TokenKind.Float
    } else if c1 == 'd' {
        p = p + 1
        kind = TokenKind.Double
    } else if c1 == 'u' {
        p = p + 1
        if cur_char(source, p) == '8' {
            p = p + 1
            kind = TokenKind.U8
        } else {
            kind = TokenKind.Uint
        }
    } else if c1 == 'i' {
        p = p + 1
        if cur_char(source, p) == '8' {
            p = p + 1
            kind = TokenKind.I8
        }
    }
    if has_dot && kind == TokenKind.Int {
        kind = TokenKind.Float
    }
    return Tok(kind, digits, digits.len(), p - start)
}

// str() 直译:常见转义逐项;未知转义按原样两字符入 text
fn lex_string(source str, start int) Tok {
    var p = start + 1
    var text = ""
    var scanning = true
    for scanning {
        if p >= source.len() {
            scanning = false
        } else {
            var c = cur_char(source, p)
            if c == '"' {
                p = p + 1
                scanning = false
            } else if c == '\\' {
                var esc = cur_char(source, p + 1)
                is esc {
                    'n' -> { text = text + "\n" }
                    't' -> { text = text + "\t" }
                    'r' -> { text = text + "\r" }
                    '0' -> { text = text + "\0" }
                    '\\' -> { text = text + "\\" }
                    '"' -> { text = text + "\"" }
                    else -> { text = text + source.slice(p, p + 2) }
                }
                p = p + 2
            } else {
                text = text + source.slice(p, p + 1)
                p = p + 1
            }
        }
    }
    return Tok(TokenKind.Str, text, p - start, p - start)
}

// char() 直译:常见转义 + 普通字符。
// 基线 quirk 照抄(D19):转义分支收尾无条件再吞一字符(视为收尾引号),
// 故 '\') 会连 ')' 一起吞掉(M1 闸门实证两侧 token 一致;上游修复会改 golden)
fn lex_char(source str, start int) Tok {
    var p = start + 1
    var c = cur_char(source, p)
    var text = ""
    if c == '\\' {
        var esc = cur_char(source, p + 1)
        is esc {
            'n' -> { text = "\n" }
            't' -> { text = "\t" }
            'r' -> { text = "\r" }
            '0' -> { text = "\0" }
            '\\' -> { text = "\\" }
            '\'' -> { text = "'" }
            else -> { text = source.slice(p, p + 2) }
        }
        p = p + 3
    } else {
        text = source.slice(p, p + 1)
        p = p + 2
    }
    return Tok(TokenKind.Char, text, p - start, p - start)
}

// identifier() 直译:字母/_ 起始;连字符后随字母/_ 时并入(preview-card 规则)
fn lex_ident(source str, start int) Tok {
    var p = start + 1
    var scanning = true
    for scanning {
        if p >= source.len() {
            scanning = false
        } else {
            var c = cur_char(source, p)
            if is_alnum(c) {
                p = p + 1
            } else if c == '-' && is_alpha(cur_char(source, p + 1)) {
                p = p + 1
            } else {
                scanning = false
            }
        }
    }
    var text = source.slice(start, p)
    return Tok(keyword_kind(text), text, p - start, p - start)
}

fn dump_escape(s str) str {
    var t = s.replace("\\", "\\\\")
    t = t.replace("\n", "\\n")
    t = t.replace("\t", "\\t")
    t = t.replace("\r", "\\r")
    return t
}

// 主循环:next_step 的子集直译(else-if 链,无 continue;见 DIVERGE D17)。
// 产出 Token List(词法语义与 M1 基线逐 token 一致)
// DIVERGE(433): 返回 List → List<Token>(a2r 需元素类型;VM 语义不变)
// f-string 词法(Plan 434 / D38c 简化形):start 位于 'f' 或 '`';
// 形态:f"..."(end1) / f"""..."""(end3) / `...`(raw end1);
// 发射 FStrStart + FStrPart(整段内容,f 形态解码转义,反引号 raw)+ FStrEnd;
// 内容内 $name/${expr} 由 a2r.at 发射侧解析。返回推进量。
fn lex_fstr_at(mut toks List<Token>, source str, start int, line int, at int) int {
    var len = source.len()
    var p = start
    var end1 = '"'
    var triple = 0
    var raw = 0
    if source.char_at(p) == '`' {
        raw = 1
        toks.push(Token(TokenKind.FStrStart, "`", line, at, 1))
        p = p + 1
    } else {
        toks.push(Token(TokenKind.FStrStart, "f\"", line, at, 2))
        p = p + 2
        if source.char_at(p) == '"' && source.char_at(p + 1) == '"' {
            triple = 1
            p = p + 2
        }
    }
    var text = ""
    var nl = 0
    var scanning = true
    while scanning && p < len {
        var c = source.char_at(p)
        var hit_end = false
        if triple == 1 {
            if c == '"' && source.char_at(p + 1) == '"' && source.char_at(p + 2) == '"' {
                hit_end = true
                p = p + 3
            }
        } else {
            if c == end1 {
                hit_end = true
                p = p + 1
            }
        }
        if hit_end {
            scanning = false
        } else if raw == 0 && c == '\\' {
            var esc = source.char_at(p + 1)
            is esc {
                'n' -> { text = text + "\n" }
                't' -> { text = text + "\t" }
                'r' -> { text = text + "\r" }
                '\\' -> { text = text + "\\" }
                '"' -> { text = text + "\"" }
                '$' -> { text = text + "$" }
                else -> { text = text + source.slice(p, p + 2) }
            }
            if esc == '\n' {
                nl = nl + 1
            }
            p = p + 2
        } else {
            if c == '\n' {
                nl = nl + 1
            }
            text = text + source.slice(p, p + 1)
            p = p + 1
        }
    }
    toks.push(Token(TokenKind.FStrPart, text, line, at, text.len()))
    if triple == 1 {
        toks.push(Token(TokenKind.FStrEnd, "\"\"\"", line, at, 3))
    } else if raw == 1 {
        toks.push(Token(TokenKind.FStrEnd, "`", line, at, 1))
    } else {
        toks.push(Token(TokenKind.FStrEnd, "\"", line, at, 1))
    }
    return p - start
}

pub fn tokenize(source str) List<Token> {
    var line = 1
    var at = 0
    var p = 0
    var len = source.len()
    var toks List<Token> = List.new()
    for p < len {
        var c = cur_char(source, p)
        // Plan 514 W2(P511-1 根因①):VM 侧 len 为码点数、char_at 亦码点索引,
        // 两侧自洽;a2r 转译侧 len()=字节数 > 码点数——无哨兵时主循环越过
        // 真实末尾继续扫描(nth→None→0),CJK 多字节注释/文本后的幻影尾段
        // 产 Unknown token(b13/b14/b19)。cur_char 哨兵 0=末尾,VM/转译
        // 两侧同判(cur_char 越界恒 0),主循环即在此收敛。
        if c == 0 {
            break
        }
        // next_step 直译:主链 is-on-char(D11b 收账,447-③);
        // digit/alpha 为卫语臂(谓词不能作模式),序同基线 else-if 链
        is c {
            ' ' | '\t' | '\r' -> {
                // skip_whitespace(非 \n)
                p = p + 1
                at = at + 1
            }
            '\n' -> {
                // '\n':line+=1, at=0 后 single→token.at=0、at=1
                line = line + 1
                at = 1
                p = p + 1
                toks.push(Token(TokenKind.Newline, "\n", line, 0, 1))
            }
            if is_digit(c) -> {
                var t = lex_number(source, p)
                toks.push(Token(t.kind, t.text, line, at, t.len))
                p = p + t.adv
                at = at + t.len
            }
            if is_alpha(c) -> {
                // f-string 前瞻(Plan 434 / D38c:f"..." 与 f"""...""";
                // 整段内容单 FStrPart——$name/${expr} 由 a2r.at 发射侧解析)
                if c == 'f' && cur_char(source, p + 1) == '"' {
                    var fadv = lex_fstr_at(toks, source, p, line, at)
                    p = p + fadv
                    at = at + fadv
                } else {
                    var t = lex_ident(source, p)
                    toks.push(Token(t.kind, t.text, line, at, t.len))
                    p = p + t.len
                    at = at + t.len
                }
            }
            '`' -> {
                // 反引号原始 f-string(无转义处理)
                var badv = lex_fstr_at(toks, source, p, line, at)
                p = p + badv
                at = at + badv
            }
            '"' -> {
                if cur_char(source, p + 1) == '"' && cur_char(source, p + 2) == '"' {
                    // 三引号多行字符串(Plan 434):到闭 """,内容实换行入 Str
                    var q3 = p + 3
                    var end3 = -1
                    var scanning3 = true
                    while scanning3 && q3 < len {
                        if cur_char(source, q3) == '"' && cur_char(source, q3 + 1) == '"' && cur_char(source, q3 + 2) == '"' {
                            end3 = q3
                            scanning3 = false
                        }
                        q3 = q3 + 1
                    }
                    var text3 = source.slice(p + 3, end3)
                    var nl3 = 0
                    var k3 = 0
                    while k3 < text3.len() {
                        if text3.char_at(k3) == '\n' {
                            nl3 = nl3 + 1
                        }
                        k3 = k3 + 1
                    }
                    toks.push(Token(TokenKind.Str, text3, line, at, end3 + 3 - p))
                    line = line + nl3
                    p = end3 + 3
                    at = 1
                } else {
                    var t = lex_string(source, p)
                    toks.push(Token(t.kind, t.text, line, at, t.len))
                    p = p + t.len
                    at = at + t.len
                }
            }
            '\'' -> {
                var t = lex_char(source, p)
                toks.push(Token(t.kind, t.text, line, at, t.len))
                p = t.len + p
                at = at + t.len
            }
            '/' -> {
                var n = cur_char(source, p + 1)
                if n == '/' {
                    // 行注释:text 含第二个 '/'(Rust 未消费即读);/// → DocComment
                    var q = p + 2
                    var scanning = true
                    for scanning {
                        if q >= len || cur_char(source, q) == '\n' {
                            scanning = false
                        } else {
                            q = q + 1
                        }
                    }
                    var text = source.slice(p + 1, q)
                    if text.len() >= 2 && text.slice(0, 2) == "//" {
                        var doc = text.slice(2, text.len()).trim()
                        toks.push(Token(TokenKind.DocComment, doc, line, at, text.len() + 2))
                    } else {
                        toks.push(Token(TokenKind.CommentLine, "//", line, at, 2))
                        toks.push(Token(TokenKind.CommentContent, text, line, at + 2, text.len()))
                    }
                    at = at + 2 + text.len()
                    p = q
                } else if n == '*' {
                    // 块注释:复刻基线 quirk——内容中 '*' 后一字符被吞不入 text
                    // (DIVERGE D18:基线 lexer 的 '*' 分支 push(c)+next() 连吞两字符,
                    //  M1 闸门以基线为唯一依据,照抄;上游修复会改 golden,挂账 432 债务簿)
                    var q = p + 1
                    var ctext = ""
                    var scanning = true
                    for scanning {
                        if q >= len {
                            scanning = false
                        } else {
                            var cc = cur_char(source, q)
                            if cc == '*' {
                                q = q + 1
                                if cur_char(source, q) == '/' {
                                    q = q + 1
                                    scanning = false
                                } else {
                                    ctext = f"${ctext}*"
                                    q = q + 1
                                }
                            } else {
                                ctext = ctext + source.slice(q, q + 1)
                                q = q + 1
                            }
                        }
                    }
                    toks.push(Token(TokenKind.CommentStart, "/*", line, at, 2))
                    toks.push(Token(TokenKind.CommentContent, ctext, line, at + 2, ctext.len()))
                    toks.push(Token(TokenKind.CommentEnd, "*/", line, at + 2 + ctext.len(), 2))
                    at = at + 2 + ctext.len() + 2
                    p = q
                } else if n == '=' {
                    toks.push(Token(TokenKind.DivEq, "/=", line, at, 2))
                    p = p + 2
                    at = at + 2
                } else {
                    toks.push(Token(TokenKind.Div, "/", line, at, 1))
                    p = p + 1
                    at = at + 1
                }
            }
            '(' -> {
                toks.push(Token(TokenKind.LParen, source.slice(p, p + 1), line, at, 1))
                p = p + 1
                at = at + 1
            }
            ')' -> {
                toks.push(Token(TokenKind.RParen, source.slice(p, p + 1), line, at, 1))
                p = p + 1
                at = at + 1
            }
            '[' -> {
                toks.push(Token(TokenKind.LSquare, source.slice(p, p + 1), line, at, 1))
                p = p + 1
                at = at + 1
            }
            ']' -> {
                toks.push(Token(TokenKind.RSquare, source.slice(p, p + 1), line, at, 1))
                p = p + 1
                at = at + 1
            }
            '{' -> {
                toks.push(Token(TokenKind.LBrace, source.slice(p, p + 1), line, at, 1))
                p = p + 1
                at = at + 1
            }
            '}' -> {
                toks.push(Token(TokenKind.RBrace, source.slice(p, p + 1), line, at, 1))
                p = p + 1
                at = at + 1
            }
            ',' -> {
                toks.push(Token(TokenKind.Comma, source.slice(p, p + 1), line, at, 1))
                p = p + 1
                at = at + 1
            }
            ';' -> {
                toks.push(Token(TokenKind.Semi, source.slice(p, p + 1), line, at, 1))
                p = p + 1
                at = at + 1
            }
            ':' -> {
                toks.push(Token(TokenKind.Colon, source.slice(p, p + 1), line, at, 1))
                p = p + 1
                at = at + 1
            }
            '@' -> {
                toks.push(Token(TokenKind.At, source.slice(p, p + 1), line, at, 1))
                p = p + 1
                at = at + 1
            }
            '+' | '*' | '%' | '!' | '>' | '<' -> {
                var base = TokenKind.Add
                var eqk = TokenKind.AddEq
                var sym = "+"
                is c {
                    '*' -> {
                        base = TokenKind.Star
                        eqk = TokenKind.MulEq
                        sym = "*"
                    }
                    '%' -> {
                        base = TokenKind.Mod
                        eqk = TokenKind.ModEq
                        sym = "%"
                    }
                    '!' -> {
                        base = TokenKind.Not
                        eqk = TokenKind.Neq
                        sym = "!"
                    }
                    '>' -> {
                        base = TokenKind.Gt
                        eqk = TokenKind.Ge
                        sym = ">"
                    }
                    '<' -> {
                        base = TokenKind.Lt
                        eqk = TokenKind.Le
                        sym = "<"
                    }
                    else -> {
                    }
                }
                if cur_char(source, p + 1) == '=' {
                    toks.push(Token(eqk, sym + "=", line, at, 2))
                    p = p + 2
                    at = at + 2
                } else {
                    toks.push(Token(base, sym, line, at, 1))
                    p = p + 1
                    at = at + 1
                }
            }
            '=' -> {
                var n = cur_char(source, p + 1)
                if n == '>' {
                    toks.push(Token(TokenKind.DoubleArrow, "=>", line, at, 2))
                    p = p + 2
                    at = at + 2
                } else if n == '=' {
                    toks.push(Token(TokenKind.Eq, "==", line, at, 2))
                    p = p + 2
                    at = at + 2
                } else {
                    toks.push(Token(TokenKind.Asn, "=", line, at, 1))
                    p = p + 1
                    at = at + 1
                }
            }
            '-' -> {
                var n = cur_char(source, p + 1)
                if n == '>' {
                    toks.push(Token(TokenKind.Arrow, "->", line, at, 2))
                    p = p + 2
                    at = at + 2
                } else if n == '=' {
                    toks.push(Token(TokenKind.SubEq, "-=", line, at, 2))
                    p = p + 2
                    at = at + 2
                } else {
                    toks.push(Token(TokenKind.Sub, "-", line, at, 1))
                    p = p + 1
                    at = at + 1
                }
            }
            '?' -> {
                if cur_char(source, p + 1) == '?' {
                    toks.push(Token(TokenKind.QuestionQuestion, "??", line, at, 2))
                    p = p + 2
                    at = at + 2
                } else {
                    toks.push(Token(TokenKind.Question, "?", line, at, 1))
                    p = p + 1
                    at = at + 1
                }
            }
            '|' | '&' -> {
                if c == '|' && cur_char(source, p + 1) == '|' {
                    toks.push(Token(TokenKind.Or, "||", line, at, 2))
                    p = p + 2
                    at = at + 2
                } else if c == '&' && cur_char(source, p + 1) == '&' {
                    toks.push(Token(TokenKind.And, "&&", line, at, 2))
                    p = p + 2
                    at = at + 2
                } else if c == '|' && cur_char(source, p + 1) == '>' {
                    // Plan 514 W5: 管道算子 |>（贪婪两字符，镜像宿主 lexer）
                    toks.push(Token(TokenKind.PipeGt, "|>", line, at, 2))
                    p = p + 2
                    at = at + 2
                } else if c == '|' {
                    toks.push(Token(TokenKind.VBar, "|", line, at, 1))
                    p = p + 1
                    at = at + 1
                } else {
                    toks.push(Token(TokenKind.Amp, "&", line, at, 1))
                    p = p + 1
                    at = at + 1
                }
            }
            '.' -> {
                var n = cur_char(source, p + 1)
                if n == '.' {
                    if cur_char(source, p + 2) == '=' {
                        toks.push(Token(TokenKind.RangeEq, "..=", line, at, 3))
                        p = p + 3
                        at = at + 3
                    } else {
                        toks.push(Token(TokenKind.Range, "..", line, at, 2))
                        p = p + 2
                        at = at + 2
                    }
                } else if n == '?' {
                    toks.push(Token(TokenKind.DotQuestion, "?.", line, at, 2))
                    p = p + 2
                    at = at + 2
                } else {
                    toks.push(Token(TokenKind.Dot, ".", line, at, 1))
                    p = p + 1
                    at = at + 1
                }
            }
            else -> {
                // 未覆盖字符:Unknown 前进(闸门 diff 暴露后逐个收编)
                toks.push(Token(TokenKind.Unknown, source.slice(p, p + 1), line, at, 1))
                p = p + 1
                at = at + 1
            }
        }
    }
    toks.push(Token(TokenKind.EOF, "", line, at, 0))
    return toks
}

// M1 闸门包装:kind|esc_text|line|at|len 逐 token 行式 dump
pub fn lex_dump(source str) str {
    var toks = tokenize(source)
    var out = ""
    var i = 0
    while i < toks.len() {
        var t Token = toks.get(i)
        out = out + kind_name(t.kind) + "|" + dump_escape(t.text) + "|" + t.line.str() + "|" + t.at.str() + "|" + t.len.str() + "\n"
        i = i + 1
    }
    return out
}
