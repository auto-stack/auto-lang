// PLAN-1023 ASE M0：交互会话 Counter A（权威 fixture；无参事件 A 面）。
// 与 counter-b 同 Schema（msg/model/on 形状一致）但根名/文字不同——UI 侧
// 反硬编码 oracle 输入（换合法根/文字仍工作）。按钮声明序（冻结）：
// 0=`-`(Dec)、1=Reset、2=`+`(Inc)；count 经已交 int 状态槽显示，不用
// f-string 文本叶。
node CounterA {
    msg { Inc, Dec, Reset }

    model {
        var count int = 0
    }

    view {
        col {
            text "ASE M0 Counter A"
            row {
                button "-" { onclick: .Dec }
                button "Reset" { onclick: .Reset }
                button "+" { onclick: .Inc }
            }
        }
    }

    on {
        .Inc -> { .count += 1 }
        .Dec -> { .count -= 1 }
        .Reset -> { .count = 0 }
    }
}
