// V-03 source leg: same-structure records are nominal — a B value cannot
// seed an A-typed field even with identical shapes
type A {
    x int
    y int
}
type B {
    x int
    y int
}
type W {
    inner A
}
fn main() int {
    let b = B { x: 1, y: 2 }
    let w = W { inner: b }
    return w.inner.x
}
