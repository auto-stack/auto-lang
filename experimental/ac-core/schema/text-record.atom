        branch(key: "expr.logical") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, text, scalar, operand, index, start, end, callee, eval_args, bindings, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "expr.call") {
            require: [type, callee, eval_args, bindings]
            forbid: [local, value, text, scalar, op, overflow, lhs, rhs, operand, index, start, end, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "expr.str_lit") {
            require: [type, text]
            forbid: [local, value, scalar, op, overflow, lhs, rhs, operand, index, start, end, callee, eval_args, bindings, record, field_args, ctor_bindings, base, path]
