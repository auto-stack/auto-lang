// record-i32-draft descriptor (PLAN-771).
//
// Machine-readable contract consumed by experimental/ac-core/src/descriptor.rs.
// Superset of scalar-i32-draft (PLAN-767/772): adds nominal record types
// (declaration-order field tables), record construction (source-order
// evaluation + field bindings), nested field paths (rvalue get and typed
// place), view/mut record borrows (774 D-04; ABI-D `*const` / ABI-E `*mut`),
// type-bound methods (static + readonly instance receivers) and explicit
// `mut` free-function params. The root identity
// (schema/revision/profile) is frozen by the 774 interface-contract §7.2
// table and must be echoed by every accepted HIR document; unknown tags,
// fields, enum cases and capabilities are rejected. Documents under the
// core/scalar identities keep using their own schemas — profiles stay
// isolated by descriptor, verifier entry and canonical writer.
//
// Layout/ABI of record values is NOT expressed here (774 D-05 owns it):
// declaration order, self-align 4, size = 4n, offset(fᵢ) = 4·i; returns go
// through an explicit caller-provided out-slot; no aggregate sret.

descriptor(schema: "auto.hir.record.draft", revision: 1u32, profile: "record-i32-draft") {

    enums {
        enum ExprKind { cases: [read_local, constant, binary, unary, logical, call, record_ctor, field_get, borrow_view, borrow_mut] }
        enum TypeKind { cases: [i32, bool, function, record] }
        enum BinOp { cases: [add_i32, sub_i32, mul_i32, div_i32, rem_i32, lt_i32, le_i32, gt_i32, ge_i32, eq, ne] }
        enum UnaryOp { cases: [neg_i32, not_bool] }
        enum LogicOp { cases: [and, or] }
        enum OverflowPolicy { cases: [trap] }
        enum LocalRole { cases: [param, binding] }
        enum PlaceKind { cases: [local, field_path] }
        enum AccessKind { cases: [mutable, readonly] }
        enum EffectKind { cases: [observable, pure] }
        enum ParamMode { cases: [view, mut] }
        enum ReceiverKind { cases: [static, view] }
    }

    nodes {
        node hir {
            slots: []
            fields { schema: Text; revision: U32; profile: Text; requires: TextList }
            inline: [module]
        }

        node module {
            slots: [Id]
            fields { path: Text }
            containers {
                types: [type]
                declarations: [function, intrinsic, method]
                bodies: [body]
            }
        }

        node type {
            slots: [Id, TypeKind]
            fields { params: TypeUseList; result: TypeUse; fields: FieldDeclList }
        }

        node function {
            slots: [Id, TypeRef]
            fields {
                name: Text
                body: BodyRef
            }
        }

        node method {
            slots: [Id, TypeRef]
            fields {
                name: Text
                body: BodyRef
                record: TypeRef
                receiver: ReceiverKind
            }
        }

        node intrinsic {
            slots: [Id, TypeRef]
            fields { symbol: Text; effect: EffectKind }
        }

        node body {
            slots: [Id]
            fields { owner: DefRef; entry: BlockRef }
            containers {
                locals: [local]
                places: [place]
                expressions: [expr]
                blocks: [block]
            }
        }

        node local {
            slots: [Id, TypeUse]
            fields { name: Text; role: LocalRole; index: U32; mutable: Bool; mode: ParamMode }
        }

        node place {
            slots: [Id, PlaceKind]
            fields { local: LocalRef; type: TypeUse; access: AccessKind; path: FieldRefList }
        }

        node expr {
            slots: [Id, ExprKind]
            fields {
                type: TypeUse
                local: LocalRef
                value: I32
                op: BinOp
                overflow: OverflowPolicy
                lhs: ExprRef
                rhs: ExprRef
                operand: ExprRef
                callee: DefRef
                eval_args: ExprRefList
                bindings: BindingList
                record: TypeRef
                field_args: ExprRefList
                ctor_bindings: CtorBindingList
                base: ExprRef
                path: FieldRefList
            }
        }

        node block {
            slots: [Id]
            statements: [let, return, if, loop, assign, break, continue]
        }

        node let { fields { local: LocalRef; value: ExprRef } }
        node return { fields { value: ExprRef } }
        node if { fields { cond: ExprRef; then: BlockRef; else: BlockRef } }
        node loop { fields { id: LoopDecl; body: BlockRef } }
        node assign { fields { place: PlaceRef; value: ExprRef } }
        node break { fields { target: LoopRef } }
        node continue { fields { target: LoopRef } }
    }

    branches {
        branch(key: "hir") { require: [schema, revision, profile] }
        branch(key: "type.i32") { forbid: [params, result, fields] }
        branch(key: "type.bool") { forbid: [params, result, fields] }
        branch(key: "type.function") { require: [params, result]; forbid: [fields] }
        branch(key: "type.record") { require: [fields]; forbid: [params, result] }
        branch(key: "function") {
            require: [name]
            forbid: [symbol, effect, record, receiver]
        }
        branch(key: "method") {
            require: [name, body, record, receiver]
            forbid: [symbol, effect]
        }
        branch(key: "intrinsic") { require: [symbol, effect]; forbid: [name, body, record, receiver] }
        branch(key: "body") { require: [owner, entry] }
        branch(key: "local.param") { require: [name, role, mode]; forbid: [mutable] }
        branch(key: "local.binding") { require: [name, role]; forbid: [index, mode] }
        branch(key: "place.local") { require: [local, type, access]; forbid: [path] }
        branch(key: "place.field_path") { require: [local, type, access, path] }
        branch(key: "expr.read_local") {
            require: [type, local]
            forbid: [value, op, overflow, lhs, rhs, operand, callee, eval_args, bindings, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "expr.constant") {
            require: [type, value]
            forbid: [local, op, overflow, lhs, rhs, operand, callee, eval_args, bindings, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "expr.binary:add_i32") {
            require: [type, op, overflow, lhs, rhs]
            forbid: [local, value, operand, callee, eval_args, bindings, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "expr.binary:sub_i32") {
            require: [type, op, overflow, lhs, rhs]
            forbid: [local, value, operand, callee, eval_args, bindings, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "expr.binary:mul_i32") {
            require: [type, op, overflow, lhs, rhs]
            forbid: [local, value, operand, callee, eval_args, bindings, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "expr.binary:div_i32") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, operand, callee, eval_args, bindings, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "expr.binary:rem_i32") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, operand, callee, eval_args, bindings, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "expr.binary:lt_i32") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, operand, callee, eval_args, bindings, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "expr.binary:le_i32") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, operand, callee, eval_args, bindings, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "expr.binary:gt_i32") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, operand, callee, eval_args, bindings, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "expr.binary:ge_i32") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, operand, callee, eval_args, bindings, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "expr.binary:eq") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, operand, callee, eval_args, bindings, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "expr.binary:ne") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, operand, callee, eval_args, bindings, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "expr.unary") {
            require: [type, op, operand]
            forbid: [local, value, overflow, lhs, rhs, callee, eval_args, bindings, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "expr.logical") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, operand, callee, eval_args, bindings, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "expr.call") {
            require: [type, callee, eval_args, bindings]
            forbid: [local, value, op, overflow, lhs, rhs, operand, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "expr.record_ctor") {
            require: [type, record, field_args, ctor_bindings]
            forbid: [local, value, op, overflow, lhs, rhs, operand, callee, eval_args, bindings, base, path]
        }
        branch(key: "expr.field_get") {
            require: [type, base, path]
            forbid: [local, value, op, overflow, lhs, rhs, operand, callee, eval_args, bindings, record, field_args, ctor_bindings]
        }
        branch(key: "expr.borrow_view") {
            require: [type, base]
            forbid: [local, value, op, overflow, lhs, rhs, operand, callee, eval_args, bindings, record, field_args, ctor_bindings, path]
        }
        branch(key: "expr.borrow_mut") {
            require: [type, local]
            forbid: [value, op, overflow, lhs, rhs, operand, callee, eval_args, bindings, record, field_args, ctor_bindings, base, path]
        }
        branch(key: "let") { require: [local, value] }
        branch(key: "return") { require: [value] }
        branch(key: "if") { require: [cond, then] }
        branch(key: "loop") { require: [id, body] }
        branch(key: "assign") { require: [place, value] }
        branch(key: "break") { require: [target] }
        branch(key: "continue") { require: [target] }
    }
}
