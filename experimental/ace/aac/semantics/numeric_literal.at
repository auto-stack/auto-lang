use app.binding.bind_budget
use app.binding.take_step
use app.semantic_tree.span_text
use app.semantic_tree.parent
use app.semantic_tree.start_of
use app.syntax_frontend.str_to_bytes
use app.types.f32_type
use app.types.f64_type
use app.types.i8_type
use app.types.i64_type
use app.types.integer_type
use app.types.u8_type
use app.types.u32_type
use app.types.u64_type
use std.conv.from_int

pub fn literal_range() int { return -28 }
pub fn literal_syntax() int { return -29 }

fn radix_digit(c int, radix int) int {
    var value = -1
    if (c >= 48 && c <= 57) { value = c - 48 }
    if (c >= 65 && c <= 70) { value = c - 65 + 10 }
    if (c >= 97 && c <= 102) { value = c - 97 + 10 }
    if (value >= radix) { return -1 }
    return value
}

fn integer_suffix(suffix Str) int {
    if (suffix == "" || suffix == "i" || suffix == "i32") { return integer_type() }
    if (suffix == "i8") { return i8_type() }
    if (suffix == "u8" || suffix == "b") { return u8_type() }
    if (suffix == "u" || suffix == "u32") { return u32_type() }
    if (suffix == "i64") { return i64_type() }
    if (suffix == "u64") { return u64_type() }
    return literal_syntax()
}

fn magnitude_limit(type_id int, negative bool) u64 {
    if (type_id == integer_type()) {
        if (negative) { return 2147483648u64 }
        return 2147483647u64
    }
    if (type_id == i8_type()) {
        if (negative) { return 128u64 }
        return 127u64
    }
    if (type_id == i64_type()) {
        if (negative) { return 9223372036854775808u64 }
        return 9223372036854775807u64
    }
    if (negative) { return 0u64 }
    if (type_id == u8_type()) { return 255u64 }
    if (type_id == u32_type()) { return 4294967295u64 }
    return 18446744073709551615u64
}

// The first value that rounds to infinity under round-to-nearest-even is
// MAX plus half its last place: 2^128 - 2^103 or 2^1024 - 2^970.
// Both thresholds are whole numbers, so comparing just the integral
// decimal digits also handles an arbitrary number of fractional digits.
fn float_range(src List<int>, start int, end int, significant int, lanes int, fuel List<int>, deadline i64) int {
    var width = 39
    if (lanes == f64_type()) { width = 309 }
    if (significant < width) { return lanes }
    if (significant > width) { return literal_range() }
    var bound = "340282356779733661637539395458142568448"
    if (lanes == f64_type()) {
        bound = ""
    }
    let border = str_to_bytes(bound)
    var at = start
    var digit = 0
    for (at < end) {
        if (!take_step(fuel, deadline)) { return bind_budget() }
        let value = src.get(at)
        if (value != 95) {
            let limit = border.get(digit)
            if (value < limit) { return lanes }
            if (value > limit) { return literal_range() }
            digit = digit + 1
        }
        at = at + 1
    }
    return literal_range()
}

// Recognize the numeric body before interpreting the suffix. In hexadecimal,
// letters a..f belong to the magnitude, including trailing "f32"/"f64".
fn inspect_literal(src List<int>, start int, end int, negative bool, scalar List<int>, fuel List<int>, deadline i64) int {
    var radix = 10
    var digits_start = start
    if (end - start >= 2 && src.get(start) == 48) {
        let prefix = src.get(start + 1)
        if (prefix == 120) { radix = 16 }
        if (prefix == 98) { radix = 2 }
        if (radix != 10) { digits_start = start + 2 }
    }
    var offset = digits_start
    var dots = 0
    var digits = 0
    var significant = 0
    var first_significant = digits_start
    var decimal_point = -1
    for (offset < end) {
        if (!take_step(fuel, deadline)) { return bind_budget() }
        let byte_value = src.get(offset)
        if (byte_value == 46) {
            dots = dots + 1
            decimal_point = offset
        } else {
            if (byte_value != 95) {
                if (radix_digit(byte_value, radix) < 0) { break }
                digits = digits + 1
                if (dots == 0 && (significant > 0 || byte_value != 48)) {
                    if (significant == 0) { first_significant = offset }
                    significant = significant + 1
                }
            }
        }
        offset = offset + 1
    }
    if (digits == 0 || dots > 1 || (dots > 0 && radix != 10)) { return literal_syntax() }
    let suffix = span_text(src, offset, end)
    if (dots == 1) {
        if (suffix == "" || suffix == "f" || suffix == "f32") {
            return float_range(src, first_significant, decimal_point, significant, f32_type(), fuel, deadline)
        }
        if (suffix == "d" || suffix == "f64") {
            return float_range(src, first_significant, decimal_point, significant, f64_type(), fuel, deadline)
        }
        return literal_syntax()
    }
    let type_id = integer_suffix(suffix)
    if (type_id < 0) { return type_id }
    let limit = magnitude_limit(type_id, negative)
    if (limit == 0u64) { return literal_range() }
    let base = radix.to(u64)
    var magnitude = 0u64
    var node = digits_start
    for (node < offset) {
        if (!take_step(fuel, deadline)) { return bind_budget() }
        let byte_value = src.get(node)
        if (byte_value != 95) {
            let digit = radix_digit(byte_value, radix)
            let unsigned = digit.to(u64)
            if (magnitude > (limit - unsigned) / base) { return literal_range() }
            magnitude = magnitude * base + unsigned
        }
        node = node + 1
    }
    if (scalar.len() > 0) {
        var word = magnitude
        var slot = 0
        for (slot < 4) {
            let limb = (word % 65536u64).to(u32)
            scalar.push(limb.to(int))
            word = word / 65536u64
            slot = slot + 1
        }
    }
    return type_id
}

pub fn negative_source_literal(src List<int>, ast List<int>, token int) bool {
    let enclosing = parent(ast, token)
    if (enclosing < 0) { return false }
    let at = start_of(ast, enclosing)
    return at < start_of(ast, token) && src.get(at) == 45
}

pub fn numeric_literal_type(src List<int>, start int, end int, negative bool, fuel List<int>, deadline i64) int {
    var scalar = List<int>.new()
    return inspect_literal(src, start, end, negative, scalar, fuel, deadline)
}

pub fn decode_i32_literal(src List<int>, start int, end int, negative bool, out List<int>, fuel List<int>, deadline i64) int {
    var magnitude = List<int>.new()
    magnitude.push(0)
    let lane = inspect_literal(src, start, end, negative, magnitude, fuel, deadline)
    if (lane == integer_type()) {
        var exact = magnitude_at(magnitude, 1).to(i64)
        if (negative) { exact = 0i64 - exact }
        out.set(0, exact.to(int))
    }
    return lane
}

pub fn wide_integer_word(lane int) Str {
    if (lane == i8_type()) { return "i8" }
    if (lane == u8_type()) { return "u8" }
    if (lane == u32_type()) { return "u32" }
    if (lane == i64_type()) { return "i64" }
    if (lane == u64_type()) { return "u64" }
    return ""
}

pub fn wide_integer_type(word Str) int {
    if (word == "i8") { return i8_type() }
    if (word == "u8") { return u8_type() }
    if (word == "u32") { return u32_type() }
    if (word == "i64") { return i64_type() }
    if (word == "u64") { return u64_type() }
    return 0
}

pub fn wide_literal_stride() int { return 6 }

fn magnitude_at(words List<int>, offset int) u64 {
    var value = 0u64
    var at = offset + 3
    for (at >= offset) {
        value = value * 65536u64 + words.get(at).to(u64)
        at = at - 1
    }
    return value
}

// Four 16-bit limbs carry the full unsigned magnitude on Gen0's List<int>
// lane. The signed minimum never passes through an i64 conversion.
pub fn decode_wide_integer(src List<int>, start int, end int, negative bool, out List<int>, fuel List<int>, deadline i64) int {
    var magnitude = List<int>.new()
    magnitude.push(0)
    let lane = inspect_literal(src, start, end, negative, magnitude, fuel, deadline)
    if (wide_integer_word(lane).len() > 0) {
        out.push(lane)
        var sign = 0
        if (negative) { sign = 1 }
        out.push(sign)
        var at = 1
        for (at <= 4) {
            out.push(magnitude.get(at))
            at = at + 1
        }
    }
    return lane
}

pub fn format_wide_integer(exact List<int>, offset int) Str {
    let magnitude = magnitude_at(exact, offset + 2)
    var digits = ""
    var remaining = magnitude
    for (true) {
        let digit = (remaining % 10u64).to(u32)
        digits = from_int(digit.to(int)) + digits
        remaining = remaining / 10u64
        if (remaining == 0u64) { break }
    }
    if (exact.get(offset + 1) != 0 && magnitude != 0u64) { digits = "-" + digits }
    return digits + wide_integer_word(exact.get(offset))
}
