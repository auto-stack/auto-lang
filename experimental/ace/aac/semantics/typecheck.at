pub fn type_unknown() int { return -20 }
pub fn type_operator() int { return -21 }
pub fn type_value() int { return -22 }
pub fn type_return() int { return -23 }
pub fn type_argument() int { return -24 }
pub fn type_branch() int { return -25 }
pub fn type_condition() int { return -26 }
pub fn type_member() int { return -27 }
pub fn type_empty_list() int { return -36 }

fn failure(errors List<int>, row int, code int) int {
    errors.push(row)
    return code
}

fn function_category(category int) bool {
    return category == function_decl() || category == method_decl()
}

fn annotation_of(pg List<int>, ast List<int>, links List<int>, row int) int {
    let annotation = child_with_role(pg, ast, links, row, "ty")
    if (annotation >= 0) { return annotation }
    return child_with_role(pg, ast, links, row, "ann")
}

fn initializer_category(category int) bool {
    return category == local_let_decl() || category == local_var_decl() || category == constant_decl() || category == global_var_decl()
}

fn signature(pg List<int>, ast List<int>, links List<int>, facts List<int>, types List<int>, function int, fuel List<int>, deadline i64) int {
    let result = facts.get(function)
    if (result == 0) { return 0 }
    let params = call_parameter_slots(pg, ast, links, function)
    var elements = List<int>.new()
    var i = 0
    for (i < params.len()) {
        if (!take_step(fuel, deadline)) { return bind_budget() }
        let param = facts.get(params.get(i))
        if (param == 0) { return 0 }
        elements.push(param)
        i = i + 1
    }
    let chain = intern_sequence(types, elements, fuel, deadline)
    if (chain < 0) { return bind_budget() }
    let callable = intern_type(types, function_kind(), result, chain, fuel, deadline)
    if (callable < 0) { return bind_budget() }
    return callable
}

fn numeric_type(id int) bool {
    return id == integer_type() || (id >= i8_type() && id <= f64_type())
}

fn literal_type(src List<int>, ast List<int>, row int, node_kind Str, fuel List<int>, deadline i64) int {
    if (node_kind == "true-kw" || node_kind == "false-kw") { return boolean_type() }
    if (node_kind == "int-lit" || node_kind == "affix-num") {
        let begin = start_of(ast, row)
        let negative = negative_source_literal(src, ast, row)
        return numeric_literal_type(src, begin, end_of(ast, row), negative, fuel, deadline)
    }
    if (node_kind == "str-lit") { return text_view_type() }
    if (node_kind == "char-lit") { return char_type() }
    return 0
}

fn value_wrapper(node_kind Str) bool {
    let expression = node_kind == "expr" || node_kind == "atom-expr" || node_kind == "unary-expr" || node_kind == "postfix-expr" || node_kind == "int-literal"
    let condition = node_kind == "condition-expr" || node_kind == "condition-atom" || node_kind == "condition-unary" || node_kind == "condition-postfix" || node_kind == "if-cond"
    return expression || condition || node_kind == "expr-stmt" || node_kind == "return-stmt" || node_kind == "stmt"
}

fn matching_operator(node_kind Str) bool {
    let arithmetic = node_kind == "plus" || node_kind == "minus" || node_kind == "star" || node_kind == "slash" || node_kind == "percent"
    let comparison = node_kind == "lt" || node_kind == "gt" || node_kind == "le" || node_kind == "ge" || node_kind == "eq" || node_kind == "ne"
    let boolean = node_kind == "andand" || node_kind == "oror"
    let bits = node_kind == "amp" || node_kind == "vbar" || node_kind == "caret" || node_kind == "shl" || node_kind == "shr"
    return arithmetic || comparison || boolean || bits
}

fn binary_type(pg List<int>, ast List<int>, links List<int>, facts List<int>, row int, op Str) int {
    let lhs = first_child(links, row)
    if (lhs < 0) { return 0 }
    let token = next_sibling(links, lhs)
    if (token < 0 || kind(pg, ast, token) != op) { return 0 }
    let rhs = next_sibling(links, token)
    if (rhs < 0) { return 0 }
    let left = facts.get(lhs)
    let right = facts.get(rhs)
    if (left == 0 || right == 0) { return 0 }
    let left_text = left == owned_text_type() || left == text_view_type()
    let right_text = right == owned_text_type() || right == text_view_type()
    if (op == "plus" && left_text && right_text) { return owned_text_type() }
    if (left != right) { return type_operator() }
    if (op == "eq" || op == "ne") { return boolean_type() }
    if (op == "andand" || op == "oror") {
        if (left != boolean_type()) { return type_operator() }
        return boolean_type()
    }
    if (!numeric_type(left)) { return type_operator() }
    let bitwise = op == "amp" || op == "vbar" || op == "caret" || op == "shl" || op == "shr"
    if (bitwise && left >= f32_type()) { return type_operator() }
    if (op == "lt" || op == "gt" || op == "le" || op == "ge") { return boolean_type() }
    return left
}

fn last_block_value(pg List<int>, ast List<int>, links List<int>, facts List<int>, row int) int {
    var child = first_child(links, row)
    var value = 0
    for (child >= 0) {
        if (kind(pg, ast, child) == "stmt") { value = facts.get(child) }
        child = next_sibling(links, child)
    }
    return value
}

fn conditional_value(pg List<int>, ast List<int>, links List<int>, facts List<int>, row int) int {
    let condition = child_with_role(pg, ast, links, row, "cond")
    let then_row = child_with_role(pg, ast, links, row, "then")
    let else_row = child_with_role(pg, ast, links, row, "else")
    if (condition < 0 || then_row < 0 || else_row < 0) { return type_branch() }
    let condition_type = facts.get(condition)
    if (condition_type == 0) { return 0 }
    if (condition_type != boolean_type()) { return type_condition() }
    let when_true = last_block_value(pg, ast, links, facts, then_row)
    let when_false = last_block_value(pg, ast, links, facts, else_row)
    if (when_true == 0 || when_false == 0) { return 0 }
    if (when_true != when_false) { return type_branch() }
    return when_true
}

fn array_type(pg List<int>, ast List<int>, links List<int>, facts List<int>, types List<int>, row int, auto_elements bool, fuel List<int>, deadline i64) int {
    let elements = child_with_role(pg, ast, links, row, "elems")
    if (elements < 0) { return type_empty_list() }
    var element_name = "expr"
    var tail_name = "array-elem-tail"
    if (auto_elements) {
        element_name = "auto-array-elem"
        tail_name = "auto-array-elem-tail"
    }
    let head = child_with_role(pg, ast, links, elements, "head")
    if (head < 0) { return type_empty_list() }
    let expected = facts.get(head)
    if (expected == 0) { return 0 }
    var at = next_sibling(links, head)
    for (at >= 0) {
        if (!take_step(fuel, deadline)) { return bind_budget() }
        if (kind(pg, ast, at) == tail_name) {
            let element = child_with_kind(pg, ast, links, at, element_name.clone())
            if (element < 0) { return type_value() }
            let actual = facts.get(element)
            if (actual == 0) { return 0 }
            if (actual != expected) { return type_value() }
        }
        at = next_sibling(links, at)
    }
    let result = intern_type(types, list_kind(), expected, 0, fuel, deadline)
    if (result < 0) { return bind_budget() }
    return result
}

fn wrapped_value(pg List<int>, ast List<int>, links List<int>, facts List<int>, row int) int {
    let value = child_with_role(pg, ast, links, row, "value")
    if (value >= 0) { return facts.get(value) }
    let first = first_child(links, row)
    if (first < 0) { return 0 }
    let start_kind = kind(pg, ast, first)
    if (start_kind == "lparen") {
        let inner = next_sibling(links, first)
        if (inner >= 0) { return facts.get(inner) }
        return 0
    }
    if (start_kind == "minus" || start_kind == "bang") {
        let inner = next_sibling(links, first)
        if (inner < 0) { return 0 }
        let inner_type = facts.get(inner)
        if (inner_type == 0) { return 0 }
        if (start_kind == "bang" && inner_type != boolean_type()) { return type_operator() }
        if (start_kind == "minus" && !numeric_type(inner_type)) { return type_operator() }
        return inner_type
    }
    return facts.get(first)
}

fn member_definition(pg List<int>, ast List<int>, src List<int>, declarations List<int>, owner int, token int, static_receiver bool, fuel List<int>, deadline i64) int {
    let name = spelling(src, ast, token)
    let end = end_of(ast, owner)
    var row = owner + 1
    for (row < row_count(ast) && start_of(ast, row) < end) {
        if (!take_step(fuel, deadline)) { return bind_budget() }
        let category = decl_category(declarations, row)
        if (category == field_decl() || category == method_decl()) {
            let form = parent(ast, row)
            var enclosing_type = field_owner(ast, row)
            if (category == method_decl() && enclosing_type >= 0) { enclosing_type = parent(ast, enclosing_type) }
            if (enclosing_type == owner && spelling(src, ast, decl_name(declarations, row)) == name) {
                if (category == field_decl() && !static_receiver) { return row }
                if (category == method_decl()) {
                    let is_static = kind(pg, ast, form) == "static-method"
                    if (is_static == static_receiver) { return row }
                }
            }
        }
        row = row + 1
    }
    return type_member()
}

fn postfix_type(pg List<int>, ast List<int>, links List<int>, src List<int>, declarations List<int>, uses List<int>, facts List<int>, types List<int>, row int, fuel List<int>, deadline i64) int {
    let atom = first_child(links, row)
    if (atom < 0) { return 0 }
    var current = facts.get(atom)
    if (current == 0) { return 0 }
    let identifier = first_child(links, atom)
    var static_receiver = false
    if (identifier >= 0 && uses.get(identifier) >= 0) {
        let reference = uses.get(identifier)
        let category = decl_category(declarations, reference)
        if (category == function_decl()) { return current }
        static_receiver = category == type_decl()
    }
    var step = next_sibling(links, atom)
    for (step >= 0) {
        let token = child_with_role(pg, ast, links, step, "member")
        if (token < 0 || type_kind(types, current) != nominal_kind()) { return 0 }
        let owner = type_first(types, current)
        let member = member_definition(pg, ast, src, declarations, owner, token, static_receiver, fuel, deadline)
        if (member < 0) { return member }
        uses.set(token, member)
        if (decl_category(declarations, member) == method_decl()) {
            current = signature(pg, ast, links, facts, types, member, fuel, deadline)
        } else {
            current = facts.get(member)
        }
        if (current <= 0) { return current }
        static_receiver = false
        step = next_sibling(links, step)
    }
    return current
}

fn foreign_source_type(lane int, types List<int>, fuel List<int>, deadline i64) int {
    if (foreign_handle_lane(lane)) { return integer_type() }
    if (lane == foreign_callback_lane()) {
        var callback_params = List<int>.new()
        callback_params.push(integer_type())
        callback_params.push(integer_type())
        let chain = intern_sequence(types, callback_params, fuel, deadline)
        if (chain < 0) { return bind_budget() }
        let callback = intern_type(types, function_kind(), integer_type(), chain, fuel, deadline)
        if (callback < 0) { return bind_budget() }
        return callback
    }
    return lane
}

fn foreign_record_type(ast List<int>, src List<int>, declarations List<int>, facts List<int>, types List<int>, layouts List<int>, layout int, occurrence int, fuel List<int>, deadline i64) int {
    let limit = layout + 2 + layouts.get(layout)
    let name = span_text(layouts, layout + 2, limit)
    let origin = source_id(ast, occurrence)
    var definition = 0
    for (definition < row_count(ast)) {
        if (!take_step(fuel, deadline)) { return bind_budget() }
        if (source_id(ast, definition) == origin && decl_category(declarations, definition) == type_decl()) {
            let source_name = spelling(src, ast, decl_name(declarations, definition))
            let lane = facts.get(definition)
            if (source_name == name && lane > 0 && type_kind(types, lane) == nominal_kind() && type_first(types, lane) == definition) {
                var fields = List<int>.new()
                let indexed = record_fields(ast, declarations, definition, fields, fuel, deadline)
                if (indexed != 0) { return indexed }
                if (fields.len() != layouts.get(layout + 1)) { return foreign_layout_error() }
                var slot = 0
                var at = limit
                for (slot < fields.len()) {
                    if (!take_step(fuel, deadline)) { return bind_budget() }
                    let field_row = fields.get(slot)
                    let next = at + 2 + layouts.get(at)
                    let expected = span_text(layouts, at + 2, next)
                    let actual = spelling(src, ast, decl_name(declarations, field_row))
                    if (facts.get(field_row) != layouts.get(at + 1) || actual != expected) { return foreign_layout_error() }
                    at = next
                    slot = slot + 1
                }
                return lane
            }
        }
        definition = definition + 1
    }
    return foreign_layout_error()
}

fn foreign_callable(external List<int>, at int, ast List<int>, src List<int>, declarations List<int>, facts List<int>, types List<int>, layouts List<int>, occurrence int, fuel List<int>, deadline i64) int {
    var lanes = List<int>.new()
    let count = external.get(at + 1)
    var index = 0
    for (index < count) {
        if (!take_step(fuel, deadline)) { return bind_budget() }
        let descriptor = external.get(at + index + 2)
        let record = foreign_record_index(descriptor)
        var lane = 0
        if (record >= 0) {
            lane = foreign_record_type(ast, src, declarations, facts, types, layouts, record, occurrence, fuel, deadline)
        } else {
            lane = foreign_source_type(descriptor, types, fuel, deadline)
        }
        if (lane == foreign_pending_lane()) { return 0 }
        if (lane < 0) { return lane }
        lanes.push(lane)
        index = index + 1
    }
    let sequence = intern_sequence(types, lanes, fuel, deadline)
    if (sequence < 0) { return bind_budget() }
    let result = foreign_source_type(external.get(at), types, fuel, deadline)
    if (result == foreign_pending_lane()) { return 0 }
    if (result < 0) { return result }
    let callable = intern_type(types, function_kind(), result, sequence, fuel, deadline)
    if (callable < 0) { return bind_budget() }
    return callable
}

pub fn text_length_receiver(pg List<int>, ast List<int>, links List<int>, src List<int>, facts List<int>, call int) int {
    let postfix = call_postfix(pg, ast, links, call)
    if (postfix < 0) { return -1 }
    let receiver = first_child(links, postfix)
    if (receiver < 0) { return -1 }
    let input = facts.get(receiver)
    if (input != text_view_type() && input != owned_text_type()) { return -1 }
    let step = next_sibling(links, receiver)
    if (step < 0 || next_sibling(links, step) >= 0) { return -1 }
    let member = child_with_role(pg, ast, links, step, "member")
    if (member < 0 || spelling(src, ast, member) != "len") { return -1 }
    return receiver
}

pub fn record_constructor(pg List<int>, ast List<int>, links List<int>, declarations List<int>, uses List<int>, facts List<int>, types List<int>, call int) int {
    let name = direct_callee(pg, ast, links, call)
    if (name < 0) { return -1 }
    let target = uses.get(name)
    if (target < 0 || decl_category(declarations, target) != type_decl()) { return -1 }
    let lane = facts.get(target)
    if (lane <= 0 || type_kind(types, lane) != nominal_kind()) { return -1 }
    return type_first(types, lane)
}

fn derive(pg List<int>, ast List<int>, links List<int>, src List<int>, declarations List<int>, uses List<int>, external List<int>, foreign_layouts List<int>, facts List<int>, types List<int>, row int, fuel List<int>, deadline i64) int {
    let node_kind = kind(pg, ast, row)
    let category = decl_category(declarations, row)
    if (initializer_category(category)) {
        let value = child_with_role(pg, ast, links, row, "value")
        if (value >= 0) { return facts.get(value) }
        return 0
    }
    if (node_kind == "ident") {
        let target = uses.get(row)
        let foreign = external_signature(target)
        if (foreign >= 0) { return foreign_callable(external, foreign, ast, src, declarations, facts, types, foreign_layouts, row, fuel, deadline) }
        if (target < 0) { return 0 }
        if (function_category(decl_category(declarations, target))) {
            return signature(pg, ast, links, facts, types, target, fuel, deadline)
        }
        return facts.get(target)
    }
    if (node_kind == "call") {
        if (text_length_receiver(pg, ast, links, src, facts, row) >= 0) { return integer_type() }
        let owner = record_constructor(pg, ast, links, declarations, uses, facts, types, row)
        if (owner >= 0) { return facts.get(owner) }
        let callee = direct_callee(pg, ast, links, row)
        if (callee < 0) { return 0 }
        let foreign = external_signature(uses.get(callee))
        if (foreign >= 0 && facts.get(callee) == 0) { return foreign_signature_error() }
        let postfix = call_postfix(pg, ast, links, row)
        let callable = facts.get(postfix)
        if (callable == 0) { return 0 }
        if (type_kind(types, callable) != function_kind()) { return type_argument() }
        return type_first(types, callable)
    }
    if (node_kind == "tuple-lit") {
        let result = tuple_type(pg, ast, links, facts, types, row, true, fuel, deadline)
        if (result < 0) { return bind_budget() }
        return result
    }
    if (node_kind == "array-lit" || node_kind == "auto-array-lit") {
        return array_type(pg, ast, links, facts, types, row, node_kind == "auto-array-lit", fuel, deadline)
    }
    if (node_kind == "empty-array-lit") { return type_empty_list() }
    if (node_kind == "auto-array-elem") {
        let value = first_child(links, row)
        if (value < 0) { return 0 }
        return facts.get(value)
    }
    if (node_kind == "array-conditional-elem") {
        let test = child_with_role(pg, ast, links, row, "cond")
        let value = child_with_role(pg, ast, links, row, "value")
        if (test < 0 || value < 0) { return type_value() }
        let condition = facts.get(test)
        if (condition == 0) { return 0 }
        if (condition != boolean_type()) { return type_condition() }
        return facts.get(value)
    }
    if (node_kind == "postfix-expr" || node_kind == "condition-postfix") {
        return postfix_type(pg, ast, links, src, declarations, uses, facts, types, row, fuel, deadline)
    }
    if (node_kind == "if-value") { return conditional_value(pg, ast, links, facts, row) }
    if (matching_operator(node_kind.clone())) { return binary_type(pg, ast, links, facts, row, node_kind) }
    if (value_wrapper(node_kind.clone())) { return wrapped_value(pg, ast, links, facts, row) }
    return literal_type(src, ast, row, node_kind, fuel, deadline)
}

fn enclosing_function(ast List<int>, declarations List<int>, row int) int {
    var at = parent(ast, row)
    for (at >= 0) {
        if (function_category(decl_category(declarations, at))) { return at }
        at = parent(ast, at)
    }
    return -1
}

fn tail_expression(pg List<int>, ast List<int>, links List<int>, function int) int {
    let body = child_with_role(pg, ast, links, function, "body")
    if (body < 0) { return -1 }
    var child = first_child(links, body)
    var tail = -1
    for (child >= 0) {
        if (kind(pg, ast, child) == "stmt") { tail = first_child(links, child) }
        child = next_sibling(links, child)
    }
    if (tail >= 0 && kind(pg, ast, tail) == "expr-stmt") {
        return child_with_role(pg, ast, links, tail, "value")
    }
    return -1
}

fn simple_name(pg List<int>, ast List<int>, links List<int>, start int) int {
    var row = start
    for (row >= 0) {
        let node_kind = kind(pg, ast, row)
        if (node_kind == "ident") { return row }
        if (!value_wrapper(node_kind)) { return -1 }
        let child = first_child(links, row)
        if (child < 0 || next_sibling(links, child) >= 0) { return -1 }
        row = child
    }
    return -1
}

fn foreign_call(pg List<int>, ast List<int>, links List<int>, uses List<int>, row int) int {
    let name = direct_callee(pg, ast, links, row)
    if (name < 0) { return -1 }
    return external_signature(uses.get(name))
}

// Handles use an Int source lane. Keep the credential alongside the regular
// type facts so a scalar bit pattern cannot satisfy an opaque provider lane.
fn handle_origin(pg List<int>, ast List<int>, links List<int>, declarations List<int>, uses List<int>, external List<int>, handles List<int>, row int) int {
    let category = decl_category(declarations, row)
    if (category == local_let_decl()) {
        let initializer = child_with_role(pg, ast, links, row, "value")
        if (initializer >= 0) { return handles.get(initializer) }
        return 0
    }
    let node_kind = kind(pg, ast, row)
    if (node_kind == "ident") {
        let target = uses.get(row)
        if (target >= 0 && decl_category(declarations, target) == local_let_decl()) { return handles.get(target) }
        return 0
    }
    if (node_kind == "call") {
        let at = foreign_call(pg, ast, links, uses, row)
        if (at >= 0 && foreign_handle_lane(external.get(at))) { return external.get(at) }
        return 0
    }
    if (value_wrapper(node_kind)) {
        let child = first_child(links, row)
        if (child >= 0 && next_sibling(links, child) < 0) { return handles.get(child) }
    }
    return 0
}

fn validate_foreign_resources(pg List<int>, ast List<int>, links List<int>, declarations List<int>, uses List<int>, external List<int>, errors List<int>, fuel List<int>, deadline i64) int {
    if (external.len() == 0) { return 0 }
    let rows = row_count(ast)
    var handles = List<int>.new()
    var row = 0
    for (row < rows) {
        handles.push(0)
        row = row + 1
    }
    var changed = true
    for (changed) {
        changed = false
        row = rows - 1
        for (row >= 0) {
            if (!take_step(fuel, deadline)) { return failure(errors, row, bind_budget()) }
            if (handles.get(row) == 0) {
                let origin = handle_origin(pg, ast, links, declarations, uses, external, handles, row)
                if (origin != 0) {
                    handles.set(row, origin)
                    changed = true
                }
            }
            row = row - 1
        }
    }
    row = 0
    for (row < rows) {
        if (!take_step(fuel, deadline)) { return failure(errors, row, bind_budget()) }
        if (kind(pg, ast, row) == "call") {
            let at = foreign_call(pg, ast, links, uses, row)
            if (at >= 0) {
                let arguments = call_args(pg, ast, links, row)
                var index = 0
                var part = first_child(links, arguments)
                for (part >= 0) {
                    if (!take_step(fuel, deadline)) { return failure(errors, part, bind_budget()) }
                    var argument = -1
                    let shape = kind(pg, ast, part)
                    if (shape == "arg") { argument = part }
                    if (shape == "arg-tail") { argument = child_with_kind(pg, ast, links, part, "arg") }
                    if (argument >= 0) {
                        let value = first_child(links, argument)
                        let lane = external.get(at + index + 2)
                        if (foreign_handle_lane(lane) && handles.get(value) != lane) {
                            return failure(errors, value, foreign_handle_error())
                        }
                        if (lane == foreign_callback_lane()) {
                            let name = simple_name(pg, ast, links, value)
                            if (name < 0 || uses.get(name) < 0 || decl_category(declarations, uses.get(name)) != function_decl()) {
                                return failure(errors, value, foreign_callback_error())
                            }
                        }
                        index = index + 1
                    }
                    part = next_sibling(links, part)
                }
            }
        }
        row = row + 1
    }
    return 0
}

fn seed_call_types(pg List<int>, ast List<int>, links List<int>, declarations List<int>, uses List<int>, mappings List<int>, facts List<int>, errors List<int>, fuel List<int>, deadline i64) int {
    var changed = 0
    var edge = 0
    for (edge < mappings.len()) {
        let arg = mappings.get(edge + 1)
        if (!take_step(fuel, deadline)) { return failure(errors, arg, bind_budget()) }
        let actual = facts.get(arg)
        if (actual != 0) {
            let function = resolved_function(pg, ast, links, declarations, uses, mappings.get(edge))
            if (function >= 0) {
                let parameters = call_parameter_slots(pg, ast, links, function)
                let parameter = parameters.get(mappings.get(edge + 2))
                if (facts.get(parameter) == 0) {
                    facts.set(parameter, actual)
                    changed = 1
                }
            }
        }
        edge = edge + call_mapping_stride()
    }
    return changed
}

fn seed_body_types(pg List<int>, ast List<int>, links List<int>, declarations List<int>, uses List<int>, implicit_results List<int>, facts List<int>, errors List<int>, fuel List<int>, deadline i64) int {
    var changed = 0
    var row = 0
    for (row < row_count(ast)) {
        if (!take_step(fuel, deadline)) { return failure(errors, row, bind_budget()) }
        let node_kind = kind(pg, ast, row)
        let tail = implicit_results.get(row)
        if (tail >= 0 && facts.get(row) == 0 && facts.get(tail) != 0) {
            facts.set(row, facts.get(tail))
            changed = 1
        }
        if (node_kind == "return-stmt") {
            let value = child_with_role(pg, ast, links, row, "value")
            let function = enclosing_function(ast, declarations, row)
            if (value >= 0 && function >= 0) {
                let actual = facts.get(value)
                let result = facts.get(function)
                if (actual != 0 && result == 0) {
                    facts.set(function, actual)
                    changed = 1
                }
                if (actual == 0 && result != 0) {
                    let name = simple_name(pg, ast, links, value)
                    if (name >= 0) {
                        let definition = uses.get(name)
                        if (definition >= 0 && decl_category(declarations, definition) == parameter_decl() && facts.get(definition) == 0) {
                            facts.set(definition, result)
                            changed = 1
                        }
                    }
                }
            }
        }
        row = row + 1
    }
    return changed
}

fn validate_indirect(pg List<int>, ast List<int>, links List<int>, facts List<int>, types List<int>, row int, errors List<int>, fuel List<int>, deadline i64) int {
    let postfix = call_postfix(pg, ast, links, row)
    if (postfix < 0 || facts.get(postfix) == 0) { return failure(errors, row, type_unknown()) }
    let callable = facts.get(postfix)
    if (type_kind(types, callable) != function_kind()) { return failure(errors, row, type_argument()) }
    var chain = type_second(types, callable)
    let arguments = call_args(pg, ast, links, row)
    if (arguments < 0) { return failure(errors, row, type_argument()) }
    var child = first_child(links, arguments)
    for (child >= 0) {
        if (!take_step(fuel, deadline)) { return failure(errors, child, bind_budget()) }
        let node_kind = kind(pg, ast, child)
        var arg = -1
        if (node_kind == "arg") { arg = child }
        if (node_kind == "arg-tail") { arg = child_with_kind(pg, ast, links, child, "arg") }
        if (arg >= 0) {
            let value = first_child(links, arg)
            if (value < 0 || chain == 0 || kind(pg, ast, value) == "named-arg") { return failure(errors, arg, type_argument()) }
            if (facts.get(value) != type_first(types, chain)) { return failure(errors, value, type_argument()) }
            chain = type_second(types, chain)
        }
        child = next_sibling(links, child)
    }
    if (chain != 0) { return failure(errors, row, type_argument()) }
    return 0
}

fn validate(pg List<int>, ast List<int>, links List<int>, src List<int>, declarations List<int>, uses List<int>, mappings List<int>, facts List<int>, types List<int>, errors List<int>, fuel List<int>, deadline i64) int {
    var row = 0
    for (row < row_count(ast)) {
        if (!take_step(fuel, deadline)) { return failure(errors, row, bind_budget()) }
        let node_kind = kind(pg, ast, row)
        let category = decl_category(declarations, row)
        if ((function_category(category) || category == parameter_decl()) && facts.get(row) == 0) {
            return failure(errors, row, type_unknown())
        }
        if (initializer_category(category) || node_kind == "return-stmt" || node_kind == "assign-stmt") {
            let value = child_with_role(pg, ast, links, row, "value")
            let actual = facts.get(value)
            if (actual == 0) { return failure(errors, value, type_unknown()) }
            var expected = facts.get(row)
            var code = type_value()
            if (node_kind == "return-stmt") {
                let function = enclosing_function(ast, declarations, row)
                if (function >= 0) { expected = facts.get(function) }
                code = type_return()
            }
            if (node_kind == "assign-stmt") {
                let name = child_with_role(pg, ast, links, row, "name")
                let target = uses.get(name)
                expected = facts.get(target)
            }
            if (actual != expected) { return failure(errors, value, code) }
        }
        if (node_kind == "if-stmt" || node_kind == "for-cond-stmt") {
            let condition = child_with_role(pg, ast, links, row, "cond")
            if (condition >= 0 && facts.get(condition) != boolean_type()) { return failure(errors, condition, type_condition()) }
        }
        if (node_kind == "expr-stmt" && facts.get(row) == 0) { return failure(errors, row, type_unknown()) }
        if (node_kind == "call" && resolved_function(pg, ast, links, declarations, uses, row) < 0 && record_constructor(pg, ast, links, declarations, uses, facts, types, row) < 0) {
            if (text_length_receiver(pg, ast, links, src, facts, row) >= 0) {
                let arguments = call_args(pg, ast, links, row)
                if (arguments < 0 || child_with_kind(pg, ast, links, arguments, "arg") >= 0 || child_with_kind(pg, ast, links, arguments, "arg-tail") >= 0) {
                    return failure(errors, row, type_argument())
                }
            } else {
                let status = validate_indirect(pg, ast, links, facts, types, row, errors, fuel, deadline)
                if (status != 0) { return status }
            }
        }
        row = row + 1
    }
    row = 0
    for (row < mappings.len()) {
        let call = mappings.get(row)
        let argument = mappings.get(row + 1)
        let slot = mappings.get(row + 2)
        if (!take_step(fuel, deadline)) { return failure(errors, argument, bind_budget()) }
        let function = resolved_function(pg, ast, links, declarations, uses, call)
        var params = List<int>.new()
        if (function >= 0) {
            params = call_parameter_slots(pg, ast, links, function)
        } else {
            let owner = record_constructor(pg, ast, links, declarations, uses, facts, types, call)
            if (owner < 0) { return failure(errors, call, type_argument()) }
            let loaded = record_fields(ast, declarations, owner, params, fuel, deadline)
            if (loaded != 0) { return failure(errors, call, loaded) }
        }
        if (slot < 0 || slot >= params.len()) { return failure(errors, call, type_argument()) }
        let expected = facts.get(params.get(slot))
        let actual = facts.get(argument)
        if (actual == 0) { return failure(errors, argument, type_unknown()) }
        if (actual != expected) { return failure(errors, argument, type_argument()) }
        row = row + call_mapping_stride()
    }
    return 0
}

fn map_deferred_calls(pg List<int>, ast List<int>, links List<int>, src List<int>, declarations List<int>, uses List<int>, facts List<int>, types List<int>, mappings List<int>, errors List<int>, fuel List<int>, deadline i64) int {
    var row = 0
    for (row < row_count(ast)) {
        if (!take_step(fuel, deadline)) { return failure(errors, row, bind_budget()) }
        if (kind(pg, ast, row) == "call") {
            let target = resolved_function(pg, ast, links, declarations, uses, row)
            if (target >= 0 && decl_category(declarations, target) == method_decl()) {
                let status = map_call(pg, ast, links, src, row, target, declarations, mappings, errors, fuel, deadline)
                if (status != 0) { return status }
            }
            let owner = record_constructor(pg, ast, links, declarations, uses, facts, types, row)
            if (owner >= 0) {
                var fields = List<int>.new()
                let indexed = record_fields(ast, declarations, owner, fields, fuel, deadline)
                if (indexed != 0) { return failure(errors, row, indexed) }
                let mapped = map_argument_slots(pg, ast, links, src, row, fields, declarations, mappings, errors, fuel, deadline)
                if (mapped != 0) { return mapped }
            }
        }
        row = row + 1
    }
    return 0
}

pub fn infer_source(pg List<int>, ast List<int>, links List<int>, src List<int>, declarations List<int>, uses List<int>, mappings List<int>, external List<int>, foreign_layouts List<int>, facts List<int>, types List<int>, errors List<int>, fuel List<int>, deadline i64) int {
    let count = row_count(ast)
    var row = 0
    var explicit_returns = List<int>.new()
    var implicit_results = List<int>.new()
    for (row < count) {
        facts.push(0)
        explicit_returns.push(0)
        implicit_results.push(-1)
        row = row + 1
    }
    init_types(types)
    if (annotation_types(pg, ast, links, src, declarations, uses, facts, types, errors, fuel, deadline) != 0) { return bind_budget() }
    row = 0
    for (row < count) {
        if (!take_step(fuel, deadline)) { return failure(errors, row, bind_budget()) }
        if (kind(pg, ast, row) == "return-stmt") {
            let function = enclosing_function(ast, declarations, row)
            if (function >= 0) { explicit_returns.set(function, 1) }
        }
        row = row + 1
    }
    row = 0
    for (row < count) {
        if (!take_step(fuel, deadline)) { return failure(errors, row, bind_budget()) }
        let category = decl_category(declarations, row)
        if (category != 0) {
            let annotation = annotation_of(pg, ast, links, row)
            if (annotation >= 0) {
                let type_id = facts.get(annotation)
                if (type_id == 0) { return failure(errors, annotation, type_unknown()) }
                facts.set(row, type_id)
            } else {
                if (function_category(category) && explicit_returns.get(row) == 0) {
                    let tail = tail_expression(pg, ast, links, row)
                    if (tail >= 0) {
                        implicit_results.set(row, tail)
                    } else {
                        facts.set(row, unit_type())
                    }
                }
                if (category == type_decl()) {
                    let alias_site = alias_target(pg, ast, links, row)
                    if (alias_site >= 0 && facts.get(row) == 0) { return failure(errors, alias_site, type_unknown()) }
                }
            }
        }
        row = row + 1
    }
    var changed = true
    for (changed) {
        changed = false
        row = count - 1
        for (row >= 0) {
            if (!take_step(fuel, deadline)) { return failure(errors, row, bind_budget()) }
            if (facts.get(row) == 0) {
                let type_id = derive(pg, ast, links, src, declarations, uses, external, foreign_layouts, facts, types, row, fuel, deadline)
                if (type_id < 0) { return failure(errors, row, type_id) }
                if (type_id > 0) {
                    facts.set(row, type_id)
                    changed = true
                }
            }
            row = row - 1
        }
        let calls = seed_call_types(pg, ast, links, declarations, uses, mappings, facts, errors, fuel, deadline)
        if (calls < 0) { return calls }
        let bodies = seed_body_types(pg, ast, links, declarations, uses, implicit_results, facts, errors, fuel, deadline)
        if (bodies < 0) { return bodies }
        if (calls != 0 || bodies != 0) { changed = true }
    }
    let calls = map_deferred_calls(pg, ast, links, src, declarations, uses, facts, types, mappings, errors, fuel, deadline)
    if (calls != 0) { return calls }
    let checked = validate(pg, ast, links, src, declarations, uses, mappings, facts, types, errors, fuel, deadline)
    if (checked != 0) { return checked }
    return validate_foreign_resources(pg, ast, links, declarations, uses, external, errors, fuel, deadline)
}
