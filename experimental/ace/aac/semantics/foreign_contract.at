use app.binding.bind_budget
use app.binding.take_step
use app.digest.blake3_hex_bytes
use app.foreign_json.foreign_field_kind
use app.foreign_json.foreign_field_text
use app.foreign_json.foreign_field_true
use app.syntax_frontend.str_to_bytes
use app.types.boolean_type
use app.types.char_type
use app.types.f64_type
use app.types.i64_type
use app.types.integer_type
use app.types.text_view_type
use app.types.u32_type
use app.types.u64_type
use app.types.unit_type
use std.conv.from_int

pub fn foreign_authority_error() int { return -37 }
pub fn foreign_signature_error() int { return -38 }
pub fn foreign_provider_error() int { return -39 }
pub fn foreign_handle_error() int { return -44 }
pub fn foreign_callback_error() int { return -45 }
pub fn foreign_layout_error() int { return -46 }
pub fn foreign_callback_lane() int { return -1 }
pub fn foreign_pending_lane() int { return -2 }
pub fn foreign_handle_lane(lane int) bool { return lane <= -1000000 }
pub fn foreign_record_index(lane int) int {
    if (lane > -1000 || foreign_handle_lane(lane)) { return -1 }
    return -1000 - lane
}

fn language_lane(lane Str) int {
    if (lane == "I32") { return integer_type() }
    if (lane == "U32") { return u32_type() }
    if (lane == "I64") { return i64_type() }
    if (lane == "U64") { return u64_type() }
    if (lane == "F64") { return f64_type() }
    if (lane == "Bool") { return boolean_type() }
    if (lane == "Char") { return char_type() }
    if (lane == "ViewText") { return text_view_type() }
    return 0
}

fn lane_at(page List<int>, path Str, provider Str, owner int, resource bool) int {
    let scalar = language_lane(foreign_field_text(page, path.clone()))
    if (scalar > 0) {
        if (resource && (scalar == i64_type() || scalar == u64_type())) { return integer_type() }
        return scalar
    }
    if (!resource) { return 0 }
    let handle = path.clone() + ".Handle.provider"
    if (foreign_field_kind(page, handle.clone()) == 4) {
        if (foreign_field_text(page, handle) != provider) { return foreign_pending_lane() }
        return -1000000 - owner
    }
    if (foreign_field_kind(page, path.clone() + ".Callback") == 6) { return foreign_callback_lane() }
    return foreign_pending_lane()
}

fn append_name(target List<int>, name List<int>, fuel List<int>, deadline i64) bool {
    var index = 0
    for (index < name.len()) {
        if (!take_step(fuel, deadline)) { return false }
        target.push(name.get(index))
        index = index + 1
    }
    return true
}

// Record layout table: name length, field count, record-name bytes, then
// each field's name length, source type and name bytes in ABI order.
fn bind_record_view(page List<int>, path Str, layouts List<int>, fuel List<int>, deadline i64) int {
    let access = foreign_field_text(page, path.clone() + ".role")
    if (access != "const") { return foreign_pending_lane() }
    let name = str_to_bytes(foreign_field_text(page, path.clone() + ".rec"))
    if (name.len() == 0) { return foreign_layout_error() }
    if (layouts.len() >= 999000) { return bind_budget() }
    let start = layouts.len()
    layouts.push(name.len())
    layouts.push(0)
    if (!append_name(layouts, name, fuel, deadline)) { return bind_budget() }
    let fields = path + ".fields"
    if (foreign_field_kind(page, fields.clone()) != 5) { return foreign_layout_error() }
    var index = 0
    for (take_step(fuel, deadline)) {
        let entry = fields.clone() + "." + from_int(index)
        let item = foreign_field_kind(page, entry.clone())
        if (item == 0) {
            layouts.set(start + 1, index)
            return -1000 - start
        }
        if (item != 5 || foreign_field_kind(page, entry.clone() + ".2") != 0) { return foreign_layout_error() }
        let label = str_to_bytes(foreign_field_text(page, entry.clone() + ".0"))
        let field_type = foreign_field_text(page, entry + ".1")
        var lane = 0
        if (field_type == "i32") { lane = integer_type() }
        if (field_type == "bool") { lane = boolean_type() }
        if (lane == 0 || label.len() == 0) { return foreign_layout_error() }
        layouts.push(label.len())
        layouts.push(lane)
        if (!append_name(layouts, label, fuel, deadline)) { return bind_budget() }
        index = index + 1
    }
    return bind_budget()
}

fn parameter_lanes(page List<int>, path Str, provider Str, owner int, resource bool, layouts List<int>, out List<int>, fuel List<int>, deadline i64) int {
    if (foreign_field_kind(page, path.clone()) != 5) { return foreign_signature_error() }
    var at = 0
    for (take_step(fuel, deadline)) {
        let lane_path = path.clone() + "." + from_int(at)
        if (foreign_field_kind(page, lane_path.clone()) == 0) { return 0 }
        let record_path = lane_path.clone() + ".Rec"
        var code = 0
        if (resource && foreign_field_kind(page, record_path.clone()) == 6) {
            code = bind_record_view(page, record_path, layouts, fuel, deadline)
            if (code == bind_budget() || code == foreign_layout_error()) { return code }
        } else {
            code = lane_at(page, lane_path, provider.clone(), owner, resource)
        }
        if (code == 0) { return foreign_signature_error() }
        out.push(code)
        at = at + 1
    }
    return bind_budget()
}

// SourceDecl is provided by the 967 admission host. Its current authority
// digest is independent of the transported bytes; swapping any physical
// layout, context, resource owner, or error model invalidates the page.
fn foreign_page_status(bytes List<int>, authority Str, fuel List<int>, deadline i64) int {
    if (!take_step(fuel, deadline) || bytes.len() > fuel.get(0)) { return bind_budget() }
    fuel.set(0, fuel.get(0) - bytes.len())
    if (authority.len() != 64 || blake3_hex_bytes(bytes) != authority) { return foreign_authority_error() }
    return 0
}

fn foreign_result(page List<int>, form Str, pure bool, resource bool, fn_path Str, provider Str, owner int) int {
    if (pure) {
        if (foreign_field_kind(page, fn_path + ".error_model") != 1) { return foreign_signature_error() }
        return lane_at(page, form + ".Pure.ret", provider, owner, resource)
    }
    let err = fn_path + ".error_model"
    if (foreign_field_text(page, err.clone() + ".kind") != "status-i32" || foreign_field_kind(page, err + ".codes.0") != 5) {
        return foreign_signature_error()
    }
    let fallible = form + ".Fallible"
    // Scalar/view calls here have no implicit source context argument.
    // Other context and multi-out forms require separate language facts.
    if (foreign_field_kind(page, fallible.clone() + ".ctx") != 1) { return foreign_signature_error() }
    if (resource) {
        let out = fallible + ".out"
        if (foreign_field_kind(page, out.clone()) == 1) { return unit_type() }
        return lane_at(page, out, provider, owner, resource)
    }
    let outs = fallible + ".outs"
    if (foreign_field_kind(page, outs.clone()) != 5 || foreign_field_kind(page, outs.clone() + ".1") != 0) {
        return foreign_signature_error()
    }
    if (foreign_field_kind(page, outs.clone() + ".0") == 0) { return unit_type() }
    return lane_at(page, outs + ".0", provider, owner, resource)
}

// For the scalar and noescape text-view contract, the source callable has
// precisely the admitted parameter lanes and success-result lane. The full
// original declaration remains the foreign consumer's authority.
fn project_signature(page List<int>, entry Str, provider Str, owner int, layouts List<int>, signature List<int>, fuel List<int>, deadline i64) int {
    let fn_path = entry + ".function"
    let resource_path = fn_path.clone() + ".resource"
    let resource = foreign_field_kind(page, resource_path.clone()) == 6
    var form = fn_path.clone() + ".form"
    if (resource) {
        if (foreign_field_text(page, resource_path.clone() + ".format") != "autoabi.contract.resource-sig/1") { return foreign_signature_error() }
        if (foreign_field_true(page, resource_path.clone() + ".typed_peer")) { return foreign_signature_error() }
        if (!foreign_field_true(page, resource_path.clone() + ".noescape")) { return foreign_signature_error() }
        form = resource_path.clone() + ".form"
    }
    let pure = foreign_field_kind(page, form.clone() + ".Pure") == 6
    if (!pure && foreign_field_kind(page, form.clone() + ".Fallible") != 6) { return foreign_signature_error() }
    let result = foreign_result(page, form.clone(), pure, resource, fn_path.clone(), provider.clone(), owner)
    if (result == 0 || result == foreign_signature_error()) { return foreign_signature_error() }
    var params = form + ".Fallible.params"
    if (pure) { params = fn_path.clone() + ".form.Pure.params" }
    if (resource) { params = resource_path + ".params" }
    let start = signature.len()
    signature.push(result)
    signature.push(0)
    let status = parameter_lanes(page, params, provider, owner, resource, layouts, signature, fuel, deadline)
    if (status != 0) { return status }
    signature.set(start + 1, signature.len() - start - 2)
    return 0
}

// Entries: module identity, signature offset, byte count, source name.
// Signatures: result type, parameter count, parameter types in slot order.
fn provider_language(page List<int>, entry Str, provider Str, language Str) bool {
    let logical = foreign_field_text(page, entry + ".logical")
    var family = "rust/"
    if (language == "c") { family = "c/" }
    let prefix = family + provider + "/"
    if (logical.len() <= prefix.len()) { return false }
    let matched = logical.slice(0, prefix.len()).clone() == prefix
    return matched
}

fn project_provider(page List<int>, provider Str, language Str, module_id int, names List<int>, signatures List<int>, layouts List<int>, fuel List<int>, deadline i64) int {
    if (page.len() == 0 || page.get(0) != 91) { return foreign_authority_error() }
    var index = 0
    var owner = -1
    var found = false
    for (take_step(fuel, deadline)) {
        let entry = from_int(index)
        if (foreign_field_kind(page, entry.clone()) == 0) {
            if (found) { return 0 }
            return foreign_provider_error()
        }
        if (foreign_field_text(page, entry.clone() + ".provider") == provider && provider_language(page, entry.clone(), provider.clone(), language.clone())) {
            let name = str_to_bytes(foreign_field_text(page, entry.clone() + ".name"))
            if (name.len() == 0) { return foreign_signature_error() }
            let start = signatures.len()
            if (owner < 0) { owner = index }
            let status = project_signature(page, entry, provider.clone(), owner, layouts, signatures, fuel, deadline)
            if (status != 0) { return status }
            names.push(module_id)
            names.push(start)
            names.push(name.len())
            if (!append_name(names, name, fuel, deadline)) { return bind_budget() }
            found = true
        }
        index = index + 1
    }
    return bind_budget()
}

pub fn admit_foreign_provider(bytes List<int>, authority Str, provider Str, language Str, module_id int, names List<int>, signatures List<int>, layouts List<int>, fuel List<int>, deadline i64) int {
    let trusted = foreign_page_status(bytes, authority, fuel, deadline)
    if (trusted != 0) { return trusted }
    return project_provider(bytes, provider, language, module_id, names, signatures, layouts, fuel, deadline)
}
