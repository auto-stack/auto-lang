pub fn hir_unsupported() int { return -30 }
pub fn hir_owner_error() int { return -31 }
pub fn hir_reference_error() int { return -32 }
pub fn hir_type_error() int { return -33 }
pub fn hir_shape_error() int { return -34 }
pub fn hir_initialization_error() int { return -40 }
pub fn hir_mutability_error() int { return -41 }
pub fn hir_global_authority_error() int { return -43 }
pub fn hir_borrow_error() int { return -47 }

fn constant_op() int { return 1 }
fn read_op() int { return 2 }
fn call_op() int { return 3 }
fn less_than_op() int { return 4 }
fn add_op() int { return 5 }
fn multiply_op() int { return 6 }
fn text_literal_op() int { return 7 }
fn text_length_op() int { return 8 }
fn record_constructor_op() int { return 9 }
fn record_field_op() int { return 10 }
fn record_view_op() int { return 11 }
fn initialize_op() int { return 1 }
fn assign_op() int { return 2 }
fn immutable_slot() int { return -1 }
fn mutable_slot() int { return -2 }

// Atom and Auto share these four escapes. Preserve exact UTF-8 source bytes
// for this subset, and reject other spellings before issuing verified HIR.
fn transport_text(src List<int>, start int, limit int, deadline i64, fuel List<int>) int {
    if (limit - start < 2 || src.get(start) != 34 || src.get(limit - 1) != 34) { return hir_unsupported() }
    var at = start + 1
    for (at < limit - 1) {
        if (!take_step(fuel, deadline)) { return bind_budget() }
        let octet = src.get(at)
        if (octet == 92) {
            at = at + 1
            if (at >= limit - 1) { return hir_unsupported() }
            let escape = src.get(at)
            if (escape != 34 && escape != 92 && escape != 110 && escape != 116) { return hir_unsupported() }
        } else {
            if (octet < 32 || octet == 34) { return hir_unsupported() }
        }
        at = at + 1
    }
    return 0
}

// Definition IDs and expression IDs are distinct even when they share an
// origin row. Each table carries its own owner and exact source-row identity.
// Definitions: (id, result type, body owner, entry block)
// Locals:      (owner, id, type, formal position or negative binding role)
// Expressions: (id, owner, op, result type, value/ref)
// Args:        (call expr, evaluation expr, formal position)
// Blocks:      (id, owner, condition, then block, else block, return expr)
// Statements:  (block, initialize/assign, local, evaluation expr)
type VerifiedCore {
    definitions int
}

fn failed(errors List<int>, row int, code int) int {
    errors.push(row)
    errors.push(code)
    return code
}

fn find_row(table List<int>, stride int, id int, field int) int {
    var pos = 0
    for (pos < table.len()) {
        if (table.get(pos + field) == id) { return pos }
        pos = pos + stride
    }
    return -1
}

fn has_budget(fuel List<int>, deadline i64, work int) bool {
    if (!take_step(fuel, deadline) || fuel.get(0) < work) { return false }
    fuel.set(0, fuel.get(0) - work)
    return true
}

fn append_expression(exprs List<int>, row int, owner int, op int, type_id int, data int) int {
    exprs.push(row)
    exprs.push(owner)
    exprs.push(op)
    exprs.push(type_id)
    exprs.push(data)
    return 0
}

fn add_expression(exprs List<int>, expression_ids List<int>, row int, owner int, op int, type_id int, data int) int {
    append_expression(exprs, row, owner, op, type_id, data)
    expression_ids.set(row, row)
    return 0
}

fn binary_inputs(args List<int>, expression int, lhs int, rhs int) int {
    args.push(expression)
    args.push(lhs)
    args.push(0)
    args.push(expression)
    args.push(rhs)
    args.push(1)
    return 0
}

fn source_binary(node_kind Str) int {
    if (node_kind == "lt") { return less_than_op() }
    if (node_kind == "plus") { return add_op() }
    if (node_kind == "star") { return multiply_op() }
    return 0
}

fn local_definition(category int) bool {
    return category == parameter_decl() || category == local_let_decl() || category == local_var_decl()
}

fn global_category(category int) bool {
    return category == constant_decl() || category == global_var_decl()
}

fn lower_field_chain(pg List<int>, ast List<int>, links List<int>, declarations List<int>, uses List<int>, facts List<int>, records List<int>, expressions List<int>, exprs List<int>, args List<int>, row int, owner int, fuel List<int>, deadline i64, errors List<int>) int {
    let receiver = first_child(links, row)
    if (receiver < 0 || expressions.get(receiver) < 0) { return 0 }
    var shape = facts.get(receiver)
    if (record_at(records, shape) < 0) { return 0 }
    var step = next_sibling(links, receiver)
    var value = expressions.get(receiver)
    for (step >= 0) {
        if (!take_step(fuel, deadline)) { return failed(errors, step, bind_budget()) }
        let member = child_with_role(pg, ast, links, step, "member")
        if (member < 0) { return failed(errors, step, hir_unsupported()) }
        let field = uses.get(member)
        if (field < 0 || decl_category(declarations, field) != field_decl()) { return failed(errors, step, hir_unsupported()) }
        let slot = record_field_number(records, shape, field)
        if (slot < 0) { return failed(errors, step, hir_reference_error()) }
        shape = facts.get(field)
        append_expression(exprs, step, owner, record_field_op(), shape, slot)
        args.push(step)
        args.push(value)
        args.push(0)
        value = step
        step = next_sibling(links, step)
    }
    expressions.set(row, value)
    return 0
}

fn lower_expressions(pg List<int>, ast List<int>, links List<int>, src List<int>, declarations List<int>, uses List<int>, mappings List<int>, facts List<int>, types List<int>, records List<int>, exprs List<int>, args List<int>, expressions List<int>, fuel List<int>, deadline i64, errors List<int>) int {
    var owners = List<int>.new()
    var scalar = List<int>.new()
    scalar.push(0)
    let count = row_count(ast)
    var row = 0
    for (row < row_count(ast)) {
        if (!take_step(fuel, deadline)) { return failed(errors, row, bind_budget()) }
        let outer = parent(ast, row)
        var owner = -1
        if (outer >= 0) { owner = owners.get(outer) }
        if (decl_category(declarations, row) == function_decl()) { owner = row }
        if (global_category(decl_category(declarations, row))) {
            owner = global_definition(count, row, initializer_mode())
        }
        owners.push(owner)
        expressions.push(-1)
        row = row + 1
    }
    row = row_count(ast) - 1
    for (row >= 0) {
        if (!take_step(fuel, deadline)) { return failed(errors, row, bind_budget()) }
        let owner = owners.get(row)
        let t = facts.get(row)
        if (owner >= 0 && core_value_type(records, t)) {
            let node_kind = kind(pg, ast, row)
            let binary = source_binary(node_kind.clone())
            if (binary != 0 && first_child(links, row) >= 0) {
                let left = first_child(links, row)
                let operator_token = next_sibling(links, left)
                if (operator_token < 0) { return failed(errors, row, hir_unsupported()) }
                let right = next_sibling(links, operator_token)
                if (right < 0 || expressions.get(left) < 0 || expressions.get(right) < 0) {
                    return failed(errors, row, hir_unsupported())
                }
                add_expression(exprs, expressions, row, owner, binary, t, 0)
                binary_inputs(args, row, expressions.get(left), expressions.get(right))
            }
            if (node_kind == "true-kw" || node_kind == "false-kw") {
                var value = 0
                if (node_kind == "true-kw") { value = 1 }
                let left = row_count(ast) + row * 2
                let right = left + 1
                append_expression(exprs, left, owner, constant_op(), integer_type(), 0)
                append_expression(exprs, right, owner, constant_op(), integer_type(), value)
                add_expression(exprs, expressions, row, owner, less_than_op(), t, 0)
                binary_inputs(args, row, left, right)
            }
            if (node_kind == "int-lit" || node_kind == "affix-num") {
                let negative = negative_source_literal(src, ast, row)
                let decoded = decode_i32_literal(src, start_of(ast, row), end_of(ast, row), negative, scalar, fuel, deadline)
                if (decoded == bind_budget()) { return failed(errors, row, decoded) }
                if (decoded != integer_type()) { return failed(errors, row, hir_unsupported()) }
                add_expression(exprs, expressions, row, owner, constant_op(), t, scalar.get(0))
            }
            if (node_kind == "int-literal") {
                let token = child_with_role(pg, ast, links, row, "value")
                if (token >= 0) { expressions.set(row, expressions.get(token)) }
            }
            if (node_kind == "str-lit") {
                let valid = transport_text(src, start_of(ast, row), end_of(ast, row), deadline, fuel)
                if (valid != 0) { return failed(errors, row, valid) }
                add_expression(exprs, expressions, row, owner, text_literal_op(), t, row)
            }
            if (node_kind == "ident") {
                let target = uses.get(row)
                let write = role(pg, ast, row) == "name" && kind(pg, ast, parent(ast, row)) == "assign-stmt"
                if (!write && target >= 0 && local_definition(decl_category(declarations, target))) {
                    add_expression(exprs, expressions, row, owner, read_op(), t, target)
                }
                if (!write && target >= 0 && global_category(decl_category(declarations, target))) {
                    let getter = global_definition(count, target, getter_mode())
                    add_expression(exprs, expressions, row, owner, call_op(), t, getter)
                }
            }
            if (node_kind == "call") {
                let receiver = text_length_receiver(pg, ast, links, src, facts, row)
                if (receiver >= 0) {
                    let operand = expressions.get(receiver)
                    if (operand < 0) { return failed(errors, row, hir_unsupported()) }
                    add_expression(exprs, expressions, row, owner, text_length_op(), t, operand)
                    args.push(row)
                    args.push(operand)
                    args.push(0)
                    row = row - 1
                    continue
                }
                var target = resolved_function(pg, ast, links, declarations, uses, row)
                var operation = call_op()
                if (record_constructor(pg, ast, links, declarations, uses, facts, types, row) >= 0) {
                    target = t
                    operation = record_constructor_op()
                }
                if (target < 0) { return failed(errors, row, hir_unsupported()) }
                var pos = 0
                for (pos < mappings.len()) {
                    if (!take_step(fuel, deadline)) { return failed(errors, row, bind_budget()) }
                    if (mappings.get(pos) == row) {
                        let source_arg = mappings.get(pos + 1)
                        var evaluation = expressions.get(source_arg)
                        if (evaluation < 0) { return failed(errors, row, hir_unsupported()) }
                        let lane = facts.get(source_arg)
                        if (operation == call_op() && record_at(records, lane) >= 0) {
                            let borrowed = count * 7 + source_arg
                            append_expression(exprs, borrowed, owner, record_view_op(), lane, evaluation)
                            args.push(borrowed)
                            args.push(evaluation)
                            args.push(0)
                            evaluation = borrowed
                        }
                        args.push(row)
                        args.push(evaluation)
                        args.push(mappings.get(pos + 2))
                    }
                    pos = pos + call_mapping_stride()
                }
                add_expression(exprs, expressions, row, owner, operation, t, target)
            }
            let expr_wrapper = node_kind == "expr" || node_kind == "unary-expr" || node_kind == "atom-expr" || node_kind == "postfix-expr"
            let cond_wrapper = node_kind == "if-cond" || node_kind == "condition-expr" || node_kind == "condition-unary" || node_kind == "condition-postfix" || node_kind == "condition-atom"
            if (node_kind == "postfix-expr" || node_kind == "condition-postfix") {
                let status = lower_field_chain(pg, ast, links, declarations, uses, facts, records, expressions, exprs, args, row, owner, fuel, deadline, errors)
                if (status != 0) { return status }
            }
            if (expr_wrapper || cond_wrapper) {
                let child = first_child(links, row)
                if (child >= 0 && next_sibling(links, child) < 0) {
                    expressions.set(row, expressions.get(child))
                }
            }
        }
        row = row - 1
    }
    return 0
}

fn append_global_write(count int, source int, global int, owner int, value int, exprs List<int>, args List<int>) int {
    let node = global_effect_node(count, source)
    let setter = global_definition(count, global, setter_mode())
    append_expression(exprs, node, owner, call_op(), integer_type(), setter)
    args.push(node)
    args.push(value)
    args.push(0)
    return node
}

fn lower_block_prefix(pg List<int>, ast List<int>, links List<int>, declarations List<int>, uses List<int>, expression_ids List<int>, body int, start int, owner int, locals List<int>, exprs List<int>, args List<int>, statements List<int>, fuel List<int>, deadline i64, errors List<int>) int {
    var child = start
    for (child >= 0) {
        let node_kind = kind(pg, ast, child)
        if (node_kind == "stmt") {
            if (!take_step(fuel, deadline)) { return failed(errors, child, bind_budget()) }
            let stmt = first_child(links, child)
            if (stmt < 0) { return failed(errors, child, hir_unsupported()) }
            let category = decl_category(declarations, stmt)
            var op = 0
            var local = stmt
            if (category == local_let_decl() || category == local_var_decl()) { op = initialize_op() }
            if (kind(pg, ast, stmt) == "assign-stmt") {
                let target = child_with_role(pg, ast, links, stmt, "name")
                if (target < 0) { return failed(errors, stmt, hir_reference_error()) }
                local = uses.get(target)
                if (local < 0) { return failed(errors, stmt, hir_reference_error()) }
                let resolved = decl_category(declarations, local)
                if (resolved != local_var_decl() && resolved != global_var_decl()) { return failed(errors, stmt, hir_mutability_error()) }
                op = assign_op()
            }
            if (op == 0) { return stmt }
            let value = child_with_role(pg, ast, links, stmt, "value")
            if (value < 0 || expression_ids.get(value) < 0) { return failed(errors, stmt, hir_unsupported()) }
            var evaluated = expression_ids.get(value)
            if (op == assign_op() && decl_category(declarations, local) == global_var_decl()) {
                evaluated = append_global_write(row_count(ast), stmt, local, owner, evaluated, exprs, args)
                local = evaluated
                op = initialize_op()
                locals.push(owner)
                locals.push(local)
                locals.push(integer_type())
                locals.push(immutable_slot())
            }
            statements.push(body)
            statements.push(op)
            statements.push(local)
            statements.push(evaluated)
        }
        child = next_sibling(links, child)
    }
    return failed(errors, body, hir_unsupported())
}

fn lower_blocks(pg List<int>, ast List<int>, links List<int>, declarations List<int>, uses List<int>, expression_ids List<int>, body int, owner int, infer_return bool, locals List<int>, exprs List<int>, args List<int>, blocks List<int>, statements List<int>, fuel List<int>, deadline i64, errors List<int>) int {
    var pending = List<int>.new()
    pending.push(body)
    pending.push(first_child(links, body))
    for (pending.len() > 0) {
        let cursor = pending.remove(pending.len() - 1)
        let block = pending.remove(pending.len() - 1)
        if (!take_step(fuel, deadline)) { return failed(errors, block, bind_budget()) }
        let statement = lower_block_prefix(pg, ast, links, declarations, uses, expression_ids, block, cursor, owner, locals, exprs, args, statements, fuel, deadline, errors)
        if (statement < 0) { return statement }
        let lexical_list = parent(ast, statement)
        var rest = next_sibling(links, lexical_list)
        for (rest >= 0 && kind(pg, ast, rest) != "stmt") {
            if (!take_step(fuel, deadline)) { return failed(errors, rest, bind_budget()) }
            rest = next_sibling(links, rest)
        }
        let form = kind(pg, ast, statement)
        var condition = -1
        var yes = -1
        var no = -1
        var value = -1
        if (form == "return-stmt" || (form == "expr-stmt" && infer_return && parent(ast, lexical_list) == body)) {
            if (rest >= 0) { return failed(errors, rest, hir_unsupported()) }
            let result = child_with_role(pg, ast, links, statement, "value")
            if (result < 0 || expression_ids.get(result) < 0) { return failed(errors, statement, hir_unsupported()) }
            value = expression_ids.get(result)
        } else {
            if (form != "if-stmt") { return failed(errors, statement, hir_unsupported()) }
            let test = child_with_role(pg, ast, links, statement, "cond")
            yes = child_with_role(pg, ast, links, statement, "then")
            let alternative = child_with_kind(pg, ast, links, statement, "else-block")
            if (test < 0 || yes < 0 || expression_ids.get(test) < 0) { return failed(errors, statement, hir_unsupported()) }
            var no_cursor = -1
            if (alternative >= 0) {
                if (rest >= 0) { return failed(errors, rest, hir_unsupported()) }
                no = child_with_kind(pg, ast, links, alternative, "block")
                if (no < 0) { return failed(errors, statement, hir_unsupported()) }
                no_cursor = first_child(links, no)
            } else {
                if (rest < 0) { return failed(errors, statement, hir_unsupported()) }
                // The first remaining statement owns the synthetic suffix
                // block. The suffix is visited only on the false branch.
                no = rest
                no_cursor = rest
            }
            condition = expression_ids.get(test)
            pending.push(no)
            pending.push(no_cursor)
            pending.push(yes)
            pending.push(first_child(links, yes))
        }
        blocks.push(block)
        blocks.push(owner)
        blocks.push(condition)
        blocks.push(yes)
        blocks.push(no)
        blocks.push(value)
    }
    return 0
}

fn lower_global_initializers(count int, layouts List<int>, expression_ids List<int>, defs List<int>, exprs List<int>, args List<int>, blocks List<int>, fuel List<int>, deadline i64, errors List<int>) int {
    var at = 0
    for (at < layouts.len()) {
        let source = layouts.get(at)
        if (!take_step(fuel, deadline)) { return failed(errors, source, bind_budget()) }
        let value = expression_ids.get(layouts.get(at + 3))
        let lane = layouts.get(at + 1)
        if ((lane != integer_type() && lane != boolean_type()) || value < 0) { return failed(errors, source, hir_unsupported()) }
        let owner = global_definition(count, source, initializer_mode())
        let evaluated = append_global_write(count, source, source, owner, value, exprs, args)
        defs.push(owner)
        defs.push(integer_type())
        defs.push(owner)
        defs.push(owner)
        blocks.push(owner)
        blocks.push(owner)
        blocks.push(-1)
        blocks.push(-1)
        blocks.push(-1)
        blocks.push(evaluated)
        at = at + global_layout_stride()
    }
    return 0
}

fn lower_core(pg List<int>, ast List<int>, links List<int>, src List<int>, declarations List<int>, uses List<int>, mappings List<int>, facts List<int>, types List<int>, records List<int>, layouts List<int>, defs List<int>, locals List<int>, exprs List<int>, args List<int>, blocks List<int>, statements List<int>, fuel List<int>, deadline i64, errors List<int>) int {
    var expressions = List<int>.new()
    let lowered = lower_expressions(pg, ast, links, src, declarations, uses, mappings, facts, types, records, exprs, args, expressions, fuel, deadline, errors)
    if (lowered != 0) { return lowered }
    var row = 0
    for (row < row_count(ast)) {
        if (!take_step(fuel, deadline)) { return failed(errors, row, bind_budget()) }
        let category = decl_category(declarations, row)
        if (category == function_decl()) {
            let body = child_with_role(pg, ast, links, row, "body")
            if (body < 0 || !core_value_type(records, facts.get(row))) { return failed(errors, row, hir_unsupported()) }
            let infer_return = child_with_role(pg, ast, links, row, "ty") < 0
            let result = lower_blocks(pg, ast, links, declarations, uses, expressions, body, row, infer_return, locals, exprs, args, blocks, statements, fuel, deadline, errors)
            if (result != 0) { return result }
            defs.push(row)
            defs.push(facts.get(row))
            defs.push(row)
            defs.push(body)
            let params = call_parameter_slots(pg, ast, links, row)
            var slot = 0
            for (slot < params.len()) {
                let param = params.get(slot)
                let ty = facts.get(param)
                if (!core_value_type(records, ty)) { return failed(errors, param, hir_unsupported()) }
                if (child_with_role(pg, ast, links, param, "mode") >= 0) { return failed(errors, param, hir_unsupported()) }
                locals.push(row)
                locals.push(param)
                locals.push(ty)
                locals.push(slot)
                slot = slot + 1
            }
        } else {
            if (category == local_let_decl() || category == local_var_decl()) {
                var owner = parent(ast, row)
                for (owner >= 0 && decl_category(declarations, owner) != function_decl()) {
                    if (!take_step(fuel, deadline)) { return failed(errors, row, bind_budget()) }
                    owner = parent(ast, owner)
                }
                if (owner < 0 || !core_value_type(records, facts.get(row))) { return failed(errors, row, hir_unsupported()) }
                var slot = immutable_slot()
                if (category == local_var_decl()) { slot = mutable_slot() }
                locals.push(owner)
                locals.push(row)
                locals.push(facts.get(row))
                locals.push(slot)
            } else {
                let type_member = category == type_decl() || category == field_decl()
                if (category != 0 && category != parameter_decl() && category != prototype_decl() && !type_member && !global_category(category)) { return failed(errors, row, hir_unsupported()) }
            }
        }
        row = row + 1
    }
    let initialized = lower_global_initializers(row_count(ast), layouts, expressions, defs, exprs, args, blocks, fuel, deadline, errors)
    if (initialized != 0) { return initialized }
    let registered = add_global_intrinsics(row_count(ast), layouts, defs, locals, fuel, deadline)
    if (registered != 0) { return failed(errors, 0, registered) }
    if (defs.len() == 0) { return failed(errors, 0, hir_unsupported()) }
    return 0
}

fn param_at(parameters List<int>, owner int, slot int) int {
    var pos = 0
    for (pos < parameters.len()) {
        if (parameters.get(pos) == owner && parameters.get(pos + 3) == slot) { return pos }
        pos = pos + 4
    }
    return -1
}

fn param_count(parameters List<int>, owner int) int {
    var count = 0
    var pos = 0
    for (pos < parameters.len()) {
        if (parameters.get(pos) == owner && parameters.get(pos + 3) >= 0) { count = count + 1 }
        pos = pos + 4
    }
    return count
}

fn verify_call(defs List<int>, parameters List<int>, exprs List<int>, args List<int>, position int, records List<int>, layouts List<int>, rows int, fuel List<int>, deadline i64) int {
    let target_id = exprs.get(position + 4)
    if (global_mode(rows, target_id) == initializer_mode()) { return hir_reference_error() }
    let definition = find_row(defs, 4, target_id, 0)
    if (definition < 0) { return hir_reference_error() }
    if (exprs.get(position + 3) != defs.get(definition + 1)) { return hir_type_error() }
    let owner = exprs.get(position + 1)
    if (defs.get(definition + 2) < 0 && global_mode(rows, target_id) == setter_mode()) {
        if (!has_budget(fuel, deadline, layouts.len() / global_layout_stride())) { return bind_budget() }
        let source = global_source(rows, target_id)
        let layout = layout_offset(layouts, source)
        if (layout < 0) { return hir_reference_error() }
        let initializer = global_definition(rows, source, initializer_mode())
        if (owner != initializer && layouts.get(layout + 2) != 1) { return hir_mutability_error() }
    }
    if (!has_budget(fuel, deadline, parameters.len() / 4)) { return bind_budget() }
    let expected = param_count(parameters, target_id)
    var slots = List<int>.new()
    var i = 0
    for (i < expected) {
        slots.push(0)
        i = i + 1
    }
    let call = exprs.get(position)
    var found = 0
    i = 0
    for (i < args.len()) {
        if (!take_step(fuel, deadline)) { return bind_budget() }
        if (args.get(i) == call) {
            let slot = args.get(i + 2)
            if (slot < 0 || slot >= expected || slots.get(slot) != 0) { return hir_reference_error() }
            if (!has_budget(fuel, deadline, parameters.len() / 4 + exprs.len() / 5)) { return bind_budget() }
            let param = param_at(parameters, target_id, slot)
            let arg = find_row(exprs, 5, args.get(i + 1), 0)
            if (param < 0 || arg < 0 || arg >= position) { return hir_reference_error() }
            if (exprs.get(arg + 1) != owner) { return hir_owner_error() }
            if (parameters.get(param + 2) != exprs.get(arg + 3)) { return hir_type_error() }
            let lane = exprs.get(arg + 3)
            if (record_at(records, lane) >= 0 && exprs.get(arg + 2) != record_view_op()) { return hir_borrow_error() }
            slots.set(slot, 1)
            found = found + 1
        }
        i = i + 3
    }
    if (found != expected) { return hir_reference_error() }
    return 0
}

fn verify_binary(exprs List<int>, args List<int>, position int, op int, fuel List<int>, deadline i64) int {
    var result = integer_type()
    if (op == less_than_op()) { result = boolean_type() }
    if (exprs.get(position + 3) != result) { return hir_type_error() }
    let expression = exprs.get(position)
    let owner = exprs.get(position + 1)
    var at = 0
    var left = false
    var right = false
    for (at < args.len()) {
        if (!take_step(fuel, deadline)) { return bind_budget() }
        if (args.get(at) == expression) {
            let slot = args.get(at + 2)
            if (slot < 0 || slot > 1 || (slot == 0 && left) || (slot == 1 && right)) { return hir_reference_error() }
            if (!has_budget(fuel, deadline, exprs.len() / 5)) { return bind_budget() }
            let operand = find_row(exprs, 5, args.get(at + 1), 0)
            if (operand < 0 || operand >= position) { return hir_reference_error() }
            if (exprs.get(operand + 1) != owner) { return hir_owner_error() }
            if (exprs.get(operand + 3) != integer_type()) { return hir_type_error() }
            if (slot == 0) { left = true } else { right = true }
        }
        at = at + 3
    }
    if (!left || !right) { return hir_reference_error() }
    return 0
}

fn verify_blocks(defs List<int>, exprs List<int>, blocks List<int>, fuel List<int>, deadline i64, errors List<int>) int {
    var outcomes = List<int>.new()
    var position = 0
    for (position < blocks.len()) {
        let row = blocks.get(position)
        let owner = blocks.get(position + 1)
        let condition = blocks.get(position + 2)
        if (!has_budget(fuel, deadline, defs.len() / 4 + exprs.len() / 5)) { return failed(errors, row, bind_budget()) }
        let def = find_row(defs, 4, owner, 0)
        if (def < 0) { return failed(errors, row, hir_owner_error()) }
        var use_expr = condition
        var expected = boolean_type()
        var exits = 0
        if (condition < 0) {
            use_expr = blocks.get(position + 5)
            expected = defs.get(def + 1)
            exits = 1
        }
        let expression = find_row(exprs, 5, use_expr, 0)
        if (expression < 0) { return failed(errors, row, hir_reference_error()) }
        if (exprs.get(expression + 1) != owner) { return failed(errors, row, hir_owner_error()) }
        if (exprs.get(expression + 3) != expected) { return failed(errors, row, hir_type_error()) }
        outcomes.push(exits)
        position = position + 6
    }
    var changed = true
    for (changed) {
        changed = false
        position = 0
        for (position < blocks.len()) {
            if (outcomes.get(position / 6) == 0) {
                let row = blocks.get(position)
                let owner = blocks.get(position + 1)
                if (!has_budget(fuel, deadline, blocks.len() / 3)) { return failed(errors, row, bind_budget()) }
                let yes = find_row(blocks, 6, blocks.get(position + 3), 0)
                let no = find_row(blocks, 6, blocks.get(position + 4), 0)
                if (yes < 0 || no < 0) { return failed(errors, row, hir_reference_error()) }
                if (blocks.get(yes + 1) != owner || blocks.get(no + 1) != owner) { return failed(errors, row, hir_owner_error()) }
                if (outcomes.get(yes / 6) != 0 && outcomes.get(no / 6) != 0) {
                    outcomes.set(position / 6, 1)
                    changed = true
                }
            }
            position = position + 6
        }
    }
    position = 0
    for (position < outcomes.len()) {
        if (outcomes.get(position) == 0) { return failed(errors, blocks.get(position * 6), hir_reference_error()) }
        position = position + 1
    }
    return 0
}

fn unary_operand(args List<int>, expression int) int {
    var operand = -1
    var at = 0
    for (at < args.len()) {
        if (args.get(at) == expression) {
            if (operand >= 0 || args.get(at + 2) != 0) { return -1 }
            operand = args.get(at + 1)
        }
        at = at + 3
    }
    return operand
}

fn verify_text_length(exprs List<int>, args List<int>, position int, fuel List<int>, deadline i64) int {
    if (!has_budget(fuel, deadline, exprs.len() / 5 + args.len() / 3)) { return bind_budget() }
    let id = exprs.get(position)
    let operand = exprs.get(position + 4)
    let input = find_row(exprs, 5, operand, 0)
    if (input < 0 || input == position || exprs.get(input + 1) != exprs.get(position + 1)) { return hir_reference_error() }
    if (exprs.get(input + 3) != text_view_type() || exprs.get(position + 3) != integer_type()) { return hir_type_error() }
    if (unary_operand(args, id) != operand) { return hir_reference_error() }
    return 0
}

fn verify_record_field(records List<int>, exprs List<int>, args List<int>, position int, fuel List<int>, deadline i64) int {
    if (!has_budget(fuel, deadline, records.len() + exprs.len() / 5 + args.len() / 3)) { return bind_budget() }
    let id = exprs.get(position)
    let base = find_row(exprs, 5, unary_operand(args, id), 0)
    if (base < 0 || base == position || exprs.get(base + 1) != exprs.get(position + 1)) { return hir_reference_error() }
    let origin = record_at(records, exprs.get(base + 3))
    if (origin < 0) { return hir_type_error() }
    let field = record_slot(records, origin, exprs.get(position + 4))
    if (field < 0) { return hir_reference_error() }
    if (records.get(field + 1) != exprs.get(position + 3)) { return hir_type_error() }
    return 0
}

fn verify_record_view(records List<int>, exprs List<int>, args List<int>, position int, fuel List<int>, deadline i64) int {
    if (!has_budget(fuel, deadline, records.len() + exprs.len() / 5 + args.len() / 3)) { return bind_budget() }
    let id = exprs.get(position)
    let base_id = unary_operand(args, id)
    let base = find_row(exprs, 5, base_id, 0)
    if (base < 0 || base == position || base_id != exprs.get(position + 4) || exprs.get(base + 1) != exprs.get(position + 1)) { return hir_reference_error() }
    let lane = exprs.get(position + 3)
    if (record_at(records, lane) < 0 || exprs.get(base + 3) != lane) { return hir_type_error() }
    var at = 0
    for (at < args.len()) {
        if (args.get(at + 1) == id) {
            if (!has_budget(fuel, deadline, exprs.len() / 5)) { return bind_budget() }
            let parent = find_row(exprs, 5, args.get(at), 0)
            if (parent >= 0 && exprs.get(parent + 2) == call_op()) { return 0 }
            return hir_borrow_error()
        }
        at = at + 3
    }
    return hir_borrow_error()
}

fn verify_record_constructor(records List<int>, exprs List<int>, args List<int>, position int, fuel List<int>, deadline i64) int {
    if (!has_budget(fuel, deadline, records.len() + args.len() / 3)) { return bind_budget() }
    let shape = exprs.get(position + 4)
    let origin = record_at(records, shape)
    if (origin < 0 || shape != exprs.get(position + 3)) { return hir_type_error() }
    let fields = records.get(origin + 1)
    var mapped = List<int>.new()
    var slot = 0
    for (slot < fields) {
        if (!take_step(fuel, deadline)) { return bind_budget() }
        mapped.push(0)
        slot = slot + 1
    }
    let id = exprs.get(position)
    let owner = exprs.get(position + 1)
    var count = 0
    var at = 0
    for (at < args.len()) {
        if (args.get(at) == id) {
            slot = args.get(at + 2)
            let field = record_slot(records, origin, slot)
            if (field < 0 || mapped.get(slot) != 0) { return hir_reference_error() }
            if (!has_budget(fuel, deadline, exprs.len() / 5)) { return bind_budget() }
            let value = find_row(exprs, 5, args.get(at + 1), 0)
            if (value < 0 || value == position || exprs.get(value + 1) != owner) { return hir_reference_error() }
            if (exprs.get(value + 3) != records.get(field + 1)) { return hir_type_error() }
            mapped.set(slot, 1)
            count = count + 1
        }
        at = at + 3
    }
    if (count != fields) { return hir_reference_error() }
    return 0
}

fn claim_node(table List<int>, stride int, claimed List<int>, node int, fuel List<int>, deadline i64) int {
    if (!has_budget(fuel, deadline, table.len() / stride)) { return bind_budget() }
    let slot = find_row(table, stride, node, 0)
    if (slot < 0 || claimed.get(slot / stride) != 0) { return hir_reference_error() }
    claimed.set(slot / stride, 1)
    return 0
}

fn unclaimed_node(table List<int>, stride int, claimed List<int>) int {
    var index = 0
    for (index < claimed.len()) {
        if (claimed.get(index) == 0) { return table.get(index * stride) }
        index = index + 1
    }
    return -1
}

// Each expression owns an evaluation, and each block belongs to one
// structured control-flow position. A terminating graph alone would also
// admit unreachable code and allow an effectful expression to be shared.
fn verify_usage(defs List<int>, exprs List<int>, args List<int>, blocks List<int>, statements List<int>, fuel List<int>, deadline i64, errors List<int>) int {
    if (!has_budget(fuel, deadline, exprs.len() / 5 + blocks.len() / 6)) { return failed(errors, 0, bind_budget()) }
    var expressions = List<int>.new()
    var block_claims = List<int>.new()
    var pending = List<int>.new()
    var at = 0
    for (at < exprs.len()) {
        expressions.push(0)
        at = at + 5
    }
    at = 0
    for (at < blocks.len()) {
        block_claims.push(0)
        at = at + 6
    }
    at = 0
    for (at < statements.len()) {
        pending.push(statements.get(at + 3))
        at = at + 4
    }
    at = 0
    for (at < defs.len()) {
        if (defs.get(at + 2) >= 0) {
            let code = claim_node(blocks, 6, block_claims, defs.get(at + 3), fuel, deadline)
            if (code != 0) { return failed(errors, defs.get(at), code) }
        }
        at = at + 4
    }
    at = 0
    for (at < blocks.len()) {
        let condition = blocks.get(at + 2)
        var evaluated = blocks.get(at + 5)
        if (condition >= 0) {
            let yes = claim_node(blocks, 6, block_claims, blocks.get(at + 3), fuel, deadline)
            if (yes != 0) { return failed(errors, blocks.get(at), yes) }
            let no = claim_node(blocks, 6, block_claims, blocks.get(at + 4), fuel, deadline)
            if (no != 0) { return failed(errors, blocks.get(at), no) }
            evaluated = condition
        }
        pending.push(evaluated)
        at = at + 6
    }
    for (pending.len() > 0) {
        let id = pending.remove(pending.len() - 1)
        let code = claim_node(exprs, 5, expressions, id, fuel, deadline)
        if (code != 0) { return failed(errors, id, code) }
        if (!has_budget(fuel, deadline, args.len() / 3)) { return failed(errors, id, bind_budget()) }
        at = 0
        for (at < args.len()) {
            if (args.get(at) == id) { pending.push(args.get(at + 1)) }
            at = at + 3
        }
    }
    let unused = unclaimed_node(exprs, 5, expressions)
    if (unused >= 0) { return failed(errors, unused, hir_reference_error()) }
    let unreachable = unclaimed_node(blocks, 6, block_claims)
    if (unreachable >= 0) { return failed(errors, unreachable, hir_reference_error()) }
    return 0
}

fn incoming_block(blocks List<int>, needle int) int {
    var at = 0
    for (at < blocks.len()) {
        if (blocks.get(at + 3) == needle || blocks.get(at + 4) == needle) { return blocks.get(at) }
        at = at + 6
    }
    return -1
}

fn initialized_before(init int, statements List<int>, blocks List<int>, block int, before int, fuel List<int>, deadline i64) int {
    if (init < 0) { return hir_initialization_error() }
    let origin = statements.get(init)
    if (origin == block && init < before) { return 0 }
    if (origin == block) { return hir_initialization_error() }
    var ancestor = block
    for (ancestor >= 0) {
        if (!has_budget(fuel, deadline, blocks.len() / 6)) { return bind_budget() }
        ancestor = incoming_block(blocks, ancestor)
        if (ancestor == origin) { return 0 }
    }
    return hir_initialization_error()
}

fn verify_local_reads(locals List<int>, exprs List<int>, args List<int>, blocks List<int>, statements List<int>, initialized List<int>, root int, block int, before int, fuel List<int>, deadline i64, errors List<int>) int {
    var pending = List<int>.new()
    pending.push(root)
    for (pending.len() > 0) {
        let id = pending.remove(pending.len() - 1)
        if (!has_budget(fuel, deadline, exprs.len() / 5 + args.len() / 3)) { return failed(errors, id, bind_budget()) }
        let expression = find_row(exprs, 5, id, 0)
        if (expression < 0) { return failed(errors, id, hir_reference_error()) }
        if (exprs.get(expression + 2) == read_op()) {
            if (!has_budget(fuel, deadline, locals.len() / 4)) { return failed(errors, id, bind_budget()) }
            let local = find_row(locals, 4, exprs.get(expression + 4), 1)
            if (local < 0) { return failed(errors, id, hir_reference_error()) }
            if (locals.get(local + 3) < 0) {
                let result = initialized_before(initialized.get(local / 4), statements, blocks, block, before, fuel, deadline)
                if (result != 0) { return failed(errors, id, result) }
            }
        }
        var at = 0
        for (at < args.len()) {
            if (args.get(at) == id) { pending.push(args.get(at + 1)) }
            at = at + 3
        }
    }
    return 0
}

fn verify_statements(locals List<int>, exprs List<int>, args List<int>, blocks List<int>, statements List<int>, fuel List<int>, deadline i64, errors List<int>) int {
    var at = 0
    var initialized = List<int>.new()
    var has_binding = false
    for (at < locals.len()) {
        if (locals.get(at + 3) < 0) { has_binding = true }
        initialized.push(-1)
        at = at + 4
    }
    if (!has_binding && statements.len() == 0) { return 0 }
    at = 0
    for (at < statements.len()) {
        let block = statements.get(at)
        if (!has_budget(fuel, deadline, locals.len() / 4 + exprs.len() / 5 + blocks.len() / 6)) {
            return failed(errors, block, bind_budget())
        }
        let owner = find_row(blocks, 6, block, 0)
        let local = find_row(locals, 4, statements.get(at + 2), 1)
        let root = statements.get(at + 3)
        let expression = find_row(exprs, 5, root, 0)
        if (owner < 0 || local < 0 || expression < 0) { return failed(errors, block, hir_reference_error()) }
        if (locals.get(local) != blocks.get(owner + 1) || exprs.get(expression + 1) != blocks.get(owner + 1)) {
            return failed(errors, block, hir_owner_error())
        }
        if (locals.get(local + 2) != exprs.get(expression + 3)) { return failed(errors, root, hir_type_error()) }
        let op = statements.get(at + 1)
        let role = locals.get(local + 3)
        if (op == initialize_op()) {
            if (role >= 0 || initialized.get(local / 4) != -1) { return failed(errors, block, hir_initialization_error()) }
            initialized.set(local / 4, at)
        } else {
            if (op != assign_op() || role != mutable_slot()) { return failed(errors, block, hir_mutability_error()) }
        }
        at = at + 4
    }
    at = 0
    for (at < statements.len()) {
        let block = statements.get(at)
        let root = statements.get(at + 3)
        if (statements.get(at + 1) == assign_op()) {
            if (!has_budget(fuel, deadline, locals.len() / 4)) { return failed(errors, block, bind_budget()) }
            let local = find_row(locals, 4, statements.get(at + 2), 1)
            let result = initialized_before(initialized.get(local / 4), statements, blocks, block, at, fuel, deadline)
            if (result != 0) { return failed(errors, block, result) }
        }
        let verified = verify_local_reads(locals, exprs, args, blocks, statements, initialized, root, block, at, fuel, deadline, errors)
        if (verified != 0) { return verified }
        at = at + 4
    }
    at = 0
    for (at < blocks.len()) {
        var root = blocks.get(at + 2)
        if (root < 0) { root = blocks.get(at + 5) }
        let verified = verify_local_reads(locals, exprs, args, blocks, statements, initialized, root, blocks.get(at), statements.len(), fuel, deadline, errors)
        if (verified != 0) { return verified }
        at = at + 6
    }
    return 0
}

fn verify_accessor(defs List<int>, parameters List<int>, at int, layouts List<int>, rows int, fuel List<int>, deadline i64) int {
    if (!has_budget(fuel, deadline, layouts.len() / global_layout_stride() + parameters.len() / 2)) { return bind_budget() }
    let definition = defs.get(at)
    let mode = global_mode(rows, definition)
    if (mode != getter_mode() && mode != setter_mode()) { return hir_reference_error() }
    let layout = layout_offset(layouts, global_source(rows, definition))
    if (layout < 0 || defs.get(at + 3) != -1) { return hir_reference_error() }
    let lane = layouts.get(layout + 1)
    let arity = param_count(parameters, definition)
    if (mode == getter_mode()) {
        if (arity != 0 || defs.get(at + 1) != lane) { return hir_type_error() }
    } else {
        let parameter = param_at(parameters, definition, 0)
        if (arity != 1 || parameter < 0 || parameters.get(parameter + 2) != lane || defs.get(at + 1) != integer_type()) {
            return hir_type_error()
        }
    }
    return 0
}

fn verify_initializer_chain(defs List<int>, parameters List<int>, exprs List<int>, blocks List<int>, layouts List<int>, rows int, fuel List<int>, deadline i64, errors List<int>) int {
    var at = 0
    for (at < layouts.len()) {
        let source = layouts.get(at)
        let getter = global_definition(rows, source, getter_mode())
        let setter = global_definition(rows, source, setter_mode())
        let initializer = global_definition(rows, source, initializer_mode())
        let scan = defs.len() / 4 * 3 + blocks.len() / 6 + parameters.len() / 4 + exprs.len() / 5
        if (!has_budget(fuel, deadline, scan)) { return failed(errors, source, bind_budget()) }
        let get_def = find_row(defs, 4, getter, 0)
        let set_def = find_row(defs, 4, setter, 0)
        let init_def = find_row(defs, 4, initializer, 0)
        if (get_def < 0 || set_def < 0 || init_def < 0) { return failed(errors, source, hir_global_authority_error()) }
        if (defs.get(get_def + 2) != -1 || defs.get(set_def + 2) != -1 || defs.get(init_def + 2) != initializer) {
            return failed(errors, source, hir_owner_error())
        }
        if (defs.get(init_def + 1) != integer_type() || param_count(parameters, initializer) != 0) {
            return failed(errors, source, hir_type_error())
        }
        let entry = find_row(blocks, 6, defs.get(init_def + 3), 0)
        if (entry < 0 || blocks.get(entry + 2) >= 0) { return failed(errors, source, hir_initialization_error()) }
        let result = find_row(exprs, 5, blocks.get(entry + 5), 0)
        if (result < 0 || exprs.get(result + 2) != call_op() || exprs.get(result + 4) != setter) {
            return failed(errors, source, hir_initialization_error())
        }
        at = at + global_layout_stride()
    }
    return 0
}

fn verify(defs List<int>, parameters List<int>, exprs List<int>, args List<int>, blocks List<int>, statements List<int>, records List<int>, layouts List<int>, rows int, fuel List<int>, deadline i64, errors List<int>) ?VerifiedCore {
    var record_error = List<int>.new()
    record_error.push(0)
    let shape_status = verify_record_shapes(records, fuel, deadline, record_error)
    if (shape_status != 0) {
        failed(errors, record_error.get(0), shape_status)
        return None
    }
    var position = 0
    for (position < defs.len()) {
        let id = defs.get(position)
        if (!has_budget(fuel, deadline, blocks.len() / 6)) {
            failed(errors, id, bind_budget())
            return None
        }
        if (defs.get(position + 2) == -1 && defs.get(position + 3) == -1) {
            let status = verify_accessor(defs, parameters, position, layouts, rows, fuel, deadline)
            if (status != 0) {
                failed(errors, id, status)
                return None
            }
        } else {
            if (defs.get(position + 2) != id) {
                failed(errors, id, hir_owner_error())
                return None
            }
            let entry = find_row(blocks, 6, defs.get(position + 3), 0)
            if (entry < 0 || blocks.get(entry + 1) != id) {
                failed(errors, id, hir_reference_error())
                return None
            }
        }
        position = position + 4
    }
    position = 0
    for (position < exprs.len()) {
        let row = exprs.get(position)
        if (!has_budget(fuel, deadline, defs.len() / 4 + parameters.len() / 4)) {
            failed(errors, row, bind_budget())
            return None
        }
        let owner = exprs.get(position + 1)
        let declaring = find_row(defs, 4, owner, 0)
        if (declaring < 0 || defs.get(declaring + 2) < 0) {
            failed(errors, row, hir_owner_error())
            return None
        }
        let op = exprs.get(position + 2)
        let type_id = exprs.get(position + 3)
        let data = exprs.get(position + 4)
        var status = hir_reference_error()
        if (op == constant_op() || op == read_op() || op == call_op()) { status = 0 }
        if (!core_value_type(records, type_id)) { status = hir_type_error() }
        if (op == read_op()) {
            let param = find_row(parameters, 4, data, 1)
            if (param < 0 || parameters.get(param) != owner) {
                status = hir_owner_error()
            } else {
                if (parameters.get(param + 2) != type_id) { status = hir_type_error() }
            }
        }
        if (op == constant_op() && type_id != integer_type()) { status = hir_type_error() }
        if (op == text_literal_op()) {
            status = hir_type_error()
            if (type_id == text_view_type() && data >= 0) { status = 0 }
        }
        if (op == text_length_op()) { status = verify_text_length(exprs, args, position, fuel, deadline) }
        if (op == record_constructor_op()) { status = verify_record_constructor(records, exprs, args, position, fuel, deadline) }
        if (op == record_field_op()) { status = verify_record_field(records, exprs, args, position, fuel, deadline) }
        if (op == record_view_op()) { status = verify_record_view(records, exprs, args, position, fuel, deadline) }
        if (op == call_op()) { status = verify_call(defs, parameters, exprs, args, position, records, layouts, rows, fuel, deadline) }
        if (op == less_than_op() || op == add_op() || op == multiply_op()) {
            status = verify_binary(exprs, args, position, op, fuel, deadline)
        }
        if (status != 0) {
            failed(errors, row, status)
            return None
        }
        position = position + 5
    }
    if (verify_blocks(defs, exprs, blocks, fuel, deadline, errors) != 0) { return None }
    if (verify_initializer_chain(defs, parameters, exprs, blocks, layouts, rows, fuel, deadline, errors) != 0) { return None }
    if (verify_usage(defs, exprs, args, blocks, statements, fuel, deadline, errors) != 0) { return None }
    if (verify_statements(parameters, exprs, args, blocks, statements, fuel, deadline, errors) != 0) { return None }
    return Some(VerifiedCore { definitions: defs.len() / 4 })
}

fn id(prefix Str, row int) Str { return prefix + from_int(row) }
fn ref_text(prefix Str, row int) Str { return "\"" + id(prefix, row) + "\"" }

fn type_id_text(t int, quoted bool) Str {
    if (t == text_view_type()) { return "str" }
    if (quoted) { return ref_text("t", t) }
    return id("t", t)
}

fn has_text(defs List<int>, parameters List<int>, exprs List<int>) bool {
    if (find_row(defs, 4, text_view_type(), 1) >= 0) { return true }
    if (find_row(parameters, 4, text_view_type(), 2) >= 0) { return true }
    return find_row(exprs, 5, text_view_type(), 3) >= 0
}

fn write_mapped_arguments(args List<int>, call int, evaluation_field Str, binding_field Str, formal_field Str) Str {
    var evaluation = ""
    var bindings = ""
    var at = 0
    var index = 0
    for (at < args.len()) {
        if (args.get(at) == call) {
            if (index > 0) {
                evaluation = evaluation + ", "
                bindings = bindings + ", "
            }
            evaluation = evaluation + ref_text("e", args.get(at + 1))
            bindings = bindings + "{ " + formal_field + ": " + from_int(args.get(at + 2)) + "u32, arg: " + from_int(index) + "u32 }"
            index = index + 1
        }
        at = at + 3
    }
    return evaluation_field + ": [" + evaluation + "]; " + binding_field + ": [" + bindings + "]"
}

fn write_call(args List<int>, call int, target int) Str {
    return "callee: " + ref_text("d", target) + "; " + write_mapped_arguments(args, call, "eval_args", "bindings", "param")
}

fn write_record_types(records List<int>, ast List<int>, src List<int>, declarations List<int>) Str {
    var output = List<Str>.new()
    var at = 0
    for (at < records.len()) {
        let limit = record_next(records, at)
        var fields = ""
        var field = at + 3
        for (field < limit) {
            if (field > at + 3) { fields = fields + ", " }
            let name = spelling(src, ast, decl_name(declarations, records.get(field)))
            fields = fields + "{ name: \"" + name + "\", type: " + type_id_text(records.get(field + 1), true) + " }"
            field = field + 2
        }
        let line = " type " + id("t", records.get(at)) + " record { fields: [" + fields + "] }\n"
        output.push(line.move)
        at = limit
    }
    return join_rows(output, output.len())
}

fn write_binary(args List<int>, expression int, op int) Str {
    var lhs = -1
    var rhs = -1
    var at = 0
    for (at < args.len()) {
        if (args.get(at) == expression) {
            if (args.get(at + 2) == 0) { lhs = args.get(at + 1) } else { rhs = args.get(at + 1) }
        }
        at = at + 3
    }
    var operation = "lt_i32; "
    if (op == add_op()) { operation = "add_i32; overflow: trap; " }
    if (op == multiply_op()) { operation = "mul_i32; overflow: trap; " }
    return "op: " + operation + "lhs: " + ref_text("e", lhs) + "; rhs: " + ref_text("e", rhs)
}

fn assigned(statements List<int>, local int) bool {
    var at = 0
    for (at < statements.len()) {
        if (statements.get(at + 1) == assign_op() && statements.get(at + 2) == local) { return true }
        at = at + 4
    }
    return false
}

fn local_places(locals List<int>, statements List<int>, owner int) Str {
    var output = List<Str>.new()
    var at = 0
    for (at < locals.len()) {
        if (locals.get(at) == owner && locals.get(at + 3) == mutable_slot()) {
            let local = locals.get(at + 1)
            if (assigned(statements, local)) {
                let line = " place " + id("p", local) + " local { local: " + ref_text("l", local) + "; type: " + type_id_text(locals.get(at + 2), true) + "; access: mutable }\n"
                output.push(line.move)
            }
        }
        at = at + 4
    }
    if (output.len() == 0) { return "" }
    return " places {\n" + join_rows(output, output.len()) + " }\n"
}

fn block_statements(statements List<int>, block int) Str {
    var output = List<Str>.new()
    var at = 0
    for (at < statements.len()) {
        if (statements.get(at) == block) {
            let local = statements.get(at + 2)
            let value = ref_text("e", statements.get(at + 3))
            if (statements.get(at + 1) == initialize_op()) {
                let line = "let(local: " + ref_text("l", local) + ", value: " + value + ") {} "
                output.push(line.move)
            } else {
                let line = "assign(place: " + ref_text("p", local) + ", value: " + value + ") {} "
                output.push(line.move)
            }
        }
        at = at + 4
    }
    return join_rows(output, output.len())
}

fn render_definition(def int, ast List<int>, src List<int>, declarations List<int>, modules List<int>) Str {
    let mode = global_mode(row_count(ast), def)
    let key = id("d", def) + " " + id("s", def)
    if (mode != 0) {
        let source = global_source(row_count(ast), def)
        let symbol = global_symbol(ast, src, modules, declarations, source)
        if (mode == getter_mode()) {
            return " intrinsic " + key + " { symbol: \"module.global.get:" + symbol + "\"; effect: pure }\n"
        }
        if (mode == setter_mode()) {
            return " intrinsic " + key + " { symbol: \"module.global.set:" + symbol + "\"; effect: observable }\n"
        }
        return " function " + key + " { name: \"__aac_init_" + symbol + "\"; body: " + ref_text("b", def) + " }\n"
    }
    var name = spelling(src, ast, decl_name(declarations, def))
    let module_id = source_id(ast, def)
    if (module_id != 0) { name = module_name_at(modules, module_id) + "." + name }
    return " function " + key + " { name: \"" + name + "\"; body: " + ref_text("b", def) + " }\n"
}

fn emit(checked VerifiedCore, defs List<int>, parameters List<int>, exprs List<int>, args List<int>, blocks List<int>, statements List<int>, records List<int>, ast List<int>, src List<int>, declarations List<int>, modules List<int>, has_globals bool) Str {
    var output = List<Str>.new()
    var schema = "auto.hir.core.draft"
    var profile = "core-i32-draft"
    let text_domain = has_text(defs, parameters, exprs)
    if (has_globals || text_domain || records.len() > 0) {
        schema = "auto.hir.text-record.draft"
        profile = "text-record-i32-draft"
    }
    var capabilities = ""
    if (text_domain) { capabilities = " requires: [\"ac.runtime.text.v1\"]\n" }
    let opening = "hir(schema: \"" + schema + "\", revision: 1u32, profile: \"" + profile + "\") {\n" + capabilities + " module m {\n path: \"" + module_name_at(modules, 0) + "\"\n types {\n type t1 i32 {}\n type t2 bool {}\n"
    output.push(opening.move)
    if (records.len() > 0) {
        let record_declarations = write_record_types(records, ast, src, declarations)
        output.push(record_declarations.move)
    }
    var def_at = 0
    for (def_at < checked.definitions * 4) {
        let def = defs.get(def_at)
        var param_list = ""
        var param_at = 0
        for (param_at < parameters.len()) {
            if (parameters.get(param_at) == def && parameters.get(param_at + 3) >= 0) {
                if (param_list.len() > 0) { param_list = param_list + ", " }
                param_list = param_list + type_id_text(parameters.get(param_at + 2), true)
            }
            param_at = param_at + 4
        }
        let line = " type " + id("s", def) + " function { params: [" + param_list + "]; result: " + type_id_text(defs.get(def_at + 1), true) + " }\n"
        output.push(line.move)
        def_at = def_at + 4
    }
    output.push(" }\n declarations {\n")
    def_at = 0
    for (def_at < checked.definitions * 4) {
        let def = defs.get(def_at)
        let line = render_definition(def, ast, src, declarations, modules)
        output.push(line.move)
        def_at = def_at + 4
    }
    output.push(" }\n bodies {\n")
    def_at = 0
    for (def_at < checked.definitions * 4) {
        let def = defs.get(def_at)
        if (defs.get(def_at + 2) < 0) {
            def_at = def_at + 4
            continue
        }
        let start = " body " + id("b", def) + " { owner: " + ref_text("d", def) + "; entry: " + ref_text("k", defs.get(def_at + 3)) + "\n locals {\n"
        output.push(start.move)
        var param_at = 0
        for (param_at < parameters.len()) {
            if (parameters.get(param_at) == def) {
                let param = parameters.get(param_at + 1)
                var name = "global_status_" + from_int(param)
                if (param < row_count(ast)) { name = spelling(src, ast, decl_name(declarations, param)) }
                let slot = parameters.get(param_at + 3)
                var entries = "binding; mutable: false"
                if (slot == mutable_slot()) { entries = "binding; mutable: true" }
                if (slot >= 0) { entries = "param; index: " + from_int(slot) + "u32" }
                let lane = parameters.get(param_at + 2)
                if (slot >= 0 && (lane == text_view_type() || record_at(records, lane) >= 0)) { entries = entries + "; mode: view" }
                let line = " local " + id("l", param) + " " + type_id_text(lane, false) + " { name: \"" + name + "\"; role: " + entries + " }\n"
                output.push(line.move)
            }
            param_at = param_at + 4
        }
        output.push(" }\n")
        let places = local_places(parameters, statements, def)
        output.push(places.move)
        output.push(" expressions {\n")
        var expr_at = 0
        for (expr_at < exprs.len()) {
            if (exprs.get(expr_at + 1) == def) {
                let expr = exprs.get(expr_at)
                let op = exprs.get(expr_at + 2)
                let t = type_id_text(exprs.get(expr_at + 3), true)
                let data = exprs.get(expr_at + 4)
                var form = "constant"
                var fields = "value: " + from_int(data) + "i32"
                if (op == read_op()) {
                    form = "read_local"
                    fields = "local: " + ref_text("l", data)
                }
                if (op == call_op()) {
                    form = "call"
                    fields = write_call(args, expr, data)
                }
                if (op == less_than_op() || op == add_op() || op == multiply_op()) {
                    form = "binary"
                    fields = write_binary(args, expr, op)
                }
                if (op == text_literal_op()) {
                    form = "str_lit"
                    fields = "text: " + spelling(src, ast, data)
                }
                if (op == text_length_op()) {
                    form = "text_len"
                    fields = "operand: " + ref_text("e", data)
                }
                if (op == record_constructor_op()) {
                    form = "record_ctor"
                    fields = "record: " + type_id_text(data, true) + "; " + write_mapped_arguments(args, expr, "field_args", "ctor_bindings", "field")
                }
                if (op == record_field_op()) {
                    form = "field_get"
                    fields = "base: " + ref_text("e", unary_operand(args, expr)) + "; path: [" + from_int(data) + "u32]"
                }
                if (op == record_view_op()) {
                    form = "borrow_view"
                    fields = "base: " + ref_text("e", data)
                }
                let line = " expr " + id("e", expr) + " " + form + " { type: " + t + "; " + fields + " }\n"
                output.push(line.move)
            }
            expr_at = expr_at + 5
        }
        output.push(" }\n blocks {\n")
        var block_at = 0
        for (block_at < blocks.len()) {
            if (blocks.get(block_at + 1) == def) {
                let block_id = blocks.get(block_at)
                let block = id("k", block_id)
                let condition = blocks.get(block_at + 2)
                var statement = ""
                if (condition < 0) {
                    statement = "return(value: " + ref_text("e", blocks.get(block_at + 5)) + ") {}"
                } else {
                    statement = "if(cond: " + ref_text("e", condition) + ", then: " + ref_text("k", blocks.get(block_at + 3)) + ", else: " + ref_text("k", blocks.get(block_at + 4)) + ") {}"
                }
                let line = " block " + block + " { " + block_statements(statements, block_id) + statement + " }\n"
                output.push(line.move)
            }
            block_at = block_at + 6
        }
        output.push(" }\n }\n")
        def_at = def_at + 4
    }
    output.push(" }\n }\n}\n")
    return join_rows(output, output.len())
}

// Controls inside the stage driver alter the real draft before verification.
// The serialized Atom document is a transport value and carries no verifier
// credential. VerifiedCore exists only inside this module.
fn supported_source_item(pg List<int>, ast List<int>, links List<int>, declarations List<int>, item int) bool {
    let node_kind = kind(pg, ast, item)
    if (global_category(decl_category(declarations, item))) { return true }
    if (node_kind == "public-item") {
        let body = child_with_role(pg, ast, links, item, "body")
        if (body < 0) { return false }
        let actual = first_child(links, body)
        if (actual < 0) { return false }
        let form = kind(pg, ast, actual)
        return form == "fn-item" || form == "use-tail-p" || form == "type-item" || global_category(decl_category(declarations, actual))
    }
    if (node_kind == "script-item") {
        var statement = first_child(links, item)
        var globals = 0
        for (statement >= 0) {
            if (kind(pg, ast, statement) == "stmt") {
                let entry = first_child(links, statement)
                if (entry < 0 || !global_category(decl_category(declarations, entry))) { return false }
                globals = globals + 1
            }
            statement = next_sibling(links, statement)
        }
        return globals > 0
    }
    return node_kind == "fn-item" || node_kind == "type-item" || node_kind == "use-item-p"
}

fn source_origin(rows int, row int) int {
    if (row >= rows * 7 && row < rows * 8) { return row - rows * 7 }
    if (row >= rows * 6 && row < rows * 7) { return row - rows * 6 }
    if (global_mode(rows, row) != 0) { return global_source(rows, row) }
    if (row >= rows && row < rows * 3) { return (row - rows) / 2 }
    if (row >= 0 && row < rows) { return row }
    return 0
}

pub fn checked_core_atom(pg List<int>, ast List<int>, links List<int>, src List<int>, roots List<int>, modules List<int>, declarations List<int>, uses List<int>, mappings List<int>, facts List<int>, types List<int>, layouts List<int>, fuel List<int>, deadline i64, errors List<int>, control int) Str {
    var module_id = 0
    for (module_id < roots.len()) {
        var member = first_child(links, roots.get(module_id))
        for (member >= 0) {
            if (!take_step(fuel, deadline)) {
                failed(errors, member, bind_budget())
                return ""
            }
            let item = first_child(links, member)
            if (item < 0 || !supported_source_item(pg, ast, links, declarations, item)) {
                failed(errors, member, hir_unsupported())
                return ""
            }
            member = next_sibling(links, member)
        }
        module_id = module_id + 1
    }
    var defs = List<int>.new()
    var parameters = List<int>.new()
    var exprs = List<int>.new()
    var args = List<int>.new()
    var blocks = List<int>.new()
    var statements = List<int>.new()
    var records = List<int>.new()
    let shaped = source_record_shapes(pg, ast, declarations, facts, types, records, fuel, deadline)
    if (shaped != 0) {
        failed(errors, 0, shaped)
        return ""
    }
    let status = lower_core(pg, ast, links, src, declarations, uses, mappings, facts, types, records, layouts, defs, parameters, exprs, args, blocks, statements, fuel, deadline, errors)
    if (status != 0) { return "" }
    if (control == 1) { defs.set(2, row_count(ast)) }
    if (control == 2) {
        var position = 0
        for (position < exprs.len()) {
            if (exprs.get(position + 2) == call_op()) {
                exprs.set(position + 4, row_count(ast))
                break
            }
            position = position + 5
        }
    }
    if (control == 3 && layouts.len() >= global_layout_stride()) { layouts.set(2, 0) }
    let verified = verify(defs, parameters, exprs, args, blocks, statements, records, layouts, row_count(ast), fuel, deadline, errors)
    is verified {
        Some(checked) -> { return emit(checked, defs, parameters, exprs, args, blocks, statements, records, ast, src, declarations, modules, layouts.len() > 0) }
        None -> { errors.set(0, source_origin(row_count(ast), errors.get(0))) }
    }
    return ""
}

fn verify_transport(bytes List<int>, layouts List<int>, names List<int>, rows int, module_path Str, fuel List<int>, deadline i64) int {
    if (!has_budget(fuel, deadline, bytes.len())) { return bind_budget() }
    let utf8 = decode_utf8(bytes)
    is utf8 {
        Some(_) -> {}
        None -> { return hir_shape_error() }
    }
    var tokens = List<int>.new()
    var values = List<int>.new()
    var nodes = List<int>.new()
    var sequence = List<int>.new()
    var fields = List<int>.new()
    var items = List<int>.new()
    var parser_error = List<int>.new()
    parser_error.push(0)
    let root = parse_transport_arena(bytes, parser_error, tokens, values, nodes, sequence, fields, items)
    if (!take_step(fuel, deadline)) { return bind_budget() }
    if (root < 0) { return hir_shape_error() }
    let text_record = text_record_transport(bytes, tokens, values, nodes, fields, root)
    if (rows > 0 && !text_record) { return hir_shape_error() }
    var definitions = List<int>.new()
    var parameters = List<int>.new()
    var expressions = List<int>.new()
    var arguments = List<int>.new()
    var blocks = List<int>.new()
    var statements = List<int>.new()
    var records = List<int>.new()
    let status = bind_core_atom(bytes, tokens, values, nodes, sequence, fields, items, root, rows, text_record, names, module_path, definitions, parameters, expressions, arguments, blocks, statements, records)
    if (!take_step(fuel, deadline)) { return bind_budget() }
    if (status == hir_global_authority_error()) { return status }
    if (status == 0) {
        var errors = List<int>.new()
        let verified = verify(definitions, parameters, expressions, arguments, blocks, statements, records, layouts, rows, fuel, deadline, errors)
        is verified {
            Some(_) -> {}
            None -> { return errors.get(1) }
        }
    }
    var schema = core_schema()
    if (text_record) { schema = global_schema() }
    let shaped = validate_transport_arena(str_to_bytes(schema), bytes, parser_error, tokens, nodes, fields, items, root)
    if (!take_step(fuel, deadline)) { return bind_budget() }
    if (!shaped) { return hir_shape_error() }
    if (status != 0) { return status }
    if (text_record) { return 1 }
    return 0
}

pub fn verify_core_document(bytes List<int>, fuel List<int>, deadline i64) int {
    var layouts = List<int>.new()
    var names = List<int>.new()
    return verify_transport(bytes, layouts, names, 0, "", fuel, deadline)
}

pub fn verify_global_document(bytes List<int>, ast List<int>, src List<int>, modules List<int>, declarations List<int>, layouts List<int>, fuel List<int>, deadline i64) int {
    if (layouts.len() == 0) { return hir_global_authority_error() }
    var names = List<int>.new()
    let loaded = build_global_names(ast, src, modules, declarations, layouts, names, fuel, deadline)
    if (loaded != 0) { return loaded }
    let old_domain_result = verify_transport(bytes, layouts, names, row_count(ast), module_name_at(modules, 0), fuel, deadline)
    if (old_domain_result == 1) { return 0 }
    return old_domain_result
}
