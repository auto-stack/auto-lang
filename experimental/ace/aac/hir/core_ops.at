use app.numeric_literal.wide_integer_type
use app.numeric_literal.wide_integer_word
use app.types.boolean_type
use app.types.integer_type

// Operation identities shared by source HIR and the Atom binder. The
// original core operations retain their identities.
pub fn less_than_op() int { return 4 }

pub fn binary_code(name Str) int {
    if (name == "lt_i32") { return less_than_op() }
    if (name == "add_i32") { return 5 }
    if (name == "mul_i32") { return 6 }
    if (name == "sub_i32") { return 12 }
    if (name == "div_i32") { return 13 }
    if (name == "rem_i32") { return 14 }
    if (name == "le_i32") { return 15 }
    if (name == "gt_i32") { return 16 }
    if (name == "ge_i32") { return 17 }
    if (name == "eq") { return 18 }
    if (name == "ne") { return 19 }
    if (name == "and") { return 20 }
    if (name == "or") { return 21 }
    return 0
}

pub fn source_binary(kind Str) int {
    if (kind == "lt") { return less_than_op() }
    if (kind == "plus") { return 5 }
    if (kind == "star") { return 6 }
    if (kind == "minus") { return 12 }
    if (kind == "slash") { return 13 }
    if (kind == "percent") { return 14 }
    if (kind == "le") { return 15 }
    if (kind == "gt") { return 16 }
    if (kind == "ge") { return 17 }
    if (kind == "eq") { return 18 }
    if (kind == "ne") { return 19 }
    if (kind == "andand") { return 20 }
    if (kind == "oror") { return 21 }
    return 0
}

pub fn binary_word(op int) Str {
    if (op == less_than_op()) { return "lt_i32" }
    if (op == 5) { return "add_i32" }
    if (op == 6) { return "mul_i32" }
    if (op == 12) { return "sub_i32" }
    if (op == 13) { return "div_i32" }
    if (op == 14) { return "rem_i32" }
    if (op == 15) { return "le_i32" }
    if (op == 16) { return "gt_i32" }
    if (op == 17) { return "ge_i32" }
    if (op == 18) { return "eq" }
    if (op == 19) { return "ne" }
    if (op == 20) { return "and" }
    if (op == 21) { return "or" }
    return ""
}

pub fn binary_op(op int) bool { return (op >= 4 && op <= 6) || (op >= 12 && op <= 21) }
pub fn extended_binary(op int) bool { return op >= 12 && op <= 21 }
pub fn comparison_op(op int) bool { return op == less_than_op() || (op >= 15 && op <= 19) }
pub fn equality_op(op int) bool { return op == 18 || op == 19 }
pub fn logical_op(op int) bool { return op == 20 || op == 21 }
pub fn overflow_op(op int) bool { return op == 5 || op == 6 || op == 12 }

pub fn wide_constant_op() int { return 22 }

// Block exits and sequential HIR statements use separate tables.
pub fn return_exit() int { return -1 }
pub fn break_exit() int { return -2 }
pub fn continue_exit() int { return -3 }
pub fn fallthrough_exit() int { return -4 }
pub fn loop_statement() int { return 3 }
pub fn if_statement() int { return 4 }
pub fn statement_stride() int { return 5 }

pub fn append_statement(statements List<int>, block int, kind int, first int, second int, alternative int) int {
    statements.push(block)
    statements.push(kind)
    statements.push(first)
    statements.push(second)
    statements.push(alternative)
    return 0
}

// An encoded operator states its operand lane independently of its result.
// The legacy unsuffixed equality accepts either i32 or Bool.
pub fn operator_lane(word Str) int {
    let code = binary_code(word.clone())
    if (logical_op(code)) { return boolean_type() }
    if (equality_op(code)) { return 0 }
    if (code != 0) { return integer_type() }
    var width = 3
    for (width <= 4) {
        let suffix = word.len() - width
        if (suffix > 0 && word.char_at(suffix).to_codepoint() == 95) {
            let lane = wide_integer_type(word.slice(suffix + 1, word.len()).clone())
            if (lane != 0) { return lane }
        }
        width = width + 1
    }
    return -1
}

pub fn typed_binary_code(word Str, lane int) int {
    if (lane < 0) { return 0 }
    if (lane <= boolean_type()) { return binary_code(word) }
    let stem = word.slice(0, word.len() - wide_integer_word(lane).len() - 1).clone()
    if (stem == "eq" || stem == "ne") { return binary_code(stem.move) }
    return binary_code(stem + "_i32")
}

pub fn typed_binary_word(op int, lane int) Str {
    let word = binary_word(op)
    let wide = wide_integer_word(lane)
    if (wide.len() == 0) { return word.move }
    if (equality_op(op)) { return word + "_" + wide }
    return word.slice(0, word.len() - 4).clone() + "_" + wide
}
