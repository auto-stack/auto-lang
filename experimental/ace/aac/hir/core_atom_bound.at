use std.conv.from_int
use std.conv.to_int

pub fn atom_tag(bytes List<int>, tokens List<int>, nodes List<int>, node int) Str {
    if (node < 0) { return "" }
    return token_text(bytes, tokens, nodes.get(node * 8))
}

fn token_text(bytes List<int>, tokens List<int>, token int) Str {
    if (token < 0) { return "" }
    return span_text(bytes, tokens.get(token * 3 + 1), tokens.get(token * 3 + 2))
}

fn value_text(bytes List<int>, tokens List<int>, values List<int>, value int, expected int) Str {
    if (value < 0 || values.get(value * 4) != expected) { return "" }
    return token_text(bytes, tokens, values.get(value * 4 + 1))
}

fn slot(nodes List<int>, seq List<int>, node int, index int) int {
    if (node < 0 || index >= nodes.get(node * 8 + 2)) { return -1 }
    return seq.get(nodes.get(node * 8 + 1) + index)
}

fn field(bytes List<int>, tokens List<int>, nodes List<int>, fields List<int>, node int, name Str) int {
    if (node < 0) { return -1 }
    let start = nodes.get(node * 8 + 3)
    let end = start + nodes.get(node * 8 + 4)
    var at = start
    for (at < end) {
        if (token_text(bytes, tokens, fields.get(at * 2)) == name) { return fields.get(at * 2 + 1) }
        at = at + 1
    }
    return -1
}

fn child(bytes List<int>, tokens List<int>, nodes List<int>, items List<int>, node int, name Str) int {
    if (node < 0) { return -1 }
    var at = nodes.get(node * 8 + 5)
    let limit = at + nodes.get(node * 8 + 6)
    var result = -1
    for (at < limit) {
        if (items.get(at * 2) == 1) {
            let member = items.get(at * 2 + 1)
            if (atom_tag(bytes, tokens, nodes, member) == name) {
                if (result >= 0) { return -1 }
                result = member
            }
        }
        at = at + 1
    }
    return result
}

fn list_size(values List<int>, node int) int {
    if (node < 0 || values.get(node * 4) != 3) { return -1 }
    return values.get(node * 4 + 3)
}

fn list_entry(values List<int>, sequence List<int>, node int, offset int) int {
    return sequence.get(values.get(node * 4 + 2) + offset)
}

fn count_children(nodes List<int>, items List<int>, node int) int {
    if (node < 0) { return 0 }
    var at = nodes.get(node * 8 + 5)
    let limit = at + nodes.get(node * 8 + 6)
    var result = 0
    for (at < limit) {
        if (items.get(at * 2) == 1) { result = result + 1 }
        at = at + 1
    }
    return result
}

fn by_id(bytes List<int>, tokens List<int>, values List<int>, nodes List<int>, sequence List<int>, items List<int>, owner int, name Str) int {
    if (owner < 0 || name.len() == 0) { return -1 }
    var at = nodes.get(owner * 8 + 5)
    let limit = at + nodes.get(owner * 8 + 6)
    var result = -1
    for (at < limit) {
        if (items.get(at * 2) == 1) {
            let node = items.get(at * 2 + 1)
            if (value_text(bytes, tokens, values, slot(nodes, sequence, node, 0), 0) == name) {
                if (result >= 0) { return -1 }
                result = node
            }
        }
        at = at + 1
    }
    return result
}

// The core descriptor accepts ordinary symbolic IDs. The global transport
// is bound to an issued source catalog and keeps its canonical d<number>
// identities so authority for a cell cannot transfer to a different def.
fn definition_id(bytes List<int>, tokens List<int>, values List<int>, nodes List<int>, sequence List<int>, definition int, rows int) int {
    if (definition < 0 || rows == 0) { return definition }
    let name = value_text(bytes, tokens, values, slot(nodes, sequence, definition, 0), 0)
    if (name.len() < 2 || name.len() > 9 || name.char_at(0).to_codepoint() != 100) { return -1 }
    let number_text = name.slice(1, name.len()).clone()
    let parsed = to_int(number_text.clone())
    is parsed {
        Some(value) -> {
            if (value >= 0 && value < rows * 6 && from_int(value) == number_text) { return value }
        }
        None -> {}
    }
    return -1
}

fn number(bytes List<int>, tokens List<int>, values List<int>, value int, ending Str, parsed List<int>) bool {
    let text = value_text(bytes, tokens, values, value, 2)
    let length = text.len()
    if (length <= 3 || text.slice(length - 3, length).clone() != ending) { return false }
    var cursor = 0
    var limit = 2147483647i64
    let negative = text.char_at(0).to_codepoint() == 45
    if (negative) {
        if (ending != "i32" || length == 4) { return false }
        cursor = 1
        limit = 2147483648i64
    }
    var amount = 0i64
    for (cursor < length - 3) {
        let digit = text.char_at(cursor).to_codepoint() - 48
        if (digit < 0 || digit > 9) { return false }
        amount = amount * 10i64 + digit.to(i64)
        if (amount > limit) { return false }
        cursor = cursor + 1
    }
    if (negative) { amount = 0i64 - amount }
    parsed.set(0, amount.to(int))
    return true
}

fn reference_name(bytes List<int>, tokens List<int>, values List<int>, value int) Str {
    if (value >= 0 && values.get(value * 4) == 0) {
        return value_text(bytes, tokens, values, value, 0)
    }
    return value_text(bytes, tokens, values, value, 1)
}

fn named_type(bytes List<int>, tokens List<int>, values List<int>, nodes List<int>, sequence List<int>, items List<int>, types int, type_name Str) int {
    if (type_name == "str") { return text_view_type() }
    if (type_name == "i32") { return 1 }
    if (type_name == "bool") { return 2 }
    let builtin = wide_integer_type(type_name.clone())
    if (builtin != 0) { return builtin }
    let type_node = by_id(bytes, tokens, values, nodes, sequence, items, types, type_name)
    let shape = value_text(bytes, tokens, values, slot(nodes, sequence, type_node, 1), 0)
    if (shape == "i32") { return 1 }
    if (shape == "bool") { return 2 }
    if (shape == "record") { return 100000 + type_node }
    return wide_integer_type(shape.move)
}

fn primitive(bytes List<int>, tokens List<int>, values List<int>, nodes List<int>, sequence List<int>, items List<int>, types int, value int) int {
    return named_type(bytes, tokens, values, nodes, sequence, items, types, reference_name(bytes, tokens, values, value))
}

fn bind_records(bytes List<int>, tokens List<int>, values List<int>, nodes List<int>, sequence List<int>, fields List<int>, items List<int>, types int, records List<int>) int {
    let begin = nodes.get(types * 8 + 5)
    let limit = begin + nodes.get(types * 8 + 6)
    var at = begin
    for (at < limit) {
        if (items.get(at * 2) == 1) {
            let node = items.get(at * 2 + 1)
            if (value_text(bytes, tokens, values, slot(nodes, sequence, node, 1), 0) == "record") {
                let name = value_text(bytes, tokens, values, slot(nodes, sequence, node, 0), 0)
                if (name == "i32" || name == "bool" || name == "str") { return -33 }
                if (by_id(bytes, tokens, values, nodes, sequence, items, types, name) != node) { return -32 }
                let layout = field(bytes, tokens, nodes, fields, node, "fields")
                let length = list_size(values, layout)
                if (length < 0 || nodes.get(node * 8 + 4) != 1 || count_children(nodes, items, node) != 0) { return -30 }
                records.push(100000 + node)
                records.push(length)
                records.push(node)
                var index = 0
                var labels = List<int>.new()
                for (index < length) {
                    let value = list_entry(values, sequence, layout, index)
                    if (values.get(value * 4) != 4) { return -30 }
                    let entry = values.get(value * 4 + 2)
                    if (nodes.get(entry * 8 + 4) != 2) { return -30 }
                    let name_id = field(bytes, tokens, nodes, fields, entry, "name")
                    let label = reference_name(bytes, tokens, values, name_id)
                    if (label.len() == 0) { return -30 }
                    var prior = 0
                    for (prior < labels.len()) {
                        let previous = reference_name(bytes, tokens, values, labels.get(prior))
                        if (previous == label) { return -32 }
                        prior = prior + 1
                    }
                    labels.push(name_id)
                    let ty = primitive(bytes, tokens, values, nodes, sequence, items, types, field(bytes, tokens, nodes, fields, entry, "type"))
                    if (ty == 0) { return -33 }
                    records.push(entry)
                    records.push(ty)
                    index = index + 1
                }
            }
        }
        at = at + 1
    }
    return 0
}

fn bind_arguments(bytes List<int>, tokens List<int>, values List<int>, nodes List<int>, sequence List<int>, fields List<int>, items List<int>, expr_group int, expression int, evaluation_field Str, binding_field Str, formal_field Str, args List<int>) bool {
    let evaluation = field(bytes, tokens, nodes, fields, expression, evaluation_field)
    let bindings = field(bytes, tokens, nodes, fields, expression, binding_field)
    let arity = list_size(values, evaluation)
    if (arity < 0 || arity != list_size(values, bindings)) { return false }
    var slots = List<int>.new()
    var parsed = List<int>.new()
    parsed.push(0)
    var at = 0
    for (at < arity) {
        slots.push(-1)
        at = at + 1
    }
    at = 0
    for (at < arity) {
        let entry = list_entry(values, sequence, bindings, at)
        if (values.get(entry * 4) != 4) { return false }
        let pair = values.get(entry * 4 + 2)
        if (nodes.get(pair * 8 + 4) != 2) { return false }
        let arg = field(bytes, tokens, nodes, fields, pair, "arg")
        let parameter = field(bytes, tokens, nodes, fields, pair, formal_field.clone())
        if (!number(bytes, tokens, values, arg, "u32", parsed)) { return false }
        let index = parsed.get(0)
        if (index < 0 || index >= arity || slots.get(index) >= 0) { return false }
        if (!number(bytes, tokens, values, parameter, "u32", parsed) || parsed.get(0) < 0) { return false }
        slots.set(index, parsed.get(0))
        at = at + 1
    }
    at = 0
    for (at < arity) {
        let value = list_entry(values, sequence, evaluation, at)
        let name = value_text(bytes, tokens, values, value, 1)
        let reference = by_id(bytes, tokens, values, nodes, sequence, items, expr_group, name)
        if (reference < 0) { return false }
        args.push(expression)
        args.push(reference)
        args.push(slots.get(at))
        at = at + 1
    }
    return true
}

fn named_loop(bytes List<int>, tokens List<int>, values List<int>, nodes List<int>, fields List<int>, items List<int>, group int, name Str) int {
    if (name.len() == 0) { return -1 }
    var found = -1
    var at = nodes.get(group * 8 + 5)
    let end = at + nodes.get(group * 8 + 6)
    for (at < end) {
        if (items.get(at * 2) == 1) {
            let block = items.get(at * 2 + 1)
            var stmt = nodes.get(block * 8 + 5)
            let limit = stmt + nodes.get(block * 8 + 6)
            for (stmt < limit) {
                if (items.get(stmt * 2) == 1) {
                    let part = items.get(stmt * 2 + 1)
                    if (atom_tag(bytes, tokens, nodes, part) == "loop") {
                        let id = field(bytes, tokens, nodes, fields, part, "id")
                        if (reference_name(bytes, tokens, values, id) == name) {
                            if (found != -1) { return -1 }
                            found = part
                        }
                    }
                }
                stmt = stmt + 1
            }
        }
        at = at + 1
    }
    return found
}

fn bind_prefix(bytes List<int>, tokens List<int>, values List<int>, nodes List<int>, sequence List<int>, fields List<int>, items List<int>, block int, block_group int, expr_group int, local_group int, place_group int, statements List<int>) int {
    var at = nodes.get(block * 8 + 5)
    let limit = at + nodes.get(block * 8 + 6)
    var terminal = -1
    for (at < limit) {
        if (items.get(at * 2) == 1) {
            if (terminal >= 0) { return -30 }
            let part = items.get(at * 2 + 1)
            let form = atom_tag(bytes, tokens, nodes, part)
            if (form == "let" || form == "assign") {
                if (nodes.get(part * 8 + 4) != 2 || count_children(nodes, items, part) != 0) { return -30 }
                let value = reference_name(bytes, tokens, values, field(bytes, tokens, nodes, fields, part, "value"))
                let result = by_id(bytes, tokens, values, nodes, sequence, items, expr_group, value)
                if (result < 0) { return -32 }
                var local_name = ""
                var op = 1
                if (form == "assign") {
                    let name = reference_name(bytes, tokens, values, field(bytes, tokens, nodes, fields, part, "place"))
                    let place = by_id(bytes, tokens, values, nodes, sequence, items, place_group, name)
                    if (place < 0) { return -32 }
                    local_name = reference_name(bytes, tokens, values, field(bytes, tokens, nodes, fields, place, "local"))
                    op = 2
                } else {
                    local_name = reference_name(bytes, tokens, values, field(bytes, tokens, nodes, fields, part, "local"))
                }
                let local = by_id(bytes, tokens, values, nodes, sequence, items, local_group, local_name)
                if (local < 0) { return -32 }
                append_statement(statements, block, op, local, result, -1)
            } else {
                if (form == "if" || form == "loop") {
                    let count = nodes.get(part * 8 + 4)
                    if (count < 2 || count > 3 || count_children(nodes, items, part) != 0) { return -30 }
                    if (form == "loop") {
                        if (count != 2) { return -30 }
                        let body_name = reference_name(bytes, tokens, values, field(bytes, tokens, nodes, fields, part, "body"))
                        let target = by_id(bytes, tokens, values, nodes, sequence, items, block_group, body_name)
                        let id = reference_name(bytes, tokens, values, field(bytes, tokens, nodes, fields, part, "id"))
                        if (target < 0 || named_loop(bytes, tokens, values, nodes, fields, items, block_group, id) != part) { return -32 }
                        append_statement(statements, block, loop_statement(), part, target, -1)
                    } else {
                        let cond_name = reference_name(bytes, tokens, values, field(bytes, tokens, nodes, fields, part, "cond"))
                        let then_name = reference_name(bytes, tokens, values, field(bytes, tokens, nodes, fields, part, "then"))
                        let cond = by_id(bytes, tokens, values, nodes, sequence, items, expr_group, cond_name)
                        let yes = by_id(bytes, tokens, values, nodes, sequence, items, block_group, then_name)
                        if (cond < 0 || yes < 0) { return -32 }
                        let else_value = field(bytes, tokens, nodes, fields, part, "else")
                        var no = -1
                        if (else_value >= 0) {
                            let name = reference_name(bytes, tokens, values, else_value)
                            no = by_id(bytes, tokens, values, nodes, sequence, items, block_group, name)
                            if (no < 0) { return -32 }
                        }
                        append_statement(statements, block, if_statement(), yes, cond, no)
                    }
                } else {
                    terminal = part
                }
            }
        }
        at = at + 1
    }
    return terminal
}

fn bind_blocks(bytes List<int>, tokens List<int>, values List<int>, nodes List<int>, sequence List<int>, fields List<int>, items List<int>, owner int, expr_group int, block_group int, local_group int, place_group int, blocks List<int>, statements List<int>) int {
    var at = nodes.get(block_group * 8 + 5)
    let limit = at + nodes.get(block_group * 8 + 6)
    for (at < limit) {
        if (items.get(at * 2) == 1) {
            let block = items.get(at * 2 + 1)
            if (atom_tag(bytes, tokens, nodes, block) != "block") { return -30 }
            let name = value_text(bytes, tokens, values, slot(nodes, sequence, block, 0), 0)
            if (by_id(bytes, tokens, values, nodes, sequence, items, block_group, name) != block) { return -32 }
            let terminal = bind_prefix(bytes, tokens, values, nodes, sequence, fields, items, block, block_group, expr_group, local_group, place_group, statements)
            if (terminal < -1) { return terminal }
            var result = -1
            var target = -1
            var exit = fallthrough_exit()
            if (terminal >= 0) {
                if (nodes.get(terminal * 8 + 4) != 1 || count_children(nodes, items, terminal) != 0) { return -30 }
                let form = atom_tag(bytes, tokens, nodes, terminal)
                if (form == "return") {
                    let name = reference_name(bytes, tokens, values, field(bytes, tokens, nodes, fields, terminal, "value"))
                    result = by_id(bytes, tokens, values, nodes, sequence, items, expr_group, name)
                    if (result < 0) { return -32 }
                    exit = return_exit()
                } else {
                    if (form != "break" && form != "continue") { return -30 }
                    let name = reference_name(bytes, tokens, values, field(bytes, tokens, nodes, fields, terminal, "target"))
                    target = named_loop(bytes, tokens, values, nodes, fields, items, block_group, name)
                    if (target < 0) { return -32 }
                    exit = break_exit()
                    if (form == "continue") { exit = continue_exit() }
                }
            }
            blocks.push(block)
            blocks.push(owner)
            blocks.push(exit)
            blocks.push(target)
            blocks.push(-1)
            blocks.push(result)
        }
        at = at + 1
    }
    return 0
}

fn validate_places(bytes List<int>, tokens List<int>, values List<int>, nodes List<int>, sequence List<int>, fields List<int>, items List<int>, local_group int, place_group int) int {
    if (place_group < 0) { return 0 }
    var at = nodes.get(place_group * 8 + 5)
    let limit = at + nodes.get(place_group * 8 + 6)
    for (at < limit) {
        if (items.get(at * 2) == 1) {
            let place = items.get(at * 2 + 1)
            if (atom_tag(bytes, tokens, nodes, place) != "place" || nodes.get(place * 8 + 2) != 2 || nodes.get(place * 8 + 4) != 3) { return -30 }
            let name = value_text(bytes, tokens, values, slot(nodes, sequence, place, 0), 0)
            if (by_id(bytes, tokens, values, nodes, sequence, items, place_group, name) != place) { return -32 }
            if (value_text(bytes, tokens, values, slot(nodes, sequence, place, 1), 0) != "local") { return -30 }
            let local_name = value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, place, "local"), 1)
            let local = by_id(bytes, tokens, values, nodes, sequence, items, local_group, local_name)
            if (local < 0) { return -32 }
            let type_field = field(bytes, tokens, nodes, fields, place, "type")
            var lane = value_text(bytes, tokens, values, type_field, 1)
            if (value_text(bytes, tokens, values, type_field, 0) == "str") { lane = "str" }
            if (lane != value_text(bytes, tokens, values, slot(nodes, sequence, local, 1), 0)) { return -33 }
            if (value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, place, "access"), 0) != "mutable") { return -41 }
        }
        at = at + 1
    }
    return 0
}

fn bind_body(bytes List<int>, tokens List<int>, values List<int>, nodes List<int>, sequence List<int>, fields List<int>, items List<int>, declaration_group int, type_group int, body int, owner int, signature int, rows int, extended bool, numeric bool, defs List<int>, params List<int>, expressions List<int>, args List<int>, blocks List<int>, statements List<int>, exact List<int>, fuel List<int>, deadline i64) int {
    let local_group = child(bytes, tokens, nodes, items, body, "locals")
    let expr_group = child(bytes, tokens, nodes, items, body, "expressions")
    let block_group = child(bytes, tokens, nodes, items, body, "blocks")
    let place_group = child(bytes, tokens, nodes, items, body, "places")
    if (expr_group < 0 || block_group < 0 || count_children(nodes, items, block_group) == 0) { return -30 }
    var groups = 2
    if (local_group >= 0) { groups = 3 }
    if (place_group >= 0) { groups = groups + 1 }
    if (groups != count_children(nodes, items, body) || nodes.get(body * 8 + 4) != 2) { return -30 }
    let entry_name = value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, body, "entry"), 1)
    let entry = by_id(bytes, tokens, values, nodes, sequence, items, block_group, entry_name)
    if (atom_tag(bytes, tokens, nodes, entry) != "block") { return -32 }
    let result = primitive(bytes, tokens, values, nodes, sequence, items, type_group, field(bytes, tokens, nodes, fields, signature, "result"))
    if (result == 0) { return -33 }
    defs.push(owner)
    defs.push(result)
    let owner_name = value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, body, "owner"), 1)
    let owner_ref = by_id(bytes, tokens, values, nodes, sequence, items, declaration_group, owner_name)
    defs.push(definition_id(bytes, tokens, values, nodes, sequence, owner_ref, rows))
    defs.push(entry)

    let sig_params = field(bytes, tokens, nodes, fields, signature, "params")
    let expected = list_size(values, sig_params)
    if (expected < 0) { return -33 }
    var formal_count = 0
    var parsed = List<int>.new()
    parsed.push(0)
    if (local_group >= 0) {
        var at = nodes.get(local_group * 8 + 5)
        let limit = at + nodes.get(local_group * 8 + 6)
        var seen = List<int>.new()
        var index = 0
        for (index < expected) {
            seen.push(0)
            index = index + 1
        }
        for (at < limit) {
            if (items.get(at * 2) == 1) {
                let local = items.get(at * 2 + 1)
                let local_role = field(bytes, tokens, nodes, fields, local, "role")
                let index_value = field(bytes, tokens, nodes, fields, local, "index")
                if (atom_tag(bytes, tokens, nodes, local) != "local") { return -30 }
                if (nodes.get(local * 8 + 2) != 2 || count_children(nodes, items, local) != 0) { return -30 }
                let local_id = value_text(bytes, tokens, values, slot(nodes, sequence, local, 0), 0)
                let local_name = field(bytes, tokens, nodes, fields, local, "name")
                if (value_text(bytes, tokens, values, local_name, 1).len() == 0 || by_id(bytes, tokens, values, nodes, sequence, items, local_group, local_id) != local) { return -32 }
                let type_name = value_text(bytes, tokens, values, slot(nodes, sequence, local, 1), 0)
                let shape = value_text(bytes, tokens, values, local_role, 0)
                var type_id = 0
                if (shape == "param") {
                    if (!number(bytes, tokens, values, index_value, "u32", parsed)) { return -33 }
                    index = parsed.get(0)
                    if (index < 0 || index >= expected || seen.get(index) != 0) { return -33 }
                    seen.set(index, 1)
                    formal_count = formal_count + 1
                    let expected_type = list_entry(values, sequence, sig_params, index)
                    type_id = primitive(bytes, tokens, values, nodes, sequence, items, type_group, expected_type)
                    if (type_id == text_view_type()) {
                        let mode = field(bytes, tokens, nodes, fields, local, "mode")
                        if (type_name != "str" || nodes.get(local * 8 + 4) != 4 || value_text(bytes, tokens, values, mode, 0) != "view") { return -33 }
                    } else {
                        let mode = field(bytes, tokens, nodes, fields, local, "mode")
                        var expected_fields = 3
                        if (mode >= 0 && type_id >= 100000 && value_text(bytes, tokens, values, mode, 0) == "view") { expected_fields = 4 }
                        if (nodes.get(local * 8 + 4) != expected_fields || type_name != reference_name(bytes, tokens, values, expected_type)) { return -33 }
                    }
                } else {
                    if (shape != "binding" || index_value >= 0) { return -30 }
                    type_id = named_type(bytes, tokens, values, nodes, sequence, items, type_group, type_name)
                    let mutability = field(bytes, tokens, nodes, fields, local, "mutable")
                    index = -1
                    if (mutability >= 0) {
                        let mutable = value_text(bytes, tokens, values, mutability, 0)
                        if (mutable == "true") { index = -2 }
                        if (mutable != "true" && mutable != "false") { return -30 }
                    }
                }
                if (type_id == 0) { return -33 }
                params.push(owner)
                params.push(local)
                params.push(type_id)
                params.push(index)
            }
            at = at + 1
        }
    }
    if (formal_count != expected) { return -33 }
    let places_checked = validate_places(bytes, tokens, values, nodes, sequence, fields, items, local_group, place_group)
    if (places_checked != 0) { return places_checked }
    var at = nodes.get(expr_group * 8 + 5)
    let limit = at + nodes.get(expr_group * 8 + 6)
    for (at < limit) {
        if (items.get(at * 2) == 1) {
            let expression = items.get(at * 2 + 1)
            if (atom_tag(bytes, tokens, nodes, expression) != "expr") { return -30 }
            if (nodes.get(expression * 8 + 2) != 2 || count_children(nodes, items, expression) != 0) { return -30 }
            let name = value_text(bytes, tokens, values, slot(nodes, sequence, expression, 0), 0)
            if (by_id(bytes, tokens, values, nodes, sequence, items, expr_group, name) != expression) { return -32 }
            let ty = primitive(bytes, tokens, values, nodes, sequence, items, type_group, field(bytes, tokens, nodes, fields, expression, "type"))
            if (ty == 0) { return -33 }
            let form = value_text(bytes, tokens, values, slot(nodes, sequence, expression, 1), 0)
            var operation = 0
            var payload = -1
            let field_count = nodes.get(expression * 8 + 4)
            if (form == "constant") {
                if (field_count != 2) { return -30 }
                let value = field(bytes, tokens, nodes, fields, expression, "value")
                if (ty == integer_type()) {
                    if (!number(bytes, tokens, values, value, "i32", parsed)) { return -33 }
                    operation = 1
                    payload = parsed.get(0)
                } else {
                    if (!numeric || wide_integer_word(ty).len() == 0 || value < 0 || values.get(value * 4) != 2) { return -33 }
                    let token = values.get(value * 4 + 1)
                    var start = tokens.get(token * 3 + 1)
                    let end = tokens.get(token * 3 + 2)
                    let negative = bytes.get(start) == 45
                    if (negative) { start = start + 1 }
                    payload = exact.len()
                    let lane = decode_wide_integer(bytes, start, end, negative, exact, fuel, deadline)
                    if (lane == bind_budget()) { return lane }
                    if (lane != ty) { return -33 }
                    operation = wide_constant_op()
                }
            }
            if (form == "read_local") {
                if (field_count != 2) { return -30 }
                operation = 2
                let name = value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, expression, "local"), 1)
                payload = by_id(bytes, tokens, values, nodes, sequence, items, local_group, name)
            }
            if (form == "call") {
                if (field_count != 4) { return -30 }
                operation = 3
                let name = value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, expression, "callee"), 1)
                let reference = by_id(bytes, tokens, values, nodes, sequence, items, declaration_group, name)
                payload = definition_id(bytes, tokens, values, nodes, sequence, reference, rows)
                if (!bind_arguments(bytes, tokens, values, nodes, sequence, fields, items, expr_group, expression, "eval_args", "bindings", "param", args)) { return -32 }
            }
            if (form == "binary" || form == "logical") {
                let op_field = field(bytes, tokens, nodes, fields, expression, "op")
                let word = value_text(bytes, tokens, values, op_field, 0)
                payload = operator_lane(word.clone())
                if (!numeric && payload > boolean_type()) { return -30 }
                operation = typed_binary_code(word.move, payload)
                if (operation == 0 || logical_op(operation) != (form == "logical")) { return -30 }
                if (!extended && extended_binary(operation)) { return -30 }
                if (overflow_op(operation)) {
                    let overflow = field(bytes, tokens, nodes, fields, expression, "overflow")
                    if (field_count != 5 || value_text(bytes, tokens, values, overflow, 0) != "trap") { return -30 }
                } else {
                    if (field_count != 4) { return -30 }
                }
                let left_name = value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, expression, "lhs"), 1)
                let right_name = value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, expression, "rhs"), 1)
                args.push(expression)
                args.push(by_id(bytes, tokens, values, nodes, sequence, items, expr_group, left_name))
                args.push(0)
                args.push(expression)
                args.push(by_id(bytes, tokens, values, nodes, sequence, items, expr_group, right_name))
                args.push(1)
            }
            if (form == "str_lit") {
                let value = field(bytes, tokens, nodes, fields, expression, "text")
                if (field_count != 2 || value < 0 || values.get(value * 4) != 1) { return -30 }
                operation = 7
                payload = expression
            }
            if (form == "text_len") {
                if (field_count != 2) { return -30 }
                let operand = value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, expression, "operand"), 1)
                payload = by_id(bytes, tokens, values, nodes, sequence, items, expr_group, operand)
                if (payload < 0) { return -32 }
                operation = 8
                args.push(expression)
                args.push(payload)
                args.push(0)
            }
            if (form == "record_ctor") {
                if (field_count != 4) { return -30 }
                operation = 9
                payload = primitive(bytes, tokens, values, nodes, sequence, items, type_group, field(bytes, tokens, nodes, fields, expression, "record"))
                if (!bind_arguments(bytes, tokens, values, nodes, sequence, fields, items, expr_group, expression, "field_args", "ctor_bindings", "field", args)) { return -32 }
            }
            if (form == "field_get") {
                if (field_count != 3) { return -30 }
                let base = value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, expression, "base"), 1)
                let operand = by_id(bytes, tokens, values, nodes, sequence, items, expr_group, base)
                if (operand < 0) { return -32 }
                let path = field(bytes, tokens, nodes, fields, expression, "path")
                if (list_size(values, path) != 1) { return -30 }
                let index = list_entry(values, sequence, path, 0)
                if (!number(bytes, tokens, values, index, "u32", parsed)) { return -32 }
                operation = 10
                payload = parsed.get(0)
                args.push(expression)
                args.push(operand)
                args.push(0)
            }
            if (form == "borrow_view") {
                if (field_count != 2) { return -30 }
                let base = value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, expression, "base"), 1)
                payload = by_id(bytes, tokens, values, nodes, sequence, items, expr_group, base)
                if (payload < 0) { return -32 }
                operation = 11
                args.push(expression)
                args.push(payload)
                args.push(0)
            }
            if (operation == 0) { return -30 }
            expressions.push(expression)
            expressions.push(owner)
            expressions.push(operation)
            expressions.push(ty)
            expressions.push(payload)
        }
        at = at + 1
    }
    return bind_blocks(bytes, tokens, values, nodes, sequence, fields, items, owner, expr_group, block_group, local_group, place_group, blocks, statements)
}

fn bind_global_intrinsic(bytes List<int>, tokens List<int>, values List<int>, nodes List<int>, sequence List<int>, fields List<int>, items List<int>, types int, node int, definition int, signature int, rows int, names List<int>, defs List<int>, params List<int>) int {
    let mode = global_mode(rows, definition)
    if (mode != getter_mode() && mode != setter_mode()) { return -43 }
    let allowed = authorized_global_name(names, global_source(rows, definition))
    if (allowed.len() == 0) { return -43 }
    var prefix = "module.global.get:"
    var effect = "pure"
    var arity = 0
    if (mode == setter_mode()) {
        prefix = "module.global.set:"
        effect = "observable"
        arity = 1
    }
    let symbol = value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, node, "symbol"), 1)
    let effect_name = value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, node, "effect"), 0)
    if (symbol != prefix + allowed || effect_name != effect) { return -43 }
    let result = primitive(bytes, tokens, values, nodes, sequence, items, types, field(bytes, tokens, nodes, fields, signature, "result"))
    let formals = field(bytes, tokens, nodes, fields, signature, "params")
    if (result == 0 || list_size(values, formals) != arity) { return -33 }
    if (arity == 1) {
        let value = list_entry(values, sequence, formals, 0)
        let input = primitive(bytes, tokens, values, nodes, sequence, items, types, value)
        if (input == 0) { return -33 }
        params.push(definition)
        params.push(definition)
        params.push(input)
        params.push(0)
    }
    defs.push(definition)
    defs.push(result)
    defs.push(-1)
    defs.push(-1)
    return 0
}

pub fn text_record_transport(bytes List<int>, tokens List<int>, values List<int>, nodes List<int>, fields List<int>, root int) bool {
    let profile = field(bytes, tokens, nodes, fields, root, "profile")
    return value_text(bytes, tokens, values, profile, 1) == "text-record-i32-draft"
}

pub fn scalar_transport(bytes List<int>, tokens List<int>, values List<int>, nodes List<int>, fields List<int>, root int) bool {
    let profile = field(bytes, tokens, nodes, fields, root, "profile")
    return value_text(bytes, tokens, values, profile, 1) == "scalar-i32-draft"
}

pub fn numeric_transport(bytes List<int>, tokens List<int>, values List<int>, nodes List<int>, fields List<int>, root int) bool {
    let profile = field(bytes, tokens, nodes, fields, root, "profile")
    return value_text(bytes, tokens, values, profile, 1) == "source-numeric-draft"
}

pub fn bind_core_atom(bytes List<int>, tokens List<int>, values List<int>, nodes List<int>, sequence List<int>, fields List<int>, items List<int>, root int, rows int, text_record bool, scalar bool, numeric bool, global_names List<int>, module_path Str, defs List<int>, params List<int>, expressions List<int>, args List<int>, blocks List<int>, statements List<int>, records List<int>, exact List<int>, fuel List<int>, deadline i64) int {
    let schema = value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, root, "schema"), 1)
    let profile = value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, root, "profile"), 1)
    let revision = value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, root, "revision"), 2)
    var expected_schema = "auto.hir.core.draft"
    var expected_profile = "core-i32-draft"
    if (text_record) {
        expected_schema = "auto.hir.text-record.draft"
        expected_profile = "text-record-i32-draft"
    }
    if (scalar) {
        expected_schema = "auto.hir.scalar.draft"
        expected_profile = "scalar-i32-draft"
    }
    if (numeric) {
        expected_schema = "auto.hir.numeric.draft"
        expected_profile = "source-numeric-draft"
    }
    if (schema != expected_schema || profile != expected_profile || revision != "1u32") { return -34 }
    let capabilities = field(bytes, tokens, nodes, fields, root, "requires")
    if (nodes.get(root * 8 + 2) != 0) { return -30 }
    var text_runtime = false
    if (capabilities >= 0 && list_size(values, capabilities) != 0) {
        if (!text_record || list_size(values, capabilities) != 1) { return -30 }
        let contract = list_entry(values, sequence, capabilities, 0)
        if (value_text(bytes, tokens, values, contract, 1) != "ac.runtime.text.v1") { return -30 }
        text_runtime = true
    }
    let module_node = child(bytes, tokens, nodes, items, root, "module")
    if (module_node < 0 || count_children(nodes, items, root) != 1) { return -30 }
    if (rows > 0) {
        let actual_path = value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, module_node, "path"), 1)
        if (actual_path != module_path) { return -43 }
    }
    let types = child(bytes, tokens, nodes, items, module_node, "types")
    let declarations = child(bytes, tokens, nodes, items, module_node, "declarations")
    let bodies = child(bytes, tokens, nodes, items, module_node, "bodies")
    if (types < 0 || declarations < 0 || bodies < 0 || count_children(nodes, items, module_node) != 3) { return -30 }
    let layouts = bind_records(bytes, tokens, values, nodes, sequence, fields, items, types, records)
    if (layouts != 0) { return layouts }
    if (records.len() > 0 && !text_record) { return -30 }
    let body_count = count_children(nodes, items, bodies)
    if (body_count == 0) { return -31 }
    var at = nodes.get(declarations * 8 + 5)
    let limit = at + nodes.get(declarations * 8 + 6)
    var claimed = List<int>.new()
    for (at < limit) {
        if (items.get(at * 2) == 1) {
            let function = items.get(at * 2 + 1)
            let form = atom_tag(bytes, tokens, nodes, function)
            if (form != "function" && form != "intrinsic") { return -30 }
            if (nodes.get(function * 8 + 2) != 2 || nodes.get(function * 8 + 4) != 2 || count_children(nodes, items, function) != 0) { return -30 }
            let name = value_text(bytes, tokens, values, slot(nodes, sequence, function, 0), 0)
            if (by_id(bytes, tokens, values, nodes, sequence, items, declarations, name) != function) { return -32 }
            let identity = definition_id(bytes, tokens, values, nodes, sequence, function, rows)
            if (identity < 0) { return -32 }
            let sig_name = value_text(bytes, tokens, values, slot(nodes, sequence, function, 1), 0)
            let signature = by_id(bytes, tokens, values, nodes, sequence, items, types, sig_name)
            if (value_text(bytes, tokens, values, slot(nodes, sequence, signature, 1), 0) != "function") { return -33 }
            if (form == "intrinsic") {
                if (rows <= 0) { return -43 }
                let admitted = bind_global_intrinsic(bytes, tokens, values, nodes, sequence, fields, items, types, function, identity, signature, rows, global_names, defs, params)
                if (admitted != 0) { return admitted }
                at = at + 1
                continue
            }
            let function_name = value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, function, "name"), 1)
            if (function_name.len() == 0) { return -30 }
            let mode = global_mode(rows, identity)
            if (mode != 0) {
                let allowed = authorized_global_name(global_names, global_source(rows, identity))
                if (mode != initializer_mode() || allowed.len() == 0 || function_name != "__aac_init_" + allowed) { return -43 }
            }
            let body_name = value_text(bytes, tokens, values, field(bytes, tokens, nodes, fields, function, "body"), 1)
            let body = by_id(bytes, tokens, values, nodes, sequence, items, bodies, body_name)
            if (body < 0 || atom_tag(bytes, tokens, nodes, body) != "body") { return -31 }
            var i = 0
            for (i < claimed.len()) {
                if (claimed.get(i) == body) { return -31 }
                i = i + 1
            }
            claimed.push(body)
            let status = bind_body(bytes, tokens, values, nodes, sequence, fields, items, declarations, types, body, identity, signature, rows, text_record || scalar || numeric, numeric, defs, params, expressions, args, blocks, statements, exact, fuel, deadline)
            if (status != 0) { return status }
        }
        at = at + 1
    }
    if (claimed.len() != body_count) { return -31 }
    if (!numeric) {
        var i = 0
        for (i < defs.len()) {
            if (wide_integer_word(defs.get(i + 1)).len() > 0) { return -30 }
            i = i + 4
        }
        i = 0
        for (i < params.len()) {
            if (wide_integer_word(params.get(i + 2)).len() > 0) { return -30 }
            i = i + 4
        }
        i = 0
        for (i < expressions.len()) {
            if (wide_integer_word(expressions.get(i + 3)).len() > 0) { return -30 }
            i = i + 5
        }
    }
    if (!text_runtime) {
        var i = 0
        for (i < defs.len()) {
            if (defs.get(i + 1) == text_view_type()) { return -30 }
            i = i + 4
        }
        i = 0
        for (i < params.len()) {
            if (params.get(i + 2) == text_view_type()) { return -30 }
            i = i + 4
        }
        i = 0
        for (i < expressions.len()) {
            if (expressions.get(i + 3) == text_view_type()) { return -30 }
            i = i + 5
        }
    }
    return 0
}
