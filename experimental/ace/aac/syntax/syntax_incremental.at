// AAC incremental lex: resume at a trusted token boundary, stop at the
// first aligned run, then translate the untouched old suffix.

use app.syntax_program.is_trivia_token
use app.syntax_lexer.tok_count
use app.syntax_lexer.tok_token
use app.syntax_lexer.tok_start
use app.syntax_lexer.tok_end
use app.syntax_lexer.tok_line
use app.syntax_lexer.tok_error
use app.syntax_lexer.scan_next
use app.syntax_lexer.st_new

pub fn rescan_window() int { return 65536 }
pub fn converge_k() int { return 8 }

pub fn fb_none() int { return 0 }
pub fn fb_unterminated() int { return 1 }
pub fn fb_no_convergence() int { return 2 }
pub fn fb_complex_edits() int { return 3 }

fn is_trivia_tok(pg List<int>, t int) bool {
    if (t == -1) {
        return false
    }
    return is_trivia_token(pg, t)
}

fn checkpoint_index(pg List<int>, old List<int>, start int) int {
    let count = tok_count(old)
    var lo = 0
    var hi = count
    for (lo < hi) {
        let mid = (lo + hi) / 2
        if (tok_end(old, mid) <= start) {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    var at = lo
    // An insertion at EOF can extend the preceding token.
    if (at == count && count > 0) {
        at = count - 1
    }
    for (at > 0 && is_trivia_tok(pg, tok_token(old, at - 1))) {
        at = at - 1
    }
    for (at > 0 && !is_trivia_tok(pg, tok_token(old, at - 1)) && tok_end(old, at - 1) == tok_start(old, at)) {
        at = at - 1
    }
    return at
}

fn old_token_at(old List<int>, offset int, from int) int {
    var lo = from
    var hi = tok_count(old)
    for (lo < hi) {
        let mid = (lo + hi) / 2
        if (tok_start(old, mid) < offset) {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if (lo < tok_count(old) && tok_start(old, lo) == offset) {
        return lo
    }
    return -1
}

fn token_aligned(head List<int>, new_index int, old List<int>, old_index int, delta int) bool {
    if (old_index >= tok_count(old)) {
        return false
    }
    let ns = tok_start(head, new_index)
    let os = tok_start(old, old_index)
    return ns - os == delta && tok_token(head, new_index) == tok_token(old, old_index) && tok_end(head, new_index) - ns == tok_end(old, old_index) - os && tok_error(head, new_index) == tok_error(old, old_index)
}

fn alignment_anchor(pg List<int>, head List<int>, j int, old List<int>, cp int, edited_end int, delta int) int {
    let start = tok_start(head, j)
    if (start < edited_end || is_trivia_tok(pg, tok_token(head, j))) {
        return -1
    }
    let oi = old_token_at(old, start - delta, cp)
    if (oi < 0 || !token_aligned(head, j, old, oi, delta)) {
        return -1
    }
    if (oi == 0) {
        return oi
    }
    if (is_trivia_tok(pg, tok_token(old, oi - 1)) || tok_end(old, oi - 1) < tok_start(old, oi)) {
        return oi
    }
    return -1
}

fn append_tokens(dst List<int>, src List<int>, from int, end int, delta int, lines int) int {
    var i = from
    for (i < end) {
        let base = i * 5
        dst.push(src.get(base))
        dst.push(src.get(base + 1) + delta)
        dst.push(src.get(base + 2) + delta)
        dst.push(src.get(base + 3) + lines)
        dst.push(src.get(base + 4))
        i = i + 1
    }
    return 0
}

/// Produces [ok, fallback, rescan_bytes, new_base, old_base, prefix_len,
/// token_count]. Both output lists are empty on entry. A fallback only
/// publishes its reason and scanned-byte count, leaving toks_out empty.
pub fn incremental_lex(pg List<int>, cs List<int>, old_toks List<int>, srcb List<int>, new_len int, e_start int, e_end int, delta int, toks_out List<int>, out List<int>) int {
    var slot = 0
    for (slot < 7) {
        out.push(0)
        slot = slot + 1
    }
    let cp = checkpoint_index(pg, old_toks, e_start)
    let old_count = tok_count(old_toks)
    let st = st_new()
    if (old_count > 0) {
        st.set(0, tok_start(old_toks, cp))
    }
    if (cp > 0) {
        if (tok_error(old_toks, cp - 1)) {
            out.set(1, fb_unterminated())
            return 0
        }
        st.set(1, tok_line(old_toks, cp - 1))
    }
    let rescan_start = st.get(0)
    let hard_end = rescan_start + rescan_window() + 1
    st.set(9, new_len)
    if (hard_end < new_len) {
        st.set(9, hard_end)
    }

    var head = List<int>.new()
    var diags = List<int>.new()
    var run_old = -1
    var run_len = 0
    for (scan_next(pg, cs, srcb, st, head, diags) != 0) {
        let scanned = st.get(0) - rescan_start
        if (scanned > rescan_window()) {
            out.set(1, fb_no_convergence())
            out.set(2, scanned)
            return 0
        }
        let j = tok_count(head) - 1
        if (run_len > 0 && token_aligned(head, j, old_toks, run_old + run_len, delta)) {
            run_len = run_len + 1
            if (run_len == converge_k()) {
                let old_base = run_old + run_len
                let new_head_count = j + 1
                let lines = tok_line(head, j) - tok_line(old_toks, old_base - 1)
                append_tokens(toks_out, old_toks, 0, cp, 0, 0)
                append_tokens(toks_out, head, 0, new_head_count, 0, 0)
                append_tokens(toks_out, old_toks, old_base, old_count, delta, lines)
                out.set(0, 1)
                out.set(2, scanned)
                out.set(3, cp + new_head_count)
                out.set(4, old_base)
                out.set(5, cp)
                out.set(6, tok_count(toks_out))
                return 1
            }
        } else {
            run_old = alignment_anchor(pg, head, j, old_toks, cp, e_end + delta, delta)
            run_len = 0
            if (run_old >= 0) {
                run_len = 1
            }
        }
    }
    out.set(1, fb_no_convergence())
    out.set(2, st.get(0) - rescan_start)
    return 0
}
