use app.syntax_grammar_data.auto_parts
use app.syntax_grammar_data.aac_parts
use app.syntax_grammar_data.age_package_parts
use app.syntax_grammar_data.packages_ct_parts
use app.syntax_grammar_data.packages_modules_parts
use app.syntax_grammar_data.text_record_instances_parts
use app.syntax_grammar_data.scalar_parts
use app.syntax_grammar_data.scheduler_parts
use app.syntax_lexer.compile_scanner
use app.syntax_lexer.lex_all
use app.syntax_lexer.tok_count
use app.syntax_lexer.tok_end
use app.syntax_lexer.tok_start
use app.syntax_lexer.tok_token
use app.syntax_lexer.tok_trivia
use app.syntax_fstr.fstr_default
use app.syntax_fstr.fstr_scheduler
use app.syntax_fstr.format_resource
use app.syntax_fstr.normalize_formats
use app.syntax_fstr.remap_format_tree
use app.syntax_parse.first_sets_into
use app.syntax_parse.parse_tokens
use std.bytes.utf8_len
use std.bytes.byte_of
use std.text.equal

pub fn fetch_parts(name Str) List<Str> {
    if (equal(name.clone(), "aac")) {
        return aac_parts()
    }
    if (equal(name.clone(), "auto")) {
        return auto_parts()
    }
    if (equal(name.clone(), "age-package")) {
        return age_package_parts()
    }
    if (equal(name.clone(), "packages-ct")) {
        return packages_ct_parts()
    }
    if (equal(name.clone(), "packages-modules")) {
        return packages_modules_parts()
    }
    if (equal(name.clone(), "text-record-instances")) {
        return text_record_instances_parts()
    }
    if (equal(name.clone(), "scalar")) {
        return scalar_parts()
    }
    if (equal(name.clone(), "scheduler")) {
        return scheduler_parts()
    }
    return List<Str>.new()
}

pub fn str_to_bytes(s Str) List<int> {
    var out = List<int>.new()
    var i = 0
    for (i < s.len()) {
        let c = s.char_at(i).to_codepoint()
        let n = utf8_len(c)
        var k = 0
        for (k < n) {
            out.push(byte_of(c, k))
            k = k + 1
        }
        i = i + 1
    }
    return out
}

pub fn format_mode(profile Str) int {
    if (equal(profile.clone(), "auto") || equal(profile.clone(), "aac")) { return fstr_default() }
    if (equal(profile, "scheduler")) { return fstr_scheduler() }
    return 0
}

pub fn diag_format_syntax() int { return 10 }
pub fn diag_format_eof() int { return 11 }

pub fn parse_cst(pg List<int>, mode int, srcb List<int>, t List<int>, ef List<int>, decls List<int>, dmsg List<int>, depth int, work int) int {
    var virtual = List<int>.new()
    var mapping = List<int>.new()
    var marks = List<int>.new()
    let prepared = normalize_formats(srcb, srcb.len(), mode, work, virtual, mapping, marks)
    if (prepared == format_resource()) { return -3 }
    if (prepared <= 0) {
        let root = parse_input(pg, srcb, t, ef, decls, dmsg, depth, work, false)
        if (prepared < 0 && root >= 0) {
            let at = -prepared - 1
            var end = at
            if (at < srcb.len()) { end = at + 1 }
            dmsg.push(diag_format_syntax())
            dmsg.push(at)
            dmsg.push(end)
            dmsg.push(0)
        }
        return root
    }
    let extra = (virtual.len() + mapping.len() + marks.len()) * 4
    if (extra > work) { return -3 }
    let root = parse_input(pg, virtual, t, ef, decls, dmsg, depth, work - extra, true)
    if (root >= 0) { remap_format_tree(mapping, marks, t, decls, dmsg) }
    return root
}

fn parse_input(pg List<int>, srcb List<int>, t List<int>, ef List<int>, decls List<int>, dmsg List<int>, depth int, work int, mapped bool) int {
    let cs = compile_scanner(pg)
    var toks = List<int>.new()
    var lexd = List<int>.new()
    lex_all(pg, cs, srcb, -1, toks, lexd)
    var firsts = List<int>.new()
    var nullable = List<int>.new()
    if (first_sets_into(pg, firsts, nullable) != 0) {
        return -6
    }
    var cold = List<int>.new()
    cold.push(0)
    let root = parse_tokens(pg, cs, firsts, nullable, toks, srcb, t, ef, decls, dmsg, List<int>.new(), List<int>.new(), List<int>.new(), List<int>.new(), List<int>.new(), cold, depth, work)
    if (mapped && root >= 0) { add_format_eof(toks, srcb, srcb.len(), dmsg) }
    return root
}

pub fn add_format_eof(toks List<int>, srcb List<int>, length int, dmsg List<int>) int {
    if (dmsg.len() > 0 && has_open_brace(toks, srcb)) {
        dmsg.push(diag_format_eof())
        dmsg.push(length)
        dmsg.push(length)
        dmsg.push(0)
    }
    return 0
}

fn has_open_brace(toks List<int>, srcb List<int>) bool {
    var braces = 0
    var i = 0
    for (i < tok_count(toks)) {
        let start = tok_start(toks, i)
        if (tok_end(toks, i) == start + 1 && tok_token(toks, i) >= 0 && !tok_trivia(toks, i)) {
            let c = srcb.get(start)
            if (c == 123) { braces = braces + 1 }
            if (c == 125 && braces > 0) { braces = braces - 1 }
        }
        i = i + 1
    }
    return braces > 0
}
