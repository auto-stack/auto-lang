fn itoa(v int) Str {
    if (v == 0) {
        return "0"
    }
    var digits = List<int>.new()
    var x = v
    for (x > 0) {
        digits.push(x % 10)
        x = x / 10
    }
    var out = ""
    var i = digits.len() - 1
    for (i >= 0) {
        out = out + table_digit(digits.get(i))
        i = i - 1
    }
    return out
}

fn table_digit(d int) Str {
    var table = "0123456789"
    return table.slice(d, d + 1).clone()
}

pub fn decode_dbg_case(name Str) Str {
    var dbg = List<int>.new()
    dbg.push(0)
    var pg = decode_program_bytes_dbg(hex_to_bytes_parts(fetch_parts(name)), dbg)
    if (!pg_ok(pg)) {
        return "ERR " + itoa(pg_err(pg)) + " SEC " + itoa(dbg.get(0))
    }
    return "OK"
}

pub fn decode_case(name Str) Str {
    var pg = decode_program_parts(fetch_parts(name))
    if (!pg_ok(pg)) {
        return "ERR " + itoa(pg_err(pg))
    }
    let v = validate_references(pg)
    if (v != 0) {
        return "BADREF " + itoa(v)
    }
    return "OK tok=" + itoa(n_tokens(pg)) + " rules=" + itoa(n_rules(pg)) + " scan=" + itoa(n_scan(pg)) + " pratt=" + itoa(n_pratt(pg))
}

/// Truncated-wire refusal: drop the last byte's worth of hex and expect the
/// decode to refuse (controlled, never a partial program).
pub fn decode_truncated_case(name Str) Str {
    // Drop the last wire byte (2 hex chars from the final chunk): a
    // controlled malformed program must be refused, never partially
    // accepted.
    var parts = fetch_parts(name)
    var bytes = hex_to_bytes_parts(parts)
    if (bytes.len() == 0) {
        return "BADHEX"
    }
    var cut = List<int>.new()
    var i = 0
    for (i < bytes.len() - 1) {
        cut.push(bytes.get(i))
        i = i + 1
    }
    var pg = decode_program(cut)
    if (!pg_ok(pg)) {
        return "REFUSED " + itoa(pg_err(pg))
    }
    return "ACCEPTED"
}

pub fn byte_len_case(name Str) Str {
    let b = hex_to_bytes_parts(fetch_parts(name))
    return "bytes=" + itoa(b.len())
}

pub fn hex_roundtrip_case(name Str) Str {
    let b = hex_to_bytes_parts(fetch_parts(name))
    return "bytes=" + itoa(b.len())
}

// ---------------------------------------------------------------------------
// T-02 parse smoke: lex + parse a frozen sample, render the canonical CST
// and the diag list (byte-exact vs the Rust runtime oracle).
// ---------------------------------------------------------------------------



fn render_diag(pg List<int>, dmsg List<int>) Str {
    var out = ""
    var i = 0
    for (i < dmsg.len() / 4) {
        let kind = dmsg.get(i * 4)
        let st = dmsg.get(i * 4 + 1)
        let en = dmsg.get(i * 4 + 2)
        let param = dmsg.get(i * 4 + 3)
        out = out + itoa(st) + ".." + itoa(en) + " "
        if (kind == 2) {
            out = out + "recovered at malformed `" + rule_name(pg, param) + "`"
        }
        if (kind == 3) {
            out = out + "skipped unexpected token at top level"
        }
        if (kind == 4) {
            out = out + "root parse failed; partial error tree"
        }
        if (kind == 5) {
            out = out + "trailing unparsed tokens"
        }
        if (kind == 99) {
            out = out + "LISTCAP which=" + itoa(st) + " len=" + itoa(en)
        }
        if (kind == 6) {
            out = out + "rule `" + rule_name(pg, param) + "` recurses without consuming input (left recursion)"
        }
        if (kind == 7) {
            out = out + "unknown rule #" + itoa(param)
        }
        if (kind == 8) {
            out = out + "expected `" + ctx_spelling(pg, param) + "` at the declared `" + ctx_role(pg, param) + "` slot"
        }
        if (kind == 9) {
            out = out + "unexpected token in " + rule_expect(pg, param)
        }
        if (kind == diag_format_syntax()) {
            out = out + "source.fstr-syntax malformed format string"
        }
        if (kind == diag_format_eof()) {
            out = out + "expected `}` before end of source"
        }
        if (kind == 90) {
            out = out + "GATE ls=" + itoa(st) + " br=" + itoa(en) + " sep=" + itoa(param)
        }
        if (kind == 99) {
            out = out + "STEP_CAP i=" + itoa(st) + " frames=" + itoa(en) + " rule=" + itoa(param)
        }
        out = out + "\n"
        i = i + 1
    }
    return out
}

/// Stage probe: scanner compile only — total bucket entries + first bucket.
pub fn scan_case(profile Str) Str {
    var pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR"
    }
    let cs = compile_scanner(pg)
    let total = cs.get(256) - 257
    return "entries=" + itoa(total) + " b0=" + itoa(cs.get(1) - cs.get(0))
}

/// Stage probe: raw accessors — n_scan + first scan rule fields + pool byte.
pub fn raw_case(profile Str) Str {
    var pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR"
    }
    let ns = n_scan(pg)
    var out = "nscan=" + itoa(ns) + " nl=" + itoa(pg.get(11)) + " start=" + itoa(pg.get(10))
    if (ns > 0) {
        var off = pg.get(32)
        out = out + " pool=" + itoa(off) + " poollen=" + itoa(pg.len() - off)
        out = out + " mtag0=" + itoa(pg.get(pg.get(18) + 0))
        out = out + " a0=" + itoa(pg.get(pg.get(18) + 1))
        let b0 = pg.get(pg.get(32) + pg.get(pg.get(18) + 1))
        out = out + " firstbyte=" + itoa(b0)
    }
    return out
}

/// Stage probe: bucket COUNT pass only.
pub fn bucket_count_case(profile Str) Str {
    var pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR"
    }
    use_count_pass(pg)
    return "counts-ok"
}

/// Stage probe: lex only — token count + first few token ids/starts.
pub fn lex_case(profile Str, sample Str) Str {
    var pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR"
    }
    let cs = compile_scanner(pg)
    let srcb = str_to_bytes(sample)
    var toks = List<int>.new()
    var lexd = List<int>.new()
    lex_all(pg, cs, srcb, -1, toks, lexd)
    var out = "ntok=" + itoa(toks.len() / 5) + " nlexd=" + itoa(lexd.len() / 2) + " head="
    var i = 0
    for (i < 12) {
        if (i * 5 < toks.len()) {
            out = out + itoa(toks.get(i * 5)) + "," + itoa(toks.get(i * 5 + 1)) + "," + itoa(toks.get(i * 5 + 3)) + " "
        }
        i = i + 1
    }
    return out
}

/// Stage probe: first sets — the start rule's first-token count.
pub fn firstsets_case(profile Str) Str {
    var pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR"
    }
    var firsts = List<int>.new()
    var nullable = List<int>.new()
    let r = first_sets_into(pg, firsts, nullable)
    if (r != 0) {
        return "FIRSTSETS_ERR"
    }
    var n = 0
    var tk = 0
    for (tk < n_tokens(pg)) {
        if (firsts.get(tk) != 0) {
            n = n + 1
        }
        tk = tk + 1
    }
    var nn = 0
    var ri = 0
    for (ri < n_rules(pg)) {
        if (nullable.get(ri) != 0) {
            nn = nn + 1
        }
        ri = ri + 1
    }
    return "startfirst=" + itoa(n) + " nullable=" + itoa(nn)
}

pub fn dump_case(profile Str, sample Str) Str {
    var pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR"
    }
    let cs2 = compile_scanner(pg)
    let srcb = str_to_bytes(sample)
    var toks = List<int>.new()
    var lexd = List<int>.new()
    lex_all(pg, cs2, srcb, -1, toks, lexd)
    var firsts = List<int>.new()
    var nullable = List<int>.new()
    let fsr = first_sets_into(pg, firsts, nullable)
    if (fsr != 0) {
        return "FIRSTSETS_ERR"
    }
    var t = List<int>.new()
    var ef = List<int>.new()
    var decls = List<int>.new()
    var dmsg = List<int>.new()
    var ot = List<int>.new()
    var oef = List<int>.new()
    var odecls = List<int>.new()
    var gcand = List<int>.new()
    var gshift = List<int>.new()
    var ginfo = List<int>.new()
    ginfo.push(0)
    let root = parse_tokens(pg, cs2, firsts, nullable, toks, srcb, t, ef, decls, dmsg, ot, oef, odecls, gcand, gshift, ginfo, 1048576, 67108864)
    if (root < 0) {
        return "PARSE_ERR"
    }
    var out = "root=" + itoa(root) + " nodes=" + itoa(t.len() / 8) + " edges=" + itoa(ef.len() / 2) + "|"
    var n = 0
    for (n < t.len() / 8) {
        out = out + itoa(n) + ":k" + itoa(t.get(n * 8)) + "s" + itoa(t.get(n * 8 + 1)) + "l" + itoa(t.get(n * 8 + 2)) + "f" + itoa(t.get(n * 8 + 3)) + "c" + itoa(t.get(n * 8 + 4)) + "d" + itoa(t.get(n * 8 + 7)) + "|"
        n = n + 1
    }
    var e = 0
    for (e < ef.len() / 2) {
        out = out + "e" + itoa(e) + "=" + itoa(ef.get(e * 2)) + "/" + itoa(ef.get(e * 2 + 1)) + " "
        e = e + 1
    }
    return out
}
/// Lex + parse `sample` under `profile`; return "CANON\n<canonical>\nDIAGS\n<diags>"
/// or a controlled refusal code.
pub fn parse_case(profile Str, sample Str) Str {
    return parse_source(profile, str_to_bytes(sample), 1048576, 67108864)
}

pub fn parse_byte_case(profile Str, srcb List<int>, depth int, work int) Str {
    if (srcb.len() > work) {
        return "PARSE_ERR 3"
    }
    let valid = decode_utf8(srcb)
    is valid {
        Some(_) -> { return parse_source(profile, srcb, depth, work) }
        None -> {}
    }
    return "SOURCE_ERR UTF8"
}

fn parse_source(profile Str, srcb List<int>, depth int, work int) Str {
    let mode = format_mode(profile.clone())
    let pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR " + itoa(pg_err(pg))
    }
    var t = List<int>.new()
    var ef = List<int>.new()
    var decls = List<int>.new()
    var dmsg = List<int>.new()
    let root = parse_cst(pg, mode, srcb, t, ef, decls, dmsg, depth, work)
    if (root < 0) {
        return "PARSE_ERR " + itoa(-root)
    }
    if (!reconstructs_input(t, ef, decls, root, srcb, srcb.len())) {
        return "LOSSLESS_ERR"
    }
    return "CANON\n" + canonical(t, ef, decls, root) + "DIAGS\n" + render_diag(pg, dmsg)
}

pub fn project_case(profile Str, sample Str, source_id int, origin_id int) Str {
    let mode = format_mode(profile.clone())
    let pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR " + itoa(pg_err(pg))
    }
    let srcb = str_to_bytes(sample)
    var t = List<int>.new()
    var ef = List<int>.new()
    var decls = List<int>.new()
    var dmsg = List<int>.new()
    let root = parse_cst(pg, mode, srcb, t, ef, decls, dmsg, 1048576, 67108864)
    if (root < 0) {
        return "PARSE_ERR " + itoa(-root)
    }
    return project_report(pg, t, ef, decls, dmsg, root, srcb.len(), source_id, origin_id)
}

fn project_report(pg List<int>, t List<int>, ef List<int>, decls List<int>, dmsg List<int>, root int, size int, source_id int, origin_id int) Str {
    var ast = List<int>.new()
    if (project_ast(t, ef, decls, root, size, source_id, origin_id, ast) < 0) {
        return "PROJECTION_ERR"
    }
    return ast_canonical(pg, ast) + "DIAGS\n" + render_diag(pg, dmsg)
}

fn reconstructs_input(t List<int>, ef List<int>, decls List<int>, root int, src List<int>, size int) bool {
    if (assert_lossless(t, ef, decls, root, size) != 0) {
        return false
    }
    var reconstructed = List<int>.new()
    reconstruct(t, ef, decls, root, src, reconstructed)
    if (reconstructed.len() != size) {
        return false
    }
    var i = 0
    for (i < size) {
        if (reconstructed.get(i) != src.get(i)) {
            return false
        }
        i = i + 1
    }
    return true
}

// ---------------------------------------------------------------------------
// T-02 incremental (V-02/V-04): cold parse -> single edit -> incremental
// reparse; observables = cold canonical, incremental canonical, splice
// facts, and the snapshot identity change/restore under an undo edit.
// ---------------------------------------------------------------------------


fn copy_ints(src List<int>) List<int> {
    var out = List<int>.new()
    var i = 0
    for (i < src.len()) {
        out.push(src.get(i))
        i = i + 1
    }
    return out
}

fn build_gcand(decls1 List<int>, t1 List<int>, ef1 List<int>, toks1 List<int>, start int, end int) List<int> {
    var gcand = List<int>.new()
    var di = 0
    for (di < decls1.len() / 3) {
        let dnode = decl_node(decls1, di)
        let ordn = t1.get(dnode * 8 + 7)
        var base = 0
        if (ordn > 0) {
            base = decl_origin(decls1, ordn - 1)
        }
        let ds = base + t1.get(dnode * 8 + 1)
        let de2 = ds + t1.get(dnode * 8 + 2)
        var intersects = 0
        if (de2 > start && ds < end) {
            intersects = 1
        }
        var has_err = 0
        if (intersects == 0) {
            has_err = subtree_has_error(t1, ef1, dnode)
        }
        if (intersects == 0 && has_err == 0) {
            var otc2 = toks1.len() / 5
            var lo2 = 0
            var probing = 1
            for (probing == 1) {
                if (lo2 >= otc2) {
                    probing = 0
                } else {
                    if (tok_start(toks1, lo2) >= decl_origin(decls1, di)) {
                        probing = 0
                    } else {
                        lo2 = lo2 + 1
                    }
                }
            }
            var hi2 = 0
            probing = 1
            for (probing == 1) {
                if (hi2 >= otc2) {
                    probing = 0
                } else {
                    if (tok_start(toks1, hi2) >= de2) {
                        probing = 0
                    } else {
                        hi2 = hi2 + 1
                    }
                }
            }
            gcand.push(lo2)
            gcand.push(di)
            gcand.push(lo2)
            gcand.push(hi2)
        }
        di = di + 1
    }
    return gcand
}

pub fn edit_case(profile Str, sample Str, start int, end int, insert Str) Str {
    return edit_observation(profile, sample, start, end, insert, List<int>.new())
}

pub fn edit_project_case(profile Str, sample Str, start int, end int, insert Str, source_id int, origin_id int) Str {
    var origin = List<int>.new()
    origin.push(source_id)
    origin.push(origin_id)
    return edit_observation(profile, sample, start, end, insert, origin)
}

fn edit_observation(profile Str, sample Str, start int, end int, insert Str, origin List<int>) Str {
    let mode = format_mode(profile.clone())
    let pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR"
    }
    let srcb = str_to_bytes(sample)
    let snap = copy_ints(srcb)
    var length = List<int>.new()
    length.push(0)
    let rc = apply_edit(snap, srcb.len(), start, end, insert, length)
    if (rc != 0) {
        return "EDIT_REFUSED " + itoa(rc)
    }
    let new_len = length.get(0)
    var edit = List<int>.new()
    edit.push(start)
    edit.push(end)
    edit.push(new_len)
    if (mode != 0) {
        return edit_with_formats(pg, mode, srcb, snap, edit, origin)
    }
    let cs = compile_scanner(pg)
    var old_toks = List<int>.new()
    lex_all(pg, cs, srcb, -1, old_toks, List<int>.new())
    var nodes = List<int>.new()
    var edges = List<int>.new()
    var decls = List<int>.new()
    var diags = List<int>.new()
    var facts = List<int>.new()
    let root = reparse_edit(pg, cs, old_toks, srcb, snap, edit, nodes, edges, decls, diags, facts, 67108864, false)
    return edit_report(pg, nodes, edges, decls, diags, root, snap, new_len, origin, facts)
}

fn edit_with_formats(pg List<int>, mode int, raw List<int>, snap List<int>, edit List<int>, origin List<int>) Str {
    let work = 67108864
    var old_input = List<int>.new()
    var old_map = List<int>.new()
    var old_marks = List<int>.new()
    let old_status = normalize_formats(raw, raw.len(), mode, work, old_input, old_map, old_marks)
    if (old_status == format_resource()) { return "COLD_ERR 3" }
    if (old_status < 0) {
        return cold_format_edit(pg, mode, snap, edit.get(2), origin, fb_unterminated())
    }
    if (old_status == 0) { old_input = copy_ints(raw) }
    let old_scratch = (old_input.len() + old_map.len() + old_marks.len()) * 4
    let cs = compile_scanner(pg)
    var old_toks = List<int>.new()
    lex_all(pg, cs, old_input, -1, old_toks, List<int>.new())
    var input = List<int>.new()
    var new_map = List<int>.new()
    var new_marks = List<int>.new()
    var virtual_edit = List<int>.new()
    let reason = prepare_format_edit(raw, snap, edit, mode, work - old_scratch, old_input, old_toks, old_map, old_marks, input, new_map, new_marks, virtual_edit)
    if (reason < 0) { return "INCR_ERR " + itoa(-reason) }
    if (reason > 0) { return cold_format_edit(pg, mode, snap, edit.get(2), origin, reason) }
    let normalized = virtual_edit.get(3)
    let scratch = old_scratch + (input.len() + new_map.len() + new_marks.len()) * 4
    if (scratch > work) { return "INCR_ERR 3" }

    var nodes = List<int>.new()
    var edges = List<int>.new()
    var decls = List<int>.new()
    var diags = List<int>.new()
    var facts = List<int>.new()
    let root = reparse_edit(pg, cs, old_toks, old_input, input, virtual_edit, nodes, edges, decls, diags, facts, work - scratch, new_marks.len() > 0)
    if (root >= 0 && new_map.len() > 0) { remap_format_tree(new_map, new_marks, nodes, decls, diags) }
    if (root >= 0) { facts.push(normalized) }
    return edit_report(pg, nodes, edges, decls, diags, root, snap, edit.get(2), origin, facts)
}

fn cold_format_edit(pg List<int>, mode int, snap List<int>, length int, origin List<int>, reason int) Str {
    for (snap.len() > length) { snap.remove(snap.len() - 1) }
    var nodes = List<int>.new()
    var edges = List<int>.new()
    var decls = List<int>.new()
    var diags = List<int>.new()
    var facts = List<int>.new()
    facts.push(0)
    facts.push(reason)
    facts.push(0)
    facts.push(0)
    let root = parse_cst(pg, mode, snap, nodes, edges, decls, diags, 1048576, 67108864)
    return edit_report(pg, nodes, edges, decls, diags, root, snap, length, origin, facts)
}

fn reparse_edit(pg List<int>, cs List<int>, old_toks List<int>, old_input List<int>, input List<int>, edit List<int>, nodes List<int>, edges List<int>, decls List<int>, diags List<int>, facts List<int>, work int, mapped bool) int {
    let start = edit.get(0)
    let end = edit.get(1)
    let new_len = edit.get(2)
    let delta = new_len - old_input.len()
    var firsts = List<int>.new()
    var nullable = List<int>.new()
    first_sets_into(pg, firsts, nullable)
    var toks = List<int>.new()
    var splice = List<int>.new()
    incremental_lex(pg, cs, old_toks, input, new_len, start, end, delta, toks, splice)

    var old_nodes = List<int>.new()
    var old_edges = List<int>.new()
    var old_decls = List<int>.new()
    var shifts = List<int>.new()
    var graft = List<int>.new()
    var candidates = List<int>.new()
    if (splice.get(0) != 0) {
        var cold_diags = List<int>.new()
        var disabled = List<int>.new()
        disabled.push(0)
        let cold_root = parse_tokens_n(pg, cs, firsts, nullable, old_toks, old_input, old_nodes, old_edges, old_decls, cold_diags, List<int>.new(), List<int>.new(), List<int>.new(), List<int>.new(), List<int>.new(), disabled, 1048576, work, old_toks.len() / 5)
        if (cold_root < 0) {
            return cold_root
        }
        candidates = edit_graft_candidates(old_decls, old_nodes, old_edges, old_toks, splice, old_input.len(), start, end)
        graft.push(1)
        graft.push(splice.get(3))
        graft.push(splice.get(4))
        graft.push(splice.get(5))
        graft.push(0)
        shifts.push(end)
        shifts.push(delta)
    } else {
        graft.push(0)
        graft.push(0)
        graft.push(0)
        graft.push(0)
        graft.push(0)
        var fresh_diags = List<int>.new()
        lex_all(pg, cs, input, new_len, toks, fresh_diags)
    }

    let root = parse_tokens_n(pg, cs, firsts, nullable, toks, input, nodes, edges, decls, diags, old_nodes, old_edges, old_decls, candidates, shifts, graft, 1048576, work, toks.len() / 5)
    if (root >= 0 && mapped) { add_format_eof(toks, input, new_len, diags) }
    facts.push(splice.get(0))
    facts.push(splice.get(1))
    facts.push(splice.get(2))
    facts.push(graft.get(4))
    return root
}

fn edit_report(pg List<int>, nodes List<int>, edges List<int>, decls List<int>, diags List<int>, root int, snap List<int>, new_len int, origin List<int>, info List<int>) Str {
    if (root < 0) {
        return "INCR_ERR " + itoa(-root) + " " + render_diag(pg, diags)
    }
    if (!reconstructs_input(nodes, edges, decls, root, snap, new_len)) {
        return "LOSSLESS_ERR"
    }
    var facts = "SPLICE ok=" + itoa(info.get(0)) + " fb=" + itoa(info.get(1)) + " rescan=" + itoa(info.get(2)) + " grafted=" + itoa(info.get(3))
    if (info.len() > 4) { facts = facts + " normalized=" + itoa(info.get(4)) }
    if (origin.len() == 2) {
        return "INCR|" + project_report(pg, nodes, edges, decls, diags, root, new_len, origin.get(0), origin.get(1)) + facts
    }
    return "INCR|CANON\n" + canonical(nodes, edges, decls, root) + "DIAGS\n" + render_diag(pg, diags) + facts
}

fn edit_graft_candidates(decls List<int>, nodes List<int>, edges List<int>, toks List<int>, splice List<int>, old_len int, start int, end int) List<int> {
    var affected_lo = start
    var affected_hi = old_len
    let old_count = toks.len() / 5
    if (splice.get(5) < old_count) {
        let checkpoint = tok_start(toks, splice.get(5))
        if (checkpoint < affected_lo) {
            affected_lo = checkpoint
        }
    }
    if (splice.get(4) < old_count) {
        affected_hi = tok_start(toks, splice.get(4))
    }
    if (affected_hi < end) {
        affected_hi = end
    }
    return build_gcand(decls, nodes, edges, toks, affected_lo, affected_hi)
}

fn subtree_has_error(t List<int>, ef List<int>, node int) int {
    var stack = List<int>.new()
    stack.push(node)
    var depth = 1
    for (depth > 0) {
        let cur = stack.get(depth - 1)
        depth = depth - 1
        let fl = t.get(cur * 8 + 6)
        if ((fl & (flag_error() | flag_missing())) != 0) {
            return 1
        }
        var k = t.get(cur * 8 + 4) - 1
        for (k >= 0) {
            let c = ef.get((t.get(cur * 8 + 3) + k) * 2)
            if (depth == stack.len()) {
                stack.push(c)
            } else {
                stack.set(depth, c)
            }
            depth = depth + 1
            k = k - 1
        }
    }
    return 0
}

pub fn edit_rollback_case(sample Str, start int, end int, insert Str) Str {
    let snap = str_to_bytes(sample)
    let original_size = snap.len()
    let original_id = snapshot_id(snap, original_size)
    var size = List<int>.new()
    size.push(original_size)
    let rc = apply_edit(snap, original_size, start, end, insert, size)
    if (rc == 0) {
        return "EDIT_ACCEPTED"
    }
    if (size.get(0) != original_size || snap.len() != original_size) {
        return "EDIT_CHANGED_SIZE"
    }
    if (!equal(snapshot_id(snap, original_size), original_id)) {
        return "EDIT_CHANGED_SNAPSHOT"
    }
    return "EDIT_REFUSED " + itoa(rc) + " unchanged"
}

/// V-04: identity behavior — insert one ASCII space at `alpha_at`, then
/// undo; the content SnapshotId must change and restore.
pub fn identity_case(sample Str, alpha_at int) Str {
    var snap = str_to_bytes(sample)
    let id0 = snapshot_id(snap, snap.len())
    var nl = List<int>.new()
    nl.push(0)
    let rc1 = apply_edit(snap, snap.len(), alpha_at, alpha_at, " ", nl)
    if (rc1 != 0) {
        return "EDIT1_REFUSED " + itoa(rc1)
    }
    let id1 = snapshot_id(snap, nl.get(0))
    var nl2 = List<int>.new()
    nl2.push(0)
    let rc2 = apply_edit(snap, nl.get(0), alpha_at, alpha_at + 1, "", nl2)
    if (rc2 != 0) {
        return "EDIT2_REFUSED " + itoa(rc2)
    }
    let id2 = snapshot_id(snap, nl2.get(0))
    var sum0 = 0
    var q = 0
    for (q < snap.len()) {
        sum0 = sum0 + snap.get(q)
        q = q + 1
    }
    var out = "changed="
    if (!equal(id1.clone(), id0.clone())) {
        out = out + "1"
    } else {
        out = out + "0"
    }
    out = out + " restored="
    if (equal(id2.clone(), id0.clone())) {
        out = out + "1"
    } else {
        out = out + "0"
    }
    out = out + " pfx=" + id0.slice(0, 8).clone() + "/" + id1.slice(0, 8).clone() + "/" + id2.slice(0, 8).clone() + " len2=" + itoa(nl2.get(0)) + " bytes=" + itoa(sum0)
    return out
}

/// D-1046-02 probe: parse-then-lex composition. mode 0 = same cs;
/// mode 1 = fresh compile_scanner before the second lex; mode 2 = two lexes
/// without any parse (control).
pub fn parse_then_lex_case(profile Str, sample Str, mode int) Str {
    var pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR"
    }
    var cs2 = compile_scanner(pg)
    let srcb = str_to_bytes(sample)
    if (mode == 2) {
        var t0 = List<int>.new()
        var l0 = List<int>.new()
        lex_all(pg, cs2, srcb, -1, t0, l0)
        var t0b = List<int>.new()
        var l0b = List<int>.new()
        lex_all(pg, cs2, srcb, -1, t0b, l0b)
        return "M2 two-lex ok " + itoa(t0.len() / 5) + "/" + itoa(t0b.len() / 5)
    }
    var firsts = List<int>.new()
    var nullable = List<int>.new()
    first_sets_into(pg, firsts, nullable)
    var toks = List<int>.new()
    var lexd = List<int>.new()
    lex_all(pg, cs2, srcb, -1, toks, lexd)
    var t = List<int>.new()
    var ef = List<int>.new()
    var decls = List<int>.new()
    var dmsg = List<int>.new()
    var g0 = List<int>.new()
    g0.push(0)
    let root = parse_tokens_n(pg, cs2, firsts, nullable, toks, srcb, t, ef, decls, dmsg, List<int>.new(), List<int>.new(), List<int>.new(), List<int>.new(), List<int>.new(), g0, 1048576, 4000000, toks.len() / 5)
    if (root < 0) {
        return "PARSE_ERR " + itoa(-root)
    }
    if (mode == 1) {
        cs2 = compile_scanner(pg)
    }
    var t2 = List<int>.new()
    var l2 = List<int>.new()
    if (mode == 3) {
        var snap = copy_ints(srcb)
        var nl = List<int>.new()
        nl.push(0)
        let rc = apply_edit(snap, snap.len(), 51, 51, "2 * ", nl)
        if (rc != 0) {
            return "M3 edit-refused " + itoa(rc)
        }
        lex_all(pg, cs2, snap, -1, t2, l2)
        return "M3 parse+edit+lex ok n2=" + itoa(t2.len() / 5)
    }
    if (mode == 4) {
        lex_all(pg, cs2, srcb, -1, t2, l2)
        var t3 = List<int>.new()
        var ef3 = List<int>.new()
        var decls3 = List<int>.new()
        var dmsg3 = List<int>.new()
        var g1 = List<int>.new()
        g1.push(0)
        let root2 = parse_tokens_n(pg, cs2, firsts, nullable, t2, srcb, t3, ef3, decls3, dmsg3, List<int>.new(), List<int>.new(), List<int>.new(), List<int>.new(), List<int>.new(), g1, 1048576, 4000000, t2.len() / 5)
        return "M4 two-parse ok " + itoa(root) + "/" + itoa(root2)
    }
    if (mode == 5) {
        let c1 = canonical(t, ef, decls, root)
        return "M5 canon-len " + itoa(c1.len()) + " tail=" + c1.slice(c1.len() - 6, c1.len()).clone()
    }
    lex_all(pg, cs2, srcb, -1, t2, l2)
    return "M" + itoa(mode) + " ok root=" + itoa(root) + " n2=" + itoa(t2.len() / 5)
}

/// The fresh reference leg (run in its own AV execution; V-02's oracle is
/// the equality of this tree with the incremental tree from edit_case).
pub fn many_lists_case() Str {
    var total = 0
    var k = 0
    for (k < 100) {
        var xs = List<int>.new()
        var i = 0
        for (i < 700) {
            xs.push(i)
            i = i + 1
        }
        total = total + xs.len()
        k = k + 1
    }
    return "total=" + itoa(total)
}

pub fn one_big_list_case() Str {
    var xs = List<int>.new()
    var i = 0
    for (i < 70000) {
        xs.push(i)
        i = i + 1
    }
    return "len=" + itoa(xs.len())
}
