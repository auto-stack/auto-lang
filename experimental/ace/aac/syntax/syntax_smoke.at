fn itoa(v int) Str {
    if (v == 0) {
        return "0"
    }
    var digits = List<int>.new()
    var x = v
    for (x > 0) {
        digits.push(x % 10)
        x = x / 10
    }
    var out = ""
    var i = digits.len() - 1
    for (i >= 0) {
        out = out + table_digit(digits.get(i))
        i = i - 1
    }
    return out
}

fn table_digit(d int) Str {
    var table = "0123456789"
    return table.slice(d, d + 1).clone()
}

pub fn decode_dbg_case(name Str) Str {
    var dbg = List<int>.new()
    dbg.push(0)
    var pg = decode_program_bytes_dbg(hex_to_bytes_parts(fetch_parts(name)), dbg)
    if (!pg_ok(pg)) {
        return "ERR " + itoa(pg_err(pg)) + " SEC " + itoa(dbg.get(0))
    }
    return "OK"
}

pub fn fetch_parts(name Str) List<Str> {
    if (name == "auto") {
        return auto_parts()
    }
    if (name == "age-package") {
        return age_package_parts()
    }
    if (name == "packages-ct") {
        return packages_ct_parts()
    }
    if (name == "packages-modules") {
        return packages_modules_parts()
    }
    if (name == "text-record-instances") {
        return text_record_instances_parts()
    }
    return scalar_parts()
}

pub fn decode_case(name Str) Str {
    var pg = decode_program_parts(fetch_parts(name))
    if (!pg_ok(pg)) {
        return "ERR " + itoa(pg_err(pg))
    }
    let v = validate_references(pg)
    if (v != 0) {
        return "BADREF " + itoa(v)
    }
    return "OK tok=" + itoa(n_tokens(pg)) + " rules=" + itoa(n_rules(pg)) + " scan=" + itoa(n_scan(pg)) + " pratt=" + itoa(n_pratt(pg))
}

/// Truncated-wire refusal: drop the last byte's worth of hex and expect the
/// decode to refuse (controlled, never a partial program).
pub fn decode_truncated_case(name Str) Str {
    // Drop the last wire byte (2 hex chars from the final chunk): a
    // controlled malformed program must be refused, never partially
    // accepted.
    var parts = fetch_parts(name)
    var bytes = hex_to_bytes_parts(parts)
    if (bytes.len() == 0) {
        return "BADHEX"
    }
    var cut = List<int>.new()
    var i = 0
    for (i < bytes.len() - 1) {
        cut.push(bytes.get(i))
        i = i + 1
    }
    var pg = decode_program(cut)
    if (!pg_ok(pg)) {
        return "REFUSED " + itoa(pg_err(pg))
    }
    return "ACCEPTED"
}

pub fn byte_len_case(name Str) Str {
    let b = hex_to_bytes_parts(fetch_parts(name))
    return "bytes=" + itoa(b.len())
}

pub fn hex_roundtrip_case(name Str) Str {
    let b = hex_to_bytes_parts(fetch_parts(name))
    return "bytes=" + itoa(b.len())
}

// ---------------------------------------------------------------------------
// T-02 parse smoke: lex + parse a frozen sample, render the canonical CST
// and the diag list (byte-exact vs the Rust runtime oracle).
// ---------------------------------------------------------------------------



pub fn str_to_bytes(s Str) List<int> {
    var out = List<int>.new()
    var i = 0
    for (i < s.len()) {
        let c = s.char_at(i).to_codepoint()
        let n = utf8_len(c)
        var k = 0
        for (k < n) {
            out.push(byte_of(c, k))
            k = k + 1
        }
        i = i + 1
    }
    return out
}

fn render_diag(pg List<int>, dmsg List<int>) Str {
    var out = ""
    var i = 0
    for (i < dmsg.len() / 4) {
        let kind = dmsg.get(i * 4)
        let st = dmsg.get(i * 4 + 1)
        let en = dmsg.get(i * 4 + 2)
        let param = dmsg.get(i * 4 + 3)
        out = out + itoa(st) + ".." + itoa(en) + " "
        if (kind == 2) {
            out = out + "recovered at malformed `" + rule_name(pg, param) + "`"
        }
        if (kind == 3) {
            out = out + "skipped unexpected token at top level"
        }
        if (kind == 4) {
            out = out + "root parse failed; partial error tree"
        }
        if (kind == 5) {
            out = out + "trailing unparsed tokens"
        }
        if (kind == 99) {
            out = out + "LISTCAP which=" + itoa(st) + " len=" + itoa(en)
        }
        if (kind == 6) {
            out = out + "rule `" + rule_name(pg, param) + "` recurses without consuming input (left recursion)"
        }
        if (kind == 7) {
            out = out + "unknown rule #" + itoa(param)
        }
        if (kind == 8) {
            out = out + "expected `" + ctx_spelling(pg, param) + "` at the declared `" + ctx_role(pg, param) + "` slot"
        }
        if (kind == 9) {
            out = out + "unexpected token in " + rule_expect(pg, param)
        }
        if (kind == 90) {
            out = out + "GATE ls=" + itoa(st) + " br=" + itoa(en) + " sep=" + itoa(param)
        }
        if (kind == 99) {
            out = out + "STEP_CAP i=" + itoa(st) + " frames=" + itoa(en) + " rule=" + itoa(param)
        }
        out = out + "\n"
        i = i + 1
    }
    return out
}

/// Stage probe: scanner compile only — total bucket entries + first bucket.
pub fn scan_case(profile Str) Str {
    var pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR"
    }
    let cs = compile_scanner(pg)
    let total = cs.get(256) - 257
    return "entries=" + itoa(total) + " b0=" + itoa(cs.get(1) - cs.get(0))
}

/// Stage probe: raw accessors — n_scan + first scan rule fields + pool byte.
pub fn raw_case(profile Str) Str {
    var pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR"
    }
    let ns = n_scan(pg)
    var out = "nscan=" + itoa(ns) + " nl=" + itoa(pg.get(11)) + " start=" + itoa(pg.get(10))
    if (ns > 0) {
        var off = pg.get(32)
        out = out + " pool=" + itoa(off) + " poollen=" + itoa(pg.len() - off)
        out = out + " mtag0=" + itoa(pg.get(pg.get(18) + 0))
        out = out + " a0=" + itoa(pg.get(pg.get(18) + 1))
        let b0 = pg.get(pg.get(32) + pg.get(pg.get(18) + 1))
        out = out + " firstbyte=" + itoa(b0)
    }
    return out
}

/// Stage probe: bucket COUNT pass only.
pub fn bucket_count_case(profile Str) Str {
    var pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR"
    }
    use_count_pass(pg)
    return "counts-ok"
}

/// Stage probe: lex only — token count + first few token ids/starts.
pub fn lex_case(profile Str, sample Str) Str {
    var pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR"
    }
    let cs = compile_scanner(pg)
    let srcb = str_to_bytes(sample)
    var toks = List<int>.new()
    var lexd = List<int>.new()
    lex_all(pg, cs, srcb, -1, toks, lexd)
    var out = "ntok=" + itoa(toks.len() / 5) + " nlexd=" + itoa(lexd.len() / 2) + " head="
    var i = 0
    for (i < 12) {
        if (i * 5 < toks.len()) {
            out = out + itoa(toks.get(i * 5)) + "," + itoa(toks.get(i * 5 + 1)) + "," + itoa(toks.get(i * 5 + 3)) + " "
        }
        i = i + 1
    }
    return out
}

/// Stage probe: first sets — the start rule's first-token count.
pub fn firstsets_case(profile Str) Str {
    var pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR"
    }
    var firsts = List<int>.new()
    var nullable = List<int>.new()
    let r = first_sets_into(pg, firsts, nullable)
    if (r != 0) {
        return "FIRSTSETS_ERR"
    }
    var n = 0
    var tk = 0
    for (tk < n_tokens(pg)) {
        if (firsts.get(tk) != 0) {
            n = n + 1
        }
        tk = tk + 1
    }
    var nn = 0
    var ri = 0
    for (ri < n_rules(pg)) {
        if (nullable.get(ri) != 0) {
            nn = nn + 1
        }
        ri = ri + 1
    }
    return "startfirst=" + itoa(n) + " nullable=" + itoa(nn)
}

pub fn dump_case(profile Str, sample Str) Str {
    var pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR"
    }
    let cs2 = compile_scanner(pg)
    let srcb = str_to_bytes(sample)
    var toks = List<int>.new()
    var lexd = List<int>.new()
    lex_all(pg, cs2, srcb, -1, toks, lexd)
    var firsts = List<int>.new()
    var nullable = List<int>.new()
    let fsr = first_sets_into(pg, firsts, nullable)
    if (fsr != 0) {
        return "FIRSTSETS_ERR"
    }
    var t = List<int>.new()
    var ef = List<int>.new()
    var decls = List<int>.new()
    var dmsg = List<int>.new()
    var ot = List<int>.new()
    var oef = List<int>.new()
    var odecls = List<int>.new()
    var gcand = List<int>.new()
    var gshift = List<int>.new()
    var ginfo = List<int>.new()
    ginfo.push(0)
    let root = parse_tokens(pg, cs2, firsts, nullable, toks, srcb, t, ef, decls, dmsg, ot, oef, odecls, gcand, gshift, ginfo, 1048576, 67108864)
    if (root < 0) {
        return "PARSE_ERR"
    }
    var out = "root=" + itoa(root) + " nodes=" + itoa(t.len() / 8) + " edges=" + itoa(ef.len() / 2) + "|"
    var n = 0
    for (n < t.len() / 8) {
        out = out + itoa(n) + ":k" + itoa(t.get(n * 8)) + "s" + itoa(t.get(n * 8 + 1)) + "l" + itoa(t.get(n * 8 + 2)) + "f" + itoa(t.get(n * 8 + 3)) + "c" + itoa(t.get(n * 8 + 4)) + "d" + itoa(t.get(n * 8 + 7)) + "|"
        n = n + 1
    }
    var e = 0
    for (e < ef.len() / 2) {
        out = out + "e" + itoa(e) + "=" + itoa(ef.get(e * 2)) + "/" + itoa(ef.get(e * 2 + 1)) + " "
        e = e + 1
    }
    return out
}
/// Lex + parse `sample` under `profile`; return "CANON\n<canonical>\nDIAGS\n<diags>"
/// or a controlled refusal code.
pub fn parse_case(profile Str, sample Str) Str {
    var pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR " + itoa(pg_err(pg))
    }
    let cs = compile_scanner(pg)
    let srcb = str_to_bytes(sample)
    var toks = List<int>.new()
    var lexd = List<int>.new()
    lex_all(pg, cs, srcb, -1, toks, lexd)
    var firsts = List<int>.new()
    var nullable = List<int>.new()
    let fsr = first_sets_into(pg, firsts, nullable)
    if (fsr != 0) {
        return "FIRSTSETS_ERR"
    }
    var t = List<int>.new()
    var ef = List<int>.new()
    var decls = List<int>.new()
    var dmsg = List<int>.new()
    var ot = List<int>.new()
    var oef = List<int>.new()
    var odecls = List<int>.new()
    var gcand = List<int>.new()
    var gshift = List<int>.new()
    var ginfo = List<int>.new()
    ginfo.push(0)
    let root = parse_tokens(pg, cs, firsts, nullable, toks, srcb, t, ef, decls, dmsg, ot, oef, odecls, gcand, gshift, ginfo, 1048576, 67108864)
    if (root < 0) {
        return "PARSE_ERR " + itoa(-root)
    }
    return "CANON\n" + canonical(t, ef, decls, root) + "DIAGS\n" + render_diag(pg, dmsg)
}

// ---------------------------------------------------------------------------
// T-02 incremental (V-02/V-04): cold parse -> single edit -> incremental
// reparse; observables = cold canonical, incremental canonical, splice
// facts, and the snapshot identity change/restore under an undo edit.
// ---------------------------------------------------------------------------


fn parse_bytes(pg List<int>, cs List<int>, firsts List<int>, nullable List<int>, srcb List<int>, t List<int>, ef List<int>, decls List<int>, dmsg List<int>) int {
    var toks = List<int>.new()
    var lexd = List<int>.new()
    lex_all(pg, cs, srcb, -1, toks, lexd)
    var g0 = List<int>.new()
    g0.push(0)
    var p_ot = List<int>.new()
    var p_oef = List<int>.new()
    var p_odecls = List<int>.new()
    var p_gc = List<int>.new()
    var p_gs = List<int>.new()
    return parse_tokens_n(pg, cs, firsts, nullable, toks, srcb, t, ef, decls, dmsg, p_ot, p_oef, p_odecls, p_gc, p_gs, g0, 1048576, 67108864, toks.len() / 5)
}



/// Fallback leg: fresh lex+parse over the edited bytes; returns the
/// canonical of BOTH legs for the equality check plus the splice facts.
fn fb_fresh(pg List<int>, cs List<int>, firsts List<int>, nullable List<int>, snap List<int>, cold Str, fb int, rescan int, stage int) Str {
    var toks3 = List<int>.new()
    var lexd3 = List<int>.new()
    lex_all(pg, cs, snap, -1, toks3, lexd3)
    if (stage == 8) {
        return "S8 fb-lexed n3=" + itoa(toks3.len() / 5)
    }
    var dprobe = List<int>.new()
    dprobe.push(toks3.len() / 5)
    var t2 = List<int>.new()
    var ef2 = List<int>.new()
    var d2 = List<int>.new()
    var decls2 = List<int>.new()
    var g0 = List<int>.new()
    g0.push(0)
    var f_ot = List<int>.new()
    var f_oef = List<int>.new()
    var f_odecls = List<int>.new()
    var f_gc = List<int>.new()
    var f_gs = List<int>.new()
    let r2 = parse_tokens_n(pg, cs, firsts, nullable, toks3, snap, t2, ef2, decls2, d2, f_ot, f_oef, f_odecls, f_gc, f_gs, g0, 1048576, 4000000, toks3.len() / 5)
    if (stage == 9) {
        return "S9 fb-parsed r2=" + itoa(r2)
    }
    return "COLD|" + cold + "INCR|" + canonical(t2, ef2, decls2, r2) + "SPLICE ok=0 fb=" + itoa(fb) + " rescan=" + itoa(rescan) + " reused=0"
}

fn copy_ints(src List<int>) List<int> {
    var out = List<int>.new()
    var i = 0
    for (i < src.len()) {
        out.push(src.get(i))
        i = i + 1
    }
    return out
}

pub fn edit_case_ph(profile Str, sample Str, start int, end int, insert Str, phase int) Str {
    return edit_case_staged(profile, sample, start, end, insert, phase)
}

pub fn edit_case(profile Str, sample Str, start int, end int, insert Str) Str {
    return edit_case_staged(profile, sample, start, end, insert, 0)
}

pub fn edit_fresh_lex_case(profile Str, sample Str, start int, end int, insert Str) Str {
    var pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR"
    }
    let cs2 = compile_scanner(pg)
    let srcb = str_to_bytes(sample)
    var snap = copy_ints(srcb)
    var nl = List<int>.new()
    nl.push(0)
    let rc = apply_edit(snap, snap.len(), start, end, insert, nl)
    if (rc != 0) {
        return "REFUSED " + itoa(rc)
    }
    var toks3 = List<int>.new()
    var lexd3 = List<int>.new()
    lex_all(pg, cs2, snap, -1, toks3, lexd3)
    var out = "n3=" + itoa(toks3.len() / 5) + " phys=" + itoa(snap.len()) + " log=" + itoa(nl.get(0)) + " last="
    let n3 = toks3.len() / 5
    if (n3 > 0) {
        out = out + itoa(tok_start(toks3, n3 - 1)) + ".." + itoa(tok_end(toks3, n3 - 1))
    }
    return out
}

pub 
fn build_gcand(decls1 List<int>, t1 List<int>, ef1 List<int>, toks1 List<int>, start int, end int) List<int> {
    var gcand = List<int>.new()
    var di = 0
    for (di < decls1.len() / 3) {
        let dnode = decl_node(decls1, di)
        let ordn = t1.get(dnode * 8 + 7)
        var base = 0
        if (ordn > 0) {
            base = decl_origin(decls1, ordn - 1)
        }
        let ds = base + t1.get(dnode * 8 + 1)
        let de2 = ds + t1.get(dnode * 8 + 2)
        var intersects = 0
        if (de2 > start && ds < end) {
            intersects = 1
        }
        var has_err = 0
        if (intersects == 0) {
            has_err = subtree_has_error(t1, ef1, dnode)
        }
        if (intersects == 0 && has_err == 0) {
            var otc2 = toks1.len() / 5
            var lo2 = 0
            var probing = 1
            for (probing == 1) {
                if (lo2 >= otc2) {
                    probing = 0
                } else {
                    if (tok_start(toks1, lo2) >= decl_origin(decls1, di)) {
                        probing = 0
                    } else {
                        lo2 = lo2 + 1
                    }
                }
            }
            var hi2 = 0
            probing = 1
            for (probing == 1) {
                if (hi2 >= otc2) {
                    probing = 0
                } else {
                    if (tok_start(toks1, hi2) >= de2) {
                        probing = 0
                    } else {
                        hi2 = hi2 + 1
                    }
                }
            }
            gcand.push(lo2)
            gcand.push(di)
            gcand.push(lo2)
            gcand.push(hi2)
        }
        di = di + 1
    }
    return gcand
}

fn edit_converged(pg List<int>, cs2 List<int>, firsts List<int>, nullable List<int>, snap List<int>, srcb List<int>, toks2 List<int>, spl List<int>, cold Str, t1 List<int>, ef1 List<int>, decls1 List<int>, gshift List<int>, gcand List<int>, stage int) Str {
    if (stage == 28) {
        return "S28 gcand=" + itoa(gcand.len() / 4) + " ntoks=" + itoa(spl.get(6))
    }
    var ginfo2 = List<int>.new()
    if (stage == 30) {
        ginfo2.push(0)
    } else {
        ginfo2.push(1)
    }
    ginfo2.push(spl.get(3))
    ginfo2.push(spl.get(4))
    ginfo2.push(spl.get(5))
    ginfo2.push(0)
    var t2 = List<int>.new()
    var ef2 = List<int>.new()
    var decls2 = List<int>.new()
    var d2 = List<int>.new()
    var r2 = parse_tokens_n(pg, cs2, firsts, nullable, toks2, snap, t2, ef2, decls2, d2, t1, ef1, decls1, gcand, gshift, ginfo2, 1048576, 67108864, spl.get(6))
    if (r2 < 0) {
        return "INCR_ERR " + itoa(-r2) + " " + render_diag(pg, d2)
    }
    if (stage == 29 || stage == 30) {
        return "S" + itoa(stage) + " root=" + itoa(r2) + " nodes=" + itoa(t2.len() / 8) + " grafted=" + itoa(ginfo2.get(4)) + " diags=" + itoa(d2.len() / 4)
    }
    if (stage == 36) {
        var cs36 = canonical(t2, ef2, decls2, r2)
        return "S36 canon-len " + itoa(cs36.len())
    }
    if (stage == 0) {
        return "INCR|CANON\n" + canonical(t2, ef2, decls2, r2) + "DIAGS\n" + render_diag(pg, d2) + "SPLICE ok=1 fb=0 rescan=" + itoa(spl.get(2)) + " grafted=" + itoa(ginfo2.get(4))
    }
    // fresh reference parse over the edited bytes
    var toksX = List<int>.new()
    var lexdX = List<int>.new()
    if (stage == 34) {
        var csB = compile_scanner(pg)
        lex_all(pg, csB, snap, -1, toksX, lexdX)
        return "S34 ref-lex-fresh-scanner n=" + itoa(toksX.len() / 5)
    }
    if (stage == 33) {
        lex_all(pg, cs2, srcb, -1, toksX, lexdX)
        return "S33 lex-original n=" + itoa(toksX.len() / 5)
    }
    lex_all(pg, cs2, snap, -1, toksX, lexdX)
    if (stage == 35) {
        return "S35 ref-lexed-edited n=" + itoa(toksX.len() / 5)
    }
    var t3 = List<int>.new()
    var ef3 = List<int>.new()
    var decls3 = List<int>.new()
    var d3 = List<int>.new()
    var gX = List<int>.new()
    gX.push(0)
    var r_ot = List<int>.new()
    var r_oef = List<int>.new()
    var r_odecls = List<int>.new()
    var r_gc = List<int>.new()
    var r_gs = List<int>.new()
    let r3 = parse_tokens_n(pg, cs2, firsts, nullable, toksX, snap, t3, ef3, decls3, d3, r_ot, r_oef, r_odecls, r_gc, r_gs, gX, 1048576, 67108864, toksX.len() / 5)
    if (r3 < 0) {
        return "REF_ERR " + itoa(-r3)
    }
    if (stage == 31) {
        return "S31 ref-ok root=" + itoa(r3) + " nodes=" + itoa(t3.len() / 8)
    }
    let incr = canonical(t2, ef2, decls2, r2)
    let refr = canonical(t3, ef3, decls3, r3)
    if (stage == 32) {
        return "S32 canon-ok ilen=" + itoa(incr.len()) + " rlen=" + itoa(refr.len())
    }
    var eqv = 0
    if (incr == refr) {
        eqv = 1
    }
    return "EQ=" + itoa(eqv) + " INCR|" + incr + "REF|" + refr + "SPLICE ok=1 fb=0 rescan=" + itoa(spl.get(2)) + " grafted=" + itoa(ginfo2.get(4))
}
fn edit_case_staged(profile Str, sample Str, start int, end int, insert Str, stage int) Str {
    var pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR"
    }
    let cs2 = compile_scanner(pg)
    var firsts = List<int>.new()
    var nullable List<int> = List<int>.new()
    first_sets_into(pg, firsts, nullable)
    let srcb = str_to_bytes(sample)
    var t1 = List<int>.new()
    var ef1 = List<int>.new()
    var d1 = List<int>.new()
    var decls1 = List<int>.new()
    let r1 = parse_bytes(pg, cs2, firsts, nullable, srcb, t1, ef1, decls1, d1)
    if (r1 < 0) {
        return "COLD_ERR " + itoa(-r1)
    }
    var toks1 = List<int>.new()
    var lexd1 = List<int>.new()
    lex_all(pg, cs2, srcb, -1, toks1, lexd1)
    if (stage == 1) {
        return "S1 ok toks1=" + itoa(toks1.len() / 5)
    }
    if (stage == 5) {
        return "S5 cold+canon len=" + itoa(canonical(t1, ef1, decls1, r1).len())
    }
    var snap = copy_ints(srcb)
    var nl = List<int>.new()
    nl.push(0)
    let delta = insert.len() - (end - start)
    let rc = apply_edit(snap, snap.len(), start, end, insert, nl)
    if (rc != 0) {
        return "EDIT_REFUSED " + itoa(rc)
    }
    if (stage == 29) {
        // splice-vs-fresh token comparison (post-fix diagnostic)
        var fx = List<int>.new()
        var fxd = List<int>.new()
        lex_all(pg, cs2, snap, -1, fx, fxd)
        var toks2x = List<int>.new()
        var splx = List<int>.new()
        var zz = 0
        for (zz < 10) {
            splx.push(0)
            zz = zz + 1
        }
        incremental_lex_p(pg, cs2, toks1, snap, nl.get(0), start, end, delta, toks2x, splx, 9)
        var n2 = splx.get(6)
        var mism = 0
        var kk = 0
        for (kk < n2) {
            if (kk * 5 >= toks2x.len() || kk * 5 >= fx.len()) {
                mism = mism + 1000000
            } else {
                var q = 0
                for (q < 5) {
                    if (toks2x.get(kk * 5 + q) != fx.get(kk * 5 + q)) {
                        mism = mism + 1
                    }
                    q = q + 1
                }
            }
            kk = kk + 1
        }
        return "S29 n2=" + itoa(n2) + " phys2=" + itoa(toks2x.len() / 5) + " fresh=" + itoa(fx.len() / 5) + " mism=" + itoa(mism)
    }
    var toks2 = List<int>.new()
    var spl = List<int>.new()
    var zz = 0
    for (zz < 10) {
        spl.push(0)
        zz = zz + 1
    }
    incremental_lex_p(pg, cs2, toks1, snap, nl.get(0), start, end, delta, toks2, spl, stage)
    if (stage == 2) {
        return "S2 ok fb=" + itoa(spl.get(1)) + " n2=" + itoa(spl.get(6))
    }
    if (stage == 6) {
        return "S6 post-inclex fb=" + itoa(spl.get(1))
    }
    let cold = canonical(t1, ef1, decls1, r1)
    if (stage == 7) {
        return "S7 canon-ok len=" + itoa(cold.len())
    }
    if (spl.get(1) != 0) {
        return fb_fresh(pg, cs2, firsts, nullable, snap, cold, spl.get(1), spl.get(2), stage)
    }
    var affected_lo = start
    var affected_hi = srcb.len()
    let old_count = toks1.len() / 5
    if (spl.get(5) < old_count) {
        let checkpoint = tok_start(toks1, spl.get(5))
        if (checkpoint < affected_lo) {
            affected_lo = checkpoint
        }
    }
    if (spl.get(4) < old_count) {
        affected_hi = tok_start(toks1, spl.get(4))
    }
    if (affected_hi < end) {
        affected_hi = end
    }
    var gcand = build_gcand(decls1, t1, ef1, toks1, affected_lo, affected_hi)
    var gshift = List<int>.new()
    gshift.push(end)
    gshift.push(delta)
    return edit_converged(pg, cs2, firsts, nullable, snap, srcb, toks2, spl, cold, t1, ef1, decls1, gshift, gcand, stage)
}

fn subtree_has_error(t List<int>, ef List<int>, node int) int {
    var stack = List<int>.new()
    stack.push(node)
    var depth = 1
    for (depth > 0) {
        let cur = stack.get(depth - 1)
        depth = depth - 1
        let fl = t.get(cur * 8 + 6)
        if ((fl & (flag_error() | flag_missing())) != 0) {
            return 1
        }
        var k = t.get(cur * 8 + 4) - 1
        for (k >= 0) {
            let c = ef.get((t.get(cur * 8 + 3) + k) * 2)
            if (depth == stack.len()) {
                stack.push(c)
            } else {
                stack.set(depth, c)
            }
            depth = depth + 1
            k = k - 1
        }
    }
    return 0
}

/// V-04: identity behavior — insert one ASCII space at `alpha_at`, then
/// undo; the content SnapshotId must change and restore.
pub fn identity_case(sample Str, alpha_at int) Str {
    var snap = str_to_bytes(sample)
    let id0 = snapshot_id(snap, snap.len())
    var nl = List<int>.new()
    nl.push(0)
    let rc1 = apply_edit(snap, snap.len(), alpha_at, alpha_at, " ", nl)
    if (rc1 != 0) {
        return "EDIT1_REFUSED " + itoa(rc1)
    }
    let id1 = snapshot_id(snap, nl.get(0))
    var nl2 = List<int>.new()
    nl2.push(0)
    let rc2 = apply_edit(snap, nl.get(0), alpha_at, alpha_at + 1, "", nl2)
    if (rc2 != 0) {
        return "EDIT2_REFUSED " + itoa(rc2)
    }
    let id2 = snapshot_id(snap, nl2.get(0))
    var sum0 = 0
    var q = 0
    for (q < snap.len()) {
        sum0 = sum0 + snap.get(q)
        q = q + 1
    }
    var out = "changed="
    if (id1 != id0) {
        out = out + "1"
    } else {
        out = out + "0"
    }
    out = out + " restored="
    if (id2 == id0) {
        out = out + "1"
    } else {
        out = out + "0"
    }
    out = out + " pfx=" + id0.slice(0, 8).clone() + "/" + id1.slice(0, 8).clone() + "/" + id2.slice(0, 8).clone() + " len2=" + itoa(nl2.get(0)) + " bytes=" + itoa(sum0)
    return out
}

/// D-1046-02 probe: parse-then-lex composition. mode 0 = same cs;
/// mode 1 = fresh compile_scanner before the second lex; mode 2 = two lexes
/// without any parse (control).
pub fn parse_then_lex_case(profile Str, sample Str, mode int) Str {
    var pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR"
    }
    var cs2 = compile_scanner(pg)
    let srcb = str_to_bytes(sample)
    if (mode == 2) {
        var t0 = List<int>.new()
        var l0 = List<int>.new()
        lex_all(pg, cs2, srcb, -1, t0, l0)
        var t0b = List<int>.new()
        var l0b = List<int>.new()
        lex_all(pg, cs2, srcb, -1, t0b, l0b)
        return "M2 two-lex ok " + itoa(t0.len() / 5) + "/" + itoa(t0b.len() / 5)
    }
    var firsts = List<int>.new()
    var nullable = List<int>.new()
    first_sets_into(pg, firsts, nullable)
    var toks = List<int>.new()
    var lexd = List<int>.new()
    lex_all(pg, cs2, srcb, -1, toks, lexd)
    var t = List<int>.new()
    var ef = List<int>.new()
    var decls = List<int>.new()
    var dmsg = List<int>.new()
    var g0 = List<int>.new()
    g0.push(0)
    let root = parse_tokens_n(pg, cs2, firsts, nullable, toks, srcb, t, ef, decls, dmsg, List<int>.new(), List<int>.new(), List<int>.new(), List<int>.new(), List<int>.new(), g0, 1048576, 4000000, toks.len() / 5)
    if (root < 0) {
        return "PARSE_ERR " + itoa(-root)
    }
    if (mode == 1) {
        cs2 = compile_scanner(pg)
    }
    var t2 = List<int>.new()
    var l2 = List<int>.new()
    if (mode == 3) {
        var snap = copy_ints(srcb)
        var nl = List<int>.new()
        nl.push(0)
        let rc = apply_edit(snap, snap.len(), 51, 51, "2 * ", nl)
        if (rc != 0) {
            return "M3 edit-refused " + itoa(rc)
        }
        lex_all(pg, cs2, snap, -1, t2, l2)
        return "M3 parse+edit+lex ok n2=" + itoa(t2.len() / 5)
    }
    if (mode == 4) {
        lex_all(pg, cs2, srcb, -1, t2, l2)
        var t3 = List<int>.new()
        var ef3 = List<int>.new()
        var decls3 = List<int>.new()
        var dmsg3 = List<int>.new()
        var g1 = List<int>.new()
        g1.push(0)
        let root2 = parse_tokens_n(pg, cs2, firsts, nullable, t2, srcb, t3, ef3, decls3, dmsg3, List<int>.new(), List<int>.new(), List<int>.new(), List<int>.new(), List<int>.new(), g1, 1048576, 4000000, t2.len() / 5)
        return "M4 two-parse ok " + itoa(root) + "/" + itoa(root2)
    }
    if (mode == 5) {
        let c1 = canonical(t, ef, decls, root)
        return "M5 canon-len " + itoa(c1.len()) + " tail=" + c1.slice(c1.len() - 6, c1.len()).clone()
    }
    lex_all(pg, cs2, srcb, -1, t2, l2)
    return "M" + itoa(mode) + " ok root=" + itoa(root) + " n2=" + itoa(t2.len() / 5)
}

/// The fresh reference leg (run in its own AV execution; V-02's oracle is
/// the equality of this tree with the incremental tree from edit_case).
pub fn many_lists_case() Str {
    var total = 0
    var k = 0
    for (k < 100) {
        var xs = List<int>.new()
        var i = 0
        for (i < 700) {
            xs.push(i)
            i = i + 1
        }
        total = total + xs.len()
        k = k + 1
    }
    return "total=" + itoa(total)
}

pub fn one_big_list_case() Str {
    var xs = List<int>.new()
    var i = 0
    for (i < 70000) {
        xs.push(i)
        i = i + 1
    }
    return "len=" + itoa(xs.len())
}

pub fn edit_ref_case(profile Str, sample Str, start int, end int, insert Str) Str {
    var pg = decode_program_parts(fetch_parts(profile))
    if (!pg_ok(pg)) {
        return "DECODE_ERR"
    }
    let cs2 = compile_scanner(pg)
    var firsts = List<int>.new()
    var nullable List<int> = List<int>.new()
    first_sets_into(pg, firsts, nullable)
    let srcb = str_to_bytes(sample)
    var snap = copy_ints(srcb)
    var nl = List<int>.new()
    nl.push(0)
    let rc = apply_edit(snap, snap.len(), start, end, insert, nl)
    if (rc != 0) {
        return "REF_EDIT_REFUSED " + itoa(rc)
    }
    var toksX = List<int>.new()
    var lexdX = List<int>.new()
    lex_all(pg, cs2, snap, -1, toksX, lexdX)
    var t3 = List<int>.new()
    var ef3 = List<int>.new()
    var decls3 = List<int>.new()
    var d3 = List<int>.new()
    var gX = List<int>.new()
    gX.push(0)
    var r_ot = List<int>.new()
    var r_oef = List<int>.new()
    var r_odecls = List<int>.new()
    var r_gc = List<int>.new()
    var r_gs = List<int>.new()
    let r3 = parse_tokens_n(pg, cs2, firsts, nullable, toksX, snap, t3, ef3, decls3, d3, r_ot, r_oef, r_odecls, r_gc, r_gs, gX, 1048576, 67108864, toksX.len() / 5)
    if (r3 < 0) {
        return "REF_ERR " + itoa(-r3)
    }
    return "REF|" + canonical(t3, ef3, decls3, r3) + "REFEND"
}
