// ---------------------------------------------------------------------------
// Frame arena layout (stride 40) and cursor slots
// ---------------------------------------------------------------------------

fn fs_kind() int { return 0 }
fn fs_rule() int { return 1 }
fn fs_alt() int { return 2 }
fn fs_step() int { return 3 }
fn fs_cstart() int { return 4 }
fn fs_clen() int { return 5 }
fn fs_save() int { return 6 }
fn fs_fsave() int { return 7 }
fn fs_repsave() int { return 8 }
fn fs_optsave() int { return 9 }
fn fs_wait() int { return 10 }
fn fs_repk() int { return 11 }
fn fs_consumed() int { return 12 }
fn fs_committed() int { return 13 }
fn fs_cuthere() int { return 14 }
fn fs_liststarted() int { return 15 }
fn fs_active() int { return 16 }
fn fs_isdecl() int { return 17 }
fn fs_coverfrom() int { return 18 }
fn fs_nodestart() int { return 19 }
fn fs_failfast() int { return 20 }
fn fs_ptable() int { return 21 }
fn fs_pstage() int { return 22 }
fn fs_panchor() int { return 23 }
fn fs_pcallee() int { return 24 }
fn fs_popenleaf() int { return 25 }
fn fs_pdone() int { return 26 }
fn fs_pfield() int { return 27 }
fn fs_ptailwait() int { return 28 }
fn fs_ptaildone() int { return 29 }
fn fs_pextra_s() int { return 30 }
fn fs_pextra_l() int { return 31 }
fn fs_pvals_s() int { return 32 }
fn fs_pvals_l() int { return 33 }
fn fs_pops_s() int { return 34 }
fn fs_pops_l() int { return 35 }
fn fs_stride() int { return 40 }

fn fg(fr List<int>, i int, slot int) int {
    return fr.get(i * fs_stride() + slot)
}

fn fset(fr List<int>, i int, slot int, v int) int {
    fr.set(i * fs_stride() + slot, v)
    return 0
}

// mc slots
fn m_i() int { return 0 }
