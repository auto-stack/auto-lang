fn diagnostic_name(code int) Str {
    if (code == bind_duplicate()) { return "bind.duplicate" }
    if (code == bind_unresolved()) { return "bind.unresolved" }
    if (code == bind_immutable()) { return "bind.immutable" }
    if (code == bind_budget()) { return "resource.semantic" }
    if (code == bind_arguments()) { return "bind.arguments" }
    if (code == bind_private()) { return "bind.private" }
    if (code == bind_module()) { return "bind.module" }
    if (code == bind_import_cycle()) { return "bind.import-cycle" }
    if (code == initializer_cycle()) { return "bind.initializer-cycle" }
    if (code == initializer_module_order()) { return "bind.initializer-order" }
    if (code == global_type_error()) { return "type.global" }
    if (code == type_unknown()) { return "type.unresolved" }
    if (code == type_operator()) { return "type.operator" }
    if (code == type_value()) { return "type.value" }
    if (code == type_return()) { return "type.return" }
    if (code == type_argument()) { return "type.argument" }
    if (code == choice_argument_error()) { return "type.argument" }
    if (code == type_branch()) { return "type.branch" }
    if (code == type_condition()) { return "type.condition" }
    if (code == type_member()) { return "type.member" }
    if (code == type_empty_list()) { return "type.empty-list" }
    if (code == foreign_authority_error()) { return "foreign.authority" }
    if (code == foreign_provider_error()) { return "foreign.provider" }
    if (code == foreign_handle_error()) { return "foreign.handle-owner" }
    if (code == foreign_callback_error()) { return "foreign.callback-target" }
    if (code == foreign_layout_error()) { return "foreign.layout" }
    if (code == type_pattern_error()) { return "type.pattern" }
    if (code == type_exhaustive_error()) { return "type.match-exhaustive" }
    if (code == type_match_branch_error()) { return "type.branch" }
    if (code == type_recursive_layout_error()) { return "type.recursive-layout" }
    if (code == foreign_signature_error()) { return "foreign.signature" }
    if (code == literal_range()) { return "type.literal-range" }
    if (code == literal_syntax()) { return "type.literal-syntax" }
    if (code == hir_unsupported()) { return "hir.unsupported" }
    if (code == hir_owner_error()) { return "hir.owner" }
    if (code == hir_reference_error()) { return "hir.reference" }
    if (code == hir_type_error()) { return "hir.type" }
    if (code == hir_shape_error()) { return "hir.shape" }
    if (code == hir_initialization_error()) { return "hir.initialization" }
    if (code == hir_mutability_error()) { return "hir.mutability" }
    if (code == hir_global_authority_error()) { return "hir.global-authority" }
    if (code == hir_borrow_error()) { return "hir.borrow" }
    if (code == outside_base_profile()) { return "mir.base-profile" }
    if (code == invalid_mir_reference()) { return "mir.reference" }
    if (code == invalid_mir_type()) { return "mir.type" }
    if (code == uninitialized_mir_slot()) { return "mir.uninitialized" }
    if (code == invalid_ct_entry()) { return "ct.entry" }
    if (code == annotation_owner_error()) { return "type.annotation-owner" }
    if (code == instance_unsupported()) { return "instance.unsupported" }
    if (code == instance_constraint()) { return "instance.constraint" }
    if (code == instance_arity()) { return "instance.arity" }
    if (code == instance_recursive()) { return "instance.recursive" }
    return "internal.semantic"
}

fn collect_literal_facts(pg List<int>, ast List<int>, src List<int>, bases List<int>, facts List<int>, lines List<Str>, errors List<int>, fuel List<int>, deadline i64) int {
    var row = 0
    var hex = List<Str>.new()
    for (row < row_count(ast)) {
        if (!take_step(fuel, deadline)) {
            errors.push(row)
            return bind_budget()
        }
        let lane = facts.get(row)
        if ((lane == f32_type() || lane == f64_type()) && kind(pg, ast, row) == "affix-num") {
            let negative = negative_source_literal(src, ast, row)
            let status = float_payload(src, start_of(ast, row), end_of(ast, row), negative, lane, hex, fuel, deadline)
            if (status != 0) {
                errors.push(row)
                return status
            }
            var width = "f32"
            if (lane == f64_type()) { width = "f64" }
            let line = "FLOAT " + width + " " + hex.remove(0) + " " + location(ast, row, bases) + "\n"
            lines.push(line.move)
        }
        row = row + 1
    }
    return 0
}

fn admit_imports(pg List<int>, ast List<int>, links List<int>, src List<int>, bases List<int>, pending List<int>, names List<int>, signatures List<int>, layouts List<int>, fuel List<int>, deadline i64) Str {
    var at = 0
    for (at < pending.len()) {
        let row = pending.get(at + 1)
        let language = child_with_role(pg, ast, links, row, "lang")
        let provider = child_with_role(pg, ast, links, row, "provider")
        if (pending.get(at) != pending_foreign() || language < 0 || provider < 0) {
            return "pending"
        }
        let language_name = spelling(src, ast, language)
        if (language_name != "rs" && language_name != "c") { return "pending" }
        at = at + deferred_stride()
    }
    let path = get("AAC1047_FOREIGN_PATH")
    let authority = get("AAC1047_FOREIGN_AUTHORITY")
    if (path.len() == 0) { return "pending" }
    let length = size(path.clone())
    if (length < 0i64) { return "ERROR os.read\n" }
    if (length > fuel.get(0).to(i64)) { return "ERROR resource.semantic\n" }
    let page = read_bytes(path)
    is page {
        Some(bytes) -> {
            at = 0
            for (at < pending.len()) {
                let row = pending.get(at + 1)
                let token = child_with_role(pg, ast, links, row, "provider")
                let provider = spelling(src, ast, token)
                let language = spelling(src, ast, child_with_role(pg, ast, links, row, "lang"))
                let status = admit_foreign_provider(bytes, authority.clone(), provider, language, source_id(ast, row), names, signatures, layouts, fuel, deadline)
                if (status != 0) {
                    return "ERROR " + diagnostic_name(status) + " " + location(ast, token, bases) + "\n"
                }
                at = at + deferred_stride()
            }
            return ""
        }
        None -> {}
    }
    return "ERROR os.read\n"
}

fn admit_global_artifact(ast List<int>, src List<int>, modules List<int>, declarations List<int>, layouts List<int>, fuel List<int>, deadline i64) Str {
    let path = get("AAC1047_HIR_INPUT")
    let size_bytes = size(path.clone())
    if (size_bytes < 0i64) { return "ERROR os.read\n" }
    if (size_bytes > 262144i64) { return "ERROR resource.semantic\n" }
    let data = read_bytes(path)
    is data {
        Some(bytes) -> {
            let result = verify_global_document(bytes, ast, src, modules, declarations, layouts, fuel, deadline)
            if (result == 0) { return "ADMITTED text-record-i32-draft\n" }
            return "ERROR " + diagnostic_name(result) + "\n"
        }
        None -> {}
    }
    return "ERROR os.read\n"
}

fn freeze_report(src List<int>, bases List<int>, modules List<int>, authority Str, report Str, fuel List<int>, deadline i64) Str {
    let frozen = semantic_facts(src, bases, modules, authority, report, fuel, deadline)
    if (frozen.len() == 0) { return "ERROR resource.semantic\n" }
    return frozen
}

fn observe(pg List<int>, src List<int>, ast List<int>, bases List<int>, roots List<int>, modules List<int>, package_source bool, steps int, ct_deadline i64) Str {
    var links = List<int>.new()
    if (!build_child_index(ast, links)) { return "ERROR resource.ast\n" }
    var declarations = List<int>.new()
    var uses = List<int>.new()
    var mappings = List<int>.new()
    var errors = List<int>.new()
    var fuel = List<int>.new()
    fuel.push(steps)
    let started = mono_ms()
    if (started < 0i64) { return "ERROR os.clock\n" }
    var deadline = started + 5000i64
    if (ct_deadline > 0i64 && ct_deadline < deadline) { deadline = ct_deadline }
    var metadata = List<int>.new()
    var pending = List<int>.new()
    let cataloged = collect_declaration_inputs(pg, ast, links, src, metadata, pending, errors, fuel, deadline)
    if (cataloged != 0) {
        return "ERROR " + diagnostic_name(cataloged) + " " + location(ast, errors.get(0), bases) + "\n"
    }
    var foreign_names = List<int>.new()
    var foreign_signatures = List<int>.new()
    var foreign_layouts = List<int>.new()
    let hir_mode = get("AAC1047_HIR")
    if (pending.len() > 0) {
        let imports = admit_imports(pg, ast, links, src, bases, pending, foreign_names, foreign_signatures, foreign_layouts, fuel, deadline)
        if (imports == "pending") {
            let report = declaration_report(ast, src, bases, metadata, pending)
            if (hir_mode == "facts") { return freeze_report(src, bases, modules, "", report, fuel, deadline) }
            return report
        }
        if (imports.len() > 0) { return imports }
    }
    let status = bind_source(pg, ast, links, src, modules, roots, package_source, foreign_names, declarations, uses, mappings, errors, fuel, deadline)
    if (status != 0) {
        return "ERROR " + diagnostic_name(status) + " " + location(ast, errors.get(0), bases) + "\n"
    }
    var initializers = List<int>.new()
    let ordered = initialize_order(pg, ast, links, src, modules, roots.len(), declarations, uses, initializers, errors, fuel, deadline)
    if (ordered != 0) {
        return "ERROR " + diagnostic_name(ordered) + " " + location(ast, errors.get(0), bases) + "\n"
    }
    var typed_report = ""
    if (get("AAC1047_TYPED") == "1" || hir_mode.len() > 0) {
        var facts = List<int>.new()
        var types = List<int>.new()
        let typed = infer_source(pg, ast, links, src, declarations, uses, mappings, foreign_signatures, foreign_layouts, facts, types, errors, fuel, deadline)
        if (typed != 0) {
            return "ERROR " + diagnostic_name(typed) + " " + location(ast, errors.get(0), bases) + "\n"
        }
        var layouts = List<int>.new()
        var accesses = List<int>.new()
        if (initializers.len() > 0) {
            let globals = collect_global_facts(pg, ast, links, declarations, uses, facts, initializers, layouts, accesses, errors, fuel, deadline)
            if (globals != 0) {
                return "ERROR " + diagnostic_name(globals) + " " + location(ast, errors.get(0), bases) + "\n"
            }
        }
        if (hir_mode.len() > 0 && hir_mode != "facts") {
            if (pending.len() > 0) {
                return type_report(ast, bases, facts, types) + declaration_report(ast, src, bases, metadata, pending)
            }
            if (hir_mode == "admit-globals") {
                return admit_global_artifact(ast, src, modules, declarations, layouts, fuel, deadline)
            }
            var control = 0
            if (hir_mode == "owner") { control = 1 }
            if (hir_mode == "defref") { control = 2 }
            if (hir_mode == "immutable-global") { control = 3 }
            if (hir_mode == "mir") { control = 4 }
            if (hir_mode == "ct-mir") { control = 4 }
            if (hir_mode == "mir-defref") { control = 5 }
            if (hir_mode == "mir-type") { control = 6 }
            if (hir_mode == "mir-cfg") { control = 7 }
            if (hir_mode == "mir-change-constant") { control = 8 }
            if (hir_mode == "mir-uninitialized") { control = 9 }
            var abc = List<int>.new()
            var entry_name = "main"
            if (ct_deadline > 0i64 && get("AAC1055_CT_TARGET").len() > 0) { entry_name = ct_entry_name() }
            let document = checked_core_atom(pg, ast, links, src, roots, modules, declarations, uses, mappings, facts, types, layouts, fuel, deadline, errors, control, abc, entry_name)
            if (document.len() == 0) {
                return "ERROR " + diagnostic_name(errors.get(1)) + " " + location(ast, errors.get(0), bases) + "\n"
            }
            if (hir_mode == "ct-mir" && write_bytes(get("AAC1055_CT_SOURCE"), src) != 0) { return "ERROR os.write\n" }
            if (control >= 4 && write_bytes(get("AAC1055_ABC"), abc) != 0) { return "ERROR os.write\n" }
            return document
        }
        var literals = List<Str>.new()
        let extracted = collect_literal_facts(pg, ast, src, bases, facts, literals, errors, fuel, deadline)
        if (extracted != 0) {
            return "ERROR " + diagnostic_name(extracted) + " " + location(ast, errors.get(0), bases) + "\n"
        }
        typed_report = type_report(ast, bases, facts, types) + globals_report(ast, src, bases, modules, declarations, layouts, accesses) + join_rows(literals, literals.len())
    }
    let report = typed_report + binding_report(ast, src, bases, declarations, uses, mappings, initializers) + declaration_report(ast, src, bases, metadata, pending)
    if (hir_mode == "facts") {
        var authority = ""
        if (foreign_signatures.len() > 0) { authority = get("AAC1047_FOREIGN_AUTHORITY") }
        return freeze_report(src, bases, modules, authority, report, fuel, deadline)
    }
    return report
}

fn load_source(pg List<int>, path Str, id int, src List<int>, ast List<int>, bases List<int>, roots List<int>, ct_deadline i64, steps int) Str {
    let length = size(path.clone())
    if (length < 0i64) { return "ERROR os.read\n" }
    if (length > 67108864i64 - src.len().to(i64)) { return "ERROR resource.source\n" }
    let input = read_bytes(path)
    is input {
        Some(bytes) -> {
            if (ct_deadline > 0i64 && id == 0) {
                let target = get("AAC1055_CT_TARGET")
                if (target.len() > 0) {
                    let raw = get("AAC1055_CT_ARGS")
                    var arguments = List<Str>.new()
                    if (raw.len() > 0) { arguments = split(raw.move, "\n") }
                    var fuel = List<int>.new()
                    fuel.push(steps)
                    let prepared = append_ct_entry(bytes, target.move, get("AAC1055_CT_RESULT"), arguments, fuel, ct_deadline)
                    if (prepared != 0) { return "ERROR " + diagnostic_name(prepared) + "\n" }
                }
            }
            var rows = List<int>.new()
            var diagnostic = List<int>.new()
            let parsed = parse_semantic_source(pg, format_mode("aac"), bytes, id, 0, rows, diagnostic)
            if (parsed == -2 || parsed == -3) { return "ERROR resource.source\n" }
            if (parsed == -4) { return "ERROR source.utf8\n" }
            if (parsed == -7 && diagnostic.len() >= 3) {
                return "ERROR source.syntax " + from_int(id) + " " + from_int(diagnostic.get(1)) + ".." + from_int(diagnostic.get(2)) + "\n"
            }
            if (parsed < 0) { return "ERROR source.projection\n" }
            if (!append_source(bytes, rows, src, ast, bases, roots)) { return "ERROR resource.source\n" }
            return ""
        }
        None -> {}
    }
    return "ERROR os.read\n"
}

fn has_named_inventory(inventory Str) bool {
    var index = 0
    var separated = true
    for (index < inventory.len()) {
        let byte_value = inventory.char_at(index).to_codepoint()
        let boundary = byte_value == 10 || byte_value == 47
        if (boundary && separated) { return false }
        separated = boundary
        index = index + 1
    }
    return !separated
}

// PLAN-1048: the instance pre-pass. When AAC1048_INSTANCES is set, the
// loaded program is expanded (templates stripped, calls rewritten to
// concrete instances, concrete functions appended per module) and the
// rebuilt tables replace the originals before the ordinary pipeline runs.
// The worksheet is written to AAC1048_WORKSHEET; no templates means the
// program is copied through untouched.
fn expand_instances(pg List<int>, src List<int>, ast List<int>, bases List<int>, roots List<int>, names List<int>, package Str, new_src List<int>, new_ast List<int>, new_bases List<int>, new_roots List<int>, steps int) Str {
    var links = List<int>.new()
    if (!build_child_index(ast, links)) { return "ERROR resource.ast\n" }
    var fuel = List<int>.new()
    fuel.push(steps)
    let started = mono_ms()
    if (started < 0i64) { return "ERROR os.clock\n" }
    var deadline = started + 5000i64
    var edits = List<int>.new()
    var arena = List<int>.new()
    var inst_texts = List<int>.new()
    var inst_meta = List<int>.new()
    var mod_insts = List<int>.new()
    var lines = List<Str>.new()
    let status = run_instance_pass(pg, ast, links, src, names, package, edits, arena, inst_texts, inst_meta, mod_insts, lines, fuel, deadline)
    if (status != 0) { return "ERROR " + diagnostic_name(status) + "\n" }
    if (lines.len() == 0) {
        var i = 0
        for (i < src.len()) {
            new_src.push(src.get(i))
            i = i + 1
        }
        i = 0
        for (i < ast.len()) {
            new_ast.push(ast.get(i))
            i = i + 1
        }
        i = 0
        for (i < bases.len()) {
            new_bases.push(bases.get(i))
            i = i + 1
        }
        i = 0
        for (i < roots.len()) {
            new_roots.push(roots.get(i))
            i = i + 1
        }
        return ""
    }
    let worksheet = get("AAC1048_WORKSHEET")
    if (worksheet.len() == 0) { return "ERROR instance.unsupported\n" }
    var report = ""
    for (lines.len() > 0) {
        report = report + lines.remove(0) + "\n"
    }
    if (write_text(worksheet, report) != 0) { return "ERROR os.write\n" }
    var module = 0
    for (module < roots.len()) {
        let lo = bases.get(module)
        var hi = src.len()
        if (module + 1 < bases.len()) { hi = bases.get(module + 1) }
        var text = rewrite_range(src, lo, hi, edits, arena)
        var cursor = 0
        var mi = 0
        for (mi < module) {
            cursor = cursor + 1 + mod_insts.get(cursor)
            mi = mi + 1
        }
        var count = mod_insts.get(cursor)
        var ii = 0
        for (ii < count) {
            let inst = mod_insts.get(cursor + 1 + ii)
            let ofs = inst_meta.get(inst * 2)
            let len = inst_meta.get(inst * 2 + 1)
            text = text + "\n" + span_text(inst_texts, ofs, ofs + len)
            ii = ii + 1
        }
        if (text.len() > 0) {
            let bytes = utf8_bytes(text)
            var rows = List<int>.new()
            var diagnostic = List<int>.new()
            let parsed = parse_semantic_source(pg, format_mode("aac"), bytes, module, 0, rows, diagnostic)
            if (parsed == -2 || parsed == -3) { return "ERROR resource.source\n" }
            if (parsed == -4) { return "ERROR source.utf8\n" }
            if (parsed == -7 && diagnostic.len() >= 3) {
                return "ERROR source.syntax " + from_int(module) + " " + from_int(diagnostic.get(1)) + ".." + from_int(diagnostic.get(2)) + "\n"
            }
            if (parsed < 0) { return "ERROR source.projection\n" }
            if (!append_source(bytes, rows, new_src, new_ast, new_bases, new_roots)) { return "ERROR resource.source\n" }
        }
        module = module + 1
    }
    if (new_roots.len() == 0) { return "ERROR instance.arity\n" }
    return ""
}

fn project(steps int) Str {
    var ct_deadline = 0i64
    let mode = get("AAC1047_HIR")
    if (mode == "ct-mir") {
        if (get("AAC1055_CT_TARGET").len() == 0) { return "ERROR ct.entry\n" }
        var budget = 10000
        let override_ms = get("AAC1055_CT_BUDGET_MS")
        if (override_ms.len() > 0) {
            let parsed = to_int(override_ms.move)
            is parsed {
                Some(value) -> { budget = value }
                None -> { return "ERROR ct.entry\n" }
            }
        }
        if (budget <= 0 || budget > 10000) { return "ERROR ct.entry\n" }
        let now = mono_ms()
        if (now < 0i64) { return "ERROR os.clock\n" }
        ct_deadline = now + budget.to(i64)
    }
    let pg = decode_program_parts(fetch_parts("aac"))
    if (!pg_ok(pg)) { return "ERROR internal.grammar\n" }
    let directory = get("AAC1047_PROJECT")
    var package = "app"
    var names = List<int>.new()
    var ast = List<int>.new()
    var src = List<int>.new()
    var roots = List<int>.new()
    var bases = List<int>.new()
    if (directory.len() == 0) {
        let result = load_source(pg, get("AAC1047_INPUT"), 0, src, ast, bases, roots, ct_deadline, steps)
        if (result.len() > 0) { return result }
        add_module_name(names, "app.main")
    } else {
        package = get("AAC1047_PACKAGE")
        if (!identifier(package.clone())) { return "ERROR source.package\n" }
        let inventory = get("AAC1047_INVENTORY")
        if (!has_named_inventory(inventory.clone())) { return "ERROR source.module\n" }
        var requested = split(inventory, "\n")
        for (requested.len() > 0) {
            let name = requested.remove(0)
            var parts = split(name.clone(), "/")
            if (parts.len() < 1 || parts.len() > 2) { return "ERROR source.module\n" }
            var owner = package.clone()
            if (parts.len() == 2) { owner = parts.remove(0) }
            let module_name = parts.remove(0)
            if (!identifier(owner.clone()) || !identifier(module_name.clone())) { return "ERROR source.module\n" }
            let key = owner + "." + module_name
            if (find_module_name(names, key.clone()) >= 0) { return "ERROR source.module-duplicate\n" }
            let path = join(directory.clone(), name.clone() + ".at")
            let result = load_source(pg, path, roots.len(), src, ast, bases, roots, ct_deadline, steps)
            if (result.len() > 0) { return result }
            add_module_name(names, key)
        }
    }
    let meta_on = get("AAC1048_META")
    if (meta_on == "1") {
        var links2 = List<int>.new()
        if (!build_child_index(ast, links2)) { return "ERROR resource.ast\n" }
        var fuel2 = List<int>.new()
        fuel2.push(steps)
        let now2 = mono_ms()
        if (now2 < 0i64) { return "ERROR os.clock\n" }
        var meta_report = "aac.meta-report/1\n"
        var row2 = 0
        for (row2 < row_count(ast)) {
            let node_kind = kind(pg, ast, row2)
            if (node_kind == "fn-item") {
                let line = fn_signature_line(pg, ast, links2, src, names, row2, fuel2, now2 + 5000i64)
                if (line.len() > 0) { meta_report = meta_report + line + "\n" }
            }
            if (node_kind == "type-item") {
                let line = record_shape_line(pg, ast, links2, src, names, row2, fuel2, now2 + 5000i64)
                if (line.len() > 0) { meta_report = meta_report + line + "\n" }
            }
            if (node_kind == "attribute-entry") {
                let line = required_line(pg, ast, links2, src, names, row2, fuel2, now2 + 5000i64)
                if (line.len() > 0) { meta_report = meta_report + line + "\n" }
            }
            row2 = row2 + 1
        }
        return meta_report
    }
    let instances_on = get("AAC1048_INSTANCES")
    if (instances_on.len() > 0 && roots.len() > 0) {
        var new_src = List<int>.new()
        var new_ast = List<int>.new()
        var new_bases = List<int>.new()
        var new_roots = List<int>.new()
        let expanded = expand_instances(pg, src, ast, bases, roots, names, package, new_src, new_ast, new_bases, new_roots, steps)
        if (expanded.len() > 0) { return expanded }
        src = new_src
        ast = new_ast
        bases = new_bases
        roots = new_roots
    }
    return observe(pg, src, ast, bases, roots, names, directory.len() > 0, steps, ct_deadline)
}

fn admit_document(path Str, steps int) Str {
    let length = size(path.clone())
    if (length < 0i64) { return "ERROR os.read\n" }
    if (length > 262144i64 || steps < 1 || steps > 1000000) { return "ERROR resource.semantic\n" }
    let input = read_bytes(path)
    is input {
        Some(bytes) -> {
            var fuel = List<int>.new()
            fuel.push(steps)
            let started = mono_ms()
            if (started < 0i64) { return "ERROR os.clock\n" }
            let result = verify_core_document(bytes, fuel, started + 5000i64)
            if (result == 0) { return "ADMITTED core-i32-draft\n" }
            if (result == 1) { return "ADMITTED text-record-i32-draft\n" }
            if (result == 2) { return "ADMITTED scalar-i32-draft\n" }
            if (result == 3) { return "ADMITTED source-numeric-draft\n" }
            return "ERROR " + diagnostic_name(result) + "\n"
        }
        None -> {}
    }
    return "ERROR os.read\n"
}

// This driver accepts an independently allocated staging path from its
// fixture. Diagnostics remain in the report, outside the consumer artifact.
fn publish_verified(report Str, artifact Str) Str {
    let staged = get("AAC1047_STAGED")
    if (staged.len() == 0 || staged == artifact) { return "ERROR os.stage\n" }
    var profile = "core-i32-draft"
    let global_prefix = "hir(schema: \"auto.hir.text-record.draft\""
    if (report.len() > global_prefix.len() && report.slice(0, global_prefix.len()).clone() == global_prefix) {
        profile = "text-record-i32-draft"
    }
    let scalar_prefix = "hir(schema: \"auto.hir.scalar.draft\""
    if (report.len() > scalar_prefix.len() && report.slice(0, scalar_prefix.len()).clone() == scalar_prefix) {
        profile = "scalar-i32-draft"
    }
    let numeric_prefix = "hir(schema: \"auto.hir.numeric.draft\""
    if (report.len() > numeric_prefix.len() && report.slice(0, numeric_prefix.len()).clone() == numeric_prefix) {
        profile = "source-numeric-draft"
    }
    if (write_text(staged.clone(), report) != 0) {
        delete(staged)
        return "ERROR os.stage\n"
    }
    if (replace_atomic(staged.clone(), artifact) != 0) {
        delete(staged)
        return "ERROR os.replace\n"
    }
    return "PUBLISHED " + profile + "\n"
}

fn write_stage_report(report Str) int {
    let artifact = get("AAC1047_ARTIFACT")
    let output = get("AAC1047_OUTPUT")
    if (artifact.len() > 0 && report.len() >= 4 && report.slice(0, 4).clone() == "hir(") {
        return write_text(output, publish_verified(report, artifact))
    }
    return write_text(output, report)
}

fn main() int {
    var limit = 1000000
    let requested = to_int(get("AAC1047_STEPS"))
    is requested {
        Some(value) -> { limit = value }
        None -> {}
    }
    if (get("AAC1047_HIR") == "descriptor") {
        let report = admit_document(get("AAC1047_INPUT"), limit)
        return write_text(get("AAC1047_OUTPUT"), report)
    }
    return write_stage_report(project(limit))
}
