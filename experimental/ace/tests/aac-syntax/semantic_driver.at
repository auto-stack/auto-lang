fn location(ast List<int>, row int, bases List<int>) Str {
    let id = source_id(ast, row)
    let base = bases.get(id)
    return from_int(id) + " " + from_int(start_of(ast, row) - base) + ".." + from_int(end_of(ast, row) - base)
}

fn diagnostic_name(code int) Str {
    if (code == bind_duplicate()) { return "bind.duplicate" }
    if (code == bind_unresolved()) { return "bind.unresolved" }
    if (code == bind_immutable()) { return "bind.immutable" }
    if (code == bind_budget()) { return "resource.semantic" }
    if (code == bind_arguments()) { return "bind.arguments" }
    if (code == bind_private()) { return "bind.private" }
    if (code == bind_module()) { return "bind.module" }
    if (code == bind_import_cycle()) { return "bind.import-cycle" }
    if (code == initializer_cycle()) { return "bind.initializer-cycle" }
    if (code == initializer_module_order()) { return "bind.initializer-order" }
    if (code == type_unknown()) { return "type.unresolved" }
    if (code == type_operator()) { return "type.operator" }
    if (code == type_value()) { return "type.value" }
    if (code == type_return()) { return "type.return" }
    if (code == type_argument()) { return "type.argument" }
    if (code == type_branch()) { return "type.branch" }
    if (code == type_condition()) { return "type.condition" }
    if (code == type_member()) { return "type.member" }
    if (code == literal_range()) { return "type.literal-range" }
    if (code == literal_syntax()) { return "type.literal-syntax" }
    if (code == hir_unsupported()) { return "hir.unsupported" }
    if (code == hir_owner_error()) { return "hir.owner" }
    if (code == hir_reference_error()) { return "hir.reference" }
    if (code == hir_type_error()) { return "hir.type" }
    if (code == hir_shape_error()) { return "hir.shape" }
    if (code == annotation_owner_error()) { return "type.annotation-owner" }
    return "internal.semantic"
}

fn binding_report(ast List<int>, src List<int>, bases List<int>, declarations List<int>, uses List<int>, mappings List<int>, initializers List<int>) Str {
    var output = List<Str>.new()
    output.push("aac.binding-report/1\n")
    var row = 0
    for (row < row_count(ast)) {
        let name = decl_name(declarations, row)
        if (name >= 0) {
            let text = spelling(src, ast, name)
            let line = "DECL " + from_int(row) + " " + from_int(decl_category(declarations, row)) + " " + text + " " + location(ast, name, bases) + "\n"
            output.push(line.move)
        }
        let target = uses.get(row)
        if (target >= 0) {
            let text = spelling(src, ast, row)
            let line = "USE " + from_int(target) + " " + text + " " + location(ast, row, bases) + "\n"
            output.push(line.move)
        }
        row = row + 1
    }
    var at = 0
    for (at < mappings.len()) {
        let call = mappings.get(at)
        let evaluation = mappings.get(at + 1)
        let slot = mappings.get(at + 2)
        let line = "ARG " + location(ast, call, bases) + " " + from_int(slot) + " " + location(ast, evaluation, bases) + "\n"
        output.push(line.move)
        at = at + call_mapping_stride()
    }
    at = 0
    for (at < initializers.len()) {
        let name = decl_name(declarations, initializers.get(at))
        let line = "INIT " + spelling(src, ast, name) + " " + location(ast, name, bases) + "\n"
        output.push(line.move)
        at = at + 1
    }
    return join_rows(output, output.len())
}

fn type_report(ast List<int>, bases List<int>, facts List<int>, types List<int>) Str {
    var result = List<Str>.new()
    result.push("aac.type-report/1\n")
    var index = 1
    for (index < types.len() / type_stride()) {
        let line = "TYPE " + from_int(index) + " " + from_int(type_kind(types, index)) + " " + from_int(type_first(types, index)) + " " + from_int(type_second(types, index)) + "\n"
        result.push(line.move)
        index = index + 1
    }
    index = 0
    for (index < facts.len()) {
        let fact = facts.get(index)
        if (fact > 0) {
            let line = "TY " + from_int(index) + " " + location(ast, index, bases) + " " + from_int(fact) + "\n"
            result.push(line.move)
        }
        index = index + 1
    }
    return join_rows(result, result.len())
}

fn declaration_report(ast List<int>, src List<int>, bases List<int>, annotations List<int>, pending List<int>) Str {
    var lines = List<Str>.new()
    if (pending.len() > 0) { lines.push("aac.pending-work/1\n") }
    var at = 0
    for (at < pending.len()) {
        let row = pending.get(at + 1)
        let line = "PENDING " + from_int(pending.get(at)) + " " + from_int(pending.get(at + 2)) + " " + location(ast, row, bases) + "\n"
        lines.push(line.move)
        at = at + deferred_stride()
    }
    at = 0
    for (at < annotations.len()) {
        let owner = annotations.get(at)
        let entry = annotations.get(at + 1)
        let text = spelling(src, ast, annotations.get(at + 2))
        let line = "ANNOTATION " + text + " " + location(ast, owner, bases) + " " + location(ast, entry, bases) + "\n"
        lines.push(line.move)
        at = at + annotation_stride()
    }
    return join_rows(lines, lines.len())
}

fn observe(pg List<int>, src List<int>, ast List<int>, bases List<int>, roots List<int>, modules List<int>, steps int) Str {
    var links = List<int>.new()
    if (!build_child_index(ast, links)) { return "ERROR resource.ast\n" }
    var declarations = List<int>.new()
    var uses = List<int>.new()
    var mappings = List<int>.new()
    var errors = List<int>.new()
    var fuel = List<int>.new()
    fuel.push(steps)
    let started = mono_ms()
    if (started < 0i64) { return "ERROR os.clock\n" }
    let deadline = started + 5000i64
    var metadata = List<int>.new()
    var pending = List<int>.new()
    let cataloged = collect_declaration_inputs(pg, ast, links, src, metadata, pending, errors, fuel, deadline)
    if (cataloged != 0) {
        return "ERROR " + diagnostic_name(cataloged) + " " + location(ast, errors.get(0), bases) + "\n"
    }
    if (pending.len() > 0) { return declaration_report(ast, src, bases, metadata, pending) }
    let status = bind_source(pg, ast, links, src, modules, roots, declarations, uses, mappings, errors, fuel, deadline)
    if (status != 0) {
        return "ERROR " + diagnostic_name(status) + " " + location(ast, errors.get(0), bases) + "\n"
    }
    var typed_report = ""
    let hir_mode = get("AAC1047_HIR")
    if (get("AAC1047_TYPED") == "1" || hir_mode.len() > 0) {
        var facts = List<int>.new()
        var types = List<int>.new()
        let typed = infer_source(pg, ast, links, src, declarations, uses, mappings, facts, types, errors, fuel, deadline)
        if (typed != 0) {
            return "ERROR " + diagnostic_name(typed) + " " + location(ast, errors.get(0), bases) + "\n"
        }
        if (hir_mode.len() > 0) {
            if (roots.len() != 1) { return "ERROR hir.unsupported\n" }
            var control = 0
            if (hir_mode == "owner") { control = 1 }
            if (hir_mode == "defref") { control = 2 }
            let document = checked_core_atom(pg, ast, links, src, declarations, uses, mappings, facts, fuel, deadline, errors, control)
            if (document.len() == 0) {
                return "ERROR " + diagnostic_name(errors.get(1)) + " " + location(ast, errors.get(0), bases) + "\n"
            }
            return document
        }
        typed_report = type_report(ast, bases, facts, types)
    }
    var initializers = List<int>.new()
    let ordered = initialize_order(pg, ast, links, src, modules, roots.len(), declarations, uses, initializers, errors, fuel, deadline)
    if (ordered != 0) {
        return "ERROR " + diagnostic_name(ordered) + " " + location(ast, errors.get(0), bases) + "\n"
    }
    return typed_report + binding_report(ast, src, bases, declarations, uses, mappings, initializers) + declaration_report(ast, src, bases, metadata, pending)
}

fn load_source(pg List<int>, path Str, id int, src List<int>, ast List<int>, bases List<int>, roots List<int>) Str {
    let length = size(path.clone())
    if (length < 0i64) { return "ERROR os.read\n" }
    if (length > 67108864i64 - src.len().to(i64)) { return "ERROR resource.source\n" }
    let input = read_bytes(path)
    is input {
        Some(bytes) -> {
            var rows = List<int>.new()
            var diagnostic = List<int>.new()
            let parsed = parse_semantic_source(pg, format_mode("aac"), bytes, id, 0, rows, diagnostic)
            if (parsed == -2 || parsed == -3) { return "ERROR resource.source\n" }
            if (parsed == -4) { return "ERROR source.utf8\n" }
            if (parsed == -7 && diagnostic.len() >= 3) {
                return "ERROR source.syntax " + from_int(id) + " " + from_int(diagnostic.get(1)) + ".." + from_int(diagnostic.get(2)) + "\n"
            }
            if (parsed < 0) { return "ERROR source.projection\n" }
            if (!append_source(bytes, rows, src, ast, bases, roots)) { return "ERROR resource.source\n" }
            return ""
        }
        None -> {}
    }
    return "ERROR os.read\n"
}

fn project(steps int) Str {
    let pg = decode_program_parts(fetch_parts("aac"))
    if (!pg_ok(pg)) { return "ERROR internal.grammar\n" }
    let directory = get("AAC1047_PROJECT")
    var package = "app"
    var names = List<int>.new()
    var ast = List<int>.new()
    var src = List<int>.new()
    var roots = List<int>.new()
    var bases = List<int>.new()
    if (directory.len() == 0) {
        let result = load_source(pg, get("AAC1047_INPUT"), 0, src, ast, bases, roots)
        if (result.len() > 0) { return result }
        add_module_name(names, "app.main")
    } else {
        package = get("AAC1047_PACKAGE")
        if (!identifier(package.clone())) { return "ERROR source.package\n" }
        var requested = split(get("AAC1047_INVENTORY"), "\n")
        for (requested.len() > 0) {
            let name = requested.remove(0)
            var parts = split(name.clone(), "/")
            if (parts.len() < 1 || parts.len() > 2) { return "ERROR source.module\n" }
            var owner = package.clone()
            if (parts.len() == 2) { owner = parts.remove(0) }
            let module_name = parts.remove(0)
            if (!identifier(owner.clone()) || !identifier(module_name.clone())) { return "ERROR source.module\n" }
            let key = owner + "." + module_name
            if (find_module_name(names, key.clone()) >= 0) { return "ERROR source.module-duplicate\n" }
            let path = join(directory.clone(), name.clone() + ".at")
            let result = load_source(pg, path, roots.len(), src, ast, bases, roots)
            if (result.len() > 0) { return result }
            add_module_name(names, key)
        }
    }
    return observe(pg, src, ast, bases, roots, names, steps)
}

fn admit_document(path Str, steps int) Str {
    let length = size(path.clone())
    if (length < 0i64) { return "ERROR os.read\n" }
    if (length > 262144i64 || steps < 1 || steps > 1000000) { return "ERROR resource.semantic\n" }
    let input = read_bytes(path)
    is input {
        Some(bytes) -> {
            var fuel = List<int>.new()
            fuel.push(steps)
            let started = mono_ms()
            if (started < 0i64) { return "ERROR os.clock\n" }
            let result = verify_core_document(bytes, fuel, started + 5000i64)
            if (result == 0) { return "ADMITTED core-i32-draft\n" }
            return "ERROR " + diagnostic_name(result) + "\n"
        }
        None -> {}
    }
    return "ERROR os.read\n"
}

// This driver accepts an independently allocated staging path from its
// fixture. Diagnostics remain in the report, outside the consumer artifact.
fn publish_verified(report Str, artifact Str) Str {
    let staged = get("AAC1047_STAGED")
    if (staged.len() == 0 || staged == artifact) { return "ERROR os.stage\n" }
    if (write_text(staged.clone(), report) != 0) {
        delete(staged)
        return "ERROR os.stage\n"
    }
    if (replace_atomic(staged.clone(), artifact) != 0) {
        delete(staged)
        return "ERROR os.replace\n"
    }
    return "PUBLISHED core-i32-draft\n"
}

fn write_stage_report(report Str) int {
    let artifact = get("AAC1047_ARTIFACT")
    let output = get("AAC1047_OUTPUT")
    if (artifact.len() > 0 && report.len() >= 4 && report.slice(0, 4).clone() == "hir(") {
        return write_text(output, publish_verified(report, artifact))
    }
    return write_text(output, report)
}

fn main() int {
    var limit = 1000000
    let requested = to_int(get("AAC1047_STEPS"))
    is requested {
        Some(value) -> { limit = value }
        None -> {}
    }
    if (get("AAC1047_HIR") == "descriptor") {
        let report = admit_document(get("AAC1047_INPUT"), limit)
        return write_text(get("AAC1047_OUTPUT"), report)
    }
    return write_stage_report(project(limit))
}
