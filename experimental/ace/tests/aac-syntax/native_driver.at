use app.source_catalog.catalog_directory
use app.syntax_smoke.bucket_count_case
use app.syntax_smoke.byte_len_case
use app.syntax_smoke.decode_case
use app.syntax_smoke.decode_dbg_case
use app.syntax_smoke.decode_truncated_case
use app.syntax_smoke.edit_case
use app.syntax_smoke.edit_project_case
use app.syntax_smoke.firstsets_case
use app.syntax_smoke.hex_roundtrip_case
use app.syntax_smoke.identity_case
use app.syntax_smoke.lex_case
use app.syntax_smoke.parse_case
use app.syntax_smoke.project_case
use app.syntax_smoke.parse_byte_case
use app.syntax_smoke.raw_case
use app.syntax_smoke.scan_case
use std.conv.to_int
use std.env.get
use std.file.read_bytes
use std.file.read_text
use std.file.write_text

fn offset(key Str) int {
    let result = to_int(get(key))
    is result {
        Some(n) -> { return n }
        None -> {}
    }
    return -1
}

fn observe(case_name Str, profile Str, sample Str) Str {
    if (case_name == "decode") {
        return decode_case(profile)
    }
    if (case_name == "decode-truncated") {
        return decode_truncated_case(profile)
    }
    if (case_name == "hex-roundtrip") {
        return hex_roundtrip_case(profile)
    }
    if (case_name == "byte-length") {
        return byte_len_case(profile)
    }
    if (case_name == "decode-debug") {
        return decode_dbg_case(profile)
    }
    if (case_name == "parse") {
        return parse_case(profile, sample)
    }
    if (case_name == "project") {
        return project_case(profile, sample, offset("AAC1046_SOURCE_ID"), offset("AAC1046_ORIGIN_ID"))
    }
    if (case_name == "lex") {
        return lex_case(profile, sample)
    }
    if (case_name == "first-sets") {
        return firstsets_case(profile)
    }
    if (case_name == "scan") {
        return scan_case(profile)
    }
    if (case_name == "raw") {
        return raw_case(profile)
    }
    if (case_name == "bucket-count") {
        return bucket_count_case(profile)
    }
    if (case_name == "edit") {
        return edit_case(profile, sample, offset("AAC1046_START"), offset("AAC1046_END"), read_text(get("AAC1046_INSERT")))
    }
    if (case_name == "project-edit") {
        return edit_project_case(profile, sample, offset("AAC1046_START"), offset("AAC1046_END"), read_text(get("AAC1046_INSERT")), offset("AAC1046_SOURCE_ID"), offset("AAC1046_ORIGIN_ID"))
    }
    if (case_name == "identity") {
        return identity_case(sample, offset("AAC1046_START"))
    }
    return "UNKNOWN_CASE"
}

fn observe_byte_source(case_name Str, profile Str, path Str) Str {
    let bytes = read_bytes(path)
    is bytes {
        Some(src) -> {
            if (case_name == "parse-source-depth") {
                return parse_byte_case(profile, src, 12, 67108864)
            }
            if (case_name == "parse-source-work") {
                return parse_byte_case(profile, src, 1048576, 128)
            }
            return parse_byte_case(profile, src, 1048576, 67108864)
        }
        None -> {}
    }
    return "SOURCE_ERR READ"
}

fn main() int {
    let case_name = get("AAC1046_CASE")
    let profile = get("AAC1046_PROFILE")
    let input = get("AAC1046_INPUT")
    if (case_name == "catalog") {
        let report = catalog_directory(profile, get("AAC1046_PACKAGE"), get("AAC1046_PROJECT"), read_text(input))
        return write_text(get("AAC1046_OUTPUT"), report)
    }
    if (case_name == "parse-source" || case_name == "parse-source-depth" || case_name == "parse-source-work") {
        let report = observe_byte_source(case_name, profile, input)
        return write_text(get("AAC1046_OUTPUT"), report)
    }
    let sample = read_text(input)
    let report = observe(case_name, profile, sample)
    return write_text(get("AAC1046_OUTPUT"), report)
}
