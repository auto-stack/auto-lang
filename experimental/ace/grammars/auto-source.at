            pratt(of: "aggregates-ops", field: "value") {}
        }

        // ---- 脚本形态（entry-unit：顶层语句序列到 EOF；首语句必需——
        // 空/仅分隔符文件由投影按旧合同区分"expected fn"与 Ok(empty)；
        // 声明先行的 entry-order 检查在投影保真）----
        script-item(profiles: [entry-unit, host-console, closures, numeric, aggregates, auto, scheduler, auto-packages]) {
            stmt() {}
            list-nl { stmt() {} }
        }
        // ---- 配置文档行（PLAN-982 B-CONFIG-I E2）----
        //
        // 配置文档**不是**脚本：顶层是按源顺序的**文档行**，行的四种形态是
        //   - pair：`key: value`（值可以是表达式或节点值 `k: file("x") { … }`）；
        //   - node：`name`／`name "id"`／`name(args)`／`name id`，可带 `{ … }` 体；
        //   - 文档控制行：`var`／`if`／`for`（体中仍是文档行）。
        // 结构与 span 由 CST 承载（`cfg-*` 规则），投影层把行还原成文档候选；
        // **不做字符串扫描**。该面只由 config-document 前门消费。
        cfg-document-item(profiles: [config-document], expect: "a configuration document line") {
            cfg-line() {}
            list-nl { cfg-line() {} }
        }
        cfg-line(profiles: [config-document], expect: "a document line (`key: value`, a node, or a var/if/for line)") {
            alt { cfg-pair() {} }
            alt { cfg-node() {} }
            alt { cfg-var() {} }
            alt { cfg-if() {} }
            alt { cfg-for() {} }
            // JSON 形文档：整份文档就是一个对象字面量 `{ "k": v, ... }`
            // （真实 pac.at 语料存在这种平台侧清单，legacy config 同样接受）。
            alt { cfg-json-document() {} }
        }
        // JSON 形文档：`{ "k": v, ... }`，逗号分隔、允许尾逗号；条目值仍是
        // `cfg-pair-value`（表达式或带体节点值），因此与 `key: value` 行同语义。
        cfg-json-document(profiles: [config-document], expect: "a `{ \"k\": v, ... }` document object") {
            lbrace() {}
            opt { cfg-json-fields(field: "fields") {} }
            rbrace() {}
        }
        cfg-json-fields(profiles: [config-document]) {
            cfg-json-entry() {}
            many { cfg-json-entry-tail() {} }
            opt { comma() {} }
        }
        cfg-json-entry-tail(profiles: [config-document]) {
            comma() {}
            cfg-json-entry() {}
        }
        cfg-json-entry(profiles: [config-document]) {
            cfg-json-key(field: "key")
            colon(same-line: true)
            cfg-pair-value(field: "value")
        }
        // 文档键：标识符、字符串字面量，**以及保留字**（真实 pac.at 会把
        // `tag`／`type` 这类清单词当键用；键位置是文档语义、不是语句关键字）。
        // 982/CONFIG 的语料缺口（`static-unknown-node-content.pac.at`）。
        cfg-doc-key(profiles: [config-document]) {
            alt { ident(field: "key") {} }
            alt { str-lit(field: "key") {} }
            alt { r-tag(field: "key") {} }
            alt { type-kw(field: "key") {} }
        }
        cfg-json-key(profiles: [config-document]) {
            cfg-doc-key(field: "key")
        }
        // `key: value`／`key: node(…) { … }`（节点值**必须**带体：无体的
        // `k: f(…)` 是普通调用表达式，交给 expr 备选）。
        cfg-pair(profiles: [config-document], expect: "a `key: value` document pair") {
            cfg-doc-key(field: "key")
            colon(same-line: true)
            cfg-pair-value(field: "value")
        }
        cfg-pair-value(profiles: [config-document]) {
            // 块形对象值 `{ k: v … }`（换行分隔、无逗号）——真实 pac.at 的
            // 常见写法（`workspace: { front: "./source/front" }`）；JSON 逗号
            // 形走普通对象字面量表达式备选。
            alt { cfg-object-block() {} }
            // 带体节点值优先（`icf: file("linker/x.icf") { … }`）：它必须**带体**，
            // 否则无体的 `kernel: kernel_config` 会被吃成节点；节点备选失败
            // （没有体）时回退到表达式备选。
            alt { cfg-value-node() {} }
            alt { expr() {} }
        }
        // 块形对象值：`{ key: value … }`，条目按换行/`;` 分隔，值是
        // `cfg-pair-value`（因此可嵌套块形对象）。
        cfg-object-block(profiles: [config-document], expect: "a `{ key: value … }` object value") {
            lbrace() {}
            list-nl { cfg-pair() {} }
            rbrace() {}
        }
        cfg-value-node(profiles: [config-document], expect: "a node value with a body (`name(args) { … }`)") {
            cfg-node-head(field: "head")
            opt { cfg-node-tail(field: "tail") {} }
            cfg-node-body(field: "body")
        }
        cfg-node(profiles: [config-document], expect: "a document node (`name`, `name \"id\"`, `name(args)` or `name id`, optionally followed by `{ … }`)") {
            cfg-node-head(field: "head")
            opt { cfg-node-tail(field: "tail") {} }
            opt { cfg-node-body(field: "body") {} }
        }
        // 节点头：普通名与三个在 manifest 位被当节点名的保留字（旧 Config
        // 口径：`dep`/`pac`/`link` 在配置文件里是节点名，不是语言声明）。
        cfg-node-head(profiles: [config-document]) {
            alt { ident(field: "word") {} }
            alt { r-dep(field: "word") {} }
            alt { r-pac(field: "word") {} }
            alt { r-link(field: "word") {} }
        }
        cfg-node-tail(profiles: [config-document]) {
            alt { cfg-node-args(field: "args") {} }
            // 节点头里的模板实参：`lib ${name} {}` 经模板 desugar 后是
            // `lib __fstr("", name) {}` —— 名字后跟一个调用实参。
            alt { cfg-node-call(field: "call") {} }
            alt { cfg-node-id(field: "id") {} }
        }
        cfg-node-call(profiles: [config-document]) {
            ident(same-line: true, field: "word")
            lparen(same-line: true) {}
            opt { args(field: "args") {} }
            rparen() {}
        }
        // 节点头的 id 必须**同行**：否则 `z: mode` 的值会把下一行 `lib("a")`
        // 吃成 `mode` 的调用尾部（实测：resolve 报 "no function named lib"）。
        cfg-node-id(profiles: [config-document]) {
            alt { ident(same-line: true, field: "id") {} }
            alt { str-lit(same-line: true, field: "id") {} }
        }
        cfg-node-args(profiles: [config-document], expect: "a parenthesized argument list") {
            lparen(same-line: true) {}
            opt { args(field: "args") {} }
            rparen() {}
        }
        cfg-node-body(profiles: [config-document], expect: "a `{ … }` document node body") {
            lbrace(same-line: true) {}
            list-nl { cfg-line() {} }
            rbrace() {}
        }
        cfg-var(profiles: [config-document], expect: "a `var <name> = <expr>` document line") {
            var(field: "kw")
            ident(field: "name")
            opt { ann-ty(field: "ann") {} }
            assign() {}
            expr(field: "value")
        }
        cfg-if(profiles: [config-document], expect: "an `if <cond> { … } [else { … }]` document line") {
            if(field: "kw")
            if-cond(field: "cond")
            cfg-body(field: "then")
            cfg-else(repeat: "opt")
        }
        cfg-else(profiles: [config-document]) {
            else() {}
            cfg-body() {}
        }
        cfg-for(profiles: [config-document], expect: "a `for <name> in <expr> { … }` document line") {
            for(field: "kw")
            ident(field: "var")
            in(field: "in-kw")
            cfg-iter(field: "iter")
            cfg-body(field: "body")
        }
        // 迭代量：文档行里是普通值表达式，但**不能**把随后的 `{` 吃成 record
        // 构造（`for d in modules {` 里的 `modules {` 不是 ctor）。故迭代位只
        // 收裸名或括号表达式；更宽的表达式需要时用括号显式写。
        cfg-iter(profiles: [config-document]) {
            alt { ident(field: "word") {} }
            // 字面数组迭代源：`for d in ["a", "b"] { … }`（legacy 的字面展开形）。
            alt { array-lit(field: "elems") {} }
            alt { lparen(same-line: true) {} expr(field: "inner") rparen() {} }
        }
        cfg-body(profiles: [config-document], expect: "a `{ … }` document body") {
            lbrace(same-line: true) {}
            list-nl { cfg-line() {} }
            rbrace() {}
        }
        // ---- 语句 ----
        block { lbrace() {} list-nl { stmt() {} } rbrace() {} }
        stmt(recover: true) {
            alt { let-stmt() {} }
            // PLAN-962（L-15）：`let (a, b, ...) = expr`（聚合面，扁平名）。
            alt(profiles: [aggregates, auto, scheduler, auto-packages]) { let-destr-stmt() {} }
            // PLAN-962（T-08，L-07）：`let hold x as v { }`——hold 整局部形
            //（`let` 头拼写：stmt 列表分派按 FIRST 集提交，新头 token 的
            // 语句备选机制未定；裸 `hold` 拼写见 SD-01 待办）。
            alt(profiles: [aggregates, auto, scheduler, auto-packages]) { let-hold-stmt() {} }
            alt { var-stmt() {} }
            alt { assign-stmt() {} }
            alt(profiles: [record, record-instances, text-record, age-h0, age-component, text-record-instances, collections, closures, packages-modules, packages-ct, aggregates, auto, packages-aggregates, scheduler, packages-aggregates-ct, packages-aggregates-ct, packages-aggregates-ct, age-package, config-document, auto-packages]) { path-assign-stmt() {} }
            // PLAN-962（L-48）：索引赋值 `xs[i] = v`。PLAN-964：closures 面
            // 同样接受（共享对象单元格 `cell[k] = v` 动态键写）。
            alt(profiles: [aggregates, auto, closures, scheduler, auto-packages]) { index-assign-stmt() {} }
            // PLAN-1082（T-02，L-19/L-48）：place 链赋值/复合赋值——置于
            // path-assign/index-assign 之后，仅承接旧规则不匹配之形（字段×
            // 索引混合链、多级索引链、任意复合 op，含裸名 `a += 1`）。
            // closures 面不裁（共享单元格 `cell[k]=v` 旧形字节不动）。
            alt(profiles: [auto, auto-packages]) { place-assign-stmt() {} }
            alt(profiles: [auto, auto-packages]) { self-place-assign-stmt() {} }
            alt { return-stmt() {} }
            // PLAN-1081 (T-03)：嵌套 fn 项（auto 面）——语句位 `fn name(..) [ret] { body }`，
            // 投影为 Stmt::NestedFn（提升为模块函数表的 mangled 单元）。
            alt(profiles: [auto, auto-packages]) { nested-fn-stmt() {} }
            alt { if-stmt() {} }
            // PLAN-966（T-02）：语句级编译期构造（仅 packages-ct；`#` 引入，
            // 与项位 #in 同域同求值器；未选分支只 Text 阶段检查）。
            alt(profiles: [packages-ct, packages-aggregates-ct, packages-aggregates-ct]) { hash-if-stmt() {} }
            alt(profiles: [packages-ct, packages-aggregates-ct, packages-aggregates-ct]) { hash-for-stmt() {} }
            alt(profiles: [packages-ct, packages-aggregates-ct, packages-aggregates-ct]) { hash-is-stmt() {} }
            // PLAN-966（T-02）：宏调用语句 `#name(args...)`（旧 MacroCall 位）。
            alt(profiles: [packages-ct, packages-aggregates-ct, packages-aggregates-ct]) { hash-macro-stmt() {} }
            alt(profiles: [core]) { while-stmt() {} }
            // PLAN-1041：for-cond 语句分派补 packages-ct（规则本身已在面集内，
            // 公共 stdlib 输出循环需要普通 while 形循环）。PLAN-965：aggregates, auto
            // 面同表（生成器/控制效果用例的普通 while 形循环）。
            alt(profiles: [scalar, scalar-instances, scalar-ct, text, record, record-instances, text-record, age-h0, age-component, text-record-instances, entry-unit, host-console, scalar-modules, packages-modules, packages-ct, aggregates, auto, scheduler, packages-aggregates-ct, age-package, config-document, auto-packages]) { for-cond-stmt() {} }
            alt(profiles: [collections, closures, numeric, aggregates, auto, packages-aggregates, scheduler, packages-aggregates-ct, packages-aggregates-ct, auto-packages]) { for-in-stmt() {} }
            // PLAN-962：`for i in a..b / a..=b { }`（i32 计数循环）。
            alt(profiles: [aggregates, auto, scheduler, auto-packages]) { for-range-stmt() {} }
            // PLAN-946：packages-aggregates 面沿用 is-stmt（单模块 aggregates, auto
            // 面按 965 拆分走 agg-is-stmt，不在此列）。
            alt(profiles: [collections, closures, numeric, packages-aggregates, packages-aggregates-ct, packages-aggregates-ct]) { is-stmt() {} }
            alt(profiles: [aggregates, auto, scheduler, auto-packages]) { agg-is-stmt() {} }
            alt(profiles: [aggregates, auto, scheduler, auto-packages]) { try-stmt() {} }
            alt(profiles: [aggregates, auto, scheduler, auto-packages]) { yield-stmt() {} }
            alt { loop-stmt() {} }
            alt { break() {} }
            alt { continue() {} }
            // 表达式语句全 profile 解析（backtracking 需要），投影按
            // entry/collections 能力拒绝并保真旧 span（表达式整体 span）
            // PLAN-968: the go and reply statements (reserved-word heads).
            alt(profiles: [scheduler]) { go-stmt() {} }
            alt(profiles: [scheduler]) { reply-stmt() {} }
            alt(profiles: [auto, auto-packages]) { block() {} }
            alt { expr-stmt() {} }
        }
        let-stmt {
            let(field: "kw")
            ident(field: "name")
            opt { ann-ty(field: "ann") }
            assign() {}
            expr(field: "value")
        }
        // PLAN-1081 (T-03)：嵌套 fn 项（auto 面）。`fn-tail` 复用项位机器
        //（含 D-04 裸返回 = 推导标记）。
        nested-fn-stmt(profiles: [auto, auto-packages]) {
            fn(field: "kw")
            fn-tail(field: "item")
        }
        // PLAN-962（T-08，L-07）：`let hold x as v { }`（别名绑定，块末
        // 失效；≥旧引擎 MVP 等义——L-07 自注"无借用纪律"）。
        let-hold-stmt(profiles: [aggregates, auto, scheduler, auto-packages]) {
            let(field: "kw")
            r-hold(same-line: true) {}
            ident(field: "name")
            r-as(same-line: true) {}
            ident(field: "bind")
            block(field: "body")
        }
        // PLAN-962（L-15）：扁平 tuple 解构——绑定名逐位对应 0..n-1。
        let-destr-stmt(profiles: [aggregates, auto, scheduler, auto-packages]) {
            let(field: "kw")
            lparen(same-line: true) {}
            destr-names(field: "names")
            rparen() {}
            assign() {}
            expr(field: "value")
        }
        destr-names(profiles: [aggregates, auto, scheduler, auto-packages]) {
            ident(field: "head")
            many { destr-name-tail() {} }
        }
        destr-name-tail(profiles: [aggregates, auto, scheduler, auto-packages]) {
            comma() {}
            ident() {}
        }
        var-stmt {
            var(field: "kw")
            ident(field: "name")
            opt { ann-ty(field: "ann") }
            assign() {}
            expr(field: "value")
        }
        assign-stmt {
            ident(field: "name")
            assign() {}
            expr(field: "value")
        }
        // `a.b.c = v`（record 族；先于 expr-stmt 尝试，无 `=` 时回退）
        path-assign-stmt {
            ident(field: "name")
            many { path-seg() {} }
            assign() {}
            expr(field: "value")
        }
        path-seg {
            alt { dot() {} ident(field: "path") }
            alt(profiles: [auto, auto-packages]) { dot(same-line: true) int-lit(field: "path", same-line: true) }
            alt(profiles: [auto, auto-packages]) { dot(same-line: true) true-kw(field: "path", same-line: true) }
            alt(profiles: [auto, auto-packages]) { dot(same-line: true) false-kw(field: "path", same-line: true) }
        }
        // PLAN-962（L-48）：`xs[i] = v`——元素替换（list-set 语义，等价
        // `.set(i, v)`；旧引擎 SET_ELEM 同形）。PLAN-964：closures 面同样
        // 接受（共享对象单元格 `cell[k] = v` 动态键写）。
        index-assign-stmt(profiles: [aggregates, auto, closures, scheduler, auto-packages]) {
            ident(field: "name")
            lbracket(same-line: true) {}
            expr(field: "index")
            rbracket() {}
            assign() {}
            expr(field: "value")
        }
        // PLAN-1082（T-02）：place 链 `ident (.f | [e])* (op)= e`——统一
        // 字段/索引混合链写回与复合赋值（`+= -= *= /=`，两 token 序列，
        // 与 1072 刀B `+ =` 同形）。按声明序置于 path-assign/index-assign
        // 之后：纯字段链 `=` 与单索引 `=` 仍由旧规则先配（冻结面字节不
        // 变），本规则承接混合链/多级索引/复合 op。
        place-assign-stmt(profiles: [auto, auto-packages]) {
            ident(field: "name")
            many { place-step() {} }
            place-assign-op() {}
            expr(field: "value")
        }
        // PLAN-1083（auto 面）：隐式 self 字段写 `.f = v` / `.f (op)= v`——
        // 首字段经隐式 self 接收者，其余步骤与 place 链同构。
        self-place-assign-stmt(profiles: [auto, auto-packages]) {
            dot(same-line: false) {}
            ident(field: "field")
            many { place-step() {} }
            place-assign-op() {}
            expr(field: "value")
        }
        place-step(profiles: [auto, auto-packages]) {
            alt { dot(same-line: true) ident(field: "field") }
            alt { lbracket(same-line: true) expr(field: "index") rbracket() {} }
        }
        place-assign-op(profiles: [auto, auto-packages]) {
            alt { assign() {} }
            alt { plus-assign() {} }
            alt { minus-assign() {} }
            alt { star-assign() {} }
            alt { slash-assign() {} }
        }
        plus-assign(profiles: [auto, auto-packages]) { plus() {} assign() {} }
        minus-assign(profiles: [auto, auto-packages]) { minus() {} assign() {} }
        star-assign(profiles: [auto, auto-packages]) { star() {} assign() {} }
        slash-assign(profiles: [auto, auto-packages]) { slash() {} assign() {} }
        return-stmt {
            return(field: "kw")
            expr(field: "value")
        }
        if-stmt {
            if(field: "kw")
            if-cond(field: "cond")
            block(field: "then")
            else-block(repeat: "opt")
        }
        if-value(profiles: [auto, auto-packages]) {
            if(field: "kw")
            if-cond(field: "cond")
            block(field: "then")
            else() {}
            block(field: "else")
        }
        // PLAN-964：if 条件两种游走——组合面（collections/closures/
        // aggregates, auto）用 condition-expr，其余面用普通 expr。原实现两条规则
        // 顺序连排使聚合面同时要求两者（潜在 bug，962 语料无聚合面 if 未
        // 暴露）；拆成子规则 alt 按 profile 单选。
        if-cond {
            alt(profiles: [record, record-instances, text-record, age-h0, age-component, text-record-instances, collections, closures, aggregates, auto, scheduler, age-package, packages-modules, config-document, auto-packages]) { condition-expr() {} }
            alt(profiles: [core, scalar, scalar-instances, scalar-ct, text, entry-unit, host-console, scalar-modules, packages-ct, numeric, aggregates, auto, packages-aggregates, scheduler, packages-aggregates-ct, packages-aggregates-ct, packages-aggregates-ct, age-package, auto-packages]) { expr() {} }
        }
        else-block { else() {} block() {} }
        while-stmt(profiles: [core]) {
            while(field: "kw")
            expr(field: "cond")
            block(field: "body")
        }
        // 条件 for（wide 族；投影复用 While AST 形状）
        for-cond-stmt(profiles: [scalar, scalar-instances, scalar-ct, text, record, record-instances, text-record, age-h0, age-component, text-record-instances, entry-unit, host-console, scalar-modules, packages-modules, packages-ct, aggregates, auto, scheduler, packages-aggregates-ct, age-package, config-document, auto-packages]) {
            for(field: "kw")
            condition-expr(profiles: [record, record-instances, text-record, age-h0, age-component, text-record-instances, collections, closures, aggregates, auto, scheduler, age-package, packages-modules, config-document, auto-packages], field: "cond")
            expr(profiles: [core, scalar, scalar-instances, scalar-ct, text, entry-unit, host-console, scalar-modules, packages-ct, numeric, packages-aggregates, packages-aggregates-ct, packages-aggregates-ct, packages-aggregates-ct, age-package], field: "cond")
            block(field: "body")
        }
        // PLAN-928（T-03）：PLAN-864 `for x in <List 局部> { .. }`。
        for-in-stmt(profiles: [collections, closures, numeric, aggregates, auto, packages-aggregates, scheduler, packages-aggregates-ct, packages-aggregates-ct, auto-packages]) {
            for(field: "kw")
            ident(field: "var")
            in(field: "in")
            // PLAN-946: the packages-aggregates face iterates a plain List
            // local (the collections shape; condition-expr stays aggregates, auto).
            ident(profiles: [collections, closures, numeric, packages-aggregates, packages-aggregates-ct, packages-aggregates-ct], field: "iter")
            condition-expr(profiles: [aggregates, auto, scheduler, auto-packages], field: "iter")
            block(field: "body")
        }
        // PLAN-962：范围迭代（L-19）——`for i in a..b { }` / `a..=b`；解析
        // 为 Range 迭代形，resolve 脱糖 i32 计数循环（步进 1）。
        for-range-stmt(profiles: [aggregates, auto, scheduler, auto-packages]) {
            for(field: "kw")
            ident(field: "var")
            in(field: "in")
            range-iter(field: "iter")
