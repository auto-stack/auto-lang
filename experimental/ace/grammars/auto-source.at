            list { enum-arm() {} }
            rbrace() {}
        }
        enum-arm(profiles: [collections, aggregates, scheduler]) {
            alt { ident(field: "name") lparen() {} ann-ty(field: "payload") rparen() {} }
            alt { ident(field: "name") }
        }
        member {
            alt { field-member() {} }
            alt(profiles: [record, record-instances, text-record, age-h0, age-component, text-record-instances, collections, packages-modules, packages-ct, aggregates, packages-aggregates, scheduler, packages-aggregates-ct, packages-aggregates-ct, packages-aggregates-ct]) { static-method() {} }
            alt(profiles: [record, record-instances, text-record, age-h0, age-component, text-record-instances, collections, packages-modules, packages-ct, aggregates, packages-aggregates, scheduler, packages-aggregates-ct, packages-aggregates-ct, packages-aggregates-ct]) { view-method() {} }
