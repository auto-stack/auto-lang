        spec-arg-list(profiles: [record, record-instances, aggregates, scheduler]) { spec-arg() {} many { spec-arg-tail() {} } }
        spec-arg-tail(profiles: [record, record-instances, aggregates, scheduler]) { comma() {} spec-arg() {} }
        spec-arg(profiles: [record, record-instances, aggregates, scheduler]) {
