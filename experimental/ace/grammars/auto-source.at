            // 面同表（生成器/控制效果用例的普通 while 形循环）。
            alt(profiles: [scalar, scalar-instances, scalar-ct, text, record, record-instances, text-record, age-h0, age-component, text-record-instances, entry-unit, host-console, scalar-modules, packages-modules, packages-ct, aggregates, scheduler, packages-aggregates-ct]) { for-cond-stmt() {} }
            alt(profiles: [collections, closures, numeric, aggregates, packages-aggregates, scheduler, packages-aggregates-ct, packages-aggregates-ct]) { for-in-stmt() {} }
            // PLAN-962：`for i in a..b / a..=b { }`（i32 计数循环）。
            alt(profiles: [aggregates, scheduler]) { for-range-stmt() {} }
