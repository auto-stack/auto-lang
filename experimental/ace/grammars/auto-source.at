// auto-source — 七 profile 统一源码语法的共享 Atom 配置（PLAN-927）。
//
// 单一规则源 + `profiles` 能力清单：`compile_profile(src, name)` 裁剪出各
// profile 自己的语法程序（canonical bytes 不同 → GrammarId 隔离）。共享词法/
// 声明/表达式规则；历史合法/拒绝边界由门控与投影层能力表共同保留——不是
// 一份"全接收语法"配后端猜 profile。
//
// 裁剪族（与 SourceProfile 谓词一致，T-01 冻结）：
//   core        —— 仅 `+ * <`、while、无字面量文本面
//   wide        = [scalar text record text-record entry-unit host-console]
//                （surface_is_scalar_or_wider：全算子集、一元 -/!、条件 for）
//   textual     = [text text-record host-console]（is_text：str/Str/char、
//                文本方法 .to/.move）
//   recordal    = [record text-record]（is_record：type/方法/字段/ctor/路径）
//   entry-unit  —— 脚本形态/尾值表达式语句/void 结果位
//
// 诊断事实（stage/code/span/message 顺序）由 core 投影层从 CST 事实映射，
// 本文件只承载语法形状与身份；被裁剪 token 在该 profile 内为保留面。
grammar(name: "auto-source", revision: 3, newline: true, stmt-end: ["semi", "rbrace"], sep: ["semi"], sync: ["semi", "rbrace"]) {
    profiles(version: 1) {
        profile(name: "core") { }
        profile(name: "scalar") { }
        profile(name: "text") { }
        profile(name: "record") { }
        // PLAN-963（T-02）：记录有限模板面 —— record 全表面 + fn 类型参数
        // `<T>`/`<T has S>` + 类型位裸 ident。仅当调用方携
        // `ac.source.instances.scalar/v1` 能力且 profile 为 Record 时由统一
        // 前门以本 profile 裁剪编译；plain record 面逐字节不变。
        profile(name: "record-instances") { }
        // PLAN-963（T-02）：文本+记录有限模板面（text-record 全表面 + fn
        // `<T>`/`<T has S>`）。文本实参的泛型函数在此面实例化；plain
        // text-record 面逐字节不变。
        profile(name: "text-record-instances") { }
        profile(name: "text-record") { }
        // PLAN-982（B-CONFIG-I）：配置文档面（`auto.source.config-document.v1`）。
        // 本步 = text-record 全表面 + 脚本语句序列（顶层语句按源顺序进入**一个**
        // 顺序入口）；配置文档专属的顶层 `key: value` / `dep`/节点三形与
        // `if`/`for` 文档语句由 E2 在本面增量（其它 profile 的裁剪字节不变——
        // 新名字只出现在原本放行 text-record 的门控列表里）。
        profile(name: "config-document") { }
        // PLAN-979（T-H0-I）：AGE 最小 Node 面（`node <name> { view { text <expr> {} } }`）。
        // 该面 = text-record 全表面 + 领域节点声明；`node`/`view`/`text` 的
        // 结构名含义只由 `contextual` 表的槽位声明给出（词法面不被扩成
        // 保留字；`view` 沿用既有 r-view 保留字，普通 Auto 规则不变）。
        // 仅当调用方显式选择 AGE 领域包（`SourceProfile::AgeH0`）时由统一
        // 前门以本 profile 裁剪编译；plain text-record 面逐字节不变。
        profile(name: "age-h0") { }
        // PLAN-979（T-03）：AGE 组件面（`node { model … on … view … }`）。与 age-h0
        // 同源、不同裁剪：age-h0 的 H0 合同逐字节不变；组件语义只在本面出现。
        profile(name: "age-component") { }
        // PLAN-981（T-01，SOURCE 批）：AGE **多模块包面** —— packages-modules
        // 全表面（`pub fn`/`use <mod>.<item>`/多段路径/模块级 const、var）∪
        // AGE 组件面（`node { model … on … view … }`）。两族规则并不新增：
        // 本面只是把既有两族同时放行，好让"普通模块图 × AGE 领域"在**同一**
        // 共享前门里被解析，而不是逐模块拼接第二套解析器。
        // 仅 `SourceProfile::AgePackage` 由 AGE 包前门
        // （`ace_core::source::age_package::compile_age_package`）裁剪；其它
        // 每个 profile 的裁剪字节不变（gates 只多了一个未启用的名字）。
        profile(name: "age-package") { }
        profile(name: "entry-unit") { }
        profile(name: "host-console") { }
        // PLAN-928：集合/闭包两 profile（闭包 = 集合面 + lambda/函数类型/
        // 间接调用；集合面规则由 T-03 落全，此处先注册身份与共享面）。
        profile(name: "collections") { }
        profile(name: "closures") { }
        // PLAN-961：数值面（闭包面超集 + 宽/窄整数与浮点类型词、typed
        // 字面量（affix-num 复用）、& | ^ 位算、as 转换、.shl/.shr/.as/.to
        // 方法形移位与转换）。
        profile(name: "numeric") { }
        // PLAN-962：聚合面（numeric 全表面 + 组合数据结构：嵌套容器、
        // tuple/array 字面量、命名 ctor、解构、索引 place、range、
        // 模式扩面；union/tag/grid/Hold/Box 见 T-08 批）。冻结面裁剪
        // 字节恒等。
        profile(name: "aggregates") { }
        // PLAN-1078: the ordinary AV language face — an aggregates-surface
        // identity (first-batch semantics; no second parser). Only the
        // `ac-av/language-source-run-v1` recipe selects this trim.
        profile(name: "auto") { }
        // Ordinary Auto bodies in the shared package graph.
        profile(name: "auto-packages") { }
        // PLAN-968: scheduler face (aggregates full surface + task actor
        // declarations `task/on`, `await`/`go` prefix ops, the legacy `!`
        // effect marker and bare unit-result fns of the canonical task
        // sources). Only the scheduler front door selects this trim.
        profile(name: "scheduler") { }
        // PLAN-935（T-02）：标量有限模板面 —— scalar 全表面 + fn 类型参数
        // `<T>`（至多一个）+ 类型位裸 ident（= 声明类型变量）。仅当调用方
        // 携 `ac.source.instances.scalar/v1` 能力时由统一前门以本 profile
        // 裁剪编译（FRONT_CAPS_VERSION ac-source-front/2）；无能力仍走
        // plain scalar 裁剪 → `<T>`/裸 ident 原语法拒绝面不变。
        profile(name: "scalar-instances") { }
        profile(name: "scalar-modules") { }
        // PLAN-960（T-02）：完整模块包面 —— scalar-modules 全表面（pub fn/use/
        // 限定引用）+ text/record 表面（str/Str、type/字段/方法/ctor/路径）+
        // 模块级 const/var 项 + use 别名/重导出（as/pub use）+ 多段限定路径。
        // 仅当调用方携 `ac.source.modules.packages/v1` 能力时由模块前门以本
        // profile 裁剪编译；旧 scalar-modules 裁剪与 `scalar/v1` 面逐字节不变。
        profile(name: "packages-modules") { }
        // PLAN-1043（T-03）：packages-ct 面 —— packages-modules 全表面 +
        // 编译期命名空间上下文 `#in`（单结构式/块式；内部 is/if/for 继承
        // 编译期属性）+ 单行 use 符号表 + 公共必需实现声明 `pub spec fn`。
        // 仅当调用方携 `ac.source.cte.in/v1` 能力时由 packages 前门以本
        // profile 裁剪编译；无能力仍走 plain packages-modules 裁剪（逐字节
        // 不变——新规则全部只在本面门控）。
        profile(name: "packages-ct") { }
        // PLAN-946（T-02）：packages-aggregates 面 —— packages-modules 全表面
        // + 集合族最小语句面（for-in 迭代、is 分支）+ `?T` 可选类型位（参数/
        // 结果）+ `List<T>.member` 接收原子。std.list 公共算法（List 参数公共
        // 函数）的承载面；仅当调用方走 aggregates packages 前门（PLAN-962
        // `av.aggregates, auto/1` 准入）时以本 profile 裁剪编译；plain
        // packages-modules/packages-ct 裁剪逐字节不变。aggregates-only 扩面
        // （range-for、索引赋值、tuple、union、解构、grid、数组字面量）不在
        // 本面——保持语法级具名拒绝（最小面，PLAN-946 T-01 冻结表）。
        profile(name: "packages-aggregates") { }
        // PLAN-972（T-02）：packages-aggregates-ct 面（packages-aggregates
        // 全表面 + packages-ct 装配项 + 闭包类型注解/字面量）；装配
        // aggregates 线（std 装配标准库承载面）。声明序紧随
        // packages-aggregates。
        profile(name: "packages-aggregates-ct") { }
        // PLAN-936（T-04）：标量有限 CT 面 —— scalar-instances, scalar-ct 全表面 +
        // 编译期表达式原子 `#{ expr }`。仅当调用方携
        // `ac.source.cte.scalar/v1` 能力时由统一前门以本 profile 裁剪编译
        // （FRONT_CAPS_VERSION ac-source-front/3）；无能力仍走 plain 裁剪 →
        // `#` 非词法面 → 原语法拒绝面不变。
        profile(name: "scalar-ct") { }
    }
    tokens {
        ws(trivia: true) { charset: " \t\r\n" }
        line-comment(trivia: true) { line-comment: "//" }
        // PLAN-982（B-CONFIG-I E7）：配置文档的 `#` 行注释。真实 pac.at 语料里
        // `# ...` 是说明行（legacy config 也把它当注释）；只在 config-document
        // 面成立——其它面的 `#` 仍是注解/CT 引入符，逐字节不变。
        hash-comment(trivia: true, profiles: [config-document]) { line-comment: "#" }
        // 关键字（声明先于 ident：同长取声明序）
        fn { literal: "fn" }
        let { literal: "let" }
        var { literal: "var" }
        if { literal: "if" }
        else { literal: "else" }
        while { literal: "while" }
        loop { literal: "loop" }
        break { literal: "break" }
        continue { literal: "continue" }
        return { literal: "return" }
        true-kw { literal: "true" }
        false-kw { literal: "false" }
        for { literal: "for" }
        int-kw { literal: "int" }
        i32 { literal: "i32" }
        bool { literal: "bool" }
        // PLAN-961：数值类型关键字（仅 numeric 面规则引用；其余面裁剪后
        // 为保留字——同 for/enum 先例）。
        i8-kw(profiles: [numeric, aggregates, auto, scheduler, packages-aggregates-ct, auto-packages]) { literal: "i8" }
        u8-kw(profiles: [numeric, aggregates, auto, scheduler, packages-aggregates-ct, auto-packages]) { literal: "u8" }
        byte-kw(profiles: [numeric, aggregates, auto, scheduler, packages-aggregates-ct, auto-packages]) { literal: "byte" }
        uint-kw(profiles: [numeric, aggregates, auto, scheduler, packages-aggregates-ct, auto-packages]) { literal: "uint" }
        u32-kw(profiles: [numeric, aggregates, auto, scheduler, packages-aggregates-ct, auto-packages]) { literal: "u32" }
        i64-kw(profiles: [numeric, aggregates, auto, scheduler, packages-aggregates-ct, auto-packages]) { literal: "i64" }
        u64-kw(profiles: [numeric, aggregates, auto, scheduler, packages-aggregates-ct, auto-packages]) { literal: "u64" }
        float-kw(profiles: [numeric, aggregates, auto, scheduler, packages-aggregates-ct, age-package, auto-packages]) { literal: "float" }
        f32-kw(profiles: [numeric, aggregates, auto, scheduler, packages-aggregates-ct, age-package, auto-packages]) { literal: "f32" }
        double-kw(profiles: [numeric, aggregates, auto, scheduler, packages-aggregates-ct, auto-packages]) { literal: "double" }
        f64-kw(profiles: [numeric, aggregates, auto, scheduler, packages-aggregates-ct, auto-packages]) { literal: "f64" }
        type-kw { literal: "type" }
        // PLAN-104（007/031 真语料）：裸自闭合标签（闭集）——AGE 两面保留拼写，
        // 使 `spacer`/`divider`/`sep`/`outlet` 可作无 label/无体元素。用 keyword
        // token 而非 contextual name：后者在未知属性处会产生 slot hint 噪声
        // （979 unknown-attribute 诊断面实证）。
        spacer-tok(profiles: [age-component, age-package]) { literal: "spacer" }
        divider-tok(profiles: [age-component, age-package]) { literal: "divider" }
        sep-tok(profiles: [age-component, age-package]) { literal: "sep" }
        outlet-tok(profiles: [age-component, age-package]) { literal: "outlet" }
        static { literal: "static" }
        mut { literal: "mut" }
        enum { literal: "enum" }
        is { literal: "is" }
        in { literal: "in" }
        // 保留字：全语言面（旧 lexer RESERVED_KEYWORDS 镜像，含 927 七面不
        // 消费的 move/to；collections/closures 由 928 扩展引用）
        r-alias { literal: "alias" }
        r-as { literal: "as" }
        r-await { literal: "await" }
        r-catch { literal: "catch" }
        r-const { literal: "const" }
        r-copy { literal: "copy" }
        r-dep { literal: "dep" }
        r-ext { literal: "ext" }
        r-finally(profiles: [aggregates, auto, scheduler, auto-packages]) { literal: "finally" }
        r-go { literal: "go" }
        r-has { literal: "has" }
        r-hold { literal: "hold" }
        r-impl { literal: "impl" }
        r-link { literal: "link" }
        r-mod { literal: "mod" }
        r-move { literal: "move" }
        // PLAN-962：范围面（聚合）`..` / `..=`——仅迭代位（for-range）。
        dotdoteq(profiles: [aggregates, auto, scheduler, auto-packages]) { literal: "..=" }
        // PLAN-962（T-08，L-14）：grid 上下文关键字（聚合面——非聚合面 `grid`
        // 仍是普通标识符）。
        grid-kw(profiles: [aggregates, auto, scheduler, auto-packages]) { literal: "grid" }
        // PLAN-1043（T-03）：`..` 进 packages-ct 面（仅 in-range 编译期迭代
        // 位引用；其余 packages 位不引用 = 保留）。
        dotdot(profiles: [aggregates, auto, packages-ct, scheduler, packages-aggregates-ct, packages-aggregates-ct, auto-packages]) { literal: ".." }
        r-nil { literal: "nil" }
        r-null { literal: "null" }
        r-outlet { literal: "outlet" }
        r-pac { literal: "pac" }
        r-reply { literal: "reply" }
        r-routes { literal: "routes" }
        r-shared { literal: "shared" }
        r-spawn { literal: "spawn" }
        r-spec { literal: "spec" }
        r-super { literal: "super" }
        r-super2 { literal: "super2" }
        r-super3 { literal: "super3" }
        r-super4 { literal: "super4" }
        r-tag { literal: "tag" }
        r-take(profiles: [core, scalar, text, record, record-instances, text-record-instances, text-record, config-document, age-h0, age-component, age-package, entry-unit, host-console, collections, closures, numeric, aggregates, scheduler, scalar-instances, scalar-modules, packages-modules, packages-ct, packages-aggregates, packages-aggregates-ct, scalar-ct]) { literal: "take" }
        r-task { literal: "task" }
        r-to { literal: "to" }
        r-try { literal: "try" }
        r-union { literal: "union" }
        r-use { literal: "use" }
        // PLAN-1041：host-console/entry-unit 内联公共 stdlib 源（如 io 输出）
        // 也用 `pub fn` 拼写——单模块文件里 pub 是可见性 no-op，保持包面/内联
        // 单源同一拼写。
        r-pub(profiles: [scalar-modules, packages-modules, packages-ct, host-console, entry-unit, packages-aggregates, packages-aggregates-ct, packages-aggregates-ct, packages-aggregates-ct, age-package, text-record, config-document, auto-packages]) { literal: "pub" }
        // PLAN-981（G1）：`render-only` —— `shape2d` 的 `layer:` 冻结值（单个
        // 保留字 token，按字节最长匹配；普通标识符 `render` 不受影响——只在
        // 精确字节序 `render-only` 处命中）。仅 age-package 裁剪。
        r-render-only(profiles: [age-package]) { literal: "render-only" }
        r-view { literal: "view" }
        r-with { literal: "with" }
        r-yield { literal: "yield" }
        // 标点（最长匹配：双字符整体命中）
        lparen { literal: "(" }
        rparen { literal: ")" }
        lbrace { literal: "{" }
        rbrace { literal: "}" }
        comma { literal: "," }
        semi { literal: ";" }
        colon { literal: ":" }
        assign { literal: "=" }
        plus { literal: "+" }
        minus { literal: "-" }
        star { literal: "*" }
        slash { literal: "/" }
        percent { literal: "%" }
        lt { literal: "<" }
        gt { literal: ">" }
        le { literal: "<=" }
        ge { literal: ">=" }
        eq { literal: "==" }
        ne { literal: "!=" }
        andand { literal: "&&" }
        oror { literal: "||" }
        // PLAN-961：单字符位算符（最长匹配下 `&&`/`||` 不受影响；仅
        // numeric 面引用，其余面裁剪为保留）。
        amp(profiles: [numeric, aggregates, auto, scheduler, packages-aggregates-ct, auto-packages]) { literal: "&" }
        // PLAN-1080（T-03）：管道算子 `|>`（仅 auto 面引用；其余面裁剪后
        // `|>` 仍按 vbar+gt 两 token 词法，冻结面行为不变）。最长匹配使
        // `|` 单独出现仍落 vbar。
        pipegt(profiles: [auto, auto-packages]) { literal: "|>" }
        vbar(profiles: [numeric, aggregates, auto, scheduler, packages-aggregates-ct, auto-packages]) { literal: "|" }
        caret(profiles: [numeric, aggregates, auto, scheduler, packages-aggregates-ct, auto-packages]) { literal: "^" }
        tilde(profiles: [aggregates, auto, scheduler, auto-packages]) { literal: "~" }
        bang { literal: "!" }
        dotquestion(profiles: [aggregates, auto, scheduler, auto-packages]) { literal: ".?" }
        questionquestion(profiles: [aggregates, auto, scheduler, auto-packages]) { literal: "??" }
        dot { literal: "." }
        question { literal: "?" }
        arrow { literal: "->" }
        fat-arrow { literal: "=>" }
        // 旧 lexer 的完整标点面（含 927 语法不消费的 `[]`——规则不引用 =
        // error 叶，投影按旧使用位合同映射；不提前成词法错误）。
        lbracket { literal: "[" }
        rbracket { literal: "]" }
        // PLAN-936（T-04）：编译期表达式引入符 `#`（仅 scalar-ct 面规则
        // 引用；其余面不引用 = error 叶，投影按无能力语法错误合同映射）。
        hash { literal: "#" }
        // 文本字面量（所有 profile 都扫描成单 token；非 text 族不被规则引用
        // → error 叶 → 投影按旧 raw-token 合同映射"not part of"拒绝）
        str-lit { quote: "\"", escape: true }
        char-lit { quote: "'", escape: true }
        // 整数字面量先于带缀数字声明：同长 tie（纯数字）取声明序 → int-lit；
        // `1i32`/`0x10`/`1.5` 由最长匹配落到 affix-num（镜像旧 AffixedNum 单 token）
        int-lit { charset: "0-9" }
        affix-num { charset: "0-9", cont: "a-zA-Z0-9_." }
        // `/*` 开器：旧 lexer 产出 Raw BlockComment 后继续正常词法（块注释
        // 不在 profile 面）——这里用字面 token（非 trivia）复刻该形状
        block-open { literal: "/*" }
        // 标识符（最后声明：同长关键字号胜）
        ident { charset: "a-zA-Z_", cont: "a-zA-Z0-9_" }
    }
    // PLAN-979（T-H0-I）：槽位限定拼写的声明表（领域包资产，配置数据而非
    // 运行时硬编码）。同一拼写只在声明槽位有结构含义；`role` 是领域语义，
    // 换拼写（别名/隔离测试 Schema）不改角色。`widget` 是同一 `node` 角色的
    // 旧作者源兼容别名——是否接纳由调用方的兼容配置决定（关闭 = 受控拒绝），
    // 不自动回落旧引擎。
    contextual(version: 1) {
        name(age-node-head) { spelling: "node", token: "ident", role: "node", profiles: [age-h0, age-component, age-package] }
        name(age-widget-head) { spelling: "widget", token: "ident", role: "node", profiles: [age-h0, age-component, age-package] }
        name(age-view-head) { spelling: "view", token: "r-view", role: "view", profiles: [age-h0, age-component, age-package] }
        name(age-text-head) { spelling: "text", token: "ident", role: "text", profiles: [age-h0, age-component, age-package] }
        // PLAN-980 P3（981 回签 (a)）→ PLAN-1072 刀A：style 声明头开 age-component
        // ——惰性视图数据面（投影期字面量替换，981 (c)3 路径；不产 const/fn、
        // 不触发 981 三锁条件）。参数化/pub 仍包面专属（style-params 步骤门控）。
        name(style-head) { spelling: "style", token: "ident", role: "style", profiles: [age-component, age-package] }
        name(age-model-head) { spelling: "model", token: "ident", role: "model", profiles: [age-component, age-package] }
        name(age-on-head) { spelling: "on", token: "ident", role: "on", profiles: [age-component, age-package] }
        // PLAN-980（B-DIALECT-I 完整批）：widget 成员槽位的槽位限定拼写
