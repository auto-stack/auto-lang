            alt(profiles: [scalar, scalar-instances, scalar-ct, scalar-modules, text, record, record-instances, text-record, age-h0, age-component, text-record-instances, entry-unit, host-console, collections, closures, numeric, aggregates, scheduler, packages-aggregates-ct, packages-aggregates-ct, packages-aggregates-ct]) { minus() {} unary-expr(field: "operand", same-line: true) }
            alt(profiles: [scalar, scalar-instances, scalar-ct, scalar-modules, text, record, record-instances, text-record, age-h0, age-component, text-record-instances, entry-unit, host-console, collections, closures, numeric, aggregates, scheduler, packages-aggregates-ct, packages-aggregates-ct, packages-aggregates-ct]) { bang() {} unary-expr(field: "operand", same-line: true) }
            alt(profiles: [scalar, scalar-instances, scalar-modules, packages-modules, packages-ct, text, record, record-instances, text-record, age-h0, age-component, text-record-instances, entry-unit, host-console, collections, closures, numeric, aggregates, packages-aggregates, scheduler]) { minus() {} unary-expr(field: "operand", same-line: true) }
            alt(profiles: [scalar, scalar-instances, scalar-modules, packages-modules, packages-ct, text, record, record-instances, text-record, age-h0, age-component, text-record-instances, entry-unit, host-console, collections, closures, numeric, aggregates, packages-aggregates, scheduler]) { bang() {} unary-expr(field: "operand", same-line: true) }
            // PLAN-968: `await <expr>` / `go <expr>` prefix operators
