        op(binding: 7, assoc: "left") { of: "+" }
        op(binding: 7, assoc: "left") { of: "-" }
        op(binding: 8, assoc: "left") { of: "*" }
        op(binding: 8, assoc: "left") { of: "/" }
        op(binding: 8, assoc: "left") { of: "%" }
        postfix: "postfix-tail"
        group: ["(", ")"]
        call {
            open: "("
            close: ")"
            args: "args"
            same-line: true
            nl-free: true
        }
    }
    pratt(condition-ops, profiles: [record, record-instances, text-record, age-h0, age-component, text-record-instances, collections, closures]) {
        primary: "condition-unary"
        op(binding: 1, assoc: "left") { of: "||" }
        op(binding: 2, assoc: "left") { of: "&&" }
        op(binding: 3, assoc: "left") { of: "==" }
        op(binding: 3, assoc: "left") { of: "!=" }
        op(binding: 4, assoc: "left") { of: "<" }
        op(binding: 4, assoc: "left") { of: ">" }
        op(binding: 4, assoc: "left") { of: "<=" }
        op(binding: 4, assoc: "left") { of: ">=" }
        op(binding: 5, assoc: "left") { of: "+" }
        op(binding: 5, assoc: "left") { of: "-" }
        op(binding: 6, assoc: "left") { of: "*" }
        op(binding: 6, assoc: "left") { of: "/" }
        op(binding: 6, assoc: "left") { of: "%" }
        // PLAN-927：调用收尾后的点后缀续读（`f().len()`——KIND_POSTFIX）。
        postfix: "postfix-tail"
        group: ["(", ")"]
        call {
            open: "("
            close: ")"
            args: "args"
            same-line: true
            nl-free: true
        }

    }
    // PLAN-972（T-02）：装配 aggregates 线（packages-aggregates-ct）算符表
    //——wide-ops 超集 + 961 位算 & | ^（同层，混用需括号，沿 numeric/
    // aggregates 面冻结记录；`&`/`|`/`^` token 自 PLAN-961 起已在本面声明，
    // 此前无算符表引用——纯投影位缺口，S-06 hash 批修复）。
    pratt(packages-aggregates-ct-ops, profiles: [packages-aggregates-ct]) {
        primary: "unary-expr"
        op(binding: 1, assoc: "left") { of: "||" }
        op(binding: 2, assoc: "left") { of: "&&" }
        op(binding: 3, assoc: "left") { of: "==" }
        op(binding: 3, assoc: "left") { of: "!=" }
        op(binding: 4, assoc: "left") { of: "<" }
        op(binding: 4, assoc: "left") { of: ">" }
        op(binding: 4, assoc: "left") { of: "<=" }
        op(binding: 4, assoc: "left") { of: ">=" }
        op(binding: 5, assoc: "left") { of: "&" }
        op(binding: 5, assoc: "left") { of: "|" }
        op(binding: 5, assoc: "left") { of: "^" }
        op(binding: 6, assoc: "left") { of: "+" }
        op(binding: 6, assoc: "left") { of: "-" }
        op(binding: 7, assoc: "left") { of: "*" }
        op(binding: 7, assoc: "left") { of: "/" }
        op(binding: 7, assoc: "left") { of: "%" }
        postfix: "postfix-tail"
        group: ["(", ")"]
        call {
            open: "("
            close: ")"
            args: "args"
            same-line: true
            nl-free: true
        }
    }
    pratt(wide-ops, profiles: [scalar, scalar-instances, scalar-ct, text, record, record-instances, text-record, age-h0, age-component, text-record-instances, entry-unit, host-console, collections, closures, scalar-modules, packages-modules, packages-ct, packages-aggregates, packages-aggregates-ct, packages-aggregates-ct, packages-aggregates-ct]) {
        primary: "unary-expr"
        op(binding: 1, assoc: "left") { of: "||" }
        op(binding: 2, assoc: "left") { of: "&&" }
        op(binding: 3, assoc: "left") { of: "==" }
        op(binding: 3, assoc: "left") { of: "!=" }
        op(binding: 4, assoc: "left") { of: "<" }
        op(binding: 4, assoc: "left") { of: ">" }
        op(binding: 4, assoc: "left") { of: "<=" }
        op(binding: 4, assoc: "left") { of: ">=" }
        op(binding: 5, assoc: "left") { of: "+" }
        op(binding: 5, assoc: "left") { of: "-" }
        op(binding: 6, assoc: "left") { of: "*" }
        op(binding: 6, assoc: "left") { of: "/" }
        op(binding: 6, assoc: "left") { of: "%" }
        // PLAN-927：调用收尾后的点后缀续读（`f().len()`——KIND_POSTFIX）。
        postfix: "postfix-tail"
        group: ["(", ")"]
        call {
            open: "("
            close: ")"
            args: "args"
            same-line: true
            nl-free: true
        }

    }
    // PLAN-961：数值面算符表（wide-ops 超集 + 位算 & | ^（同层，混用需
    // 括号——冻结记录）。转换/移位均不入 pratt：pratt 算子右操作数只能
    // 是表达式（类型词 RHS 不支持），移位双 token 算符不支持且 `>>` 与
    // 嵌套泛型闭合冲突——`.as(T)`/`.to(T)`/`.shl(n)`/`.shr(n)` 方法形
    // 承载（后缀步 r-as/r-to 已门控 numeric；中缀 `as` 具名延后）。
    pratt(aggregates-ops, profiles: [aggregates, scheduler]) {
        primary: "unary-expr"
        op(binding: 1, assoc: "left") { of: "||" }
        op(binding: 2, assoc: "left") { of: "&&" }
        op(binding: 3, assoc: "right") { of: "??" }
        op(binding: 4, assoc: "left") { of: "==" }
        op(binding: 4, assoc: "left") { of: "!=" }
        op(binding: 5, assoc: "left") { of: "<" }
        op(binding: 5, assoc: "left") { of: ">" }
        op(binding: 5, assoc: "left") { of: "<=" }
        op(binding: 5, assoc: "left") { of: ">=" }
        op(binding: 6, assoc: "left") { of: "&" }
        op(binding: 6, assoc: "left") { of: "|" }
        op(binding: 6, assoc: "left") { of: "^" }
        op(binding: 7, assoc: "left") { of: "+" }
        op(binding: 7, assoc: "left") { of: "-" }
        op(binding: 8, assoc: "left") { of: "*" }
        op(binding: 8, assoc: "left") { of: "/" }
        op(binding: 8, assoc: "left") { of: "%" }
        postfix: "postfix-tail"
        group: ["(", ")"]
        call {
            open: "("
            close: ")"
            args: "args"
            same-line: true
            nl-free: true
        }
    }
    pratt(numeric-ops, profiles: [numeric]) {
        primary: "unary-expr"
        op(binding: 1, assoc: "left") { of: "||" }
        op(binding: 2, assoc: "left") { of: "&&" }
        op(binding: 3, assoc: "left") { of: "==" }
        op(binding: 3, assoc: "left") { of: "!=" }
        op(binding: 4, assoc: "left") { of: "<" }
        op(binding: 4, assoc: "left") { of: ">" }
        op(binding: 4, assoc: "left") { of: "<=" }
        op(binding: 4, assoc: "left") { of: ">=" }
        op(binding: 5, assoc: "left") { of: "&" }
        op(binding: 5, assoc: "left") { of: "|" }
        op(binding: 5, assoc: "left") { of: "^" }
        op(binding: 6, assoc: "left") { of: "+" }
        op(binding: 6, assoc: "left") { of: "-" }
        op(binding: 7, assoc: "left") { of: "*" }
        op(binding: 7, assoc: "left") { of: "/" }
        op(binding: 7, assoc: "left") { of: "%" }
        postfix: "postfix-tail"
        group: ["(", ")"]
        call {
            open: "("
            close: ")"
            args: "args"
            same-line: true
            nl-free: true
        }
    }
    // PLAN-1043（T-03）：#in 编译期条件/判别表达式（仅 packages-ct 面）。
    // 值域=标量事实（i32/bool，与 source-cte CtValue 对齐）；仅比较与逻辑
    // 算子（无算术/无括号分组/无调用——越域由绑定具名拒，不静默扩面）。
    pratt(in-ct-ops, profiles: [packages-ct, packages-aggregates-ct, packages-aggregates-ct]) {
        primary: "in-ct-unary"
        op(binding: 1, assoc: "left") { of: "||" }
        op(binding: 2, assoc: "left") { of: "&&" }
        op(binding: 3, assoc: "left") { of: "==" }
        op(binding: 3, assoc: "left") { of: "!=" }
        op(binding: 4, assoc: "left") { of: "<" }
        op(binding: 4, assoc: "left") { of: ">" }
        op(binding: 4, assoc: "left") { of: "<=" }
        op(binding: 4, assoc: "left") { of: ">=" }
    }
    outline {
        decl-rule: "fn-item"
        name-field: "name"
        params-field: "params"
    }
}
