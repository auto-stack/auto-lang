// auto-source — 七 profile 统一源码语法的共享 Atom 配置（PLAN-927）。
//
// 单一规则源 + `profiles` 能力清单：`compile_profile(src, name)` 裁剪出各
// profile 自己的语法程序（canonical bytes 不同 → GrammarId 隔离）。共享词法/
// 声明/表达式规则；历史合法/拒绝边界由门控与投影层能力表共同保留——不是
// 一份"全接收语法"配后端猜 profile。
//
// 裁剪族（与 SourceProfile 谓词一致，T-01 冻结）：
//   core        —— 仅 `+ * <`、while、无字面量文本面
//   wide        = [scalar text record text-record entry-unit host-console]
//                （surface_is_scalar_or_wider：全算子集、一元 -/!、条件 for）
//   textual     = [text text-record host-console]（is_text：str/Str/char、
//                文本方法 .to/.move）
//   recordal    = [record text-record]（is_record：type/方法/字段/ctor/路径）
//   entry-unit  —— 脚本形态/尾值表达式语句/void 结果位
//
// 诊断事实（stage/code/span/message 顺序）由 core 投影层从 CST 事实映射，
// 本文件只承载语法形状与身份；被裁剪 token 在该 profile 内为保留面。
grammar(name: "auto-source", revision: 2, newline: true, stmt-end: ["semi", "rbrace"], sep: ["semi"], sync: ["semi", "rbrace"]) {
    profiles(version: 1) {
        profile(name: "core") { }
        profile(name: "scalar") { }
        profile(name: "text") { }
        profile(name: "record") { }
        profile(name: "text-record") { }
        profile(name: "entry-unit") { }
        profile(name: "host-console") { }
        // PLAN-928：集合/闭包两 profile（闭包 = 集合面 + lambda/函数类型/
        // 间接调用；集合面规则由 T-03 落全，此处先注册身份与共享面）。
        profile(name: "collections") { }
        profile(name: "closures") { }
        // PLAN-935（T-02）：标量有限模板面 —— scalar 全表面 + fn 类型参数
        // `<T>`（至多一个）+ 类型位裸 ident（= 声明类型变量）。仅当调用方
        // 携 `ac.source.instances.scalar/v1` 能力时由统一前门以本 profile
        // 裁剪编译（FRONT_CAPS_VERSION ac-source-front/2）；无能力仍走
        // plain scalar 裁剪 → `<T>`/裸 ident 原语法拒绝面不变。
        profile(name: "scalar-instances") { }
        profile(name: "scalar-modules") { }
        // PLAN-936（T-04）：标量有限 CT 面 —— scalar-instances, scalar-ct 全表面 +
        // 编译期表达式原子 `#{ expr }`。仅当调用方携
        // `ac.source.cte.scalar/v1` 能力时由统一前门以本 profile 裁剪编译
        // （FRONT_CAPS_VERSION ac-source-front/3）；无能力仍走 plain 裁剪 →
        // `#` 非词法面 → 原语法拒绝面不变。
        profile(name: "scalar-ct") { }
    }
    tokens {
        ws(trivia: true) { charset: " \t\r\n" }
        line-comment(trivia: true) { line-comment: "//" }
        // 关键字（声明先于 ident：同长取声明序）
        fn { literal: "fn" }
        let { literal: "let" }
        var { literal: "var" }
        if { literal: "if" }
        else { literal: "else" }
        while { literal: "while" }
        loop { literal: "loop" }
        break { literal: "break" }
        continue { literal: "continue" }
        return { literal: "return" }
        true-kw { literal: "true" }
        false-kw { literal: "false" }
        for { literal: "for" }
        int-kw { literal: "int" }
        i32 { literal: "i32" }
        bool { literal: "bool" }
        type-kw { literal: "type" }
        static { literal: "static" }
        mut { literal: "mut" }
        enum { literal: "enum" }
        is { literal: "is" }
        in { literal: "in" }
        // 保留字：全语言面（旧 lexer RESERVED_KEYWORDS 镜像，含 927 七面不
        // 消费的 move/to；collections/closures 由 928 扩展引用）
        r-alias { literal: "alias" }
        r-as { literal: "as" }
        r-await { literal: "await" }
        r-catch { literal: "catch" }
        r-const { literal: "const" }
        r-copy { literal: "copy" }
        r-dep { literal: "dep" }
        r-ext { literal: "ext" }
        r-go { literal: "go" }
        r-has { literal: "has" }
        r-hold { literal: "hold" }
        r-impl { literal: "impl" }
        r-link { literal: "link" }
        r-mod { literal: "mod" }
        r-move { literal: "move" }
        r-nil { literal: "nil" }
        r-null { literal: "null" }
        r-outlet { literal: "outlet" }
        r-pac { literal: "pac" }
        r-reply { literal: "reply" }
        r-routes { literal: "routes" }
        r-shared { literal: "shared" }
        r-spawn { literal: "spawn" }
        r-spec { literal: "spec" }
        r-super { literal: "super" }
        r-super2 { literal: "super2" }
        r-super3 { literal: "super3" }
        r-super4 { literal: "super4" }
        r-tag { literal: "tag" }
        r-take { literal: "take" }
        r-task { literal: "task" }
        r-to { literal: "to" }
        r-try { literal: "try" }
        r-union { literal: "union" }
        r-use { literal: "use" }
        r-pub(profiles: [scalar-modules]) { literal: "pub" }
        r-view { literal: "view" }
        r-with { literal: "with" }
        r-yield { literal: "yield" }
        // 标点（最长匹配：双字符整体命中）
        lparen { literal: "(" }
        rparen { literal: ")" }
        lbrace { literal: "{" }
        rbrace { literal: "}" }
        comma { literal: "," }
        semi { literal: ";" }
        colon { literal: ":" }
        assign { literal: "=" }
        plus { literal: "+" }
        minus { literal: "-" }
        star { literal: "*" }
        slash { literal: "/" }
        percent { literal: "%" }
        lt { literal: "<" }
        gt { literal: ">" }
        le { literal: "<=" }
        ge { literal: ">=" }
        eq { literal: "==" }
        ne { literal: "!=" }
        andand { literal: "&&" }
        oror { literal: "||" }
        bang { literal: "!" }
        dot { literal: "." }
        question { literal: "?" }
        arrow { literal: "->" }
        fat-arrow { literal: "=>" }
        // 旧 lexer 的完整标点面（含 927 语法不消费的 `[]`——规则不引用 =
        // error 叶，投影按旧使用位合同映射；不提前成词法错误）。
        lbracket { literal: "[" }
        rbracket { literal: "]" }
        // PLAN-936（T-04）：编译期表达式引入符 `#`（仅 scalar-ct 面规则
        // 引用；其余面不引用 = error 叶，投影按无能力语法错误合同映射）。
        hash { literal: "#" }
        // 文本字面量（所有 profile 都扫描成单 token；非 text 族不被规则引用
        // → error 叶 → 投影按旧 raw-token 合同映射"not part of"拒绝）
        str-lit { quote: "\"", escape: true }
        char-lit { quote: "'", escape: true }
        // 整数字面量先于带缀数字声明：同长 tie（纯数字）取声明序 → int-lit；
        // `1i32`/`0x10`/`1.5` 由最长匹配落到 affix-num（镜像旧 AffixedNum 单 token）
        int-lit { charset: "0-9" }
        affix-num { charset: "0-9", cont: "a-zA-Z0-9_." }
        // `/*` 开器：旧 lexer 产出 Raw BlockComment 后继续正常词法（块注释
        // 不在 profile 面）——这里用字面 token（非 trivia）复刻该形状
        block-open { literal: "/*" }
        // 标识符（最后声明：同长关键字号胜）
        ident { charset: "a-zA-Z_", cont: "a-zA-Z0-9_" }
    }
    rules {
        // 旧 items() 顶层无行纪律（同线相邻声明合法，c05 差分）——ListPlain；
        // 块内语句序列才用 list-nl 的换行/`;` 分隔纪律。
        program { list { item() {} } }
        item {
            alt(profiles: [scalar-modules]) { public-fn() {} }
            alt { fn-item() {} }
            // PLAN-936（T-04）：scalar-ct 面的 type-item 仅字段形（member 规则中方法两 alt 仍门控在 record 族；元信息源声明，§5.2）。
            alt(profiles: [record, text-record, collections, scalar-ct]) { type-item() {} }
            alt(profiles: [scalar-modules]) { use-item() {} }
            alt(profiles: [record, text-record, collections]) { type-item() {} }
            alt(profiles: [collections]) { enum-item() {} }
            alt(profiles: [entry-unit, host-console, closures]) { script-item() {} }
        }
        // ---- 声明 ----
        fn-item(recover: true) {
            fn(field: "kw")
            fn-tail() {}
        }
        public-fn(profiles: [scalar-modules]) {
            r-pub() {}
            fn-item(field: "function")
        }
        use-item(profiles: [scalar-modules]) {
            r-use() {}
            ident(field: "module")
            dot() {}
            ident(field: "import")
        }
        qualified-name(profiles: [scalar-modules]) {
            ident(field: "module")
            dot(same-line: true)
            ident(field: "member")
        }
        // `fn` 之后的共享形状（自由函数与方法共用；receiver/owner 由投影
        // 从外层 type-item 上下文恢复）
        fn-tail {
            ident(field: "name")
            // PLAN-935（T-02）：有限类型参数 `<T>`（scalar-instances, scalar-ct 面步骤级
            // 门控——被裁 profile 该步缺席 = 形状与旧 fn-tail 逐字节等价）。
            opt(profiles: [scalar-instances, scalar-ct]) { type-params(field: "type_params") }
            lparen() {}
            params(repeat: "opt", field: "params")
            rparen() {}
            ret-ty(field: "ty")
            block(field: "body")
        }
        // PLAN-935（T-02）：类型参数表 `<T>` / `<T, U>`（投影/实例层先限一
        // 个；>1 由投影具名拒，语法形状此处一次到位）。
        // PLAN-935（T-03）：约束/const 形状（`<T has Bound>` / `<const N>`
        // ——词法上都是 ident ident）语法可识别、投影具名拒——不能当普通
        // token 跳过。
        type-params(profiles: [scalar-instances, scalar-ct]) {
            lt() {}
            type-param() {}
            many { type-param-tail() {} }
            gt() {}
        }
        type-param-tail(profiles: [scalar-instances, scalar-ct]) { comma() {} type-param() {} }
        type-param(profiles: [scalar-instances, scalar-ct]) {
            alt { ident(field: "name") opt(profiles: [scalar-instances, scalar-ct]) { type-param-constraint(field: "constraint") } }
            // `<const N>`（r-const 保留词形状；投影具名拒）
            alt { r-const(field: "const_kw") {} ident(field: "name") }
        }
        type-param-constraint(profiles: [scalar-instances, scalar-ct]) { r-has(field: "kw") {} ident(field: "bound") }
        params { param() {} many { param-tail() {} } }
        param-tail { comma() {} param() {} }
        param {
            // mode 词全域结构化（旧 parser 对非可用面在 expect_ident 上以
            // "keyword `X` cannot be used as a name" 拒绝——由投影层复刻）
            opt { r-move(field: "mode") }
            opt { mut(field: "mode") }
            ident(field: "name")
            ann-ty(field: "ty")
        }
        // 结果类型：int/i32/bool 全域；ident 面 = 文本词/记录名/void（投影
        // 按拼写+profile 分类与拒绝）；closures 面的 fn 型后备选（词备选在
        // `fn` token 上干净失败后回退到达）。
        ret-ty {
            alt { int-kw(field: "word") }
            alt { i32(field: "word") }
            alt { bool(field: "word") }
            alt(profiles: [collections, closures]) { generic-ty(field: "generic") }
            alt(profiles: [collections, closures]) { optional-ty(field: "optional") }
            alt(profiles: [text, text-record, host-console, record, entry-unit, collections, closures, scalar-instances, scalar-ct]) { ident(field: "word") }
            alt(profiles: [closures]) { fn-type(field: "fn") }
        }
        // 参数/字段/let 注解类型（入口 void 由 entry 面的拼写分类处理）
        ann-ty {
            alt { int-kw(field: "word") }
            alt { i32(field: "word") }
            alt { bool(field: "word") }
            alt(profiles: [collections, closures]) { generic-ty(field: "generic") }
            alt(profiles: [collections, closures]) { optional-ty(field: "optional") }
            alt(profiles: [text, text-record, host-console, record, entry-unit, collections, closures, scalar-instances, scalar-ct]) { ident(field: "word") }
            alt(profiles: [closures]) { fn-type(field: "fn") }
        }
        // PLAN-928（T-03）：参数化名义类型 `List<T>` / `Result<T, E>`（类型位；
        // 嵌套类型实参允许——`List<List<int>>` 域约束归 resolve）。
        generic-ty(profiles: [collections, closures]) {
            ident(field: "name")
            lt() {}
            type-args(field: "args")
            gt() {}
        }
        type-args(profiles: [collections, closures]) { type-arg() {} many { type-arg-tail() {} } }
        type-arg-tail(profiles: [collections, closures]) { comma() {} type-arg() {} }
        type-arg(profiles: [collections, closures]) {
            alt { int-kw(field: "word") }
            alt { i32(field: "word") }
            alt { bool(field: "word") }
            alt { generic-ty(field: "generic") }
            alt { optional-ty(field: "optional") }
            alt { ident(field: "word") }
        }
        // PLAN-928（T-03）：`?T` 可选糖（Option<T> 名义变体）。
        optional-ty(profiles: [collections, closures]) {
            question(field: "q")
            optional-inner(field: "inner")
        }
        optional-inner(profiles: [collections, closures]) {
            alt { int-kw(field: "word") }
            alt { i32(field: "word") }
            alt { bool(field: "word") }
            alt { generic-ty(field: "generic") }
            alt { ident(field: "word") }
        }
        // PLAN-928：闭包函数类型 `fn(T0, ...) -> R`（`->` 可省 = K 语料
        // 相邻结果拼写兼容形，仅闭包面）。可嵌套（参数/结果位可再为 fn 型；
        // fn 型在词后备选，`fn` token 使词备选干净失败回退）。
        fn-type(profiles: [closures]) {
            fn(field: "kw")
            lparen() {}
            fn-type-params(repeat: "opt", field: "params")
            rparen() {}
            opt { arrow(field: "arrow") }
            fn-type-result(field: "result")
        }
        fn-type-result(profiles: [closures]) {
            alt { int-kw(field: "word") }
            alt { i32(field: "word") }
            alt { bool(field: "word") }
            alt { ident(field: "word") }
            alt { fn-type(field: "fn") }
        }
        fn-type-params(profiles: [closures]) { fn-type-param() {} many { fn-type-param-tail() {} } }
        fn-type-param-tail(profiles: [closures]) { comma() {} fn-type-param() {} }
        fn-type-param(profiles: [closures]) {
            alt { int-kw(field: "word") }
            alt { i32(field: "word") }
            alt { bool(field: "word") }
            alt { ident(field: "word") }
            alt { fn-type(field: "fn") }
        }
        type-item(recover: true, profiles: [record, text-record, collections, scalar-ct]) {
            type-kw(field: "kw")
            ident(field: "name")
            lbrace() {}
            list-nl { member() {} }
            rbrace() {}
        }
        // PLAN-928（T-03）：PLAN-864 有限 enum——臂换行/`;` 分隔（list-nl 语义；
        // `,` 容忍由差分冻结），至多单载荷。
        enum-item(recover: true, profiles: [collections]) {
            enum(field: "kw")
            ident(field: "name")
            lbrace() {}
            list { enum-arm() {} }
            rbrace() {}
        }
        enum-arm(profiles: [collections]) {
            alt { ident(field: "name") lparen() {} ann-ty(field: "payload") rparen() {} }
            alt { ident(field: "name") }
        }
        member {
            alt { field-member() {} }
            alt(profiles: [record, text-record, collections]) { static-method() {} }
            alt(profiles: [record, text-record, collections]) { view-method() {} }
        }
        // 字段：`name` `:`? 类型（旧 parser 的可选冒号）
        field-member {
            ident(field: "name")
            opt { colon() {} }
            ann-ty(field: "ty")
        }
        static-method {
            static(field: "lead")
            fn(field: "kw")
            fn-tail() {}
        }
        view-method {
            fn(field: "kw")
            fn-tail() {}
        }
        // ---- 脚本形态（entry-unit：顶层语句序列到 EOF；首语句必需——
        // 空/仅分隔符文件由投影按旧合同区分"expected fn"与 Ok(empty)；
        // 声明先行的 entry-order 检查在投影保真）----
        script-item(profiles: [entry-unit, host-console, closures]) {
            stmt() {}
            list-nl { stmt() {} }
        }
        // ---- 语句 ----
        block { lbrace() {} list-nl { stmt() {} } rbrace() {} }
        stmt(recover: true) {
            alt { let-stmt() {} }
            alt { var-stmt() {} }
            alt { assign-stmt() {} }
            alt(profiles: [record, text-record, collections, closures]) { path-assign-stmt() {} }
            alt { return-stmt() {} }
            alt { if-stmt() {} }
            alt(profiles: [core]) { while-stmt() {} }
            alt(profiles: [scalar, scalar-instances, scalar-ct, text, record, text-record, entry-unit, host-console, scalar-modules]) { for-cond-stmt() {} }
            alt(profiles: [collections, closures]) { for-in-stmt() {} }
            alt(profiles: [collections, closures]) { is-stmt() {} }
            alt { loop-stmt() {} }
            alt { break() {} }
            alt { continue() {} }
            // 表达式语句全 profile 解析（backtracking 需要），投影按
            // entry/collections 能力拒绝并保真旧 span（表达式整体 span）
            alt { expr-stmt() {} }
        }
        let-stmt {
            let(field: "kw")
            ident(field: "name")
            opt { ann-ty(field: "ann") }
            assign() {}
            expr(field: "value")
        }
        var-stmt {
            var(field: "kw")
            ident(field: "name")
            opt { ann-ty(field: "ann") }
            assign() {}
            expr(field: "value")
        }
        assign-stmt {
            ident(field: "name")
            assign() {}
            expr(field: "value")
        }
        // `a.b.c = v`（record 族；先于 expr-stmt 尝试，无 `=` 时回退）
        path-assign-stmt {
            ident(field: "name")
            many { path-seg() {} }
            assign() {}
            expr(field: "value")
        }
        path-seg { dot() {} ident(field: "path") }
        return-stmt {
            return(field: "kw")
            expr(field: "value")
        }
        if-stmt {
            if(field: "kw")
            expr(field: "cond")
            block(field: "then")
            else-block(repeat: "opt")
        }
        else-block { else() {} block() {} }
        while-stmt(profiles: [core]) {
            while(field: "kw")
            expr(field: "cond")
            block(field: "body")
        }
        // 条件 for（wide 族；投影复用 While AST 形状）
        for-cond-stmt(profiles: [scalar, scalar-instances, scalar-ct, text, record, text-record, entry-unit, host-console, scalar-modules]) {
            for(field: "kw")
            expr(field: "cond")
            block(field: "body")
        }
        // PLAN-928（T-03）：PLAN-864 `for x in <List 局部> { .. }`。
        for-in-stmt(profiles: [collections, closures]) {
            for(field: "kw")
            ident(field: "var")
            in(field: "in")
            ident(field: "iter")
            block(field: "body")
        }
        // PLAN-928（T-03）：PLAN-864 `is <局部> { 臂 -> { .. } }`（穷尽分派；
        // 限定形式 `Enum.Name`；载荷绑定 `(v)`）。
        is-stmt(profiles: [collections, closures]) {
            is(field: "kw")
            ident(field: "scrutinee")
            lbrace() {}
            list { match-arm() {} }
            rbrace() {}
        }
        match-arm(profiles: [collections, closures]) {
            opt { arm-qual(field: "qual") }
            ident(field: "pattern")
            opt { arm-payload(field: "payload") }
            arrow() {}
            block(field: "body")
        }
        arm-qual(profiles: [collections, closures]) {
            ident(field: "qual")
            dot() {}
        }
        arm-payload(profiles: [collections, closures]) {
            lparen() {}
            ident(field: "binding")
            rparen() {}
        }
        loop-stmt {
            loop(field: "kw")
            block(field: "body")
        }
        expr-stmt {
            expr(field: "value")
        }
        // ---- 表达式 ----
        expr {
            alt(profiles: [core]) { pratt(of: "core-ops") }
            alt(profiles: [scalar, scalar-instances, scalar-ct, text, record, text-record, entry-unit, host-console, collections, closures, scalar-modules]) { pratt(of: "wide-ops") }
        }
        // 一元前缀（右结合）：字面量分支先行（`-5` 带符号折叠），`-x`/`!x`
        // 仅 wide 族；core 面经投影保真旧"仅字面量前一元减"拒绝
        unary-expr {
            alt { int-literal() {} }
            // 一元 -/! 操作数锚定同行（旧 anchored(Unary)；负号换行的 e19 拒绝）。
            alt(profiles: [scalar, scalar-instances, scalar-ct, text, record, text-record, entry-unit, host-console, collections, closures]) { minus() {} unary-expr(field: "operand", same-line: true) }
            alt(profiles: [scalar, scalar-instances, scalar-ct, text, record, text-record, entry-unit, host-console, collections, closures]) { bang() {} unary-expr(field: "operand", same-line: true) }
            alt(profiles: [scalar, scalar-instances, scalar-modules, text, record, text-record, entry-unit, host-console, collections, closures]) { minus() {} unary-expr(field: "operand", same-line: true) }
            alt(profiles: [scalar, scalar-instances, scalar-modules, text, record, text-record, entry-unit, host-console, collections, closures]) { bang() {} unary-expr(field: "operand", same-line: true) }
            alt { postfix-expr() {} }
        }
        postfix-expr {
            alt(profiles: [record, text-record, text, host-console, collections, closures]) { atom-expr() {} many { postfix-step() {} } }
            alt { atom-expr() {} }
        }
        // 点后缀链。record 族：`.name`（字段；调用经 pratt call 收尾）、
        // `.mut`；text 族：`.move`、`.to(str|Str)`（`.name(args)` 文本方法
        // = `.name` 步 + pratt call）。token 区分自然实现旧 record 臂对
        // `to` 的 carve-out。core/scalar/entry 无点后缀（`.` 在这些面由
        // 投影按旧 unsupported/语法错误合同映射）。
        postfix-step(profiles: [record, text-record, text, host-console, collections, closures]) {
            alt(profiles: [record, text-record, text, host-console, closures, collections]) { dot(same-line: true) ident(field: "member") }
            alt(profiles: [record, text-record, collections]) { dot(same-line: true) mut(field: "member") }
            alt(profiles: [text, text-record, host-console, collections, closures]) { dot(same-line: true) r-move(same-line: true, field: "member") }
            alt(profiles: [text, text-record, host-console]) { dot(same-line: true) r-to(same-line: true) lparen(same-line: true) ident(field: "word") rparen() {} }
        }
        // 调用收尾后的点后缀续读（pratt `postfix:` 引用）：`f().len()`、
        // `xs.get(0).name.len()`——primary 的 postfix-expr 只覆盖 atom 起始链，
        // 调用节点之后再接 `.name` 步由本规则承载（运行时包装 KIND_POSTFIX）。
        postfix-tail(profiles: [record, text-record, text, host-console, collections, closures]) {
            many { postfix-step() {} }
        }
        // PLAN-936（T-04）：编译期表达式 `#{ expr }` —— 单表达式 CT 需求
        // 原子（引入符与花括号须与表达式同行开始；体为恰一表达式）。
        hash-expr(profiles: [scalar-ct]) {
            hash(same-line: true)
            lbrace(same-line: true)
            expr(field: "expr")
            rbrace() {}
        }
        atom-expr {
            // HashExpr 原子先于其余原子形状（`#` 不与其余形状共享前缀）。
            alt(profiles: [scalar-ct]) { hash-expr() {} }
            alt(profiles: [scalar-modules]) { qualified-name() {} }
            alt(profiles: [collections, closures, record, text-record]) { ctor-expr() {} }
            // PLAN-928（T-03）：`List<T>.member` 接收位（尾随 dot 成员使提交
            // 条件镜像旧 generic_scan_commits——平衡 `<...>` 后随 `.`；普通
            // `a < b` 比较在本备选失败后回退 ident + 二元 `<`）。
            alt(profiles: [collections, closures]) { generic-atom() {} }
            // lambda 先于括号组备选：`( 参数 ) =>` 形状提交后不回退（ordered
            // choice 头部即 `( params ) =>` 匹配；普通 `( expr )` 组在 `=>`
            // 缺席时由 lambda 备选干净失败回退到括号组备选）。
            alt(profiles: [closures]) { lambda-expr() {} }
            alt(profiles: [record, text-record, collections]) { leading-dot() {} }
            alt { str-lit(field: "lit") }
            alt { char-lit(field: "lit") }
            alt { affix-num(field: "lit") }
            alt { true-kw(field: "kw") }
            alt { false-kw(field: "kw") }
            alt { ident() {} }
            alt { lparen() {} expr() {} rparen() {} }
        }
        // PLAN-928（T-03）：`List<T>.member` 原子（GenericType 接收位）。
        generic-atom(profiles: [collections, closures]) {
            ident(field: "name")
            lt() {}
            type-args(field: "args")
            gt() {}
            dot(same-line: true)
            ident(field: "member")
        }
        // PLAN-928（T-02 最小面，T-04 冻结诊断差分）：lambda 表达式——
        // `move? ( 参数? ) => 块 | 表达式`。块体复用语句纪律（list-nl）；
        // 参数无 mode 词（旧 closure_expr 合同：ident + 类型）。
        lambda-expr(profiles: [closures]) {
            opt { r-move(field: "mode") }
            lparen() {}
            lambda-params(repeat: "opt", field: "params")
            rparen() {}
            fat-arrow() {}
            lambda-body(field: "body")
        }
        lambda-body(profiles: [closures]) {
            alt { block(field: "block-body") }
            alt { expr(field: "expr-body") }
        }
        lambda-params(profiles: [closures]) { lambda-param() {} many { lambda-param-tail() {} } }
        lambda-param-tail(profiles: [closures]) { comma() {} lambda-param() {} }
        lambda-param(profiles: [closures]) {
            ident(field: "name")
            ann-ty(field: "ty")
        }
        // 隐式 self：`.name` / `.name(args)`（record 族）
        leading-dot(profiles: [record, text-record, collections]) {
            dot() {}
            ident(field: "member")
        }
        // 具名构造 `Ty { f: v, ... }`（record 族；`{` 须同行——括号内放宽
        // 由 bracket==0 语义承担，与旧 in_bracket||same_line 提交一致）。
        // `{` 是 cut 步：消费后 alt 失败不回退到后续备选——复刻旧 parser
        // 在 `ident {` 的无回溯提交（如 `if p { return 0 }` 拒绝在 return，
        // 而裸 ident（`total + 1`）在 `{` 不匹配时照常回退为普通名字）。
        ctor-expr(profiles: [record, text-record, collections, closures]) {
            ident(field: "ty")
            lbrace(same-line: true, cut: true) {}
            opt { ctor-fields() {} }
            rbrace() {}
        }
        ctor-fields {
            ctor-field() {}
            many { ctor-tail() {} }
        }
        ctor-tail {
            alt { comma() {} ctor-field() {} }
            alt { ctor-field() {} }
        }
        ctor-field {
            ident(field: "label")
            colon() {}
            expr(field: "value")
        }
        // 带符号字面量折叠（same-line 只绑定负号分支——无符号整数字面量可跨行起始，e19 的负号换行拒绝由负号分支保持）。
        int-literal {
            alt { minus() int-lit(field: "value", same-line: true) }
            alt { int-lit(field: "value") }
        }
        args { arg(repeat: "opt") many { arg-tail() {} } }
        arg-tail { comma() {} arg() {} }
        arg {
            alt { named-arg() {} }
            alt { expr() {} }
        }
        named-arg {
            ident(field: "label")
            colon() {}
            expr(field: "value")
        }
    }
    pratt(core-ops, profiles: [core]) {
        primary: "unary-expr"
        op(binding: 1, assoc: "left") { of: "<" }
        op(binding: 2, assoc: "left") { of: "+" }
        op(binding: 3, assoc: "left") { of: "*" }
        group: ["(", ")"]
        call {
            open: "("
            close: ")"
            args: "args"
            same-line: true
            nl-free: true
        }
    }
    pratt(wide-ops, profiles: [scalar, scalar-instances, scalar-ct, text, record, text-record, entry-unit, host-console, collections, closures, scalar-modules]) {
        primary: "unary-expr"
        op(binding: 1, assoc: "left") { of: "||" }
        op(binding: 2, assoc: "left") { of: "&&" }
        op(binding: 3, assoc: "left") { of: "==" }
        op(binding: 3, assoc: "left") { of: "!=" }
        op(binding: 4, assoc: "left") { of: "<" }
        op(binding: 4, assoc: "left") { of: ">" }
        op(binding: 4, assoc: "left") { of: "<=" }
        op(binding: 4, assoc: "left") { of: ">=" }
        op(binding: 5, assoc: "left") { of: "+" }
        op(binding: 5, assoc: "left") { of: "-" }
        op(binding: 6, assoc: "left") { of: "*" }
        op(binding: 6, assoc: "left") { of: "/" }
        op(binding: 6, assoc: "left") { of: "%" }
        // PLAN-927：调用收尾后的点后缀续读（`f().len()`——KIND_POSTFIX）。
        postfix: "postfix-tail"
        group: ["(", ")"]
        call {
            open: "("
            close: ")"
            args: "args"
            same-line: true
            nl-free: true
        }

    }
    outline {
        decl-rule: "fn-item"
        name-field: "name"
        params-field: "params"
    }
}
