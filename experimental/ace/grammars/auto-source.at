// auto-source — 七 profile 统一源码语法的共享 Atom 配置（PLAN-927）。
//
// 单一规则源 + `profiles` 能力清单：`compile_profile(src, name)` 裁剪出各
// profile 自己的语法程序（canonical bytes 不同 → GrammarId 隔离）。共享词法/
// 声明/表达式规则；历史合法/拒绝边界由门控与投影层能力表共同保留——不是
// 一份"全接收语法"配后端猜 profile。
//
// 裁剪族（与 SourceProfile 谓词一致，T-01 冻结）：
//   core        —— 仅 `+ * <`、while、无字面量文本面
//   wide        = [scalar text record text-record entry-unit host-console]
//                （surface_is_scalar_or_wider：全算子集、一元 -/!、条件 for）
//   textual     = [text text-record host-console]（is_text：str/Str/char、
//                文本方法 .to/.move）
//   recordal    = [record text-record]（is_record：type/方法/字段/ctor/路径）
//   entry-unit  —— 脚本形态/尾值表达式语句/void 结果位
//
// 诊断事实（stage/code/span/message 顺序）由 core 投影层从 CST 事实映射，
// 本文件只承载语法形状与身份；被裁剪 token 在该 profile 内为保留面。
grammar(name: "auto-source", revision: 1, newline: true, stmt-end: ["semi", "rbrace"], sep: ["semi"], sync: ["semi", "rbrace"]) {
    profiles(version: 1) {
        profile(name: "core") { }
        profile(name: "scalar") { }
        profile(name: "text") { }
        profile(name: "record") { }
        profile(name: "text-record") { }
        profile(name: "entry-unit") { }
        profile(name: "host-console") { }
    }
    tokens {
        ws(trivia: true) { charset: " \t\r\n" }
        line-comment(trivia: true) { line-comment: "//" }
        // 关键字（声明先于 ident：同长取声明序）
        fn { literal: "fn" }
        let { literal: "let" }
        var { literal: "var" }
        if { literal: "if" }
        else { literal: "else" }
        while { literal: "while" }
        loop { literal: "loop" }
        break { literal: "break" }
        continue { literal: "continue" }
        return { literal: "return" }
        true-kw { literal: "true" }
        false-kw { literal: "false" }
        for { literal: "for" }
        int-kw { literal: "int" }
        i32 { literal: "i32" }
        bool { literal: "bool" }
        type-kw { literal: "type" }
        static { literal: "static" }
        mut { literal: "mut" }
        enum { literal: "enum" }
        is { literal: "is" }
        in { literal: "in" }
        // 保留字：全语言面（旧 lexer RESERVED_KEYWORDS 镜像，含 927 七面不
        // 消费的 move/to；collections/closures 由 928 扩展引用）
        r-alias { literal: "alias" }
        r-as { literal: "as" }
        r-await { literal: "await" }
        r-catch { literal: "catch" }
        r-const { literal: "const" }
        r-copy { literal: "copy" }
        r-dep { literal: "dep" }
        r-ext { literal: "ext" }
        r-go { literal: "go" }
        r-has { literal: "has" }
        r-hold { literal: "hold" }
        r-impl { literal: "impl" }
        r-link { literal: "link" }
        r-mod { literal: "mod" }
        r-move { literal: "move" }
        r-nil { literal: "nil" }
        r-null { literal: "null" }
        r-outlet { literal: "outlet" }
        r-pac { literal: "pac" }
        r-reply { literal: "reply" }
        r-routes { literal: "routes" }
        r-shared { literal: "shared" }
        r-spawn { literal: "spawn" }
        r-spec { literal: "spec" }
        r-super { literal: "super" }
        r-super2 { literal: "super2" }
        r-super3 { literal: "super3" }
        r-super4 { literal: "super4" }
        r-tag { literal: "tag" }
        r-take { literal: "take" }
        r-task { literal: "task" }
        r-to { literal: "to" }
        r-try { literal: "try" }
        r-union { literal: "union" }
        r-use { literal: "use" }
        r-view { literal: "view" }
        r-with { literal: "with" }
        r-yield { literal: "yield" }
        // 标点（最长匹配：双字符整体命中）
        lparen { literal: "(" }
        rparen { literal: ")" }
        lbrace { literal: "{" }
        rbrace { literal: "}" }
        comma { literal: "," }
        semi { literal: ";" }
        colon { literal: ":" }
        assign { literal: "=" }
        plus { literal: "+" }
        minus { literal: "-" }
        star { literal: "*" }
        slash { literal: "/" }
        percent { literal: "%" }
        lt { literal: "<" }
        gt { literal: ">" }
        le { literal: "<=" }
        ge { literal: ">=" }
        eq { literal: "==" }
        ne { literal: "!=" }
        andand { literal: "&&" }
        oror { literal: "||" }
        bang { literal: "!" }
        dot { literal: "." }
        question { literal: "?" }
        arrow { literal: "->" }
        fat-arrow { literal: "=>" }
        // 文本字面量（所有 profile 都扫描成单 token；非 text 族不被规则引用
        // → error 叶 → 投影按旧 raw-token 合同映射"not part of"拒绝）
        str-lit { quote: "\"", escape: true }
        char-lit { quote: "'", escape: true }
        // 整数字面量先于带缀数字声明：同长 tie（纯数字）取声明序 → int-lit；
        // `1i32`/`0x10`/`1.5` 由最长匹配落到 affix-num（镜像旧 AffixedNum 单 token）
        int-lit { charset: "0-9" }
        affix-num { charset: "0-9", cont: "a-zA-Z0-9_." }
        // `/*` 开器：旧 lexer 产出 Raw BlockComment 后继续正常词法（块注释
        // 不在 profile 面）——这里用字面 token（非 trivia）复刻该形状
        block-open { literal: "/*" }
        // 标识符（最后声明：同长关键字号胜）
        ident { charset: "a-zA-Z_", cont: "a-zA-Z0-9_" }
    }
    rules {
        program { list-nl { item() {} } }
        item {
            alt { fn-item() {} }
            alt(profiles: [record, text-record]) { type-item() {} }
            alt(profiles: [entry-unit]) { script-item() {} }
        }
        // ---- 声明 ----
        fn-item(recover: true) {
            fn(field: "kw")
            fn-tail() {}
        }
        // `fn` 之后的共享形状（自由函数与方法共用；receiver/owner 由投影
        // 从外层 type-item 上下文恢复）
        fn-tail {
            ident(field: "name")
            lparen() {}
            params(repeat: "opt", field: "params")
            rparen() {}
            ret-ty(field: "ty")
            block(field: "body")
        }
        params { param() {} many { param-tail() {} } }
        param-tail { comma() {} param() {} }
        param {
            // mode 词：text 族 Reserved move + Kw mut；纯 record 面 Kw mut
            opt(profiles: [text, text-record, host-console]) { r-move(field: "mode") }
            opt(profiles: [text, text-record, host-console, record]) { mut(field: "mode") }
            ident(field: "name")
            ann-ty(field: "ty")
        }
        // 结果类型：int/i32/bool 全域；ident 面 = 文本词/记录名/void（投影
        // 按拼写+profile 分类与拒绝）
        ret-ty {
            alt { int-kw(field: "word") }
            alt { i32(field: "word") }
            alt { bool(field: "word") }
            alt(profiles: [text, text-record, host-console, record, entry-unit]) { ident(field: "word") }
        }
        // 参数/字段/let 注解类型（入口 void 由 entry 面的拼写分类处理）
        ann-ty {
            alt { int-kw(field: "word") }
            alt { i32(field: "word") }
            alt { bool(field: "word") }
            alt(profiles: [text, text-record, host-console, record, entry-unit]) { ident(field: "word") }
        }
        type-item(recover: true, profiles: [record, text-record]) {
            type-kw(field: "kw")
            ident(field: "name")
            lbrace() {}
            list-nl { member() {} }
            rbrace() {}
        }
        member {
            alt { field-member() {} }
            alt { static-method() {} }
            alt { view-method() {} }
        }
        // 字段：`name` `:`? 类型（旧 parser 的可选冒号）
        field-member {
            ident(field: "name")
            opt { colon() {} }
            ann-ty(field: "ty")
        }
        static-method {
            static(field: "lead")
            fn(field: "kw")
            fn-tail() {}
        }
        view-method {
            fn(field: "kw")
            fn-tail() {}
        }
        // ---- 脚本形态（entry-unit：顶层语句序列到 EOF；首语句必需——
        // 空/仅分隔符文件由投影按旧合同区分"expected fn"与 Ok(empty)；
        // 声明先行的 entry-order 检查在投影保真）----
        script-item(profiles: [entry-unit]) {
            stmt() {}
            list-nl { stmt() {} }
        }
        // ---- 语句 ----
        block { lbrace() {} list-nl { stmt() {} } rbrace() {} }
        stmt(recover: true) {
            alt { let-stmt() {} }
            alt { var-stmt() {} }
            alt { assign-stmt() {} }
            alt(profiles: [record, text-record]) { path-assign-stmt() {} }
            alt { return-stmt() {} }
            alt { if-stmt() {} }
            alt(profiles: [core]) { while-stmt() {} }
            alt(profiles: [scalar, text, record, text-record, entry-unit, host-console]) { for-cond-stmt() {} }
            alt { loop-stmt() {} }
            alt { break() {} }
            alt { continue() {} }
            // 表达式语句全 profile 解析（backtracking 需要），投影按
            // entry/collections 能力拒绝并保真旧 span（表达式整体 span）
            alt { expr-stmt() {} }
        }
        let-stmt {
            let(field: "kw")
            ident(field: "name")
            opt { ann-ty(field: "ann") }
            assign() {}
            expr(field: "value")
        }
        var-stmt {
            var(field: "kw")
            ident(field: "name")
            opt { ann-ty(field: "ann") }
            assign() {}
            expr(field: "value")
        }
        assign-stmt {
            ident(field: "name")
            assign() {}
            expr(field: "value")
        }
        // `a.b.c = v`（record 族；先于 expr-stmt 尝试，无 `=` 时回退）
        path-assign-stmt {
            ident(field: "name")
            many { path-seg() {} }
            assign() {}
            expr(field: "value")
        }
        path-seg { dot() {} ident(field: "path") }
        return-stmt {
            return(field: "kw")
            expr(field: "value")
        }
        if-stmt {
            if(field: "kw")
            expr(field: "cond")
            block(field: "then")
            else-block(repeat: "opt")
        }
        else-block { else() {} block() {} }
        while-stmt(profiles: [core]) {
            while(field: "kw")
            expr(field: "cond")
            block(field: "body")
        }
        // 条件 for（wide 族；投影复用 While AST 形状）
        for-cond-stmt(profiles: [scalar, text, record, text-record, entry-unit, host-console]) {
            for(field: "kw")
            expr(field: "cond")
            block(field: "body")
        }
        loop-stmt {
            loop(field: "kw")
            block(field: "body")
        }
        expr-stmt {
            expr(field: "value")
        }
        // ---- 表达式 ----
        expr {
            alt(profiles: [core]) { pratt(of: "core-ops") }
            alt(profiles: [scalar, text, record, text-record, entry-unit, host-console]) { pratt(of: "wide-ops") }
        }
        // 一元前缀（右结合）：字面量分支先行（`-5` 带符号折叠），`-x`/`!x`
        // 仅 wide 族；core 面经投影保真旧"仅字面量前一元减"拒绝
        unary-expr {
            alt { int-literal() {} }
            alt(profiles: [scalar, text, record, text-record, entry-unit, host-console]) { minus() {} unary-expr(field: "operand") }
            alt(profiles: [scalar, text, record, text-record, entry-unit, host-console]) { bang() {} unary-expr(field: "operand") }
            alt { postfix-expr() {} }
        }
        postfix-expr {
            alt(profiles: [record, text-record, text, host-console]) { atom-expr() {} many { postfix-step() {} } }
            alt { atom-expr() {} }
        }
        // 点后缀链。record 族：`.name`（字段；调用经 pratt call 收尾）、
        // `.mut`；text 族：`.move`、`.to(str|Str)`（`.name(args)` 文本方法
        // = `.name` 步 + pratt call）。token 区分自然实现旧 record 臂对
        // `to` 的 carve-out。core/scalar/entry 无点后缀（`.` 在这些面由
        // 投影按旧 unsupported/语法错误合同映射）。
        postfix-step(profiles: [record, text-record, text, host-console]) {
            alt(profiles: [record, text-record]) { dot(same-line: true) ident(field: "member") }
            alt(profiles: [record, text-record]) { dot(same-line: true) mut(field: "member") }
            alt(profiles: [text, text-record, host-console]) { dot(same-line: true) r-move(same-line: true, field: "member") }
            alt(profiles: [text, text-record, host-console]) { dot(same-line: true) r-to(same-line: true) lparen(same-line: true) ident(field: "word") rparen() {} }
        }
        atom-expr {
            alt(profiles: [record, text-record]) { leading-dot() {} }
            alt(profiles: [record, text-record]) { ctor-expr() {} }
            alt(profiles: [text, text-record, host-console]) { str-lit(field: "lit") }
            alt(profiles: [text, text-record, host-console]) { char-lit(field: "lit") }
            alt { true-kw(field: "kw") }
            alt { false-kw(field: "kw") }
            alt { ident() {} }
            alt { lparen() {} expr() {} rparen() {} }
        }
        // 隐式 self：`.name` / `.name(args)`（record 族）
        leading-dot(profiles: [record, text-record]) {
            dot() {}
            ident(field: "member")
        }
        // 具名构造 `Ty { f: v, ... }`（record 族；`{` 须同行——括号内放宽
        // 由 bracket==0 语义承担，与旧 in_bracket||same_line 提交一致）。
        // `{` 是 cut 步：消费后 alt 失败不回退到后续备选——复刻旧 parser
        // 在 `ident {` 的无回溯提交（如 `if p { return 0 }` 拒绝在 return，
        // 而裸 ident（`total + 1`）在 `{` 不匹配时照常回退为普通名字）。
        ctor-expr(profiles: [record, text-record]) {
            ident(field: "ty")
            lbrace(same-line: true, cut: true) {}
            opt { ctor-fields() {} }
            rbrace() {}
        }
        ctor-fields {
            ctor-field() {}
            many { ctor-tail() {} }
        }
        ctor-tail {
            alt { comma() {} ctor-field() {} }
            alt { ctor-field() {} }
        }
        ctor-field {
            ident(field: "label")
            colon() {}
            expr(field: "value")
        }
        // 带符号字面量折叠（负号与数字须同行）
        int-literal {
            minus(repeat: "opt", field: "sign")
            int-lit(field: "value", same-line: true)
        }
        args { arg(repeat: "opt") many { arg-tail() {} } }
        arg-tail { comma() {} arg() {} }
        arg {
            alt { named-arg() {} }
            alt { expr() {} }
        }
        named-arg {
            ident(field: "label")
            colon() {}
            expr(field: "value")
        }
    }
    pratt(core-ops, profiles: [core]) {
        primary: "unary-expr"
        op(binding: 1, assoc: "left") { of: "<" }
        op(binding: 2, assoc: "left") { of: "+" }
        op(binding: 3, assoc: "left") { of: "*" }
        group: ["(", ")"]
        call {
            open: "("
            close: ")"
            args: "args"
            same-line: true
            nl-free: true
        }
    }
    pratt(wide-ops, profiles: [scalar, text, record, text-record, entry-unit, host-console]) {
        primary: "unary-expr"
        op(binding: 1, assoc: "left") { of: "||" }
        op(binding: 2, assoc: "left") { of: "&&" }
        op(binding: 3, assoc: "left") { of: "==" }
        op(binding: 3, assoc: "left") { of: "!=" }
        op(binding: 4, assoc: "left") { of: "<" }
        op(binding: 4, assoc: "left") { of: ">" }
        op(binding: 4, assoc: "left") { of: "<=" }
        op(binding: 4, assoc: "left") { of: ">=" }
        op(binding: 5, assoc: "left") { of: "+" }
        op(binding: 5, assoc: "left") { of: "-" }
        op(binding: 6, assoc: "left") { of: "*" }
        op(binding: 6, assoc: "left") { of: "/" }
        op(binding: 6, assoc: "left") { of: "%" }
        group: ["(", ")"]
        call {
            open: "("
            close: ")"
            args: "args"
            same-line: true
            nl-free: true
        }
    }
    outline {
        decl-rule: "fn-item"
        name-field: "name"
        params-field: "params"
    }
}
