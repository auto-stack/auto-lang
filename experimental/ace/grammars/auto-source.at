        task-arm(profiles: [scheduler]) {
            task-pattern(field: "pattern")
            arrow() {}
            block(field: "body")
        }
        // `<int-lit>` | `<str-lit>` | `<ident> [<ann-ty>]` — the ident form
        // covers both the typed binding (`n int`) and the wildcard (`_`);
        // projection rejects a typed `_` and an untyped named binding.
        task-pattern(profiles: [scheduler]) {
