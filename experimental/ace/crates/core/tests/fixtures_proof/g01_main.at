// PLAN-008 g01/main base entry: the original four-shape pure scene as
// declarative modules (scene-2d profile, behavior=null play, no VM). Exact
// original geometry/colors/order (dbb4b75): red circle (-20,10) d30 a0.5,
// blue quad (0,0) 30 a0.5, green circle (25,-15) d24 a0.6, yellow quad
// (-45,-25) 12 a1.0 hidden. Zero characters, zero triggers, no camera, no
// Tick — visibility is a scene row, never an if-destroy.
use resources: red_alpha, blue_alpha, green_alpha, yellow_opaque
use shapes: Disc

node Main {
    view-2d {
        Disc red_disc {
            x: -20.0
            y: 10.0
            diameter: 30.0
            tint: resources.red_alpha
        }
        shape2d blue_quad {
            kind: quad
            position: (0.0, 0.0)
            size: (30.0, 30.0)
            material: resources.blue_alpha
        }
        Disc green_disc {
            x: 25.0
            y: -15.0
            diameter: 24.0
            tint: resources.green_alpha
        }
        shape2d yellow_quad {
            kind: quad
            position: (-45.0, -25.0)
            size: (12.0, 12.0)
            material: resources.yellow_opaque
            visible: false
        }
    }
}
