// PLAN-008 g01 Node content: programmatic resources. Exact original G01
// colors (dbb4b75 g01-main/scene.agscene, read-only baseline): alpha facts
// yellow 1.0 opaque, green 0.6, red/blue 0.5 (red drawn before blue in base
// declaration order -> blue is the blend top). Variants rebind materials/
// positions/order/visibility in their own entries. deep_green is the
// v-color rebinding target (the original recolor value). No external
// assets, no new formats, no licences; instances reference these symbols.
let red_alpha = material2d.color(0.9, 0.3, 0.2, 0.5)
let blue_alpha = material2d.color(0.2, 0.3, 0.9, 0.5)
let green_alpha = material2d.color(0.2, 0.8, 0.3, 0.6)
let yellow_opaque = material2d.color(0.95, 0.9, 0.1, 1.0)
let deep_green = material2d.color(0.1, 0.8, 0.2, 0.5)
