// text-i32-draft descriptor (PLAN-770).
//
// Machine-readable contract consumed by experimental/ac-core/src/descriptor.rs.
// Superset of scalar-i32-draft (PLAN-767): adds the str/Str/char value types,
// string/char literals, the text operation set (len/len_bytes/char_at/slice/
// concat/clone/to conversions/codepoint casts), parameter ownership modes
// (view default, explicit mut / move), explicit `drop` statements (program
// builder surface only) and `.move` call-site binding markers, all under the
// PLAN-774 data-resource contract (docs/reports/774-data-resource/). The root
// identity (schema/revision/profile) must be echoed by every accepted HIR
// document; unknown tags, fields, enum cases and capabilities are rejected.
// Documents under the core/scalar identities keep using their own schemas —
// the three profiles stay isolated by descriptor, verifier entry and
// canonical writer.

descriptor(schema: "auto.hir.text.draft", revision: 1u32, profile: "text-i32-draft") {

    enums {
        enum ExprKind { cases: [read_local, constant, binary, unary, logical, call, str_lit, char_lit, text_len, text_len_bytes, text_char_at, text_slice, text_concat, text_clone, text_to_owned, text_to_borrowed, char_to_codepoint, char_from_codepoint] }
        enum TypeKind { cases: [i32, bool, str, Str, char, function] }
        enum BinOp { cases: [add_i32, sub_i32, mul_i32, div_i32, rem_i32, lt_i32, le_i32, gt_i32, ge_i32, eq, ne] }
        enum UnaryOp { cases: [neg_i32, not_bool] }
        enum LogicOp { cases: [and, or] }
        enum OverflowPolicy { cases: [trap] }
        enum LocalRole { cases: [param, binding] }
        enum ParamModeKind { cases: [view, mut, move] }
        enum PlaceKind { cases: [local] }
        enum AccessKind { cases: [mutable, readonly] }
        enum EffectKind { cases: [observable, pure] }
    }

    nodes {
        node hir {
            slots: []
            fields { schema: Text; revision: U32; profile: Text; requires: TextList }
            inline: [module]
        }

        node module {
            slots: [Id]
            fields { path: Text }
            containers {
                types: [type]
                declarations: [function, intrinsic]
                bodies: [body]
            }
        }

        node type {
            slots: [Id, TypeKind]
            fields { params: TypeUseList; result: TypeUse }
        }

        node function {
            slots: [Id, TypeRef]
            fields { name: Text; body: BodyRef }
        }

        node intrinsic {
            slots: [Id, TypeRef]
            fields { symbol: Text; effect: EffectKind }
        }

        node body {
            slots: [Id]
            fields { owner: DefRef; entry: BlockRef }
            containers {
                locals: [local]
                places: [place]
                expressions: [expr]
                blocks: [block]
            }
        }

        node local {
            slots: [Id, TypeUse]
            fields { name: Text; role: LocalRole; index: U32; mutable: Bool; mode: ParamModeKind }
        }

        node place {
            slots: [Id, PlaceKind]
            fields { local: LocalRef; type: TypeUse; access: AccessKind }
        }

        node expr {
            slots: [Id, ExprKind]
            fields {
                type: TypeUse
                local: LocalRef
                value: I32
                text: Text
                scalar: U32
                op: BinOp
                overflow: OverflowPolicy
                lhs: ExprRef
                rhs: ExprRef
                operand: ExprRef
                index: ExprRef
                start: ExprRef
                end: ExprRef
                callee: DefRef
                eval_args: ExprRefList
                bindings: BindingList
            }
        }

        node block {
            slots: [Id]
            statements: [let, return, if, loop, assign, break, continue, drop]
        }

        node let { fields { local: LocalRef; value: ExprRef } }
        node return { fields { value: ExprRef } }
        node if { fields { cond: ExprRef; then: BlockRef; else: BlockRef } }
        node loop { fields { id: LoopDecl; body: BlockRef } }
        node assign { fields { place: PlaceRef; value: ExprRef } }
        node break { fields { target: LoopRef } }
        node continue { fields { target: LoopRef } }
        node drop { fields { local: LocalRef } }
    }

    branches {
        branch(key: "hir") { require: [schema, revision, profile] }
        branch(key: "type.i32") { forbid: [params, result] }
        branch(key: "type.bool") { forbid: [params, result] }
        branch(key: "type.str") { forbid: [params, result] }
        branch(key: "type.Str") { forbid: [params, result] }
        branch(key: "type.char") { forbid: [params, result] }
        branch(key: "type.function") { require: [params, result] }
        branch(key: "function") { require: [name, body]; forbid: [symbol, effect] }
        branch(key: "intrinsic") { require: [symbol, effect]; forbid: [name, body] }
        branch(key: "body") { require: [owner, entry] }
        branch(key: "local.param") { require: [name, role, index]; forbid: [mutable] }
        branch(key: "local.binding") { require: [name, role]; forbid: [index, mode] }
        branch(key: "place.local") { require: [local, type, access] }
        branch(key: "expr.read_local") {
            require: [type, local]
            forbid: [value, text, scalar, op, overflow, lhs, rhs, operand, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.constant") {
            require: [type, value]
            forbid: [local, text, scalar, op, overflow, lhs, rhs, operand, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.binary:add_i32") {
            require: [type, op, overflow, lhs, rhs]
            forbid: [local, value, text, scalar, operand, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.binary:sub_i32") {
            require: [type, op, overflow, lhs, rhs]
            forbid: [local, value, text, scalar, operand, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.binary:mul_i32") {
            require: [type, op, overflow, lhs, rhs]
            forbid: [local, value, text, scalar, operand, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.binary:div_i32") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, text, scalar, operand, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.binary:rem_i32") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, text, scalar, operand, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.binary:lt_i32") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, text, scalar, operand, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.binary:le_i32") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, text, scalar, operand, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.binary:gt_i32") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, text, scalar, operand, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.binary:ge_i32") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, text, scalar, operand, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.binary:eq") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, text, scalar, operand, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.binary:ne") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, text, scalar, operand, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.unary") {
            require: [type, op, operand]
            forbid: [local, value, text, scalar, overflow, lhs, rhs, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.logical") {
            require: [type, op, lhs, rhs]
            forbid: [overflow, local, value, text, scalar, operand, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.call") {
            require: [type, callee, eval_args, bindings]
            forbid: [local, value, text, scalar, op, overflow, lhs, rhs, operand, index, start, end]
        }
        branch(key: "expr.str_lit") {
            require: [type, text]
            forbid: [local, value, scalar, op, overflow, lhs, rhs, operand, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.char_lit") {
            require: [type, scalar]
            forbid: [local, value, text, op, overflow, lhs, rhs, operand, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.text_len") {
            require: [type, operand]
            forbid: [local, value, text, scalar, op, overflow, lhs, rhs, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.text_len_bytes") {
            require: [type, operand]
            forbid: [local, value, text, scalar, op, overflow, lhs, rhs, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.text_char_at") {
            require: [type, operand, index]
            forbid: [local, value, text, scalar, op, overflow, lhs, rhs, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.text_slice") {
            require: [type, operand, start, end]
            forbid: [local, value, text, scalar, op, overflow, lhs, rhs, index, callee, eval_args, bindings]
        }
        branch(key: "expr.text_concat") {
            require: [type, lhs, rhs]
            forbid: [local, value, text, scalar, op, overflow, operand, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.text_clone") {
            require: [type, operand]
            forbid: [local, value, text, scalar, op, overflow, lhs, rhs, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.text_to_owned") {
            require: [type, operand]
            forbid: [local, value, text, scalar, op, overflow, lhs, rhs, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.text_to_borrowed") {
            require: [type, operand]
            forbid: [local, value, text, scalar, op, overflow, lhs, rhs, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.char_to_codepoint") {
            require: [type, operand]
            forbid: [local, value, text, scalar, op, overflow, lhs, rhs, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "expr.char_from_codepoint") {
            require: [type, operand]
            forbid: [local, value, text, scalar, op, overflow, lhs, rhs, index, start, end, callee, eval_args, bindings]
        }
        branch(key: "let") { require: [local, value] }
        branch(key: "return") { require: [value] }
        branch(key: "if") { require: [cond, then] }
        branch(key: "loop") { require: [id, body] }
        branch(key: "assign") { require: [place, value] }
        branch(key: "break") { require: [target] }
        branch(key: "continue") { require: [target] }
        branch(key: "drop") { require: [local] }
    }
}
