/// EchoTool — the simplest possible Tool, for testing the agent tool-calling loop.
///
/// Design: `pub type has Tool` with four required methods.  The a2r generator
/// (plan 373 G2 fix) emits a real `impl Tool for EchoTool` (not a synthetic
/// `ToolTrait`), and `~Result` methods become `async fn`.  No hand-edits needed
/// after transpile.

use wire: JsonValue
use error: ToolError

pub type EchoTool has Tool {
    pub fn name() str {
        return "echo"
    }

    pub fn description() str {
        return "Echo the input text back.  Useful for testing the tool-calling plumbing."
    }

    pub fn parameters() JsonValue {
        return json.parse(
            "{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]}"
        )
    }

    pub fn execute(args JsonValue) ~Result<str, ToolError> {
        let text = args.get("text").as_string()
        if text.is_empty() {
            return Err(ToolError.Args("missing 'text' argument"))
        }
        return Ok(f"ECHO: ${text}")
    }
}
