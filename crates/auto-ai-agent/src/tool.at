/// The [Tool] spec and [ToolRegistry].
///
/// Apps register concrete tools (file IO, shell, search, ...) and the
/// [agent.Agent] exposes them to the model as callable functions. A
/// [role_def.Role] can restrict which tools are visible via allowed_tools().
///
/// Auto port of crates/auto-ai-agent/src/tool.rs (auto-ai v0.4.0).
///
/// Adaptations:
/// - `Arc<dyn Tool>` → `Arc(Tool)` (Auto `spec` is dynamically dispatched).
/// - `async fn execute` → `fn execute ~...` (plan 013 async decision).
/// - ToolRegistry stores a parallel `names List<str>` because Auto's VM Map
///   has no iteration API (plan 013 gotcha B5). Fields are `pub` (B12).

use.rust std::sync::Arc
use.rust std::pin::Pin
use.rust std::future::Future
use.rust async_trait

use wire: ToolDefinition, JsonValue
use error: ToolError

// ═══════════════════════════════════════════════════════════════════════════
// Tool spec
// ═══════════════════════════════════════════════════════════════════════════

/// A callable tool the agent can hand to the LLM.
///
/// Implementors supply the metadata the model sees (name/description/
/// parameters) and an async execute.
pub spec Tool {
    /// Tool name (must be unique within a registry).
    fn name() str

    /// Human/LLM-facing description — the model uses this to decide whether to
    /// call the tool.
    fn description() str

    /// JSON-Schema fragment describing the tool's `input` object.
    fn parameters() JsonValue {
        // json.parse returns serde_json::Value directly (not a Result), so no
        // .unwrap() — a2r rendered `json.parse(...).unwrap()` which fails (Value
        // has no unwrap).
        return json.parse("{\"type\":\"object\",\"properties\":{}}")
    }

    /// Run the tool with the model-supplied arguments, returning a string
    /// result that is fed back to the model.
    fn execute(args JsonValue) ~Result<str, ToolError>
}

/// Convert a [Tool] into the Layer-2 [ToolDefinition] the client sends.
//
// Takes `Arc<Tool>` (→ Arc<Box<dyn Tool>>) because that's what
// ToolRegistry.filter / .get yield; a2r renders the spec `Tool` param as owned
// `Box<dyn Tool>`, and moving out of an Arc isn't allowed.
pub fn tool_to_definition(tool Arc<Tool>) ToolDefinition {
    return ToolDefinition.new(tool.name(), tool.description(), tool.parameters())
}

// ═══════════════════════════════════════════════════════════════════════════
// ToolRegistry
// ═══════════════════════════════════════════════════════════════════════════

/// Registry of tools keyed by name.
///
/// Stores tools as `Arc<Tool>` (Auto spec → a2r renders `Arc<Box<dyn Tool>>`).
/// The Arc matches the Rust original's `Arc<dyn Tool>` for shared ownership
/// across agents / workflow steps. Carries a parallel `names List<str>` for
/// iteration (Auto VM Map has no keys()/entries()).
#[derive(Clone, Debug)]
pub type ToolRegistry {
    tools Map<str, Arc<Tool>>
    names List<str>
}

ext ToolRegistry {
    pub static fn new() ToolRegistry {
        return ToolRegistry(tools: Map.new(), names: [])
    }

    /// Register a tool from an Arc (overwrites an existing tool with the same
    /// name). Single insertion path so `names` stays in sync.
    pub mut fn register_shared(tool Arc<Tool>) void {
        let n = tool.name()
        if self.tools.contains(n) == false {
            self.names.push(n.to_string())
        }
        self.tools.set(n, tool)
    }

    /// Look up a tool by name.
    pub fn get(name str) ?Arc<Tool> {
        // self.tools.get(name) returns Option<&Arc<...>>; destructure + .clone()
        // to yield an owned Arc. (a2r rendered the prior `Some(self.tools.get())`
        // as `Some(Option<&Arc>)` and direct map.get as `[key as usize]`.)
        is self.tools.get(name) {
            Some(t) -> return Some(t.clone()),
            None -> return None
        }
    }

    /// All registered tool names.
    pub fn names() List<str> {
        return self.names
    }

    /// Number of registered tools.
    pub fn len() uint {
        return self.names.len() as uint
    }

    pub fn is_empty() bool {
        return self.names.len() == 0
    }

    /// All tools whose name is in `filter`. If `filter` is empty, returns all
    /// tools (matches the Role allowed_tools() "empty = all" rule).
    pub fn filter(filter List<str>) List<Arc<Tool>> {
        var out List<Arc<Tool>> = []
        if filter.len() == 0 {
            for n in self.names.clone() {
                is self.tools.get(n.as_str()) {
                    Some(t) -> out.push(t.clone()),
                    None -> {}
                }
            }
            return out
        }
        for n in filter {
            is self.tools.get(n.as_str()) {
                Some(t) -> out.push(t.clone()),
                None -> {}
            }
        }
        return out
    }

    /// Run a tool by name, returning its string output.
    pub fn execute(name str, args JsonValue) ~Result<str, ToolError> {
        is self.get(name) {
            Some(tool) -> return tool.execute(args).await,
            None -> return Err(ToolError.Exec(f"tool not found: ${name}"))
        }
    }

    /// Run a tool by name; on error return a human-readable "[tool error: …]"
    /// string instead of propagating (mirrors Rust's `format!("[tool error: {}]")`
    /// fallback so the loop keeps going and the model sees the failure).
    ///
    /// Exists as a ToolRegistry METHOD (not a free fn taking ToolRegistry by
    /// value) because a2r clones struct args at call sites and ToolRegistry
    /// (holding Arc<Box<dyn Tool>>) is not Clone.
    pub fn exec_or_msg(name str, args JsonValue) ~str {
        is self.execute(name, args).await {
            Ok(out) -> return out,
            Err(e) -> return f"[tool error: ${e.message()}]"
        }
    }
}
