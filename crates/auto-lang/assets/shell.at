// 桌面 shell pack（特权 .at App —— 宿主进程内编译装载，不进 examples/ui）。
// R1/R8 首落：shell 组件本身是 AutoUI App。根声明 `widget Desktop`
// （Design 25 §4.1 谱系；463 的 DesktopShell 于 472 T4 改名，全仓仅本文件
// 一处引用）。
//
// 双向接缝（463 T1 §2/§3 定案；Plan 472 T3 formalize 为投影协议 v1，
// Plan 478 T3 升版 v1.1，Plan 479 T4 升版 v1.2，Plan 486 升版 v1.3，
// Plan 487 M4 升版 v1.4，Plan 505 B2 升版 v1.5——合同
// schema/projection-protocol-v1.md——字段表/指纹门控/动词词表）：
//   出：`__desktop_cmd`（候选 B 命令总线 —— 宿主每周期读+清；记录
//       "verb\targ"，多条以 "\n" 连接。词表：launch/close/focus/layout/
//       summon/workspace/workspace_next/activate + v1.1 增量
//       workspace_add/workspace_close/send_to + v1.2 增量
//       notify/notes_toggle/notes_clear/notes_dismiss + v1.3 增量
//       focus_native/close_native——arg 直传条目 wid "N<slot>"，宿主侧
//       剥 N 前缀取 slot id + v1.4 增量
//       open_settings（齿轮）/set_dock_position/set_dock_enabled——
//       后两者由 settings.at 面板发出，本文件只发 open_settings）+
//       PLAN-526 增量 win_min（dock 右键菜单最小化）/ shutdown（电源键
//       确认退出，无参）
//   入：`__wm_wins`（宿主注入 {wid,title,focused,workspace,app,icon} Obj
//       数组，跨分区全集，dock 运行窗列表源；v1.3 native 槽位条目为五字段
//       {wid:"N<slot>",title,native,icon,focused}——workspace/app 不适用
//       省略，native=="1" 分支走 title 文本按钮 + native 动词；v1.5 增
//       `pager` 旗标 "1"/""——本窗属其分区缩略前 4，native/mru 条目恒空串）
//       `__wm_workspaces`（{id,name,current,label} Obj 数组，分区切换条
//       源；label = 1 基人读标签，v1.1——当前分区高亮消费 current；v1.5
//       增 `more` 溢出标签 "+N"（分区窗数 >4 时，缺省空串）——pager
//       截断消费（505 B2/债 P497-1））
//       `__wm_mru`（v1.1：当前分区 MRU 序 Obj 数组；switcher 专用合同面，
//       dock 不消费）
//       `__wm_running`（",id1,id2," 运行中 app 集合派生串，pinned 运行
//       指示条件消费——.at 无法跨列表聚合，宿主派生保持 I9 单一事实）
//       `__wm_meta`（"layout\tfocused_wid"，布局按钮态）
//       `__wm_notes`（v1.2：通知历史 {id,kind,msg,at} Obj 数组；合同面，
//       dock 不直接消费）
//       `__wm_notes_unread`（v1.2：未读计数串；铃铛 badge 条件消费——
//       缺省空串不出 badge）
// dock 数据级配置（协议 v1 §6）：storage 键 shell.dock.pinned / position /
// enabled，缺席回退 pack 默认（bottom / 启用 / 固定 calculator+todo+notes）。
// position/enabled 由 Init 读入；pinned 由宿主读键并解析 {id,icon} 注入
// （图标源 = 注册表，I9）。auto-os-config settings 写手 = shell-track M4；
// v1 由外部预置键（AUTO_VM_STORAGE_FILE 指向预写 JSON）。
// 消费者唯一：宿主 renderer 的 DesktopBus 双排空点（462/463 update 壳层）。
// launcher overlay 槽：SummonLauncher 召唤（464），本文件只发事件。
widget Desktop {
    msg {
        SummonLauncher,
        LayoutFree, LayoutGrid, LayoutStack,
        WinFocus(str), WinClose(str), WinMin(str),
        ActivateApp(str), SetWorkspace(str), WorkspaceNext,
        WorkspaceAdd, WorkspaceClose(str),
        NotificationToggle,
        NativeFocus(str), NativeClose(str),
        OpenSettingsPanel,
        // PLAN-526 T18：分区切换面板开合（触发 icon；热键切换由宿主
        // 直写 switcher_open 并计时收起）。
        SwitcherToggle,
        // PLAN-526 T8：dock 条目右键菜单（win_menu 态门控 popover 内容
        // 切换——hover 缩略 / 菜单二态；条目聚焦/最小化/关闭三动作）。
        WinMenu(str),
        // PLAN-526 T11：电源键（shutdown 确认面板三态）。
        ShutdownRequest, ShutdownCancel, ShutdownConfirm,
        // Plan 497 G5：dock/pager hover 预览（shell 内部 UI 态，非总线动词）。
        HoverWin(str), HoverEnd, HoverWs(str), HoverWsEnd
    }

    model {
        var __desktop_cmd str = ""
        var __wm_wins = []
        var __wm_workspaces = []
        var __wm_running str = ""
        var __wm_meta str = ""
        var __wm_fp str = ""
        var __wm_notes = []            // 协议 v1.2 合同面（dock 不直接消费）
        var __wm_notes_unread str = "" // 协议 v1.2：未读串（badge 条件消费）
        // __dock_pinned = 宿主注入 {id,icon} Obj 数组（storage shell.dock.pinned
        // 覆盖 > pack 默认三枚；icon 宿主自注册表解析——.at 无注册表访问权）。
        var __dock_pinned = []
        var __dock_position str = "bottom"
        var __dock_enabled str = "1"
        // Plan 505 B1：任务栏边线类（宿主投影——top→border-b / bottom→
        // border-t；容器/注册件的 if 样式表达式在实机装配层不稳，边线类
        // 改数据驱动拼接（"grid grid-cols-" + n 先例形态））。
        var __dock_border str = "border-t"
        // Plan 497 G1：dock 时钟（HH:MM 本地）。宿主 ServiceTick 帧泵注入
        // （分钟变化才写——稳态零重建）；本地 tick 非驱动事实投影，不进
        // 指纹门控组（协议字段表外注记，零协议改动）。
        var __wm_clock str = ""
        // Plan 497 G5：hover 预览态（shell 自有 UI 态——非 __wm_ 宿主注入
        // 域）。dock_hover = 预览中窗口 wid；ws_hover = 预览中分区 id。
        var dock_hover str = ""
        var ws_hover str = ""
        // PLAN-526 T8：右键菜单态（命中条目 wid；hover 复用同一 popover
        // 容器——open 条件或合，内容按本态切换缩略/菜单）。
        var win_menu str = ""
        // PLAN-526 T11：关机确认面板态（"1" = 待确认）。
        var shutdown_ask str = ""
        // PLAN-526 T18：分区切换预览面板态（"1" = 开；热键切换时宿主
        // 置位 + switcher_until 计时自动收起）。
        var switcher_open str = ""
    }

    view {
        col {
            // Plan 505 B1（债 P487-3 清偿）：任务栏单份承载——原 top/bottom 双
            // 分支 ~150 行重复收敛为参数化单份：位置由容器 flex-col-reverse
            // 数据级翻转承载（子序 [taskbar, spacer] 反转即 [spacer,
            // taskbar]——iced 臂 col_reverse 412 已有；Vue 轨同 class 原生），
            // 任务栏边线随位置 border-b/border-t。
            style: if .__dock_position == "top" {
                "w-full h-full"
            } else {
                "w-full h-full flex-col-reverse"
            }
            if .__dock_enabled == "1" {
                taskbar {
                    // PLAN-526 T7：bg-card/95——与虚拟窗标题栏同 alpha 口径
                    // （518 G6 off 档 0.95；原不透明 bg-card 实测与窗带异色）。
                    style: "h-14 w-full flex items-center gap-2 px-2 bg-card/95 " + .__dock_border

                    // Plan 503：launcher 召唤钮。
                    // PLAN-526 T17：全任务栏 icon 统一 start 规格——容器
                    // h-10 w-10、字标本体 text-lg、底色全透明（三轮反馈：
                    // start 也不保留 accent 底），hover = 语义前景 10% 透明
                    // （深色主题变亮/浅色主题变暗，Win11 形态）。start 字形
                    // lucide 化（layout-grid）——文字 ⊞ 与矢量 icon 的字形
                    // 视觉尺寸差即三轮反馈"icon 本体大小不一致"根因。
                    button (icon: "layout-grid") {
                        onclick: .SummonLauncher
                        style: "h-10 w-10 px-0 text-lg rounded-xl bg-transparent text-foreground hover:bg-foreground/10"
                    }
                    // Plan 503：dock 图标格 48px rounded-xl(stella 签名)。
                    // Plan 518 G3：格常驻透明(hover 才出格,rounded-xl 保留),
                    // 运行指示改贴底宽条(原侧位 4px 圆点可感知性弱,形态实机定)。
                    // PLAN-526 T9：外框统一 h-10 w-10。
                    for p in .__dock_pinned {
                        col {
                            style: "items-center"
                            button (icon: p.icon) {
                                onclick: .ActivateApp(p.id)
                                style: "h-10 w-10 px-0 text-lg rounded-xl bg-transparent text-foreground hover:bg-foreground/10"
                            }
                            if .__wm_running.contains("," + p.id + ",") {
                                div { style: "h-1 w-6 rounded-full bg-primary mt-0.5" }
                            }
                        }
                    }
                    for w in .__wm_wins {
                        row {
                            style: "items-center gap-1"
                            // v1.3：native 条目（native=="1"）——title 文本
                            // 按钮（无注册表图标，title 即身份）+ native 动词；
                            // App 条目走既有图标按钮路径。
                            // PLAN-526 T8：× 内嵌钮退役（Q5c）——右键菜单
                            // 承接关闭（popover 与 hover 缩略同容器，win_menu
                            // 态切换内容）。
                            if w.native == "1" {
                                mouse-area {
                                    popover (open: .win_menu == w.wid, placement: "top", ondismiss: .HoverEnd, class: "p-1 border rounded bg-card") {
                                        button (text: w.title) {
                                            onclick: .NativeFocus(w.wid)
                                            oncontextmenu.prevent: .WinMenu(w.wid)
                                            style: "h-10 max-w-32 truncate px-2 text-sm rounded-xl bg-transparent text-foreground hover:bg-foreground/10"
                                        }
                                        col {
                                            style: "w-36 gap-1"
                                            button "聚焦" {
                                                onclick: .NativeFocus(w.wid)
                                                style: "h-8 px-2 text-sm rounded-md bg-transparent text-foreground hover:bg-primary/10 text-left"
                                            }
                                            button "关闭" {
                                                onclick: .NativeClose(w.wid)
                                                style: "h-8 px-2 text-sm rounded-md bg-transparent text-error hover:bg-primary/10 text-left"
                                            }
                                        }
                                    }
                                }
                            } else {
                                // Plan 503：激活窗 2px accent 竖条(stella 激活态
                                // 范式)。Plan 518 G3：格底常驻 accent(bg-primary/15)
                                // 撤除——格 hover 才出底,accent 只留激活竖条。
                                if w.focused == "1" {
                                    div { style: "w-0.5 h-5 rounded-full bg-primary" }
                                }
                                // Plan 497 G5：条目 hover 预览（422 popover
                                // 先例，widget 锚=条目按钮；内容=真缩略，
                                // miss 由渲染臂 fallback icon 兜底）。
                                // PLAN-526 T8：open 条件或合 hover/菜单态；
                                // 锚恒为条目按钮（plain[0]），内容（plain[1]）
                                // 按菜单态切换缩略/三动作菜单（聚焦/最小化/
                                // 关闭——Q5c 右键替代内嵌 ×）。
                                mouse-area (onmouseenter: .HoverWin(w.wid), onmouseleave: .HoverEnd) {
                                    popover (open: .dock_hover == w.wid || .win_menu == w.wid, placement: "top", ondismiss: .HoverEnd, class: "p-1 border rounded bg-card") {
                                        button (icon: w.icon) {
                                            onclick: .WinFocus(w.wid)
                                            oncontextmenu.prevent: .WinMenu(w.wid)
                                            style: "h-10 w-10 px-0 text-lg rounded-xl bg-transparent text-foreground hover:bg-foreground/10"
                                        }
                                        if .win_menu == w.wid {
                                            col {
                                                style: "w-36 gap-1"
                                                button "聚焦" {
                                                    onclick: .WinFocus(w.wid)
                                                    style: "h-8 px-2 text-sm rounded-md bg-transparent text-foreground hover:bg-primary/10 text-left"
                                                }
                                                button "最小化" {
                                                    onclick: .WinMin(w.wid)
                                                    style: "h-8 px-2 text-sm rounded-md bg-transparent text-foreground hover:bg-primary/10 text-left"
                                                }
                                                button "关闭" {
                                                    onclick: .WinClose(w.wid)
                                                    style: "h-8 px-2 text-sm rounded-md bg-transparent text-error hover:bg-primary/10 text-left"
                                                }
                                            }
                                        } else {
                                            window_thumbnail (wid: w.wid, fallback_icon: w.icon) { style: "w-48 h-28 rounded" }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    spacer {
                        style: "flex-1 h-8"
                    }
                    // PLAN-526 T18：分区切换器触发 icon（原直列分区条
                    // "1 ×/2 ×/+/⇥" 整组退役——点击开合上方悬浮预览面板，
                    // 热键切换时宿主 transient 置位同面板）。
                    button (icon: "square-stack") {
                        onclick: .SwitcherToggle
                        style: "h-10 w-10 px-0 text-lg rounded-xl bg-transparent text-foreground hover:bg-foreground/10"
                    }
                    // PLAN-526 T17：布局钮 lucide 化（文字字形 ▦▤▢ 与
                    // 矢量 icon 的视觉尺寸差不复存在）。
                    button (icon: "layout-grid") {
                        onclick: .LayoutGrid
                        style: "h-10 w-10 px-0 text-lg rounded-xl bg-transparent text-foreground hover:bg-foreground/10"
                    }
                    button (icon: "table") {
                        onclick: .LayoutStack
                        style: "h-10 w-10 px-0 text-lg rounded-xl bg-transparent text-foreground hover:bg-foreground/10"
                    }
                    button (icon: "square") {
                        onclick: .LayoutFree
                        style: "h-10 w-10 px-0 text-lg rounded-xl bg-transparent text-foreground hover:bg-foreground/10"
                    }
                    // Plan 479 T4：通知中心铃铛 + 未读 badge（v1.2；
                    // 开关走 notes_toggle 总线动词，清除钮在面板内）。
                    // PLAN-526 T7/T9：去默认 primary 底（显式透明）+ 统一
                    // start 档外框。
                    row {
                        style: "items-center gap-0"
                        button (icon: "bell") {
                            onclick: .NotificationToggle
                            style: "h-10 w-10 px-0 text-lg rounded-xl bg-transparent text-foreground hover:bg-foreground/10"
                        }
                        if .__wm_notes_unread != "0" && .__wm_notes_unread != "" {
                            text .__wm_notes_unread {
                                style: "text-xs text-error font-semibold"
                            }
                        }
                    }
                    // Plan 487 M4：设置齿轮（v1.4 open_settings 无参动词；
                    // 宿主臂二态翻转——面板可见再点即关）。
                    button (icon: "settings") {
                        onclick: .OpenSettingsPanel
                        style: "h-10 w-10 px-0 text-lg rounded-xl bg-transparent text-foreground hover:bg-foreground/10"
                    }
                    // PLAN-526 T11：电源键（Q10b——Escape 退出退役后的图形
                    // 退出入口；确认面板 popover 锚定本键，top 落位）。
                    popover (open: .shutdown_ask == "1", placement: "top", ondismiss: .ShutdownCancel, class: "p-3 border rounded bg-card") {
                        button (icon: "power") {
                            onclick: .ShutdownRequest
                            style: "h-10 w-10 px-0 text-lg rounded-xl bg-transparent text-foreground hover:bg-foreground/10"
                        }
                        col {
                            style: "w-52 gap-2"
                            text "退出 Auto 桌面？" { style: "text-sm text-foreground" }
                            row {
                                style: "gap-2"
                                button "取消" {
                                    onclick: .ShutdownCancel
                                    style: "h-8 px-3 text-sm rounded-md bg-transparent text-foreground hover:bg-foreground/10"
                                }
                                button "退出" {
                                    onclick: .ShutdownConfirm
                                    style: "h-8 px-3 text-sm rounded-md bg-primary text-primary-foreground hover:bg-primary/90"
                                }
                            }
                        }
                    }
                    // Plan 497 G2：托盘组右置尾部——[状态图标挂载点容器]
                    // [时钟]。挂载点 v1 为空 row（app 图标注册 API 为
                    // 非目标；容器先行占位，后续状态图标挂此）；
                    // 铃铛（479）/齿轮（487）/电源（526）即组内既有成员。
                    row {
                        style: "items-center gap-0"
                    }
                    text .__wm_clock {
                        style: "text-xs text-muted-foreground px-2 tabular-nums"
                    }
                }
            }
            // PLAN-526 T18：分区切换悬浮预览面板（触发 icon 点击开合；热键
            // 切换时宿主 transient 置位 ~1.6s 自动收起）。紧邻任务栏渲染——
            // bottom 停靠 = 任务栏上方，top 停靠 = 任务栏下方；宽度=分区数
            // 自适应居中（不括满屏，Win11 任务视图形态）。每卡：label +
            // pager 前 4 真缩略（v1.5 旗标复用）+ current 高亮边；尾部
            // 「新建桌面」卡（对照 Win11 截图）。
            if .switcher_open == "1" {
                row {
                    style: "w-full items-center justify-center gap-2 px-2 pb-2"
                    for ws in .__wm_workspaces {
                        button {
                            onclick: .SetWorkspace(ws.id)
                            style: if ws.current == "1" {
                                "w-44 p-2 rounded-xl border-2 border-primary bg-card/95 text-foreground hover:bg-foreground/10"
                            } else {
                                "w-44 p-2 rounded-xl border bg-card/95 text-foreground hover:bg-foreground/10"
                            }
                            col {
                                style: "w-full gap-1"
                                text ws.label { style: "text-xs text-muted-foreground" }
                                row {
                                    style: "h-16 w-full items-center justify-center gap-1 bg-background/50 rounded-lg"
                                    for w in .__wm_wins {
                                        if w.workspace == ws.id && w.pager == "1" {
                                            window_thumbnail (wid: w.wid, fallback_icon: w.icon) { style: "w-16 h-10 rounded" }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    button {
                        onclick: .WorkspaceAdd
                        style: "w-44 p-2 rounded-xl border bg-card/95 text-foreground hover:bg-foreground/10"
                        col {
                            style: "w-full gap-1 items-center"
                            row {
                                style: "h-16 w-full items-center justify-center bg-background/50 rounded-lg"
                                text "+" { style: "text-xl text-muted-foreground" }
                            }
                            text "新建桌面" { style: "text-xs text-muted-foreground" }
                        }
                    }
                }
            }
            // 虚拟窗层让位（flex-1 在 iced 适配器只映射主轴（row=宽），
            // 纵向撑开须显式 h-full —— 463 T5 实测修正）。
            spacer {
                style: "w-full h-full"
            }
        }
    }

    on {
        .Init -> {
            // dock 配置读入（storage，018/025 先例；键值全字符串）。缺席
            // 回退 pack 默认——覆盖链：运行时配置 > pack 声明默认（§4.1）。
            // pinned 列表由宿主解析注入（__dock_pinned；registry 图标源在
            // 宿主侧，shell.at Init 不再读 shell.dock.pinned——472 T5）。
            var pos str = storage.get("shell.dock.position")
            if pos == "top" {
                .__dock_position = "top"
                .__dock_border = "border-b"
            }
            var en str = storage.get("shell.dock.enabled")
            if en == "false" {
                .__dock_enabled = "0"
            }
        }
        .SummonLauncher -> { .__desktop_cmd = "summon\tlauncher" }
        .LayoutFree -> { .__desktop_cmd = "layout\tfree" }
        .LayoutGrid -> { .__desktop_cmd = "layout_toggle\tgrid" }
        .LayoutStack -> { .__desktop_cmd = "layout_toggle\tmaster-stack" }
        // PLAN-526 T8：菜单态随动作消费清零（动作项与条目本体共用消息，
        // 非菜单路径清空为无害幂等）。
        .WinFocus(wid) -> { .__desktop_cmd = "focus\t" + wid; .win_menu = "" }
        .WinClose(wid) -> { .__desktop_cmd = "close\t" + wid; .win_menu = "" }
        .WinMin(wid) -> { .__desktop_cmd = "win_min\t" + wid; .win_menu = "" }
        .ActivateApp(app) -> { .__desktop_cmd = "activate\t" + app }
        .SetWorkspace(id) -> { .__desktop_cmd = "workspace\t" + id; .switcher_open = "" }
        // PLAN-526 T18：面板开合（触发 icon 二态翻转；热键切换由宿主
        // 直写 switcher_open 并 ServiceTick 计时收起）。
        .SwitcherToggle -> {
            if .switcher_open == "1" {
                .switcher_open = ""
            } else {
                .switcher_open = "1"
            }
        }
        .WorkspaceNext -> { .__desktop_cmd = "workspace_next" }
        // Plan 478 T5：pager 增/删分区（协议 v1.1 动词；非空/末分区门在宿主臂）。
        .WorkspaceAdd -> { .__desktop_cmd = "workspace_add" }
        .WorkspaceClose(id) -> { .__desktop_cmd = "workspace_close\t" + id }
        // Plan 479 T4：通知中心开关（协议 v1.2 无参动词；宿主臂落
        // toggle_notification_center 执行体——开面板即未读清零）。
        .NotificationToggle -> { .__desktop_cmd = "notes_toggle" }
        // Plan 486 v1.3：native 条目聚焦/关闭（arg 直传 wid "N<slot>"，
        // 宿主 parse 剥 N 前缀取 slot id——shell 零字符串加工）。
        .NativeFocus(wid) -> { .__desktop_cmd = "focus_native\t" + wid; .win_menu = "" }
        .NativeClose(wid) -> { .__desktop_cmd = "close_native\t" + wid; .win_menu = "" }
        // Plan 487 M4 v1.4：设置面板召唤（无参动词；宿主臂落
        // toggle_settings 执行体——二态翻转，面板可见再点即关）。
        .OpenSettingsPanel -> { .__desktop_cmd = "open_settings" }
        // PLAN-526 T8：条目右键 → 菜单态（popover open 条件或合 hover）。
        .WinMenu(wid) -> { .win_menu = wid }
        // PLAN-526 T11：关机确认三态（确认落 shutdown 无参动词；
        // Escape 退出热键退役——T13——后唯一图形退出入口）。
        .ShutdownRequest -> { .shutdown_ask = "1" }
        .ShutdownCancel -> { .shutdown_ask = "" }
        .ShutdownConfirm -> { .__desktop_cmd = "shutdown"; .shutdown_ask = "" }
        // Plan 497 G5：hover 预览态翻转（mouse-area enter/exit 驱动）。
        // PLAN-526 T8：HoverEnd 兼清菜单态（popover ondismiss 单消息
        // 复用——鼠标离条目/点面板外均收菜单）。
        .HoverWin(wid) -> { .dock_hover = wid }
        .HoverEnd -> { .dock_hover = ""; .win_menu = "" }
        .HoverWs(id) -> { .ws_hover = id }
        .HoverWsEnd -> { .ws_hover = "" }
    }
}
