// switcher overlay pack（特权 .at App —— 宿主进程内编译装载，不进 examples/ui；
// Plan 478 T4，464 launcher overlay 同型的第二枚 overlay 槽）。
//
// 形态：Ctrl+Tab 召唤的窗口切换器——MRU 序窗口面板（lucide 图标 + 标题，
// 472 debt「标题展示归 switcher」在此收口），键盘流选中确认聚焦。
// 键位分层（478 T1 施工图 §2）：本 App 自 bind 裸 Tab/←→/Enter/Esc 管选中；
// 宿主 Ctrl+Tab 走事件投递（可见时 .Advance 直投推进，否则召唤）——两路不打架。
//
// 接缝（协议 v1.1，schema/projection-protocol-v1.md）：
//   出：`__desktop_cmd`（`focus\t<wid>` 确认记录；宿主读+清）
//   入：召唤时快照注入——`mru_wids`/`mru_titles`/`mru_icons`/`mru_thumbs`(497 快照
//       就绪标记 "1"/""，平行列表)平行字符串列表
//       （B12：宿主注入 Obj 数组的 handler 字段读失效，launcher apps_* 同型；
//       `RebuildMru` 由宿主显式调用重建 handler 自有 rows）、`__wm_mru`
//       （合同面 Obj 数组，本 App 声明不 handler 消费）、`hosted`/`visible`。
// 快照语义：召唤时点定序，打开期间 Advance 不重注（MRU 切换器惯例）。
// 消费者唯一：宿主 renderer 的 summon_switcher / switcher 键盘订阅。
widget Switcher {
    msg { Init, RebuildMru, Advance, Back, Pick, Focus(str), Escape }

    model {
        // ---- 接缝状态（desktop 宿主注入）----
        var visible str = "0"       // overlay 门控：宿主召唤置 "1"
        var hosted str = "0"        // 宿主挂载时写 "1"
        var __desktop_cmd str = ""  // 上行命令总线（focus 确认记录）
        var __wm_mru = []           // 协议 v1.1 合同面（声明不 handler 消费）

        // ---- MRU 快照（宿主注入平行字符串列表；B12 规避）----
        var mru_wids = []
        var mru_titles = []
        var mru_icons = []
        // Plan 497：快照就绪标记（"1"/""；合同面——行缩略由
        // window_thumbnail 渲染臂自决 fallback，本列表供测试/后续增强分支）。
        var mru_thumbs = []

        // ---- 面板状态（handler 自建 rows；view 消费 + handler 下标读安全）----
        var sel int = 0             // 选中索引（app 内自建焦点索引）
        var rows = []               // {i,wid,title,icon}
        var nres int = 0            // 条目数（view 条件用，替代模板 .len()）
    }

    view {
        if .visible == "1" {
            // ---- 打开态：全屏暗底 + 居中卡片（launcher palette 同级视觉；
            // Plan 503：语义 scrim bg-background/60 + 卡片 glass 三件套）----
            col {
                style: "w-full h-full bg-background/60 flex flex-col items-center"
                spacer { style: "h-40 w-full" }
                col {
                    style: "w-full max-w-lg bg-card/80 border rounded-2xl shadow-xl overflow-hidden"

                    // 标题行
                    row {
                        style: "flex items-center gap-2 px-4 py-3 border-b"
                        text "Switch Window" { style: "text-foreground text-sm" }
                        text "MRU" { style: "ml-auto text-xs text-muted-foreground" }
                    }

                    // 窗口列表（MRU 序；空态）
                    col {
                        style: "w-full"
                        if .nres == 0 {
                            col {
                                style: "flex flex-col items-center py-8"
                                text "No windows" { style: "text-muted-foreground text-sm" }
                            }
                        }
                        // Plan 497 G5：行缩略升级——window_thumbnail
                        // （命中=真缩略；miss=渲染臂 fallback
                        // icon + 异步抓取，下帧升级；fallback_icon
                        // =既有 icon 兼容）。
                        for r in .rows {
                            if .sel == r.i {
                                row {
                                    onclick: .Focus(r.wid)
                                    style: "flex items-center gap-3 px-4 py-2 bg-primary/15 cursor-pointer"
                                    window_thumbnail (wid: r.wid, fallback_icon: r.icon) { style: "w-24 h-14 border rounded" }
                                    text r.title { style: "text-primary text-sm font-medium" }
                                }
                            } else {
                                row {
                                    onclick: .Focus(r.wid)
                                    style: "flex items-center gap-3 px-4 py-2 hover:bg-primary/10 cursor-pointer"
                                    window_thumbnail (wid: r.wid, fallback_icon: r.icon) { style: "w-24 h-14 border rounded" }
                                    text r.title { style: "text-foreground text-sm" }
                                }
                            }
                        }
                    }

                    // 底部提示行
                    row {
                        style: "flex items-center gap-4 px-4 py-2 border-t"
                        text "Tab/←→ select" { style: "text-xs text-muted-foreground" }
                        text "Enter focus" { style: "text-xs text-muted-foreground" }
                        text "Esc cancel" { style: "text-xs text-muted-foreground" }
                    }
                }
                spacer { style: "h-40 w-full" }
            }
        } else {
            // ---- 隐藏态：透明空层（不挡桌面点击；装配层仅 visible 时推层）----
            col {
                style: "w-full h-full"
            }
        }
    }

    bind {
        "Tab" -> .Advance
        "ArrowRight" -> .Advance
        "ArrowLeft" -> .Back
        "Enter" -> .Pick
        "Escape" -> .Escape
    }

    on {
        .Init -> {
            .visible = "0"
            .sel = 0
            .RebuildMru()
        }

        // 宿主召唤时显式调用（宿主写状态不触发 handler）：平行列表 →
        // handler 自有 rows（此后 .Pick 下标读安全），sel 复位 0（计划 D1）。
        .RebuildMru -> {
            .rows = []
            .nres = 0
            .sel = 0
            var idx int = 0
            while idx < .mru_wids.len() {
                var row = { i: idx, wid: .mru_wids[idx], title: .mru_titles[idx], icon: .mru_icons[idx], thumb: .mru_thumbs[idx] }
                .rows.push(row)
                idx = idx + 1
            }
            .nres = .rows.len()
        }

        // 选中推进（快照序内环走；不重注——MRU 切换器惯例）。
        .Advance -> {
            if .visible == "1" {
                if .nres > 0 {
                    if .sel < .nres - 1 {
                        .sel = .sel + 1
                    } else {
                        .sel = 0
                    }
                }
            }
        }

        .Back -> {
            if .visible == "1" {
                if .nres > 0 {
                    if .sel > 0 {
                        .sel = .sel - 1
                    } else {
                        .sel = .nres - 1
                    }
                }
            }
        }

        // Enter：聚焦选中行（同点击）。
        .Pick -> {
            if .visible == "1" {
                if .nres > 0 {
                    if .sel < .nres {
                        .Focus(.rows[.sel].wid)
                    }
                }
            }
        }

        // 确认聚焦：写上行总线 + 自隐（宿主排空执行 FocusWindow）。
        .Focus(wid) -> {
            .__desktop_cmd = "focus\t" + wid
            .visible = "0"
        }

        // Esc 取消：自隐不聚焦。
        .Escape -> {
            if .visible == "1" {
                .visible = "0"
            }
        }
    }
}
