// dashboard overlay pack（特权 .at App —— 宿主进程内编译装载，不进
// examples/ui；PLAN-024 T-03/T-04——设置面板退役后的第四 overlay 槽继任，
// 通知层邻位顶层）。
//
// 形态：dock Dashboard 钮召唤的小组件面板——顶部居中浮层（宽 ≤920px），
// 3 列网格直显各 App 的 `view mini` 活渲染面。面板 chrome（scrim + 底板
// + 标题行）在本文件；face 卡的格位几何由宿主计算（单一事实在宿主），
// 经 `__panel_*` px 注入镜像（notification __panel_max_h 同型）；face
// 视图本身由宿主拆借渲染叠合（活渲染面），不经本 App——事件带各自
// app 标签直达该 App 会话，face 内交互零中转。
//
// 接缝（协议 v1.8，schema/projection-protocol-v1.md）：
//   出：`__dashboard_cmd`（`dashboard_close`；编辑动词 pin/unpin/span/
//       launch 在 T-05 编辑 popover 落地）
//   入：召唤/活更新注入——face_ids/face_titles/face_icons/face_statuses/
//       face_spans 平行字符串列表（B12：handler 字段读 Obj 数组失效，
//       notification face_ids 同型规避）、`__dashboard_faces`（合同面
//       Obj 数组，声明不 handler 消费）、`__panel_w/__panel_h/__panel_top`
//       （宿主几何注入，px）、`hosted`/`visible`。
// 关闭模型（PLAN-012 W2 同型）：× / 点面板外（scrim）/ Esc 三路径。
// 消费者唯一：宿主 renderer 的 dashboard_toggle / refresh_dashboard_panel
// / dashboard 键盘订阅。
//
// 2026-09-22 用户裁定（本文件 rev）：
//   · 面板 8×3→8×2（宿主 DASH_ROWS；face 卡回自然 2 格高，T-18 满高
//     3 行格退役）；
//   · 分页 pill（悬空「系统」钮）改面板正下方 tab 条——宿主 wrapper
//     高 = 外框 + DASH_TAB_STRIP_H(28)，条行常驻占位、按钮 hover 显隐；
//   · chrome 底板改玻璃形态（bg-white/10 + 亮边框 + backdrop-blur
//     冻结声明）。
widget DashboardPanel {
    msg { Init, Escape, Close, SelectTab(str), ShowClose, HideClose, RebuildFaces }

    model {
        // ---- 接缝状态（desktop 宿主注入）----
        var visible str = "0"       // overlay 门控：宿主召唤置 "1"
        var hosted str = "0"        // 宿主挂载时写 "1"
        var __dashboard_cmd str = "" // 协议 v1.8 上行命令总线（dashboard_close 等）
        var __dashboard_faces = []  // 协议 v1.8 合同面（声明不 handler 消费）

        // ---- 面板几何（宿主注入，px——单一事实在宿主，本面镜像）----
        // 缺省 = 宿主 8×2 契约值（720×176，含 T-14 四围 PAD），仅注
        // 入前首帧可见；chrome 定高 h-[176px] 同源（视图串不可插值）。
        var __panel_w int = 720
        var __panel_h int = 176
        var __panel_top int = 64

        // ---- face 快照（宿主注入平行字符串列表；B12 规避）----
        var face_ids = []
        var face_titles = []
        var face_icons = []
        var face_statuses = []      // running | hatched | placeholder
        var face_spans = []         // "1" | "2"
        var face_tabs = []          // "main" | "system"（R9：未声明此变量时
                                    // write_state_vec 静默失败，视图按 tab
                                    // 过滤会滤光所有 face——两个 tab 全空根因）

        // ---- 面板状态（handler 自建 rows；view 条件消费）----
        // R5：活动 tab（main=小组件 / system=系统——实时轮询类组件住
        // system 页，非活动页宿主不渲染 face 且孵化会话 Tick 停订，常驻
        // 零轮询开销；stella widget-tabs 语义）。
        var active_tab str = "main"
        // R6：× 悬停显隐（面板级 mouse enter/leave；槽位固定不跳版）。
        var show_close str = "0"
        var rows = []
        var nrows int = 0
    }

    view {
        if .visible == "1" {
            // 常驻小组件层（R2）：宿主 wrapper 给定面板矩形 + 下缘 28px
            // tab 条带（2026-09-22：分页 pill 从右上悬浮改面板正下方
            // hover 显隐——本面根块 h = 外框 176 + 条带 28 = 204，chrome
            // 定高 176 镜像宿主 8×2 算式（2*80-8 + 2*12），条带浮层锚定
            // 底缘、按钮 hover 显隐：单一 mouse-area 包面板+条全程，
            // 零跨元素 enter/leave 抖动）。PLAN-035 T-14：外框四围 p-3。
            col {
                style: "w-full h-full"
                mouse-area (onmouseenter: .ShowClose, onmouseleave: .HideClose) {
                col {
                    style: "w-full h-full"

                    // 玻璃 chrome 底板（半透明 + 磨砂词汇冻结声明）：
                    // bg-white/10 低透白 + 亮边框；backdrop-blur-md 为
                    // 518 G8 冻结词汇（当前渲染 no-op，框架落地 backdrop
                    // 管道后自动升真磨砂）。face 卡由宿主按活动 tab 拆借
                    // 渲染叠合于网格算式格位；空态文案居中。
                    col {
                        style: "w-full h-[176px] p-3 bg-white/10 border border-white/25 rounded-xl overflow-hidden backdrop-blur-md"
                        col {
                            style: "w-full h-full items-center justify-center"
                            if .nrows == 0 {
                                text "No widgets" {
                                    style: "text-muted-foreground text-sm"
                                }
                            }
                        }

                        // ×（hover 显隐，绝对悬浮右上——PLAN-536 浮层）。
                        mouse-area (onclick: .Close) {
                            style: "absolute top-2 right-2 h-6 w-8 items-center justify-center rounded-lg hover:bg-accent z-10"
                            if .show_close == "1" {
                                text { "×" }
                            }
                        }
                    }

                    // 下缘 tab 条（绝对锚定 chrome 底缘 y=176——流式兄弟序
                    // 在宿主动态臂不稳定，浮层锚定像素确定；PLAN-536 偏移
                    // 浮层与老 pill 同机制。常驻渲染、按钮 hover 显隐）：
                    // 双页签直显（stella widget-tabs 语义），活动页高亮。
                    row {
                        style: "absolute top-[176px] left-0 w-full h-7 items-center justify-center gap-2 z-10"
                        if .show_close == "1" {
                            button (text: "小组件", onclick: .SelectTab("main")) {
                                style: if .active_tab == "main" { "h-6 px-2.5 text-xs rounded-full bg-primary/15 border border-primary/40 text-primary" } else { "h-6 px-2.5 text-xs rounded-full bg-card/80 border text-muted-foreground hover:bg-accent" }
                            }
                            button (text: "系统", onclick: .SelectTab("system")) {
                                style: if .active_tab == "system" { "h-6 px-2.5 text-xs rounded-full bg-primary/15 border border-primary/40 text-primary" } else { "h-6 px-2.5 text-xs rounded-full bg-card/80 border text-muted-foreground hover:bg-accent" }
                            }
                        }
                    }
                }
            }
            }
        }
    }

    on {
        .Init -> {
            .hosted = "1"
            .visible = "0"
        }
        .Close -> {
            // 宿主臂 drain 后统一裁决（写 storage/重注入），本地先自隐
            // ——同一消息周期内 visible=0 + 宿主 refresh 幂等。
            .__dashboard_cmd += "dashboard_close\n"
            .visible = "0"
        }
        .Escape -> {
            .__dashboard_cmd += "dashboard_close\n"
            .visible = "0"
        }
        .SelectTab(t) -> {
            .active_tab = t
        }
        .ShowClose -> { .show_close = "1" }
        .HideClose -> { .show_close = "0" }
        .RebuildFaces -> {
            // 空态判据 = face 快照长度（rows 由宿主 face 层渲染，本面不建）。
            .nrows = .face_ids.len()
        }
    }
}
