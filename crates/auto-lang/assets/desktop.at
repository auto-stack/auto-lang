// 桌面本体 pack（特权 .at App —— 宿主进程内编译装载，不进 examples/ui；
// Plan 496 M5 = shell-track 第五面：桌面图标网格面，常驻不召唤——挂 463
// 预留的桌面层 z 槽（壁纸之上、App 虚拟窗口之下；宿主装配层 Stack 先于
// 虚拟窗推层即得底序）。
//
// 接缝（投影协议 v1.7，schema/projection-protocol-v1.md）：
//   出：`__desktop_cmd`（复用既有动词词表——activate（472 两臂：未运行→
//       启动 / 运行中→聚焦）+ open_settings（v1.4 齿轮同款——「显示设置」）
//       + PLAN-019 v1.7 增量：wallpaper_pick / wallpaper_close /
//       wallpaper_browse_dir / wallpaper_nav / wallpaper_preview（壁纸
//       picker 族，语义宿主收口）+ set_wallpaper（缩略图点选即应用）。
//   入：`__desktop_bg`（宿主注入：壁纸色值类片段——"#hex" 色值时注入
//       "bg-[#hex]"（本面根 bg 实铺）；图片路径/缺省时注入 ""（图片壁纸
//       由宿主在更底层推壁纸图层——DSL 无重叠布局，z 序宿主侧兑现））
//       `__desktop_icons`（宿主注入 {id,icon,label,src,color} Obj 数组——
//       pinned ∪ 自定义条目合并去重（排除 hidden），src 标来源
//       pinned|custom；icon/label 宿主自注册表解析，缺省 app-window/id；
//       color = per-app 徽标色（badge_color_for 哈希分配，PLAN-014 W-01
//       补记——v1.4 起实注入，协议字段表 v1.8 同步审计））
//       `__desktop_hidden`（宿主注入：排除 id 逗号串——移除臂重写
//       shell.desktop.hidden 的当前值底稿）。
// storage 键（487 判定先例：非几何无动词，storage 直写 boot 生效）：
//   shell.desktop.wallpaper（路径 | #hex；settings 外观分区写手）
//   shell.desktop.icons（自定义条目 id 逗号串——shell.dock.pinned 同形）
//   shell.desktop.hidden（排除 id 逗号串——pinned/custom 通用移除位）。
// 空白点击：根容器 onclick → 关右键菜单（463 桌面层语义——不改 WM 焦点，
// 无动词本地态）。消费者唯一：宿主 renderer 桌面层装配。
widget DesktopSurface {
    msg {
        Init,
        ActivateApp(str),
        IconMenu(str),
        // PLAN-012 W5：拖拽态机（press-press 两段式——onclick 即 iced
        // press；按下拾起 → 按到目标卡落下交换；按回原卡 = 取消）。
        IconPress(str),
        BlankPress, BlankDrop,
        MenuOpen,
        MenuRemove,
        MenuWallpaper,
        // PLAN-526 T10：空白处右键（mouse-area oncontextmenu——布局件
        // 右键臂缺位的替代挂点；菜单态本地门控，IconMenu 同型）。
        BlankMenu,
        // PLAN-019 v1.7：壁纸 picker（栅格点选即应用 / 预览二级态 /
        // 浏览换目录 / 关闭——语义全宿主收口，本面零分支）。
        PickerApply(str),
        // PLAN-035 T-11：桌面右键菜单「桌面小组件」开关（dashboard_toggle
        // v1.8 词面；可见性判据 = 宿主投影 __wm_dashboard）。
        ToggleDashboardBlank,
        PickerPreview(str),
        PickerBack,
        PickerNav(str),
        PickerBrowse,
        PickerDismiss,
        // PLAN-014 W-05'：空白菜单「恢复默认图标」（清 hidden 单源 +
        // refresh_desktop_icons 即时重注入）。
        ResetIconsBlank,
        // PLAN-014 W-02：总线写单点（同 shell.at SendCmd——追加语义，
        // 同排空周期多命令不互相覆盖）。
        SendCmd(str)
    }

    model {
        var __desktop_cmd str = ""
        var __desktop_bg str = ""
        var __desktop_icons = []
        var __desktop_hidden str = ""
        // PLAN-012 W5：格子化图标表（宿主注入——拖拽换位渲染面 + 平行
        // 字符串列表供 handler 下标读，B12 规避）。
        var __desktop_cells = []
        var __desktop_cell_ids = []
        var __desktop_cell_cs = []
        var __desktop_cell_rs = []
        var menu_id str = ""
        // PLAN-012 W5：拖拽态（按下拾起的图标 id；"" = 无拖拽）。
        var drag_id str = ""
        // 2026-09-15：拖拽辅助视觉数据面（宿主写入）——drag_icon = 被拖
        // 图标渲染名（坐标锚幽灵 popover）；drop_c/drop_r = 光标所在格
        // （落点格高亮）；__desktop_label_dark = 壁纸亮度判定（暗壁纸
        // 白字标题）。
        var drag_icon str = ""
        var drop_c str = ""
        var drop_r str = ""
        // 2026-09-15：位移阈值越线旗标（宿主 __mouse_moved 臂置 "1"，清理
        // 臂复位）——拖拽幽灵 popover 的开门条件（drag_id 按下即置位，直接
        // 用它会让单击/双击第一击也闪出副本）。
        var drag_moved str = ""
        var __desktop_label_dark str = ""
        var blank_menu str = ""
        // PLAN-012：光标坐标（宿主 __mouse_moved 臂持续写入，只写不置
        // view_dirty；空白菜单坐标锚数据源——open 翻转重建时读取最新值）。
        var __desktop_cursor_x float = 0.0
        var __desktop_cursor_y float = 0.0
        // PLAN-014 W-04：图标选中态（单击置位 / 空白点击清空；与 022
        // 拖拽互洽——选中只置本地态，不写命令，拖拽阈值臂不受影响）。
        var sel_id str = ""
        // PLAN-014 W-04：启动中反馈（ActivateApp 置位；__wm_running 含
        // 该 id 即清——宿主 RunningSync 召唤臂 / Init 重注入求差自愈）。
        var launching str = ""
        // PLAN-014 W-04：运行集合派生串（宿主 __wm_running 注入面扩注
        // desktop 层，协议 v1.8 登记——launching ack 判据数据面）。
        var __wm_running str = ""
        // PLAN-035 T-11：dashboard 面板可见性投影（宿主注入；右键菜单
        // checkbox 判据）。
        var __wm_dashboard str = ""
        // PLAN-019 v1.7：壁纸 picker 注入面（协议 v1.7 §2.1——宿主写，
        // 本面只读消费；wp_paths 平行列表 = handler 侧数据合同面，本面
        // 消息均闭包带参，无下标读）。
        var __wp_picker str = ""
        var __wp_preview str = ""
        var __wp_dir str = ""
        var __wp_current str = ""
        var __wp_items = []
        var __wp_visible = []
        var __wp_x float = 0.0
        var __wp_y float = 0.0
        var wp_paths = []
    }

    view {
        // 根：全屏透明容器（纯色壁纸时 __desktop_bg 带 bg-[#hex] 实铺）。
        // PLAN-526 T10：内容包 mouse-area——onclick（原布局件 490 G4 左键）
        // + oncontextmenu（右键空白菜单；Q6 实测桌面空白无右键闭环）。
        col {
            style: "w-full h-full p-3 ${.__desktop_bg}"
            // PLAN-012：blank 菜单坐标锚（跟随右键落点）——原 widget 锚
            //（children[0]=全屏 mouse-area）+ bottom-start 使菜单固定桌面
            // 左下（011 复审 F-R1）。坐标 = 宿主 __mouse_moved 臂持续写入
            // 的 __desktop_cursor_x/y（只写不置 dirty）；422 P3 坐标锚形态
            // （027-file-manager 先例），面板内容独占 popover children。
            // PLAN-012 F2 走查：onmouseup = 拖拽松手落格（宿主全局臂
            // 读光标算格；drag_id 空时 no-op）。
            mouse-area (onclick: .BlankPress, onmouseup: .BlankDrop, oncontextmenu.prevent: .BlankMenu) {
                style: "w-full h-full"
            // PLAN-011 T3：mouse_area 命中带=内容盒（iced 侧 style 只落在
            // 外层包装 container，对命中几何是 no-op）——本 mouse-area 直接
            // 包 grid 时命中带仅图标条带高，条带以下全桌面是 BlankPress/
            // BlankMenu 命中死区（P010-F1 根因，t1_matrix 五配置+格条带
            // 微测实证 scratch/p011）。内容包 w-full h-full col 使命中带
            // 随之全屏；锚件（外层包装）几何不变，popover 放置语义不变。
            col {
                style: "w-full h-full"

                // 图标网格（固定网格 v1；列数 8 起步，占位 lucide 图标——
            // pinned 条目自带注册表 icon 优先）。双击 = mouse-area
            // ondblclick（484 mouse-area + iced on_double_click）；右键 =
            // 布局件 oncontextmenu（PLAN-002 B：布局件级右键挂点，格内全域
            // 可右键——此前挂 button 上仅图标本体命中）。
            // Plan 518 G4③：格 = per-app 徽标色圆角底（哈希分配,数据驱动
            // bg-[ 拼接——"grid grid-cols-" + n 先例）+ 白 glyph（stella
            // 桌面 Notes 徽标同款;单色 lucide "带颜色"正解是容器底色）。
                            // PLAN-012 W5：grid 定宽（8 列 × 80px 格宽 + 7 × 8px gap =
                            // 696px）——原 w-full 均分整行把格距拉伸到数百 px（用户反馈
                            // "间距过大"根因）；定宽后图标群贴左上、格距 = gap 8px 量级
                            // （w-fit iced 轨不支持，class.rs 白名单受限——显式算术宽）。
                            // 2026-09-15 用户裁定（二轮）：图标 48×48 + 下方标题回归，
                            // 格宽 w-20 承载标签；栅格宽随之 568 → 696。
                            grid (cols: 8, gap: 8) {
                                style: "w-[696px]"
                // PLAN-012 W5：格子表渲染（宿主分配 (c,r) + spacer 填位）——
                // 拖拽换位后位置持久（shell.desktop.positions，重启保持）。
                for e in .__desktop_cells {
                    if e.spacer == "1" {
                        div { style: "w-20 h-[72px]" }
                    } else {
                    mouse-area (ondblclick: .ActivateApp(e.id), onclick: .IconPress(e.id)) {
                        col {
                            // PLAN-002 B pilot：布局件 hover 类消费（此前 row/col
                            // 上的 hover: 静默丢弃——526 Q9①）+ 右键挂点。
                            // PLAN-012 W5：拖拽拾起态 = 半透明底（拖拽语义反馈；
                            // 无逐帧跟随幽灵——headless 决策，见工件）。
                            // 2026-09-15 用户裁定（二轮）：格高改自适应（图标 48
                            // + 下方标题；此前固定 h 把标签裁没），hover 半透明
                            // 底覆盖 icon+标题整组。
                            // 2026-09-15 用户裁定（三轮）：格高回固定 72px——
                            // 自适应高被 iced grid 拉伸成整行高（行高数百 px、
                            // 高亮纵向稀疏）；48px 图标 + 4px gap + 16px 标题
                            // 恰好 72。拖拽中落点格 = bg-primary/20 实时高亮。
                            style: if .drag_id == e.id {
                                "w-20 h-[72px] items-center justify-center gap-1 bg-white/20 opacity-50"
                            } else {
                                if .drag_id != "" && .drag_id != e.id && e.c == .drop_c && e.r == .drop_r {
                                    "w-20 h-[72px] items-center justify-center gap-1 bg-primary/20"
                                } else {
                                    // PLAN-014 W-04：启动中 = 选中底 + 半透明
                                    // （chip 半透明语义；RunningSync/Init 收敛后回落）。
                                    if .launching == e.id {
                                        "w-20 h-[72px] items-center justify-center gap-1 rounded-lg bg-white/10 opacity-50"
                                    } else {
                                        // PLAN-014 W-04：单击选中 = 白/10 圆角
                                        // 高亮块（022 网格语境 rev2 形态）。
                                        if .sel_id == e.id {
                                            "w-20 h-[72px] items-center justify-center gap-1 rounded-lg bg-white/10"
                                        } else {
                                            "w-20 h-[72px] items-center justify-center gap-1 hover:bg-white/10"
                                        }
                                    }
                                }
                            }
                            oncontextmenu.prevent: .IconMenu(e.id)
            // PLAN-526 T30：icon 右键菜单 popover 化（锚=图标 chip 视觉件，
            // 与任务栏条目右键同款悬浮样式；此前准内联 col 把
            // 图标挤下且样式不符）。
            popover (open: .menu_id == e.id, placement: "bottom-start", ondismiss: .MenuClose, class: "p-1 border rounded bg-card") {
                // PLAN-002 N1（用户定案方案 A）：chip 降级非交互视觉件
                // （col+icon）——原 iced Button 捕获 press 饿死祖先
                // mouse-area 的 ondblclick（chip 上双击死区，T30 起存量；
                // review_ue.log 实录 8 条裸 click 无 ActivateApp）。降级后
                // 整格 160×160 统一双击+右键（Windows 惯例：图标+文字整块
                // 可点）；PLAN-019-FU1：chip 80px + glyph 40px（原 40/20）。
                if e.full == "1" {
                    col {
                        // 2026-09-15 用户裁定（二轮）：图标 48×48 满幅、FU3
                        // 透明边框方案退役（边框观感差）——高亮由整组 hover
                        // 半透明底承担（外层 col hover:bg-white/10）。
                        style: "w-12 h-12"
                        icon (name: e.icon) {
                            style: "w-full h-full"
                        }
                    }
                } else {
                    col {
                        style: "h-10 w-10 items-center justify-center rounded-xl bg-[" + e.color + "]"
                        icon (name: e.icon) {
                            style: "w-5 h-5 text-white"
                        }
                    }
                }
                                // PLAN-035 T-02：菜单内容包 open 态守卫——
                                // 关闭态 popover 内容在合成层泄漏（幽灵绘制/
                                // 命中，attribution #2），内容不物化即无泄漏
                                // 面。锚件（chip）不受守卫（网格视觉本体）。
                                if .menu_id == e.id {
                                    col {
                                        style: "w-44 gap-1"
                                        button (text: "打开", variant: "ghost") {
                                            onclick: .MenuOpen
                                            style: "w-full h-8 px-2 text-sm text-left rounded-md bg-transparent text-foreground hover:bg-primary/10"
                                        }
                                        button (text: "从桌面移除", variant: "ghost") {
                                            onclick: .MenuRemove
                                            style: "w-full h-8 px-2 text-sm text-left rounded-md bg-transparent text-muted-foreground hover:bg-primary/10"
                                        }
                                        button (text: "更换壁纸…", variant: "ghost") {
                                            onclick: .MenuWallpaper
                                            style: "w-full h-8 px-2 text-sm text-left rounded-md bg-transparent text-muted-foreground hover:bg-primary/10"
                                        }
                                    }
                                }
                            }
                            text e.label {
                                // 2026-09-15：暗壁纸可读性三级配色——图片壁纸
                                // （__desktop_bg 空）= 白字 + 半透明深色底片
                                // （明暗混合壁纸平均亮度判不准，底片恒可读）；
                                // 纯色壁纸按亮度白字/前景色。
                                style: if .__desktop_bg == "" {
                                    "text-xs text-white truncate w-full text-center rounded-md bg-black/30"
                                } else {
                                    if .__desktop_label_dark == "1" {
                                        "text-xs text-white truncate w-full text-center"
                                    } else {
                                        "text-xs text-foreground truncate w-full text-center"
                                    }
                                }
                            }
                            // PLAN-014 W-04：启动中右上角灰点（launching 态
                            // 第二反馈臂；绝对定位压格右上——class.rs
                            // absolute/-top/-right 白名单在案）。
                            if .launching == e.id {
                                div { style: "absolute top-0.5 right-1 w-1.5 h-1.5 rounded-full bg-muted-foreground" }
                            }
                        }
                    }
                    }
                }
            }
            // 2026-09-15：拖拽幽灵——坐标锚 popover 跟随光标（__desktop_cursor_x/y
            // 宿主 __mouse_moved 臂逐事件回写 + 拖拽期置 view_dirty），内容 =
            // 被拖图标 48px 半透明满幅渲染；class 全透明无边框（popover 容器
            // 样式完全由 class 承载）。开门 = drag_moved（真拖起来才显示——
            // drag_id 按下即置位，单击/双击第一击不闪副本）。
            popover (open: .drag_moved == "1", x: .__desktop_cursor_x, y: .__desktop_cursor_y, class: "p-0 bg-transparent") {
                // PLAN-035 T-02：内容开态守卫（同 blank 菜单注）。
                if .drag_moved == "1" {
                    col {
                        style: "w-12 h-12 opacity-60"
                        icon (name: .drag_icon) {
                            style: "w-full h-full"
                        }
                    }
                }
            }
            // PLAN-011 T3：闭合命中带内包 col（见 mouse-area 开标签处注）。
            }
            // PLAN-002：blank 菜单内容归位 popover 标签内（plain[1]=content）—
            // 此前闭合括号错位使其成为 view 级散落子树，桌面左下角常驻渲染
            // （T36 结构回归；实机截图在案 scratch/p002）。
            }
            // PLAN-012：坐标锚 popover（open 驱动 + x/y 落点；坐标锚形态
            // 无锚子件，children 全为面板内容）。
            popover (open: .blank_menu != "", x: .__desktop_cursor_x, y: .__desktop_cursor_y, ondismiss: .BlankClose, class: "p-1 border rounded bg-card") {
            // PLAN-035 T-02：内容开态守卫——boot 期关闭态本 popover 在合成层
            // 泄漏三按钮文本幽灵（桌面左下角常驻，T36 历史回归同位置复发；
            // 实机 b0 截图在案 tmp/p035/attribution.md #2）。内容不物化即
            // 无可泄漏绘制/命中面（锚定面板 bg 由 class 承载，空面板无
            // 可视块）。
            if .blank_menu != "" {
            col {
                style: "w-44 gap-1"
                // PLAN-035 T-11：「桌面小组件」开关项（AC-11）——面板 ×
                // 关闭后的常驻重开入口；checked 判据 = 宿主投影。
                row {
                    style: "items-center gap-2 px-2 h-8"
                    checkbox {
                        checked: .__wm_dashboard == "1"
                        onclick: .ToggleDashboardBlank
                        style: "w-4 h-4"
                    }
                    text "桌面小组件" {
                        style: "text-sm text-foreground"
                    }
                }
                button (text: "更换壁纸…", variant: "ghost") {
                    onclick: .MenuWallpaperBlank
                    style: "w-full h-8 px-2 text-sm text-left rounded-md bg-transparent text-foreground hover:bg-primary/10"
                }
                button (text: "显示设置", variant: "ghost") {
                    onclick: .OpenSettingsBlank
                    style: "w-full h-8 px-2 text-sm text-left rounded-md bg-transparent text-foreground hover:bg-primary/10"
                }
                // PLAN-014 W-05'：恢复默认图标（清 shell.desktop.hidden
                // 单源——boot 合并臂不再排除任何条目，重启全量回；
                // refresh_desktop_icons 触发宿主即时重注入，storage 已清
                // 故即时臂同效）。
                button (text: "恢复默认图标", variant: "ghost") {
                    onclick: .ResetIconsBlank
                    style: "w-full h-8 px-2 text-sm text-left rounded-md bg-transparent text-muted-foreground hover:bg-primary/10"
                }
            }
            }
        }
            // PLAN-019 v1.7：壁纸选择 carousel 层（坐标锚 popover 浮置——
            // 负一屏无 App 窗，picker 与图标/真壁纸同屏合成。缩略图单击 =
            // set_wallpaper 立即应用（真桌面即预览）；「预览」钮进大图
            // 二级态（←/→ 键导航宿主侧，Esc/返回退栅格）。ondiscard 即
            // ondismiss（外点/Esc）→ wallpaper_close，归属规则宿主收口）。
            popover (open: .__wp_picker == "1", x: .__wp_x, y: .__wp_y, ondismiss: .PickerDismiss, class: "p-4 border rounded-xl bg-card w-[720px] gap-3") {
                // PLAN-035 T-02：面板内容包 open 态守卫（同 blank 菜单注）
                // ——用户实机「任务栏白卡幽灵（浏览…可点击→弹目录对话框）」
                // 即本面板关闭态内容泄漏；内容不物化即根治。
                if .__wp_picker == "1" {
                // 头部行：目录展示 + 浏览换目录 + 关闭。
                row {
                    style: "w-full items-center gap-2"
                    icon (name: "image") {
                        style: "w-4 h-4 text-muted-foreground"
                    }
                    text .__wp_dir {
                        style: "text-xs text-muted-foreground flex-1 truncate"
                    }
                    button (text: "浏览…", variant: "ghost") {
                        onclick: .PickerBrowse
                        style: "h-7 px-3 text-xs rounded-lg bg-muted text-muted-foreground hover:bg-primary/10"
                    }
                    button (icon: "x", variant: "ghost") {
                        onclick: .PickerDismiss
                        style: "h-7 w-7 px-0 rounded-lg text-muted-foreground hover:bg-primary/10"
                    }
                }
                // 双态：栅格（点击即应用）/ 大图预览（‹ › 环绕导航）。
                if .__wp_preview == "" {
                    // FU7：横向 carousel——滑窗只显 5 枚（宿主切片注入
                    // __wp_visible），‹›/←→ 滑窗、点选即应用。
                    row {
                        style: "w-full items-center gap-2"
                        button (icon: "chevron-left", variant: "ghost") {
                            onclick: .PickerNav("prev")
                            style: "h-8 w-8 px-0 rounded-lg hover:bg-primary/10"
                        }
                        for e in .__wp_visible {
                            col {
                                style: "gap-1"
                                mouse-area (onclick: .PickerApply(e.path)) {
                                    col {
                                        style: if e.path == .__wp_current {
                                            "w-[120px] h-[68px] rounded-lg border-2 border-primary"
                                        } else {
                                            "w-[120px] h-[68px] rounded-lg border-2 border-transparent"
                                        }
                                        image (src: e.path, alt: e.name, fit: "cover") {
                                            style: "w-full h-full rounded-lg"
                                        }
                                    }
                                }
                                row {
                                    style: "w-[120px] items-center justify-between"
                                    text e.name {
                                        style: "text-[10px] text-muted-foreground truncate"
                                    }
                                    button (text: "预览", variant: "ghost") {
                                        onclick: .PickerPreview(e.path)
                                        style: "h-5 px-1 text-[10px] rounded-md bg-transparent text-muted-foreground hover:bg-primary/10"
                                    }
                                }
                            }
                        }
                        button (icon: "chevron-right", variant: "ghost") {
                            onclick: .PickerNav("next")
                            style: "h-8 w-8 px-0 rounded-lg hover:bg-primary/10"
                        }
                    }
                } else {
                    col {
                        style: "w-full gap-2 items-center"
                        image (src: .__wp_preview, alt: "preview", fit: "contain") {
                            style: "w-full h-[440px] rounded-lg bg-black/40"
                        }
                        row {
                            style: "items-center gap-2"
                            button (icon: "chevron-left", variant: "ghost") {
                                onclick: .PickerNav("prev")
                                style: "h-8 w-8 px-0 rounded-lg hover:bg-primary/10"
                            }
                            button (text: "返回", variant: "ghost") {
                                onclick: .PickerBack
                                style: "h-7 px-3 text-xs rounded-lg bg-muted text-muted-foreground hover:bg-primary/10"
                            }
                            button (icon: "chevron-right", variant: "ghost") {
                                onclick: .PickerNav("next")
                                style: "h-8 w-8 px-0 rounded-lg hover:bg-primary/10"
                            }
                        }
                    }
                }
                }
            }
    }
    }

    on {
        // Init：本地态复位（宿主投影注入不触发 handler；无 storage 读入——
        // 数据全宿主侧解析注入，此处仅消 boot 期 handler-not-found 噪音）。
        .Init -> {
            .menu_id = ""
            .blank_menu = ""
            // PLAN-014 W-04：launching 残态自愈（Init/重注入时 running
            // 不含 launching id = 启动失败/过期——求差清残，防永驻灰点）。
            if .launching != "" {
                if .__wm_running.contains("," + .launching + ",") == false {
                    .launching = ""
                }
            }
        }

        // 双击启动/聚焦（472 activate 两臂动词复用——宿主臂已备）。
        .ActivateApp(app) -> {
            .SendCmd("activate\t" + app)
            // PLAN-014 W-04：启动中反馈（T-05 完成两臂——已运行应用
            // activate = 聚焦语义，不置 launching；此处先置，RunningSync
            // 读 __wm_running 收敛，重入双击无害幂等）。
            .launching = app
        }

        // 右键图标：开菜单（记录目标条目）。
        .IconMenu(id) -> { .menu_id = id }

        // PLAN-012 F2 走查：拖拽 = 按下拾起（宿主 drag_start 置位）→
        // 拖动 → 松手落格（根 mouse-area onmouseup → BlankDrop；宿主全局
        // __mouse_released 臂兜底）。落格 = 光标格磁吸，占位挤下一空格。
        // PLAN-014 W-04：onclick 兼选中（单击/双击第一击置 sel_id；拖拽
        // 拾起臂不受影响——阈值门在宿主 icon_drag_moved，选中只置本地态）。
        .IconPress(id) -> {
            .sel_id = id
            if .drag_id == "" {
                .drag_id = id
                .SendCmd("desktop_icon_drag_start	" + id)
            }
        }
        .BlankDrop -> {
            if .drag_id != "" {
                .SendCmd("desktop_icon_drop_at	" + .drag_id)
                .drag_id = ""
            }
        }

        // PLAN-526 T10：空白处右键 → 空白菜单态。
        .BlankMenu -> { .blank_menu = "1" }

        // 空白点击：关菜单（463 语义——不动 WM 焦点，纯本地态）。
        // PLAN-526 T10：兼清空白菜单。PLAN-014 W-04：兼清图标选中态。
        .BlankPress -> { .menu_id = ""; .blank_menu = ""; .sel_id = "" }
        // PLAN-526 T36/T34：popover ondismiss 关闭（点外部/Esc）。
        .BlankClose -> { .blank_menu = "" }
        .MenuClose -> { .menu_id = "" }

        // PLAN-526 T10：空白菜单动作（消费即收起；动词同图标菜单臂）。
        .MenuWallpaperBlank -> {
            .blank_menu = ""
            .SendCmd("wallpaper_pick")
        }
        .OpenSettingsBlank -> {
            .blank_menu = ""
            .SendCmd("open_settings")
        }

        // 菜单：打开 = activate 两臂（同双击）。
        .MenuOpen -> {
            if .menu_id != "" {
                .SendCmd("activate\t" + .menu_id)
                .menu_id = ""
            }
        }

        // 菜单：从桌面移除 = shell.desktop.hidden 续写（pinned/custom 通用；
        // boot 合并臂排除 hidden id——下次启动生效，487 pinned 同语义）。
        // PLAN-014 W-05'：追加前去重（逗号域串包裹 contains——重复移除
        // 同 id 不产生重份；handler 侧 contains 可用，view 条件才是死点）。
        .MenuRemove -> {
            if .menu_id != "" {
                var hay str = "," + .__desktop_hidden + ","
                var needle str = "," + .menu_id + ","
                if hay.contains(needle) == false {
                    if .__desktop_hidden == "" {
                        .__desktop_hidden = .menu_id
                    } else {
                        .__desktop_hidden = .__desktop_hidden + "," + .menu_id
                    }
                    storage.set("shell.desktop.hidden", .__desktop_hidden)
                }
                .menu_id = ""
            }
        }

        // PLAN-014 W-05'：恢复默认图标 = hidden 单源清空（storage 落盘 +
        // 本地底稿清空）+ refresh_desktop_icons 即时重注入（宿主重读
        // storage 重算格子表——storage 已清故即时臂与重启全量回同效）。
        .ResetIconsBlank -> {
            .blank_menu = ""
            .__desktop_hidden = ""
            storage.set("shell.desktop.hidden", "")
            .SendCmd("refresh_desktop_icons")
        }

        // 菜单：更换壁纸 → wallpaper_pick（PLAN-019 v1.7 组合动词 = 借
        // 负一屏 + 开 picker + 归属簿记宿主收口；open_settings 退役——
        // 「显示设置」臂仍走旧通道）。
        .MenuWallpaper -> {
            .menu_id = ""
            .SendCmd("wallpaper_pick")
        }

        // PLAN-035 T-11：小组件面板开关（dashboard_toggle 词面；菜单消费
        // 即收起，可见性回正由宿主投影下一拍同步）。
        .ToggleDashboardBlank -> {
            .blank_menu = ""
            .SendCmd("dashboard_toggle")
        }

        // PLAN-019 v1.7：壁纸 picker 消息族（语义宿主收口——本面只发
        // 总线记录，零本地态）。
        .PickerApply(path) -> {
            .SendCmd("set_wallpaper\t" + path)
        }
        .PickerPreview(path) -> {
            .SendCmd("wallpaper_preview\t" + path)
        }
        .PickerBack -> {
            .SendCmd("wallpaper_preview\t")
        }
        .PickerNav(dir) -> {
            .SendCmd("wallpaper_nav\t" + dir)
        }
        .PickerBrowse -> {
            .SendCmd("wallpaper_browse_dir")
        }
        .PickerDismiss -> {
            .SendCmd("wallpaper_close")
        }

        // PLAN-014 W-02：追加语义单点（同 shell.at SendCmd——多命令以
        // 换行连接，宿主排空按记录切分逐条执行）。
        .SendCmd(rec) -> {
            if .__desktop_cmd != "" {
                .__desktop_cmd = .__desktop_cmd + "\n"
            }
            .__desktop_cmd = .__desktop_cmd + rec
        }

        // PLAN-014 W-04：launching 收敛（宿主 running 集合变化时召唤，
        // call_handler 同 RebuildMru/RebuildNotes 先例）——running 含
        // launching id 即清（启动成功 ack）；Init/重注入求差清残在 Init 臂。
        .RunningSync -> {
            if .launching != "" {
                if .__wm_running.contains("," + .launching + ",") {
                    .launching = ""
                }
            }
        }
    }
}
