// settings overlay pack（特权 .at App —— 宿主进程内编译装载，不进
// examples/ui；Plan 487 M4，464/478/479 overlay 槽同型的第四枚）。
//
// 形态：dock 齿轮召唤的系统设置面板——左列分区导航（Dock/通知/外观/系统/
// 关于）+ 右列内容卡（463 shell pack 皮肤）。分区见计划 §详细设计：
//   Dock：位置/开关热生效（desktop.set_dock_position/enabled 驱动动词，
//   I7：几何是驱动事实，settings 只是 UI）+ pinned 编辑（storage 键
//   shell.dock.pinned 直写，boot 生效）。
//   通知：持久化开关（shell.notes.enabled storage 直写，479 持久化链门控）。
//   外观（496 M5 + 518）：壁纸输入（shell.desktop.wallpaper storage 直写
//   ——路径 | #hex | builtin: 资产方案；boot 解析回退链见 renderer
//   load_desktop_wallpaper，重启生效）+ 深色模式（set_theme 驱动动词即时
//   生效 + shell.appearance.theme 持久化,518 G1）+ 透明度三档
//   （shell.desktop.transparency storage 直写,虚拟窗底色每帧读即时生效,
//   518 G6）。
//   系统（501）：「系统设置（全部模块）」入口——desktop.launch("os-config")
//   拉起外部仓 os-config App（daemon 检活/spawn/env 注入在宿主 launch 臂）；
//   offline 徽标态（daemon 起不来入口置灰 + 提示，点击重试——launch 每次
//   重新探活，重试语义零额外动词）。
//   关于：版本/宿主信息（投影注入常量，无新协议字段）。
//
// 接缝（协议 v1.4，schema/projection-protocol-v1.md）：
//   出：`__desktop_cmd`（`set_dock_position\t<bottom|top>` /
//       `set_dock_enabled\t<0|1>` / `launch\tos-config` 驱动动词——热改
//       dock_edges + relayout + storage 写回全在宿主臂；召唤动词
//       `open_settings` 由 shell.at 齿轮发出，本面板不复用关闭动词——
//       Esc/齿轮再点走宿主二态翻转，待澄清④定案）
//   入：召唤时快照注入——`cfg_dock_position`/`cfg_dock_enabled`（当前
//       驱动事实投影）、`pinned_ids` 平行字符串列表（B12 规避，宿主注入
//       后显式 RebuildPinned 重建 handler 自有 rows）、`cfg_notes_enabled`
//       （479 门控键快照）、`osconfig_state`（501：unknown/ready/offline
//       ——宿主 osconfig_status 三态投影）、`osconfig_hint`（offline 原因）、
//       `about_host`/`about_version`（boot 投影常量）、`hosted`/`visible`。
// pinned 持久化：storage.set("shell.dock.pinned", "id1,id2,…") 直写
// （逗号拼接 = 宿主 load_dock_pinned 解析格式；boot 生效）。
// 快照语义：召唤时点定序；面板打开期间宿主配置变更不重注（设置面板是
// 配置的编辑面，不是配置的监视面）。
// 消费者唯一：宿主 renderer 的 toggle_settings / 设置面板键盘订阅。
widget Settings {
    msg {
        Init, RebuildPinned, Escape, Nav(str),
        PickPosition(str), PickEnabled(str),
        DraftPinned(str), AddPinned, RemovePinned(int),
        PickNotes(str),
        DraftWallpaper(str), SaveWallpaper,
        PickTheme(str), PickTransparency(str),
        OpenSystemSettings
    }

    model {
        // ---- 接缝状态（desktop 宿主注入）----
        var visible str = "0"       // overlay 门控：宿主召唤置 "1"
        var hosted str = "0"        // 宿主挂载时写 "1"
        var __desktop_cmd str = ""  // 上行命令总线（set_dock_* 记录）

        // ---- 分区导航（v3 五分区；501 增系统）----
        var section str = "dock"    // dock | notes | appearance | system | about

        // ---- Dock 分区快照（宿主注入当前驱动事实）----
        var cfg_dock_position str = "bottom"
        var cfg_dock_enabled str = "1"

        // ---- pinned 表（宿主注入平行字符串列表 + handler 自建 rows）----
        var pinned_ids = []
        var pinned_rows = []        // {i,id}
        var pinned_n int = 0        // 行数（view 条件用，替代模板 .len()）
        var pinned_draft str = ""   // 新增项输入框草稿
        var pinned_saved str = "0"  // 已保存提示（写键成功后置 1）

        // ---- 通知分区快照 ----
        var cfg_notes_enabled str = "1"

        // ---- 外观分区（496 M5：壁纸——storage 直写 boot 生效）----
        var cfg_wallpaper str = ""  // 宿主召唤注入当前键值快照
        var wallpaper_draft str = "" // 壁纸输入草稿（路径 | #hex）
        var wallpaper_saved str = "0"
        // PLAN-526 T14：壁纸目录选择（Q8——磁盘图片可选）。__wallpapers =
        // 宿主召唤注入 {name,path,src} Obj 数组（wallpapers_dir storage 键
        // 目录扫描 jpg/png）；dir_draft = 目录输入草稿（storage 直写）。
        var __wallpapers = []
        var wallpapers_dir_draft str = ""
        // ---- Appearance 增量（Plan 518 G1/G6）：主题与透明度快照（宿主
        //      召唤注入;主题切换 = set_theme 驱动动词即时生效,透明度 =
        //      storage 直写虚拟窗每帧读即时生效）----
        var cfg_theme str = "dark"          // dark | light
        var cfg_transparency str = "off"    // off | low | high

        // ---- 系统分区（501）：os-config daemon 状态快照（宿主召唤注入；
        //      unknown = 未检活——面板不预探，首次 launch 才有真值）----
        var osconfig_state str = "unknown" // unknown | ready | offline
        var osconfig_hint str = ""  // offline 原因（宿主投影）

        // ---- 关于分区（boot 投影注入常量）----
        var about_host str = ""
        var about_version str = ""
    }

    view {
        if .visible == "1" {
            // ---- 打开态：全屏暗底 + 居中大卡（switcher palette 同级视觉）----
            col {
                style: "w-full h-full bg-gray-900 flex flex-col items-center"
                spacer { style: "h-32 w-full" }
                col {
                    style: "w-full max-w-2xl bg-gray-800 rounded-2xl shadow-2xl overflow-hidden"

                    // 标题行
                    row {
                        style: "flex items-center gap-2 px-4 py-3 border-b border-gray-700"
                        text "设置" { style: "text-gray-300 text-sm font-semibold" }
                        text "Esc 关闭" { style: "ml-auto text-xs text-gray-500" }
                    }

                    // 主体：左列分区导航 + 右列内容卡
                    row {
                        style: "w-full"

                        // 左列导航（三分区）
                        col {
                            style: "w-36 py-2 border-r border-gray-700"
                            if .section == "dock" {
                                button "Dock" {
                                    style: "w-full h-9 px-0 text-sm bg-gray-700 text-white"
                                }
                            } else {
                                button "Dock" {
                                    onclick: .Nav("dock")
                                    style: "w-full h-9 px-0 text-sm text-gray-400"
                                }
                            }
                            if .section == "notes" {
                                button "通知" {
                                    style: "w-full h-9 px-0 text-sm bg-gray-700 text-white"
                                }
                            } else {
                                button "通知" {
                                    onclick: .Nav("notes")
                                    style: "w-full h-9 px-0 text-sm text-gray-400"
                                }
                            }
                            if .section == "appearance" {
                                button "外观" {
                                    style: "w-full h-9 px-0 text-sm bg-gray-700 text-white"
                                }
                            } else {
                                button "外观" {
                                    onclick: .Nav("appearance")
                                    style: "w-full h-9 px-0 text-sm text-gray-400"
                                }
                            }
                            if .section == "system" {
                                button "系统" {
                                    style: "w-full h-9 px-0 text-sm bg-gray-700 text-white"
                                }
                            } else {
                                button "系统" {
                                    onclick: .Nav("system")
                                    style: "w-full h-9 px-0 text-sm text-gray-400"
                                }
                            }
                            if .section == "about" {
                                button "关于" {
                                    style: "w-full h-9 px-0 text-sm bg-gray-700 text-white"
                                }
                            } else {
                                button "关于" {
                                    onclick: .Nav("about")
                                    style: "w-full h-9 px-0 text-sm text-gray-400"
                                }
                            }
                        }

                        // 右列内容卡（分区占位——控件接线在执行步骤 5/6）
                        col {
                            style: "flex-1 p-4 gap-3"

                            if .section == "dock" {
                                // ---- Dock 分区：位置/开关热生效 + pinned 编辑 ----

                                // 位置卡（bottom/top 单选——驱动动词热生效）
                                col {
                                    style: "gap-2 p-3 bg-gray-750 rounded-lg"
                                    text "位置" { style: "text-gray-200 text-sm font-medium" }
                                    text "任务栏停靠边（立即生效）" { style: "text-gray-500 text-xs" }
                                    row {
                                        style: "gap-2"
                                        if .cfg_dock_position == "bottom" {
                                            button "底部" {
                                                style: "h-8 px-3 text-xs bg-blue-900 text-white rounded-md"
                                            }
                                        } else {
                                            button "底部" {
                                                onclick: .PickPosition("bottom")
                                                style: "h-8 px-3 text-xs text-gray-400"
                                            }
                                        }
                                        if .cfg_dock_position == "top" {
                                            button "顶部" {
                                                style: "h-8 px-3 text-xs bg-blue-900 text-white rounded-md"
                                            }
                                        } else {
                                            button "顶部" {
                                                onclick: .PickPosition("top")
                                                style: "h-8 px-3 text-xs text-gray-400"
                                            }
                                        }
                                    }
                                }

                                // 开关卡（启用/停用——驱动动词热生效）
                                col {
                                    style: "gap-2 p-3 bg-gray-750 rounded-lg"
                                    text "启用任务栏" { style: "text-gray-200 text-sm font-medium" }
                                    row {
                                        style: "gap-2"
                                        if .cfg_dock_enabled == "1" {
                                            button "开" {
                                                style: "h-8 px-3 text-xs bg-blue-900 text-white rounded-md"
                                            }
                                        } else {
                                            button "开" {
                                                onclick: .PickEnabled("1")
                                                style: "h-8 px-3 text-xs text-gray-400"
                                            }
                                        }
                                        if .cfg_dock_enabled == "0" {
                                            button "关" {
                                                style: "h-8 px-3 text-xs bg-blue-900 text-white rounded-md"
                                            }
                                        } else {
                                            button "关" {
                                                onclick: .PickEnabled("0")
                                                style: "h-8 px-3 text-xs text-gray-400"
                                            }
                                        }
                                    }
                                }

                                // pinned 编辑卡（storage 键直写——boot 生效）
                                col {
                                    style: "gap-2 p-3 bg-gray-750 rounded-lg"
                                    text "固定应用（pinned）" { style: "text-gray-200 text-sm font-medium" }
                                    if .pinned_saved == "1" {
                                        text "已保存，重启后生效" { style: "text-success text-xs" }
                                    } else {
                                        text "增删后重启生效" { style: "text-gray-500 text-xs" }
                                    }
                                    if .pinned_n == 0 {
                                        text "（空）" { style: "text-gray-500 text-xs" }
                                    }
                                    for r in .pinned_rows {
                                        row {
                                            style: "items-center gap-2"
                                            text r.id { style: "flex-1 text-gray-300 text-xs" }
                                            button "×" {
                                                onclick: .RemovePinned(r.i)
                                                style: "h-6 w-6 px-0 text-xs text-muted-foreground"
                                            }
                                        }
                                    }
                                    row {
                                        style: "items-center gap-2"
                                        input {
                                            value: .pinned_draft
                                            oninput: .DraftPinned
                                            placeholder: "app id，如 011-calculator"
                                            style: "flex-1 text-sm text-white bg-gray-900"
                                        }
                                        button "添加" {
                                            onclick: .AddPinned
                                            style: "h-8 px-3 text-xs"
                                        }
                                    }
                                }
                            } else {
                                if .section == "notes" {
                                    // ---- 通知分区：持久化开关（storage 直写，
                                    // 479 持久化链门控消费——重启保持）----
                                    col {
                                        style: "gap-2 p-3 bg-gray-750 rounded-lg"
                                        text "通知" { style: "text-gray-200 text-sm font-medium" }
                                        text "关闭后 App 通知（notify 动词）不再入史/浮现/计未读，重启保持" { style: "text-gray-500 text-xs" }
                                        row {
                                            style: "gap-2"
                                            if .cfg_notes_enabled == "1" {
                                                button "开" {
                                                    style: "h-8 px-3 text-xs bg-blue-900 text-white rounded-md"
                                                }
                                            } else {
                                                button "开" {
                                                    onclick: .PickNotes("1")
                                                    style: "h-8 px-3 text-xs text-gray-400"
                                                }
                                            }
                                            if .cfg_notes_enabled == "0" {
                                                button "关" {
                                                    style: "h-8 px-3 text-xs bg-blue-900 text-white rounded-md"
                                                }
                                            } else {
                                                button "关" {
                                                    onclick: .PickNotes("0")
                                                    style: "h-8 px-3 text-xs text-gray-400"
                                                }
                                            }
                                        }
                                        text "立即生效" { style: "text-gray-500 text-xs" }
                                    }
                                } else {
                                    if .section == "appearance" {
                                        // ---- Appearance 分区（496 M5 壁纸 +
                                        //     518 G1 主题切换 + G6 透明度三档）----
                                        col {
                                            style: "gap-3"

                                            // 主题卡（Plan 518 G1：set_theme
                                            // 驱动动词——set_dock_position 同型,
                                            // 宿主臂 set_dark_mode 即时生效 +
                                            // shell.appearance.theme 持久化）。
                                            col {
                                                style: "gap-2 p-3 bg-gray-750 rounded-lg"
                                                text "深色模式" { style: "text-gray-200 text-sm font-medium" }
                                                text "浅色 = 暖纸主题（stella 对齐），立即生效" { style: "text-gray-500 text-xs" }
                                                row {
                                                    style: "gap-2"
                                                    if .cfg_theme == "dark" {
                                                        button "深色" {
                                                            style: "h-8 px-3 text-xs bg-blue-900 text-white rounded-md"
                                                        }
                                                    } else {
                                                        button "深色" {
                                                            onclick: .PickTheme("dark")
                                                            style: "h-8 px-3 text-xs text-gray-400"
                                                        }
                                                    }
                                                    if .cfg_theme == "light" {
                                                        button "浅色" {
                                                            style: "h-8 px-3 text-xs bg-blue-900 text-white rounded-md"
                                                        }
                                                    } else {
                                                        button "浅色" {
                                                            onclick: .PickTheme("light")
                                                            style: "h-8 px-3 text-xs text-gray-400"
                                                        }
                                                    }
                                                }
                                            }

                                            // 透明度卡（Plan 518 G6：storage 直写
                                            // shell.desktop.transparency,虚拟窗
                                            // 底色 alpha 每帧读即时生效）。
                                            col {
                                                style: "gap-2 p-3 bg-gray-750 rounded-lg"
                                                text "透明度" { style: "text-gray-200 text-sm font-medium" }
                                                text "窗口底色透出壁纸（关/低/高），立即生效" { style: "text-gray-500 text-xs" }
                                                row {
                                                    style: "gap-2"
                                                    if .cfg_transparency == "off" {
                                                        button "关" {
                                                            style: "h-8 px-3 text-xs bg-blue-900 text-white rounded-md"
                                                        }
                                                    } else {
                                                        button "关" {
                                                            onclick: .PickTransparency("off")
                                                            style: "h-8 px-3 text-xs text-gray-400"
                                                        }
                                                    }
                                                    if .cfg_transparency == "low" {
                                                        button "低" {
                                                            style: "h-8 px-3 text-xs bg-blue-900 text-white rounded-md"
                                                        }
                                                    } else {
                                                        button "低" {
                                                            onclick: .PickTransparency("low")
                                                            style: "h-8 px-3 text-xs text-gray-400"
                                                        }
                                                    }
                                                    if .cfg_transparency == "high" {
                                                        button "高" {
                                                            style: "h-8 px-3 text-xs bg-blue-900 text-white rounded-md"
                                                        }
                                                    } else {
                                                        button "高" {
                                                            onclick: .PickTransparency("high")
                                                            style: "h-8 px-3 text-xs text-gray-400"
                                                        }
                                                    }
                                                }
                                            }

                                            // 壁纸卡（496 M5）：路径/色值 storage
                                            // 直写——boot 解析（#hex 直传/路径验在/
                                            // 坏值回退默认色），重启生效。
                                            // PLAN-526 T14：+ 壁纸目录扫描缩略图
                                            // （点选即 set_wallpaper 热切换）。
                                            col {
                                                style: "gap-2 p-3 bg-gray-750 rounded-lg"
                                                text "壁纸" { style: "text-gray-200 text-sm font-medium" }
                                                text "图片路径或 #hex 色值（如 #243b55）；内置宣纸/水墨可填 builtin:ricepaper / builtin:inkwash，重启后生效" { style: "text-gray-500 text-xs" }
                                                row {
                                                    style: "items-center gap-2"
                                                    input {
                                                        value: .wallpaper_draft
                                                        oninput: .DraftWallpaper
                                                        placeholder: "D:\\wallpaper.png 或 #243b55"
                                                        style: "flex-1 text-sm text-white bg-gray-900"
                                                    }
                                                    button "保存" {
                                                        onclick: .SaveWallpaper
                                                        style: "h-8 px-3 text-xs"
                                                    }
                                                }
                                                if .wallpaper_saved == "1" {
                                                    text "已保存，重启后生效" { style: "text-success text-xs" }
                                                } else {
                                                    row {
                                                        style: "items-center gap-2"
                                                        text "当前：" { style: "text-gray-500 text-xs" }
                                                        text .cfg_wallpaper { style: "text-gray-300 text-xs" }
                                                    }
                                                }
                                                // PLAN-526 T14：壁纸目录（storage
                                                // shell.desktop.wallpapers_dir 直
                                                // 写；重开面板扫描）+ 缩略图点选
                                                // （set_wallpaper 动词即时生效+持久）。
                                                row {
                                                    style: "items-center gap-2"
                                                    input {
                                                        value: .wallpapers_dir_draft
                                                        oninput: .DraftWallpapersDir
                                                        placeholder: "壁纸目录，如 D:\\Down\\stella-os\\wallpapers"
                                                        style: "flex-1 text-sm text-white bg-gray-900"
                                                    }
                                                    button "保存目录" {
                                                        onclick: .SaveWallpapersDir
                                                        style: "h-8 px-3 text-xs"
                                                    }
                                                }
                                                if .__wallpapers.len() > 0 {
                                                    grid (cols: 4, gap: 8) {
                                                        style: "w-full"
                                                        for wp in .__wallpapers {
                                                            button {
                                                                onclick: .PickWallpaper(wp.path)
                                                                style: "w-full h-20 p-0 bg-transparent rounded-lg overflow-hidden hover:bg-primary/10"
                                                                image (src: wp.src) {
                                                                    style: "w-full h-full object-cover"
                                                                }
                                                            }
                                                        }
                                                    }
                                                    text "点选缩略图立即更换壁纸" { style: "text-gray-500 text-xs" }
                                                } else {
                                                    text "未配置壁纸目录或目录无 jpg/png 图片" { style: "text-gray-600 text-xs" }
                                                }
                                            }
                                        }
                                    } else {
                                        if .section == "system" {
                                            // ---- 系统分区（501）：外部仓 os-config
                                            //     App 入口——launch 全链在宿主臂
                                            //    （daemon 检活/spawn/env 注入；
                                            //     offline 徽标 = 置灰 + 提示，
                                            //     点击即重试——launch 每次重新探活）----
                                            col {
                                                style: "gap-2 p-3 bg-gray-750 rounded-lg"
                                                text "系统设置（全部模块）" { style: "text-gray-200 text-sm font-medium" }
                                                if .osconfig_state == "ready" {
                                                    text "auto-os-config daemon 已就绪" { style: "text-success text-xs" }
                                                } else {
                                                    if .osconfig_state == "offline" {
                                                        text "daemon 不可用，点击重试" { style: "text-warning text-xs" }
                                                        text .osconfig_hint { style: "text-gray-500 text-xs" }
                                                    } else {
                                                        text "打开 auto-os-config 配置中心" { style: "text-gray-500 text-xs" }
                                                    }
                                                }
                                                if .osconfig_state == "offline" {
                                                    button "重试并打开系统设置" {
                                                        onclick: .OpenSystemSettings
                                                        style: "h-8 px-3 text-xs text-gray-500"
                                                    }
                                                } else {
                                                    button "打开系统设置" {
                                                        onclick: .OpenSystemSettings
                                                        style: "h-8 px-3 text-xs bg-blue-900 text-white rounded-md"
                                                    }
                                                }
                                            }
                                        } else {
                                    // ---- 关于分区：宿主版本/平台（召唤注入常量）----
                                    col {
                                        style: "gap-2 p-3 bg-gray-750 rounded-lg"
                                        text "关于" { style: "text-gray-200 text-sm font-medium" }
                                        row {
                                            style: "items-center gap-2"
                                            text "宿主平台" { style: "w-24 text-gray-500 text-xs" }
                                            text .about_host { style: "text-gray-300 text-xs" }
                                        }
                                        row {
                                            style: "items-center gap-2"
                                            text "宿主版本" { style: "w-24 text-gray-500 text-xs" }
                                            text .about_version { style: "text-gray-300 text-xs" }
                                        }
                                    }
                                    }
                                    }
                                }
                            }
                        }
                    }
                }
                spacer { style: "h-32 w-full" }
            }
        } else {
            // ---- 隐藏态：透明空层（不挡桌面点击；装配层仅 visible 时推层）----
            col {
                style: "w-full h-full"
            }
        }
    }

    bind {
        "Escape" -> .Escape
    }

    on {
        .Init -> {
            .visible = "0"
            .section = "dock"
            .RebuildPinned()
        }

        // 宿主召唤时显式调用（宿主写状态不触发 handler）：平行列表 →
        // handler 自有 rows（此后增删下标读安全）。
        .RebuildPinned -> {
            .pinned_rows = []
            .pinned_n = 0
            var idx int = 0
            while idx < .pinned_ids.len() {
                var row = { i: idx, id: .pinned_ids[idx] }
                .pinned_rows.push(row)
                idx = idx + 1
            }
            .pinned_n = .pinned_rows.len()
        }

        // 分区导航（dock/notes/appearance/system/about；未知值忽略）。
        .Nav(s) -> {
            if s == "dock" {
                .section = "dock"
            } else {
                if s == "notes" {
                    .section = "notes"
                } else {
                    if s == "appearance" {
                        .section = "appearance"
                    } else {
                        if s == "system" {
                            .section = "system"
                        } else {
                            if s == "about" {
                                .section = "about"
                            }
                        }
                    }
                }
            }
        }

        // ---- Dock 分区：位置/开关 → 驱动动词（I7：几何是驱动事实，
        // 执行臂改 dock_edges + relayout + storage 写回；面板只记记录）----
        .PickPosition(p) -> {
            if p == "top" {
                .cfg_dock_position = "top"
            } else {
                .cfg_dock_position = "bottom"
            }
            .__desktop_cmd = "set_dock_position\t" + .cfg_dock_position
        }

        .PickEnabled(v) -> {
            if v == "1" {
                .cfg_dock_enabled = "1"
            } else {
                .cfg_dock_enabled = "0"
            }
            .__desktop_cmd = "set_dock_enabled\t" + v
        }

        // ---- 通知分区：持久化开关 → storage 直写（479 持久化链
        // push_notification 门控消费；"false" = 关，其余/缺席 = 开）----
        .PickNotes(v) -> {
            if v == "1" {
                .cfg_notes_enabled = "1"
                storage.set("shell.notes.enabled", "true")
            } else {
                .cfg_notes_enabled = "0"
                storage.set("shell.notes.enabled", "false")
            }
        }

        // ---- 外观分区（496 M5）：壁纸 storage 直写（boot 解析生效——
        // #hex 直传/路径验在/坏值回退默认色；487 非几何无动词判定同款）----
        .DraftWallpaper(v) -> {
            .wallpaper_draft = v
        }

        .SaveWallpaper -> {
            if .wallpaper_draft != "" {
                storage.set("shell.desktop.wallpaper", .wallpaper_draft)
                .cfg_wallpaper = .wallpaper_draft
                .wallpaper_draft = ""
                .wallpaper_saved = "1"
            }
        }

        // ---- PLAN-526 T14：壁纸目录与缩略图点选（Q8 闭环）----
        // 目录 = storage 直写（重开面板/重启扫描生效）；缩略图 = set_wallpaper
        // 驱动动词（宿主臂 storage 持久 + 会话字段回读 + 快照撤——即时生效，
        // 无需重启；SetTheme 同链先例）。
        .DraftWallpapersDir(v) -> {
            .wallpapers_dir_draft = v
        }

        .SaveWallpapersDir -> {
            if .wallpapers_dir_draft != "" {
                storage.set("shell.desktop.wallpapers_dir", .wallpapers_dir_draft)
            }
        }

        .PickWallpaper(p) -> {
            .cfg_wallpaper = p
            .wallpaper_saved = "0"
            .__desktop_cmd = "set_wallpaper\t" + p
        }

        // ---- Appearance 增量（Plan 518 G1/G6）：主题 = set_theme 驱动动词
        //（宿主臂 set_dark_mode 即时生效 + shell.appearance.theme 持久化）;
        // 透明度 = storage 直写（虚拟窗底色每帧读,即时生效）----
        .PickTheme(v) -> {
            if v == "light" {
                .cfg_theme = "light"
            } else {
                .cfg_theme = "dark"
            }
            .__desktop_cmd = "set_theme\t" + .cfg_theme
        }

        .PickTransparency(v) -> {
            if v == "low" {
                .cfg_transparency = "low"
            } else {
                if v == "high" {
                    .cfg_transparency = "high"
                } else {
                    .cfg_transparency = "off"
                }
            }
            storage.set("shell.desktop.transparency", .cfg_transparency)
        }

        // ---- pinned 编辑 → storage 键直写（boot 生效；逗号拼接 = 宿主
        // load_dock_pinned 解析格式）----
        .DraftPinned(v) -> {
            .pinned_draft = v
        }

        .AddPinned -> {
            if .pinned_draft != "" {
                .pinned_rows.push({ i: .pinned_n, id: .pinned_draft })
                .pinned_n = .pinned_n + 1
                .pinned_draft = ""
                .PersistPinned()
            }
        }

        .RemovePinned(i) -> {
            var rows = []
            var idx int = 0
            var n int = 0
            while idx < .pinned_n {
                if idx != i {
                    rows.push({ i: n, id: .pinned_rows[idx].id })
                    n = n + 1
                }
                idx = idx + 1
            }
            .pinned_rows = rows
            .pinned_n = n
            .PersistPinned()
        }

        .PersistPinned -> {
            var s str = ""
            var idx int = 0
            while idx < .pinned_n {
                if idx > 0 {
                    s = s + ","
                }
                s = s + .pinned_rows[idx].id
                idx = idx + 1
            }
            storage.set("shell.dock.pinned", s)
            .pinned_saved = "1"
        }

        // ---- 系统分区（501）：launch 记录上行（宿主 launch 臂全链——daemon
        // 检活/spawn/AUTOOS_DAEMON env 注入 + build 装载 + 开虚拟窗）；发完
        // 自隐（App 在面板之下开窗，Esc 同型自隐语义）。offline 态同一动词
        //（点击 = 重试——launch 每次重新探活，重试语义零额外动词）----
        .OpenSystemSettings -> {
            .__desktop_cmd = "launch\tos-config"
            .visible = "0"
        }

        // Esc 关闭：自隐（宿主二态翻转语义的另一半——再召唤由宿主臂翻转）。
        .Escape -> {
            if .visible == "1" {
                .visible = "0"
            }
        }
    }
}
