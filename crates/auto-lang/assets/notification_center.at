// notification_center overlay pack（特权 .at App —— 宿主进程内编译装载，
// 不进 examples/ui；Plan 479 T3，464/478 overlay 槽同型的第三枚）。
//
// 形态：notes_toggle 召唤的通知中心——历史列表面板（右下锚定卡片，避开
// bottom-center toast 区；T1 施工图定案 2），逐条 × / 全部清除 / Esc 关。
// 无键盘导航（v1）——bind 仅 Escape。
//
// 关闭模型（PLAN-012 W2 定型，SD-04；macOS 对标）：本面板 = **通知中心**
// 语义——不做定时自动关，人工关闭三路径 = × 按钮 / 点面板外（scrim）/
// Esc（宿主键盘订阅）。toast = **banner** 语义，TTL 自动过期（宿主
// renderer toasts.retain 在案）——两者不再混谈。若后续需要"闲置自动
// 收起"，走新需求（storage 开关 + ServiceTick 计时）。
//
// 锚定（PLAN-012 W2 T4 定案，scratch/p012 同族探针在 auto-lang
// layout_tests::w2_notification_panel_anchor_bottom_right）：顶部
// `flex-1` spacer 在 iced 轨塌缩（端到端 .at 管线实测 y=0，实机截图
// 互证）→ 改 `mt-auto` 填充条路径（Plan-050 已验证机制，实测 y=384
// 下压生效）；行内 h-80 垫高退役 + items-end 底对齐 → 卡片紧贴 dock
// 上方；右距 w-3 = 底垫视觉 gap 12px 对称（底垫 h-[60px] = dock 48 +
// gap 12）。
//
// 接缝（协议 v1.2，schema/projection-protocol-v1.md）：
//   出：`__desktop_cmd`（`notes_dismiss\t<id>` 逐条删 / `notes_clear` 全清；
//       宿主读+清；开关经 shell 铃铛钮的 notes_toggle，不在本 App）
//   入：召唤时快照注入——note_ids/note_kinds/note_msgs/note_ats 平行字符串
//       列表（B12：宿主注入 Obj 数组的 handler 字段读失效，launcher apps_*
//       同型；`RebuildNotes` 由宿主显式调用重建 handler 自有 rows）、
//       `__wm_notes`/`__wm_notes_unread`（合同面 Obj 数组/串，本 App 声明不
//       handler 消费）、`hosted`/`visible`。
// 快照语义：召唤时点定序；打开期间新通知/删除由宿主重注入（479
// refresh_notification_panel——打开期间列表活更新）。
// 消费者唯一：宿主 renderer 的 toggle_notification_center /
// refresh_notification_panel / 通知面板键盘订阅。
widget NotificationCenter {
    msg { Init, RebuildNotes, Escape, Close, Dismiss(str), ClearAll }

    model {
        // ---- 接缝状态（desktop 宿主注入）----
        var visible str = "0"       // overlay 门控：宿主召唤置 "1"
        var hosted str = "0"        // 宿主挂载时写 "1"
        var __desktop_cmd str = ""  // 上行命令总线（dismiss/clear 记录）
        var __wm_notes = []         // 协议 v1.2 合同面（声明不 handler 消费）
        var __wm_notes_unread str = ""  // 协议 v1.2 合同面（badge 源在 shell）
        // PLAN-012 O3：历史列表最大高（宿主按视口注入，px，紧凑面板 55%
        // 档）——条目多时列表滚动，卡片恒为右下角紧凑卡（实机 6 条 ~110px
        // 条目 ≈ 790px 满高清偿）。锚定与 scrim 在装配层（renderer 通知层
        // 推臂），.at 内 mt-auto/根高类在真实 Stack 子层不可依赖已退役。
        var __panel_max_h int = 560

        // ---- 通知快照（宿主注入平行字符串列表；B12 规避）----
        var note_ids = []
        var note_kinds = []
        var note_msgs = []
        var note_ats = []

        // ---- 面板状态（handler 自建 rows；view 消费 + handler 下标读安全）----
        var rows = []               // {i,id,kind,msg,at}
        var nrows int = 0           // 条目数（view 条件用，替代模板 .len()）
    }

    view {
        if .visible == "1" {
            // ---- 打开态：紧凑卡片（PLAN-012 O3 终解）：scrim 外点关闭 =
            // N6d 模式（用户走查已验证）；贴顶 = justify-start 列顶对齐
            // （真实链验证机制——mt-auto/填充条/col-reverse 在真实 Stack
            // 子层不可依赖，复验三连贴顶 0 实证）。卡片守卫 = 内层
            // mouse-area 幂等动作（卡片本体内点不关闭）。----
            mouse-area (onclick: .Close) {
                style: "w-full h-full"
                col {
                    style: "w-full h-full justify-start"
                    row {
                        style: "w-full justify-end"
                        // PLAN-010 N6d：卡片守卫——onclick 幂等动作
                        // （RebuildNotes 纯重算）吞掉卡片本体内点。
                        mouse-area (onclick: .RebuildNotes, style: "w-80 mr-3 pt-3") {
                            col {
                                // Plan 503：glass 三件套（bg-card/80 + 细边框 + 柔影）
                                style: "w-full bg-card/80 border rounded-xl shadow-xl overflow-hidden"

                                // 标题行：通知 + × 关闭 + 全部清除
                                // （PLAN-012 W2：× 人工关闭路径之一，同一自隐臂）
                                row {
                                    style: "flex items-center px-4 py-3 border-b"
                                    text "通知" { style: "text-foreground text-sm font-semibold" }
                                    button (icon: "x") {
                                        onclick: .Close
                                        style: "ml-auto h-7 w-7 px-0 text-xs text-muted-foreground rounded hover:bg-primary/10"
                                    }
                                    button "全部清除" {
                                        onclick: .ClearAll
                                        style: "h-7 px-2 text-xs text-muted-foreground rounded hover:bg-primary/10"
                                    }
                                }

                                // 历史列表（MRU 序；空态）。PLAN-012 O3：
                                // max-h + overflow-y-auto（028-launcher T38
                                // 先例）——条目多时列表滚动，卡片恒为紧凑卡。
                                col {
                                    style: "w-full max-h-[${.__panel_max_h}px] overflow-y-auto"
                                    if .nrows == 0 {
                                        col {
                                            // PLAN-013 W3：补 w-full——容器无宽则收缩
                                            // 到内容宽，items-center 居中退化无效
                                            // （用户实机截图：文案贴左）。
                                            style: "w-full flex flex-col items-center py-8"
                                            text "暂无通知" { style: "text-muted-foreground text-sm" }
                                        }
                                    }
                                    for r in .rows {
                                        row {
                                            style: "flex items-center gap-3 px-4 py-2 border-b cursor-pointer"
                                            if r.kind == "success" {
                                                icon (name: "check") { style: "h-4 w-4 text-success" }
                                            } else {
                                                if r.kind == "error" {
                                                    // PLAN-012 F2（用户裁定）：错误 ❗
                                                    // （原 x 与右侧关闭钮混淆）。
                                                    icon (name: "circle-alert") { style: "h-4 w-4 text-error" }
                                                } else {
                                                    icon (name: "info") { style: "h-4 w-4 text-muted-foreground" }
                                                }
                                            }
                                            col {
                                                style: "flex-1 gap-0"
                                                text r.msg { style: "text-foreground text-sm" }
                                                text r.at { style: "text-muted-foreground text-xs" }
                                            }
                                            button "×" {
                                                onclick: .Dismiss(r.id)
                                                style: "h-7 w-7 px-0 text-xs text-muted-foreground rounded hover:bg-primary/10"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        } else {
            // ---- 隐藏态：透明空层（不挡桌面点击；装配层仅 visible 时推层）----
            col {
                style: "w-full h-full"
            }
        }
    }

    bind {
        "Escape" -> .Escape
    }

    on {
        .Init -> {
            .visible = "0"
            .RebuildNotes()
        }

        // 宿主召唤/活更新时显式调用（宿主写状态不触发 handler）：平行列表 →
        // handler 自有 rows（此后 .Dismiss 参数源安全），MRU 序 front=最新。
        .RebuildNotes -> {
            .rows = []
            .nrows = 0
            var idx int = 0
            while idx < .note_ids.len() {
                var row = { i: idx, id: .note_ids[idx], kind: .note_kinds[idx], msg: .note_msgs[idx], at: .note_ats[idx] }
                .rows.push(row)
                idx = idx + 1
            }
            .nrows = .rows.len()
        }

        // 逐条 ×：写上行总线（删除执行 + 落盘 + 重注入在宿主臂）。
        .Dismiss(id) -> {
            .__desktop_cmd = "notes_dismiss\t" + id
        }

        // 全部清除：写上行总线。
        .ClearAll -> {
            .__desktop_cmd = "notes_clear"
        }

        // Esc 关闭：自隐（未读已在打开时清零，关闭不加未读——visible 门控）。
        .Escape -> {
            if .visible == "1" {
                .visible = "0"
            }
        }

        // PLAN-012 W2：× / scrim 外点关闭——与 Esc 同一自隐臂语义
        // （不加未读、不动历史；宿主 notification_visible 直读 visible，
        // __wm_notes_visible 投影随动 → 铃铛高亮同步回落）。
        .Close -> {
            if .visible == "1" {
                .visible = "0"
            }
        }
    }
}
