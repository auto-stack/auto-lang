### Auto
path: "sizes.at"
```auto
use.rs std::fs

fn main() ! {
    var total = 0
    let entries = fs.read_dir(".").?
    for entry in entries {
        let entry = entry.?
        let meta = entry.metadata().?
        total = total + meta.len()
    }
    assert(total >= 0)
}
