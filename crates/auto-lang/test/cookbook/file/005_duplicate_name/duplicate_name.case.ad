### Auto
path: "duplicate_name.at"
```auto
use.rs std::collections::HashMap
use.rs std::fs

fn main() ! {
    var seen HashMap<str, bool> = HashMap.new()
    let entries = fs.read_dir(".").?
    for entry in entries {
        let entry = entry.?
        let name = entry.file_name()
        let name_str = name.to_str().unwrap()
        if seen.contains_key(name_str) {
            print(f"Duplicate: $name_str")
        } else {
            seen.insert(name_str.to_string(), true)
        }
    }
    assert(true)
}
```

