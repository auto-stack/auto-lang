use.rs std::collections::HashSet

fn visit(path str, visited HashSet<str>) {
    if !visited.contains(path) {
        visited.insert(path)
    } else {
        print(f"Loop detected: ${path}")
    }
}

fn main() {
    var visited HashSet<str> = HashSet.new()
    visit(".", visited)
    assert(visited.contains("."))
}
```

