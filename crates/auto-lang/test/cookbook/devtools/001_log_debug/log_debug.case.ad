id: "legacy.cookbook.devtools.001_log_debug"
entry-mode: "program"

### Auto
path: "log_debug.at"
```auto
dep env_logger
use.rs log::debug
use.rs log::info

fn main() {
    env_logger.init()
    debug("starting operation")
    let value = 42
    debug(f"value = ${value}")
    assert(value == 42)
}
