entry-mode: "program"

### Auto
path: "log_mod.at"
```auto
dep env_logger
use.rs log::info
use.rs log::debug

mod network {
    use.rs log::debug

    pub fn connect() {
        debug("connecting to server")
    }
}

fn process() {
    debug("processing step 1")
    debug("processing step 2")
    info("processing complete")
}

fn main() {
    env_logger.init()
    info("app started")
    network.connect()
    process()
    print("done")
    assert(true)
}
```

