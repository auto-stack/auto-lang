dep simplelog
dep log
use.rs log::info
use.rs simplelog::WriteLogger
use.rs simplelog::LevelFilter
use.rs simplelog::Config

fn main() {
    let file = File.create("app.log").unwrap()
    WriteLogger.init(LevelFilter.Info, Config.default(), file).unwrap()
    info("logging to custom file")
    assert(true)
}
