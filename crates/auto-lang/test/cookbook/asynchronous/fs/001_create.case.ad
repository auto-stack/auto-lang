// File and directory creation
fn main() ! {
    let _ = File.write_text("data.txt", "hello").?
    let _ = File.create_dir("my_dir").?
    let _ = File.create_dir("my_dir/sub_dir/inner").?
    print("Files and directories created")
    assert(true)
}
