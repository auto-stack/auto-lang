// Auto-generated by a2r transpiler

use crossbeam;
fn main() {
    crossbeam::scope(|s| { s.spawn(|_| { println!("Hello from scoped thread 1")}); s.spawn(|_| { println!("Hello from scoped thread 2")})}).unwrap();
    assert!(true);
}
