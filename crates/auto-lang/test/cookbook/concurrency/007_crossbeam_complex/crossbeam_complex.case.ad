// Auto-generated by a2r transpiler

fn main() {
    let messages: Vec<String> = vec!["hello".to_string(), "world".to_string()];
    let mut msg_count: i64 = 0;
    for msg in &messages {
        msg_count += 1;
        if msg.as_str() == "world" {
            break;
        }
    }
    assert!(msg_count == 2);
}
