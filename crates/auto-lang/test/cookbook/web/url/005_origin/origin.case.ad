### Auto
path: "origin.at"
```auto
dep url
use.rs url::Url

fn main() {
    let url = Url.parse("https://user:pass@example.com:8080/path?query=1#frag").unwrap()
    let scheme = url.scheme()
    let host = url.host_str()
    assert(scheme == "https")
    assert(host == "example.com")
}
```

