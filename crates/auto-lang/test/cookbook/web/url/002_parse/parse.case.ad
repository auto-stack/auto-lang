// Auto-generated by a2r transpiler

use url::Url;
fn main() {
    let url = Url::parse("https://example.com/rust?name=hello&age=20").unwrap();

    let query = url.query();
    println!("Query string: {}", query);

    let query = url.query();
    let mut pair_count: i64 = 0;
    for pair in url.query_pairs() {
        pair_count += 1;
    }
    assert!(pair_count == 2);
}
```
