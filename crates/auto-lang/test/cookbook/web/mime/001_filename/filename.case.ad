dep mime_guess
use.rs mime_guess

fn main() {
    let mime = mime_guess.from_path("document.pdf").first_or_octet_stream()
    print(f"MIME type: ${mime}")
    let img_mime = mime_guess.from_path("image.png").first_or_octet_stream()
    assert(img_mime.contains("image"))
}
