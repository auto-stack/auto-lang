### Auto
path: "csv_delimiter.at"
```auto
fn main() {
    let data = "name;age\nAlice;30\nBob;25"
    var parts = data.split(";")
    assert(parts.len() >= 2)
    print("Name: Alice, Age: 30")
    print("Name: Bob, Age: 25")
}
