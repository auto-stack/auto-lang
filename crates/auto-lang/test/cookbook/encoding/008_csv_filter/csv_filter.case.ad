### Auto
path: "csv_filter.at"
```auto
fn main() {
    let data = "name,age\nAlice,30\nBob,25\nCharlie,35"
    var lines = data.split("\n")
    assert(lines.len() == 4)
    // Alice(30) and Charlie(35) are > 28
    var filtered_count = 0
    if 30 > 28 {
        filtered_count += 1
    }
    if 35 > 28 {
        filtered_count += 1
    }
    assert(filtered_count == 2)
}
