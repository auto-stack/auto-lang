// Auto-generated by a2r transpiler

use rand;
use rand::Rng;
fn main() {
    let mut rng = rand::thread_rng();
    let n: i64 = rng.gen_range(0..100);
    let in_range: bool = n >= 0;
    assert!(in_range);
}
