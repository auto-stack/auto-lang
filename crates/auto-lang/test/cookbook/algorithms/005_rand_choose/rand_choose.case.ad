// Random choice demo
use.rs rand

fn main() {
    var rng = rand.thread_rng()
    let choices = ["a", "b", "c", "d", "e"]
    let idx = rng.gen_range(0..choices.len())
    let choice = choices[idx]
    let valid = idx >= 0
    assert(valid)
}
