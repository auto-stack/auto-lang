// Auto-generated by a2r transpiler

use rand;
use rand::Rng;
use rand_distr;
fn main() -> Result<(), Box<dyn std::error::Error>> {
    let mut rng = rand::thread_rng();
    let mut normal = rand_distr::Normal::new(2.0, 3.0)?;
    let v: f64 = rng.sample(normal);
    assert!(true)
}
