// Normal distribution sample demo
use.rs rand
use.rs rand_distr

fn main() ! {
    var rng = rand.thread_rng()
    var normal = Normal.new(2.0, 3.0).?
    let v f64 = rng.sample(normal)
    assert(true)
}
