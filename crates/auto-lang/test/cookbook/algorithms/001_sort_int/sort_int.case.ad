use.rs std::vec::Vec

fn main() {
    var vec = [1, 5, 10, 2, 15]
    vec.sort()
    assert(vec[0] == 1)
    assert(vec[1] == 2)
    assert(vec[2] == 5)
    assert(vec[3] == 10)
    assert(vec[4] == 15)
}
