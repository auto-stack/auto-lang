// Auto-generated by a2r transpiler

use std::vec::Vec;
fn main() {
    let mut vec: Vec<i64> = vec![1, 5, 10, 2, 15];
    vec.sort();
    assert!(vec[0].clone() == 1);
    assert!(vec[1].clone() == 2);
    assert!(vec[2].clone() == 5);
    assert!(vec[3].clone() == 10);
    assert!(vec[4].clone() == 15);
}
