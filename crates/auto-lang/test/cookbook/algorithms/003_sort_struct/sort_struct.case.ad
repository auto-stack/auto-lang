#### sort_struct.rs
```rust
// Auto-generated by a2r transpiler

use std::vec::Vec;
#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Person {
    pub name: String,
    pub age: u32,
}

fn main() {
    let mut people = vec![Person { name: "Zoe".to_string(), age: 25 as u32 }, Person { name: "Al".to_string(), age: 60 as u32 }, Person { name: "John".to_string(), age: 1 as u32 }];



    people.sort();


    people.sort_by_key(|p| p.age);
    assert!(people[0].clone().name == "Zoe");
    assert!(people[1].clone().name == "Al");
    assert!(people[2].clone().name == "John");
}
```
