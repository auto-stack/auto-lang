## Case: legacy-cookbook-os-006-send-input
id: "legacy.cookbook.os.006_send_input"
entry-mode: "program"

### Auto
path: "send_input.at"
```auto
use.rs std::io::Write
use.rs std::process::Command
use.rs std::process::Stdio

fn main() {
    var child = Command.new("cat").stdin(Stdio.piped()).stdout(Stdio.piped()).spawn().unwrap()

    let stdin = child.stdin.as_mut().unwrap()
    stdin.write_all("hello from stdin".as_bytes())

    let output = child.wait_with_output().unwrap()
    let stdout = String.from_utf8(output.stdout).unwrap()
    assert(stdout.contains("hello"))
}
```

