fn main() {
    env.set("AUTO_TEST_240", "hello")
    let val = env.get_or("AUTO_TEST_240", "default")
    assert(val == "hello")

    let missing = env.get_or("AUTO_NONEXISTENT_240", "fallback")
    assert(missing == "fallback")
}
