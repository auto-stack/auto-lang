### Auto
path: "process_output.at"
```auto
use.rs std::process::Command

fn main() {
    let output = Command.new("ls").args(["-la"]).output().unwrap()
    let stdout = String.from_utf8(output.stdout).unwrap()
    // Verify ls command produces output
    assert(stdout.len() > 0)
}
