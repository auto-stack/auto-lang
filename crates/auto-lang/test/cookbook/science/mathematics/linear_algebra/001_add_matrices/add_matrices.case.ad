// Auto-generated by a2r transpiler

fn main() {
    let a: Vec<Vec<i64>> = vec![vec![1, 2], vec![3, 4]];
    let b: Vec<Vec<i64>> = vec![vec![5, 6], vec![7, 8]];
    let mut c: Vec<Vec<i64>> = vec![vec![0, 0], vec![0, 0]];
    for i in 0..2 {
        for j in 0..2 {
            c[(i) as usize][(j) as usize] = a[(i) as usize].clone()[(j) as usize].clone() + b[(i) as usize].clone()[(j) as usize].clone();
        }
    }
    assert!(c[0].clone()[0].clone() == 6);
    assert!(c[0].clone()[1].clone() == 8);
    assert!(c[1].clone()[0].clone() == 10);
    assert!(c[1].clone()[1].clone() == 12);
}
