fn main() {
    let scalar: i64 = 2;
    let v: Vec<i64> = vec![1, 2, 3];
    let mut result: Vec<i64> = vec![0, 0, 0];
    for i in 0..3 {
        result[(i) as usize] = scalar * v[(i) as usize].clone();
    }
    assert!(result[0].clone() == 2);
    assert!(result[1].clone() == 4);
    assert!(result[2].clone() == 6);
}
