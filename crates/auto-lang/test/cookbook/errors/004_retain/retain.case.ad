// Auto-generated by a2r transpiler

use std::error::Error;
fn inner() -> Result<String, Box<dyn std::error::Error>> {
    Err("inner error".into())
}

fn outer() -> Result<String, Box<dyn std::error::Error>> {
    let result = inner()?;
    Ok(result)
}

fn main() {
    let result = outer();
    let mut got_err: bool = false;
    match result {
        Ok(val) => println!("Success: {}", val),
        Err(e) => got_err = true,
    };
    assert!(got_err == true);
}
```
