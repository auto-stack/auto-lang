### Auto
path: "regex_replace.at"
```auto
use.rs regex::Regex

fn main() {
    let re = Regex.new(c"\d+").unwrap()
    let text = "abc 123 def 456"
    let replaced = re.replace_all(text, "NUM")
    assert(replaced == "abc NUM def NUM")
}
```

