// Auto-generated by a2r transpiler

use regex::Regex;
fn main() {
    let re = Regex::new("#\\w+").unwrap();
    let text: String = "Love #rust and #programming!".to_string();
    let matches = re.captures_iter(text);
    assert!((matches.len() as i64) == 2);
}
