use.rs regex::Regex

fn main() {
    let re = Regex.new(c"\d{3}-\d{3}-\d{4}").unwrap()
    let text = "Call 555-123-4567 or 555-987-6543"
    var phone_count = 0
    for cap in re.find_iter(text) {
        phone_count += 1
    }
    assert(phone_count == 2)
}
