### Auto
path: "filter_log.at"
```auto
use.rs regex::Regex

fn main() {
    let re = Regex.new("ERROR: .+").unwrap()
    let log = "INFO: started\nERROR: file not found\nWARN: retrying\nERROR: disk full"
    let matches = re.captures_iter(log)
    assert(matches.len() == 2)
}
```

