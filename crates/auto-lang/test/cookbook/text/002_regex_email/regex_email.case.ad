### Auto
path: "regex_email.at"
```auto
use.rs regex::Regex

fn main() {
    let re = Regex.new(c"[a-z]+@[a-z]+\.[a-z]+").unwrap()
    let text = "Contact user@example.com for info"
    let matched = re.is_match(text)
    assert(matched == true)
}
```

