### Auto
path: "semver_prerelease.at"
```auto
dep semver
use.rs semver::Version

fn main() {
    let v = Version.parse("1.0.0-alpha.1").unwrap()
    print(f"Major: ${v.major}")
    print(f"Pre: ${v.pre}")
    let is_pre = !v.pre.is_empty()
    assert(is_pre == true)
}
