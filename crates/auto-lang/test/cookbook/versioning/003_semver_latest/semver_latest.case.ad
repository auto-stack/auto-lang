### Auto
path: "semver_latest.at"
```auto
use.rs semver::Version

fn main() {
    let versions = ["1.0.0", "2.1.0", "1.5.0", "2.0.1"]
    var max = Version.parse(versions[0]).unwrap()
    for v in versions {
        let parsed = Version.parse(v).unwrap()
        if parsed > max {
            max = parsed
        }
    }
    assert(max.major == 2)
    assert(max.minor == 1)
}
