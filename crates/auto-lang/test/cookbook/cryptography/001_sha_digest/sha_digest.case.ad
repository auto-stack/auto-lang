// Auto-generated by a2r transpiler

use sha2::Sha256;
use sha2::Digest;

fn main() {
    let mut hasher = Sha256::new();
    hasher.update(b { content: "hello world".to_string() });
    let result = hasher.finalize();
    assert!(true);
}
