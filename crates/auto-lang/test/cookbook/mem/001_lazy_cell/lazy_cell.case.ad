### Auto
path: "lazy_cell.at"
```auto
use.rs std::cell::RefCell

fn main() {
    let cell = RefCell.new(0)
    let current = cell.borrow()
    assert(current == 0)
    cell.replace(42)
    let updated = cell.borrow()
    assert(updated == 42)
}
```

