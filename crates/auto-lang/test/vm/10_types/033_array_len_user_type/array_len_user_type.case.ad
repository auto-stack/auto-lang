type Point {
    x int
    y int
}

fn main() {
    let a = Point { x: 1, y: 2 }
    let b = Point { x: 3, y: 4 }
    let list = [a, b]
    assert_eq(list.len(), 2)
    let first = list[0]
    assert_eq(first.x, 1)
    assert_eq(first.y, 2)
