// str.lower() on a string produced by str.split() returns garbage
// (-2147483647 suffix). str.upper() on the same element is correct.
// Root cause hypothesis: split/lines return heap-based strings whose
// in-memory representation differs from const-pool strings; str.lower()'s
// native shim mishandles that case. Literal/variable .lower() is fine.
let parts = "a.RS".split(".")
let p1 = parts[1]
print(p1)
print(p1.lower())
print(p1.upper())
let lines = "X\nY".lines()
let l0 = lines[0]
print(l0.lower())
