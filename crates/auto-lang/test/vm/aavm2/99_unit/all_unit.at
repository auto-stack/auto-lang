// keyword_kind: Rust keyword_kind 的 None → Ident 哨兵(DIVERGE D11);调用方以 != Ident 判定
fn keyword_kind(text str) TokenKind {
    is text {
        "true" -> TokenKind.True
        "false" -> TokenKind.False
        "nil" -> TokenKind.Nil
        "null" -> TokenKind.Null
        "if" -> TokenKind.If
        "else" -> TokenKind.Else
        "for" -> TokenKind.For
        "loop" -> TokenKind.Loop
        "while" -> TokenKind.While
        "try" -> TokenKind.Try
        "catch" -> TokenKind.Catch
        "is" -> TokenKind.Is
        "var" -> TokenKind.Var
        "in" -> TokenKind.In
        "fn" -> TokenKind.Fn
        "type" -> TokenKind.Type
        "union" -> TokenKind.Union
        "tag" -> TokenKind.Tag
        "let" -> TokenKind.Let
        "mut" -> TokenKind.Mut
        "move" -> TokenKind.Move
        "view" -> TokenKind.View
        "take" -> TokenKind.Take
        "copy" -> TokenKind.Copy
        "hold" -> TokenKind.Hold
        "has" -> TokenKind.Has
        "spec" -> TokenKind.Spec
        "use" -> TokenKind.Use
        "pac" -> TokenKind.Pac
        "super" -> TokenKind.Super
        "super2" -> TokenKind.Super2
        "super3" -> TokenKind.Super3
        "super4" -> TokenKind.Super4
        "as" -> TokenKind.As
        "to" -> TokenKind.To
        "enum" -> TokenKind.Enum
        "grid" -> TokenKind.Grid
        "alias" -> TokenKind.Alias
        "break" -> TokenKind.Break
        "continue" -> TokenKind.Continue
        "return" -> TokenKind.Return
        "yield" -> TokenKind.Yield
        "ext" -> TokenKind.Ext
        "static" -> TokenKind.Static
        "shared" -> TokenKind.Shared
        "impl" -> TokenKind.Impl
        "const" -> TokenKind.Const
        "dep" -> TokenKind.Dep
        "routes" -> TokenKind.Routes
        "outlet" -> TokenKind.Outlet
        "link" -> TokenKind.Link
        "route" -> TokenKind.Route
        "task" -> TokenKind.Task
        "spawn" -> TokenKind.Spawn
        "await" -> TokenKind.Await
        "reply" -> TokenKind.Reply
        "go" -> TokenKind.Go
        "mod" -> TokenKind.Mod
        else -> TokenKind.Ident
    }
}

// kind_name: 与 Rust Debug 输出({:?})逐字一致——M1 闸门 dump 对齐的唯一事实源
