//                 内联作结构体构造参数时返回值丢失(List.new() 使字段成垃圾,
//                 提升为局部变量后恢复);②List.pop 目录签名 Void 而 shim 压
//                 返回值,语句位调用即静默毁栈、消费位返回垃圾——一律不用,
//                 作用域退栈改为 depth 计数(scopes 只增不减,越界层不读)

// ── 状态与载体 ────────────────────────────────────────────────

type Binding {
    name str
    ty str
}

type P {
    toks List<Token>
    pos int
    err str
    scopes List<List<Binding>>
    globals List<Binding>
    depth int
    decls List<Binding>
}

// 类型/枚举注册表查询(D38b):name → 声明期 Display 快照
fn p_decl_lookup(p P, name str) str {
    var i = 0
    while i < p.decls.len() {
        if p.decls.get(i).name == name {
            return p.decls.get(i).ty
        }
        i = i + 1
    }
    return ""
}

fn p_decl_register(mut p P, name str, display str) {
    p.decls.push(Binding(name, display))
}

// 表达式结果:dump=S-expr;word=标识符词/方法词/运算符 kind;name=name 的
// 文本或 int/uint 值串或 str/bool 原文(pair key 用);args=call 的
// "(args ...)" 段;ity=构造期推断类型(Display 串,""=Unknown)
type E {
    kind str
    word str
    name str
    args str
    dump str
    ity str
}

fn parse_new(toks List<Token>) P {
    var scs List<List<Binding>> = List.new()
    var glo List<Binding> = List.new()
    var dcl List<Binding> = List.new()
    var p = P(toks, 0, "", scs, glo, 0, dcl)
    // Parser::from 的 cur 初始化含 skip_comments:起始位置跳过前导注释
    var scanning = true
    for scanning {
        if p.pos >= p.toks.len() {
            scanning = false
        } else if is_comment_kind(p.toks.get(p.pos).kind) {
            p.pos = p.pos + 1
        } else {
            scanning = false
        }
    }
    return p
}

// 447-③9.2:Token.kind 载体已枚举化;p_kind 暂以 kind_name 维持 str 边界
// (P1 步翻转返回 TokenKind 并参数化全部比较位)
// 447-③P1:kind 载体枚举化,返回 TokenKind(错误消息经 kind_name)
fn p_kind(p P) TokenKind {
    if p.pos >= p.toks.len() {
        return TokenKind.EOF
    }
    return p.toks.get(p.pos).kind
}

fn p_text(p P) str {
    if p.pos >= p.toks.len() {
        return ""
    }
    return p.toks.get(p.pos).text
}

fn p_line(p P) int {
    if p.pos >= p.toks.len() {
        return 0
    }
    return p.toks.get(p.pos).line
}

// 原始前瞻(不跳注释;与基线 lexer.pushback 前瞻同构,corpus 括号内无注释)
fn p_peek(p P, n int) TokenKind {
    var i = p.pos + n
    if i >= p.toks.len() {
        return TokenKind.EOF
    }
    return p.toks.get(i).kind
}

fn is_comment_kind(k TokenKind) bool {
    is k {
        TokenKind.DocComment | TokenKind.CommentLine | TokenKind.CommentStart | TokenKind.CommentContent | TokenKind.CommentEnd -> true
        else -> false
    }
}

// Parser::next 直译:前进一 token 并跳过注释 token
fn p_next(mut p P) {
    p.pos = p.pos + 1
    var scanning = true
    for scanning {
        if p.pos >= p.toks.len() {
            scanning = false
        } else if is_comment_kind(p.toks.get(p.pos).kind) {
            p.pos = p.pos + 1
        } else {
            scanning = false
        }
    }
}

fn p_err(mut p P, msg str) {
    if p.err == "" {
        p.err = "PARSE-ERROR:" + p_line(p).str() + ":" + msg + " <" + kind_name(p_kind(p)) + ">"
    }
}

fn p_expect(mut p P, k TokenKind) {
    if p.err != "" {
        return
    }
    if p_kind(p) == k {
        p_next(p)
    } else {
        p_err(p, "expected " + kind_name(k) + ", got ")
    }
}

fn skip_empty_lines(mut p P) int {
    var count = 0
    while p_kind(p) == TokenKind.Newline {
        count = count + 1
        p_next(p)
    }
    return count
}

// ── 作用域(仅服务 let 无注解时的内联推断,D23) ─────────────────

fn push_scope(mut p P) {
    var sc List<Binding> = List.new()
    p.scopes.push(sc)
    p.depth = p.depth + 1
}

fn pop_scope(mut p P) {
    p.depth = p.depth - 1
}

fn p_bind(mut p P, name str, ty str) {
    if p.depth > 0 {
        // 提升+写回:VM 引用语义下 set 写回同一引用(无操作);
        // a2r 值语义下写回修改后的副本(VM/a2r 可观察状态一致)
        var sc = p.scopes.get(p.depth - 1)
        sc.push(Binding(name, ty))
        p.scopes.set(p.depth - 1, sc)
    } else {
        p.globals.push(Binding(name, ty))
    }
}

fn p_lookup(p P, name str) str {
    var s = p.depth - 1
    while s >= 0 {
        var scope List<Binding> = p.scopes.get(s)
        var i = scope.len() - 1
        while i >= 0 {
            if scope.get(i).name == name {
                return scope.get(i).ty
            }
            i = i - 1
        }
        s = s - 1
    }
    var g = p.globals.len() - 1
    while g >= 0 {
        if p.globals.get(g).name == name {
            return p.globals.get(g).ty
        }
        g = g - 1
    }
    return ""
}

// ── 数字/浮点值显示(D24) ─────────────────────────────────────

fn digit_val(c int) int {
    if c >= '0' && c <= '9' {
        return c - '0'
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10
    }
    return c - 'A' + 10
}

// parse_int 直译:0x/0b 前缀 + 十进制(下划线 lexer 已剥离)
fn int_val(text str) int {
    var base = 10
    var start = 0
    if text.len() >= 2 && text.slice(0, 2) == "0x" {
        base = 16
        start = 2
    } else if text.len() >= 2 && text.slice(0, 2) == "0b" {
        base = 2
        start = 2
    }
    var val = 0
    var i = start
    while i < text.len() {
        val = val * base + digit_val(text.char_at(i))
        i = i + 1
    }
    return val
}

// f32/f64 Display 近似:十进制文本剥分数尾零("1.0"→"1","3.14"→"3.14")
fn float_display(text str) str {
    var dot = -1
    var i = 0
    while i < text.len() {
        if text.char_at(i) == '.' {
            dot = i
        }
        i = i + 1
    }
    if dot < 0 {
        return text
    }
    var int_part = text.slice(0, dot)
    var frac = text.slice(dot + 1, text.len())
    while frac.len() > 0 && frac.char_at(frac.len() - 1) == '0' {
        frac = frac.slice(0, frac.len() - 1)
    }
    if frac.len() == 0 {
        return int_part
    }
    return int_part + "." + frac
}

// ── 类型解析(D23:类型即 Display 串) ──────────────────────────

fn builtin_type(name str) str {
    if name == "int" {
        return "int"
    }
    if name == "uint" {
        return "uint"
    }
    if name == "usize" {
        return "usize"
    }
    if name == "i64" {
        return "i64"
    }
    if name == "u64" {
        return "u64"
    }
    if name == "float" {
        return "float"
    }
    if name == "double" {
        return "double"
    }
    if name == "bool" {
        return "bool"
    }
    if name == "char" {
        return "char"
    }
    if name == "str" {
        return "str"
    }
    if name == "String" {
        return "String"
    }
    if name == "byte" {
        return "byte"
    }
    if name == "cstr" {
        return "cstr"
    }
    return ""
}

fn is_type_name(mut p P) bool {
    var k = p_kind(p)
    is k {
        TokenKind.Ident | TokenKind.Question | TokenKind.Not | TokenKind.Tilde | TokenKind.LSquare | TokenKind.Star | TokenKind.At | TokenKind.Fn | TokenKind.Link | TokenKind.Type -> true
        else -> false
    }
}

// parse_type 子集:标量/用户名 + ?T/!T/*T 前后缀;泛型/数组/fn 类型 Missing
fn parse_type(mut p P) str {
    if p.err != "" {
        return ""
    }
    var ty = parse_type_base(p)
    while p_kind(p) == TokenKind.Question {
        p_next(p)
        ty = f"?${ty}"
    }
    return ty
}

fn parse_type_base(mut p P) str {
    var k = p_kind(p)
    if k == TokenKind.Question {
        p_next(p)
        return "?" + parse_type(p)
    }
    if k == TokenKind.Not {
        p_next(p)
        if is_type_name(p) {
            return "!" + parse_type(p)
        }
        return "!void"
    }
    if k == TokenKind.Star {
        p_next(p)
        return "*" + parse_type(p)
    }
    if k == TokenKind.Ident {
        var name = p_text(p)
        var b = builtin_type(name)
        if b == "" {
            // 用户类型(D38b):注册表内联整个声明快照(对齐 Rust
            // Type::User(TypeDecl) 的 Display——已声明 → 完整 decl,
            // 前向引用/未注册 → 空声明 "(type-decl (name X))")
            var snap = p_decl_lookup(p, name)
            if snap != "" {
                b = snap
            } else {
                b = f"(type-decl (name ${name}))"
            }
        }
        p_next(p)
        // 泛型实例(Plan 434:AA2R 需解析 lib 自身的 List<T>/Map<K, V>):
        // 基名取裸名(List/Map → Type::List/Map Display 内联参数;未注册
        // 基名 → GenericInstance——Display 亦为裸名,参数侧的 unique_name
        // 差异见 D38a 备注);多参 ", " 连接
        if p_kind(p) == TokenKind.Lt {
            p_next(p)
            skip_empty_lines(p)
            var args = ""
            var first = true
            while p.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.Gt {
                var at = parse_type(p)
                skip_empty_lines(p)
                if !first {
                    args = f"${args}, "
                }
                args = args + at
                first = false
                if p_kind(p) == TokenKind.Comma {
                    p_next(p)
                    skip_empty_lines(p)
                } else if p_kind(p) != TokenKind.Gt {
                    p_err(p, "expected ',' or '>' in generic args ")
                    return ""
                }
            }
            p_expect(p, TokenKind.Gt)
            return name + "<" + args + ">"
        }
        return b
    }
    p_err(p, "expected type, got ")
    return ""
}

// ── Pratt 表直译(parser.rs:28-164) ──────────────────────────

// 运算符枚举(镜像 auto-val value.rs Op 的 lib 子集;447-③P3 杠杆点——
// 六链函数一步收编为 is-on-Op)。NoOp = 非运算符哨兵(镜像 Parser::op 的兜底)
enum Op {
    Add
    Sub
    Mul
    Div
    Mod
    AddEq
    SubEq
    MulEq
    DivEq
    ModEq
    Not
    And
    Or
    LSquare
    LParen
    Asn
    Eq
    Neq
    Lt
    Gt
    Le
    Ge
    Range
    RangeEq
    Dot
    Colon
    QuestionQuestion
    NoOp
}

// Parser::op() 直译(parser.rs:2897):TokenKind → Op;非运算符 → NoOp
fn p_op(k TokenKind) Op {
    is k {
        TokenKind.Add -> Op.Add
        TokenKind.Sub -> Op.Sub
        TokenKind.Star -> Op.Mul
        TokenKind.Div -> Op.Div
        TokenKind.Mod -> Op.Mod
        TokenKind.AddEq -> Op.AddEq
        TokenKind.SubEq -> Op.SubEq
        TokenKind.MulEq -> Op.MulEq
        TokenKind.DivEq -> Op.DivEq
        TokenKind.ModEq -> Op.ModEq
        TokenKind.LSquare -> Op.LSquare
        TokenKind.LParen -> Op.LParen
        TokenKind.Not -> Op.Not
        TokenKind.Asn -> Op.Asn
        TokenKind.Eq -> Op.Eq
        TokenKind.Neq -> Op.Neq
        TokenKind.Lt -> Op.Lt
        TokenKind.Gt -> Op.Gt
        TokenKind.Le -> Op.Le
        TokenKind.Ge -> Op.Ge
        TokenKind.Range -> Op.Range
        TokenKind.RangeEq -> Op.RangeEq
        TokenKind.Dot -> Op.Dot
        TokenKind.Colon -> Op.Colon
        TokenKind.And -> Op.And
        TokenKind.Or -> Op.Or
        TokenKind.QuestionQuestion -> Op.QuestionQuestion
        else -> Op.NoOp
    }
}

fn prefix_power(op Op) int {
    // sign(Add/Sub/Star)=2*13=26;Not=2*14=28
    is op {
        Op.Add | Op.Sub | Op.Mul -> 26
        Op.Not -> 28
        else -> 0
    }
}

fn postfix_power(op Op) int {
    // pair=2*4=8;call=2*15=30;index=2*16=32;bang=2*17=34
    is op {
        Op.Colon -> 8
        Op.LParen -> 30
        Op.LSquare -> 32
        Op.Not -> 34
        else -> 0
    }
}

fn infix_l(op Op) int {
    is op {
        Op.Asn -> 1
        Op.AddEq | Op.SubEq -> 3
        Op.MulEq | Op.DivEq | Op.ModEq -> 5
        Op.Or | Op.QuestionQuestion -> 9
        Op.And -> 11
        Op.Eq | Op.Neq -> 13
        Op.Lt | Op.Gt | Op.Le | Op.Ge -> 15
        Op.Range | Op.RangeEq -> 17
        Op.Add | Op.Sub -> 19
        Op.Mul | Op.Div | Op.Mod -> 21
        Op.Dot -> 35
        else -> 0
    }
}

fn infix_r(op Op) int {
    is op {
        Op.Asn -> 2
        Op.AddEq | Op.SubEq -> 4
        Op.MulEq | Op.DivEq | Op.ModEq -> 6
        Op.Or | Op.QuestionQuestion -> 10
        Op.And -> 12
        Op.Eq | Op.Neq -> 14
        Op.Lt | Op.Gt | Op.Le | Op.Ge -> 16
        Op.Range | Op.RangeEq -> 18
        Op.Add | Op.Sub -> 20
        Op.Mul | Op.Div | Op.Mod -> 22
        Op.Dot -> 36
        else -> 0
    }
}

fn op_display(op Op) str {
    is op {
        Op.Add -> "+"
        Op.Sub -> "-"
        Op.Mul -> "*"
        Op.Div -> "/"
        Op.Mod -> "%"
        Op.AddEq -> "+="
        Op.SubEq -> "-="
        Op.MulEq -> "*="
        Op.DivEq -> "/="
        Op.ModEq -> "%="
        Op.Not -> "!"
        Op.Asn -> "="
        Op.Eq -> "=="
        Op.Neq -> "!="
        Op.Lt -> "<"
        Op.Gt -> ">"
        Op.Le -> "<="
        Op.Ge -> ">="
        Op.Range -> ".."
        Op.RangeEq -> "..="
        Op.Dot -> "."
        Op.Colon -> ":"
        Op.And -> "&&"
        Op.Or -> "||"
        Op.QuestionQuestion -> "??"
        else -> ""
    }
}

// 运算符 token 是否可作 lhs 之后的运算符(infix 或 postfix)
fn is_op_kind(k TokenKind) bool {
    return op_display(p_op(k)) != "" || k == TokenKind.LParen || k == TokenKind.LSquare
}

// ── 推断构造期辅助(infer_binop_type/infer_unary_op_type 直译) ─

fn infer_unify(a str, b str) str {
    if a == "" {
        return b
    }
    if b == "" {
        return a
    }
    if a == b {
        return a
    }
    // 基线走 unify_with_coercion;类型不匹配的语料未及,按其错误路径
    // Unknown 传播
    return ""
}

fn binop_result(op Op, l str, r str) str {
    is op {
        Op.Eq | Op.Neq | Op.Lt | Op.Gt | Op.Le | Op.Ge -> "bool"
        Op.Add | Op.Sub | Op.Mul | Op.Div | Op.Mod -> infer_unify(l, r)
        Op.AddEq | Op.SubEq | Op.MulEq | Op.DivEq | Op.ModEq | Op.Asn -> infer_unify(l, r)
        else -> ""
    }
}

// ── 表达式(返回 E;错误短路见 D22) ──────────────────────────

fn bad_e() E {
    return E("bad", "", "", "", "", "")
}

// f-string 解析(447-③ 11.2a;D38c 简化形:FStrStart + FStrPart 整段
// 文本 + FStrEnd,段拆分在此重建——镜像宿主 parser.rs fstr() 的部件
// 序列,dump 对齐 (fstr <part>...):文本段 (str "...")/$Ident (name x)/
// ${expr} 子解析直通 dump)。$Ident 的 .field 链为 D40 校准子集外。
fn fstr_expr(mut p P) E {
    p_next(p)
    var content = p_text(p)
    p_next(p)
    p_next(p)
    if p.err != "" {
        return bad_e()
    }
    var parts = ""
    var lit = ""
    var i = 0
    var n = content.len()
    while i < n {
        var ch = content.char_at(i)
        if ch == 36 {
            if lit != "" {
                parts = parts + " (str \"" + lit + "\")"
                lit = ""
            }
            if i + 1 < n && content.char_at(i + 1) == 123 {
                // ${expr}:平衡括号定界,子串递归解析直通 dump
                var depth = 1
                var j = i + 2
                while j < n && depth > 0 {
                    var cj = content.char_at(j)
                    if cj == 123 {
                        depth = depth + 1
                    } else if cj == 125 {
                        depth = depth - 1
                    }
                    j = j + 1
                }
                if depth != 0 {
                    p_err(p, "fstr: unterminated interpolation ")
                    return bad_e()
                }
                var inner = content.slice(i + 2, j - 1)
                var subtoks = tokenize(inner)
                var subp = parse_new(subtoks)
                var sub = expr_pratt(subp, 0)
                if subp.err != "" {
                    p_err(p, "fstr: bad interpolation ")
                    return bad_e()
                }
                parts = f"${parts} ${sub.dump}"
                i = j
            } else {
                // $Ident
                var j2 = i + 1
                var stop = false
                while j2 < n && !stop {
                    var cj2 = content.char_at(j2)
                    var ok2 = (cj2 >= 97 && cj2 <= 122) || (cj2 >= 65 && cj2 <= 90) || (cj2 >= 48 && cj2 <= 57) || cj2 == 95
                    if !ok2 {
                        stop = true
                    } else {
                        j2 = j2 + 1
                    }
                }
                var nm = content.slice(i + 1, j2)
                if nm == "" {
                    p_err(p, "fstr: empty interpolation ")
                    return bad_e()
                }
                parts = f"${parts} (name ${nm})"
                i = j2
            }
        } else {
            lit = lit + content.slice(i, i + 1)
            i = i + 1
        }
    }
    if lit != "" {
        parts = parts + " (str \"" + lit + "\")"
    }
    return E("fstr", "", "", "", "(fstr" + parts + ")", "str")
}

fn expr_atom(mut p P) E {
    if p.err != "" {
        return bad_e()
    }
    var k = p_kind(p)
    if k == TokenKind.LParen {
        // group() 直译
        p_next(p)
        var inner = expr_pratt(p, 0)
        p_expect(p, TokenKind.RParen)
        return inner
    }
    if k == TokenKind.Int {
        var v = int_val(p_text(p)).str()
        p_next(p)
        return E("int", "", v, "", "(int " + v + ")", "int")
    }
    if k == TokenKind.Uint {
        var v2 = int_val(p_text(p)).str()
        p_next(p)
        return E("uint", "", v2, "", "(uint " + v2 + ")", "uint")
    }
    if k == TokenKind.I8 {
        var v3 = int_val(p_text(p)).str()
        p_next(p)
        return E("i8", "", v3, "", "(i8 " + v3 + ")", "int")
    }
    if k == TokenKind.U8 {
        var v4 = int_val(p_text(p)).str()
        p_next(p)
        return E("u8", "", v4, "", "(u8 " + v4 + ")", "int")
    }
    if k == TokenKind.Float {
        var f1 = float_display(p_text(p))
        p_next(p)
        return E("float", "", "", "", "(float " + f1 + ")", "float")
    }
    if k == TokenKind.Double {
        var f2 = float_display(p_text(p))
        p_next(p)
        return E("double", "", "", "", "(double " + f2 + ")", "double")
    }
    if k == TokenKind.True {
        p_next(p)
        return E("bool", "", "true", "", "(true)", "bool")
    }
    if k == TokenKind.False {
        p_next(p)
        return E("bool", "", "false", "", "(false)", "bool")
    }
    if k == TokenKind.Char {
        var c = p_text(p)
        p_next(p)
        return E("char", "", c, "", "(char '" + c + "')", "char")
    }
    if k == TokenKind.Str {
        var s = p_text(p)
        p_next(p)
        return E("str", "", s, "", "(str \"" + s + "\")", "str")
    }
    if k == TokenKind.Ident {
        var n = p_text(p)
        p_next(p)
        // W1 构造字面量:已注册类型名紧随 {(镜像宿主 atom 的
        // accepts_as_type_construction——scope 命中类型才拦截);
        // 否则回落原标识符路径({ 留给语句层,行为不变)
        if p_kind(p) == TokenKind.LBrace && p_decl_lookup(p, n) != "" {
            return ctor_node(p, n)
        }
        return E("name", n, n, "", "(name " + n + ")", p_lookup(p, n))
    }
    if is_soft_ident_kind(k) {
        // soft-ident(Plan 356 镜像):表达式位按标识符消费
        var n2 = p_text(p)
        p_next(p)
        if p_kind(p) == TokenKind.LBrace && p_decl_lookup(p, n2) != "" {
            return ctor_node(p, n2)
        }
        return E("name", n2, n2, "", "(name " + n2 + ")", p_lookup(p, n2))
    }
    if k == TokenKind.Nil {
        p_next(p)
        return E("nil", "", "", "", "(nil)", "")
    }
    if k == TokenKind.Null {
        p_next(p)
        return E("null", "", "", "", "(null)", "")
    }
    if k == TokenKind.Is {
        // 表达式位 is(Plan 447 部分②):参考 Expr::Is 的 Display 只出目标
        // "(is-expr target)",分支解析后弃置(quirk 照抄,D18)
        p_next(p)
        var t = expr_pratt(p, 0)
        p_expect(p, TokenKind.LBrace)
        skip_empty_lines(p)
        while p.err == "" && p_kind(p) != TokenKind.RBrace && p_kind(p) != TokenKind.EOF {
            var discard = parse_is_branch(p)
            if p_kind(p) == TokenKind.Comma {
                p_next(p)
                skip_empty_lines(p)
            }
        }
        p_expect(p, TokenKind.RBrace)
        return E("other", "", "", "", "(is-expr " + t.dump + ")", "")
    }
    p_err(p, "expected term, got ")
    return bad_e()
}

// args() 直译:Pos/Name 显示相同(D22 备注),统一按 Display 输出
fn parse_args(mut p P) str {
    p_expect(p, TokenKind.LParen)
    skip_empty_lines(p)
    var out = "(args"
    while p.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RParen {
        var a = expr_pratt(p, 0)
        if a.kind == "pair" {
            p_err(p, "v2 unsupported: named call arg ")
            return ""
        }
        out = f"${out} ${a.dump}"
        // sep_args
        var k = p_kind(p)
        if k == TokenKind.Comma || k == TokenKind.Newline {
            p_next(p)
            skip_empty_lines(p)
        } else if k != TokenKind.RParen {
            p_err(p, "expected argument separator, got ")
            return ""
        }
    }
    p_expect(p, TokenKind.RParen)
    return out + ")"
}

// array() 直译(fmt_array:空数组 "(array )")
fn parse_array(mut p P) E {
    p_expect(p, TokenKind.LSquare)
    skip_empty_lines(p)
    var elems List<str> = List.new()
    var first_ity = ""
    while p.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RSquare {
        var e = expr_pratt(p, 0)
        if elems.len() == 0 {
            first_ity = e.ity
        }
        elems.push(e.dump)
        // sep_array
        var has_sep = false
        while p_kind(p) == TokenKind.Comma || p_kind(p) == TokenKind.Newline {
            has_sep = true
            p_next(p)
        }
        if p_kind(p) != TokenKind.RSquare && !has_sep {
            p_err(p, "expected array separator, got ")
        }
    }
    p_expect(p, TokenKind.RSquare)
    var dump = "(array "
    var i = 0
    while i < elems.len() {
        if i > 0 {
            dump = f"${dump} "
        }
        dump = dump + elems.get(i)
        i = i + 1
    }
    var ity = ""
    if elems.len() > 0 {
        ity = "(array-type (elem " + first_ity + ") (len " + elems.len().str() + "))"
    }
    return E("array", "", "", "", dump + ")", ity)
}

// key() 直译:返回 key 的 Display 形式
fn parse_key(mut p P) str {
    var k = p_kind(p)
    if k == TokenKind.Ident || k == TokenKind.Type || k == TokenKind.Tag || k == TokenKind.Task {
        var n = p_text(p)
        p_next(p)
        return "(name " + n + ")"
    }
    if k == TokenKind.Int {
        var v = int_val(p_text(p)).str()
        p_next(p)
        return v
    }
    if k == TokenKind.True {
        p_next(p)
        return "true"
    }
    if k == TokenKind.False {
        p_next(p)
        return "false"
    }
    if k == TokenKind.Str {
        var s = p_text(p)
        p_next(p)
        return "\"" + s + "\""
    }
    p_err(p, "expected key, got ")
    return ""
}

// object() 直译
fn parse_object(mut p P) E {
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    var dump = "(object "
    var i = 0
    while p.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RBrace {
        if i > 0 {
            dump = f"${dump} "
        }
        var key = parse_key(p)
        p_expect(p, TokenKind.Colon)
        var val = expr_pratt(p, 0)
        dump = f"${dump}(pair ${key} ${val.dump})"
        i = i + 1
        // sep_obj
        var k = p_kind(p)
        if k == TokenKind.Comma || k == TokenKind.Newline {
            p_next(p)
            skip_empty_lines(p)
        } else if k != TokenKind.RBrace {
            p_err(p, "expected pair separator, got ")
        }
    }
    p_expect(p, TokenKind.RBrace)
    return E("object", "", "", "", dump + ")", "")
}

// W1 构造字面量 X { a: e1, b: e2 }:宿主 Expr::Node 形态,Pair 落 node 的
// body 段(parse_node_body → Stmt::Expr(Pair)),Display 对齐 ast/node.rs:
// (node (name X) (body (pair (name a) e1) (pair (name b) e2)))
// 键限 NamedKey(宿主 parse_braced_struct_args 只转 NamedKey→Pair);
// ity 空 = Unknown(镜像宿主 infer Node→Unknown)
fn ctor_node(mut p P, name str) E {
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    var body = "(body"
    var n = 0
    while p.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RBrace {
        var k = p_kind(p)
        if k != TokenKind.Ident && k != TokenKind.Type && k != TokenKind.Tag && k != TokenKind.Task {
            p_err(p, "expected field name in struct ctor, got ")
            return bad_e()
        }
        var key = "(name " + p_text(p) + ")"
        p_next(p)
        p_expect(p, TokenKind.Colon)
        var val = expr_pratt(p, 0)
        body = f"${body} (pair ${key} ${val.dump})"
        n = n + 1
        // sep_obj:逗号/换行
        var sk = p_kind(p)
        if sk == TokenKind.Comma || sk == TokenKind.Newline {
            p_next(p)
            skip_empty_lines(p)
        } else if sk != TokenKind.RBrace {
            p_err(p, "expected pair separator, got ")
        }
    }
    p_expect(p, TokenKind.RBrace)
    var dump = f"(node (name ${name})"
    if n > 0 {
        dump = f"${dump} ${body}))"
    } else {
        dump = f"${dump})"
    }
    return E("node", name, name, body, dump, "")
}

fn join_dump_list(parts List<str>, sep str) str {
    var out = ""
    var i = 0
    while i < parts.len() {
        if i > 0 {
            out = out + sep
        }
        out = out + parts.get(i)
        i = i + 1
    }
    return out
}

// 元组解析(( 已在 cur):elems 经 expr_pratt(0),ity 为元素 ity 的 ", " 连接
fn tuple_rest(mut p P, first E) E {
    var dumps List<str> = List.new()
    var itys List<str> = List.new()
    dumps.push(first.dump)
    itys.push(first.ity)
    while p_kind(p) == TokenKind.Comma {
        p_next(p)
        var e = expr_pratt(p, 0)
        dumps.push(e.dump)
        itys.push(e.ity)
    }
    p_expect(p, TokenKind.RParen)
    return E("tuple", "", "", "", "(tuple " + join_dump_list(dumps, " ") + ")", "(" + join_dump_list(itys, ", ") + ")")
}

// LParen 前缀的 group/tuple/closure 判定(expr_pratt_inner LParen 臂直译)
fn paren_prefix(mut p P) E {
    var k1 = p_peek(p, 1)
    if k1 == TokenKind.RParen {
        var k2 = p_peek(p, 2)
        if k2 == TokenKind.DoubleArrow {
            p_err(p, "v2 unsupported: zero-param closure ")
            return bad_e()
        }
        // () 单元 → 空元组(fmt_tuple 空形态)
        p_next(p)
        p_next(p)
        return E("tuple", "", "", "", "(tuple )", "()")
    }
    if k1 == TokenKind.Ident {
        // 前瞻扫描闭包/元组判定:depth 追踪 + 闭括号后 => 前瞻
        var found_comma = false
        var found_arrow = false
        var depth = 1
        var i = p.pos + 1
        var scanning = true
        while scanning && i < p.toks.len() {
            var tk = p.toks.get(i).kind
            if tk == TokenKind.LParen || tk == TokenKind.LSquare || tk == TokenKind.LBrace {
                depth = depth + 1
            } else if tk == TokenKind.RParen || tk == TokenKind.RSquare || tk == TokenKind.RBrace {
                depth = depth - 1
                if depth == 0 {
                    if i + 1 < p.toks.len() && p.toks.get(i + 1).kind == TokenKind.DoubleArrow {
                        found_arrow = true
                    }
                    scanning = false
                }
            } else if tk == TokenKind.Comma && depth == 1 {
                found_comma = true
            } else if tk == TokenKind.EOF {
                scanning = false
            }
            i = i + 1
        }
        if found_arrow {
            p_err(p, "v2 unsupported: multi-param closure ")
            return bad_e()
        }
        if found_comma {
            // 元组:消费 (,首元素后按逗号续
            p_next(p)
            var first = expr_pratt(p, 0)
            return tuple_rest(p, first)
        }
        // 普通 group
        p_next(p)
        var inner = expr_pratt(p, 0)
        p_expect(p, TokenKind.RParen)
        return inner
    }
    // 非标识符起始:group 或元组
    p_next(p)
    var first2 = expr_pratt(p, 0)
    if p_kind(p) == TokenKind.Comma {
        return tuple_rest(p, first2)
    }
    p_expect(p, TokenKind.RParen)
    return first2
}

// expr_pratt_inner 直译:前缀分发 + with_left 循环
fn expr_pratt(mut p P, min int) E {
    if p.err != "" {
        return bad_e()
    }
    var k = p_kind(p)
    var lhs = bad_e()
    // A2:主分派 is 化(镜像 Rust expr_pratt 的 match kind 链)
    is k {
        TokenKind.If -> {
            // if 表达式:复用 if 解析(Display 同 If)
            var d = if_contents(p)
            lhs = E("other", "", "", "", d, "")
        }
        TokenKind.Add | TokenKind.Sub | TokenKind.Not | TokenKind.Star -> {
            var pow = prefix_power(p_op(k))
            p_next(p)
            var operand = expr_pratt(p, pow)
            var ity = ""
            if k == TokenKind.Not {
                ity = "bool"
            } else {
                ity = operand.ity
            }
            lhs = E("una", k, "", "", "(una (op " + op_display(p_op(k)) + ") " + operand.dump + ")", ity)
        }
        TokenKind.LParen -> {
            lhs = paren_prefix(p)
        }
        TokenKind.LSquare -> {
            lhs = parse_array(p)
        }
        TokenKind.LBrace -> {
            lhs = parse_object(p)
        }
        TokenKind.FStrStart -> {
            lhs = fstr_expr(p)
        }
        else -> {
            lhs = expr_atom(p)
        }
    }
    return expr_with_left(p, lhs, min)
}

// expr_pratt_with_left_inner 直译
fn expr_with_left(mut p P, lhs E, min int) E {
    if p.err != "" {
        return lhs
    }
    // 单参闭包 x => e:Missing
    if lhs.kind == "name" && p_kind(p) == TokenKind.DoubleArrow {
        p_err(p, "v2 unsupported: single-param closure ")
        return lhs
    }
    var cur = lhs
    while p.err == "" {
        var k = p_kind(p)
        // P2:循环顶 token 分派(镜像 Rust parser.rs:2425 的 match kind:
        // 11 种界符 break;其余走算符链)
        is k {
            TokenKind.EOF | TokenKind.Newline | TokenKind.Semi | TokenKind.LBrace | TokenKind.RBrace | TokenKind.Comma | TokenKind.Arrow | TokenKind.DoubleArrow | TokenKind.VBar | TokenKind.RSquare | TokenKind.RParen -> {
                break
            }
            else -> {
                if !is_op_kind(k) {
                    p_err(p, "expected infix operator, got ")
                    break
                }
                var op = p_op(k)
                var post = postfix_power(op)
                if post > 0 {
                    if post < min {
                        break
                    }
                    if op == Op.LSquare {
                        // 下标(切片形态 Missing)
                        p_next(p)
                        var idx = expr_pratt(p, 18)
                        p_expect(p, TokenKind.RSquare)
                        cur = E("index", "", "", "", "(index " + cur.dump + " " + idx.dump + ")", "")
                    } else if op == Op.LParen {
                        // 调用:fmt_call —— args 非空才带 args 段;调用 ity=Unknown
                        var args = parse_args(p)
                        var word = ""
                        if cur.kind == "name" {
                            word = cur.word
                        }
                        var d = f"(call ${cur.dump}"
                        if args != "(args)" {
                            d = f"${d} ${args}"
                        }
                        cur = E("call", word, cur.dump, args, d + ")", "")
                    } else if op == Op.Colon {
                        // pair:key 由 lhs 形态决定;直接返回(不回循环)
                        p_next(p)
                        var key = ""
                        if cur.kind == "name" {
                            key = f"(name ${cur.word})"
                        } else if cur.kind == "int" || cur.kind == "uint" || cur.kind == "bool" {
                            key = cur.name
                        } else if cur.kind == "str" {
                            key = "\"" + cur.name + "\""
                        } else {
                            p_err(p, "invalid pair key ")
                            break
                        }
                        var val = expr_pratt(p, 0)
                        return E("pair", "", "", "", "(pair " + key + " " + val.dump + ")", "")
                    } else {
                        // Not 后缀(collect!):Missing
                        p_err(p, "v2 unsupported: postfix bang ")
                        break
                    }
                } else {
                    var l = infix_l(op)
                    if l == 0 || l < min {
                        break
                    }
                    p_next(p)
                    // || / && 换行续接
                    if op == Op.Or || op == Op.And {
                        skip_empty_lines(p)
                    }
                    var rhs = expr_pratt(p, infix_r(op))
                    if op == Op.Range {
                        cur = E("range", "", "", "", "(range (start " + cur.dump + ") (end " + rhs.dump + ") (eq false))", "")
                    } else if op == Op.RangeEq {
                        cur = E("range", "", "", "", "(range (start " + cur.dump + ") (end " + rhs.dump + ") (eq true))", "")
                    } else if op == Op.Dot {
                        if rhs.kind == "name" {
                            cur = E("dot", rhs.word, "", "", "(dot " + cur.dump + "." + rhs.word + ")", "")
                        } else if rhs.kind == "int" || rhs.kind == "uint" {
                            cur = E("dot", rhs.name, "", "", "(dot " + cur.dump + "." + rhs.name + ")", "")
                        } else if rhs.kind == "call" {
                            // 方法调用重写:Call(name=Dot(obj,method))
                            var d2 = f"(call (dot ${cur.dump}.${rhs.word})"
                            if rhs.args != "(args)" {
                                d2 = f"${d2} ${rhs.args}"
                            }
                            cur = E("call", rhs.word, "(dot " + cur.dump + "." + rhs.word + ")", rhs.args, d2 + ")", "")
                        } else {
                            p_err(p, "invalid field name after dot ")
                            break
                        }
                    } else if op == Op.QuestionQuestion {
                        cur = E("other", "", "", "", "(?? " + cur.dump + " " + rhs.dump + ")", "")
                    } else {
                        cur = E("bina", op, "", "", "(bina " + cur.dump + " (op " + op_display(op) + ") " + rhs.dump + ")", binop_result(op, cur.ity, rhs.ity))
                    }
                }
            }
        }
    }
    return cur
}

// ── 语句 ──────────────────────────────────────────────────────

fn store_kw_name(kw TokenKind) str {
    if kw == TokenKind.Var {
        return "var"
    }
    if kw == TokenKind.Const {
        return "const"
    }
    if kw == TokenKind.Shared {
        return "shared"
    }
    return "let"
}

fn parse_store(mut p P, kw TokenKind) str {
    p_next(p)
    // 元组解构 let (a, b) = expr:基础实现
    if p_kind(p) == TokenKind.LParen {
        p_next(p)
        var names = ""
        if p_kind(p) != TokenKind.RParen {
            names = p_text(p)
            p_next(p)
            while p_kind(p) == TokenKind.Comma {
                p_next(p)
                names = f"${names} ${p_text(p)}"
                p_next(p)
            }
        }
        p_expect(p, TokenKind.RParen)
        p_expect(p, TokenKind.Asn)
        var de = expr_pratt(p, 0)
        return "(destr (" + names + ") " + de.dump + ")"
    }
    var name = p_text(p)
    p_next(p)
    var ty = ""
    if is_type_name(p) {
        ty = parse_type(p)
    }
    var init = E("nil", "", "", "", "(nil)", "")
    if p_kind(p) == TokenKind.Asn {
        p_next(p)
        init = expr_pratt(p, 0)
        if ty == "" {
            ty = init.ity
        }
    } else if ty == "" {
        p_err(p, "store must have type annotation or initializer: " + name)
        return ""
    }
    p_bind(p, name, ty)
    if kw == TokenKind.Var {
        return "(var (name " + name + ") " + init.dump + ")"
    }
    if ty == "" {
        return "(" + store_kw_name(kw) + " (name " + name + ") " + init.dump + ")"
    }
    return "(" + store_kw_name(kw) + " (name " + name + ") (type " + ty + ") " + init.dump + ")"
}

fn parse_fn_params(mut p P) str {
    var out = ""
    var count = 0
    skip_empty_lines(p)
    var running = true
    while running && p.err == "" {
        var mode = "view"
        var k = p_kind(p)
        if k == TokenKind.View {
            p_next(p)
        } else if k == TokenKind.Mut {
            mode = "mut"
            p_next(p)
        } else if k == TokenKind.Move {
            mode = "move"
            p_next(p)
        } else if k == TokenKind.Take {
            mode = "move"
            p_next(p)
        } else if k == TokenKind.Copy {
            mode = "move"
            p_next(p)
        }
        if p_kind(p) != TokenKind.Ident {
            if mode != "view" {
                p_err(p, "expected parameter name after mode ")
            }
            running = false
        } else {
            var pname = p_text(p)
            p_next(p)
            var ty = "int"
            if p_kind(p) == TokenKind.Colon {
                p_next(p)
            }
            if is_type_name(p) {
                ty = parse_type(p)
            }
            var pdump = f"(param (name ${pname}) (type ${ty}) (mode ${mode})"
            if p_kind(p) == TokenKind.Asn {
                p_next(p)
                var def = expr_pratt(p, 0)
                pdump = f"${pdump} (default ${def.dump})"
            }
            pdump = f"${pdump})"
            if count > 0 {
                out = f"${out} "
            }
            out = out + pdump
            count = count + 1
            p_bind(p, pname, ty)
            if p_kind(p) == TokenKind.Comma {
                p_next(p)
            } else {
                running = false
            }
        }
    }
    return out
}

fn parse_fn(mut p P) str {
    p_next(p)
    if p_kind(p) == TokenKind.Dot {
        p_err(p, "v2 unsupported: fn.c/fn.vm ")
        return ""
    }
    if !is_name_kind(p_kind(p)) {
        p_err(p, "expected fn name, got ")
        return ""
    }
    var name = p_text(p)
    p_next(p)
    if p_kind(p) == TokenKind.Dot {
        p_err(p, "v2 unsupported: dotted fn name ")
        return ""
    }
    if p_kind(p) == TokenKind.Lt {
        p_err(p, "v2 unsupported: fn generic params ")
        return ""
    }
    push_scope(p)
    p_expect(p, TokenKind.LParen)
    var params = parse_fn_params(p)
    p_expect(p, TokenKind.RParen)
    var ret = ""
    if p_kind(p) == TokenKind.Arrow {
        p_next(p)
        ret = parse_type(p)
        skip_empty_lines(p)
    } else if is_type_name(p) {
        ret = parse_type(p)
        skip_empty_lines(p)
    } else if p_kind(p) == TokenKind.LBrace || p_kind(p) == TokenKind.Semi {
        ret = "void"
    }
    var body = "(body )"
    if p_kind(p) == TokenKind.Semi {
        p_next(p)
    } else {
        body = parse_body(p)
    }
    var out = f"(fn (name ${name})"
    if params != "" {
        out = f"${out} (params ${params})"
    }
    if ret != "" {
        out = f"${out} (ret ${ret})"
    }
    pop_scope(p)
    return out + " " + body + ")"
}

fn if_contents(mut p P) str {
    p_next(p)
    if p_kind(p) == TokenKind.Let {
        p_err(p, "v2 unsupported: if-let ")
        return ""
    }
    var out = "(if "
    var cond = expr_pratt(p, 0)
    var body = parse_body(p)
    out = f"${out}(branch ${cond.dump} ${body})"
    while p_kind(p) == TokenKind.Else {
        p_next(p)
        if p_kind(p) == TokenKind.If {
            p_next(p)
            if p_kind(p) == TokenKind.Let {
                p_err(p, "v2 unsupported: else-if-let ")
                return ""
            }
            var c2 = expr_pratt(p, 0)
            var b2 = parse_body(p)
            out = f"${out}(branch ${c2.dump} ${b2})"
        } else {
            var eb = parse_body(p)
            out = f"${out} (else ${eb})"
            break
        }
    }
    return out + ")"
}

fn parse_for(mut p P) str {
    p_next(p)
    if p_kind(p) == TokenKind.LBrace {
        var b0 = parse_body(p)
        return "(for (ever) (nil) " + b0 + ")"
    }
    if p_kind(p) == TokenKind.Let || p_kind(p) == TokenKind.Var {
        // for let x = 0; cond { }:init 不入 For Display
        parse_store(p, TokenKind.Let)
        p_expect(p, TokenKind.Semi)
        var c0 = expr_pratt(p, 0)
        var b1 = parse_body(p)
        return "(for (cond) " + c0.dump + " " + b1 + ")"
    }
    if p_kind(p) == TokenKind.Mut {
        p_err(p, "'mut' is not supported as a storage modifier ")
        return ""
    }
    if p_kind(p) == TokenKind.LParen {
        // 解构 for (k, v) in expr:基础实现
        p_next(p)
        var kn = p_text(p)
        p_next(p)
        p_expect(p, TokenKind.Comma)
        var vn = p_text(p)
        p_next(p)
        p_expect(p, TokenKind.RParen)
        p_expect(p, TokenKind.In)
        push_scope(p)
        p_bind(p, kn, "int")
        p_bind(p, vn, "int")
        var r1 = expr_pratt(p, 0)
        var b2 = parse_body(p)
        pop_scope(p)
        return "(for ((name " + kn + ") (name " + vn + ")) " + r1.dump + " " + b2 + ")"
    }
    if p_kind(p) == TokenKind.Ident {
        var name = p_text(p)
        p_next(p)
        if p_kind(p) == TokenKind.In {
            p_next(p)
            push_scope(p)
            p_bind(p, name, "int")
            var range = expr_pratt(p, 0)
            var body = parse_body(p)
            pop_scope(p)
            return "(for (name " + name + ") " + range.dump + " " + body + ")"
        }
        if p_kind(p) == TokenKind.Comma {
            p_next(p)
            var name2 = p_text(p)
            p_next(p)
            p_expect(p, TokenKind.In)
            push_scope(p)
            p_bind(p, name2, "int")
            var range2 = expr_pratt(p, 0)
            var body2 = parse_body(p)
            pop_scope(p)
            return "(for ((name " + name + ") (name " + name2 + ")) " + range2.dump + " " + body2 + ")"
        }
        if p_kind(p) == TokenKind.LParen {
            // for call(args) { } 条件循环
            var args = parse_args(p)
            var calle = E("call", name, "(name " + name + ")", args, "(call (name " + name + ") " + args + ")", "")
            if p_kind(p) == TokenKind.Question {
                p_err(p, "v2 unsupported: for-iterator call ")
                return ""
            }
            var cond = expr_with_left(p, calle, 0)
            var b3 = parse_body(p)
            return "(for (cond) " + cond.dump + " " + b3 + ")"
        }
        // for i < max { } / 一般条件式:以 Ident 为 lhs 续解析
        var idente = E("name", name, name, "", "(name " + name + ")", p_lookup(p, name))
        var cond2 = expr_with_left(p, idente, 0)
        var b4 = parse_body(p)
        return "(for (cond) " + cond2.dump + " " + b4 + ")"
    }
    var cond3 = expr_pratt(p, 0)
    var b5 = parse_body(p)
    return "(for (cond) " + cond3.dump + " " + b5 + ")"
}

fn parse_while(mut p P) str {
    p_next(p)
    var had_paren = false
    if p_kind(p) == TokenKind.LParen {
        p_next(p)
        had_paren = true
    }
    skip_empty_lines(p)
    var cond = expr_pratt(p, 0)
    if had_paren {
        p_expect(p, TokenKind.RParen)
    }
    var body = parse_body(p)
    return "(for (cond) " + cond.dump + " " + body + ")"
}

fn parse_return(mut p P) str {
    p_next(p)
    var k = p_kind(p)
    if k == TokenKind.Newline || k == TokenKind.Semi || k == TokenKind.RBrace || k == TokenKind.EOF {
        return "(return (nil))"
    }
    var e = expr_pratt(p, 0)
    return "(return " + e.dump + ")"
}

// 可作名字的 token(对齐 parse_name 盲取文本;结构性分隔符除外——
// 成员/变体名可为关键字,如 UI 方言的 grid)
fn is_name_kind(k TokenKind) bool {
    is k {
        TokenKind.EOF | TokenKind.RBrace | TokenKind.Newline | TokenKind.Semi | TokenKind.Comma | TokenKind.Colon | TokenKind.Asn | TokenKind.LParen | TokenKind.LBrace | TokenKind.LSquare | TokenKind.RParen | TokenKind.RSquare | TokenKind.Arrow | TokenKind.Dot | TokenKind.Lt | TokenKind.Gt -> false
        else -> true
    }
}

// 宿主 soft-ident 面(parser.rs:663 Plan 356):词法保留但表达式位合法
// 作标识符的关键字(`o.tag` 的点右值位等);aavm 镜像同名集合
fn is_soft_ident_kind(k TokenKind) bool {
    is k {
        TokenKind.Tag | TokenKind.Type | TokenKind.Union | TokenKind.Spec | TokenKind.Super | TokenKind.Has | TokenKind.Copy | TokenKind.Move | TokenKind.Take | TokenKind.Hold | TokenKind.Alias | TokenKind.Ext | TokenKind.Impl | TokenKind.Mod | TokenKind.Enum -> true
        else -> false
    }
}

// W3(Plan 511)use 语句:四形态 Display 对齐 ast/use_.rs——
// `use db` → (use (module_path db));`use db: a, b` → +(items a,b);
// `use db: *` → +(wildcard);点路径 tools.helper 原样;异构 use.rs/py →
// (use (kind rust|py) (path foo.Bar))。注:Auto use 的 {} 花括号形态经
// `::` 不可达(宿主 :: 双冒号被 items-colon 消费后报错,W0 实测),
// parse_use_items 的 LBrace 臂仅服务 use.rs 路径形态。
fn parse_use(mut p P) str {
    p_next(p)
    // 异构形态:use.rs / use.py(use 已消费,cur 为 Dot)
    if p_kind(p) == TokenKind.Dot {
        var lang = p_peek_text(p, 1)
        p_next(p)
        p_next(p)
        if lang != "rs" && lang != "py" && lang != "c" {
            p_err(p, "expected language after use., got ")
            return ""
        }
        var kind = "rust"
        if lang == "py" {
            kind = "py"
        } else if lang == "c" {
            kind = "c"
        }
        // 路径段::: 分隔(词法为两个 Colon),Display 以 . 连接
        var path = p_text(p)
        p_next(p)
        while p_kind(p) == TokenKind.Colon && p_peek(p, 1) == TokenKind.Colon {
            p_next(p)
            p_next(p)
            path = path + "." + p_text(p)
            p_next(p)
        }
        return "(use (kind " + kind + ") (path " + path + "))"
    }
    if !is_name_kind(p_kind(p)) {
        p_err(p, "expected module name after use, got ")
        return ""
    }
    var name = p_text(p)
    p_next(p)
    while p_kind(p) == TokenKind.Dot {
        p_next(p)
        if !is_name_kind(p_kind(p)) {
            p_err(p, "expected path segment after dot, got ")
            return ""
        }
        name = name + "." + p_text(p)
        p_next(p)
    }
    var items = ""
    var wildcard = false
    if p_kind(p) == TokenKind.Colon {
        p_next(p)
        if p_kind(p) == TokenKind.Star {
            p_next(p)
            wildcard = true
        } else {
            if !is_name_kind(p_kind(p)) {
                p_err(p, "expected identifier or *, got ")
                return ""
            }
            items = p_text(p)
            p_next(p)
            while p_kind(p) == TokenKind.Comma {
                p_next(p)
                if !is_name_kind(p_kind(p)) {
                    p_err(p, "expected identifier, got ")
                    return ""
                }
                items = items + "," + p_text(p)
                p_next(p)
            }
        }
    }
    var out = "(use (module_path " + name + ")"
    if items != "" {
        out = out + " (items " + items + ")"
    }
    if wildcard {
        out = out + " (wildcard)"
    }
    return out + ")"
}

// type 声明(Plan 434:AA2R 转译 lib 自身需要)。Display 对齐 ast/types.rs
// 的 TypeDecl:仅 members 路径;泛型参数/别名/is/as/has/方法体/字段默认值
// 遇之报 v2 unsupported(lib 未用,golden 02 组部分留后续)
fn parse_type_decl(mut p P) str {
    p_next(p)
    if !is_name_kind(p_kind(p)) {
        p_err(p, "expected type name, got ")
        return ""
    }
    var name = p_text(p)
    p_next(p)
    if p_kind(p) == TokenKind.Lt {
        p_err(p, "v2 unsupported: type generic params ")
        return ""
    }
    if p_kind(p) == TokenKind.Asn {
        p_err(p, "v2 unsupported: type alias ")
        return ""
    }
    if p_kind(p) == TokenKind.Is {
        p_err(p, "v2 unsupported: type inheritance ")
        return ""
    }
    if p_kind(p) == TokenKind.As {
        p_err(p, "v2 unsupported: type as ")
        return ""
    }
    if p_kind(p) == TokenKind.Has {
        p_err(p, "v2 unsupported: type has ")
        return ""
    }
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    var members = ""
    while p.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RBrace {
        if p_kind(p) == TokenKind.Fn || p_kind(p) == TokenKind.Static {
            p_err(p, "v2 unsupported: method in type ")
            return ""
        }
        if p_kind(p) == TokenKind.Hash {
            p_err(p, "v2 unsupported: member attr ")
            return ""
        }
        if !is_name_kind(p_kind(p)) {
            p_err(p, "expected member name, got ")
            return ""
        }
        var fname = p_text(p)
        p_next(p)
        if p_kind(p) == TokenKind.Colon {
            p_next(p)
        }
        var fty = parse_type(p)
        if p_kind(p) == TokenKind.Asn {
            p_err(p, "v2 unsupported: member default value ")
            return ""
        }
        if members != "" {
            members = f"${members} "
        }
        members = f"${members}(member (name ${fname}) (type ${fty}))"
        // 成员间空行:Display 无 nl 载体,基线亦忽略——静默跳过
        expect_eos(p)
        skip_empty_lines(p)
    }
    p_expect(p, TokenKind.RBrace)
    var out = f"(type-decl (name ${name})"
    if members != "" {
        out = f"${out} (members ${members})"
    }
    out = f"${out})"
    p_decl_register(p, name, out)
    return out
}

// enum 声明(Plan 434)。Display 对齐 ast/enums.rs 的 EnumDecl:
// (enum (name X) (item (name A) (value 0)) ...);首项 value 0、显式 = N 后
// last_val=N+1(基线 gap-fill);payload/方法/变体属性遇之报 unsupported
fn parse_enum_decl(mut p P) str {
    p_next(p)
    if !is_name_kind(p_kind(p)) {
        p_err(p, "expected enum name, got ")
        return ""
    }
    var name = p_text(p)
    p_next(p)
    if p_kind(p) == TokenKind.Lt {
        p_err(p, "v2 unsupported: enum generic params ")
        return ""
    }
    if p_kind(p) == TokenKind.Ident || p_kind(p) == TokenKind.Type {
        p_err(p, "v2 unsupported: enum repr type ")
        return ""
    }
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    var out = f"(enum (name ${name}) "
    var next_val = 0
    var first = true
    var any_payload = false
    while p.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RBrace {
        if p_kind(p) == TokenKind.Fn || p_kind(p) == TokenKind.Static {
            p_err(p, "v2 unsupported: method in enum ")
            return ""
        }
        if p_kind(p) == TokenKind.Hash {
            p_err(p, "v2 unsupported: enum variant attr ")
            return ""
        }
        if !is_name_kind(p_kind(p)) {
            p_err(p, "expected variant name, got ")
            return ""
        }
        var vname = p_text(p)
        p_next(p)
        // Plan 447 部分②:载荷变体 Name(T1, T2)/Name{ f T, ... }。Display 与
        // 单元变体同形(载荷类型不入 dump,value 恒 0 不参与自增);载荷类型
        // 按 Enum.Variant.slot 登记进 decls,供 is 臂绑定推断用
        var has_payload = false
        if p_kind(p) == TokenKind.LParen {
            p_next(p)
            skip_empty_lines(p)
            if p_kind(p) != TokenKind.RParen {
                var more_payload = true
                var slot = 0
                while more_payload {
                    var pt = parse_type(p)
                    p_decl_register(p, name + "." + vname + "." + slot.str(), pt)
                    slot = slot + 1
                    if p_kind(p) == TokenKind.Comma {
                        p_next(p)
                        skip_empty_lines(p)
                    } else {
                        more_payload = false
                    }
                }
            }
            p_expect(p, TokenKind.RParen)
            has_payload = true
        } else if p_kind(p) == TokenKind.LBrace {
            p_next(p)
            skip_empty_lines(p)
            var slot2 = 0
            while p.err == "" && p_kind(p) != TokenKind.RBrace && p_kind(p) != TokenKind.EOF {
                if !is_name_kind(p_kind(p)) {
                    p_err(p, "expected variant field name, got ")
                    return ""
                }
                p_next(p)
                if p_kind(p) == TokenKind.Colon {
                    p_next(p)
                }
                var ft = parse_type(p)
                p_decl_register(p, name + "." + vname + "." + slot2.str(), ft)
                slot2 = slot2 + 1
                if p_kind(p) == TokenKind.Comma {
                    p_next(p)
                    skip_empty_lines(p)
                }
                skip_empty_lines(p)
            }
            p_expect(p, TokenKind.RBrace)
            has_payload = true
        }
        any_payload = any_payload || has_payload
        var val = next_val
        if has_payload {
            val = 0
        }
        if p_kind(p) == TokenKind.Asn {
            p_next(p)
            if p_kind(p) != TokenKind.Int {
                p_err(p, "v2 unsupported: enum value ")
                return ""
            }
            val = int_val(p_text(p))
            p_next(p)
        }
        // 载荷变体不推进自增基准(参考实证:Val{VI(int) VS(str) VN} 三项全 0)
        if !has_payload {
            next_val = val + 1
        }
        if !first {
            out = f"${out} "
        }
        out = f"${out}(item (name ${vname}) (value ${val.str()}))"
        first = false
        // 变体间空行同成员:静默跳过
        expect_eos(p)
        skip_empty_lines(p)
    }
    p_expect(p, TokenKind.RBrace)
    // 注册策略(镜像参考注册面):载荷枚举 → 参数位内联完整 enum 快照;
    // 纯标量枚举 → 不注册,参数位落 (type-decl (name X)) 兜底
    if any_payload {
        p_decl_register(p, name, out + ")")
    }
    return out + ")"
}

// ── is 语句(Plan 447 部分② Phase 4:镜像宿主 parser.rs parse_is/
// parse_is_branch/is_branch_cond_expr 的决策,Display 对齐 ast/is.rs) ──

// parse_expr_or_body 直译:{...} → parse_body;return/break/continue 单语句;
// 其余单表达式 → "(body e)"
fn parse_expr_or_body(mut p P) str {
    if p_kind(p) == TokenKind.LBrace {
        return parse_body(p)
    }
    if p_kind(p) == TokenKind.Return {
        return "(body " + parse_return(p) + ")"
    }
    if p_kind(p) == TokenKind.Break {
        p_next(p)
        return "(body (break))"
    }
    if p_kind(p) == TokenKind.Continue {
        p_next(p)
        return "(body (continue))"
    }
    var e = expr_pratt(p, 0)
    return "(body " + e.dump + ")"
}

// 逗号切分(char_at/slice 手写,载荷绑定列表解析用)
fn split_commas(s str) List<str> {
    var out List<str> = List.new()
    var start = 0
    var i = 0
    while i < s.len() {
        if s.char_at(i) == ',' {
            out.push(s.slice(start, i))
            start = i + 1
        }
        i = i + 1
    }
    out.push(s.slice(start, s.len()))
    return out
}

// is_branch_cond_expr 直译(模式位不走表达式语义,D39):Ident 点路径 →
// tag-cover;其余(字面量/裸名/调用形,含 Some(x)——两侧 lexer 均不产出
// SomeKW,宿主同走 Call 路径)交给表达式机。E 复用约定:kind="tag-cover"
// 时 name=枚举名、word=变体名、args=绑定逗号串
fn is_pattern(mut p P) E {
    var k = p_kind(p)
    if k == TokenKind.Ident {
        // 仅当 Ident 后随 Dot 才按点路径拦截(裸名/调用形留给表达式机)
        var nxt = TokenKind.EOF
        if p.pos + 1 < p.toks.len() {
            nxt = p.toks.get(p.pos + 1).kind
        }
        if nxt == TokenKind.Dot {
            var segs List<str> = List.new()
            segs.push(p_text(p))
            p_next(p)
            while p.err == "" && p_kind(p) == TokenKind.Dot {
                p_next(p)
                if !is_name_kind(p_kind(p)) {
                    p_err(p, "expected variant name after '.', got ")
                    return bad_e()
                }
                segs.push(p_text(p))
                p_next(p)
            }
            // 3 段路径剥模块前缀(镜像参考 Call 转换:kind 取倒数第二段)
            var ek = segs.get(segs.len() - 2)
            var tg = segs.get(segs.len() - 1)
            var bind_list List<str> = List.new()
            if p_kind(p) == TokenKind.LParen {
                p_next(p)
                skip_empty_lines(p)
                if p_kind(p) != TokenKind.RParen {
                    var more_bind = true
                    while more_bind {
                        if !is_name_kind(p_kind(p)) {
                            p_err(p, "expected pattern binding, got ")
                            return bad_e()
                        }
                        bind_list.push(p_text(p))
                        p_next(p)
                        if p_kind(p) == TokenKind.Comma {
                            p_next(p)
                            skip_empty_lines(p)
                        } else {
                            more_bind = false
                        }
                    }
                }
                p_expect(p, TokenKind.RParen)
            } else {
                // 无括号单元变体 → bindings ["_"](参考 TagCover 约定)
                bind_list.push("_")
            }
            var bj = ""
            var aj = ""
            var i = 0
            while i < bind_list.len() {
                if i > 0 {
                    bj = f"${bj} "
                    aj = f"${aj},"
                }
                bj = bj + bind_list.get(i)
                aj = aj + bind_list.get(i)
                i = i + 1
            }
            var d = f"(tag-cover (kind ${ek}) (tag ${tg}) (bindings ${bj}))"
            return E("tag-cover", tg, ek, aj, d, "")
        }
    }
    return expr_pratt(p, 0)
}

// parse_is_branch 直译:If → "(if cond body)";Else → "(else body)";
// Eq → "(eq p1 [| p2]... body)";首模式 tag-cover 的载荷绑定入臂体作用域
// (载荷类型查 Enum.Variant.slot 登记)
fn parse_is_branch(mut p P) str {
    var k = p_kind(p)
    if k == TokenKind.If {
        p_next(p)
        var c = expr_pratt(p, 0)
        p_expect(p, TokenKind.Arrow)
        var b = parse_expr_or_body(p)
        skip_empty_lines(p)
        return "(if " + c.dump + " " + b + ")"
    }
    if k == TokenKind.Else {
        p_next(p)
        p_expect(p, TokenKind.Arrow)
        var b2 = parse_expr_or_body(p)
        skip_empty_lines(p)
        return "(else " + b2 + ")"
    }
    var pat = is_pattern(p)
    var extra List<str> = List.new()
    while p.err == "" && p_kind(p) == TokenKind.VBar {
        p_next(p)
        skip_empty_lines(p)
        var np = is_pattern(p)
        extra.push(np.dump)
        skip_empty_lines(p)
    }
    p_expect(p, TokenKind.Arrow)
    skip_empty_lines(p)
    var body = ""
    var scoped = false
    if pat.kind == "tag-cover" && pat.args != "" && pat.args != "_" {
        var binds = split_commas(pat.args)
        var real = false
        var i = 0
        while i < binds.len() {
            if binds.get(i) != "_" {
                real = true
            }
            i = i + 1
        }
        if real {
            push_scope(p)
            scoped = true
            var i2 = 0
            while i2 < binds.len() {
                if binds.get(i2) != "_" {
                    var slot_ty = p_decl_lookup(p, pat.name + "." + pat.word + "." + i2.str())
                    p_bind(p, binds.get(i2), slot_ty)
                }
                i2 = i2 + 1
            }
        }
    }
    body = parse_expr_or_body(p)
    if scoped {
        pop_scope(p)
    }
    var out = f"(eq ${pat.dump} "
    var j = 0
    while j < extra.len() {
        out = f"${out}| ${extra.get(j)} "
        j = j + 1
    }
    skip_empty_lines(p)
    return out + body + ")"
}

// parse_is 直译:语句位 "(is target br1 br2...)";臂间可选逗号
fn parse_is(mut p P) str {
    p_next(p)
    var t = expr_pratt(p, 0)
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    var branches = ""
    var first = true
    while p.err == "" && p_kind(p) != TokenKind.RBrace && p_kind(p) != TokenKind.EOF {
        var b = parse_is_branch(p)
        if !first {
            branches = f"${branches} "
        }
        branches = branches + b
        first = false
        if p_kind(p) == TokenKind.Comma {
            p_next(p)
            skip_empty_lines(p)
        }
    }
    p_expect(p, TokenKind.RBrace)
    return "(is " + t.dump + " " + branches + ")"
}

fn is_unsupported_stmt_kind(k TokenKind) bool {
    is k {
        TokenKind.Spec | TokenKind.Tag | TokenKind.Union | TokenKind.Ext | TokenKind.Impl | TokenKind.Task | TokenKind.On | TokenKind.Dep | TokenKind.Hash | TokenKind.HashIf | TokenKind.HashFor | TokenKind.HashIs | TokenKind.HashBrace | TokenKind.HashIdent | TokenKind.Try | TokenKind.Yield | TokenKind.Reply | TokenKind.View -> true
        else -> false
    }
}

fn parse_stmt(mut p P) str {
    if p.err != "" {
        return ""
    }
    var k = p_kind(p)
    if k == TokenKind.Let || k == TokenKind.Var || k == TokenKind.Const || k == TokenKind.Shared {
        return parse_store(p, k)
    }
    if k == TokenKind.Mut {
        p_err(p, "'mut' is not supported as a storage modifier ")
        return ""
    }
    if k == TokenKind.Type {
        return parse_type_decl(p)
    }
    if k == TokenKind.Enum {
        return parse_enum_decl(p)
    }
    if k == TokenKind.Fn {
        return parse_fn(p)
    }
    if k == TokenKind.If {
        return if_contents(p)
    }
    if k == TokenKind.For {
        return parse_for(p)
    }
    if k == TokenKind.Is {
        return parse_is(p)
    }
    if k == TokenKind.While {
        return parse_while(p)
    }
    if k == TokenKind.Loop {
        p_next(p)
        var b = parse_body(p)
        return "(for (ever) (nil) " + b + ")"
    }
    if k == TokenKind.Break {
        p_next(p)
        return "(break)"
    }
    if k == TokenKind.Continue {
        p_next(p)
        return "(continue)"
    }
    if k == TokenKind.Return {
        return parse_return(p)
    }
    if k == TokenKind.LBrace {
        return parse_body(p)
    }
    if k == TokenKind.Use {
        return parse_use(p)
    }
    if is_unsupported_stmt_kind(k) {
        p_err(p, "v2 unsupported: " + kind_name(k) + " ")
        return ""
    }
    if k == TokenKind.Ident && p_text(p) == "pub" {
        // W3:pub 前缀——跳过后递归(pub fn/let/var;D3:VM 链路无过滤,
        // dump 不承载 pub 位)
        p_next(p)
        return parse_stmt(p)
    }
    var e = expr_pratt(p, 0)
    return e.dump
}

// parse_body_inner 直译(方法链合并 Missing;空 body → "(body )")
fn parse_body(mut p P) str {
    p_expect(p, TokenKind.LBrace)
    push_scope(p)
    var stmts List<str> = List.new()
    var nl = skip_empty_lines(p)
    if nl > 1 {
        stmts.push("(nl*" + (nl - 1).str() + ")")
    }
    while p.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RBrace {
        var s = parse_stmt(p)
        stmts.push(s)
        var n = expect_eos(p)
        if n > 1 {
            stmts.push("(nl*" + (n - 1).str() + ")")
        }
    }
    p_expect(p, TokenKind.RBrace)
    pop_scope(p)
    return "(body " + join_dump_list(stmts, " ") + ")"
}

// expect_eos 直译(Semi/Newline/Comma 皆可分隔;返回 newline 数)
fn expect_eos(mut p P) int {
    var count = 0
    var has_sep = false
    while p_kind(p) == TokenKind.Semi || p_kind(p) == TokenKind.Newline || p_kind(p) == TokenKind.Comma {
        has_sep = true
        if p_kind(p) == TokenKind.Newline {
            count = count + 1
        }
        p_next(p)
    }
    if p_kind(p) == TokenKind.EOF || p_kind(p) == TokenKind.RBrace {
        return count
    }
    if !has_sep {
        p_err(p, "expected end of statement, got ")
        return 0
    }
    return count
}

// parse_impl 直译(#section/convert_last_block Missing;空 code → "(code )")
fn parse_program(mut p P) str {
    var stmts List<str> = List.new()
    skip_empty_lines(p)
    while p.err == "" && p_kind(p) != TokenKind.EOF {
        var s = parse_stmt(p)
        stmts.push(s)
        var n = expect_eos(p)
        if n > 1 {
            stmts.push("(nl*" + (n - 1).str() + ")")
        }
    }
    return "(code " + join_dump_list(stmts, " ") + ")"
}

// M2 闸门入口:parse_dump(source) -> str
// 注意:当前 VM 存在字符串池 RC 回归(运行期串 List.push 后读回 UAF,
// 242 tracker)——本入口在 VM 修复前会在含 List push 的循环上 canary。
fn parse_dump(source str) str {
    var toks = tokenize(source)
    var p = parse_new(toks)
    var dump = parse_program(p)
    if p.err != "" {
        return p.err
    }
    return dump
}

// ╔═══════════════════════════════════════════════════════════╗
// ║ AAVM v2 Sync Snapshot                                     ║
// ║ Component: typeinfo.at (Plan 432 S3 / D27: typecheck_dump)║
// ║ Rust ref:  infer/expr.rs + codegen .type 属性 @ 432 基线  ║
// ║ Gate:      M3 —— corpus_m3 `.type` 输出与 Rust VM 一致     ║
// ╚═══════════════════════════════════════════════════════════╝
//           447-③ 终局收账:t_infer_expr 主分派/t_literal_type/
//           t_binop_result/t_unify is 化(Y1/11.1);FStrStart → str;
//           D23/D27 判据层形状保留(dump 口径耦合,见 divergences 终局节)
// Coverage:  TFnSig 函数注册表(fn 名→ret Display 串,参数经 p_bind 入
//            作用域)——"单一 TypeStore"的 S3 裁剪;infer 传播(字面量全集/
//            标识符作用域查找/调用→注册表返回类型/数组元素提取/二元运算
//            ——算术取操作数统一型、比较恒 bool/元组连接);未知型输出
//            "unknown"(对齐 Type::Unknown 的 unique_name);语句级走查
//            (fn 声明注册+体内 let/var 绑定+print(EXPR.type) 查询收集)
// Missing:   混合算术 coercion(1 + 1.5 的数值提升,语料未含)、let 显式
//            注解与推断冲突检查、块级作用域遮蔽(fn 体扁平遍历)、对象/
//            方法调用/下标链推断、类型/spec 声明表(S4 按需)、类型错误
//            样例通道(解释器路径无独立 typeck pass 可镜像,见
//            m3-typecheck-format.md 考古结论)
// DIVERGE:   D27: infer/expr.rs(infer_expr 枚举匹配)→ typecheck_dump
//                 行式输出(判据层)——AAVM 不建 AST,自带轻量表达式型推
//                 断器(优先级表复用 parser.at 的 infix_l/infix_r);
//            D23 同款:类型以 Display 字符串为载体(数组型
//                 "(array-type (elem T) (len n))" 与 Rust Array Display 同形,
//                 元素提取按该形状解析);
//            D22 同款:t.err 单槽短路,错误返回 "TYPE-ERROR:..." 使闸门爆红;
//            复用契约:复用 lexer.at 的 tokenize 与 parser.at 的游标/类型
//            解析助手(p_kind/p_next/p_expect/parse_type/is_type_name/
//            p_bind/p_lookup),不调用 parse_* 语句族(避免 dump 副作用)

// ── 函数签名注册表(TypeStore 的 S3 裁剪) ──────────────────────

type TFnSig {
    name str
    ret str
}

// ── 语句级走查 ────────────────────────────────────────────────
// 复用 parser.at 的 P(游标+作用域),外加 fn 注册表与输出行收集。

// fn 声明走查:镜像 parse_fn 的签名词法流(name/泛型拒绝/params 绑定/ret),
// 但不构造 dump。体内语句交回 t_stmt_walk。
fn t_fn_walk(mut p P, mut fns List<TFnSig>, mut out List<str>) {
    p_next(p)
    if p_kind(p) == TokenKind.Dot || p_kind(p) == TokenKind.Lt {
        p_err(p, "typeinfo: unsupported fn form ")
        return
    }
    if p_kind(p) != TokenKind.Ident {
        p_err(p, "typeinfo: expected fn name ")
        return
    }
    var name = p_text(p)
    p_next(p)
    push_scope(p)
    p_expect(p, TokenKind.LParen)
    // 参数:镜像 parse_fn_params 的词法流(mode 词/name/:类型/默认值),绑定入作用域
    skip_empty_lines(p)
    var running = true
    while running && p.err == "" {
        var k = p_kind(p)
        if k == TokenKind.View || k == TokenKind.Mut || k == TokenKind.Move || k == TokenKind.Take || k == TokenKind.Copy {
            p_next(p)
        }
        if p_kind(p) != TokenKind.Ident {
            running = false
        } else {
            var pname = p_text(p)
            p_next(p)
            var ty = "int"
            if p_kind(p) == TokenKind.Colon {
                p_next(p)
            }
            if is_type_name(p) {
                ty = parse_type(p)
            }
            if p_kind(p) == TokenKind.Asn {
                p_next(p)
                expr_pratt(p, 0)
            }
            p_bind(p, pname, ty)
            if p_kind(p) == TokenKind.Comma {
                p_next(p)
            } else {
                running = false
            }
        }
    }
    p_expect(p, TokenKind.RParen)
    var ret = ""
    if p_kind(p) == TokenKind.Arrow {
        p_next(p)
        ret = parse_type(p)
        skip_empty_lines(p)
    } else if is_type_name(p) {
        ret = parse_type(p)
        skip_empty_lines(p)
    } else if p_kind(p) == TokenKind.LBrace || p_kind(p) == TokenKind.Semi {
        ret = "void"
    }
    fns.push(TFnSig(name, ret))
    if p_kind(p) == TokenKind.Semi {
        p_next(p)
        pop_scope(p)
        return
    }
    t_body_walk(p, fns, out)
    pop_scope(p)
}

// fn 体:期望 LBrace,扁平遍历至配对 RBrace(嵌套块按平衡跳过,Missing:
// 块级作用域)。
fn t_body_walk(mut p P, mut fns List<TFnSig>, mut out List<str>) {
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    while p.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RBrace {
        t_stmt_walk(p, fns, out)
        if p.err == "" {
            // expect_eos 直译(Semi/Newline/Comma 分隔;不产 nl 行)
            var has_sep = false
            while p_kind(p) == TokenKind.Semi || p_kind(p) == TokenKind.Newline || p_kind(p) == TokenKind.Comma {
                has_sep = true
                p_next(p)
            }
            if p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RBrace && !has_sep {
                p_err(p, "typeinfo: expected end of statement ")
            }
        }
    }
    p_expect(p, TokenKind.RBrace)
}

// print(EXPR.type) 查询收集:识别 print 调用且实参以 .type 收尾。
// 返回 1 = 已处理(含非查询的普通 print:求值后跳过)。
// pos+1 处是否 .type 属性词("type" 是关键字,lex 为 Type;亦容 Ident)
fn t_is_type_prop(p P) bool {
    var nk = p_peek(p, 1)
    if nk == TokenKind.Type {
        return true
    }
    return nk == TokenKind.Ident && p_text_at(p, 1) == "type"
}

fn t_try_print_query(mut p P, mut out List<str>, mut fns List<TFnSig>) int {
    if p_kind(p) != TokenKind.Ident || p_text(p) != "print" {
        return 0
    }
    if p_peek(p, 1) != TokenKind.LParen {
        return 0
    }
    p_next(p)
    p_next(p)
    skip_empty_lines(p)
    // 解析实参表达式;若随后是 .type 则收集该表达式的推断型
    var ty = t_infer_expr(p, 0, fns)
    if p_kind(p) == TokenKind.Dot && t_is_type_prop(p) {
        p_next(p)
        p_next(p)
        if ty == "" {
            ty = "unknown"
        }
        out.push(ty)
    }
    // 其余实参按分隔符消费至 RParen
    while p.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RParen {
        t_infer_expr(p, 0, fns)
        if p_kind(p) == TokenKind.Comma || p_kind(p) == TokenKind.Newline {
            p_next(p)
            skip_empty_lines(p)
        } else if p_kind(p) != TokenKind.RParen {
            p_err(p, "typeinfo: expected argument separator ")
        }
    }
    p_expect(p, TokenKind.RParen)
    return 1
}

// 前瞻读取 pos+n 处 token 文本(不推进)
fn p_text_at(p P, n int) str {
    var i = p.pos + n
    if i >= p.toks.len() {
        return ""
    }
    return p.toks.get(i).text
}

// 语句分派:fn → 注册;let/var → 推断绑定;print 查询;其余表达式消费。
// ── is 语句走查(Plan 447 部分② Phase 5)───────────────────────
// 臂体走查 + 载荷绑定按 Enum.Variant.slot 入局部作用域(镜像宿主 infer
// 对 is 臂绑定的处理);print(EXPR.type) 查询在臂体内照常收集。

// 臂体:{...} 块逐语句;return/break/continue 单语句;其余单表达式语句
fn t_walk_is_arm_body(mut p P, mut fns List<TFnSig>, mut out List<str>) {
    if p_kind(p) == TokenKind.LBrace {
        t_body_walk(p, fns, out)
        return
    }
    if p_kind(p) == TokenKind.Return {
        p_next(p)
        var k = p_kind(p)
        if k == TokenKind.Newline || k == TokenKind.Semi || k == TokenKind.RBrace || k == TokenKind.EOF {
            return
        }
        t_infer_expr(p, 0, fns)
        return
    }
    if p_kind(p) == TokenKind.Break || p_kind(p) == TokenKind.Continue {
        p_next(p)
        return
    }
    t_stmt_walk(p, fns, out)
}

fn t_is_walk(mut p P, mut fns List<TFnSig>, mut out List<str>) {
    p_next(p)
    t_infer_expr(p, 0, fns)
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    while p.err == "" && p_kind(p) != TokenKind.RBrace && p_kind(p) != TokenKind.EOF {
        if p_kind(p) == TokenKind.If {
            p_next(p)
            t_infer_expr(p, 0, fns)
            p_expect(p, TokenKind.Arrow)
            t_walk_is_arm_body(p, fns, out)
        } else if p_kind(p) == TokenKind.Else {
            p_next(p)
            p_expect(p, TokenKind.Arrow)
            t_walk_is_arm_body(p, fns, out)
        } else {
            push_scope(p)
            // 模式复用 parser.at 的 is_pattern(游标推进 + tag-cover 绑定
            // 信息:name=枚举名/word=变体名/args=绑定逗号串)
            var pat = is_pattern(p)
            while p.err == "" && p_kind(p) == TokenKind.VBar {
                p_next(p)
                skip_empty_lines(p)
                is_pattern(p)
                skip_empty_lines(p)
            }
            p_expect(p, TokenKind.Arrow)
            skip_empty_lines(p)
            if pat.kind == "tag-cover" && pat.args != "" && pat.args != "_" {
                var binds = split_commas(pat.args)
                var i = 0
                while i < binds.len() {
                    if binds.get(i) != "_" {
                        var slot_ty = p_decl_lookup(p, pat.name + "." + pat.word + "." + i.str())
                        p_bind(p, binds.get(i), slot_ty)
                    }
                    i = i + 1
                }
            }
            t_walk_is_arm_body(p, fns, out)
            pop_scope(p)
        }
        if p_kind(p) == TokenKind.Comma {
            p_next(p)
            skip_empty_lines(p)
        }
        skip_empty_lines(p)
    }
    p_expect(p, TokenKind.RBrace)
}

fn t_stmt_walk(mut p P, mut fns List<TFnSig>, mut out List<str>) {
    if p.err != "" {
        return
    }
    if t_try_print_query(p, out, fns) == 1 {
        return
    }
    var k = p_kind(p)
    if k == TokenKind.Fn {
        t_fn_walk(p, fns, out)
        return
    }
    if k == TokenKind.Enum {
        // 枚举声明(Plan 447 部分② Phase 5):直接复用 parser.at 的
        // parse_enum_decl——载荷类型按 Enum.Variant.slot 入 decls 与
        // parser 侧单一事实源(返回的 dump 串弃置,无走查副作用)
        parse_enum_decl(p)
        return
    }
    if k == TokenKind.Type {
        // W1:struct 声明走查——复用 parse_type_decl(注册入 p.decls,
        // dump 弃置);字段型经 t_field_ty 从注册 dump 提取
        parse_type_decl(p)
        return
    }
    if k == TokenKind.Is {
        t_is_walk(p, fns, out)
        return
    }
    if k == TokenKind.Let || k == TokenKind.Var || k == TokenKind.Const || k == TokenKind.Shared {
        p_next(p)
        if p_kind(p) != TokenKind.Ident {
            p_err(p, "typeinfo: expected store name ")
            return
        }
        var name = p_text(p)
        p_next(p)
        var ty = ""
        if is_type_name(p) {
            ty = parse_type(p)
        }
        if p_kind(p) == TokenKind.Asn {
            p_next(p)
            var ity = t_infer_expr(p, 0, fns)
            if ty == "" {
                ty = ity
            }
        }
        p_bind(p, name, ty)
        return
    }
    // 其余语句:按表达式消费(if/for/while 等控制流的条件部分会被消费,
    // 体走查不递归——语料不含,Missing 登记)
    t_infer_expr(p, 0, fns)
}

// ── 表达式类型推断(infer/expr.rs 核心子集,D27) ───────────────
// 优先级表复用 parser.at 的 infix_l/infix_r/postfix_power/prefix_power。

// 字面量 kind → 型
fn t_literal_type(k TokenKind) str {
    is k {
        TokenKind.Int | TokenKind.I8 | TokenKind.U8 -> "int"
        TokenKind.Uint -> "uint"
        TokenKind.Float -> "float"
        TokenKind.Double -> "double"
        TokenKind.True | TokenKind.False -> "bool"
        TokenKind.Char -> "char"
        TokenKind.Str -> "str"
        else -> ""
    }
}

// 数组型 "(array-type (elem T) (len n))" → T;非该形状返回 ""
fn t_array_elem(ty str) str {
    var head = "(array-type (elem "
    if ty.len() >= head.len() && ty.slice(0, head.len()) == head {
        var rest = ty.slice(head.len(), ty.len())
        var depth = 1
        var i = 0
        while i < rest.len() {
            var c = rest.char_at(i)
            if c == '(' {
                depth = depth + 1
            } else if c == ')' {
                depth = depth - 1
                if depth == 0 {
                    return rest.slice(0, i)
                }
            }
            i = i + 1
        }
    }
    return ""
}

// unify 简式(D23):一方未知取另一方;相同取之;不匹配 → ""(Unknown)
fn t_unify(a str, b str) str {
    is a {
        "" -> b
        if b == "" -> a
        if a == b -> a
        else -> ""
    }
}

// 二元运算结果型(infer_binop_type 直译)
fn t_binop_result(op Op, l str, r str) str {
    is op {
        Op.Eq | Op.Neq | Op.Lt | Op.Gt | Op.Le | Op.Ge -> "bool"
        Op.Add | Op.Sub | Op.Mul | Op.Div | Op.Mod -> t_unify(l, r)
        Op.AddEq | Op.SubEq | Op.MulEq | Op.DivEq | Op.ModEq | Op.Asn -> t_unify(l, r)
        Op.And | Op.Or -> "bool"
        else -> ""
    }
}

// 表达式推断:优先级爬升(镜像 expr_pratt 骨架,只产类型不产 dump)
fn t_infer_expr(mut p P, min int, mut fns List<TFnSig>) str {
    if p.err != "" {
        return ""
    }
    var k = p_kind(p)
    var lhs = ""
    // A2:主分派 is 化(前缀/元组/数组/原子;镜像 Rust expr_pratt)
    is k {
        TokenKind.Add | TokenKind.Sub | TokenKind.Not | TokenKind.Star -> {
            var pow = prefix_power(p_op(k))
            p_next(p)
            var operand = t_infer_expr(p, pow, fns)
            if k == TokenKind.Not {
                lhs = "bool"
            } else {
                lhs = operand
            }
        }
        TokenKind.LParen -> {
        p_next(p)
        // 元组判定简化:组内逗号即元组(连接型),否则 group 透传
        lhs = t_infer_expr(p, 0, fns)
        var parts List<str> = List.new()
        var lh2 = f"${lhs}"
        parts.push(lh2)
        while p_kind(p) == TokenKind.Comma {
            p_next(p)
            var e = t_infer_expr(p, 0, fns)
            parts.push(e)
        }
        p_expect(p, TokenKind.RParen)
        if parts.len() > 1 {
            lhs = t_join_types(parts)
        }
        }
        TokenKind.FStrStart -> {
            // 447-③ 11.2a:f-string 类型恒 str(镜像宿主 ObjectType::String)
            lhs = "str"
            p_next(p)
            p_next(p)
            p_next(p)
        }
        TokenKind.LSquare -> {
        // 数组字面量:元素型取首元素,Display 同 Rust Array
        p_next(p)
        skip_empty_lines(p)
        var first = ""
        var n = 0
        while p.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RSquare {
            var e = t_infer_expr(p, 0, fns)
            if n == 0 {
                first = e
            }
            n = n + 1
            var has_sep = false
            while p_kind(p) == TokenKind.Comma || p_kind(p) == TokenKind.Newline {
                has_sep = true
                p_next(p)
            }
            if p_kind(p) != TokenKind.RSquare && !has_sep {
                p_err(p, "typeinfo: expected array separator ")
            }
        }
        p_expect(p, TokenKind.RSquare)
        if n > 0 {
            lhs = f"(array-type (elem ${first}) (len ${n.str()}))"
        }
        }
        else -> {
        // ── 原子:字面量 / 标识符(含调用/下标后缀) ──
        var lit = t_literal_type(k)
        if lit != "" {
            lhs = lit
            p_next(p)
        } else if k == TokenKind.Ident {
            var name = p_text(p)
            p_next(p)
            // W1 构造字面量:已注册类型紧随 { → 消费 pairs,推断=类型名
            // (镜像宿主可观察行为:var_types 记 base 名,`.type` 链可用)
            if p_kind(p) == TokenKind.LBrace && p_decl_lookup(p, name) != "" {
                t_ctor_consume(p, fns)
                lhs = name
            } else {
            lhs = p_lookup(p, name)
            // 调用后缀:注册表查返回类型
            if p_kind(p) == TokenKind.LParen {
                lhs = t_fn_ret(fns, name)
                parse_args(p)
            }
            // 下标后缀:数组元素型
            if p_kind(p) == TokenKind.LSquare {
                p_next(p)
                t_infer_expr(p, 0, fns)
                p_expect(p, TokenKind.RSquare)
                lhs = t_array_elem(lhs)
            }
            }
        } else {
            p_err(p, "typeinfo: expected expression, got ")
            return ""
        }
        }
    }
    // ── 中缀循环 ──
    while p.err == "" {
        var opk = p_kind(p)
        // P2:循环顶 token 分派 is 化(11 种界符臂内 break;镜像 Rust
        // parser.rs:2425 的 match kind)
        is opk {
            TokenKind.EOF | TokenKind.Newline | TokenKind.Semi | TokenKind.LBrace | TokenKind.RBrace | TokenKind.Comma | TokenKind.Arrow | TokenKind.DoubleArrow | TokenKind.VBar | TokenKind.RSquare | TokenKind.RParen -> {
                break
            }
            else -> {
                // .type 属性:停走留给调用方(print 查询)消费——它是作用于整个
                // 表达式的后缀属性,不是方法调用
                if opk == TokenKind.Dot && t_is_type_prop(p) {
                    break
                }
                if !is_op_kind(opk) {
                    p_err(p, "typeinfo: expected infix operator, got ")
                    break
                }
                var l = infix_l(p_op(opk))
                if l == 0 || l < min {
                    break
                }
                p_next(p)
                if opk == TokenKind.Or || opk == TokenKind.And {
                    skip_empty_lines(p)
                }
                // W1 字段访问推断:Dot+名(soft-ident 含)且 lhs 型为已注册
                // 用户类型(裸名或完整 type-decl dump)→ 按字段名查型;
                // 名后跟 ( 为方法调用 → 消费实参,推断 unknown(镜像宿主
                // 方法推断面);非名右值落回通用中缀
                var dot_field_done = false
                if opk == TokenKind.Dot {
                    var fk = p_kind(p)
                    if fk == TokenKind.Ident || is_soft_ident_kind(fk) {
                        var fld = p_text(p)
                        p_next(p)
                        if p_kind(p) == TokenKind.LParen {
                            parse_args(p)
                            lhs = ""
                        } else {
                            var dump = ""
                            if lhs.len() >= 11 && lhs.slice(0, 11) == "(type-decl " {
                                dump = lhs
                            } else {
                                dump = p_decl_lookup(p, lhs)
                            }
                            lhs = t_field_ty(dump, fld)
                        }
                        dot_field_done = true
                    }
                }
                if !dot_field_done {
                    var rhs = t_infer_expr(p, infix_r(p_op(opk)), fns)
                    lhs = t_binop_result(p_op(opk), lhs, rhs)
                }
            }
        }
    }
    return lhs
}

// W1 构造字面量消费:X { a: e1, b: e2 } —— 值表达式逐个推断(结果弃置,
// 查询语境不会出现在构造位),键限名字 token;sep 逗号/换行
fn t_ctor_consume(mut p P, mut fns List<TFnSig>) {
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    while p.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RBrace {
        var k = p_kind(p)
        if k != TokenKind.Ident && !is_soft_ident_kind(k) {
            p_err(p, "typeinfo: expected field name in struct ctor, got ")
            return
        }
        p_next(p)
        p_expect(p, TokenKind.Colon)
        t_infer_expr(p, 0, fns)
        var sk = p_kind(p)
        if sk == TokenKind.Comma || sk == TokenKind.Newline {
            p_next(p)
            skip_empty_lines(p)
        } else if sk != TokenKind.RBrace {
            p_err(p, "typeinfo: expected pair separator, got ")
        }
    }
    p_expect(p, TokenKind.RBrace)
}

// W1 字段型提取:从注册的 type-decl dump 里按字段名取 "(type T)" 的 T
// (T 可为嵌套 type-decl/array-type,括号配平截取);无该字段返回 ""
fn t_field_ty(dump str, field str) str {
    if dump == "" {
        return ""
    }
    var pat = "(member (name " + field + ") (type "
    var i = 0
    while i + pat.len() <= dump.len() {
        if dump.slice(i, i + pat.len()) == pat {
            // 字段名精确边界:模式尾随 ") (type " 已保证
            var rest = dump.slice(i + pat.len(), dump.len())
            var depth = 1
            var j = 0
            while j < rest.len() {
                var c = rest.char_at(j)
                if c == '(' {
                    depth = depth + 1
                } else if c == ')' {
                    depth = depth - 1
                    if depth == 0 {
                        return rest.slice(0, j)
                    }
                }
                j = j + 1
            }
            return ""
        }
        i = i + 1
    }
    return ""
}

fn t_join_types(parts List<str>) str {
    var out = "("
    var i = 0
    while i < parts.len() {
        if i > 0 {
            out = f"${out}, "
        }
        out = out + parts.get(i)
        i = i + 1
    }
    return out + ")"
}

fn t_fn_ret(fns List<TFnSig>, name str) str {
    var i = fns.len() - 1
    while i >= 0 {
        if fns.get(i).name == name {
            return fns.get(i).ret
        }
        i = i - 1
    }
    return ""
}

// ── M3 闸门入口:typecheck_dump(source) -> str ─────────────────
fn typecheck_dump(source str) str {
    var toks = tokenize(source)
    var p = parse_new(toks)
    var fns List<TFnSig> = List.new()
    var out List<str> = List.new()
    skip_empty_lines(p)
    while p.err == "" && p_kind(p) != TokenKind.EOF {
        t_stmt_walk(p, fns, out)
        if p.err == "" {
            var has_sep = false
            while p_kind(p) == TokenKind.Semi || p_kind(p) == TokenKind.Newline || p_kind(p) == TokenKind.Comma {
                has_sep = true
                p_next(p)
            }
            if p_kind(p) != TokenKind.EOF && !has_sep {
                p_err(p, "typeinfo: expected end of statement ")
            }
        }
    }
    if p.err != "" {
        return p.err
    }
    var s = ""
    var i = 0
    while i < out.len() {
        if i > 0 {
            s = s + "\n"
        }
        s = s + out.get(i)
        i = i + 1
    }
    return s
}

// ╔═══════════════════════════════════════════════════════════╗
// ║ AAVM v2 Sync Snapshot                                     ║
// ║ Component: codegen.at (Plan 432 S4 / D28: codegen_dump)   ║
// ║ Rust ref:  vm/codegen.rs(Stmt 发射)+ vm/loader.rs(链接) ║
// ║ Gate:      M4 —— corpus_m4 字节码与 Rust codegen 结构一致  ║
// ╚═══════════════════════════════════════════════════════════╝
//           447-③ 终局收账:I.op → enum OpCode(C1)/cg 中缀环 is(P2)/
//           break-continue 占位回填/cg_fstr build.fstr(11.2a);
//           布局等价策略保留(D28 余项)
// Coverage:  脚本 wrapper(FN_PROLOG args=0 locals=16 + RESERVE 16);
//            fn 编译(每 fn 一个 jmp-over、FN_PROLOG/RESERVE 占位回填、
//            体块弹出的槽释放组、epilogue RET、jmp-over patch);
//            语句(let/var 存储无 dup-pop、赋值表达式语句 load-rhs-op-
//            dup-store-pop、复合赋值同型、if/else-if/else(含 return 后
//            死 jmp)、while(back-jmp 不含语句 .line)、for-in-range
//            增量循环(循环域弹出发释放)、return);表达式(Int/Str/bool
//            字面量、标识符寻址[param 0x80+rel / loc.0 / loc.1 /
//            local N]、二元算术/比较/逻辑、一元 !、用户 fn 调用(符号
//            表解析)、print CALL_NAT nat#10、str.cat);字符串池内容
//            寻址去重;.line 由语句步行者按语句首行发射;跳转 patch
//            (目标指令索引 → 字节偏移);
//            [M4 扩]数组字面量(elems+create.arr count=N)、下标读
//            (arr,idx,get.elem)与下标写(rhs,arr,idx,set.elem——value
//            展栈底,Rust quick-fix 栈序镜像)、.len()→arr.len(仅数组
//            接收者,镜像 Rust infer_object_type==Array 闸,7177)、顶层
//            非 fn 语句(wrapper 内步行,.line 同 cg_stmts);let/var 的
//            数组性绑定跟踪(CGVar.arr,供 .len() 接收者判定)
// Missing:   对象/元组字面量与方法调用(.str() 等 CALL_NAT 家族)、
//            字符串下标(get.elem 的 str→码点分支)、闭包/捕获、
//            浮点(CONST_F32/PROMOTE)、全局变量(LOAD_GLOBAL/
//            STORE_GLOBAL)、下标复合赋值、一元负号(NEG)、嵌套赋值、
//            #[vm] stub、生成器、多模块链接
// DIVERGE:   D28: Vec<u8> 字节码 + 链接重定位 → 指令 List(I{op,s,n})+
//            序列化直出 —— 发射顺序/操作数逐字对齐;FN_PROLOG/RESERVE
//            由 Rust 的"体后插入+地址平移"改为"占位+回填"(布局等价);
//            CALL 的链接重定位改为符号表(FnEntry)序列化期解析;槽释放
//            组按槽位升序(Rust pop_scope 按 HashMap 迭代序不定,m4 闸门
//            Rust 侧 dumper 同步规范化)。作用域栈 depth 计数(List 只增
//            不减,D25 写法)。D22 同款错误短路;复用 parser.at 的 token
//            游标/优先级表与 typeinfo.at 的 p_text_at。

// ── 载体 ──────────────────────────────────────────────────────

// 指令:op=助记符(空=已删除占位);s=序列化操作数文本;n=patch 载荷
// (jmp/jmp.z:目标指令索引;call:FnEntry 索引;load.str:池索引)
type I {
    op OpCode
    s str
    n int
}

type FnEntry {
    name str
    ins int
}

type CGVar {
    name str
    idx int
    arr int
    // 447-③ 11.2a:build.fstr 段类型 tag 用(""=int/未知,宿主默认同;
    // "str" → tag 1;仅 str 需显式识别,其余值域 tag 0)
    ty str
}

type CG {
    ins List<I>
    pool List<str>
    fns List<FnEntry>
    scopes List<List<CGVar>>
    depth int
    n_args int
    max_idx int
    err str
    str_flag int
    arr_flag int
    // Plan 447 部分②:枚举注册表(镜像宿主 enum_values + generic_registry
    // 载荷模板)。consts:"Enum.Variant"→判别值(scalar 链;载荷变体按
    // 位序,镜像 scalar_value.unwrap_or(i));ctors:"Enum.Variant"→字段数
    consts List<CGEnum>
    ctors List<CGEnum>
    // P2:循环 break/continue 占位回填(镜像宿主 H2 patch_jump_to;aavm
    // 侧首实现)。帧按层深 append-only(engine.at args_stack 同款,无
    // List.pop opcode);cont_tg 为各层 continue 落点(while=条件顶,
    // for=步进位)
    brk_js List<List<int>>
    cont_js List<List<int>>
    cont_tg List<int>
    loop_depth int
    // Plan 495: 镜像宿主 emit_source_line 的 current_source_line ——
    // 相邻同线 .line 去重状态(0=未发过)
    cur_line int
    // W1(Plan 511):struct 类型注册表(name→声明序字段名;镜像宿主
    // generic_registry 的 field_names/field_index 面);inst_ty=构造字面量
    // 绑定的类型名(str_flag/arr_flag 同款单值回传,let 绑定用)
    tys List<CGType>
    inst_ty str
    // W2(Plan 511):全局变量(镜像宿主 global_vars/global_inits——仅顶层
    // var/const;inits 记 init 表达式的 token 区间,fn main 体首重放用)
    global_vars List<str>
    global_inits List<CGInit>
    // W2:hi_idx=本 fn 槽位高 watermark(prolog locals 用;宿主 pop_scope
    // 释放槽位供姊妹作用域复用,但 fn locals 取分配高水位——两值分离);
    // scope_saves=各层入口 max_idx(弹出恢复)
    hi_idx int
    scope_saves List<int>
    // W3(Plan 511):use 记录(mod 名/逗号 items/通配);mod_name=本编译
    // 单元的模块名(""=主模块——全局键裸名,否则 mod. 前缀);defers=跨模块
    // 调用延迟解析(ins 指针+符号);mod_bases=链接后各 dep 模块起始
    // ins 下标(ev_run_files 初始化序用)
    uses List<CGUse>
    mod_name str
    defers List<CGDefer>
    mod_bases List<int>
    // W3:fn→模块名平行表(链接期符号定址用;单文件路径恒空)
    fn_mods List<str>
}

// W3:use 语句记录(kind:auto|rs|py|c)
type CGUse {
    kind str
    module str
    items str
    wildcard int
}

// W3:跨模块调用延迟解析条目(链接期定址)
type CGDefer {
    ins_idx int
    symbol str
}

// W3:名字是否在 use items(逗号连接串)中
fn cg_items_has(items str, name str) bool {
    var i = 0
    var start = 0
    var n = items.len()
    while i <= n {
        var at_end = i == n
        var is_sep = false
        if !at_end {
            if items.char_at(i) == ',' {
                is_sep = true
            }
        }
        if at_end || is_sep {
            if items.slice(start, i) == name {
                return true
            }
            start = i + 1
        }
        i = i + 1
    }
    return false
}

// W3:裸名 → 导入符号(遍历 uses:定向 items 命中或通配;返回 "mod.name",
// 未命中返回 "")
fn cg_import_symbol(c CG, name str) str {
    var i = 0
    while i < c.uses.len() {
        var u = c.uses.get(i)
        if u.kind == "auto" {
            if u.wildcard == 1 || cg_items_has(u.items, name) {
                return u.module + "." + name
            }
        }
        i = i + 1
    }
    return ""
}

// W3:名字是否为已 use 的模块名(限定调用 db.fn 判定)
fn cg_is_module(c CG, name str) bool {
    var i = 0
    while i < c.uses.len() {
        if c.uses.get(i).module == name {
            return true
        }
        i = i + 1
    }
    return false
}

// W2:全局初始化重放条目(name + init 表达式 token 闭区间)
type CGInit {
    name str
    from int
    to int
}

// W3:全局键限名(模块编译单元内 mod. 前缀;主模块裸名——镜像宿主
// current_module/qualified_global_name)
fn cg_gkey(c CG, name str) str {
    if c.mod_name == "" {
        return name
    }
    return c.mod_name + "." + name
}

// W2:名字是否已入全局集
fn cg_is_global(c CG, name str) bool {
    var i = 0
    while i < c.global_vars.len() {
        if c.global_vars.get(i) == name {
            return true
        }
        i = i + 1
    }
    return false
}

type CGEnum {
    key str
    val int
}

type CGType {
    name str
    fields List<str>
}

// W1:按类型名查注册表下标(-1=未注册)
fn cg_tys_lookup(c CG, name str) int {
    var i = 0
    while i < c.tys.len() {
        if c.tys.get(i).name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

// W1:字段在类型声明序中的下标(-1=无该字段)
fn cg_field_idx(c CG, tyname str, field str) int {
    var ti = cg_tys_lookup(c, tyname)
    if ti < 0 {
        return -1
    }
    var fl = c.tys.get(ti).fields
    var j = 0
    while j < fl.len() {
        if fl.get(j) == field {
            return j
        }
        j = j + 1
    }
    return -1
}

fn cg_const_lookup(c CG, key str) int {
    var i = 0
    while i < c.consts.len() {
        if c.consts.get(i).key == key {
            return c.consts.get(i).val
        }
        i = i + 1
    }
    return -999999
}

fn cg_ctor_lookup(c CG, key str) int {
    var i = 0
    while i < c.ctors.len() {
        if c.ctors.get(i).key == key {
            return c.ctors.get(i).val
        }
        i = i + 1
    }
    return -999999
}

fn cg_new() CG {
    var scs List<List<CGVar>> = List.new()
    var base List<CGVar> = List.new()
    scs.push(base)
    var ins_l List<I> = List.new()
    var pool List<str> = List.new()
    var fns List<FnEntry> = List.new()
    var consts_l List<CGEnum> = List.new()
    var ctors_l List<CGEnum> = List.new()
    var brk_l List<List<int>> = List.new()
    var cont_l List<List<int>> = List.new()
    var ctg_l List<int> = List.new()
    var tys_l List<CGType> = List.new()
    var gv_l List<str> = List.new()
    var gi_l List<CGInit> = List.new()
    var saves_l List<int> = List.new()
    var uses_l List<CGUse> = List.new()
    var defers_l List<CGDefer> = List.new()
    var bases_l List<int> = List.new()
    var fmods_l List<str> = List.new()
    return CG(ins_l, pool, fns, scs, 1, 0, -1, "", 0, 0, consts_l, ctors_l, brk_l, cont_l, ctg_l, 0, 0, tys_l, "", gv_l, gi_l, -1, saves_l, uses_l, "", defers_l, bases_l, fmods_l)
}

// P2:进循环层——帧占位列表 + continue 落点(读改写回填,VM 引用语义
// 与 a2r 值语义两可;镜像 ev_arr_write 写回注释)
fn cg_loop_enter(mut c CG, cont_target int) {
    var bl List<int> = List.new()
    c.brk_js.push(bl)
    var cl List<int> = List.new()
    c.cont_js.push(cl)
    c.cont_tg.push(cont_target)
    c.loop_depth = c.loop_depth + 1
}

// P2:出循环层——continue 占位 → 本层落点;break 占位 → 循环后
fn cg_loop_exit(mut c CG, brk_target int) {
    var d = c.loop_depth - 1
    if d < 0 {
        cg_err(c, "loop exit without enter")
        return
    }
    var cj = c.cont_js.get(d)
    var j = 0
    while j < cj.len() {
        c.ins.get(cj.get(j)).n = c.cont_tg.get(d)
        j = j + 1
    }
    var bj = c.brk_js.get(d)
    var b = 0
    while b < bj.len() {
        c.ins.get(bj.get(b)).n = brk_target
        b = b + 1
    }
    c.loop_depth = d
}

// P2:break/continue 语句发射(占位 Jmp 入本层帧;层外报错)
fn cg_loop_jump(mut c CG, k TokenKind) {
    if c.loop_depth == 0 {
        cg_err(c, "break/continue outside loop")
        return
    }
    var j = emit(c, OpCode.Jmp, "", -1)
    if k == TokenKind.Continue {
        var fr = c.cont_js.get(c.loop_depth - 1)
        fr.push(j)
        c.cont_js.set(c.loop_depth - 1, fr)
    } else {
        var fr2 = c.brk_js.get(c.loop_depth - 1)
        fr2.push(j)
        c.brk_js.set(c.loop_depth - 1, fr2)
    }
}

fn cg_err(mut c CG, msg str) {
    if c.err == "" {
        c.err = "CODEGEN-ERROR:" + msg
    }
}

// 前瞻 token 文本(原始,不跳注释;corpus 括号内无注释)
fn p_peek_text(p P, n int) str {
    var i = p.pos + n
    if i >= p.toks.len() {
        return ""
    }
    return p.toks.get(i).text
}

// 指令字节宽度(与 Rust opcode 编码一致;S4 子集)。new.instance/
// is.variant 的名字内联字节随名长(Plan 447 部分②);get.generic.field
// 的 u32 操作数在 Rust 侧按 1B 操作数+3B 残留(nop)错位展示,照抄
enum OpCode {
    Line
    Add
    Sub
    Mul
    Div
    Mod
    Eq
    Ne
    Lt
    Gt
    Le
    Ge
    And
    Or
    Not
    Neg
    StrCat
    ConstI32
    LoadStr
    LoadLoc0
    LoadLoc1
    LoadLoc2
    LoadLocal
    StoreLoc0
    StoreLoc1
    StoreLocal
    FnProlog
    Reserve
    Ret
    Call
    CallNat
    Jmp
    JmpZ
    JmpNz
    PushBool
    PushNil
    Dup
    Pop
    ArrLen
    CreateArr
    GetElem
    SetElem
    IsVariant
    NewInstance
    ConstructInstance
    GetGenericField
    BuildFstr
    Halt
    Nop
    Blank
    GetField
    SetField
    SetGenericField
    Const0
    LoadGlobal
    StoreGlobal
}

// 助记符文本(M4 dump 序列化的唯一口径;447-③C1:载体 str → OpCode)
fn op_name(op OpCode) str {
    is op {
        OpCode.Line -> ".line"
        OpCode.Add -> "add"
        OpCode.Sub -> "sub"
        OpCode.Mul -> "mul"
        OpCode.Div -> "div"
        OpCode.Mod -> "mod"
        OpCode.Eq -> "eq"
        OpCode.Ne -> "ne"
        OpCode.Lt -> "lt"
        OpCode.Gt -> "gt"
        OpCode.Le -> "le"
        OpCode.Ge -> "ge"
        OpCode.And -> "and"
        OpCode.Or -> "or"
        OpCode.Not -> "not"
        OpCode.Neg -> "neg"
        OpCode.StrCat -> "str.cat"
        OpCode.ConstI32 -> "const.i32"
        OpCode.LoadStr -> "load.str"
        OpCode.LoadLoc0 -> "load.loc.0"
        OpCode.LoadLoc1 -> "load.loc.1"
        OpCode.LoadLoc2 -> "load.loc.2"
        OpCode.LoadLocal -> "load.local"
        OpCode.StoreLoc0 -> "store.loc.0"
        OpCode.StoreLoc1 -> "store.loc.1"
        OpCode.StoreLocal -> "store.local"
        OpCode.FnProlog -> "fn.prolog"
        OpCode.Reserve -> "reserve"
        OpCode.Ret -> "ret"
        OpCode.Call -> "call"
        OpCode.CallNat -> "call.nat"
        OpCode.Jmp -> "jmp"
        OpCode.JmpZ -> "jmp.z"
        OpCode.JmpNz -> "jmp.nz"
        OpCode.PushBool -> "push.bool"
        OpCode.PushNil -> "push.nil"
        OpCode.Dup -> "dup"
        OpCode.Pop -> "pop"
        OpCode.ArrLen -> "arr.len"
        OpCode.CreateArr -> "create.arr"
        OpCode.GetElem -> "get.elem"
        OpCode.SetElem -> "set.elem"
        OpCode.IsVariant -> "is.variant"
        OpCode.NewInstance -> "new.instance"
        OpCode.ConstructInstance -> "construct.instance"
        OpCode.GetGenericField -> "get.generic.field"
        OpCode.BuildFstr -> "build.fstr"
        OpCode.Halt -> "halt"
        OpCode.Nop -> "nop"
        OpCode.GetField -> "get.field"
        OpCode.SetField -> "set.field"
        OpCode.SetGenericField -> "set.generic.field"
        OpCode.Const0 -> "const.0"
        OpCode.LoadGlobal -> "load.global"
        OpCode.StoreGlobal -> "store.global"
        else -> ""
    }
}

fn i_size(op OpCode) int {
    is op {
        OpCode.FnProlog -> 3
        OpCode.Reserve -> 2
        OpCode.Jmp | OpCode.JmpZ | OpCode.JmpNz -> 3
        OpCode.Line -> 3
        OpCode.LoadStr -> 5
        OpCode.Call -> 5
        OpCode.CallNat -> 3
        OpCode.ConstI32 -> 5
        OpCode.PushBool -> 2
        OpCode.Ret -> 2
        OpCode.LoadLocal | OpCode.StoreLocal -> 2
        OpCode.CreateArr -> 2
        OpCode.GetGenericField -> 2
        // W1:get.field 真宽 u32(5);set.generic.field 同 get.generic.field
        // 的 u8 读宽形态(2+幽灵 nop);set.field 无操作数(1)
        OpCode.GetField -> 5
        OpCode.SetField -> 1
        OpCode.SetGenericField -> 2
        OpCode.Const0 -> 1
        OpCode.LoadGlobal -> 5
        OpCode.StoreGlobal -> 5
        else -> 1
    }
}

// 名字内联指令的字节宽(new.instance=1+名长;is.variant=3+名长:
// 操作码+u16 名长+名字节,镜像宿主 emit_u16 + bytes)
fn i_size_named(op OpCode, s str, n int) int {
    var name = s
    // s 形如 "\"Val.VI\"" —— 剥引号
    if name.len() >= 2 && name.char_at(0) == '"' {
        name = name.slice(1, name.len() - 1)
    }
    if op == OpCode.NewInstance {
        return 1 + name.len()
    }
    if op == OpCode.IsVariant {
        return 3 + name.len()
    }
    // build.fstr:操作码+u8 段数+每段 u8 tag(镜像宿主 BUILD_FSTR)
    if op == OpCode.BuildFstr {
        return 2 + n
    }
    return i_size(op)
}

// 发射一条指令,返回其指令索引
fn emit(mut c CG, op OpCode, s str, n int) int {
    c.ins.push(I(op, s, n))
    return c.ins.len() - 1
}

// Plan 495: 镜像宿主 emit_source_line —— line>0 且异于当前已发行才发
// SOURCE_LINE(相邻同线去重,与宿主 current_source_line 同款状态机)
fn cg_line(mut c CG, ln int) {
    if ln > 0 && ln != c.cur_line {
        c.cur_line = ln
        emit(c, OpCode.Line, ln.str(), 0)
    }
}

// ── 作用域(depth 计数;深度≥3 弹出时发槽释放组) ───────────────

fn cg_push_scope(mut c CG) {
    // W2:记录本层入口 max_idx(弹出恢复——宿主 pop_scope 释放槽位,
    // 姊妹作用域复用槽号;b38 三循环实证)
    if c.scope_saves.len() < c.depth + 1 {
        c.scope_saves.push(c.max_idx)
    } else {
        c.scope_saves.set(c.depth, c.max_idx)
    }
    // Plan 447 部分②修复:多 fn 复用槽位时必须换新空表——旧实现无条件
    // push,第二個 fn 按深度取到前一 fn 的残留作用域(其体内变量泄漏进
    // 后续 fn 的释放组/查找域;is 的 _is_target 首次暴露)。表长仍只增
    // 不减(D25 写法保持)
    if c.depth == c.scopes.len() {
        var sc List<CGVar> = List.new()
        c.scopes.push(sc)
    } else {
        var fresh List<CGVar> = List.new()
        c.scopes.set(c.depth, fresh)
    }
    c.depth = c.depth + 1
}

// 弹出作用域:depth>2 时对栈顶域的槽按升序发 push.nil+store
fn cg_pop_scope(mut c CG) {
    if c.depth > 1 {
        if c.depth > 2 {
            var sc = c.scopes.get(c.depth - 1)
            var slots = cg_sort_ints_of_vars(sc)
            var m = 0
            while m < slots.len() {
                emit(c, OpCode.PushNil, "", 0)
                cg_emit_store(c, slots.get(m))
                m = m + 1
            }
        }
        c.depth = c.depth - 1
        // W2:恢复槽位分配游标(本层槽号可复用;hi_idx 高水位不受影响)
        if c.scope_saves.len() >= c.depth + 1 {
            c.max_idx = c.scope_saves.get(c.depth)
        }
    }
}

// W2:静默弹出(无释放组)——Call 迭代器协议通道专用:宿主 2747-2829
// 的 _iterator/循环变量不入释放组(实测 b38:循环尾无 push.nil+store)
fn cg_pop_scope_silent(mut c CG) {
    if c.depth > 1 {
        c.depth = c.depth - 1
        if c.scope_saves.len() >= c.depth + 1 {
            c.max_idx = c.scope_saves.get(c.depth)
        }
    }
}

// 域内变量 idx 升序收集
fn cg_sort_ints_of_vars(sc List<CGVar>) List<int> {
    var out List<int> = List.new()
    var k = 0
    while k < sc.len() {
        out.push(sc.get(k).idx)
        k = k + 1
    }
    var a = 0
    while a < out.len() {
        var b = a + 1
        while b < out.len() {
            if out.get(b) < out.get(a) {
                var t = out.get(a)
                out.set(a, out.get(b))
                out.set(b, t)
            }
            b = b + 1
        }
        a = a + 1
    }
    return out
}

fn cg_add_var(mut c CG, name str, arr int, ty str) int {
    var next = c.max_idx + 1
    c.max_idx = next
    if next > c.hi_idx {
        c.hi_idx = next
    }
    // 提升+写回(VM 引用语义同写回;a2r 值语义写回修改副本)
    var sc = c.scopes.get(c.depth - 1)
    // Plan 447 部分②:同名重登记按名覆盖(镜像宿主 add_var 的 HashMap
    // 按名 insert——旧槽从表中消失:不再释放也不被查找;多次 is 的
    // _is_target 首次暴露该差异)。max_idx 单调计数 = 宿主高水位
    var replaced = false
    var ri = 0
    while ri < sc.len() {
        if sc.get(ri).name == name {
            sc.set(ri, CGVar(name, next, arr, ty))
            replaced = true
        }
        ri = ri + 1
    }
    if !replaced {
        sc.push(CGVar(name, next, arr, ty))
    }
    c.scopes.set(c.depth - 1, sc)
    return next
}

// 按 idx 反查变量的数组性(.len() 接收者判定)
fn cg_var_arr(mut c CG, idx int) int {
    var s = c.depth - 1
    while s >= 0 {
        var sc = c.scopes.get(s)
        var i = sc.len() - 1
        while i >= 0 {
            if sc.get(i).idx == idx {
                return sc.get(i).arr
            }
            i = i - 1
        }
        s = s - 1
    }
    return 0
}

// 按名查变量类型(11.2a:build.fstr 段 tag;""=int/未知,宿主默认同)
fn cg_var_ty(mut c CG, name str) str {
    var s = c.depth - 1
    while s >= 0 {
        var sc = c.scopes.get(s)
        var i = sc.len() - 1
        while i >= 0 {
            if sc.get(i).name == name {
                return sc.get(i).ty
            }
            i = i - 1
        }
        s = s - 1
    }
    return ""
}

fn cg_lookup(mut c CG, name str) int {
    var s = c.depth - 1
    while s >= 0 {
        var sc = c.scopes.get(s)
        var i = sc.len() - 1
        while i >= 0 {
            if sc.get(i).name == name {
                return sc.get(i).idx
            }
            i = i - 1
        }
        s = s - 1
    }
    return -1
}

// ── 寻址发射(param:0x80+rel;局部 rel 0/1 → loc.0/loc.1,否则 local N) ──

fn cg_emit_store(mut c CG, idx int) {
    if idx < c.n_args {
        var sv = (128 + idx).str()
        emit(c, OpCode.StoreLocal, sv, 128 + idx)
        return
    }
    var rel = idx - c.n_args
    if rel == 0 {
        emit(c, OpCode.StoreLoc0, "0", 0)
    } else if rel == 1 {
        emit(c, OpCode.StoreLoc1, "1", 1)
    } else {
        var sv2 = rel.str()
        emit(c, OpCode.StoreLocal, sv2, rel)
    }
}

fn cg_emit_load(mut c CG, idx int) {
    if idx < c.n_args {
        var lv = (128 + idx).str()
        emit(c, OpCode.LoadLocal, lv, 128 + idx)
        return
    }
    var rel = idx - c.n_args
    if rel == 0 {
        emit(c, OpCode.LoadLoc0, "0", 0)
    } else if rel == 1 {
        emit(c, OpCode.LoadLoc1, "1", 1)
    } else if rel == 2 {
        emit(c, OpCode.LoadLoc2, "2", 2)
    } else {
        var lv2 = rel.str()
        emit(c, OpCode.LoadLocal, lv2, rel)
    }
}

// ── 字符串池(内容寻址去重) ────────────────────────────────────

fn cg_pool_add(mut c CG, s str) int {
    var i = 0
    while i < c.pool.len() {
        if c.pool.get(i) == s {
            return i
        }
        i = i + 1
    }
    c.pool.push(s)
    return c.pool.len() - 1
}

// W1:名字池非去重追加(get.field 操作数专用——镜像宿主 5842-5848 的
// 直接 strings.push,不去重;load.str/set.field 路径仍走 cg_pool_add)
fn cg_pool_push(mut c CG, s str) int {
    c.pool.push(s)
    return c.pool.len() - 1
}

// ── 表达式发射 ────────────────────────────────────────────────

fn cg_binop_mnem(k Op) OpCode {
    if k == Op.Add || k == Op.AddEq {
        return OpCode.Add
    }
    if k == Op.Sub || k == Op.SubEq {
        return OpCode.Sub
    }
    if k == Op.Mul || k == Op.MulEq {
        return OpCode.Mul
    }
    if k == Op.Div || k == Op.DivEq {
        return OpCode.Div
    }
    if k == Op.Mod || k == Op.ModEq {
        return OpCode.Mod
    }
    if k == Op.Eq {
        return OpCode.Eq
    }
    if k == Op.Neq {
        return OpCode.Ne
    }
    if k == Op.Lt {
        return OpCode.Lt
    }
    if k == Op.Gt {
        return OpCode.Gt
    }
    if k == Op.Le {
        return OpCode.Le
    }
    if k == Op.Ge {
        return OpCode.Ge
    }
    if k == Op.And {
        return OpCode.And
    }
    if k == Op.Or {
        return OpCode.Or
    }
    return OpCode.Blank
}

fn cg_is_assign_op(k Op) bool {
    is k {
        Op.Asn | Op.AddEq | Op.SubEq | Op.MulEq | Op.DivEq | Op.ModEq -> true
        else -> false
    }
}

// 值表达式发射(优先级爬升;复用 parser.at 的 infix_l/infix_r/is_op_kind)
// f-string 发射(447-③ 11.2a;镜像宿主 codegen.rs 4990 BUILD_FSTR):
// 逐段先发射(字面段 load.str;$Ident 变量加载;${expr} 子 tokenize +
// cg_expr 直走),再发 build.fstr(count + tags;tag:1=str 0=int,
// 镜像宿主 expr_type_hint——Ident 查变量表,非 str 即 int/未知 0)
fn cg_fstr(mut c CG, mut p P) {
    p_next(p)
    var content = p_text(p)
    p_next(p)
    p_next(p)
    var tags = ""
    var n_parts = 0
    var lit = ""
    var i = 0
    var n = content.len()
    while i < n {
        var ch = content.char_at(i)
        if ch == 36 {
            if lit != "" {
                var pi = cg_pool_add(c, lit)
                emit(c, OpCode.LoadStr, "", pi)
                tags = f"${tags}1"
                n_parts = n_parts + 1
                lit = ""
            }
            if i + 1 < n && content.char_at(i + 1) == 123 {
                var depth = 1
                var j = i + 2
                while j < n && depth > 0 {
                    var cj = content.char_at(j)
                    if cj == 123 {
                        depth = depth + 1
                    } else if cj == 125 {
                        depth = depth - 1
                    }
                    j = j + 1
                }
                if depth != 0 {
                    cg_err(c, "fstr: unterminated interpolation ")
                    return
                }
                var inner = content.slice(i + 2, j - 1)
                var subtoks = tokenize(inner)
                var subp = parse_new(subtoks)
                cg_expr(c, subp, 0)
                if c.err != "" || subp.err != "" {
                    return
                }
                var tg = 0
                if subp.pos < subtoks.len() {
                    var ftk = subtoks.get(0)
                    if ftk.kind == TokenKind.Ident && cg_var_ty(c, ftk.text) == "str" {
                        tg = 1
                    }
                }
                tags = tags + tg.str()
                n_parts = n_parts + 1
                i = j
            } else {
                var j2 = i + 1
                var stop = false
                while j2 < n && !stop {
                    var cj2 = content.char_at(j2)
                    var ok2 = (cj2 >= 97 && cj2 <= 122) || (cj2 >= 65 && cj2 <= 90) || (cj2 >= 48 && cj2 <= 57) || cj2 == 95
                    if !ok2 {
                        stop = true
                    } else {
                        j2 = j2 + 1
                    }
                }
                var nm = content.slice(i + 1, j2)
                var vi = cg_lookup(c, nm)
                if vi < 0 {
                    cg_err(c, "fstr: unknown ident $" + nm)
                    return
                }
                cg_emit_load(c, vi)
                var tg2 = 0
                if cg_var_ty(c, nm) == "str" {
                    tg2 = 1
                }
                tags = tags + tg2.str()
                n_parts = n_parts + 1
                i = j2
            }
        } else {
            lit = lit + content.slice(i, i + 1)
            i = i + 1
        }
    }
    if lit != "" {
        var pi2 = cg_pool_add(c, lit)
        emit(c, OpCode.LoadStr, "", pi2)
        tags = f"${tags}1"
        n_parts = n_parts + 1
    }
    // tags 文本对齐宿主 disasm:parts=N, tags=[0, 1]
    var txt = f"parts=${n_parts.str()}, tags=["
    var t3 = 0
    while t3 < n_parts {
        if t3 > 0 {
            txt = f"${txt}, "
        }
        txt = txt + tags.slice(t3, t3 + 1)
        t3 = t3 + 1
    }
    txt = f"${txt}]"
    emit(c, OpCode.BuildFstr, txt, n_parts)
    c.str_flag = 1
    c.arr_flag = 0
}

fn cg_expr(mut c CG, mut p P, min int) {
    if c.err != "" {
        return
    }
    var k = p_kind(p)
    // 每次表达式求值从干净 flag 起;原子按需置位(str/arr/inst_ty)
    c.str_flag = 0
    c.arr_flag = 0
    c.inst_ty = ""
    if k == TokenKind.Not {
        p_next(p)
        cg_expr(c, p, 28)
        emit(c, OpCode.Not, "", 0)
        c.str_flag = 0
        c.arr_flag = 0
    } else if k == TokenKind.Sub || k == TokenKind.Add {
        // 一元符号:operand 后发 neg(镜像 Rust 6414;一元 + 为 no-op)
        p_next(p)
        cg_expr(c, p, 28)
        if k == TokenKind.Sub {
            emit(c, OpCode.Neg, "", 0)
        }
        c.str_flag = 0
        c.arr_flag = 0
    } else if k == TokenKind.FStrStart {
        cg_fstr(c, p)
    } else if k == TokenKind.Int {
        var t = p_text(p)
        p_next(p)
        var cv = int_val(t).str()
        emit(c, OpCode.ConstI32, cv, int_val(t))
    } else if k == TokenKind.Str {
        var s = p_text(p)
        p_next(p)
        var idx = cg_pool_add(c, s)
        emit(c, OpCode.LoadStr, "", idx)
        c.str_flag = 1
    } else if k == TokenKind.True {
        p_next(p)
        emit(c, OpCode.PushBool, "true", 0)
    } else if k == TokenKind.False {
        p_next(p)
        emit(c, OpCode.PushBool, "false", 0)
    } else if k == TokenKind.Char {
        // Plan 447 部分②:字符字面量 → const.i32 码点(镜像宿主 Char 编译)
        var t = p_text(p)
        p_next(p)
        var cp = t.char_at(0)
        emit(c, OpCode.ConstI32, cp.str(), cp)
    } else if k == TokenKind.Ident {
        var name = p_text(p)
        // Plan 447 部分②:枚举路径前瞻判定(不消费)——注册命中才拦截,
        // 否则落回原标识符路径(方法调用 a.len() 等不受影响)。
        // Enum.Variant → const.i32 判别值;Enum.Variant(args) → 载荷
        // 构造(值…, const 名长, new.instance, const 字段数,
        // construct.instance —— 镜像宿主 generic_registry 路径 5128-5147)
        var is_enum_path = false
        var variant = ""
        if p_peek(p, 1) == TokenKind.Dot {
            var seg = p_peek_text(p, 2)
            var dk = f"${name}.${seg}"
            if cg_const_lookup(c, dk) != -999999 || cg_ctor_lookup(c, dk) >= 0 {
                is_enum_path = true
                variant = seg
            }
        }
        if is_enum_path {
            p_next(p)
            p_next(p)
            p_next(p)
            var key = f"${name}.${variant}"
            if p_kind(p) == TokenKind.LParen {
                var fc = cg_ctor_lookup(c, key)
                if fc < 0 {
                    cg_err(c, "unknown enum ctor: " + key)
                    return
                }
                cg_call_args(c, p)
                var nm = key.len()
                emit(c, OpCode.ConstI32, nm.str(), nm)
                emit(c, OpCode.NewInstance, "\"" + key + "\"", 0)
                emit(c, OpCode.ConstI32, fc.str(), fc)
                emit(c, OpCode.ConstructInstance, "", 0)
            } else {
                var dv = cg_const_lookup(c, key)
                emit(c, OpCode.ConstI32, dv.str(), dv)
            }
        } else {
        p_next(p)
        // W1 构造字面量:已注册类型紧随 { → NEW_INSTANCE 族发射;
        // inst_ty 回传类型名(let 绑定记 var_types 用)
        if p_kind(p) == TokenKind.LBrace && cg_tys_lookup(c, name) >= 0 {
            cg_ctor_emit(c, p, name)
            c.inst_ty = name
            return
        }
        // W3:模块限定调用 db.fn(...)(db 为已 use 模块名;镜像宿主
        // auto_modules + mod.fn reloc 符号——链接期定址;调用后可接
        // 后缀/中缀,故 call_done 包裹而非 return)
        var call_done = false
        // 注:括号化 || 不入 && 链(a2r 转译不保括号优先级——提中间变量)
        var qk_name = p_peek(p, 1) == TokenKind.Ident || is_soft_ident_kind(p_peek(p, 1))
        if p_kind(p) == TokenKind.Dot && qk_name && p_peek(p, 2) == TokenKind.LParen && cg_is_module(c, name) {
            p_next(p)
            var qfn = p_text(p)
            p_next(p)
            // 接收者占位:宿主 Ident 模块兜底推 const.i32 0(Plan 437
            // 注记的已知占位泄漏——镜像;帧 bp 锚定下无害)
            emit(c, OpCode.ConstI32, "0", 0)
            cg_call_args(c, p)
            var qdi = emit(c, OpCode.Call, "", -1)
            c.defers.push(CGDefer(qdi, name + "." + qfn))
            call_done = true
        }
        if !call_done && name == "print" && p_kind(p) == TokenKind.LParen {
            cg_call_args(c, p)
            emit(c, OpCode.CallNat, "nat#10", 10)
        } else if !call_done && p_kind(p) == TokenKind.LParen {
            var fe = -1
            var fi = 0
            while fi < c.fns.len() {
                if c.fns.get(fi).name == name {
                    fe = fi
                }
                fi = fi + 1
            }
            if fe < 0 {
                // W3:导入名(use mod: item / 通配)→ 延迟调用,链接期定址
                // (无 return:调用结果可接后缀/中缀,如 get_base() * 2)
                var isym = cg_import_symbol(c, name)
                if isym != "" {
                    cg_call_args(c, p)
                    var idi = emit(c, OpCode.Call, "", -1)
                    c.defers.push(CGDefer(idi, isym))
                } else {
                    cg_err(c, "unknown fn: " + name)
                    return
                }
            } else {
                cg_call_args(c, p)
                emit(c, OpCode.Call, "", fe)
            }
        } else if !call_done {
            var idx = cg_lookup(c, name)
            if idx < 0 {
                // W2:全局读(镜像宿主读链 局部>全局 优先序;W3 模块限名)
                if cg_is_global(c, cg_gkey(c, name)) {
                    var gkr = cg_gkey(c, name)
                    var gidx = cg_pool_add(c, gkr)
                    emit(c, OpCode.LoadGlobal, gidx.str(), gidx)
                    c.arr_flag = 0
                } else {
                    cg_err(c, "unknown ident: " + name)
                    return
                }
            } else {
                cg_emit_load(c, idx)
                c.arr_flag = cg_var_arr(c, idx)
                // W2:str 型变量加载置 str_flag(镜像宿主 var_types 的
                // String 性——s[i]+s[j] 发 str.cat;b39 实证)
                if cg_var_ty(c, name) == "str" {
                    c.str_flag = 1
                }
            }
        }
        }
    } else if k == TokenKind.LParen {
        // W2:括号 group 透明(镜像宿主 group();-(x+y) 形态经此)
        p_next(p)
        cg_expr(c, p, 0)
        p_expect(p, TokenKind.RParen)
    } else if k == TokenKind.LSquare {
        // 数组字面量:elems 依次入栈,create.arr count=N(Rust 4865)
        p_next(p)
        skip_empty_lines(p)
        var n = 0
        if p_kind(p) != TokenKind.RSquare {
            cg_expr(c, p, 0)
            n = 1
            while p_kind(p) == TokenKind.Comma || p_kind(p) == TokenKind.Newline {
                p_next(p)
                skip_empty_lines(p)
                cg_expr(c, p, 0)
                n = n + 1
            }
        }
        p_expect(p, TokenKind.RSquare)
        emit(c, OpCode.CreateArr, "count=" + n.str(), n)
        c.arr_flag = 1
    } else {
        cg_err(c, "unsupported expr atom: " + kind_name(k))
        return
    }
    // 后缀链:下标读(get.elem);.len()(仅数组接收者,镜像 Rust 7177 闸)
    // W2:str_flag 保留——宿主字符串性穿透下标(b39:s[i]+s[j] 发 str.cat)
    while c.err == "" && p_kind(p) == TokenKind.LSquare {
        p_next(p)
        skip_empty_lines(p)
        // W2:str_flag 穿透下标——下标子表达式的 cg_expr 头部会清位,
        // 此处保存/恢复(宿主字符串性穿透;b39:s[i]+s[j] 发 str.cat)
        var save_str = c.str_flag
        cg_expr(c, p, 0)
        c.str_flag = save_str
        skip_empty_lines(p)
        p_expect(p, TokenKind.RSquare)
        emit(c, OpCode.GetElem, "", 0)
        c.arr_flag = 0
    }
    if c.err == "" && p_kind(p) == TokenKind.Dot && p_peek_text(p, 1) == "len" && p_peek(p, 2) == TokenKind.LParen && p_peek(p, 3) == TokenKind.RParen {
        if c.arr_flag != 1 {
            cg_err(c, ".len() receiver is not an array")
            return
        }
        p_next(p)
        p_next(p)
        p_next(p)
        p_next(p)
        emit(c, OpCode.ArrLen, "", 0)
        c.str_flag = 0
        c.arr_flag = 0
    }
    // W1:点访问链深(0=原子直连首跳 → get.field;>0 链式后续跳 →
    // get.generic.field field=0 幽灵 nop 形态)
    var dot_seq = 0
    while c.err == "" {
        var opk = p_kind(p)
        // P2:循环顶 token 分派 is 化(11 种界符臂内 break;镜像 Rust
        // parser.rs:2425 的 match kind)
        is opk {
            TokenKind.EOF | TokenKind.Newline | TokenKind.Semi | TokenKind.LBrace | TokenKind.RBrace | TokenKind.Comma | TokenKind.Arrow | TokenKind.DoubleArrow | TokenKind.VBar | TokenKind.RSquare | TokenKind.RParen -> {
                break
            }
            else -> {
                if opk == TokenKind.Dot && t_is_type_prop(p) {
                    break
                }
                // W1 字段读:Dot+名(非 .type/非方法调用)→ 接收者已在
                // 栈,get.field field[N](名字池非去重追加——镜像宿主
                // 5842-5848 直接 push;读路径不分 var_types 形态,
                // 宿主非泛型与 fallback 同一发射);字段访问消费完直接
                // 回循环顶,不走通用中缀
                var dot_done = false
                if opk == TokenKind.Dot {
                    var fk2 = p_peek(p, 1)
                    if fk2 == TokenKind.Ident || is_soft_ident_kind(fk2) {
                        if p_peek(p, 2) == TokenKind.LParen {
                            cg_err(c, "unsupported method call: ." + p_peek_text(p, 1))
                            break
                        }
                        var fname2 = p_peek_text(p, 1)
                        p_next(p)
                        p_next(p)
                        if dot_seq == 0 {
                            // 首跳(原子直连,宿主 Ident 接收者 var_types 命中/
                            // User 型):get.field field[N](名字池非去重追加)
                            var fidx4 = cg_pool_push(c, fname2)
                            emit(c, OpCode.GetField, "field[" + fidx4.str() + "]", fidx4)
                        } else {
                            // 链式后续跳(接收者已是表达式,宿主 untyped
                            // fallback):get.generic.field field=0 + 3 幽灵 nop
                            emit(c, OpCode.GetGenericField, "field=0", 0)
                            emit(c, OpCode.Nop, "", 0)
                            emit(c, OpCode.Nop, "", 0)
                            emit(c, OpCode.Nop, "", 0)
                        }
                        dot_seq = dot_seq + 1
                        c.str_flag = 0
                        c.arr_flag = 0
                        c.inst_ty = ""
                        dot_done = true
                    } else {
                        cg_err(c, "unsupported dot access: ." + p_peek_text(p, 1))
                        break
                    }
                }
                if !dot_done {
                if !is_op_kind(opk) {
                    cg_err(c, "expected infix op, got " + kind_name(opk))
                    break
                }
                var l = infix_l(p_op(opk))
                if l == 0 || l < min {
                    break
                }
                if cg_is_assign_op(p_op(opk)) {
                    cg_err(c, "nested assignment unsupported")
                    break
                }
                p_next(p)
                if opk == TokenKind.Or || opk == TokenKind.And {
                    skip_empty_lines(p)
                }
                var lhs_str = c.str_flag
                c.str_flag = 0
                cg_expr(c, p, infix_r(p_op(opk)))
                var rhs_str = c.str_flag
                var mn = cg_binop_mnem(p_op(opk))
                var str_either = lhs_str == 1 || rhs_str == 1
                if opk == TokenKind.Add && str_either {
                    mn = OpCode.StrCat
                    c.str_flag = 1
                } else {
                    c.str_flag = 0
                }
                c.arr_flag = 0
                if mn != OpCode.Blank {
                    emit(c, mn, "", 0)
                }
                }
            }
        }
    }
}

// 调用实参:( 已在 cur;消费至 RParen
fn cg_call_args(mut c CG, mut p P) {
    p_next(p)
    skip_empty_lines(p)
    if p_kind(p) != TokenKind.RParen {
        cg_expr(c, p, 0)
        while p_kind(p) == TokenKind.Comma || p_kind(p) == TokenKind.Newline {
            p_next(p)
            skip_empty_lines(p)
            cg_expr(c, p, 0)
        }
    }
    p_expect(p, TokenKind.RParen)
}

// ── 语句发射(.line 由语句步行者发,见 cg_stmts) ────────────────

// ── 枚举声明注册(Plan 447 部分② Phase 6:镜像宿主 Stmt::EnumDecl 的
// enum_values + generic_registry 注册,零字节码)────────────────

fn cg_enum_decl(mut c CG, mut p P) {
    p_next(p)
    if !is_name_kind(p_kind(p)) {
        cg_err(c, "expected enum name")
        return
    }
    var name = p_text(p)
    p_next(p)
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    var next_val = 0
    var idx = 0
    while c.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RBrace {
        if !is_name_kind(p_kind(p)) {
            cg_err(c, "expected variant name")
            return
        }
        var vname = p_text(p)
        p_next(p)
        var key = f"${name}.${vname}"
        var nfields = 0
        var has_payload = false
        if p_kind(p) == TokenKind.LParen {
            p_next(p)
            skip_empty_lines(p)
            has_payload = true
            if p_kind(p) != TokenKind.RParen {
                var more = true
                while more {
                    parse_type(p)
                    nfields = nfields + 1
                    if p_kind(p) == TokenKind.Comma {
                        p_next(p)
                        skip_empty_lines(p)
                    } else {
                        more = false
                    }
                }
            }
            p_expect(p, TokenKind.RParen)
        } else if p_kind(p) == TokenKind.LBrace {
            p_next(p)
            skip_empty_lines(p)
            has_payload = true
            while c.err == "" && p_kind(p) != TokenKind.RBrace && p_kind(p) != TokenKind.EOF {
                if !is_name_kind(p_kind(p)) {
                    cg_err(c, "expected variant field name")
                    return
                }
                p_next(p)
                if p_kind(p) == TokenKind.Colon {
                    p_next(p)
                }
                parse_type(p)
                nfields = nfields + 1
                if p_kind(p) == TokenKind.Comma {
                    p_next(p)
                    skip_empty_lines(p)
                }
                skip_empty_lines(p)
            }
            p_expect(p, TokenKind.RBrace)
        }
        // 判别值:scalar 链(auto/显式 = N)或载荷变体按位序(镜像宿主
        // scalar_value.unwrap_or(i);载荷不入 Display 值链)
        var val = next_val
        if has_payload {
            val = idx
        }
        if p_kind(p) == TokenKind.Asn {
            p_next(p)
            if p_kind(p) != TokenKind.Int {
                cg_err(c, "unsupported enum value")
                return
            }
            val = int_val(p_text(p))
            p_next(p)
            next_val = val + 1
        } else if !has_payload {
            next_val = val + 1
        }
        c.consts.push(CGEnum(key, val))
        if has_payload {
            c.ctors.push(CGEnum(key, nfields))
        }
        idx = idx + 1
        // 变体间空行:静默跳过
        while p_kind(p) == TokenKind.Semi || p_kind(p) == TokenKind.Newline || p_kind(p) == TokenKind.Comma {
            p_next(p)
        }
        skip_empty_lines(p)
    }
    p_expect(p, TokenKind.RBrace)
}

// ── is 语句发射(Plan 447 部分② Phase 6:镜像宿主 Stmt::Is 3417-3800)──

// 臂体:{...} 块(compile_body_inline,不推作用域);return 单语句;
// 其余单表达式(无 pop,镜像 Stmt::Expr 语句)
fn cg_is_arm_body(mut c CG, mut p P) {
    if p_kind(p) == TokenKind.LBrace {
        cg_body_inline(c, p)
        return
    }
    // Plan 495: 非块体 arm 体镜像宿主 parse_expr_or_body 的 stmt_line——
    // arm 体首 token 行经 cg_line 发射(块体由 cg_stmts 按体内语句发)
    cg_line(c, p_line(p))
    if p_kind(p) == TokenKind.Return {
        cg_stmt(c, p)
        return
    }
    if p_kind(p) == TokenKind.Break || p_kind(p) == TokenKind.Continue {
        cg_stmt(c, p)
        return
    }
    cg_expr(c, p, 0)
}

// 单模式比较发射:load t;<pattern 表达式>;eq —— 标量枚举判别值直接
// const.i32,字面量按各自形态
// W3(Plan 511)use 语句消费+记录(词法形态镜像 parser.at parse_use;
// use.rs/py 的域外报错归模块解析器 cg_resolve——此处仅消费)
fn cg_use(mut c CG, mut p P) {
    p_next(p)
    if p_kind(p) == TokenKind.Dot {
        var lang = p_peek_text(p, 1)
        p_next(p)
        p_next(p)
        var path = p_text(p)
        p_next(p)
        while p_kind(p) == TokenKind.Colon && p_peek(p, 1) == TokenKind.Colon {
            p_next(p)
            p_next(p)
            path = path + "." + p_text(p)
            p_next(p)
        }
        var kind = "rs"
        if lang == "py" {
            kind = "py"
        } else if lang == "c" {
            kind = "c"
        }
        c.uses.push(CGUse(kind, path, "", 0))
        return
    }
    if !is_name_kind(p_kind(p)) {
        cg_err(c, "expected module name after use")
        return
    }
    var name = p_text(p)
    p_next(p)
    while p_kind(p) == TokenKind.Dot {
        p_next(p)
        if !is_name_kind(p_kind(p)) {
            cg_err(c, "expected path segment after dot")
            return
        }
        name = name + "." + p_text(p)
        p_next(p)
    }
    var items = ""
    var wildcard = 0
    if p_kind(p) == TokenKind.Colon {
        p_next(p)
        if p_kind(p) == TokenKind.Star {
            p_next(p)
            wildcard = 1
        } else {
            if !is_name_kind(p_kind(p)) {
                cg_err(c, "expected identifier or *")
                return
            }
            items = p_text(p)
            p_next(p)
            while p_kind(p) == TokenKind.Comma {
                p_next(p)
                if !is_name_kind(p_kind(p)) {
                    cg_err(c, "expected identifier")
                    return
                }
                items = items + "," + p_text(p)
                p_next(p)
            }
        }
    }
    c.uses.push(CGUse("auto", name, items, wildcard))
}

// ── W1 struct 声明注册(Plan 511:镜像宿主 Stmt::TypeDecl 的
// register_type——零字节码,字段名表入 c.tys)─────────────────

fn cg_type_decl(mut c CG, mut p P) {
    p_next(p)
    if !is_name_kind(p_kind(p)) {
        cg_err(c, "expected type name")
        return
    }
    var name = p_text(p)
    p_next(p)
    // 裁剪面同 parser.at parse_type_decl(v2 unsupported 族)
    if p_kind(p) == TokenKind.Lt {
        cg_err(c, "v2 unsupported: type generic params")
        return
    }
    if p_kind(p) == TokenKind.Asn {
        cg_err(c, "v2 unsupported: type alias")
        return
    }
    if p_kind(p) == TokenKind.Is {
        cg_err(c, "v2 unsupported: type inheritance")
        return
    }
    if p_kind(p) == TokenKind.As {
        cg_err(c, "v2 unsupported: type as")
        return
    }
    if p_kind(p) == TokenKind.Has {
        cg_err(c, "v2 unsupported: type has")
        return
    }
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    var fields List<str> = List.new()
    while c.err == "" && p.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RBrace {
        if p_kind(p) == TokenKind.Fn || p_kind(p) == TokenKind.Static {
            cg_err(c, "v2 unsupported: method in type")
            return
        }
        if p_kind(p) == TokenKind.Hash {
            cg_err(c, "v2 unsupported: member attr")
            return
        }
        if !is_name_kind(p_kind(p)) {
            cg_err(c, "expected member name")
            return
        }
        var fname = p_text(p)
        p_next(p)
        if p_kind(p) == TokenKind.Colon {
            p_next(p)
        }
        parse_type(p)
        if p_kind(p) == TokenKind.Asn {
            cg_err(c, "v2 unsupported: member default value")
            return
        }
        fields.push(fname)
        // 成员间空行:静默跳过
        expect_eos(p)
        skip_empty_lines(p)
    }
    p_expect(p, TokenKind.RBrace)
    c.tys.push(CGType(name, fields))
}

// W1 构造字面量发射 X { a: e1, b: e2 }:( 已在 cur 由调用方判别;
// 镜像宿主 NEW_INSTANCE 族 5270-5319:字段值按字面量序 → const.i32
// 名长 → new.instance → const.i32 字段数 → construct.instance)
fn cg_ctor_emit(mut c CG, mut p P, name str) {
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    var n = 0
    while c.err == "" && p.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RBrace {
        var k = p_kind(p)
        if k != TokenKind.Ident && !is_soft_ident_kind(k) {
            cg_err(c, "expected field name in struct ctor")
            return
        }
        p_next(p)
        p_expect(p, TokenKind.Colon)
        cg_expr(c, p, 0)
        n = n + 1
        var sk = p_kind(p)
        if sk == TokenKind.Comma || sk == TokenKind.Newline {
            p_next(p)
            skip_empty_lines(p)
        } else if sk != TokenKind.RBrace {
            cg_err(c, "expected pair separator")
        }
    }
    p_expect(p, TokenKind.RBrace)
    var nm = name.len()
    emit(c, OpCode.ConstI32, nm.str(), nm)
    emit(c, OpCode.NewInstance, "\"" + name + "\"", 0)
    emit(c, OpCode.ConstI32, n.str(), n)
    emit(c, OpCode.ConstructInstance, "", 0)
    c.arr_flag = 0
    c.str_flag = 0
}

// 单模式比较发射:load t;<pattern 表达式>;eq —— 标量枚举判别值直接
// const.i32,字面量按各自形态
fn cg_is_pattern_expr(mut c CG, pat E) {
    if pat.kind == "tag-cover" {
        var dv = cg_const_lookup(c, pat.name + "." + pat.word)
        if dv == -999999 {
            cg_err(c, "unknown enum variant: " + pat.name + "." + pat.word)
            return
        }
        emit(c, OpCode.ConstI32, dv.str(), dv)
    } else if pat.kind == "str" {
        var idx = cg_pool_add(c, pat.name)
        emit(c, OpCode.LoadStr, "", idx)
    } else if pat.kind == "char" {
        var cp = pat.name.char_at(0)
        emit(c, OpCode.ConstI32, cp.str(), cp)
    } else if pat.kind == "int" {
        emit(c, OpCode.ConstI32, pat.name, int_val(pat.name))
    } else {
        cg_err(c, "unsupported is pattern: " + pat.kind)
    }
}

// EqBranch 臂:模式收集(is_pattern 复用)→ 按形态三路发射:
// ① 载荷变体+实绑定 → is.variant + jmp.z next + 逐槽 get.generic.field
//   绑定 + 体 + jmp end(continue 式,无共享尾)
// ② 载荷变体无绑定 → load t;is.variant;共享尾(jmp.z next;体;jmp end)
// ③ 标量/字面量 → 单模式:load t;pat;eq;共享尾;多模式:or 链
fn cg_is(mut c CG, mut p P) {
    p_next(p)
    cg_expr(c, p, 0)
    var t = cg_add_var(c, "_is_target", 0, "")
    cg_emit_store(c, t)
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    var end_jmps List<int> = List.new()
    while c.err == "" && p_kind(p) != TokenKind.RBrace && p_kind(p) != TokenKind.EOF {
        var k = p_kind(p)
        if k == TokenKind.If {
            p_next(p)
            cg_expr(c, p, 0)
            var jz = emit(c, OpCode.JmpZ, "", -1)
            p_expect(p, TokenKind.Arrow)
            cg_is_arm_body(c, p)
            var je = emit(c, OpCode.Jmp, "", -1)
            end_jmps.push(je)
            c.ins.get(jz).n = c.ins.len()
        } else if k == TokenKind.Else {
            p_next(p)
            p_expect(p, TokenKind.Arrow)
            cg_is_arm_body(c, p)
            // 宿主 Else 臂体后同样发 jmp→end(end 即紧邻指令,无害跳转)
            var jej = emit(c, OpCode.Jmp, "", -1)
            end_jmps.push(jej)
        } else {
            var pat = is_pattern(p)
            var extras List<E> = List.new()
            while c.err == "" && p_kind(p) == TokenKind.VBar {
                p_next(p)
                skip_empty_lines(p)
                var np = is_pattern(p)
                extras.push(np)
                skip_empty_lines(p)
            }
            p_expect(p, TokenKind.Arrow)
            skip_empty_lines(p)
            var fc = -1
            if pat.kind == "tag-cover" {
                fc = cg_ctor_lookup(c, pat.name + "." + pat.word)
            }
            var has_real_bind = false
            if fc >= 0 && pat.args != "" && pat.args != "_" {
                var binds = split_commas(pat.args)
                var bi = 0
                while bi < binds.len() {
                    if binds.get(bi) != "_" {
                        has_real_bind = true
                    }
                    bi = bi + 1
                }
            }
            if fc >= 0 && has_real_bind {
                // ① 载荷 + 绑定
                var key = f"${pat.name}.${pat.word}"
                cg_emit_load(c, t)
                emit(c, OpCode.IsVariant, "\"" + key + "\"", 0)
                var jz2 = emit(c, OpCode.JmpZ, "", -1)
                var binds2 = split_commas(pat.args)
                var si = 0
                while si < binds2.len() {
                    if binds2.get(si) != "_" {
                        cg_emit_load(c, t)
                        emit(c, OpCode.GetGenericField, "field=" + si.str(), si)
                        emit(c, OpCode.Nop, "", 0)
                        emit(c, OpCode.Nop, "", 0)
                        emit(c, OpCode.Nop, "", 0)
                        var bidx = cg_add_var(c, binds2.get(si), 0, "")
                        cg_emit_store(c, bidx)
                    }
                    si = si + 1
                }
                cg_is_arm_body(c, p)
                var je2 = emit(c, OpCode.Jmp, "", -1)
                end_jmps.push(je2)
                c.ins.get(jz2).n = c.ins.len()
            } else {
                var shared_jz = -1
                if fc >= 0 {
                    // ② 载荷无实绑定:is.variant 后走共享尾
                    var key2 = f"${pat.name}.${pat.word}"
                    cg_emit_load(c, t)
                    emit(c, OpCode.IsVariant, "\"" + key2 + "\"", 0)
                } else if extras.len() == 0 {
                    // ③a 单模式:load t;pat;eq
                    cg_emit_load(c, t)
                    cg_is_pattern_expr(c, pat)
                    emit(c, OpCode.Eq, "", 0)
                } else {
                    // ③b or 链:逐模式 eq + jmp.nz 匹配标号;全落空 jmp next
                    var nz_jmps List<int> = List.new()
                    cg_emit_load(c, t)
                    cg_is_pattern_expr(c, pat)
                    emit(c, OpCode.Eq, "", 0)
                    var nz = emit(c, OpCode.JmpNz, "", -1)
                    nz_jmps.push(nz)
                    var ei = 0
                    while ei < extras.len() {
                        cg_emit_load(c, t)
                        cg_is_pattern_expr(c, extras.get(ei))
                        emit(c, OpCode.Eq, "", 0)
                        var nz2 = emit(c, OpCode.JmpNz, "", -1)
                        nz_jmps.push(nz2)
                        ei = ei + 1
                    }
                    var jmp_next = emit(c, OpCode.Jmp, "", -1)
                    var mi = 0
                    while mi < nz_jmps.len() {
                        c.ins.get(nz_jmps.get(mi)).n = c.ins.len()
                        mi = mi + 1
                    }
                    cg_is_arm_body(c, p)
                    var je3 = emit(c, OpCode.Jmp, "", -1)
                    end_jmps.push(je3)
                    c.ins.get(jmp_next).n = c.ins.len()
                    skip_empty_lines(p)
                    if p_kind(p) == TokenKind.Comma {
                        p_next(p)
                        skip_empty_lines(p)
                    }
                    skip_empty_lines(p)
                    continue
                }
                // 共享尾:jmp.z next;体;jmp end;patch next
                shared_jz = emit(c, OpCode.JmpZ, "", -1)
                cg_is_arm_body(c, p)
                var je4 = emit(c, OpCode.Jmp, "", -1)
                end_jmps.push(je4)
                c.ins.get(shared_jz).n = c.ins.len()
            }
        }
        if p_kind(p) == TokenKind.Comma {
            p_next(p)
            skip_empty_lines(p)
        }
        skip_empty_lines(p)
    }
    p_expect(p, TokenKind.RBrace)
    var e = 0
    while e < end_jmps.len() {
        c.ins.get(end_jmps.get(e)).n = c.ins.len()
        e = e + 1
    }
}

fn cg_stmt(mut c CG, mut p P) {
    if c.err != "" {
        return
    }
    var k = p_kind(p)
    if k == TokenKind.Enum {
        cg_enum_decl(c, p)
        return
    }
    if k == TokenKind.Type {
        cg_type_decl(c, p)
        return
    }
    if k == TokenKind.Use {
        cg_use(c, p)
        return
    }
    if k == TokenKind.Ident && p_text(p) == "pub" {
        // W3:pub 前缀跳过(D3:VM 链路无导出过滤)
        p_next(p)
        if p_kind(p) == TokenKind.Fn {
            cg_fn(c, p)
        } else {
            cg_stmt(c, p)
        }
        return
    }
    if k == TokenKind.Break || k == TokenKind.Continue {
        p_next(p)
        cg_loop_jump(c, k)
        return
    }
    if k == TokenKind.Is {
        cg_is(c, p)
        return
    }
    if k == TokenKind.Let || k == TokenKind.Var || k == TokenKind.Const || k == TokenKind.Shared {
        p_next(p)
        var name = p_text(p)
        p_next(p)
        var vty = ""
        if is_type_name(p) {
            var vt = parse_type(p)
            if vt == "str" {
                vty = "str"
            }
        }
        var is_arr = 0
        // W2(Plan 511):全局路径(镜像宿主 Plan 317/322——顶层 var/const
        // 注册进 global_vars 且无 scope 守卫:fn 体内同名声明也走全局;
        // W3:模块编译单元内键带 mod. 前缀 cg_gkey)
        var gk = cg_gkey(c, name)
        if (k == TokenKind.Var || k == TokenKind.Const) && c.depth == 1 {
            if !cg_is_global(c, gk) {
                c.global_vars.push(gk)
            }
        }
        if p_kind(p) == TokenKind.Asn {
            p_next(p)
            if cg_is_global(c, gk) {
                // init token 区间登记(fn main 体首重放用;首次声明记;
                // W3:仅主模块重放——dep 模块经模块初始化序执行 init)
                var from2 = p.pos
                cg_expr(c, p, 0)
                var to2 = p.pos
                if c.mod_name == "" {
                    var seen2 = false
                    var si2 = 0
                    while si2 < c.global_inits.len() {
                        if c.global_inits.get(si2).name == gk {
                            seen2 = true
                        }
                        si2 = si2 + 1
                    }
                    if !seen2 {
                        c.global_inits.push(CGInit(gk, from2, to2))
                    }
                }
                var gidx2 = cg_pool_add(c, gk)
                emit(c, OpCode.StoreGlobal, gidx2.str(), gidx2)
                return
            }
            cg_expr(c, p, 0)
            is_arr = c.arr_flag
            if c.str_flag == 1 {
                vty = "str"
            }
            // W1:构造字面量绑定记类型名(镜像宿主 var_types=GenericInstance
            // 的可观察面——写字段走 set.generic.field;注解/调用源不记,
            // 写走 load.str+set.field,与宿主 User 路径一致)
            if c.inst_ty != "" {
                vty = c.inst_ty
            }
        }
        var idx = cg_add_var(c, name, is_arr, vty)
        cg_emit_store(c, idx)
        return
    }
    if k == TokenKind.Return {
        p_next(p)
        var kk = p_kind(p)
        if kk == TokenKind.Newline || kk == TokenKind.Semi || kk == TokenKind.RBrace || kk == TokenKind.EOF {
            emit(c, OpCode.PushNil, "", 0)
        } else {
            cg_expr(c, p, 0)
        }
        var na = c.n_args
        var rs2 = f"n_args=${na.str()}"
        emit(c, OpCode.Ret, rs2, na)
        return
    }
    if k == TokenKind.If {
        cg_if(c, p)
        return
    }
    if k == TokenKind.While {
        cg_while(c, p)
        return
    }
    if k == TokenKind.For {
        cg_for(c, p)
        return
    }
    if k == TokenKind.Fn {
        cg_err(c, "nested fn unsupported")
        return
    }
    // 下标赋值 a[idx] = rhs:Rust 发射序为 rhs→arr→idx→set.elem
    // (value 展栈底,Rust 5954 quick-fix 栈序);单遍步行以游标
    // 快照两段解析——先越前扫到匹配 ] 后的 Asn,先发 rhs 再回头发 arr/idx
    if k == TokenKind.Ident && p_peek(p, 1) == TokenKind.LSquare {
        var arr_name = p_text(p)
        var aidx = cg_lookup(c, arr_name)
        if aidx < 0 {
            cg_err(c, "unknown ident: " + arr_name)
            return
        }
        var start = p.pos
        var scan = start + 2
        var depth = 1
        var ok = false
        while scan < p.toks.len() && !ok {
            var sk = p.toks.get(scan).kind
            if is_comment_kind(sk) {
                scan = scan + 1
            } else {
                if sk == TokenKind.LSquare {
                    depth = depth + 1
                } else if sk == TokenKind.RSquare {
                    depth = depth - 1
                    if depth == 0 {
                        ok = true
                    }
                }
                scan = scan + 1
            }
        }
        if ok && scan < p.toks.len() && p.toks.get(scan).kind != TokenKind.Asn && cg_is_assign_op(p_op(p.toks.get(scan).kind)) {
            // W2/D1(Plan 511):宿主对非 Ident LHS 复合赋值的拒绝文本同款
            cg_err(c, "Compound assignment requires a variable on left side")
            return
        }
        if ok && scan < p.toks.len() && p.toks.get(scan).kind == TokenKind.Asn {
            p.pos = scan + 1
            skip_empty_lines(p)
            cg_expr(c, p, 0)
            var end_pos = p.pos
            cg_emit_load(c, aidx)
            p.pos = start
            p_next(p)
            p_next(p)
            skip_empty_lines(p)
            cg_expr(c, p, 0)
            skip_empty_lines(p)
            p_expect(p, TokenKind.RSquare)
            emit(c, OpCode.SetElem, "", 0)
            p.pos = end_pos
            return
        }
        p.pos = start
    }
    // W1 字段赋值 x.f = rhs / x.a.b = rhs:两段游标快照(镜像 a[idx]= 模式)
    // —— 先前瞻扫字段链至 Asn,先发 rhs 再回头发对象/字段
    if k == TokenKind.Ident && p_peek(p, 1) == TokenKind.Dot {
        var recv2 = p_text(p)
        var ridx2 = cg_lookup(c, recv2)
        if ridx2 < 0 {
            cg_err(c, "unknown ident: " + recv2)
            return
        }
        var start3 = p.pos
        // 前瞻:Ident (Dot 名)+ Asn;名后不是 Dot/Asn 即非本形态
        var scan3 = start3 + 1
        var fields3 List<str> = List.new()
        var shape_ok = true
        while shape_ok && p.toks.get(scan3).kind == TokenKind.Dot {
            var fk3 = p.toks.get(scan3 + 1).kind
            if fk3 != TokenKind.Ident && !is_soft_ident_kind(fk3) {
                shape_ok = false
                break
            }
            fields3.push(p.toks.get(scan3 + 1).text)
            scan3 = scan3 + 2
            var after3 = p.toks.get(scan3).kind
            if after3 == TokenKind.Dot {
                // 链继续
            } else if after3 == TokenKind.Asn {
                break
            } else if cg_is_assign_op(p_op(after3)) {
                // 复合赋值:镜像宿主非 Ident LHS 的拒绝文本(D1 同族)
                cg_err(c, "Compound assignment requires a variable on left side")
                return
            } else {
                shape_ok = false
            }
        }
        if shape_ok && p.toks.get(scan3).kind == TokenKind.Asn {
            // 发射:rhs 先行
            p.pos = scan3 + 1
            skip_empty_lines(p)
            cg_expr(c, p, 0)
            var end_pos3 = p.pos
            var recv_ty = cg_var_ty(c, recv2)
            if fields3.len() == 1 && cg_tys_lookup(c, recv_ty) >= 0 {
                // 构造字面量源变量(宿主 GenericInstance 路径):
                // value,instance_id → set.generic.field <u32 字段下标>
                // (+3 幽灵 nop,镜像宿主 disasm u8 读宽形态)
                var fidx3 = cg_field_idx(c, recv_ty, fields3.get(0))
                if fidx3 < 0 {
                    cg_err(c, "unknown field: " + recv_ty + "." + fields3.get(0))
                    return
                }
                cg_emit_load(c, ridx2)
                emit(c, OpCode.SetGenericField, "field=" + fidx3.str(), fidx3)
                emit(c, OpCode.Nop, "", 0)
                emit(c, OpCode.Nop, "", 0)
                emit(c, OpCode.Nop, "", 0)
            } else {
                // 嵌套/非构造源(宿主 User/fallback 路径):value → 对象
                // 表达式 → load.str 字段名(栈顶)→ set.field
                cg_emit_load(c, ridx2)
                var fi3 = 0
                while fi3 < fields3.len() - 1 {
                    var mid3 = cg_pool_push(c, fields3.get(fi3))
                    emit(c, OpCode.GetField, "field[" + mid3.str() + "]", mid3)
                    fi3 = fi3 + 1
                }
                var last3 = cg_pool_add(c, fields3.get(fields3.len() - 1))
                emit(c, OpCode.LoadStr, "", last3)
                emit(c, OpCode.SetField, "", 0)
            }
            p.pos = end_pos3
            return
        }
        p.pos = start3
    }
    // 表达式语句:赋值特判
    if k == TokenKind.Ident {
        var name = p_text(p)
        var nk = p_peek(p, 1)
        if cg_is_assign_op(p_op(nk)) {
            // W2:全局写优先于局部查找(镜像宿主 6189-6192 的 check-BEFORE)
            if cg_is_global(c, cg_gkey(c, name)) {
                p_next(p)
                var gopk = p_kind(p)
                p_next(p)
                if gopk != TokenKind.Asn {
                    var gka = cg_gkey(c, name)
                    var gg = cg_pool_add(c, gka)
                    emit(c, OpCode.LoadGlobal, gg.str(), gg)
                }
                cg_expr(c, p, 0)
                var gmn = cg_binop_mnem(p_op(gopk))
                if gmn != OpCode.Blank {
                    emit(c, gmn, "", 0)
                }
                emit(c, OpCode.Dup, "", 0)
                var gkb = cg_gkey(c, name)
                var gidx3 = cg_pool_add(c, gkb)
                emit(c, OpCode.StoreGlobal, gidx3.str(), gidx3)
                emit(c, OpCode.Pop, "", 0)
                return
            }
            var idx = cg_lookup(c, name)
            if idx < 0 {
                cg_err(c, "unknown ident: " + name)
                return
            }
            p_next(p)
            var opk = p_kind(p)
            p_next(p)
            if opk != TokenKind.Asn {
                cg_emit_load(c, idx)
            }
            cg_expr(c, p, 0)
            var mn = cg_binop_mnem(p_op(opk))
            if mn != OpCode.Blank {
                emit(c, mn, "", 0)
            }
            emit(c, OpCode.Dup, "", 0)
            cg_emit_store(c, idx)
            emit(c, OpCode.Pop, "", 0)
            return
        }
    }
    // W3:表达式语句——用户 fn 调用语句尾补 pop 弃值(镜像宿主
    // Stmt::Expr 的非 void 结果丢弃;call.nat print 为 void 无 pop)
    var before_len = c.ins.len()
    cg_expr(c, p, 0)
    if c.err == "" && c.depth > 1 && c.ins.len() > before_len {
        if c.ins.get(c.ins.len() - 1).op == OpCode.Call {
            emit(c, OpCode.Pop, "", 0)
        }
    }
}

// 语句序列步行:.line(语句首 token 行,经 cg_line 同线去重)→ cg_stmt → eos
fn cg_stmts(mut c CG, mut p P) {
    while c.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RBrace {
        cg_line(c, p_line(p))
        cg_stmt(c, p)
        if c.err == "" {
            cg_eos(c, p)
        }
    }
}

// if/else-if/else:每分支 cond,jz→下一;体;jmp→end(含 return 后死 jmp)
fn cg_if(mut c CG, mut p P) {
    var jzs List<int> = List.new()
    var jends List<int> = List.new()
    var more = true
    while more {
        p_next(p)
        cg_expr(c, p, 0)
        var jz = emit(c, OpCode.JmpZ, "", -1)
        jzs.push(jz)
        cg_body_inline(c, p)
        var je = emit(c, OpCode.Jmp, "", -1)
        jends.push(je)
        if p_kind(p) == TokenKind.Else {
            p_next(p)
            if p_kind(p) != TokenKind.If {
                var z = 0
                while z < jzs.len() {
                    c.ins.get(jzs.get(z)).n = c.ins.len()
                    z = z + 1
                }
                cg_body_inline(c, p)
                more = false
            }
        } else {
            var z2 = 0
            while z2 < jzs.len() {
                c.ins.get(jzs.get(z2)).n = c.ins.len()
                z2 = z2 + 1
            }
            more = false
        }
    }
    var e = 0
    while e < jends.len() {
        c.ins.get(jends.get(e)).n = c.ins.len()
        e = e + 1
    }
}

// 分支/循环体(compile_body_inline:不推作用域)
fn cg_body_inline(mut c CG, mut p P) {
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    cg_stmts(c, p)
    p_expect(p, TokenKind.RBrace)
}

fn cg_eos(mut c CG, mut p P) {
    var has_sep = false
    while p_kind(p) == TokenKind.Semi || p_kind(p) == TokenKind.Newline || p_kind(p) == TokenKind.Comma {
        has_sep = true
        p_next(p)
    }
    if p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.RBrace && !has_sep {
        cg_err(c, "expected eos, got " + kind_name(p_kind(p)))
    }
}

// while:top(在语句 .line 之后):cond;jmp.z end;体;jmp top;end
fn cg_while(mut c CG, mut p P) {
    p_next(p)
    var top = c.ins.len()
    cg_expr(c, p, 0)
    var jz = emit(c, OpCode.JmpZ, "", -1)
    // P2:continue 落点 = 条件顶(while 语义:重判条件);体作用域与
    // for 同构(体内变量每迭代释放,cg_pop_scope depth>2 发释放组)
    cg_push_scope(c)
    cg_loop_enter(c, top)
    cg_body_inline(c, p)
    // 宿主布局:体 → 体内变量释放组 → 回跳;break 越过释放组直达 end
    cg_pop_scope(c)
    emit(c, OpCode.Jmp, "", top)
    var end = c.ins.len()
    c.ins.get(jz).n = end
    cg_loop_exit(c, end)
}

// for-in-range:start;store var;top:load var;end;lt;jmp.z end;
// 体;load var;const 1;add;store var;jmp top;end;循环域弹出(释放)
fn cg_for(mut c CG, mut p P) {
    p_next(p)
    if p_kind(p) != TokenKind.Ident {
        cg_err(c, "for: expected ident")
        return
    }
    var name = p_text(p)
    p_next(p)
    if p_kind(p) != TokenKind.In {
        cg_err(c, "for: expected in")
        return
    }
    p_next(p)
    // Call 迭代器通道不推作用域(宿主 2747-2829 无 push_scope——_iterator/
    // 循环变量落 fn 层作用域,fn 尾统一释放;b38 实证)
    if p_kind(p) == TokenKind.Ident && p_peek(p, 1) == TokenKind.LParen {
        // —— Call 迭代器协议 ——
        cg_expr(c, p, 0)
        var it_idx = cg_add_var(c, "_iterator", 0, "")
        cg_emit_store(c, it_idx)
        var it_v = cg_add_var(c, name, 0, "")
        var it_top = c.ins.len()
        cg_emit_load(c, it_idx)
        emit(c, OpCode.CallNat, "nat#112", 112)
        emit(c, OpCode.Dup, "", 0)
        emit(c, OpCode.ConstI32, "-1", -1)
        emit(c, OpCode.Eq, "", 0)
        var it_jnz = emit(c, OpCode.JmpNz, "", -1)
        cg_emit_store(c, it_v)
        cg_loop_enter(c, 0)
        cg_body_inline(c, p)
        // continue 也回循环顶(重新 next),无增量段(宿主同款)
        c.cont_tg.set(c.loop_depth - 1, it_top)
        emit(c, OpCode.Jmp, "", it_top)
        var it_end = c.ins.len()
        c.ins.get(it_jnz).n = it_end
        cg_loop_exit(c, it_end)
        return
    }
    cg_push_scope(c)
    // start 以 min=18 界定(不吞 .. 的中缀绑定);显式吃 Range/RangeEq 再取 end
    cg_expr(c, p, 18)
    if p_kind(p) == TokenKind.Range || p_kind(p) == TokenKind.RangeEq {
        p_next(p)
    } else {
        // —— 数组/表达式通道(Plan 511 W2)——
        // <对象> 求值一次;dup/arr.len 缓存;const.0 计数器;三隐藏槽
        // (_counter/_array_len/_array_ref)+ 循环变量;continue 落点=增量段
        emit(c, OpCode.Dup, "", 0)
        emit(c, OpCode.ArrLen, "", 0)
        emit(c, OpCode.Const0, "", 0)
        var cnt = cg_add_var(c, "_counter", 0, "")
        cg_emit_store(c, cnt)
        var aln = cg_add_var(c, "_array_len", 0, "")
        cg_emit_store(c, aln)
        var aref = cg_add_var(c, "_array_ref", 0, "")
        cg_emit_store(c, aref)
        var av = cg_add_var(c, name, 0, "")
        var atop = c.ins.len()
        cg_emit_load(c, cnt)
        cg_emit_load(c, aln)
        emit(c, OpCode.Lt, "", 0)
        var ajz = emit(c, OpCode.JmpZ, "", -1)
        cg_emit_load(c, aref)
        cg_emit_load(c, cnt)
        emit(c, OpCode.GetElem, "", 0)
        cg_emit_store(c, av)
        cg_loop_enter(c, 0)
        cg_body_inline(c, p)
        c.cont_tg.set(c.loop_depth - 1, c.ins.len())
        cg_emit_load(c, cnt)
        emit(c, OpCode.ConstI32, "1", 1)
        emit(c, OpCode.Add, "", 0)
        cg_emit_store(c, cnt)
        emit(c, OpCode.Jmp, "", atop)
        var aend = c.ins.len()
        c.ins.get(ajz).n = aend
        cg_loop_exit(c, aend)
        cg_pop_scope(c)
        return
    }
    var idx = cg_add_var(c, name, 0, "")
    cg_emit_store(c, idx)
    var top = c.ins.len()
    cg_emit_load(c, idx)
    cg_expr(c, p, 0)
    emit(c, OpCode.Lt, "", 0)
    var jz = emit(c, OpCode.JmpZ, "", -1)
    // P2:continue 落点 = 步进位(循环变量自增;宿主 range-for 同口径)
    cg_loop_enter(c, 0)
    cg_body_inline(c, p)
    c.cont_tg.set(c.loop_depth - 1, c.ins.len())
    cg_emit_load(c, idx)
    emit(c, OpCode.ConstI32, "1", 1)
    emit(c, OpCode.Add, "", 0)
    cg_emit_store(c, idx)
    emit(c, OpCode.Jmp, "", top)
    var end = c.ins.len()
    c.ins.get(jz).n = end
    cg_loop_exit(c, end)
    cg_pop_scope(c)
}

// ── fn 编译 ──────────────────────────────────────────────────

fn cg_fn(mut c CG, mut p P) {
    p_next(p)
    if p_kind(p) != TokenKind.Ident {
        cg_err(c, "fn: expected name")
        return
    }
    var name = p_text(p)
    p_next(p)
    var jover = emit(c, OpCode.Jmp, "", -1)
    var entry = c.ins.len()
    c.fns.push(FnEntry(name, entry))
    var saved_args = c.n_args
    var saved_max = c.max_idx
    c.max_idx = -1
    var saved_hi = c.hi_idx
    c.hi_idx = -1
    cg_push_scope(c)
    var prolog = emit(c, OpCode.FnProlog, "", 0)
    var reserve = emit(c, OpCode.Reserve, "", 0)
    var n_args = 0
    p_expect(p, TokenKind.LParen)
    skip_empty_lines(p)
    var running = true
    while running && c.err == "" {
        var k = p_kind(p)
        if k == TokenKind.View || k == TokenKind.Mut || k == TokenKind.Move || k == TokenKind.Take || k == TokenKind.Copy {
            p_next(p)
        }
        if p_kind(p) != TokenKind.Ident {
            running = false
        } else {
            var pname = p_text(p)
            p_next(p)
            if p_kind(p) == TokenKind.Colon {
                p_next(p)
            }
            // W2:List 型参数记 arr(447 收账缺口①——.len() 接收者跟踪)
            var parr = 0
            if is_type_name(p) {
                if p_text(p) == "List" && p_peek(p, 1) == TokenKind.Lt {
                    parr = 1
                }
                parse_type(p)
            }
            if p_kind(p) == TokenKind.Asn {
                p_next(p)
                expr_pratt(p, 0)
            }
            cg_add_var(c, pname, parr, "")
            n_args = n_args + 1
            if p_kind(p) == TokenKind.Comma {
                p_next(p)
            } else {
                running = false
            }
        }
    }
    p_expect(p, TokenKind.RParen)
    c.n_args = n_args
    if p_kind(p) == TokenKind.Arrow {
        p_next(p)
        parse_type(p)
        skip_empty_lines(p)
    } else if is_type_name(p) {
        parse_type(p)
        skip_empty_lines(p)
    }
    // W2:fn main 体首重放全局初始化(镜像宿主 codegen 1339-1348——入口
    // 直接 spawn main 跳过 wrapper 顶层,故在 main 体首按声明序重放
    // init token 区间;语料约定 fn main 声明于顶层 var 之后)
    if name == "main" && c.mod_name == "" && c.global_inits.len() > 0 {
        var gi = 0
        while gi < c.global_inits.len() && c.err == "" {
            var ent = c.global_inits.get(gi)
            var saved_pos = p.pos
            p.pos = ent.from
            cg_expr(c, p, 0)
            p.pos = saved_pos
            var rgidx = cg_pool_add(c, ent.name)
            emit(c, OpCode.StoreGlobal, rgidx.str(), rgidx)
            gi = gi + 1
        }
    }
    // 体块(Stmt::Block:推作用域;语句 .line 由 cg_stmts 发)
    cg_push_scope(c)
    p_expect(p, TokenKind.LBrace)
    skip_empty_lines(p)
    cg_stmts(c, p)
    p_expect(p, TokenKind.RBrace)
    cg_pop_scope(c)
    // epilogue RET
    var rs = f"n_args=${n_args.str()}"
    emit(c, OpCode.Ret, rs, n_args)
    // 回填 prolog/reserve(Rust:n_locals = max_locals - n_args)
    var n_locals = 0
    if c.hi_idx >= n_args {
        n_locals = c.hi_idx + 1 - n_args
    }
    c.ins.get(prolog).s = "args=" + n_args.str() + ", locals=" + n_locals.str()
    c.ins.get(prolog).n = n_args
    if n_locals > 0 {
        c.ins.get(reserve).s = n_locals.str()
        c.ins.get(reserve).n = n_locals
    } else {
        c.ins.get(reserve).op = OpCode.Blank
    }
    c.ins.get(jover).n = c.ins.len()
    cg_pop_scope(c)
    c.n_args = saved_args
    c.max_idx = saved_max
    c.hi_idx = saved_hi
}

// ── 序列化 ──────────────────────────────────────────────────

fn hex4(n int) str {
    var digits = "0123456789abcdef"
    var out = ""
    var v = n
    var k = 0
    while k < 4 {
        var d = v % 16
        out = digits.slice(d, d + 1) + out
        v = v / 16
        k = k + 1
    }
    return out
}

fn cg_serialize(mut c CG) str {
    var offs List<int> = List.new()
    var acc = 0
    var i = 0
    while i < c.ins.len() {
        offs.push(acc)
        var ii = c.ins.get(i)
        if ii.op != OpCode.Blank {
            acc = acc + i_size_named(ii.op, ii.s, ii.n)
        }
        i = i + 1
    }
    var out = ""
    var j = 0
    while j < c.ins.len() {
        var ins = c.ins.get(j)
        if ins.op != OpCode.Blank {
            var ops = ins.s
            if ins.op == OpCode.Jmp || ins.op == OpCode.JmpZ || ins.op == OpCode.JmpNz {
                ops = f"-> 0x${hex4(offs.get(ins.n))}"
            } else if ins.op == OpCode.Call {
                var fe = c.fns.get(ins.n)
                ops = f"0x${hex4(offs.get(fe.ins))}"
            } else if ins.op == OpCode.LoadStr {
                ops = "\"" + c.pool.get(ins.n) + "\""
            } else if ins.op == OpCode.LoadGlobal || ins.op == OpCode.StoreGlobal {
                // W3:链接后 ins.n 为合并池索引(s 为模块本地旧值,弃用)
                ops = ins.n.str()
            } else if ins.op == OpCode.GetField {
                ops = "field[" + ins.n.str() + "]"
            }
            if out != "" {
                out = out + "\n"
            }
            out = f"${out}${hex4(offs.get(j))}  ${op_name(ins.op)} ${ops}"
        }
        j = j + 1
    }
    return out
}

// ── W3(Plan 511):use 模块化——解析器/多编译单元/链接器 ────────

// 模块记录(name=use 路径,source=文件文本)
type CGMod {
    name str
    source str
}

// 路径目录部分(最后 / 或 \ 之前;无分隔符返回 "")
fn cg_dir_of(path str) str {
    var i = 0
    var last = -1
    while i < path.len() {
        var ch = path.char_at(i)
        if ch == 47 || ch == 92 {
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        return ""
    }
    return path.slice(0, last)
}

// use 语句轻扫(复用 cg_use 的消费逻辑,记录进临时 CG 的 uses)
fn cg_use_scan(source str) List<CGUse> {
    var out List<CGUse> = List.new()
    var toks = tokenize(source)
    var p = parse_new(toks)
    var scratch = cg_new()
    skip_empty_lines(p)
    while p.err == "" && p_kind(p) != TokenKind.EOF {
        if p_kind(p) == TokenKind.Use {
            cg_use(scratch, p)
        } else if p_kind(p) == TokenKind.Ident && p_text(p) == "pub" {
            p_next(p)
        } else {
            // 越过其余语句:保守步进到行尾
            while p.err == "" && p_kind(p) != TokenKind.EOF && p_kind(p) != TokenKind.Newline && p_kind(p) != TokenKind.Semi {
                p_next(p)
            }
        }
        if p.err == "" {
            var k2 = p_kind(p)
            while k2 == TokenKind.Newline || k2 == TokenKind.Semi || k2 == TokenKind.Comma {
                p_next(p)
                k2 = p_kind(p)
            }
        }
    }
    var i = 0
    while i < scratch.uses.len() {
        out.push(scratch.uses.get(i))
        i = i + 1
    }
    return out
}

// 模块路径 . → /(slice 拼接——char_at 为码点整数值)
fn cg_mod_fs_path(module str) str {
    var out = ""
    var start = 0
    var i = 0
    while i < module.len() {
        if module.char_at(i) == 46 {
            out = out + module.slice(start, i) + "/"
            start = i + 1
        }
        i = i + 1
    }
    return out + module.slice(start, module.len())
}

// 递归解析:file 的 use 依赖先行入列(DFS 后序 = deps 先于依赖者;
// 环静默跳过 D2;按名去重)。返回错误文本(""=成功,宿主文本为规范)。
fn cg_resolve_into(file str, mut mods List<CGMod>, mut loading List<str>, mut done List<str>) str {
    var src = File.read_text(file)
    if src == "" {
        return "Module not found: " + file + " (module_path=" + file + ", parent_dirs=[])"
    }
    var uses = cg_use_scan(src)
    var dir = cg_dir_of(file)
    var i = 0
    while i < uses.len() {
        var u = uses.get(i)
        if u.kind == "rs" {
            var crate_name = u.module
            var di = 0
            while di < crate_name.len() {
                if crate_name.char_at(di) == 46 {
                    crate_name = crate_name.slice(0, di)
                    di = crate_name.len()
                }
                di = di + 1
            }
            return "Crate '" + crate_name + "' not declared. Add `dep " + crate_name + "` before `use.rs`."
        }
        if u.kind == "py" {
            return "Python FFI not enabled. Rebuild with `--features python` to use `use.py`."
        }
        if u.kind == "c" {
            return "Expected <lib> or \"lib\", got Ident"
        }
        // auto 模块
        var m = u.module
        var already = false
        var j = 0
        while j < done.len() {
            if done.get(j) == m {
                already = true
            }
            j = j + 1
        }
        var in_stack = false
        var j2 = 0
        while j2 < loading.len() {
            if loading.get(j2) == m {
                in_stack = true
            }
            j2 = j2 + 1
        }
        if !already && !in_stack {
            var mfile = dir + "/" + cg_mod_fs_path(m) + ".at"
            var msrc = File.read_text(mfile)
            if msrc == "" {
                return "Module not found: " + m + " (module_path=" + cg_mod_fs_path(m) + ", parent_dirs=[])"
            }
            loading.push(m)
            var rerr = cg_resolve_into(mfile, mods, loading, done)
            if rerr != "" {
                return rerr
            }
            // loading 免清除:done 表先行判定,链上环检测仅需活动期在栈
            mods.push(CGMod(m, msrc))
            done.push(m)
        }
        i = i + 1
    }
    return ""
}

// 入口:main_path → 有序模块列(deps DFS 后序 + main 末位)。错误文本直返
fn cg_resolve(main_path str) AutoResult2 {
    var mods List<CGMod> = List.new()
    var loading List<str> = List.new()
    var done List<str> = List.new()
    var err = cg_resolve_into(main_path, mods, loading, done)
    if err != "" {
        return AutoResult2(mods, err)
    }
    var main_src = File.read_text(main_path)
    mods.push(CGMod("", main_src))
    return AutoResult2(mods, "")
}

// 多值返回载体(mods + err)
type AutoResult2 {
    mods List<CGMod>
    err str
}

// ── 编译入口(S5 engine 复用;返回 CG 结构) ────────────────────

fn cg_compile(source str) CG {
    // W3:主模块经 cg_compile_mod(mod_name="" → wrapper 形态)
    return cg_compile_mod(source, "")
}

// W3:多编译单元入口。主模块(mod_name=""):wrapper 形态(既有口径);
// dep 模块(mod_name≠""):裸形态——Type/Use 消费、顶层 var/const 走
// 限名全局、fn 直接发射(各自 jmp-over),尾 HALT,无 wrapper(镜像
// 宿主 compile_module_to_bytecode;语料声明序=Type→Store→Fn 单趟步行)
fn cg_compile_mod(source str, mod_name str) CG {
    var toks = tokenize(source)
    var p = parse_new(toks)
    var c = cg_new()
    c.mod_name = mod_name
    if mod_name == "" {
        emit(c, OpCode.FnProlog, "args=0, locals=16", 16)
        emit(c, OpCode.Reserve, "16", 16)
    }
    skip_empty_lines(p)
    while c.err == "" && p.err == "" && p_kind(p) != TokenKind.EOF {
        if p_kind(p) == TokenKind.Fn {
            cg_fn(c, p)
        } else if p_kind(p) == TokenKind.Ident && p_text(p) == "pub" {
            p_next(p)
            if p_kind(p) == TokenKind.Fn {
                cg_fn(c, p)
            } else {
                cg_stmt(c, p)
            }
        } else {
            // 顶层非 fn 语句:主模块 wrapper 内步行(镜像 Rust
            // compile_and_link 的 other_stmts 路径);该路径不发 .line;
            // dep 模块顶层语句同口径(005 实测:模块 init store 无 .line)
            cg_stmt(c, p)
        }
        if c.err == "" {
            cg_eos(c, p)
        }
    }
    if c.err == "" {
        emit(c, OpCode.Halt, "", 0)
    }
    return c
}

// W3:符号定址(bare 首到首胜 + mod.fn 限定;host loader 264-312 镜像)
fn cg_link_symbol(c CG, symbol str) int {
    var i = 0
    while i < c.fns.len() {
        if c.fns.get(i).name == symbol {
            return i
        }
        i = i + 1
    }
    // 限定:前缀逐模块试(模块名可含点,tools.helper.fn)
    var mi2 = 0
    while mi2 < c.fn_mods.len() {
        var m = c.fn_mods.get(mi2)
        if m != "" && symbol.len() > m.len() + 1 {
            var head = symbol.slice(0, m.len())
            var tail = symbol.slice(m.len() + 1, symbol.len())
            var sep = symbol.char_at(m.len())
            if head == m && sep == 46 && c.fns.get(mi2).name == tail {
                return mi2
            }
        }
        mi2 = mi2 + 1
    }
    // 兜底:剥前缀裸名(host loader strip-prefix fallback)
    var li2 = 0
    while li2 < c.fns.len() {
        if c.fns.get(li2).name == symbol {
            return li2
        }
        li2 = li2 + 1
    }
    return -1
}

// W3:链接器——cgs(deps DFS 后序 + main 末位)→ 合并 CG:
// 指令平移(jmp 目标 +base / Call fn 索引 +fnbase / 池操作数 remap 去重
// 并池)、fns/fn_mods 合并、defers 定址(mod_bases 记 dep 起始)。
// 返回 CG.err 非空即链接失败(宿主文本)
fn cg_link_modules(mut cgs List<CG>) CG {
    var m = cg_new()
    var fn_base = 0
    var mi = 0
    while mi < cgs.len() {
        var mc = cgs.get(mi)
        var ins_base = m.ins.len()
        if mi < cgs.len() - 1 {
            m.mod_bases.push(ins_base)
        }
        // 池去重合并 + remap 表
        var remap List<int> = List.new()
        var pi = 0
        while pi < mc.pool.len() {
            var ps = mc.pool.get(pi)
            var found = -1
            var pj = 0
            while pj < m.pool.len() {
                if m.pool.get(pj) == ps {
                    found = pj
                }
                pj = pj + 1
            }
            if found < 0 {
                m.pool.push(ps)
                found = m.pool.len() - 1
            }
            remap.push(found)
            pi = pi + 1
        }
        // 指令迁移
        var ii = 0
        while ii < mc.ins.len() {
            var ins = mc.ins.get(ii)
            if ins.op == OpCode.Jmp || ins.op == OpCode.JmpZ || ins.op == OpCode.JmpNz {
                ins.n = ins.n + ins_base
            } else if ins.op == OpCode.Call && ins.n >= 0 {
                ins.n = ins.n + fn_base
            } else if ins.op == OpCode.LoadStr || ins.op == OpCode.GetField || ins.op == OpCode.LoadGlobal || ins.op == OpCode.StoreGlobal {
                if ins.n >= 0 && ins.n < remap.len() {
                    ins.n = remap.get(ins.n)
                }
            }
            m.ins.push(ins)
            ii = ii + 1
        }
        // fns + fn_mods
        var fi = 0
        while fi < mc.fns.len() {
            var fe = mc.fns.get(fi)
            m.fns.push(FnEntry(fe.name, fe.ins + ins_base))
            var mn2 = mc.mod_name
            m.fn_mods.push(mn2)
            fi = fi + 1
        }
        // defers(绝对化 ins 指针)
        var di = 0
        while di < mc.defers.len() {
            var d = mc.defers.get(di)
            m.defers.push(CGDefer(d.ins_idx + ins_base, d.symbol))
            di = di + 1
        }
        fn_base = fn_base + mc.fns.len()
        if mc.err != "" && m.err == "" {
            m.err = mc.err
        }
        mi = mi + 1
    }
    // defer 定址
    var ri = 0
    while ri < m.defers.len() {
        var d2 = m.defers.get(ri)
        var target = cg_link_symbol(m, d2.symbol)
        if target < 0 {
            m.err = "Undefined symbol: " + d2.symbol + " in module <main>"
            return m
        }
        m.ins.get(d2.ins_idx).n = target
        ri = ri + 1
    }
    return m
}

// W3 多文件编译主入口:main_path → 合并 CG(err 语义同 cg_compile)
fn cg_compile_files(main_path str) CG {
    var res = cg_resolve(main_path)
    if res.err != "" {
        var e = cg_new()
        e.err = res.err
        return e
    }
    var cgs List<CG> = List.new()
    var i = 0
    while i < res.mods.len() {
        var mod = res.mods.get(i)
        cgs.push(cg_compile_mod(mod.source, mod.name))
        i = i + 1
    }
    return cg_link_modules(cgs)
}

// W3 M4 多文件闸门入口
fn codegen_dump_files(main_path str) str {
    var c = cg_compile_files(main_path)
    if c.err != "" {
        return c.err
    }
    return cg_serialize(c)
}

// M4 闸门入口
fn codegen_dump(source str) str {
    var c = cg_compile(source)
    if c.err != "" {
        return c.err
    }
    return cg_serialize(c)
}

// ╔═══════════════════════════════════════════════════════════╗
// ║ AAVM v2 Sync Snapshot                                     ║
// ║ Component: engine.at (Plan 432 S5 / D29: ev_run)          ║
// ║ Rust ref:  vm/engine.rs(执行循环)+ lib.rs(main 入口查找) ║
// ║ Gate:      M3 主里程碑 —— VM 内全管线跑通 corpus 行为      ║
// ╚═══════════════════════════════════════════════════════════╝
//           447-③ 终局收账:ev_run_t 分派巨链 is(E1)/Val 枚举化
//           VInt|VStr|VArr|VInst(E2,D34)/BuildFstr 执行(11.2a);D36①②
//           提升写法永久保留(正确性保障,rules §4a)
// Coverage:  栈机执行循环(指令 List 直译,无字节码解码);帧语义
//            (CALL:ret-ip+old-bp;RET:result 转移 + new_sp=bp-n_args;
//            fn.prolog 记 n_args;reserve 推 n+1 零槽);main 入口
//            查找(无 main 回落 wrapper=0,镜像 lib.rs 1183);
//            指令子集:const.i32/push.bool/push.nil/load.str/
//            load.loc.0/1/2/load.local(参数 0x80+rel →
//            bp-n_args+rel-1)/store.loc.0/1/store.local/
//            add/sub/mul/div/mod/eq/ne/lt/gt/le/ge/and/or/not/
//            str.cat/dup/pop/jmp/jmp.z/.line(nop)/call/call.nat
//            (nat#10=print → 输出行收集)/ret/halt;
//            [M4 扩]create.arr(元素依次建 Auto List)、get.elem
//            (负下标归一/OOB 推 0,镜像 engine.rs 4403)、set.elem
//            (value 在栈底:idx,arr,value 逆序弹;引用语义原地写)、
//            arr.len(List/str 动态分派,镜像 ARRAY_LEN 的两分支)
// Missing:   浮点/对象/字符串下标(码点取值已含)/方法调用 native、
//            闭包、全局变量、任务/调度/async(debugger/trace 按
//            计划不移植)、值 RC(宿主 AutoVM 自管 .at 值生命周期)
// DIVERGE:   D29: 字节码 Flash + ip 解码 → 指令 List 直译
//            (ip=指令索引;jmp/call 目标即索引);print 输出 →
//            out 字符串收集(run 返回);栈 = Auto List + 手记账 sp
//            (ev_push 兼容 push/set);RET 帧/参数槽位算术
//            与 engine.rs 逐条对齐(参数寻址 bp-n_args+rel-1)。
//            D30(433 重构):负 int 偏置编码保留但收窄到 int 载荷
//            域;D31(433 重构;447-③ E2 收账):值栈异构载体 → 枚举
//            Val{VInt/VStr/VArr/VInst}(对齐 auto-val Value 的 match
//            分派;433 期"枚举载荷跨函数丢标签"以宿主 H3 根治解除);
//            布尔/nil 仍以 0/1 整型承载(宿主 print 对 bool 打
//            "1"/"0",可观察行为一致)。

// 值栈元素:异构值的显式载体(433:a2r 需要静态元素类型;VM 侧 List
// 本就动态,行为不变)。447-③ E2(D34 收账):判别器结构体 {k,i,s}
// → 枚举载荷 VInt/VStr/VArr/VInst(对齐 auto-val Value 枚举的 match
// 分派形态;433 期的"枚举载荷跨函数传参丢标签"规避以 H3 根治解除,
// probe/b31/g05 三件护航)。VArr/VInst 的 int 载荷 = arena(数组侧表)
// 索引——索引即引用,镜像宿主 VM 的堆 id 设计(D31 续:VM 引用语义
// 与 a2r 值语义在"单一事实源=arena 槽位"上对齐,局部槽/栈位持有的
// 是可自由复制的索引);VInst 双载荷 {arena 字段表槽位, 变体名}
// (部分② 的 k=3 实例形态枚举化)。
enum Val {
    VInt(int)
    VStr(str)
    VArr(int)
    VInst(int, str)
}

fn ev_vi(x int) Val {
    return Val.VInt(x)
}

fn ev_vs(t str) Val {
    return Val.VStr(t)
}

fn ev_va(ai int) Val {
    return Val.VArr(ai)
}

// 栈写:sp 越界即 push,否则原地 set(镜像 ev_push)
fn ev_push(mut stack List<Val>, sp int, v Val) int {
    if sp == stack.len() {
        stack.push(v)
    } else {
        stack.set(sp, v)
    }
    return sp + 1
}

// 数值视图:int 载荷;其余 0(镜像 VM 对非数值参与 ==0 判定的行为)
fn ev_int(v Val) int {
    is v {
        Val.VInt(n) -> n
        else -> 0
    }
}

// 显示串(print 参数):镜像宿主 ADD-含字符串即拼接的语义;负 int
// 先解偏置(D30 编码);arr 为不可比载体(语料以元素/len 为观察
// 通道,D31),占位输出
fn ev_str(v Val) str {
    is v {
        Val.VStr(t) -> t
        Val.VInt(n) -> ev_dec(n).str()
        else -> "[arr]"
    }
}

// 真值:int 按 !=0;其余(含 str)恒真(镜像 VM `v != 0` 的
// 行为——字符串与 0 比较恒不等)
fn ev_truthy(v Val) bool {
    is v {
        Val.VInt(n) -> n != 0
        else -> true
    }
}

// v2 负 int 编码(D30):负 int 偏置 -1e9 入栈(规避宿主无类型
// List 的字符串哨兵别名);非负原样穿透
fn ev_enc(v int) int {
    if v < 0 {
        return v - 1000000000
    }
    return v
}

fn ev_dec(v int) int {
    if v <= -1000000000 {
        return v + 1000000000
    }
    return v
}

// 加法(host ADD 语义):任一侧字符串 → 拼接;双 int → 数值加
// (str.cat 指令与 add 的宿主语义镜像,当前 codegen 仅对已知
// 字符串操作数发 str.cat,双 int 分支为语义保真保留)
fn ev_add(a Val, b Val) Val {
    is a {
        Val.VStr(sa) -> {
            var bs = ev_str(b)
            return ev_vs(sa + bs)
        }
        else -> {
        }
    }
    is b {
        Val.VStr(sb) -> {
            var as2 = ev_str(a)
            return ev_vs(as2 + sb)
        }
        else -> {
        }
    }
    return ev_vi(ev_int(a) + ev_int(b))
}

// 全序比较:int 域比较先解偏置;str 域字典序(VM "b" > "a" 实测);
// 混合型/arr 不可比 → 2(eq 取 false、ne 取 true,镜像 VM "x" == 1
// → false);返回 -1/0/1/2
fn ev_cmp(a Val, b Val) int {
    is a {
        Val.VInt(ax) -> {
            // 嵌套 is 用新鲜拷贝(同标识符二次 is 会触发主 a2r H5 的
            // match & 引用绑定,载荷变 &i64/&String 不可再入按值调用)
            var b1 = b
            is b1 {
                Val.VInt(bx) -> {
                    var dx = ev_dec(ax)
                    var dy = ev_dec(bx)
                    if dx < dy {
                        return -1
                    }
                    if dx > dy {
                        return 1
                    }
                    return 0
                }
                else -> {
                }
            }
        }
        Val.VStr(sa) -> {
            var b2 = b
            is b2 {
                Val.VStr(sb) -> {
                    if sa < sb {
                        return -1
                    }
                    if sa > sb {
                        return 1
                    }
                    return 0
                }
                else -> {
                }
            }
        }
        else -> {
        }
    }
    return 2
}

// arr 载荷提取(只读用途);非数组值返回空表(长度 0 → OOB 语义)
fn ev_arr_of(mut arena List<List<Val>>, v Val) List<Val> {
    is v {
        Val.VArr(ai) -> {
            return arena.get(ai)
        }
        else -> {
        }
    }
    var none_l List<Val> = List.new()
    return none_l
}

// set.elem 写通道:唯一变异点 = arena 槽位。VM 引用语义下 l2 即
// arena 内同一引用(set 后 arena.set 为无操作写回);a2r 值语义下
// 写回修改副本进 arena——两种语义的可观察状态一致
fn ev_arr_write(mut arena List<List<Val>>, ai int, idx int, val Val) {
    var l2 List<Val> = arena.get(ai)
    l2.set(idx, val)
    arena.set(ai, l2)
}

// W1(Plan 511):字段名在类型声明序中的下标(-1=无该类型/字段)。
// get.field/set.field 按名定位用(镜像宿主 GenericInstanceData 的
// field_names.position)
fn ev_field_idx(c CG, tname str, fname str) int {
    var ti = 0
    while ti < c.tys.len() {
        if c.tys.get(ti).name == tname {
            var fl = c.tys.get(ti).fields
            var j = 0
            while j < fl.len() {
                if fl.get(j) == fname {
                    return j
                }
                j = j + 1
            }
            return -1
        }
        ti = ti + 1
    }
    return -1
}

// 数组/字符串长度动态分派(镜像 ARRAY_LEN 两分支)
fn ev_len(mut arena List<List<Val>>, v Val) int {
    is v {
        Val.VArr(ai) -> {
            var l = arena.get(ai)
            return l.len()
        }
        Val.VStr(t) -> {
            return t.len()
        }
        else -> {
        }
    }
    return 0
}

// ── 执行循环 ──────────────────────────────────────────────────

fn ev_run(source str) str {
    return ev_run_t(source, 0)
}

fn ev_run_t(source str, trace int) str {
    var c = cg_compile(source)
    if c.err != "" {
        return c.err
    }
    // main 入口查找(无 main 回落 0 = wrapper,镜像 lib.rs 1183)
    var entry = 0
    var fi = 0
    while fi < c.fns.len() {
        if c.fns.get(fi).name == "main" {
            entry = c.fns.get(fi).ins
        }
        fi = fi + 1
    }
    var gnames List<str> = List.new()
    var gvals List<Val> = List.new()
    return ev_exec(c, entry, trace, gnames, gvals)
}

// W3(Plan 511)多文件执行入口:resolve_uses→多编译单元→链接→初始化序
// (dep 模块链接序逐个执行至各自 HALT,全局区共享)→main 入口。
// 模块解析/编译错误文本直返(宿主为规范)
fn ev_run_files(main_path str) str {
    var c = cg_compile_files(main_path)
    if c.err != "" {
        return c.err
    }
    var gnames List<str> = List.new()
    var gvals List<Val> = List.new()
    var out = ""
    var bi = 0
    while bi < c.mod_bases.len() {
        var chunk = ev_exec(c, c.mod_bases.get(bi), 0, gnames, gvals)
        if chunk != "" {
            if out != "" {
                out = out + "
"
            }
            out = out + chunk
        }
        bi = bi + 1
    }
    // main 入口(镜像 lib.rs 1222:main/test 导出,否则主模块起点)
    var entry = 0
    var fi2 = 0
    while fi2 < c.fns.len() {
        if c.fns.get(fi2).name == "main" {
            entry = c.fns.get(fi2).ins
        }
        fi2 = fi2 + 1
    }
    var main_out = ev_exec(c, entry, 0, gnames, gvals)
    if main_out != "" {
        if out != "" {
            out = out + "
"
        }
        out = out + main_out
    }
    return out
}

// 执行核心(自 ev_run_t 抽出:单文件/多模块 init 共用;全局区以
// gnames/gvals 传入共享——VM List 引用语义写回)
fn ev_exec(c CG, entry int, trace int, mut gnames List<str>, mut gvals List<Val>) str {
    var stack List<Val> = List.new()
    var arena List<List<Val>> = List.new()
    var sp = 0
    // 初始帧:[0=ret 哨兵, 0=oldbp 哨兵];bp=1;main 的 RET 触底即 halt
    sp = ev_push(stack, sp, ev_vi(0))
    sp = ev_push(stack, sp, ev_vi(0))
    var bp = 1
    var ip = entry
    var out = ""
    var cur_args = 0
    var args_stack List<int> = List.new()
    var args_depth = 0
    var running = true
    while running {
        var ins = c.ins.get(ip)
        ip = ip + 1
        var op = ins.op
        if trace == 1 {
            if out != "" {
                out = out + "\n"
            }
            out = f"${out}${op_name(op)} sp=${sp.str()} bp=${bp.str()}"
        }
        is op {
            OpCode.Blank -> {
            // 已删除的占位指令(如 n_locals=0 时的 reserve)——跳过
        }
        OpCode.Halt -> {
            running = false
        }
        OpCode.Line | OpCode.FnProlog -> {
            if op == OpCode.FnProlog {
                cur_args = ins.n
            }
        }
        OpCode.Reserve -> {
            var n = ins.n
            var k = 0
            while k < n + 1 {
                sp = ev_push(stack, sp, ev_vi(0))
                k = k + 1
            }
        }
        OpCode.Jmp -> {
            ip = ins.n
        }
        OpCode.JmpZ -> {
            var v = stack.get(sp - 1)
            sp = sp - 1
            if !ev_truthy(v) {
                ip = ins.n
            }
        }
        OpCode.JmpNz -> {
            // Plan 447 部分②:or 臂短路或(H1 修后口径)
            var v0 = stack.get(sp - 1)
            sp = sp - 1
            if ev_truthy(v0) {
                ip = ins.n
            }
        }
        OpCode.NewInstance -> {
            // Plan 447 部分②:弹名长(const.i32 哨兵,名字在操作数);
            // 建空字段表入 arena,推实例(VInst:slot=arena 槽位,
            // name=变体名)
            sp = sp - 1
            var nm = ins.s
            if nm.len() >= 2 && nm.char_at(0) == '"' {
                nm = nm.slice(1, nm.len() - 1)
            }
            var fl List<Val> = List.new()
            arena.push(fl)
            var slot3 = arena.len() - 1
            sp = ev_push(stack, sp, Val.VInst(slot3, nm))
        }
        OpCode.ConstructInstance -> {
            // 栈:[..., 字段值…, 实例, 字段数](镜像宿主弹序:count→
            // instance→count 值);字段自底而上读入 arena 槽,实例回栈
            var n9 = ev_dec(ev_int(stack.get(sp - 1)))
            sp = sp - 1
            var inst9 = stack.get(sp - 1)
            sp = sp - 1
            var fl9 List<Val> = List.new()
            // is 拷贝:VInst 绑定 String 载荷是部分移动,inst9 后续回栈复用
            var inst9c = inst9
            is inst9c {
                Val.VInst(slot9, nm9) -> {
                    fl9 = arena.get(slot9)
                    var ci9 = 0
                    while ci9 < n9 {
                        fl9.push(stack.get(sp - n9 + ci9))
                        ci9 = ci9 + 1
                    }
                    arena.set(slot9, fl9)
                }
                else -> {
                }
            }
            sp = sp - n9
            sp = ev_push(stack, sp, inst9)
        }
        OpCode.IsVariant -> {
            // 弹实例,推命中 bool;VInst 且变体名全等才命中(非实例恒假)
            var v9 = stack.get(sp - 1)
            sp = sp - 1
            var nm9 = ins.s
            if nm9.len() >= 2 && nm9.char_at(0) == '"' {
                nm9 = nm9.slice(1, nm9.len() - 1)
            }
            var hit9 = 0
            is v9 {
                Val.VInst(slot9, name9) -> {
                    if name9 == nm9 {
                        hit9 = 1
                    }
                }
                else -> {
                }
            }
            sp = ev_push(stack, sp, ev_vi(hit9))
        }
        OpCode.GetGenericField -> {
            // 弹实例,推第 n 槽字段(后续 3 条 nop 为 u32 残留形态,直通)
            var v10 = stack.get(sp - 1)
            sp = sp - 1
            var slot10 = 0
            is v10 {
                Val.VInst(s10, nm10) -> {
                    slot10 = s10
                }
                else -> {
                }
            }
            var fl10 List<Val> = arena.get(slot10)
            sp = ev_push(stack, sp, fl10.get(ins.n))
        }
        OpCode.SetGenericField -> {
            // W1(Plan 511):栈 [value, instance_id](镜像宿主 6324-6352);
            // 弹实例→弹值→按声明序下标写 arena 槽(后 3 条 nop 直通)
            var v12 = stack.get(sp - 1)
            sp = sp - 1
            var slot12 = -1
            is v12 {
                Val.VInst(s12, nm12) -> {
                    slot12 = s12
                }
                else -> {
                }
            }
            var val12 = stack.get(sp - 1)
            sp = sp - 1
            if slot12 < 0 {
                out = "RUNTIME-ERROR:set.generic.field on non-instance"
                running = false
            } else {
                var fl12 List<Val> = arena.get(slot12)
                fl12.set(ins.n, val12)
                arena.set(slot12, fl12)
            }
        }
        OpCode.GetField -> {
            // W1:弹实例,按字段名(ins.n=名字池索引)在实例类型声明序中
            // 定位下标取值(镜像宿主 engine 5236 的 field_names.position)
            var v13 = stack.get(sp - 1)
            sp = sp - 1
            var slot13 = -1
            var tname13 = ""
            is v13 {
                Val.VInst(s13, nm13) -> {
                    slot13 = s13
                    tname13 = nm13
                }
                else -> {
                }
            }
            if slot13 < 0 {
                out = "RUNTIME-ERROR:get.field on non-instance"
                running = false
            } else {
                var fname13 = c.pool.get(ins.n)
                var fi13 = ev_field_idx(c, tname13, fname13)
                if fi13 < 0 {
                    out = "RUNTIME-ERROR:no field " + fname13 + " in " + tname13
                    running = false
                } else {
                    var fl13 List<Val> = arena.get(slot13)
                    sp = ev_push(stack, sp, fl13.get(fi13))
                }
            }
        }
        OpCode.SetField -> {
            // W1:栈 [value, object_id, field_name](名字经 load.str 压栈,
            // 镜像宿主 4925-4947 弹序:名→实例→值)
            var vname14 = ev_str(stack.get(sp - 1))
            sp = sp - 1
            var v14 = stack.get(sp - 1)
            sp = sp - 1
            var slot14 = -1
            var tname14 = ""
            is v14 {
                Val.VInst(s14, nm14) -> {
                    slot14 = s14
                    tname14 = nm14
                }
                else -> {
                }
            }
            var val14 = stack.get(sp - 1)
            sp = sp - 1
            if slot14 < 0 {
                out = "RUNTIME-ERROR:set.field on non-instance"
                running = false
            } else {
                var fi14 = ev_field_idx(c, tname14, vname14)
                if fi14 < 0 {
                    out = "RUNTIME-ERROR:no field " + vname14 + " in " + tname14
                    running = false
                } else {
                    var fl14 List<Val> = arena.get(slot14)
                    fl14.set(fi14, val14)
                    arena.set(slot14, fl14)
                }
            }
        }
        OpCode.BuildFstr -> {
            // 447-③ 11.2a:弹 ins.n 段(栈顶为末段,镜像宿主逆序弹),
            // ev_str 逐段转文本(int 解偏置 D30)正序拼接
            var n11 = ins.n
            var segs List<str> = List.new()
            var k11 = 0
            while k11 < n11 {
                segs.push(ev_str(stack.get(sp - 1)))
                sp = sp - 1
                k11 = k11 + 1
            }
            var out11 = ""
            var m11 = segs.len() - 1
            while m11 >= 0 {
                out11 = out11 + segs.get(m11)
                m11 = m11 - 1
            }
            sp = ev_push(stack, sp, ev_vs(out11))
        }
        OpCode.Nop -> {
            // no-op(get.generic.field 的 u32 残留字节形态)
        }
        OpCode.ConstI32 -> {
            sp = ev_push(stack, sp, ev_vi(ev_enc(ins.n)))
        }
        OpCode.Const0 -> {
            // W2:for-in 计数器初值(宿主 CONST_0 0x12)
            sp = ev_push(stack, sp, ev_vi(0))
        }
        OpCode.LoadGlobal -> {
            // W2:名字键全局读;未命中缺省 0(镜像宿主 unwrap_or(0))
            var gname = c.pool.get(ins.n)
            var gv = ev_vi(0)
            var qi = 0
            while qi < gnames.len() {
                if gnames.get(qi) == gname {
                    gv = gvals.get(qi)
                }
                qi = qi + 1
            }
            sp = ev_push(stack, sp, gv)
        }
        OpCode.StoreGlobal -> {
            // W2:弹值覆盖/插入(名字键)
            var gname2 = c.pool.get(ins.n)
            var gval2 = stack.get(sp - 1)
            sp = sp - 1
            // 先定位后单次写(名字键唯一;循环内不移动——a2r 借用检查友好)
            var gpos = -1
            var qi2 = 0
            while qi2 < gnames.len() {
                if gnames.get(qi2) == gname2 {
                    gpos = qi2
                    qi2 = gnames.len()
                }
                qi2 = qi2 + 1
            }
            if gpos >= 0 {
                gvals.set(gpos, gval2)
            } else {
                gnames.push(gname2)
                gvals.push(gval2)
            }
        }
        OpCode.PushBool -> {
            // 布尔以 1/0 承载:与宿主 print(bool)→"1"/"0" 的可观察行为一致
            if ins.s == "true" {
                sp = ev_push(stack, sp, ev_vi(1))
            } else {
                sp = ev_push(stack, sp, ev_vi(0))
            }
        }
        OpCode.PushNil -> {
            sp = ev_push(stack, sp, ev_vi(0))
        }
        OpCode.LoadStr -> {
            // D25-① 规避:原生调用(get)不得内联作枚举构造参数,先提升
            var sv = c.pool.get(ins.n)
            sp = ev_push(stack, sp, ev_vs(sv))
        }
        OpCode.LoadLoc0 -> {
            var v0 = stack.get(bp + 1)
            sp = ev_push(stack, sp, v0)
        }
        OpCode.LoadLoc1 -> {
            var v1 = stack.get(bp + 2)
            sp = ev_push(stack, sp, v1)
        }
        OpCode.LoadLoc2 -> {
            var v2 = stack.get(bp + 3)
            sp = ev_push(stack, sp, v2)
        }
        OpCode.LoadLocal -> {
            if ins.n >= 128 {
                // 参数:bp - n_args + rel - 1(engine.rs 7304 同式)
                var rel = ins.n - 128
                var slot = bp - cur_args + rel - 1
                var va = stack.get(slot)
                sp = ev_push(stack, sp, va)
            } else {
                var vb = stack.get(bp + 1 + ins.n)
                sp = ev_push(stack, sp, vb)
            }
        }
        OpCode.StoreLoc0 -> {
            sp = sp - 1
            stack.set(bp + 1, stack.get(sp))
        }
        OpCode.StoreLoc1 -> {
            sp = sp - 1
            stack.set(bp + 2, stack.get(sp))
        }
        OpCode.StoreLocal -> {
            sp = sp - 1
            if ins.n >= 128 {
                var rel2 = ins.n - 128
                stack.set(bp - cur_args + rel2 - 1, stack.get(sp))
            } else {
                stack.set(bp + 1 + ins.n, stack.get(sp))
            }
        }
        OpCode.Dup -> {
            var vd = stack.get(sp - 1)
            sp = ev_push(stack, sp, vd)
        }
        OpCode.Pop -> {
            sp = sp - 1
        }
        OpCode.Call -> {
            var fe = c.fns.get(ins.n)
            args_stack.push(cur_args)
            args_depth = args_depth + 1
            sp = ev_push(stack, sp, ev_vi(ip))
            sp = ev_push(stack, sp, ev_vi(bp))
            bp = sp - 1
            ip = fe.ins
        }
        OpCode.Ret -> {
            var result = stack.get(sp - 1)
            sp = sp - 1
            var old_bp = ev_int(stack.get(bp))
            var ret_ip = ev_int(stack.get(bp - 1))
            var n_args = ins.n
            var new_sp = bp - n_args
            stack.set(new_sp - 1, result)
            sp = new_sp
            if old_bp == 0 && bp == 1 {
                running = false
            } else {
                bp = old_bp
                ip = ret_ip
                if args_depth > 0 {
                    args_depth = args_depth - 1
                    cur_args = args_stack.get(args_depth)
                }
            }
        }
        OpCode.CallNat -> {
            if ins.n == 112 {
                // W2:nat#112 = auto.iterator.next——镜像宿主可观察行为:
                // 裸 List 句柄非迭代器对象,shim 对其零迭代(立即 -1;
                // b38 实证:for w in mk() 宿主零输出;宿主 values()/keys()
                // 特例即为此而生——超 W2 范围不镜像)
                var itv = stack.get(sp - 1)
                sp = sp - 1
                var next_v = ev_vi(-1)
                sp = ev_push(stack, sp, next_v)
            } else {
            // nat#10 = print:弹 1 参入输出
            if out != "" {
                out = out + "\n"
            }
            out = out + ev_str(stack.get(sp - 1))
            sp = sp - 1
            sp = ev_push(stack, sp, ev_vi(0))
        }
            }
        OpCode.Add | OpCode.Sub | OpCode.Mul | OpCode.Div | OpCode.Mod -> {
            var b = ev_dec(ev_int(stack.get(sp - 1)))
            var a = ev_dec(ev_int(stack.get(sp - 2)))
            sp = sp - 1
            var r = 0
            if op == OpCode.Add {
                r = a + b
            } else if op == OpCode.Sub {
                r = a - b
            } else if op == OpCode.Mul {
                r = a * b
            } else if op == OpCode.Div {
                r = a / b
            } else {
                r = a % b
            }
            stack.set(sp - 1, ev_vi(ev_enc(r)))
        }
        OpCode.StrCat -> {
            var b2 = stack.get(sp - 1)
            var a2 = stack.get(sp - 2)
            sp = sp - 1
            // W2:STR_CAT 恒字符串拼接(镜像宿主——操作数按显示形态字符串化:
            // s[i]+s[j] 两码点 int 拼成 "6667",非数值加;b39 实证)
            stack.set(sp - 1, ev_vs(ev_str(a2) + ev_str(b2)))
        }
        OpCode.Eq | OpCode.Ne | OpCode.Lt | OpCode.Gt | OpCode.Le | OpCode.Ge -> {
            var bv = stack.get(sp - 1)
            var av = stack.get(sp - 2)
            sp = sp - 1
            var cr = ev_cmp(av, bv)
            var r2 = 0
            if op == OpCode.Eq {
                if cr == 0 {
                    r2 = 1
                }
            } else if op == OpCode.Ne {
                if cr != 0 {
                    r2 = 1
                }
            } else if op == OpCode.Lt {
                if cr == -1 {
                    r2 = 1
                }
            } else if op == OpCode.Gt {
                if cr == 1 {
                    r2 = 1
                }
            } else if op == OpCode.Le {
                if cr == 0 || cr == -1 {
                    r2 = 1
                }
            } else {
                if cr == 0 || cr == 1 {
                    r2 = 1
                }
            }
            stack.set(sp - 1, ev_vi(r2))
        }
        OpCode.And | OpCode.Or -> {
            var b3 = stack.get(sp - 1)
            var a3 = stack.get(sp - 2)
            sp = sp - 1
            var r3 = 0
            if op == OpCode.And {
                if ev_truthy(a3) && ev_truthy(b3) {
                    r3 = 1
                }
            } else {
                if ev_truthy(a3) || ev_truthy(b3) {
                    r3 = 1
                }
            }
            stack.set(sp - 1, ev_vi(r3))
        }
        OpCode.Not -> {
            var v4 = stack.get(sp - 1)
            if ev_truthy(v4) {
                stack.set(sp - 1, ev_vi(0))
            } else {
                stack.set(sp - 1, ev_vi(1))
            }
        }
        OpCode.Neg -> {
            var v10 = ev_dec(ev_int(stack.get(sp - 1)))
            stack.set(sp - 1, ev_vi(ev_enc(-v10)))
        }
        OpCode.CreateArr -> {
            // 元素已按序压栈;自下而上读入新 List,入 arena 后以索引
            // 为载体(索引即引用,镜像宿主堆 id)
            var n6 = ins.n
            var arr6 List<Val> = List.new()
            var i6 = 0
            while i6 < n6 {
                arr6.push(stack.get(sp - n6 + i6))
                i6 = i6 + 1
            }
            sp = sp - n6
            arena.push(arr6)
            var ai6 = arena.len() - 1
            sp = ev_push(stack, sp, ev_va(ai6))
        }
        OpCode.GetElem -> {
            // 栈:[..., arr, idx];负下标归一,-1=末位;OOB 推 0
            // (engine.rs 4403);str 接收者取码点(Missing→已含)
            var idx7 = ev_dec(ev_int(stack.get(sp - 1)))
            var arrv Val = stack.get(sp - 2)
            var len7 = ev_len(arena, arrv)
            var j7 = idx7
            if j7 < 0 {
                j7 = len7 + j7
            }
            var val7 = ev_vi(0)
            if j7 >= 0 && j7 < len7 {
                is arrv {
                    Val.VArr(ai7) -> {
                        var l7 = ev_arr_of(arena, arrv)
                        val7 = l7.get(j7)
                    }
                    Val.VStr(sv7) -> {
                        // D25-① 规避:char_at 原生调用先提升
                        var cv = sv7.char_at(j7)
                        val7 = ev_vi(cv)
                    }
                    else -> {
                    }
                }
            }
            sp = sp - 2
            sp = ev_push(stack, sp, val7)
        }
        OpCode.SetElem -> {
            // 栈:[..., value, arr, idx](value 展栈底,Rust quick-fix
            // 栈序);写通道 = ev_arr_write + 写回数组槽位(VM 引用
            // 语义下写回同一引用,无操作;a2r 值语义写回修改副本)
            var idx8 = ev_dec(ev_int(stack.get(sp - 1)))
            var arr8 = stack.get(sp - 2)
            var val8 = stack.get(sp - 3)
            is arr8 {
                Val.VArr(ai8) -> {
                    ev_arr_write(arena, ai8, idx8, val8)
                }
                else -> {
                }
            }
            sp = sp - 3
        }
        OpCode.ArrLen -> {
            // 动态分派:List→元素数,str→长度(镜像 ARRAY_LEN 两分支)
            var v9 = stack.get(sp - 1)
            var l9 = ev_len(arena, v9)
            sp = sp - 1
            sp = ev_push(stack, sp, ev_vi(l9))
        }
        else -> {
            return "ENGINE-ERROR:unknown op " + op_name(op)
        }
        }
    }
    return out
}

// L3(Plan 511):D1——下标复合赋值与宿主同文本拒绝(错误文本以宿主为规范)
#[test]
fn t_d1_index_compound_reject() {
    assert_eq(ev_run("fn main() {\n    let a = [1, 2]\n    a[0] += 5\n}"), "CODEGEN-ERROR:Compound assignment requires a variable on left side")
}

#[test]
fn t_d1_field_compound_reject() {
    assert_eq(ev_run("type P {\n    x int\n}\n\nfn main() {\n    let p = P { x: 1 }\n    p.x += 5\n}"), "CODEGEN-ERROR:Compound assignment requires a variable on left side")
}

// L3(Plan 511):引擎微行为单测——ev_run 输出形态/全局缺省/迭代器零迭代
#[test]
fn t_ev_run_no_trailing_newline() {
    assert_eq(ev_run("print(6*7)"), "42")
}

#[test]
fn t_ev_run_multiline_join() {
    assert_eq(ev_run("fn main() {\n    print(1)\n    print(2)\n}"), "1\n2")
}

#[test]
fn t_global_default_zero() {
    assert_eq(ev_run("var g int = 9\n\nfn main() {\n    print(g)\n}"), "9")
}

#[test]
fn t_iter_zero_on_raw_array() {
    assert_eq(ev_run("fn mk() {\n    return [1, 2]\n}\n\nfn main() {\n    var n int = 0\n    for w in mk() {\n        n = n + 1\n    }\n    print(n)\n}"), "0")
}

// L3(Plan 511):模块解析微行为——D2 合法环/D1 错误文本(路径相对仓库根,
