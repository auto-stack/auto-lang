// Plan 514 W2 g15: .field 简写与 self.x 双形态（读位 + 写位交叉）
type Mixed15 {
    a int
    b int
    fn short_sum() int { return .a + .b }
    fn self_sum() int { return self.a + self.b }
    fn mixed_set(n int) { self.a = n }
    fn short_set(n int) { .b = n }
    static fn new(a int, b int) Mixed15 { return Mixed15(a, b) }
}
fn main() {
    let m = Mixed15.new(1, 2)
    print(m.short_sum())
    print(m.self_sum())
    var n = Mixed15.new(10, 20)
    n.mixed_set(100)
    n.short_set(200)
    print(n.short_sum())
}
