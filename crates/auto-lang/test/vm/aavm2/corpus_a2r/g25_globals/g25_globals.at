var count int = 100

fn bump(n int) int {
    count = count + n
    return count
}

var g int = 10

fn set_via_let() int {
    let g = 5
    return g
}

fn main() {
    print(bump(5))
    print(count)
    count = count * 2
    print(count)
    print(set_via_let())
    print(g)
    g = g + 1
    print(g)
}
