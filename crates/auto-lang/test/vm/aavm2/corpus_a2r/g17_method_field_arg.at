// Plan 514 W3-15: 方法实参位的 str 字段读取(str 局部/List.get 元素字段/
// str 返回调用三形态)——方法环实参强转对拍
type Holder17 {
    name str
    fn show(text str) str { return text }
    static fn new(name str) Holder17 { return Holder17(name) }
}
fn main() {
    var h = Holder17.new("lib")
    var r1 = h.show(h.name)
    var local = "x"
    var r2 = h.show(local)
    var list = List.new()
    list.push(Holder17.new("y"))
    var d2 = list.get(0)
    var r3 = h.show(d2.name)
    print(r1 + r2 + r3)
}
