// Plan 525 W2 b44:接收者简写字段写(.value = .value + 1)——宿主
// dot_item 解析 .field→Dot(self,field) 的赋值形态
type Counter {
    value int
    fn bump() {
        .value = .value + 1
    }
    fn get() int {
        return .value
    }
}

fn main() {
    var c = Counter { value: 40 }
    c.bump()
    c.bump()
    print(c.get())
}
