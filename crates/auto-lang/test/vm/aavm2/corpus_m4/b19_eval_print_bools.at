// Plan 474 待澄清#3 追记：同 b13/b14——aavm bool 整型承载与宿主 true/false
// 显示形态分歧（值模型级 parity 债，见 KNOWN-DEBT-AND-RISKS）。
// 改写为「双 bool 求值 + 分支」保语义覆盖，输出类型稳定。
if true {
    if false {
        print("unreachable")
    } else {
        print("both-evaluated")
    }
}
