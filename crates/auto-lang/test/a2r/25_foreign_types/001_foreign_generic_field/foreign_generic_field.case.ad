    pub events: i64,
}

#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct TermSession {
    pub term: FakeTerm<ChannelListener>,
    pub fallback: Box<ChannelListener>,
}

fn main() {
    let boxed = Box::new(ChannelListener { events: 2 });
    let spare = Box::new(ChannelListener { events: 2 });
    let session = TermSession { term: FakeTerm::new(boxed), fallback: spare };
