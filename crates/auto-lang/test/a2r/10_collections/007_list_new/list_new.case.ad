// Auto-generated by a2r transpiler

use std::process::{exit};
#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Buffer {
    pub items: Vec<i64>,
}

fn main() {
    let mut b = Buffer { items: Vec::new() };
    b.items.push(42);
    let mut bare = Vec::new();
    bare.push(7);
    let n = (b.items.len() as i64);
}
