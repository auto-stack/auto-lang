### Auto
path: "map_literal.at"
```auto
// Map literal initializers with declared Map types emit HashMap::from
// (Plan 415-A / 242 #2): str keys/values wrap in String::from; int keys and
// non-literal values pass through; `var` keeps `let mut`.

fn main() {
    var counts Map<str, int> = { "a": 1, "b": 2 }
    counts.insert("c", 3)
    let labels Map<int, str> = { 1: "one", 2: "two" }
    let name str = "k"
    let dyn_key Map<str, int> = { "seed": counts.len() }
    print(counts.len() + labels.len() + dyn_key.len())
}
```

### Rust
check-id: "rust"

#### map_literal.rs
```rust
// Auto-generated by a2r transpiler

fn main() {
    let mut counts: std::collections::HashMap<String, i64> = std::collections::HashMap::from([(String::from("a"), 1), (String::from("b"), 2)]);
    counts.insert("c".to_string(), 3);
    let labels: std::collections::HashMap<i64, String> = std::collections::HashMap::from([(1, String::from("one")), (2, String::from("two"))]);
    let name: String = "k".to_string();
    let dyn_key: std::collections::HashMap<String, i64> = std::collections::HashMap::from([(String::from("seed"), (counts.len() as i64))]);
    println!("{:?}", (counts.len() as i64) + (labels.len() as i64) + (dyn_key.len() as i64));
}
```
