pub struct InlineSpan {
    pub text: String,
    pub marks: Vec<Mark>,
    pub attrs: Vec<Attr>,
}

pub fn span(text: &str) -> InlineSpan {
    return InlineSpan { text: text.to_string(), marks: vec![], attrs: vec![] };
}

