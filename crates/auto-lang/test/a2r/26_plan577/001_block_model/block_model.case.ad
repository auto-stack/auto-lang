    return InlineSpan { text: text.to_string(), marks: marks, attrs: attrs };
}

pub fn spansText(spans: Vec<InlineSpan>) -> String {
    let mut t: String = "".to_string();
    for s in &spans {
        t = format!("{}{}", t, s.text);
    }
    return t;
}

pub fn dupSpans(spans: Vec<InlineSpan>) -> Vec<InlineSpan> {
    let mut out: Vec<InlineSpan> = vec![];
    for s in &spans {
        out.push(s.clone().clone());
    }
    return out;
}

pub fn spansInsert(spans: Vec<InlineSpan>, offset: i64, text: &str) -> Vec<InlineSpan> {
    let mut out: Vec<InlineSpan> = vec![];
    let mut pos: i64 = 0;
    let mut done: bool = false;
    for s in &spans {
        if done {
            out.push(s.clone().clone());
        } else {
            let sLen: i64 = (s.text.len() as i64);
            if offset <= pos + sLen {
                let at: i64 = offset - pos;
                let nt: String = format!("{}{}", format!("{}{}", s.text[0..(at) as usize].to_string(), text), s.text[(at) as usize..].to_string());
                out.push(InlineSpan { text: nt.to_string(), marks: s.marks.clone(), attrs: s.attrs.clone() });
                done = true;
            } else {
                out.push(s.clone().clone());
            }
            pos = pos + sLen;
        }

    }
    if !(done) {
        out.push(span(text));
    }
    return out;
}

pub fn spansDelete(spans: Vec<InlineSpan>, lo: i64, hi: i64) -> Vec<InlineSpan> {
    let mut out: Vec<InlineSpan> = vec![];
    let mut pos: i64 = 0;
    for s in &spans {
        let sLen: i64 = (s.text.len() as i64);
        let sEnd: i64 = pos + sLen;
        let mut overlapped: bool = true;
        if sEnd <= lo {
            overlapped = false;
        }
        if pos >= hi {
            overlapped = false;
        }
        if overlapped {
            let mut nt: String = "".to_string();
            if lo > pos {
                nt = s.text[0..(lo - pos) as usize].to_string();
            }            if hi < sEnd {
                nt = format!("{}{}", nt, s.text[(hi - pos) as usize..].to_string());
            }            if (nt.chars().count() as i64) > 0 {
                out.push(InlineSpan { text: nt.to_string(), marks: s.marks.clone(), attrs: s.attrs.clone() });
            }        } else {
            out.push(s.clone().clone());
        }

        pos = sEnd;
    }
    return out;
}

#[derive(Clone, Debug, PartialEq)]
pub struct SpanSplit {
    pub before: Vec<InlineSpan>,
    pub after: Vec<InlineSpan>,
}

pub fn spansSplitAt(spans: Vec<InlineSpan>, offset: i64) -> SpanSplit {
    let mut before: Vec<InlineSpan> = vec![];
    let mut after: Vec<InlineSpan> = vec![];
    let mut pos: i64 = 0;
    let mut done: bool = false;
    for s in &spans {
        if done {
            after.push(s.clone().clone());
        } else {
            let sLen: i64 = (s.text.len() as i64);
            let sEnd: i64 = pos + sLen;
            if offset <= pos {
                after.push(s.clone().clone());
                done = true;
            } else {
                if offset >= sEnd {
                    before.push(s.clone().clone());
                } else {
                    let lt = s.text[0..(offset - pos) as usize].to_string();
                    let rt = s.text[(offset - pos) as usize..].to_string();
                    if (lt.chars().count() as i64) > 0 {
                        before.push(InlineSpan { text: lt.to_string(), marks: s.marks.clone(), attrs: s.attrs.clone() });
                    }                    if (rt.chars().count() as i64) > 0 {
                        after.push(InlineSpan { text: rt.to_string(), marks: s.marks.clone(), attrs: s.attrs.clone() });
                    }                    done = true;
                }
            }
            pos = sEnd;
        }

    }
    return SpanSplit { before: before, after: after };
}

