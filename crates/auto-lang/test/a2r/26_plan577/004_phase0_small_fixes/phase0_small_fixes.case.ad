// Auto-generated by a2r transpiler

#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Holder {
    pub items: Vec<i64>,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]
enum Kind {
    Alpha = 0,
    Beta = 1,
}

impl std::fmt::Display for Kind {
    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
        match self {
            Kind::Alpha => write!(f, "Alpha"),
            Kind::Beta => write!(f, "Beta"),
        }
    }
}
impl Kind {
    pub fn from_id(id: &str) -> Self {
        match id {
            "Alpha" | "alpha" => Kind::Alpha,
            "Beta" | "beta" => Kind::Beta,
            _ => Kind::Alpha
        }
    }
}

fn pick(kind: Kind, m: std::collections::HashMap<Kind, i64>) -> i64 {

    if m.contains_key(&kind) {
        return m[&kind].clone();
    }
    return -1;
}

fn total(h: Holder) -> i64 {

    return (h.items.len() as i64) + 1;
}

fn esc() -> i64 {

    let r#final: i64 = 7;
    return r#final;
}

fn main() {

    let mut empty: std::collections::HashMap<String, i64> = std::collections::HashMap::new();
    println!("{}", format!("{:?}", (empty.len() as i64)));

    let mut m: std::collections::HashMap<Kind, i64> = std::collections::HashMap::new();
    m.insert(Kind::Alpha, 1);
    println!("{}", format!("{:?}", pick(Kind::Alpha.clone(), m.clone())));
    println!("{}", format!("{:?}", pick(Kind::Beta.clone(), m.clone())));

    let h = Holder { items: vec![1, 2, 3] };
    println!("{}", format!("{:?}", total(h.clone())));
    println!("{}", format!("{:?}", esc()));
}
```
