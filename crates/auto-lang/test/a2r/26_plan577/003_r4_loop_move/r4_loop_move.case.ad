// Auto-generated by a2r transpiler

fn consume(xs: Vec<i64>) -> i64 {
    let mut total: i64 = 0;
    for x in &xs {
        total = total + x;
    }
    return total;
}

fn sumGroups(groups: Vec<Vec<i64>>) -> i64 {
    let mut acc: i64 = 0;
    let mut flat: Vec<i64> = vec![1, 2, 3];
    for g in &groups {
        
        acc = acc + consume(flat.clone());
        
        acc = acc + consume(g.clone());
    }
    return acc;
}

fn main() {
    let mut groups: Vec<Vec<i64>> = vec![vec![10], vec![20]];
    println!("{}", format!("{:?}", sumGroups(groups.clone())));
}
```
