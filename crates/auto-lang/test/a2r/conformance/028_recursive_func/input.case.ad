// Conformance 028: Recursive function (fibonacci)
fn fib(n int) int {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn main() {
    print(fib(0))
    print(fib(1))
    print(fib(5))
    print(fib(10))
}
```

