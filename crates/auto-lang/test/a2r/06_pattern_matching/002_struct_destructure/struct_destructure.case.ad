```auto
// Plan 165: Struct destructuring in is match arms

type Point {
    x int
    y int
}

enum Shape {
    Circle int
    Rect Point
    None
}

fn main() {
    let p = Point(x: 3, y: 4)

    // Plain struct destructuring
    is p {
        Point { x, y } -> print(x)
    }

    // Enum variant with struct destructuring
    let s = Shape.Rect(p)
    is s {
        Shape.Circle(r) -> print(r)
        Shape.Rect(pt) -> {
            is pt {
                Point { x, y } -> print(x)
            }
        }
        Shape.None -> print("none")
    }
}
```

### Rust
check-id: "rust"

#### struct_destructure.rs
```rust
// Auto-generated by a2r transpiler

#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Point {
    pub x: i64,
    pub y: i64,
}

#[derive(Clone, Debug, PartialEq)]
enum Shape {
    Circle(i64),
    Rect(Point),
    None,
}


fn main() {
    let p = Point { x: 3, y: 4 };


    match p {
        Point { x, y } => println!("{}", x),
    };


    let s = Shape::Rect(p);
    match s {
        Shape::Circle(r) => println!("{}", r),
        Shape::Rect(pt) => {
            match pt {
                Point { x, y } => println!("{}", x),
            };
        },
        Shape::None => println!("none"),
    };
}
```
