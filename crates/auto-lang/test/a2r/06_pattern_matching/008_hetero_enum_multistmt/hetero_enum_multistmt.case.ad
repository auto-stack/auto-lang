### Auto
path: "hetero_enum_multistmt.at"
```auto
enum Message {
    Quit
    Move int
    Write str
}

fn handle(msg Message) int {
    is msg {
        Message.Quit -> 0
        Message.Move(dist) -> {
            print("Moving:")
            print(dist)
            return dist
        }
        Message.Write(text) -> {
            print(text)
            return text.len()
        }
    }
}

fn main() {
    let m1 = Message.Move(10)
    let r1 = handle(m1)
    print(r1)

    let m2 = Message.Write("hello")
    let r2 = handle(m2)
    print(r2)
}
```

### Rust
check-id: "rust"

#### hetero_enum_multistmt.rs
```rust
// Auto-generated by a2r transpiler

#[derive(Clone, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]
enum Message {
    Quit,
    Move(i64),
    Write(String),
}


fn handle(msg: Message) -> i64 {
    match msg {
        Message::Quit => 0,
        Message::Move(dist) => {
            println!("Moving:");
            println!("{}", dist);
            return dist;
        },
        Message::Write(text) => {
            println!("{}", text);
            return (text.len() as i64);
        },
    }
}

fn main() {
    let m1 = Message::Move(10);
    let r1 = handle(m1.clone());
    println!("{}", r1);

    let m2 = Message::Write("hello".to_string());
    let r2 = handle(m2.clone());
    println!("{}", r2);
}
```
