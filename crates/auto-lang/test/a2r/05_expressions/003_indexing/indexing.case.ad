// Auto-generated by a2r transpiler

fn main() {
    let arr: Vec<i64> = vec![10, 20, 30, 40, 50];
    let first: i64 = arr[0].clone();
    let third: i64 = arr[2].clone();
    let last: i64 = arr[4].clone();

    println!("First: {}", first);
    println!("Third: {}", third);
    println!("Last: {}", last);

    let matrix: Vec<Vec<i64>> = vec![vec![1, 2], vec![3, 4]];
    let val: i64 = matrix[0].clone()[1].clone();
    println!("Matrix value: {}", val);
}
