#### comprehensive.rs
```rust
// Auto-generated by a2r transpiler

#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Math {
    pub value: i64,
}

impl Math {
    fn square(&self, x: i64) -> i64 {
        x * x
    }
}

fn main() {
    let m = Math { value: 0 };
    let sq = m.square(5);

    if sq > 20 {
        println!("Square is large: {}", sq);
    } else {
        println!("Square is small: {}", sq);
    }


    match sq {
        25 => println!("Square is 25"),
        _ => println!("Square is not 25"),
    };

    let arr: Vec<i64> = vec![1, 2, 3];
    println!("Array: {:?}", arr);
}
```
