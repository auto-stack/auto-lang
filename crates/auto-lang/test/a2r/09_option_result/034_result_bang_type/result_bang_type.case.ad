// Auto-generated by a2r transpiler

fn safe_divide(a: i64, b: i64) -> Result<i64, Box<dyn std::error::Error>> {
    if b == 0 {
        return Err("division by zero".into());
    }
    Ok(a / b)
}

fn chain(a: i64) -> Result<i64, Box<dyn std::error::Error>> {
    let x = safe_divide(a, 2)?;
    Ok(x + 1)
}

fn main() {
    let r1 = safe_divide(10, 2);
    let r2 = chain(10);
}
```
