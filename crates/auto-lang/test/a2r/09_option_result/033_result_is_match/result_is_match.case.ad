// Auto-generated by a2r transpiler

fn process(res: Result<i64, Box<dyn std::error::Error>>) -> i64 {
    match res {
        Ok(v) => v,
        Err(e) => -1,
    }
}

fn main() {
    let r1: Result<i64, Box<dyn std::error::Error>> = Ok(42);
    let r2 = Err("bad value".into());
    let a = process(r1.clone());
    let b = process(r2);
}
```
