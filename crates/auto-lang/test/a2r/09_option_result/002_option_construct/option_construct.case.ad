// Auto-generated by a2r transpiler

fn maybe_value(x: i64) -> Option<i64> {
    if x > 0 {
        return Some(x);
    }
    return None;
}

fn divide(a: i64, b: i64) -> Result<i64, Box<dyn std::error::Error>> {
    if b == 0 {
        return Err("division by zero".into());
    }
    return Ok(a / b);
}

fn main() {
    let a: Option<i64> = Some(42);
    let b: Option<i64> = None;
    let c: Result<i64, Box<dyn std::error::Error>> = Ok(100);
    let d = Err("something went wrong".into());

    let result1 = maybe_value(10);
    let result2 = divide(10, 2);
}
```
