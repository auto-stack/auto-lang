#[allow(unused_imports)]
use std::rc::Rc;
#[allow(unused_imports)]
use std::cell::{RefCell, Cell};
fn main() {
    let a = std::rc::Rc::new(std::cell::RefCell::new(1));
    let b = std::rc::Rc::new(std::cell::RefCell::new(2));
    let mut f = { let a = std::rc::Rc::clone(&a); let b = std::rc::Rc::clone(&b); move |n: i64| { { let __a2r_wc = *a.borrow() + n; *a.borrow_mut() = __a2r_wc; }; { let __a2r_wc = *b.borrow() + *a.borrow(); *b.borrow_mut() = __a2r_wc; }; return *b.borrow(); } };
    println!("{}", f(20) + f(0));
}
