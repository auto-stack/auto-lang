// Auto-generated by a2r transpiler

fn check<T: Clone + Debug>(x: T) -> i64 {
    return 42;
}

fn dup<T: Clone + Debug>(x: T) -> i64 {
    return 42;
}

#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Pair<K: Debug> {
    pub key: K,
}

trait Greeter {
    fn greet(&self) -> String;
}


fn say<T: Greeter>(mut g: T) -> String {
    return g.greet();
}
```
