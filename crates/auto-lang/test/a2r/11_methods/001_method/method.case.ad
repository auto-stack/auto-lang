### Rust
check-id: "rust"

#### method.rs
```rust
// Auto-generated by a2r transpiler

#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Point {
    pub x: i64,
    pub y: i64,
}

impl Point {
    fn modulus(&self) -> i64 {
        self.x * self.x + self.y * self.y
    }
}

fn main() {
    let p = Point { x: 3, y: 4 };
    let m: i64 = p.modulus();
    println!("Modulus: {}", m);
}
```
