entry-mode: "program"

### Auto
path: "fstring.at"
```auto
fn main() {
    let name = "AutoLang"
    let age = 1

    // Simple interpolation
    let greeting = f"Hello, $name"
    print(greeting)

    // Multiple variables
    let info = f"Name: $name, Age: $age"
    print(info)

    // With expressions
    let x = 10
    let y = 20
    let result = f"Result: ${x + y}"
    print(result)

    // Mixed literals and variables
    let msg = f"The value is $x and ${y * 2}"
    print(msg)

    // Direct print with f-string
    print(f"Direct: $name is $age years old")

    // Complex expression in f-string
    let a = 5
    let b = 3
    print(f"Sum: ${a + b}, Product: ${a * b}")
}
```

### Rust
check-id: "rust"

#### fstring.rs
```rust
// Auto-generated by a2r transpiler

fn main() {
    let name: String = "AutoLang".to_string();
    let age: i64 = 1;


    let greeting: String = format!("Hello, {}", name);
    println!("{}", greeting);


    let info: String = format!("Name: {}, Age: {}", name, age);
    println!("{}", info);


    let x: i64 = 10;
    let y: i64 = 20;
    let result: String = format!("Result: {}", x + y);
    println!("{}", result);


    let msg: String = format!("The value is {} and {}", x, y * 2);
    println!("{}", msg);


    println!("Direct: {} is {} years old", name, age);


    let a: i64 = 5;
    let b: i64 = 3;
    println!("Sum: {}, Product: {}", a + b, a * b);
}
```
