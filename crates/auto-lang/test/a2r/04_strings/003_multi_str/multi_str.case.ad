// Auto-generated by a2r transpiler

fn main() {

    let msg: String = "hello\nworld".to_string();
    println!("{}", msg);


    let quote: String = "she said \"hello\"\nand \"goodbye\"".to_string();
    println!("{}", quote);


    let simple: String = "just a string".to_string();
    println!("{}", simple);


    let escaped: String = "line1\ttab\nline2".to_string();
    println!("{}", escaped);
}
