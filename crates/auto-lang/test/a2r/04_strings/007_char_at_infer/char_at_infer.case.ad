```auto
// char_at results infer as int without an explicit annotation (Plan 417-E1 /
// DIV-A2R-CHAR-AT-1): the code point + int literal must emit integer add,
// not string concatenation.

fn shift(ch str) int {
    var c = ch.char_at(0)
    if c >= 65 && c <= 90 { c = c + 32 }
    return c
}

fn main() {
    let a = "Q".char_at(0)
    let shifted = shift("Q")
    print(a + shifted)
}
```

### Rust
check-id: "rust"

#### char_at_infer.rs
```rust
// Auto-generated by a2r transpiler

fn shift(ch: &str) -> i64 {
    let mut c = ch.chars().nth((0) as usize).unwrap_or('\0') as i64;
    if c >= 65 && c <= 90 {
        c = c + 32;
    }
    return c;
}

fn main() {
    let a = "Q".chars().nth((0) as usize).unwrap_or('\0') as i64;
    let shifted = shift("Q");
    println!("{}", a + shifted);
}
```
