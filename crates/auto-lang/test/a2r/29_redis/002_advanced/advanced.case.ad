// Auto-generated by a2r transpiler

// a2r Standard Library (from crate)
#[allow(unused_imports)]
use a2r_std;
use a2r_std::*;

use a2r_std::redis;
fn main() {
    let addr: String = "redis://127.0.0.1:6379/1".to_string();
    let mut r: a2r_std::redis::RedisClient = a2r_std::redis::open(&addr.as_str());
    let err: String = a2r_std::redis::last_error();
    println!("{}", err);
}
