### Auto
path: "basic.at"
```auto
// Plan 415-B2: redis stdlib module basic path — open, ping, set, get, del, exists.
// var binding: redis connection ops take &mut self (var → let mut).
use redis

fn main() {
    var r RedisClient = redis.open("redis://127.0.0.1:6379")
    let alive bool = r.ping()
    r.set("greeting", "hello")
    let v str = r.get("greeting")
    print(v)
    let n int = r.del("greeting")
    print(n)
    let has bool = r.exists("greeting")
    print(has)
}
```

### Rust
check-id: "rust"

#### basic.rs
```rust
// Auto-generated by a2r transpiler

// a2r Standard Library (from crate)
#[allow(unused_imports)]
use a2r_std;
use a2r_std::*;

use a2r_std::redis;
fn main() {
    let mut r: a2r_std::redis::RedisClient = a2r_std::redis::open("redis://127.0.0.1:6379");
    let alive: bool = r.ping();
    r.set("greeting", "hello");
    let v: String = r.get("greeting");
    println!("{}", v);
    let n: i64 = r.del("greeting");
    println!("{}", n);
    let has: bool = r.exists("greeting");
    println!("{}", has);
}
```
