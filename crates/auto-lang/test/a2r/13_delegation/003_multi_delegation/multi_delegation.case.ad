```auto
spec Calculator {
    fn add(a int, b int) int
    fn multiply(a int, b int) int
}

type MathEngine as Calculator {
    fn add(a int, b int) int {
        a + b
    }

    fn multiply(a int, b int) int {
        a * b
    }
}

type Computer {
    has engine MathEngine for Calculator
}

fn main() {
    let comp = Computer()
    // Now use comp as a Calculator 
    let result1 = comp.add(5, 3)
    let result2 = comp.multiply(4, 7)
    print(result1)
    print(result2)
}
```

