// Auto-generated by a2r transpiler

trait Calculator {
    fn add(&self, a: i64, b: i64) -> i64;
    fn multiply(&self, a: i64, b: i64) -> i64;
}


#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct MathEngine {}

impl Calculator for MathEngine {
    fn add(&self, a: i64, b: i64) -> i64 {
        a + b
    }
    fn multiply(&self, a: i64, b: i64) -> i64 {
        a * b
    }
}

#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Computer {
    pub engine: MathEngine,
}

impl Calculator for Computer {
    fn add(&self, a: i64, b: i64) -> i64 {
        self.engine.add(a, b)
    }
    fn multiply(&self, a: i64, b: i64) -> i64 {
        self.engine.multiply(a, b)
    }
}

fn main() {
    let comp = Computer { engine: MathEngine {} };

    let result1 = comp.add(5, 3);
    let result2 = comp.multiply(4, 7);
    println!("{}", result1);
    println!("{}", result2);
}
```
