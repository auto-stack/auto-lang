### Rust
check-id: "rust"

#### multi_spec.rs
```rust
// Auto-generated by a2r transpiler

trait Engine {
    fn start(&self);
}


trait Weapon {
    fn fire(&self);
}


#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct WarpDrive {}

impl WarpDrive {
    fn start(&self) {
        println!("WarpDrive engaging");
    }
}

#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct LaserCannon {}

impl LaserCannon {
    fn fire(&self) {
        println!("Pew! Pew!");
    }
}

#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Starship {
    pub core: WarpDrive,
    pub weapon: LaserCannon,
}

impl Engine for Starship {
    fn start(&self) {
        self.core.start()
    }
}

impl Weapon for Starship {
    fn fire(&self) {
        self.weapon.fire()
    }
}

fn main() {
    let ship = Starship { core: WarpDrive {}, weapon: LaserCannon {} };
    ship.start();
    ship.fire();
}
```
