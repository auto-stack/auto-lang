// Auto-generated by a2r transpiler

trait Engine {
    fn start(&self);
}


#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct WarpDrive {}

impl WarpDrive {
    fn start(&self) {
        println!("WarpDrive engaging");
    }
}

#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Starship {
    pub core: WarpDrive,
}

impl Engine for Starship {
    fn start(&self) {
        self.core.start()
    }
}

fn main() {
    let ship = Starship { core: WarpDrive {} };
    ship.start();
}
