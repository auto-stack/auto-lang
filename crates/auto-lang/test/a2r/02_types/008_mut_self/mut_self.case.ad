// Auto-generated by a2r transpiler

#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Counter {
    pub count: i64,
}

impl Counter {
    fn new() -> Counter {
        return Counter { count: 0 };
    }
    fn increment(&mut self) {
        self.count = self.count + 1;
    }
    fn get_count(&self) -> i64 {
        return self.count;
    }
}

fn main() {
    let mut c = Counter::new();
    c.increment();
    c.increment();
    println!("{}", c.get_count());
}
```
