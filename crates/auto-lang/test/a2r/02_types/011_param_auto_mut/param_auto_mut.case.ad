```rust
// Auto-generated by a2r transpiler

#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Engine {
    pub n: i64,
}

impl Engine {
    fn new() -> Engine {
        return Engine { n: 0 };
    }
    fn bump(&mut self) {
        self.n = self.n + 1;
    }
}

fn record(mut eng: Engine) {
    eng.bump();
}

fn main() {
    let e = Engine::new();
    record(e.clone());
    println!("{}", e.n);
}
```
