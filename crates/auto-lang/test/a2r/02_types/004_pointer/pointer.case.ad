### Auto
path: "pointer.at"
```auto
fn inc(a *int) {
    a.* += 1
}

fn main() {
    var x = 5;
    print("x = ", x)
    var y *int = x.@
    print("y = ", y.*)
    y.* += 1
    print("now x is", x)

    inc(x.@)
    print("now x is", x)
}
```

### Rust
check-id: "rust"

#### pointer.rs
```rust
// Auto-generated by a2r transpiler

fn inc(a: *mut i64) {
    *a += 1;
}

fn main() {
    let mut x: i64 = 5;
    println!("x =  {}", x);
    let mut y: *mut i64 = x as *mut _;
    println!("y =  {}", *y);
    *y += 1;
    println!("now x is {}", x);

    inc(x as *mut _);
    println!("now x is {}", x);
}
```
