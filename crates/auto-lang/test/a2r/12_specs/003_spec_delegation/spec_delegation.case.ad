#### spec_delegation.rs
```rust
// Auto-generated by a2r transpiler

trait Flyer {
    fn fly(&self);
}


#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Pigeon {}

impl Flyer for Pigeon {
    fn fly(&self) {
        println!("Flap Flap");
    }
}

#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Hawk {}

impl Flyer for Hawk {
    fn fly(&self) {
        println!("Gawk! Gawk!");
    }
}

fn main() {

    let b1 = Pigeon {};
    let b2 = Hawk {};



    let arr: Vec<Box<dyn Flyer>> = vec![Box::new(b1), Box::new(b2)];
    for b in &arr {
        b.fly();
    }
}
```
