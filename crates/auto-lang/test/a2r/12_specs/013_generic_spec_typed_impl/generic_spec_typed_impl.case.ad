```rust
// Auto-generated by a2r transpiler

trait Comparable<T> {
    fn compare(&self, other: T) -> T;
}


#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct ScoreCmp {
    pub val: i64,
}

impl Comparable<i64> for ScoreCmp {
    fn compare(&self, other: i64) -> i64 {
        return self.val - other;
    }
}

fn main() {
    let mut s: ScoreCmp = ScoreCmp { val: 10 };
    println!("{}", s.compare(4));
}
```
