// Auto-generated by a2r transpiler

trait Answer {
    fn base(&self) -> i64;
    fn doubled(&self) -> i64{
        return 42;
    }}


#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Fixed {}

impl Answer for Fixed {
    fn base(&self) -> i64 {
        return 7;
    }
    fn doubled(&self) -> i64 {
        return 42;
    }
}

pub fn main() {
    let mut a = Fixed {};
    println!("{}", a.doubled());
}
