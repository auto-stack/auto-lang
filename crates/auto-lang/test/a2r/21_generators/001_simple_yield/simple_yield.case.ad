#### simple_yield.rs
```rust
// Auto-generated by a2r transpiler

fn counter() -> impl futures::Stream<Item = i64> { async_stream::stream! {{
    yield 1;
    yield 2;
    yield 3
} } }

#[tokio::main]
pub async fn main() {
    let mut sum: i64 = 0;
        let mut __s = counter();
    tokio::pin!(__s);
    while let Some(n) = futures::StreamExt::next(&mut __s).await {
        sum = sum + n;
    }
    println!("{}", sum);
}
```
