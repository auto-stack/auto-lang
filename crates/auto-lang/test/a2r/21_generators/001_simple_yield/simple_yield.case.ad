// Plan 321: Simple yield generator test
fn counter() ~Iter<int> {
    yield 1
    yield 2
    yield 3
}

pub fn main() {
    var sum = 0
    for n in counter() {
        sum = sum + n
    }
    print(sum)
}
```

### Rust
