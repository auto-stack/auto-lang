widget App {
    view {
        center {
            // Plan 481: selectable text —— 标题样式显式化(text-4xl 对齐 h1
            // 默认),正文可选可复制(VM 拖选/双击/Ctrl+C,vue 显式 user-select)。
            text "Hello, World!" {
                style: "text-4xl font-bold text-primary",
                selectable: true
            }
        }
    }
}
