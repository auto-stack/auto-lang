#### for.expected.ts
```ts
function main(): void {
    for (let j = 0; j < 10; j++) {
        console.log(j);
    }
    

    const arr: number[] = [1, 2, 3];
    for (const n of arr) {
        console.log(n);
    }
}

main();
```
