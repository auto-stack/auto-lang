#### nested_if.expected.ts
```ts
function main(): void {
    const x: number = 10;
    if (x > 5) {
        if (x > 8) {
            console.log("large");
        } else {
            console.log("medium");
        }
    } else {
        console.log("small");
    }
}

main();
```
