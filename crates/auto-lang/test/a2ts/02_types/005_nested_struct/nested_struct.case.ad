### Rust
check-id: "a2ts-emit"

#### nested_struct.expected.ts
```ts
export class Inner {
    val: number;

    constructor(val: number) {
        this.val = val;
    }
}

export class Outer {
    inner: Inner;
    name: string;

    constructor(inner: Inner, name: string) {
        this.inner = inner;
        this.name = name;
    }
}

function main(): void {
    const i = new Inner(42);
    const o = new Outer(i, "test");
    console.log(o.inner.val);
}

main();
```
