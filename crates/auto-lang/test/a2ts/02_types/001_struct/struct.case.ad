### Rust
check-id: "a2ts-emit"

#### struct.expected.ts
```ts
export class Point {
    x: number;
    y: number;

    constructor(x: number, y: number) {
        this.x = x;
        this.y = y;
    }
}

export class Circle {
    radius: number;
    border: number;
    center: Point;

    constructor(radius: number, border: number, center: Point) {
        this.radius = radius;
        this.border = border;
        this.center = center;
    }
}

function main(): void {
    let p = new Point(1, 2);
    p.x = 3;
    console.log(`P: ${p.x}, ${p.y}`);
    

    const circle = new Circle(5, 1, new Point(50, 50));
    console.log(`C: ${circle.center.x}, ${circle.center.y}, ${circle.radius}`);
}

main();
```
