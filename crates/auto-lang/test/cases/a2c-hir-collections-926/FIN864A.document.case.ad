static a2x_trap_code a2x_coll_list_i32_reserve(a2x_list_i32* l, size_t want) {
    size_t new_cap, bytes, old_bytes;
    a2x_trap_code t;
    if (l->len + want <= l->cap) { return A2X_TRAP_NONE; }
    new_cap = (l->cap == 0) ? (size_t)(4 > want ? 4 : want) : l->cap;
    while (new_cap < l->len + want) {
