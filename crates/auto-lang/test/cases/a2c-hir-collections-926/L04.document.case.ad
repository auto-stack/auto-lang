static a2x_trap_code a2x_coll_list_rec_Item_reserve(a2x_list_rec_Item* l, size_t want) {
    size_t new_cap, bytes, old_bytes;
    a2x_trap_code t;
    if (l->len + want <= l->cap) { return A2X_TRAP_NONE; }
    new_cap = (l->cap == 0) ? (size_t)(4 > want ? 4 : want) : l->cap;
    while (new_cap < l->len + want) {
        if (new_cap > 65536) { return A2X_TRAP_LIST_INDEX; }
        if (new_cap > (size_t)-1 / 2) { return A2X_TRAP_RESOURCE; }
        new_cap *= 2;
    }
    if (new_cap > 65536) { return A2X_TRAP_LIST_INDEX; }
    t = a2x_coll_charge(2 * (long)(new_cap - l->cap));
    if (t != A2X_TRAP_NONE) { return t; }
    old_bytes = l->cap * sizeof(a2x_rec_Item);
    bytes = new_cap * sizeof(a2x_rec_Item);
    t = a2x_coll_alloc_gate(bytes - old_bytes);
    if (t != A2X_TRAP_NONE) { return t; }
    {
        a2x_rec_Item* p = (a2x_rec_Item*)realloc(l->data, bytes);
        if (p == NULL) { a2x_coll_st_live_backing_bytes -= (long)(bytes - old_bytes); return A2X_TRAP_RESOURCE; }
        l->data = p; l->cap = new_cap;
    }
    return A2X_TRAP_NONE;
}

a2x_trap_code a2x_coll_list_rec_Item_new(a2x_list_rec_Item* out) {
