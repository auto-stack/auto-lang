    size_t bytes = 4 * sizeof(a2x_rec_Item);
    memset(out, 0, sizeof *out);
    t = a2x_coll_charge(2 * 4);
    if (t != A2X_TRAP_NONE) { return t; }
    t = a2x_coll_alloc_gate(bytes);
    if (t != A2X_TRAP_NONE) { return t; }
    out->data = (a2x_rec_Item*)malloc(bytes);
    if (out->data == NULL) { a2x_coll_st_live_backing_bytes -= (long)bytes; return A2X_TRAP_RESOURCE; }
    out->len = 0; out->cap = 4;
    return A2X_TRAP_NONE;
}

int32_t a2x_coll_list_rec_Item_len(const a2x_list_rec_Item* l) { return (int32_t)l->len; }

a2x_trap_code a2x_coll_list_rec_Item_push(a2x_list_rec_Item* l, a2x_rec_Item v) {
    a2x_trap_code t;
    if (l->len + 1 > 65536) { a2x_coll_elem_rec_Item_free(&v); return A2X_TRAP_LIST_INDEX; }
    t = a2x_coll_list_rec_Item_reserve(l, 1);
    if (t != A2X_TRAP_NONE) { a2x_coll_elem_rec_Item_free(&v); return t; }
    t = a2x_coll_charge(2);
    if (t != A2X_TRAP_NONE) { a2x_coll_elem_rec_Item_free(&v); return t; }
    l->data[l->len] = v; l->len++;
    a2x_coll_st_live_nodes++;
    return A2X_TRAP_NONE;
}

a2x_trap_code a2x_coll_list_rec_Item_insert(a2x_list_rec_Item* l, int32_t index, a2x_rec_Item v) {
    a2x_trap_code t;
    size_t idx;
    if (index < 0) { a2x_coll_elem_rec_Item_free(&v); return A2X_TRAP_LIST_INDEX; }
    idx = (size_t)index;
    if (idx > l->len) { a2x_coll_elem_rec_Item_free(&v); return A2X_TRAP_LIST_INDEX; }
    t = a2x_coll_list_rec_Item_reserve(l, 1);
    if (t != A2X_TRAP_NONE) { a2x_coll_elem_rec_Item_free(&v); return t; }
    t = a2x_coll_charge(2);
    if (t != A2X_TRAP_NONE) { a2x_coll_elem_rec_Item_free(&v); return t; }
    if (idx < l->len) { memmove(&l->data[idx + 1], &l->data[idx], (l->len - idx) * sizeof(a2x_rec_Item)); }
    l->data[idx] = v; l->len++;
    a2x_coll_st_live_nodes++;
    return A2X_TRAP_NONE;
}

a2x_trap_code a2x_coll_list_rec_Item_get(const a2x_list_rec_Item* l, int32_t index, a2x_rec_Item* out) {
    size_t idx;
    if (index < 0) { return A2X_TRAP_LIST_INDEX; }
    idx = (size_t)index;
    if (idx >= l->len) { return A2X_TRAP_LIST_INDEX; }
    *out = l->data[idx];
    return A2X_TRAP_NONE;
}

a2x_trap_code a2x_coll_list_rec_Item_view(const a2x_list_rec_Item* l, int32_t index, const a2x_rec_Item** out) {
    size_t idx;
    if (index < 0) { return A2X_TRAP_LIST_INDEX; }
    idx = (size_t)index;
    if (idx >= l->len) { return A2X_TRAP_LIST_INDEX; }
    *out = &l->data[idx];
    return A2X_TRAP_NONE;
}

a2x_trap_code a2x_coll_list_rec_Item_set(a2x_list_rec_Item* l, int32_t index, a2x_rec_Item v) {
    a2x_trap_code t;
    size_t idx;
    if (index < 0) { a2x_coll_elem_rec_Item_free(&v); return A2X_TRAP_LIST_INDEX; }
    idx = (size_t)index;
    if (idx >= l->len) { a2x_coll_elem_rec_Item_free(&v); return A2X_TRAP_LIST_INDEX; }
    t = a2x_coll_charge(2);
    if (t != A2X_TRAP_NONE) { a2x_coll_elem_rec_Item_free(&v); return t; }
    a2x_coll_elem_rec_Item_free(&l->data[idx]); /* old frees at commit */
    l->data[idx] = v;
    return A2X_TRAP_NONE;
}

a2x_trap_code a2x_coll_list_rec_Item_remove(a2x_list_rec_Item* l, int32_t index, a2x_rec_Item* out) {
    size_t idx;
    if (index < 0) { return A2X_TRAP_LIST_INDEX; }
    idx = (size_t)index;
    if (idx >= l->len) { return A2X_TRAP_LIST_INDEX; }
    *out = l->data[idx];
    if (idx + 1 < l->len) { memmove(&l->data[idx], &l->data[idx + 1], (l->len - idx - 1) * sizeof(a2x_rec_Item)); }
    l->len--;
    a2x_coll_st_live_nodes--;
    return A2X_TRAP_NONE;
}

void a2x_coll_list_rec_Item_clear(a2x_list_rec_Item* l) {
    while (l->len > 0) {
        l->len--;
        a2x_coll_elem_rec_Item_free(&l->data[l->len]);
        a2x_coll_st_live_nodes--;
    }
}

void a2x_coll_list_rec_Item_free(a2x_list_rec_Item* l) {
    while (l->len > 0) {
        l->len--;
        a2x_coll_elem_rec_Item_free(&l->data[l->len]);
        a2x_coll_st_live_nodes--;
    }
    if (l->data != NULL) {
        free(l->data);
        a2x_coll_backing_release(l->cap * sizeof(a2x_rec_Item));
        l->data = NULL; l->cap = 0;
    }
}

