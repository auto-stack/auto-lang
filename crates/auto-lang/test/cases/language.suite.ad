# PLAN-1078 — the public feature-organized language corpus selection.
# The canonical author root is crates/auto-lang/test/cases/language/; every
# file here is the ONE active author of its cases (AV / AC / A2R checks share
# the same Auto source). New AVP batches append canonical references only.
```test-suite
suite { schema: "autolang.suite/2", id: "language", include: [
  "language/basics/expressions.case.ad",
  "language/numbers/literals-conversions.case.ad",
  "language/text/interpolation-unicode.case.ad",
  "language/calls/binding-pipeline.case.ad",
  "language/functions/references-closures.case.ad",
  "language/collections/list-places.case.ad",
  "language/types/variants.case.ad",
  "language/patterns/nested-match.case.ad",
  "language/dynamic/objects-null.case.ad",
  "language/modules/imports-globals.case.ad",
  "language/ownership/borrows-moves.case.ad",
  "language/errors/catch-finally.case.ad",
  "language/generators/yield-close.case.ad",
  "language/generics/spec-methods.case.ad",
  "language/generics/list-methods.case.ad",
  "language/generics/spec-dispatch.case.ad",
  "language/generics/record-templates.case.ad",
] }
```
