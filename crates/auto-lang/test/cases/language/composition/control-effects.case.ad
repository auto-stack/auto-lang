### Auto
path: "main.at"

```auto
fn twice(x int) int { return x * 2 }
fn main() int {
 let f = twice
 let xs = [19, 23]
 let state = { title: "ready", total: f(xs[0]) + f(xs[1]) }
 try { if state.title == "ready" && state.total == 84 { return 42 }; return 0 } finally { }
}
```

