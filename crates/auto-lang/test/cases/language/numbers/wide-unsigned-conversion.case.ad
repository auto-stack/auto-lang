tags: ["av-language-parity", "plan-1122", "numbers"]
links: ["PLAN-1122"]
entry-mode: "program"

### Auto
path: "main.at"

```auto
fn number(s str) u64 {
    return s.parse_u64().?(0u64)
}
fn main() int {
    let s = "5000000000"
    let n = number(s)
    print(n.to_str())
    print((number(s) * 2u64).to_str())
    print((number(s) + 5000000000u64).to_str())
    let x u64 = number(s)
    print(x.to_str())
    print((x + 1u64).to_str())
    let big = number("281474976710656")
    print(big.to_str())
    let a = number("140737488355328")
    let b = number("140737488355328")
    print((a + b).to_str())
    print(a == b)
    print(big > a)
    return 0
}
```

