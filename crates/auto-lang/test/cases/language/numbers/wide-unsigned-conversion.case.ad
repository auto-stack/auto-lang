# Wide unsigned decimal conversion on ordinary AV

`parse_u64` produces an Option with a full-width payload. These checks use
independent decimal, stdout, and diagnostic oracles on the public AV source
recipe. The unmodified AutoVM sources remain in the legacy corpus.

## Case: checked-u64
id: "av.parity.1122.checked-u64"
tags: ["av-language-parity", "plan-1122", "numbers"]
links: ["PLAN-1122"]
entry-mode: "program"

### Auto
path: "main.at"

```auto
fn rejects(text str) bool {
    let result = text.parse_u64()
    is result {
        Some(_) -> { return false }
        None -> { return true }
    }
}
fn main() int {
    if "0".parse_u64().?(99u64) != 0u64 { return 1 }
    if "5000000000".parse_u64().?(0u64) != 5000000000u64 { return 2 }
    if "9007199254740993".parse_u64().?(0u64) - 9007199254740992u64 != 1u64 { return 3 }
    let max = "18446744073709551615".parse_u64().?(0u64)
    if max != 18446744073709551615u64 { return 4 }
    let formatted = max.to_str()
    if formatted != "18446744073709551615" { return 5 }
    if formatted.parse_u64().?(0u64) != max { return 6 }
    if formatted.len() != 20 { return 7 }
    if "+00042".parse_u64().?(0u64) != 42u64 { return 8 }
    if "00000000000000000000000000000000000000000000000".parse_u64().?(99u64) != 0u64 { return 9 }
    if !rejects("18446744073709551616") { return 10 }
    if !rejects("184467440737095516150") { return 11 }
    if !rejects("-1") || !rejects("-0") { return 12 }
    if !rejects("") || !rejects("+") { return 13 }
    if !rejects("42x") || !rejects("１２") || !rejects("1_000") { return 14 }
    if !rejects(" 42") || !rejects("42\t") || !rejects("\u{2003}42") { return 15 }
    if !rejects("42\u{0}7") || !rejects("++42") { return 16 }
    if "+18446744073709551615".parse_u64().?(0u64) != max { return 17 }
    if (0u64).to_str() != "0" { return 18 }
    if f"max=${max}" != "max=18446744073709551615" { return 19 }
    return 42
}
```

