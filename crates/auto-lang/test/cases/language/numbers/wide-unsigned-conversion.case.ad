## Case: legacy-local
id: "av.parity.1122.legacy-local"
tags: ["av-language-parity", "plan-1122", "numbers"]
links: ["PLAN-1122"]
entry-mode: "program"

### Auto
path: "main.at"

```auto
fn number(s str) u64 {
    return s.parse_u64().?(0u64)
}
fn main() int {
    let s = "42"
    let n = number(s)
    print(n.to_str())
    print((number(s) + 8u64).to_str())
    print((number(s) - 2u64).to_str())
    print(number("10").to(f64) + 1.5d)
    print(number("10").to(f64) * 2.0d)
    let x u64 = number("100")
    print(x.to_str())
    print((x + 23u64).to_str())
    var y u64 = 0u64
    y = number("7")
    print(y.to_str())
    y = y + number("7")
    print(y.to_str())
    let a = number("100")
    let b = number("45")
    print((a + b).to_str())
    print((a - b).to_str())
    print(a > b)
    let year = number("2024")
    print(f"year: ${year}")
    print(f"next: ${year + 1u64}")
    return 0
}
```

