fn main() int {
    let s = "hello"
    print(s.len())
    let arr = [1, 2, 3]
    print(arr.len())
    print(s.len() + 10)
    var x = 0
    x = x + 1
    print(x)
    print(2 + 3)
    print("abc".find("b").?(-1))
    return 0
}
