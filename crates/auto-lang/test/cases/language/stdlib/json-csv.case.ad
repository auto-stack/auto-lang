## Case: json-encodable-schema
id: "av.parity.1124.json-encodable-schema"
tags: ["av-language-parity", "plan-1124", "stdlib", "json"]
links: ["PLAN-1124"]
entry-mode: "program"

### Auto
path: "main.at"

```auto
type Empty as JsonEncodable {}

type Custom as JsonEncodable {
    x int
    fn json_encode() Str {
        return "{\"custom\":" + .x.to(Str) + "}"
    }
}

type Tag as JsonEncodable {
    name Str
    rank u32
}

type Record as JsonEncodable {
    id i64
    score f64
    ratio f32
    ok bool
    note ?Str
    tags List<Tag>
}

fn main() int {
    if encode(Empty()) != "{}" { return 1 }
    if encode(Custom { x: 7 }) != "{\"custom\":7}" { return 2 }

    var ts = List<Tag>.new()
    ts.push(Tag { name: "a\"b", rank: 9u32 })
    let rec = Record {
        id: -123456i64,
        score: 2.25d,
        ratio: 1.5f32,
        ok: true,
        note: None,
        tags: ts.move
    }
    let raw = encode(rec)
    let doc = parse_strict(raw)
    if doc.get_int("id") != -123456 { return 3 }
    if doc.get_f64("score") != 2.25d { return 4 }
    if doc.get_f64("ratio") != 1.5d { return 5 }
    if !doc.get_bool("ok") { return 6 }
    let note_node = doc.get("note") ?? parse_strict("1")
    if !note_node.is_null() { return 7 }
    let dtags = doc.get("tags") ?? parse_strict("[]")
    if dtags.len() != 1 { return 8 }
    if dtags.at(0).get_str("name") != "a\"b" { return 9 }
    if dtags.at(0).get_int("rank") != 9 { return 10 }
    if encode(doc) != raw { return 11 }
    if !(encode_pretty(rec).contains("\n")) { return 12 }
    return 42
}
```

