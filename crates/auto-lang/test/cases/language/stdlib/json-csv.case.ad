// No library is referenced here: a local, a parameter, a nested function and
// a closure carry library names, and a reserved library name is declared.
fn __json_admit() int {
    return 7
}

fn helper(parse int) int {
    return parse + 1
}

fn main() int {
    let encode = 1
    var minify = fn (x int) int {
        return x + 2
    }
    fn is_valid(v int) int {
        return v
    }
    var total = 0
    if encode != 1 { return 1 }
    total = total + encode
    if minify(1) != 3 { return 2 }
    total = total + minify(1)
    if helper(4) != 5 { return 3 }
    total = total + helper(4)
    if is_valid(9) != 9 { return 4 }
    total = total + is_valid(9)
    if __json_admit() != 7 { return 5 }
    total = total + __json_admit()
    if total != 25 { return 6 }
    return 42
}
```

