## Case: pretty-bytes
id: "av.parity.1124.pretty-bytes"
tags: ["av-language-parity", "plan-1124", "stdlib", "json"]
links: ["PLAN-1124"]
entry-mode: "program"

### Auto
path: "main.at"

```auto
fn main() int {
    let text Str = "{\"b\":2,\"a\":[1,true,{\"c\":[],\"d\":{}}],\"e\":-1.5}"
    let layout Str = "{
  \"b\": 2,
  \"a\": [
    1,
    true,
    {
      \"c\": [],
      \"d\": {}
    }
  ],
  \"e\": -1.5
}"
    if prettify(text) != layout { return 1 }
    if minify(prettify(text)) != text { return 2 }
    let doc = parse_strict(text)
    if doc.prettify() != layout { return 3 }
    let v = parse_strict("[1,2,3]")
    let arr = v.as_array()
    if arr.len() != 3 { return 4 }
    let last = arr.remove(2)
    if last.as_int() != 3 { return 5 }
    if arr.len() != 2 { return 6 }
    return 42
}
```

