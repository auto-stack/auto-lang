```auto
use model.Item
use std.json: encode, parse_strict
use std.csv: csv_encode, csv_parse_with_delimiter
use std.encoding.csv.csv_parse

fn main() int {
    let it = Item { code: "sku-9", qty: 3, price: 4.5d }
    let doc = parse_strict(encode(it))
    if doc.get_str("code") != "sku-9" || doc.get_int("qty") != 3 { return 1 }

    let j = csv_parse("k,v\nx,\"1,2\"")
    if csv_encode(j) != "k,v\nx,\"1,2\"" { return 2 }
    let tsv = csv_parse_with_delimiter("a\tb\n1\t2", "\t")
    if tsv != "[[\"a\",\"b\"],[\"1\",\"2\"]]" { return 3 }
    return 42
}
```

