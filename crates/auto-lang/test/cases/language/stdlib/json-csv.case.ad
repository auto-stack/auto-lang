fn main() int {
    if minify(" [ 1e-10 , 5e-324 , 0.9999999996 ] ") != "[1e-10,5e-324,0.9999999996]" { return 1 }
    let tiny = parse_strict("1e-10")
    if tiny.json_encode() != "1e-10" { return 2 }
    let almost = parse_strict("0.9999999996")
    if almost.json_encode() != "0.9999999996" { return 3 }
    let huge = parse_strict("1e100")
    if huge.json_encode() != "1e100" { return 4 }
    let least = parse_strict("5e-324")
    if least.json_encode() != "5e-324" { return 5 }
    let wide = parse_strict("9007199254740993")
    if wide.json_encode() != "9007199254740992" { return 6 }
    let edges = parse_strict("[-2147483648, -0]")
    if edges.json_encode() != "[-2147483648,-0]" { return 7 }
    if minify("-2147483648") != "-2147483648" { return 8 }
    var caught = 0
    try {
        let over = parse_strict("1e400")
    } catch e {
        if e.contains("JsonError") { caught = caught + 1 }
    }
    if caught != 1 { return 9 }
    return 42
}
```

