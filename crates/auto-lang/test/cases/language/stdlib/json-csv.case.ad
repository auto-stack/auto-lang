## Case: csv-rfc4180
id: "av.parity.1124.csv-rfc4180"
tags: ["av-language-parity", "plan-1124", "stdlib", "csv"]
links: ["PLAN-1124"]
entry-mode: "program"

### Auto
path: "main.at"

```auto
fn main() int {
    let raw = "a,,\"b,c\"\r\n\"x\"\"y\",\"l1\nl2\","
    let rows = csv_parse_rows(raw)
    if rows.len() != 2 || rows.get(0).len() != 3 { return 1 }
    if rows.get(0).get(0).clone() != "a" || rows.get(0).get(1).clone() != "" || rows.get(0).get(2).clone() != "b,c" { return 2 }
    if rows.get(1).get(0).clone() != "x\"y" || rows.get(1).get(1).clone() != "l1\nl2" || rows.get(1).get(2).clone() != "" { return 3 }

    let encoded = csv_encode_rows(rows)
    let json_text = csv_parse(encoded)
    if csv_encode(json_text) != encoded { return 4 }

    let semi_json = csv_parse_with_delimiter("h1;h2\n\"v;1\";", ";")
    if semi_json != "[[\"h1\",\"h2\"],[\"v;1\",\"\"]]" { return 5 }
    if csv_encode_with_delimiter(semi_json, ";") != "h1;h2\n\"v;1\";" { return 6 }

    var caught = 0
    try {
        let _e1 = csv_parse("\"unclosed")
    } catch e {
        if e.contains("CsvError") { caught = caught + 1 }
    }
    try {
        let _e2 = csv_parse_with_delimiter("a,b", "\"")
    } catch e {
        if e.contains("CsvError") { caught = caught + 1 }
    }
    if caught != 2 { return 7 }
    return 42
}
```

