# PLAN-1124 — Dynamic JSON, Generic Schema Encoding, and RFC-4180 CSV (`std.json` / `std.csv`)

Public language corpus coverage for ordinary Auto AV stdlib data formats:
- Dynamic `JsonValue` parsing (`parse`, `parse_strict`, `is_valid`, `minify`, `prettify`), type inspection, insertion-ordered `keys()` with last-member-wins duplicate-key deduplication, typed extractors, and catchable errors;
- Schema-driven `spec JsonEncodable` / `encode` / `encode_pretty` over primitives, wide numeric types, optionals, lists, nested records, empty records, and custom overrides;
- Pure-Auto RFC-4180 `std.csv` parsing/encoding (`csv_parse`, `csv_encode`, custom delimiters, `csv_parse_rows`, `csv_encode_rows`, `std.encoding.csv` compatibility) including quoted commas, escaped quotes, embedded newlines, CRLF, and empty trailing fields.

## Case: json-dynamic-tree
id: "av.parity.1124.json-dynamic-tree"
tags: ["av-language-parity", "plan-1124", "stdlib", "json"]
links: ["PLAN-1124"]
entry-mode: "program"

### Auto
path: "main.at"

```auto
fn main() int {
    let raw = "{\"n\":null,\"a\":[1.5,\"中\",true,false,-42,{}],\"k\":1,\"k\":2,\"u\":\"hi\\n\\\"q\\\"\\u0041\"}"
    if !is_valid(raw) { return 1 }
    if is_valid("{bad") { return 2 }
    if is_valid("[1,]") { return 3 }

    let bad = parse("{bad")
    is bad {
        Some(_) -> { return 4 }
        None -> {}
    }

    let v = parse_strict(raw)
    if !(v.is_object()) || v.kind() != "object" || v.type_of() != "object" { return 5 }
    if !(v.has_key("n")) || v.has_key("missing") { return 6 }

    let keys = v.keys()
    if keys.len() != 4 { return 7 }
    if keys.get(0).clone() != "n" || keys.get(1).clone() != "a" || keys.get(2).clone() != "k" || keys.get(3).clone() != "u" { return 8 }
    if v.get_int("k") != 2 { return 9 }
    if v.get_str("u") != "hi\n\"q\"A" { return 10 }

    let arr = v.get("a") ?? parse_strict("[]")
    if arr.len() != 6 { return 11 }
    if arr.at(0).as_f64() != 1.5d { return 12 }
    if arr.at(1).as_str() != "中" { return 13 }
    if !(arr.at(2).as_bool()) || arr.at(3).as_bool() { return 14 }
    if arr.at(4).as_int() != -42 || !(arr.at(5).is_object()) { return 15 }

    let pretty = prettify("{\"b\":2,\"a\":[1,true]}")
    if minify(pretty) != "{\"b\":2,\"a\":[1,true]}" { return 16 }

    var caught = 0
    try {
        let _x = v.get_str("n")
    } catch e {
        if e.contains("TypeError") { caught = caught + 1 }
    }
    try {
        let _y = v.get_int("missing")
    } catch e {
        if e.contains("JsonError") { caught = caught + 1 }
    }
    if caught != 2 { return 17 }
    return 42
}
```

