```auto
type Custom as JsonEncodable {
    x int
    fn json_encode() Str {
        return "{\"custom\":" + .x.to(Str) + "}"
    }
}

type Holder as JsonEncodable {
    customs List<Custom>
}

fn main() int {
    var rows = List<Custom>.new()
    rows.push(Custom { x: 1 })
    rows.push(Custom { x: 2 })
    let h = Holder { customs: rows.move }
    if encode(h) != "{\"customs\":[{\"custom\":1},{\"custom\":2}]}" { return 1 }
    let one = encode(Custom { x: 3 })
    if one != "{\"custom\":3}" { return 2 }
    let layout = "{\n  \"customs\": [\n    {\n      \"custom\": 1\n    },\n    {\n      \"custom\": 2\n    }\n  ]\n}"
    if encode_pretty(h) != layout { return 3 }
    return 42
}
```

