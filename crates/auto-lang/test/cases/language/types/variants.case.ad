```auto
type Note { id int; title Str }
fn make_note(i int, t Str) Note {
    Note { id: i, title: t }
}
fn main() {
    let n = Note { id: 1, title: "hello" }
    if n.title == "hello" {
        print("title ok")
    }
    if n.id == 1 {
        print("id ok")
    }
    let m = make_note(42, "world")
    if m.title == "world" {
        print("from fn ok")
    }
}
```

