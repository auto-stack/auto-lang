### Auto
path: "main.at"

```auto
fn try_divide(a int, b int) !int {
    if b == 0 {
        return Err("division by zero")
    }
    return Ok(a / b)
}
fn main() int {
    let r1 = try_divide(10, 2)
    is r1 {
        Ok(n) -> return n
        Err(e) -> return 0
    }
}
```

