42
```

### Notes

legacy.16_option_result.021: an Err arm carrying a DECLARED ENUM payload
— the `!int` sugar rewrites to the explicit `Result<int, ParseError>`
spelling (all Err payloads name one enum) and the nested `is` dispatches
on the payload. The r2 success leg (42) is asserted by
multi-error-family below.

## Case: multi-error-family
id: "av.parity.1083.multi-error-family"
tags: ["av-language-parity", "plan-1083", "types"]
links: ["PLAN-1083"]
entry-mode: "program"

### Auto
path: "main.at"

```auto
enum ApiError {
    Http { code int, msg Str }
    Timeout
}
fn fetch(url Str) !int {
    if url == "" {
        return Err(ApiError.Http(code: 404, msg: "not found"))
    }
    if url == "slow" {
        return Err(ApiError.Timeout)
    }
    return Ok(200)
}
fn main() {
    let r1 = fetch("")
    is r1 {
        Ok(data) -> print(data)
        Err(e) -> {
            is e {
                ApiError.Http(code, msg) -> print(code)
                ApiError.Timeout -> print("timeout")
            }
        }
    }
    let r2 = fetch("slow")
    is r2 {
        Ok(data) -> print(data)
        Err(e) -> {
            is e {
                ApiError.Http(code, msg) -> print(code)
                ApiError.Timeout -> print("timeout")
            }
        }
    }
    let r3 = fetch("ok")
    is r3 {
        Ok(data) -> print(data)
        Err(e) -> print("error")
    }
}
```

