### Auto
path: "main.at"

```auto
enum Light {
    Red
    Green
    fn is_red() bool {
        is self {
            Light.Red -> return true
        }
        return false
    }
}
fn main() {
    if Light.Red.is_red() { print("yes") } else { print("no") }
    if Light.Green.is_red() { print("yes") } else { print("no") }
}
```

