## Case: types-and-text
id: "py.float-args.1129.types-and-text"
tags: ["av-language-parity", "plan-1129"]
entry-mode: "program"

### Auto
path: "main.as"
syntax: "auto-script"

```auto
use.py builtins: getattr, repr

fn main() int {
    var obj = repr
    var step = 1
    print(getattr("F:1.25", "__class__").__name__.to(str))
    print(getattr(0.1, "__class__").__name__.to(str))
    print(getattr(0.1d, "__class__").__name__.to(str))
    print(getattr(0.5f + 0.25f, "__class__").__name__.to(str))
    print(getattr(7, "__class__").__name__.to(str))
    print(getattr(true, "__class__").__name__.to(str))
    print(getattr(obj, "__class__").__name__.to(str))
    print(getattr(step.as(float), "__class__").__name__.to(str))
    print(getattr(step, "__class__").__name__.to(str))
    print(repr("F:1.25").to(str))
    print(repr(0.1).to(str))
    print(repr(0.1d).to(str))
    print(repr(true).to(str))
    var joined_text = "F:1.25" + "F:2.5"
    print(repr(joined_text).to(str))
    return 0
}
```

