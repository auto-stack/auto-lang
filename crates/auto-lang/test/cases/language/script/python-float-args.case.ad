## Case: boundaries
id: "py.float-args.1129.boundaries"
tags: ["av-language-parity", "plan-1129"]
entry-mode: "program"

### Auto
path: "main.as"
syntax: "auto-script"

```auto
use.py struct: pack
use.py math: isinf, isnan, copysign

fn main() int {
    var i = 0
    var big = 1.0d
    for i < 11 {
        big = big * 100000000000000000000000000000000.0d
        i = i + 1
    }
    print(isinf(big).to(int))
    print(pack(">d", big).hex().to(str))
    print(pack(">d", copysign(1.0d, big)).hex().to(str))
    var nan = big - big
    print(isnan(nan).to(int))
    var tiny = 1.0d
    i = 0
    for i < 320 {
        tiny = tiny / 10.0d
        i = i + 1
    }
    print(pack(">d", tiny).hex().to(str))
    var small = 1.0f
    i = 0
    for i < 40 {
        small = small / 10.0f
        i = i + 1
    }
    print(pack(">f", small).hex().to(str))
    print(pack(">f", big.as(float)).hex().to(str))
    print(pack(">d", 0.0d * -1.0d).hex().to(str))
    return 0
}
```

