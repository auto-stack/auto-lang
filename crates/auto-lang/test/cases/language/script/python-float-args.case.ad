## Case: torch-lr-computed
id: "py.float-args.1129.torch-lr-computed"
tags: ["av-language-parity", "plan-1129"]
entry-mode: "program"

### Auto
path: "main.as"
syntax: "auto-script"

```auto
use.py torch: manual_seed, arange, ones
use.py torch.nn: Linear, MSELoss
use.py torch.optim: SGD

fn learning_rate(training_step int) float {
    return training_step.as(float) * 0.0625f + 0.03125f
}

fn main() int {
    var run = 0
    for run < 2 {
        var training_step = run
        var rate = learning_rate(training_step)
        manual_seed(0)
        var x = arange(8).reshape(4, 2) / 2
        var target = ones(4, 1)
        var model = Linear(2, 1, bias: false)
        var loss_fn = MSELoss()
        var optimizer = SGD(model.parameters(), lr: rate)
        print(rate)
        print(optimizer.param_groups[0]["lr"].to(float))
        var step = 0
        for step < 3 {
            var prediction = model(x)
            var loss = loss_fn(prediction, target)
            optimizer.zero_grad()
            loss.backward()
            optimizer.step()
            if step == 0 {
                print(loss.item().to(float))
            }
            if step == 2 {
                print(loss.item().to(float))
            }
            step = step + 1
        }
        var prediction = model(x)
        print(prediction.shape)
        print(prediction[0].item().to(float))
        run = run + 1
    }
    return 0
}
```

