## Case: containers-and-binop
id: "py.float-args.1129.containers-and-binop"
tags: ["av-language-parity", "plan-1129"]
entry-mode: "program"

### Auto
path: "main.as"
syntax: "auto-script"

```auto
use.py builtins: dict, repr

fn main() int {
    var d = dict()
    var missing = d.get(0.5, "missing")
    print(missing.to(str))
    var seven = 7
    var placed = d.setdefault(2.5d, seven)
    print(placed.to(int))
    print(d[2.5d].to(int))
    print(d.get(2.5d, 0).to(int))
    var s = repr("a")
    var joined = s + "F:1.25"
    print(joined.to(str))
    var doubled = s + s
    var four = doubled * 2
    print(four.to(str))
    return 0
}
```

