## Case: order-and-once
id: "py.float-args.1129.order-and-once"
tags: ["av-language-parity", "plan-1129"]
entry-mode: "program"

### Auto
path: "main.as"
syntax: "auto-script"

```auto
use.py math: isclose, sqrt

fn mark(label_text str, v float) float {
    print(label_text)
    return v
}

fn main() int {
    var a = isclose(mark("a", 1.5f), mark("b", 1.5f), rel_tol: mark("rel", 0.0f))
    print(a.to(int))
    var caught = 0
    try {
        var r = sqrt(mark("neg", -4.0f))
        print(r.to(float))
    } catch e {
        caught = caught + 1
        print(e.to(str))
    }
    print(caught)
    var b = isclose(mark("c", 2.5f), mark("d", 3.5f), rel_tol: mark("rel2", 0.0f))
    print(b.to(int))
    return 0
}
```

