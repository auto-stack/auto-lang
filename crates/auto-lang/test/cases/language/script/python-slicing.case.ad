## Case: order-compatibility
id: "py.slicing.1127.order-compatibility"
tags: ["av-language-parity", "plan-1127"]
entry-mode: "program"

### Auto
path: "main.as"
syntax: "auto-script"

```auto
use.py builtins: range, slice
use.py numpy: array
use.py json: loads

fn mark(label_text str, n int) int {
    print(label_text)
    return n
}

fn main() int {
    var n = array(range(6))
    print(n[slice(0, 3, 2)].tolist().to(str))
    print(n[n[1]:n[4]].tolist().to(str))
    print(n.reshape(2, 3)[0][::2].tolist().to(str))

    var xs = [4, 5]
    print(xs[0])
    var s = "abcd"
    print(s[1..3])
    var data = loads("{\"key\":42}")
    print(data["key"].to(int))
    if true {
        var slice = 99
        var row = array(range(mark("recv", 6)))[mark(label_text: "start", n: 0):mark("stop", 3):mark("step", 2)]
        print(row.tolist().to(str))
        print(slice)
    }
    return 0
}
```

