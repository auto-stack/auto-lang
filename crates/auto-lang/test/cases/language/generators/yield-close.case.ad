## Case: owned-list-items
id: "av.parity.1089.owned-list-items"
tags: ["av-language-parity", "plan-1089"]
entry-mode: "program"

### Auto
path: "main.at"

```auto
fn values() ~Iter<List<Str>> {
    var first = List<Str>.new()
    first.push("twenty".clone())
    yield first
    var second = List<Str>.new()
    second.push("twenty-two".clone())
    yield second
}
fn main() int {
    var it = values()
    let a = it.next()
    let b = it.next()
    let c = it.next()
    let d = it.next()
    it.close()
    let first = is a { Some(xs) -> xs.remove(0) == "twenty"; None -> false }
    let second = is b { Some(xs) -> xs.remove(0) == "twenty-two"; None -> false }
    let empty = is c { Some(xs) -> false; None -> true }
    let empty_again = is d { Some(xs) -> false; None -> true }
    if first && second && empty && empty_again { return 42 }
    return 0
}
```

