## Case: payload-owner-early-stop
id: "av.parity.1089.payload-owner-early-stop"
tags: ["av-language-parity", "plan-1089"]
entry-mode: "program"

### Auto
path: "main.at"

```auto
enum Entry {
    Row(List<Str>),
    Other,
}
fn records() ~Iter<Entry> {
    var first = List<Str>.new()
    first.push("first".clone())
    yield Entry.Row(first)
    var second = List<Str>.new()
    second.push("second".clone())
    yield Entry.Row(second)
    fail("third-next-must-not-run")
}
fn main() int {
    var visits = 0
    for entry in records() {
        let word = is entry {
            Entry.Row(xs) -> xs.remove(0),
            Entry.Other -> "".clone(),
        }
        if visits == 0 && word != "first" { return -1 }
        if visits == 1 && word != "second" { return -2 }
        visits += 1
        if visits == 2 { break }
    }
    return 40 + visits
}
```

