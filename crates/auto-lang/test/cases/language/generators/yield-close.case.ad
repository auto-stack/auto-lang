## Case: early-break-outer-finally
id: "av.parity.1089.early-break-outer-finally"
tags: ["av-language-parity", "plan-1089"]
entry-mode: "program"

### Auto
path: "main.at"

```auto
fn seq(events List<int>) ~Iter<Str> {
    try {
        let before = "kept".clone()
        yield before.clone()
        yield before + "!"
        yield before + "?"
    } finally {
        events.push(2)
    }
}
fn main() int {
    var events = List<int>.new()
    var n = 0
    for word in seq(events) {
        n += word.len()
        if n == 9 { break }
    }
    if n == 9 && events.len() == 1 && events[0] == 2 { return 42 }
    return 0
}
```

