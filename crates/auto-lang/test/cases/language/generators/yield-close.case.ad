## Case: close-throws-then-terminal
id: "av.parity.1089.close-throws-then-terminal"
entry-mode: "program"

### Auto
path: "main.at"

```auto
fn seq(events List<int>) ~Iter<int> {
 try { yield 40; yield 41 } finally { events.push(2); fail("close!") }
}
fn main() int {
 var events = List<int>.new()
 var g = seq(events)
 let initial = g.next() ?? 0
 try { g.close(); return -1 } catch e { if e != "close!" { return -2 } }
 try { g.close() } catch e { return -3 }
 if (g.next() ?? -1) != -1 { return -4 }
 if events.len() != 1 { return -5 }
 return initial + events.get(0)
}
```

