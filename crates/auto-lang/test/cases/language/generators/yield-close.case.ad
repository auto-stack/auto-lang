fn seq() ~Iter<Str> {
    var retained = List<Str>.new()
    retained.push("twenty".clone())
    retained.push("twenty-two".clone())
    yield retained.remove(0)
    yield retained.remove(0)
    yield "unexpected-after-cancel".clone()
}
fn main() int {
    var count = 0
    for text in seq() {
        print(text)
        count += 1
        if count == 2 { break }
    }
    return 42
}
