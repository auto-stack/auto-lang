type Number { value int }
fn series(n Number) ~Iter<int> {
    let initial = n.value
    var i = 0
    for i < 2 {
        yield initial + i * 2
        i += 1
    }
}
fn main() int {
    let n = Number(20)
    var result = 0
    for value in series(n) { result += value }
    return result
}
