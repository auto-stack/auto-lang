## Case: nested-close
id: "av.parity.1089.nested-close"
entry-mode: "program"

### Auto
path: "main.at"

```auto
fn seq(events List<int>) ~Iter<int> {
 try {
  try { yield 42 } finally { events.push(1); fail("inner") }
 } finally { events.push(2) }
}
fn main() int {
 var events = List<int>.new()
 var g = seq(events)
 let n = g.next() ?? 0
 try { g.close(); return -1 } catch e { if e != "inner" { return -2 } }
 if events.len() != 2 || events.get(0) != 1 || events.get(1) != 2 { return -3 }
 return n
}
```

