```auto
fn main() int {
    let xs = List<Str>.new(["long".clone(), "s".clone(), "end".clone()])
    let ys = xs.filter(fn(s str) bool { return s.len() > 1 })
    if !(ys.len() == 2 && xs.len() == 3) { return 0 }
    if !(ys.get(0).len() == 4 && ys.get(1).len() == 3) { return 0 }
    return 42
}
