## Case: filter-order-calls
id: "av.parity.1088.filter-order-calls"
tags: ["av-language-parity", "plan-1088"]
entry-mode: "program"

### Auto
path: "main.at"

```auto
type Note { id int; title str }
fn main() int {
    let xs = List<Note>.new([Note { id: 3, title: "c" }, Note { id: 1, title: "a" }, Note { id: 0, title: "z" }, Note { id: 2, title: "b" }])
    var calls = 0
    var order = 0
    var filtered = xs.filter(fn(n Note) bool {
        calls = calls + 1
        order = order * 10 + n.id
        return n.id > 0
    })
    if !(filtered.len() == 3) { return 0 }
    if !(filtered[0].id == 3 && filtered[1].id == 1 && filtered[2].id == 2) { return 0 }
    let f0 = filtered[0]
    let f1 = filtered[1]
    let f2 = filtered[2]
    if !(f0.title == "c" && f1.title == "a" && f2.title == "b") { return 0 }
    if !(calls == 4 && order == 3102) { return 0 }
    filtered.set(0, Note { id: 42, title: "changed" })
    let input_first = xs[0]
    if !(input_first.title == "c" && input_first.id == 3) { return 0 }
    return filtered[0].id
}
```

