## Case: array-copy-independence
id: "av.parity.1088.array-copy-independence"
tags: ["av-language-parity", "plan-1088"]
entry-mode: "program"

### Auto
path: "main.at"

```auto
type Note { id int; title str }
fn main() int {
    var original = List<Note>.new([Note { id: 1, title: "alpha" }, Note { id: 2, title: "beta" }])
    var copied = original.to_array()
    copied.set(0, Note { id: 42, title: "changed" })
    original.set(1, Note { id: 3, title: "other" })
    if !(original[0].id == 1) { return 0 }
    let original_first = original[0]
    if !(original_first.title == "alpha") { return 0 }
    if !(copied[1].id == 2) { return 0 }
    let copy_second = copied[1]
    if !(copy_second.title == "beta") { return 0 }
    return copied[0].id
}
```

