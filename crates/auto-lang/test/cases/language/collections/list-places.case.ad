## Case: tuple-literal-destructure
id: "av.parity.1082.tuple-literal-destructure"
tags: ["av-language-parity", "plan-1082", "collections"]
links: ["PLAN-1082"]
entry-mode: "program"

### Auto
path: "main.at"

```auto
fn main() {
 let t = (10, 20, 30)
 let (a, b, c) = t
 var ok = 0
 if a == 10 { if b == 20 { if c == 30 { ok = 1 } } }
 let m = (7, 42)
 let (m0, m1) = m
 if m1 == 42 { } else { ok = 0 }
 if ok == 1 { print("tuple: all assertions passed") }
}
```

