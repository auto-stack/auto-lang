## Case: hof-family-legacy
id: "av.parity.1082.hof-family-legacy"
tags: ["av-language-parity", "plan-1082", "collections"]
links: ["PLAN-1082", "PLAN-972"]
entry-mode: "program"

### Auto
path: "main.at"

```auto
fn main() {
 let nums = [1, 2, 3, 4, 5]
 print(nums.reduce(0, (acc int, x int) => acc + x))
 var found = 0
 let hit = nums.find((x int) => x > 3)
 is hit { Some(v) -> { found = v } None -> { found = 0 } }
 print(found)
 var has_neg = 0
 if nums.any((x int) => x < 0) { has_neg = 1 }
 print(has_neg)
 var all_pos = 0
 if nums.all((x int) => x > 0) { all_pos = 1 }
 print(all_pos)
}
```

