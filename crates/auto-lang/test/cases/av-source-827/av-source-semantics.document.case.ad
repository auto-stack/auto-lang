## Case: av-source-binop-args
id: "av.source.binop-args"
tags: ["av-source-827", "probe"]
links: ["PLAN-827"]

### Auto
path: "main.at"

~~~~auto
// V-08: binary operators inside call arguments — positional, named
// (reversed order), nested calls, multiline continuation inside brackets.
fn add(a int, b int) int {
    return a + b
}

fn main() int {
    if add(1 - 2, 3 * 4) != 11 { return 1 }
    if add(b: 10 / 2, a: 7 % 4) != 8 { return 2 }
    if add(add(1, 2), add(3 % 2, 4 - 1)) != 7 { return 3 }
    if add(
        1 +
        2,
        3
    ) != 6 { return 4 }
    let x = (1 +
        2) * (10 -
        7)
    if x != 9 { return 5 }
    return 0
}
~~~~

### Probe run-binop-args
recipe: "ac-av/core-run-v1"
entry: "d_main"
exit: 0

## Case: av-source-short-circuit-trap
id: "av.source.short-circuit-trap"
tags: ["av-source-827", "probe", "trap"]
links: ["PLAN-827"]

### Auto
path: "main.at"

~~~~auto
// V-04 (trap polarity): the skipped RHS never executes its division by
// zero; the executed one traps (exit 70) before the final return.
fn main() int {
    let safe = false && 1 / 0 > 0
    if safe { return 1 }
    let boom = true && 1 / 0 > 0
    return 0
}
~~~~

