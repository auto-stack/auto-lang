# PLAN-925 a2c-hir record-text - C04 (static/view methods + owned Str len (40+1+1)). The golden four-file C
# set (main.c / a2x_c_rt_runtime.h / generated.c + manifest.json sidecar)
# was frozen from a real worker emission (`daily-emit-c`, profile
# text-record) and re-verified deterministic across nonces; the
# certification leg (real C compile+run vs the independent
# reference-C04.c) is the explicit certify axis, not this daily check.

```test-case
case {
  schema: "autolang.case/2"
  id: "a2c-hir-record-text-925.c04"
  tags: ["a2c-hir", "record-text", "text-record"]
  links: ["PLAN-925"]
  source: { file: "src/C04.at", syntax: "auto", path: "main.at" }
  entry: { mode: "program" }
  checks: [
    { id: "a2x-emit", adapter: "probe", action: "run",
      options: {
        recipe: "ac-a2c/hir-record-text-emit-v1",
        a2x_hir: { profile: "text-record", entry: "main", caps: ["ac.runtime.text.v1"] },
        steps: [{ op: "run" }]
      },
      expect: { completion: "success", artifacts: [
        { path: "main.c", file: "golden-C04/main.c", compare: "bytes" },
        { path: "a2x_c_rt_runtime.h", file: "golden-C04/a2x_c_rt_runtime.h", compare: "bytes" },
        { path: "generated.c", file: "golden-C04/generated.c", compare: "bytes" },
        { path: "manifest.json", file: "golden-C04/manifest.json", compare: "bytes" }
      ] } }
  ]
}
```
