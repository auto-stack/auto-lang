        { path: "a2x_c_rt_runtime.h", file: "golden-R07/a2x_c_rt_runtime.h", compare: "bytes" },
        { path: "generated.c", file: "golden-R07/generated.c", compare: "bytes" },
        { path: "manifest.json", file: "golden-R07/manifest.json", compare: "bytes" }
      ] } }
  ]
