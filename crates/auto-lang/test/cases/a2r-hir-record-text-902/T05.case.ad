        a2x_hir: { profile: "text", entry: "main", caps: ["ac.runtime.text.v1"] },
        steps: [{ op: "run" }]
      },
      expect: { completion: "success", artifacts: [
        { path: "main.rs", file: "golden-T05/main.rs", compare: "bytes" },
        { path: "a2x_runtime.rs", file: "golden-T05/a2x_runtime.rs", compare: "bytes" },
        { path: "generated.rs", file: "golden-T05/generated.rs", compare: "bytes" },
        { path: "manifest.json", file: "golden-T05/manifest.json", compare: "bytes" }
      ] } }
  ]
}
