# Negative: a deck edit to an unknown leg is a typed deck diagnostic
# (the query returns diags before any native call).
```test-case
case {
  schema: "autolang.case/2"
  id: "ace-ca-d1.bad-leg"
  tags: ["ca-d1", "probe", "negative"]
  source: { file: "src/bridge-source.atomdata", syntax: "atom-data", path: "bridge-source.atomdata" }
  entry: { mode: "program" }
  checks: [
    { id: "bad-leg", adapter: "probe", action: "run",
      options: {
        recipe: "abi/ca-d1-bridge-v1",
        abi: { leg: "source" },
        steps: [
          { op: "edit-source", from: "leg source", to: "leg nope" },
          { op: "query" }
        ]
      },
      expect: { completion: { stage: "parse", code: "deck" }, probe: [ { } ] } }
  ]
}
```
