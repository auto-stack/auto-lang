      expect: { completion: "success", result: { format: "legacy-display", text: "false" } } },
    { id: "rust", adapter: "a2r", action: "emit", tier: "trans-snapshot",
      options: { module_name: "eq_false" },
      expect: { completion: "success", artifacts: [
        { path: "eq_false.rs", file: "cases/pilot/oracle/lang.basic.eq-false.rs", compare: "bytes" } ] } }
  ]
}
```

