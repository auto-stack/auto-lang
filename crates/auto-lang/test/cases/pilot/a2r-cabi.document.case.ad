mod engine_face_full_dyn_json_c_dyn {
    fn lib() -> &'static libloading::Library {
        static LIB: std::sync::OnceLock<libloading::Library> = std::sync::OnceLock::new();
        LIB.get_or_init(|| unsafe {
            // Plan 610 ⑥ D form: env AUTOTERM_CORE_DLL → exe same-dir → bare name (PATH).
            if let Ok(p) = std::env::var("AUTOTERM_CORE_DLL") {
                if let Ok(l) = libloading::Library::new(&p) { return l; }
            }
            let file = if cfg!(windows) { "autoterm_core.dll".to_string() } else { "libautoterm_core.so".to_string() };
            if let Ok(exe) = std::env::current_exe() {
                if let Some(dir) = exe.parent() {
                    if let Ok(l) = libloading::Library::new(dir.join(&file)) { return l; }
                }
            }
            libloading::Library::new(&file).expect("failed to load library autoterm_core (set AUTOTERM_CORE_DLL)")
        })
    }
    pub fn autoterm_engine_spawn(cols: i64, rows: i64, program: &str) -> *const std::os::raw::c_void {
