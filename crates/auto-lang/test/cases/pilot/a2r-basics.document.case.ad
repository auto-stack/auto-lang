## Case: trans-basics-arithmetic
id: "trans.basics.arithmetic"
tags: ["pilot", "a2r"]
module-name: "arithmetic"

### Auto
path: "main.at"

~~~~auto
fn main() {
    let x = 10
    let y = 20
    let z = 30

    let result1 = (x + y) * z
    let result2 = x + y * z
    let result3 = (x + y) * (z - x)

    print("Result1:", result1)
    print("Result2:", result2)
    print("Result3:", result3)

    let a = 5
    let b = a * 2 + a / 2 - 1
    print("b:", b)
}
~~~~

### Rust
check-id: "emit"
tier: "trans-snapshot"

#### arithmetic.rs

~~~~rust
// Auto-generated by a2r transpiler

fn main() {
    let x: i64 = 10;
    let y: i64 = 20;
    let z: i64 = 30;

    let result1: i64 = (x + y) * z;
    let result2: i64 = x + y * z;
    let result3: i64 = (x + y) * (z - x);

    println!("Result1: {}", result1);
    println!("Result2: {}", result2);
    println!("Result3: {}", result3);

    let a: i64 = 5;
    let b: i64 = a * 2 + a / 2 - 1;
    println!("b: {}", b);
}
~~~~
