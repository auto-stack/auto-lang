## Case: trans-basics-struct
id: "trans.basics.struct"
tags: ["pilot", "a2r"]
module-name: "struct"

### Auto
path: "main.at"

~~~~auto
type Point {
    x int
    y int
}

type Circle {
    radius float
    border uint
    center Point
}

fn main() {
    var p = Point(1, 2)
    p.x = 3
    print(`P: ${p.x}, ${p.y}`)

    let circle = Circle(5.0, 1, Point(50, 50))
    print(`C: ${circle.center.x}, ${circle.center.y}, ${circle.radius}`)
}
~~~~

### Rust
check-id: "emit"
tier: "trans-snapshot"

#### struct.rs

~~~~rust
// Auto-generated by a2r transpiler

#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Point {
    pub x: i64,
    pub y: i64,
}

#[derive(Clone, Debug, PartialEq)]
struct Circle {
    pub radius: f64,
    pub border: u32,
    pub center: Point,
}

fn main() {
    let mut p = Point { x: 1, y: 2 };
    p.x = 3;
    println!("P: {}, {}", p.x, p.y);

    let circle = Circle { radius: 5.0, border: 1 as u32, center: Point { x: 50, y: 50 } };
    println!("C: {}, {}, {}", circle.center.x, circle.center.y, circle.radius);
}
~~~~

