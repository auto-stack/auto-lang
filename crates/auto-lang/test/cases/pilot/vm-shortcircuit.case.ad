```test-case
case {
  schema: "autolang.case/1"
  id: "lang.error.out-of-bounds"
  tags: ["pilot", "vm", "negative", "strengthened-oracle"]
  links: ["PLAN-768"]
  source: { file: "vm/15_nested_mutation/014_out_of_bounds_error/out_of_bounds_error.at", syntax: "auto", path: "main.at" }
  entry: { mode: "script" }
  checks: [
    { id: "vm", adapter: "avm", action: "run",
      expect: { completion: { stage: "run", message: { contains: "out of bounds" } } } }
  ]
}
