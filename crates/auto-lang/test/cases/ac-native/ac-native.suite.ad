# reference the REAL ac-core/ac-syntax fixtures in place; outputs live in
# the runner's owned temp out-dir (outside this root, audited both ways).

```test-suite
suite { schema: "autolang.suite/2", id: "ac-native", include: [
    "core-run.case.ad",
