# PLAN-788 T-07: raw-HIR negatives from the REAL invalid fixture set

```test-case
case { schema: "autolang.case/2", id: "ac.hir.ref-dangling-expr", source: { text: "// Draft, schema-bound Atom text. Not executable Auto source.
// INVALID: e_add.rhs points at e_missing, which is not in the expression table.
hir(schema: \"auto.hir.core.draft\", revision: 1u32, profile: \"core-i32-draft\") {
    module m_add {
        path: \"examples.add\"

        types {
            type t_i32 i32 {}
            type t_add function {
                params: [\"t_i32\", \"t_i32\"]
                result: \"t_i32\"
            }
        }

        declarations {
            function d_add t_add {
                name: \"add\"
                body: \"b_add\"
            }
        }

        bodies {
            body b_add {
                owner: \"d_add\"
                entry: \"k_entry\"

                locals {
                    local l_a t_i32 { name: \"a\"; role: param; index: 0u32 }
                    local l_b t_i32 { name: \"b\"; role: param; index: 1u32 }
                    local l_sum t_i32 { name: \"sum\"; role: binding; mutable: false }
                }

                expressions {
                    expr e_a read_local { type: \"t_i32\"; local: \"l_a\" }
                    expr e_b read_local { type: \"t_i32\"; local: \"l_b\" }
                    expr e_add binary {
                        type: \"t_i32\"
                        op: add_i32
                        overflow: trap
                        lhs: \"e_a\"
                        rhs: \"e_missing\"
                    }
                    expr e_sum read_local { type: \"t_i32\"; local: \"l_sum\" }
                }

                blocks {
                    block k_entry {
                        let(local: \"l_sum\", value: \"e_add\") {}
                        return(value: \"e_sum\") {}
                    }
                }
            }
        }
    }
}
", syntax: "hir-atom", path: "main.atom" }, entry: { mode: "program" }, checks: [ { id: "chk", adapter: "ac", action: "check", options: {  }, expect: { completion: { stage: "bind", code: "bind.dangling-ref" } } } ] }
