```test-case
case { schema: "autolang.case/2", id: "ac.hir.type-swap-mismatch", source: { text: "// Draft, schema-bound Atom text. Not executable Auto source.
// PLAN-741 Phase 2 (QA-02) rejection: swapped bindings with mismatched types.
// params are [i32, bool]; the mapping sends the bool arg to param 0 and the
// i32 arg to param 1. Must be rejected at verify with verify.type-mismatch
// (the r1 verifier passed it by comparing eval_args positionally).
hir(schema: \"auto.hir.core.draft\", revision: 1u32, profile: \"core-i32-draft\") {
    module m_swap_bad {
        path: \"examples.swap_bad\"

        types {
            type t_i32 i32 {}
            type t_bool bool {}
            type t_entry function { params: []; result: \"t_i32\" }
            type t_mix function { params: [\"t_i32\", \"t_bool\"]; result: \"t_i32\" }
        }

        declarations {
            function d_entry t_entry { name: \"test_entry\"; body: \"b_entry\" }
            function d_mix t_mix { name: \"mix\"; body: \"b_mix\" }
        }

        bodies {
            body b_entry {
                owner: \"d_entry\"
                entry: \"k_entry\"

                expressions {
                    expr e_1 constant { type: \"t_i32\"; value: 1i32 }
                    expr e_2 constant { type: \"t_i32\"; value: 2i32 }
                    expr e_lt binary { type: \"t_bool\"; op: lt_i32; lhs: \"e_1\"; rhs: \"e_2\" }
                    expr e_9 constant { type: \"t_i32\"; value: 9i32 }
                    expr e_call call {
                        type: \"t_i32\"
                        callee: \"d_mix\"
                        eval_args: [\"e_9\", \"e_lt\"]
                        bindings: [
                            { param: 0u32, arg: 1u32 },
                            { param: 1u32, arg: 0u32 }
                        ]
                    }
                }

                blocks {
                    block k_entry { return(value: \"e_call\") {} }
                }
            }

            body b_mix {
                owner: \"d_mix\"
                entry: \"k_mix\"

                locals {
                    local l_i t_i32 { name: \"i\"; role: param; index: 0u32 }
                    local l_b t_bool { name: \"b\"; role: param; index: 1u32 }
                }

                expressions {
                    expr e_i read_local { type: \"t_i32\"; local: \"l_i\" }
                }

                blocks {
                    block k_mix { return(value: \"e_i\") {} }
                }
            }
        }
    }
}
", syntax: "hir-atom", path: "main.atom" }, entry: { mode: "program" }, checks: [ { id: "chk", adapter: "ac", action: "check", options: {  }, expect: { completion: { stage: "verify", code: "verify.type-mismatch" } } } ] }
