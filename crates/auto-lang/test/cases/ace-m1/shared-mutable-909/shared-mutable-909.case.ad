# PLAN-909 T-06: shared mutable scalar captures — the dedicated corpus.
# Positives run the real closures source recipe (fresh / body-edit / restart);
# S07/S08 are the named unsupported-domain negatives. The parent oracle in
# crates/auto-lang-core (CLOSURES_SOURCE_CASES) holds independent values.
```test-case
case {
  schema: "autolang.case/2"
  id: "ace.m1.s01-av909"
  tags: ["ace-m1", "closures", "value", "plan-909"]
  links: ["PLAN-909"]
  source: { file: "src/S01.at", syntax: "auto", path: "S01.at" }
  entry: { mode: "program" }
  checks: [
    { id: "av-s01-closures-source-fresh", adapter: "probe", action: "run",
      options: { recipe: "ac-av/closures-source-run-v1", av: { entry: "source:S01:fresh" }, steps: [{ op: "run" }] },
      expect: { completion: "success", exit: 43 } },
    { id: "av-s01-closures-source-body-edit", adapter: "probe", action: "run",
      options: { recipe: "ac-av/closures-source-run-v1", av: { entry: "source:S01:body-edit" }, steps: [
        { op: "run" },
        { op: "edit-source", from: "base = base + n", to: "base = base + n + 1" },
        { op: "run" }
      ] },
      expect: { completion: "success", exit: 46 } }
  ]
}
```

