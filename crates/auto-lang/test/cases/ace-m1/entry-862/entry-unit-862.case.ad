  links: ["PLAN-862"]
  source: { file: "src/U02.at", syntax: "auto", path: "main.at" }
  entry: { mode: "program" }
  checks: [
    { id: "av", adapter: "probe", action: "run",
      options: { recipe: "ac-av/core-run-v1", av: { entry: "d_main", profile: "entry-unit" }, steps: [{ op: "run" }] },
      expect: { completion: "success", av_channel: "unit" } },
    { id: "av-scalar-rejects", adapter: "probe", action: "run",
      options: { recipe: "ac-av/core-run-v1", av: { entry: "d_main" }, steps: [{ op: "run" }] },
      expect: { completion: { stage: "parse", code: "source.unsupported" } } }
  ]
}
```

