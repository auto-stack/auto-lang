# PLAN-881 T-05 — the record/text-record METHOD rows on the shared
# lowering: every value row carries BOTH the ac-native (mn) leg and the AV
# leg (data or owned recipe by domain) against the SAME hand-audited
# expected value; diagnostic rows carry the mn leg against the shared
# frontend/verify stack (the per-code specificity is asserted by the
# in-crate av_method_881_* tiers). R08 joins here in its VALUE form (the
# t-r-native gap row flips in the same change). The 852 base suite is NOT
# extended (freeze §5.6): this rides its own suite file.

```test-case
case {
  schema: "autolang.case/2"
  id: "ace.m1.m08"
  tags: ["ace-m1", "method-881", "record"]
  links: ["PLAN-852", "PLAN-881"]
  source: { file: "src/M08.at", syntax: "auto", path: "main.at" }
  entry: { mode: "program" }
  checks: [
    { id: "ac-native", adapter: "probe", action: "run",
      options: { recipe: "ac/mir-native-scalar-v1", mn: { entry: "d_main" }, steps: [{ op: "run" }] },
      expect: { completion: "success", exit: 42 } },
    { id: "av", adapter: "probe", action: "run",
      options: { recipe: "ac-av/data-run-v1", av: { entry: "d_main" }, steps: [{ op: "run" }] },
      expect: { completion: "success", exit: 42 } },
  ]
}
```

