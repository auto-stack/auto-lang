```test-case
case {
  schema: "autolang.case/2"
  id: "ace.m1.i09.ace"
  tags: ["ace-m1", "scenario", "order-914", "layout"]
  links: ["PLAN-914"]
  source: { file: "src/I09-ace.at", syntax: "auto", path: "main.at" }
  entry: { mode: "program" }
  checks: [
    { id: "refused", adapter: "probe", action: "run",
      options: { recipe: "ac/mir-native-scalar-v1", mn: { entry: "d_main", session: "ace_m1_i09_914", diagnostics: "source-v1" }, steps: [
        { op: "run" },
        { op: "edit-source", from: "fn f(x int) int", to: "fn f(x int, y int) int" },
        { op: "run" }
      ] },
      expect: { completion: { stage: "verify", code: "mn.incremental.refused.signature-or-context-drift" } } },
    { id: "survives", adapter: "probe", action: "run",
      options: { recipe: "ac/mir-native-scalar-v1", mn: { entry: "d_main", session: "ace_m1_i09_914", diagnostics: "source-v1" }, steps: [ { op: "run" } ] },
      expect: { completion: "success", exit: 7 } }
  ]
}
```

