// PLAN-914 E01 (ACE paths: ac/mn scalar + av scalar): named-argument call
// evaluates its arguments in SOURCE order (b then a) and then binds by name.
// Frozen oracle: value 7, mark trace "b","a".
// Discriminators: positional binding -> 2*3+1*2 = 8 (value red); declaration
// order evaluation -> trace "a","b" (trace red).

fn sub(a int, b int) int {
    return a * 3 + b * 2
}

fn main() int {
    return sub(b: mark_b(), a: mark_a())
}
