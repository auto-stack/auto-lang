  entry: { mode: "program" }
  checks: [
    { id: "fresh-run", adapter: "probe", action: "run",
      options: {
        recipe: "ac/mir-native-scalar-v1",
        mn: { entry: "d_main" },
        steps: [ { op: "run" } ]
      },
      expect: { completion: "success", exit: 120 } },
    { id: "edit-then-restart-run", adapter: "probe", action: "run",
      options: {
        recipe: "ac/mir-native-scalar-v1",
        mn: { entry: "d_main" },
        steps: [
          { op: "edit-source", from: "fact(5)", to: "fact(6)" },
          { op: "run" },
          { op: "restart" },
          { op: "run" }
        ]
      },
      expect: { completion: "success", exit: 720 } }
  ]
}
