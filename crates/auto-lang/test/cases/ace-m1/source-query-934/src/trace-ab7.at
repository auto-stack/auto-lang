// PLAN-934 SQ-A capability-intrinsic facts: the trace marks are ordinary
// callees of the query layer (mark_a = 1, mark_b = 2), so the closed-form
// oracle is a = x = 1, b = 2, value = 1*3 + 2*2 = 7 and the mark trace is
// "a" then "b" (the let executes before the call arguments).
fn sub(a int, b int) int {
    return a * 3 + b * 2
}

fn main() int {
    let x = mark_a()
    return sub(b: mark_b(), a: x)
}
