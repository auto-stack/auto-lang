# PLAN-870 T-05 — the ACE-M1 T*/R* record/text rows bound for REAL on the
# ac-native (mn) path (the ac column of binding.tsv flips from
# `gap:mn-scalar-only` to graded results). Value/trap rows carry the mn leg
# and — where PLAN-862's T-06 bound the AV result `ok` — the matching av
# data/owned leg, both against the SAME frozen oracle (independent expected
# column). Diagnostic rows carry the mn leg (the shared frontend/verify
# stack rejects with the family code; the per-row SPECIFIC code is asserted
# by mn's in-crate `data_owned_tier` against the same shared stack). Rows
# whose av column stays a gap (T03/T05/R07/R08) wire no av leg. T05 wires
# no leg at all — named upstream exclusion `gap:upstream-s-eq` (the shared
# lowering's view-eq Bin path; KNOWN-DEBT, S owner). The 852 base suite is
# NOT extended (freeze §5.6): this rides its own suite file.

```test-case
case {
  schema: "autolang.case/2"
  id: "ace.m1.t01"
  tags: ["ace-m1", "four-path", "owned-text"]
  links: ["PLAN-852", "PLAN-870"]
  source: { file: "src/T01.at", syntax: "auto", path: "main.at" }
  entry: { mode: "program" }
  checks: [
    { id: "ac-native", adapter: "probe", action: "run",
      options: { recipe: "ac/mir-native-scalar-v1", mn: { entry: "d_main" }, steps: [{ op: "run" }] },
      expect: { completion: "success", exit: 38 } },
    { id: "av", adapter: "probe", action: "run",
      options: { recipe: "ac-av/owned-run-v1", av: { entry: "d_main" }, steps: [{ op: "run" }] },
      expect: { completion: "success", exit: 38 } },
  ]
}
```

