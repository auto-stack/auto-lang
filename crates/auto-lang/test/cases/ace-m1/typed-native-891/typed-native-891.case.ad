# PLAN-891: native wide-scalar typed entry — file-ized fixtures through the
# real PE bitwise frame channel. The (kind, bits) oracles below are the
# parent's INDEPENDENT hand-computed expectations (binding.tsv W01–W05 rows
# frozen since PLAN-820); the worker never sees them.
```test-case
case {
  schema: "autolang.case/2"
  id: "ace.m1.w01-mn891"
  tags: ["ace-m1", "typed", "value"]
  links: ["PLAN-891", "W01"]
  source: { file: "src/W01-i64-min.mnf", syntax: "typed-fixture", path: "main.mnf" }
  entry: { mode: "program" }
  checks: [
    { id: "mn-w01-typed", adapter: "probe", action: "run",
      options: { recipe: "ac/mir-native-typed-v1", mn: { entry: "main", typed: { fixture: "src/W01-i64-min.mnf" } }, steps: [{ op: "run" }] },
      expect: { completion: "success", typed: { kind: "i64", bits: "8000000000000000" } } }
  ]
}
```

