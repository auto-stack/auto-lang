# PLAN-863 typed console source corpus. All stdout/stderr/result/error oracles below are hand-computed.
# NUL transport is additionally tested by the parent API regression (Atom contract escape syntax is unchanged).

```test-case
case {
  schema: "autolang.case/2", id: "ace.m1.o01", tags: ["ace-m1", "console", "signed-int"], links: ["PLAN-863"],
  source: { file: "src/O01.at", syntax: "auto", path: "main.at" }, entry: { mode: "program" },
  checks: [{ id: "av-console", adapter: "probe", action: "run",
    options: { recipe: "ac-av/console-run-v1", av: { entry: "d_main", caps: ["console.stdout", "console.stderr"] }, steps: [{ op: "run" }] },
    expect: { completion: "success", stdout: { text: "-2147483648\n-7\n0\n42\n", compare: "bytes" }, stderr: { text: "", compare: "bytes" }, exit: 7 } }]
}
```

