# PLAN-917 legacy A2R mut-record (R07) and text-slice (T08) evidence —
# daily emit axis ONLY: real production emission + byte comparison against
# independently reviewed frozen goldens. Zero Rust compilation happens here
# (no rustc/cargo spawn); the explicit compile+run certification lives in the
# separate `ace.m1.a2r-emit917.cert/1` domain (a2r-emit-917-cert), which this
# suite never invokes.
#
# Golden provenance: `golden/daily/*` bytes came from the REAL adapter-driven
# production emission (adapter-materialized layout), reviewed and frozen per
# plan §5.2/§5.3 — never copied from an expected/oracle file. The cert-domain
# goldens under `golden/` (top level) belong to the certification receipts.
# Original corpus sources stay in ../src (R07.at/T08.at are only referenced).

```test-case
case {
  schema: "autolang.case/2"
  id: "ace.m1.a2r917.r07.single"
  tags: ["ace-m1", "a2r", "mut-record", "daily-emit"]
  links: ["PLAN-917"]
  source: { file: "src/R07.at", syntax: "auto", path: "main.at" }
  entry: { mode: "program" }
  checks: [{ id: "emit", adapter: "a2r", action: "emit", options: { module_name: "R07" }, expect: { completion: "success", artifacts: [{ path: "R07.rs", file: "a2r-emit-917/golden/daily/r07.single.rs", compare: "bytes" }] } }]
}
```

