type Item { name Str; code int }
enum Token { Data(Item)
End }
fn collections_helper(seed int) Token {
 var xs = List<Token>.new()
 let label Str = "中"
 let named = label.clone()
 xs.push(Token.Data(Item(named.move, seed + 41 + 0)))
 return xs.remove(0)
}
