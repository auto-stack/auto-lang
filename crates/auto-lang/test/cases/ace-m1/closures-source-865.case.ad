# PLAN-865: K01–K06 use the unchanged original .at files as source-backed
# closures cases. The parent validates each source id and independently
# checks the value/diagnostic plus the closures-session release face.

```test-case
case {
  schema: "autolang.case/2"
  id: "ace.m1.k01-av865"
  tags: ["ace-m1", "closures", "value", "plan-865"]
  links: ["PLAN-865"]
  source: { file: "src/K01.at", syntax: "auto", path: "K01.at" }
  entry: { mode: "program" }
  checks: [
    { id: "av-k01-closures-source-fresh", adapter: "probe", action: "run",
      options: { recipe: "ac-av/closures-source-run-v1", av: { entry: "source:K01:fresh", session: "av_closures_865_k01" }, steps: [{ op: "run" }] },
      expect: { completion: "success", exit: 42 } },
    { id: "av-k01-closures-source-restart", adapter: "probe", action: "run",
      options: { recipe: "ac-av/closures-source-run-v1", av: { entry: "source:K01:restart", session: "av_closures_865_k01" }, steps: [{ op: "run" }] },
      expect: { completion: "success", exit: 42 } }
  ]
}
```

