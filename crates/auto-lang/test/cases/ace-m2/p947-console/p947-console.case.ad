# PLAN-947 console/1 public binding corpus. The same sources run on BOTH
# real lanes — AV (recipe ac-av/console-run-v1) and native mn (recipe
# ac/mn/console-run-v1) — with independent hand-computed byte oracles.
# say is the 943-frozen public spelling (stdout, UTF-8 bytes + exactly one
# LF per call). Unauthorized runs and console budgets are named rejections.

```test-case
case {
  schema: "autolang.case/2", id: "ace.m2.p947.o03-mn", tags: ["ace-m2", "console", "utf8-newline"], links: ["PLAN-947"],
  source: { file: "src/O03.at", syntax: "auto", path: "main.at" }, entry: { mode: "program" },
  checks: [{ id: "mn-console", adapter: "probe", action: "run",
    options: { recipe: "ac/mn/console-run-v1", mn: { entry: "d_main", caps: ["console.stdout", "console.stderr"] }, steps: [{ op: "run" }] },
    expect: { completion: "success", stdout: { text: "你好\n\n", compare: "bytes" }, stderr: { text: "é\n", compare: "bytes" }, exit: 0 } }]
}
```

