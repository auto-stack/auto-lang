# PLAN-964 T-02/T-08 — permanent M2 dynamic corpus: object literals,
# dynamic string-key read/write, nil/null, callable values in objects,
# generic closure capture + HOF, FStr interpolation. The same sources run
# on the AV lane (recipe ac-av/aggregates-source-run-v1 for object/nil/
# fstr cases and ac-av/closures-source-run-v1 for closure cases) with
# hand-computed byte oracles (exit codes). The native/a2r/a2c legs of the
# same sources run in the crate-level four-end tests (PLAN-964 §6 V rows)
# per the original support domain (mn: closures Move/Clone + FStr
# TextConcat/display; a2r/a2c: FStr only — objects/dynamic are outside
# their domains).

```test-case
case {
  schema: "autolang.case/2", id: "ace.m2.p964.map-bracket-write", tags: ["ace-m2", "dynamic", "object", "plan-964"],
  source: { file: "src/map_bracket_write.at", syntax: "auto", path: "main.at" }, entry: { mode: "program" },
  checks: [{ id: "av-object", adapter: "probe", action: "run",
    options: { recipe: "ac-av/aggregates-source-run-v1", av: { entry: "d_main" }, steps: [{ op: "run" }] },
    expect: { completion: "success", exit: 600 } }]
}
```

