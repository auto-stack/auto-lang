// PLAN-964 T-02 source03 (L-22/FStr): f-string interpolation — the old
// fstring corpus (public obligation: source-order evaluation of the
// interpolation expressions, display of ints). Values are checked
// numerically via the printed/concatenated forms.
fn main() int {
    let name = "AutoLang"
    let age = 1
    let greeting = f"Hello, $name"
    let info = f"Name: $name, Age: $age"
    let x = 10
    let y = 20
    let result = f"Result: ${x + y}"
    let msg = f"The value is $x and ${y * 2}"
    let a = 5
    let b = 3
    let sum = f"Sum: ${a + b}, Product: ${a * b}"
    if greeting != "Hello, AutoLang" { return 0 }
    if info != "Name: AutoLang, Age: 1" { return 0 }
    if result != "Result: 30" { return 0 }
    if msg != "The value is 10 and 40" { return 0 }
    if sum != "Sum: 8, Product: 15" { return 0 }
    return 42
}
