// Auto-generated by a2r transpiler

#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Item {
    pub name: String,
    pub code: i64,
}

fn relay(x: Item) -> Item {
    return x;
}

fn main() -> i64 {
    let a: Item = Item { name: "x".to_string(), code: 41 };
    let b: Item = relay(a);
    return b.code + (b.name.len() as i64);
}
````

