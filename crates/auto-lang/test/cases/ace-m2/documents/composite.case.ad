    Data(Item)
    End
}
fn main() int {
    let t = Token.Data(Item("hello", 37))
    is t {
        Token.Data(v) -> { return v.name.len() + v.code }
        Token.End -> { return 1 }
    }
}
````

### VM result
check-id: "autovm"
