```

### Rust
check-id: "a2r-snapshot"

````rust
// Auto-generated by a2r transpiler

#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Counter {
    pub value: i64,
}

impl Counter {
    fn new(n: i64) -> Counter {
        return Counter { value: n };
    }
    fn read(&self) -> i64 {
        return self.value;
    }
}

fn main() -> i64 {
    let x: Counter = Counter::new(42);
    return x.read();
}
````

