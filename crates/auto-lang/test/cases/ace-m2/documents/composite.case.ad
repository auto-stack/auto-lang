## Case: v01-option-some-destructure
id: "ace.m1.v01"
module-name: "m1_v01"

### Auto
path: "main.at"

````auto
fn maybe(x int) ?int {
    if x > 0 { return Some(x) }
    return None
}
fn main() int {
    let x = maybe(42)
    is x {
        Some(v) -> { return v }
        None -> { return 1 }
    }
}
````

### VM result
check-id: "autovm"
final-newline: false

```text
42
```

### Rust
check-id: "a2r-snapshot"

````rust
// Auto-generated by a2r transpiler

fn maybe(x: i64) -> Option<i64> {
    if x > 0 {
        return Some(x);
    }
    return None;
}

fn main() -> i64 {
    let x = maybe(42);
    match x {
        Some(v) => return v,
        None => return 1,
    }
}
````

## Case: v02-result-ok-destructure
id: "ace.m1.v02"
module-name: "m1_v02"

### Auto
path: "main.at"

````auto
fn divide(a int, b int) Result<int, Str> {
    if b == 0 { return Err("bad") }
    return Ok(a / b)
}
fn main() int {
    let r = divide(84, 2)
    is r {
        Ok(v) -> { return v }
        Err(e) -> { return e.len() }
    }
}
````

### VM result
check-id: "autovm"
final-newline: false

```text
42
```

### Rust
check-id: "a2r-snapshot"

````rust
// Auto-generated by a2r transpiler

fn divide(a: i64, b: i64) -> Result<i64, String> {
    if b == 0 {
        return Err("bad".into());
    }
    return Ok(a / b);
}

fn main() -> i64 {
    let r = divide(84, 2);
    match r {
        Ok(v) => return v,
        Err(e) => return (e.len() as i64),
    }
}
````

