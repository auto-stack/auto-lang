struct Inner {
    pub value: i64,
}

#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
struct Outer {
    pub inner: Inner,
    pub extra: i64,
}

fn main() -> i64 {
    let mut p: Outer = Outer { inner: Inner { value: 3 }, extra: 2 };
    p.inner.value = 7;
    return p.inner.value + p.extra;
}
