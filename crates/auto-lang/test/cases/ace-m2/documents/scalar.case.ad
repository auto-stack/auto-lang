// Auto-generated by a2r transpiler

fn main() -> i64 {
    let mut total: i64 = 0;
    let mut i: i64 = 0;
    while i < 3 {
        let mut j: i64 = 0;
        loop {
            j = j + 1;
            if j == 2 {
                continue;
            }
            if j == 3 {
                break;
            }
            total = total + 10;
        }
        i = i + 1;
    }
    return total;
}
````

