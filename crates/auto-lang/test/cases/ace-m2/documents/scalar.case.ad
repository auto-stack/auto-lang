// Auto-generated by a2r transpiler

fn even(n: i64) -> bool {
    if n == 0 {
        return true;
    }
    return odd(n - 1);
}

fn odd(n: i64) -> bool {
    if n == 0 {
        return false;
    }
    return even(n - 1);
}

fn main() -> i64 {
    if even(6) {
        return 42;
    }
    return 1;
}
````

