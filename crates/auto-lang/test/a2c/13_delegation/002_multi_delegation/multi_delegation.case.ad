# Legacy a2c corpus: 13_delegation/002_multi_delegation

## Case: legacy-13-delegation-002-multi-delegation
id: "legacy.13_delegation.002_multi_delegation"
entry-mode: "program"

### Auto
path: "multi_delegation.at"
```auto
spec Engine {
    fn start()
}

spec Weapon {
    fn fire()
}

type WarpDrive {
    fn start() {
        print("WarpDrive engaging")
    }
}

type LaserCannon {
    fn fire() {
        print("Pew! Pew!")
    }
}

type Starship {
    has core WarpDrive for Engine
    has weapon LaserCannon for Weapon
}

fn main() {
    let ship = Starship()
    ship.start()
    ship.fire()
}
```

### Rust
check-id: "a2c-emit"

#### multi_delegation.expected.c
```c
#include "multi_delegation.h"



void WarpDrive_Start(struct WarpDrive *self) {
    printf("%s\n", "WarpDrive engaging");
}

void LaserCannon_Fire(struct LaserCannon *self) {
    printf("%s\n", "Pew! Pew!");
}

void Starship_start(struct Starship *self) {
    WarpDrive_start(&self->core);
}
void Starship_fire(struct Starship *self) {
    LaserCannon_fire(&self->weapon);
}

int main(void) {
    struct Starship ship = {};
    Starship_start(&ship);
    Starship_fire(&ship);
    return 0;
}
```

