} Weapon_vtable;

struct WarpDrive {
};

void WarpDrive_Start(struct WarpDrive *self);
struct LaserCannon {
};

void LaserCannon_Fire(struct LaserCannon *self);
struct Starship {
    struct WarpDrive core;
    struct LaserCannon weapon;
};
void Starship_start(struct Starship *self);
