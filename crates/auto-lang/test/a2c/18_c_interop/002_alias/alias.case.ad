### Auto
path: "alias.at"
```auto
fn my_add(a int, b int) int {
    a + b
}

alias add = my_add

fn main() {
    let s int = add(3, 5)
    print("Sum:", s)
}
```

### Rust
check-id: "a2c-emit"

#### alias.expected.c
```c
#include "alias.h"

int my_add(int a, int b) {
    return a + b;
}

#define add my_add

int main(void) {
    int s = add(3, 5);
    printf("%s %d\n", "Sum:", s);
    return 0;
}
```

