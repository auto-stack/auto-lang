# Legacy a2c corpus: 06_pattern_matching/007_tag_types

## Case: legacy-06-pattern-matching-007-tag-types
id: "legacy.06_pattern_matching.007_tag_types"
entry-mode: "program"

### Auto
path: "tag_types.at"
```auto
enum Shape {
    Circle float
    Rect float
}

fn area(s Shape) float {
    is s {
        Shape.Circle(r) -> 3.14 * r * r
        Shape.Rect(side) -> {
            return side * side
        }
    }
}

fn main() {
    let c = Shape.Circle(2.0)
    let ca = area(c)
    print("Circle area:", ca)

    let r = Shape.Rect(3.0)
    let ra = area(r)
    print("Rect area:", ra)
}
```

### Rust
check-id: "a2c-emit"

#### tag_types.expected.c
```c
#include "tag_types.h"


float area(struct Shape s) {
    switch (s.tag) {
    case SHAPE_CIRCLE:
        {
            return 3.14 * s.as.Circle * s.as.Circle;
        }
        break;
    case SHAPE_RECT:
        {
            return s.as.Rect * s.as.Rect;
        }
        break;
    }
    return 0.0;
}

int main(void) {
    struct Shape c = {.tag = SHAPE_CIRCLE, .as.Circle = 2.0};
    unknown ca = area(c);
    printf("%s %d\n", "Circle area:", ca);

    struct Shape r = {.tag = SHAPE_RECT, .as.Rect = 3.0};
    unknown ra = area(r);
    printf("%s %d\n", "Rect area:", ra);
    return 0;
}
```

#### tag_types.expected.h
```c
#pragma once

#include <stdio.h>

enum ShapeKind {
    SHAPE_CIRCLE,
    SHAPE_RECT,
};

struct Shape {
    enum ShapeKind tag;
    union {
        float Circle;
        float Rect;
    } as;
};
float area(struct Shape s);
```
