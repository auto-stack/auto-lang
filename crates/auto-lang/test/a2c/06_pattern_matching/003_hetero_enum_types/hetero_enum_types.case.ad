#### hetero_enum_types.expected.h
```c
#pragma once

enum AtomKind {
    ATOM_INT,
    ATOM_FLOAT,
};

struct Atom {
    enum AtomKind tag;
    union {
        int Int;
        float Float;
    } as;
};
int Atom_GetValue(struct Atom* self);
