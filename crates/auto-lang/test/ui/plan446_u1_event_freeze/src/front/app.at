// app.at — Plan 446 批五 U1 corpus: 事件冻结(P0)复现载体。
// 侧栏(循环构建) press → Nav(m.id) → store.active_id 切换 → 主区条件翻转。

use store: NavStore

widget App {
    msg { Init, Nav, Cell }

    model {
        var current str = "boot"
        var probe str = "none"
    }

    on {
        .Init -> {
            store.Init()
            .current = "home"
        }

        .Nav(id) -> {
            store.SetActive(id)
            .current = id
        }

        // Plan 446 批五 U2: 循环内 input 的 $event 内联调用形态(现场
        // collection_browser TableCell 同款)。
        .Cell(idx, txt) -> {
            .current = txt
            .probe = idx
        }
    }

    view {
        row {
            col {
                for m in .store.items {
                    button (text: m.name) {
                        onclick: .Nav(m.id)
                    }
                }
            }
            col {
                for e in .store.items {
                    input (value: e.name) {
                        onchange: .Cell(1, $event.target.value)
                    }
                }
                select (onchange: .Nav) {
                    option "home" {}
                    option "roles" {}
                    option "daemon" {}
                }
                if .store.active_id == "roles" {
                    text "ROLES-VIEW" {}
                }
                if .store.active_id == "daemon" {
                    text "DAEMON-VIEW" {}
                }
                if .store.active_id == "home" {
                    text "HOME-VIEW" {}
                }
                text .current
            }
        }
    }
}
