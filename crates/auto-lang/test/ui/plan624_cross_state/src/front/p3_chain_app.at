// p3_chain_app.at — PLAN-624 red corpus (P3): JS-idiom &&/|| chains on
// struct operands. On the VM these evaluate as BOOLEAN logic — the jade
// title read back as literal `true`. Agreed ruling: non-bool operands of
// &&/|| must be a compile-time error (forces the explicit null-guard
// form); this corpus must FAIL handler synthesis with that diagnostic.

use store: ChainStore

widget ChainApp {
    msg { Probe }

    model {
        var status str = "boot"
        var pages = []
        var hop_a str = "unset"
        var hop_b str = "unset"
        var hop_c str = "unset"
    }

    on {
        .Init -> {
            .pages.push({ title: "A", body: "x" })
        }

        .Probe -> {
            var t = .pages[0]
            var a = t.frontmatter
            .hop_a = a
            var b = a && a.title
            .hop_b = b
            var c = b || "fallback"
            .hop_c = c
            .status = c
        }
    }

    view {
        col {
            text .status
        }
    }
}
