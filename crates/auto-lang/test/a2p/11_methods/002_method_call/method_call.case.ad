type Counter {
    count int

    fn inc() {
        .count = .count + 1
    }

    fn get() int {
        .count
    }
}

fn main() {
    let c = Counter(count: 0)
    c.inc()
    c.inc()
    print(c.get())
}
```

### Rust
check-id: "a2p-emit"

#### method_call.expected.py
```python
@dataclass
class Counter:
    count: int

    def inc(self):
        self.count = self.count + 1

    def get(self) -> int:
        return self.count

def main():
    c = Counter(count=0)
    c.inc()
    c.inc()
    print(c.get())

if __name__ == "__main__":
    main()
```
