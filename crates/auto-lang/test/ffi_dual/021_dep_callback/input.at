/// PLAN-596 复审 F-1: 回调面独立语料(V2-6, experimental)。
/// 与 020 拆分——DIV-DEP-19(a2r 闭包实参不装箱)只豁免本 case,
/// 020 主面(trait/泛型/深拷贝/组合)恢复自动 a2r 三轨。
dep autolang_traits(path: "{{FFI_DUAL_DIR}}/020_dep_traits_generics/fixture/autolang_traits")
use.rs autolang_traits::{Invoker}

fn main() {
    let inv = Invoker.new()
    let r = inv.apply(x => x*2+1, 5)
    print(r)
}
