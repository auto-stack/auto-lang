dep autolang_traits(path: "{{FFI_DUAL_DIR}}/020_dep_traits_generics/fixture/autolang_traits")
use.rs autolang_traits::{Temp, Tagged}

fn main() {
    let abc str = "abc"
    let t = Temp.of(abc)
    let s = t.to_string()
    print(s)
    print(t.degree)

    let tag str = "orig"
    let src = Tagged.new(tag, 1)
    let cp = src.clone()
    cp.hits = 9
    print(src.hits)
    print(cp.hits)
    print(src.tag)
}
