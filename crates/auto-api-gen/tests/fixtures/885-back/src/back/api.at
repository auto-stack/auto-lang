// PLAN-885 T-02 fixture: 覆盖四个根因组的约简 back 模块。
// G1 time 路径: time.now_sec()/now_ms() → a2r_std::time::now_sec()
// G2 字符串值/借用: Env.get 返回 String 传 &str 形参、字符比较、数字 as_str
// G3 int 宽度/容器/签名: find 单参(2参 str_find vs 3参签名)、parse().ok() 的 Option、i64/i32
// G4 模块类型路径: works 模块类型经 db 包装后返回

use works: blank_work, make_work, new_work_id, work_to_meta_json, work_from_meta_json, join_path, json_escape, json_field_str, json_field_int, hex_val

pub type Work = { work_id: str, title: str, summary: str, body: str, tags: str, status: str, revision: int, created_at: int, updated_at: int }
pub type SaveResult = { work_id: str, revision: int, ok: bool }

fn data_root() str {
    return join_path(Env.get("HOME"), ".plan885-data")
}

fn write_confirmed(path str, content str) bool {
    let tmp = File.write(path, content)
    return tmp
}

#[api(method = "GET", path = "/api/885/time")]
pub fn time_now() int {
    let now int = time.now_sec()
    return now
}

#[api(method = "GET", path = "/api/885/time_ms")]
pub fn time_now_ms() int {
    let ms int = time.now_ms()
    return ms
}

#[api(method = "GET", path = "/api/885/find")]
pub fn find_test() int {
    let ids str = "a\nb\nc"
    let hit int = ids.find("b")
    return hit
}

#[api(method = "GET", path = "/api/885/write")]
pub fn write_test() bool {
    let ok bool = write_confirmed(data_root(), "hello")
    return ok
}

#[api(method = "GET", path = "/api/885/parse")]
pub fn parse_test() int {
    let t str = "42"
    let v int = t.parse()
    return v
}
