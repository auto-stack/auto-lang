// PLAN-885 T-02 fixture companion: works 模块,提供 api.at 使用的类型与工具函数。
// 保持与真实 Blog works.at 的签名形状一致(join_path 返回 str、json_escape 等)。

pub type Work = { work_id: str, title: str, summary: str, body: str, tags: str, status: str, revision: int, created_at: int, updated_at: int }

pub fn new_work_id() str {
    let now int = time.now_sec()
    let n int = now * 1000000
    return n.to_string()
}

pub fn make_work(work_id str, p_title str, p_summary str, p_body str, p_tags str, p_status str, p_rev int, p_created int, p_updated int) Work {
    return Work { work_id: work_id, title: p_title, summary: p_summary, body: p_body, tags: p_tags, status: p_status, revision: p_rev, created_at: p_created, updated_at: p_updated }
}

pub fn blank_work(work_id str) Work {
    return Work { work_id: work_id, title: "", summary: "", body: "", tags: "", status: "draft", revision: 0, created_at: 0, updated_at: 0 }
}

pub fn json_escape(s str) str {
    var out str = ""
    var i int = 0
    while i < s.len() {
        let c str = s.slice(i, i + 1)
        if c == "\"" {
            out = out + "\\\""
        } else if c == "\\" {
            out = out + "\\\\"
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

pub fn hex_val(c str) int {
    if c == "0" { return 0 }
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    if c == "a" { return 10 }
    if c == "b" { return 11 }
    if c == "c" { return 12 }
    if c == "d" { return 13 }
    if c == "e" { return 14 }
    if c == "f" { return 15 }
    return 0
}

pub fn json_field_str(src str, key str) str {
    return json_escape(src)
}

pub fn json_field_int(src str, key str) int {
    let v int = src.parse()
    return v
}

pub fn work_to_meta_json(w Work) str {
    return json_escape(w.title)
}

pub fn work_from_meta_json(meta str, body str) Work {
    return Work { work_id: "", title: meta, summary: body, body: body, tags: "", status: "draft", revision: 0, created_at: 0, updated_at: 0 }
}

pub fn join_path(a str, b str) str {
    if a == "" {
        return b
    }
    return a + "/" + b
}
