// p051-min-ta — PLAN-051 Phase 2 诊断语料：textarea 分层二分。
// A(根级 textarea)=已实证可输入；B(子 widget MinTa 内 textarea)=复刻
// musk composer 的"条件渲染+子 widget"形态。B 失败 A 成功 → 011 核心
// (子 widget 内 text_editor 焦点)实锤,语料直携上游。
// B 变体走独立文件 min_ta.at（生产装载惯例：同文件兄弟 widget 不被
// 收集——第一版因此 MinTa 整体被丢，树仅 3 孩）。

use min_ta: MinTa
use c1_ta: C1Ta
use c2_ta: C2Ta

widget App {
    msg { Init, SetA(str) }
    model {
        var a str = ""
    }
    view {
        col {
            style: "p-6 gap-3"
            textarea {
                placeholder: "A: root-level textarea"
                value: .a
                oninput: .SetA($event)
                height: 80
                style: "w-full px-3 py-2 border border-primary/40 rounded-md text-[15px] text-foreground"
            }
            text "A值: " + .a
            MinTa {}
            C1Ta {}
            C2Ta {}
            text "B框在上方组件内（独立状态）"
            text "C1/C2 见上：真键盘逐框试输，MCP 读 t 字段判定"
        }
    }
    on {
        .SetA(v) -> { .a = v }
    }
}
