// 041 — model var DEEP reactivity canary (plan 443 regression carrier).
//
// Before plan 443, EVERY widget model var compiled to
// `defineModel<T>("x", { default })`. defineModel is built on `customRef`,
// whose get/set contract only covers the WHOLE value — with no parent
// `v-model` binding (the local-state case), it stores a plain object, so
// deep in-place mutations were INVISIBLE to the render:
//
//     doc.value.shapes.push(s)   // data changed, view did NOT re-render
//     doc.value.provider.api_key = "x"  // same silent drift
//
// Two real-world victims: jade-garden WhiteboardPage (doc.value.shapes.push,
// DEBTS 015 🔴) and auto-os-config probe B (provider.api_key deep write).
//
// Plan 443 narrows the downgrade: only model channels some parent call-site
// actually BINDS (`v-model:name`) compile to defineModel; every unbound
// model var emits `ref<T>(...)` again — ref wraps object values in a deep
// reactive proxy, so nested writes and nested-array pushes TRACK again.
// Pinned codegen-side by cap_model_channel_bound_downgrades_child /
// cap_model_channel_unbound_keeps_ref (tests/vue_capabilities.rs); this
// fixture pins the RUNTIME behavior — click the three buttons and every
// line below must update in place (nothing here whole-replaces the model).
widget App {
    msg { DeepSet, DeepPush, NestedSet }

    model {
        var doc map = { provider: { api_key: "orig", shapes: ["s1"] } }
    }

    computed {
        key_len => .doc.provider.api_key.len()
        shapes_len => .doc.provider.shapes.len()
    }

    view {
        col {
            // all three lines read NESTED paths + computeds over them —
            // they must update from deep mutations alone
            text f"api_key=${.doc.provider.api_key} len=${.key_len}"
            text f"shapes=${.doc.provider.shapes.join(",")} n=${.shapes_len}"
            button "deep-set" { onclick: .DeepSet }
            button "deep-push" { onclick: .DeepPush }
            button "nested-set" { onclick: .NestedSet }
        }
    }

    on {
        // deep WRITE through two levels
        .DeepSet -> { .doc.provider.api_key = "deep" }
        // deep PUSH on a nested array — the exact jade whiteboard shape
        .DeepPush -> { .doc.provider.shapes.push("s2") }
        // nested write on a fresh key (object grows in place)
        .NestedSet -> { .doc.provider.api_key = "nested" }
    }
}
