// item_w.at — Phase 2 child: widget ItemRow (same contract as item_cf.at.disabled).
//
// Same exercised capabilities as Phase 1, but the child is a `widget`.
// Callback contract (Plan 043 M5 R4): `on_select: msg` prop + matching
// `Select(str)` msg variant — the prop is dropped from defineProps and
// delivered as an emit; the child fires it with `onclick: .Select(...)`
// exactly like the component fn variant.

widget ItemRow(label: str, on_select: msg) {
    msg Msg { Select(str), Bump }
    model { var clicks int = 0 }
    view {
        row {
            style: "flex items-center gap-2 py-1 px-2 border-b border-gray-200"
            button {
                onclick: .Bump
                text .label
                style: "px-2 py-0.5 text-sm bg-blue-500 text-white rounded"
            }
            text .clicks {
                style: "text-xs text-gray-500 w-6 text-center"
            }
            button "pick" {
                onclick: .Select(.label)
                style: "px-2 py-0.5 text-xs text-gray-500"
            }
        }
    }
    on {
        .Select(label) -> {}
        .Bump -> { .clicks = .clicks + 1 }
    }
}
