// item_cf.at — Phase 1 child: component fn ItemRow.
//
// Exercised capabilities:
//   - props in (label) — one per loop instance
//   - internal per-instance state (clicks) — proves N instances own N states
//   - event up (select(label)) — child emits its payload (Form A)

component fn ItemRow(label: str) {
    msg Msg { select(str), bump }
    model { var clicks int = 0 }
    on {
        .select(label) -> {}
        .bump -> { .clicks = .clicks + 1 }
    }
    row {
        style: "flex items-center gap-2 py-1 px-2 border-b border-gray-200"
        button {
            onclick: .bump
            text .label
            style: "px-2 py-0.5 text-sm bg-blue-500 text-white rounded"
        }
        text .clicks {
            style: "text-xs text-gray-500 w-6 text-center"
        }
        button "pick" {
            onclick: .select(.label)
            style: "px-2 py-0.5 text-xs text-gray-500"
        }
    }
}
