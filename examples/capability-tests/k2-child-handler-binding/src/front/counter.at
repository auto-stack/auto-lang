widget Counter(on_select: msg) {
    // PLAN-037 T3 fix: a callback prop (`on_xxx: msg`) must have a matching
    // Pascal msg variant declared — that is what drops it from defineProps
    // and declares the emit. Without `Select(int)` the prop stayed REQUIRED
    // and `emit('Select')` was undeclared (two TS2345s).
    msg Msg { Select(int), Bump(int) }
    model { var n int = 0 }
    view { col { button "increment" { onclick: .Bump(.n + 1) } text .n { } style: "gap-2" } }
    on { .Bump(next) -> { .n = next; on_select(next) } }
}
