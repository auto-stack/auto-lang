// p781-scroll-child-anchor — PLAN-781 阶段B子内容锚点 capability 示例（双端同源）。
// 覆盖接口决策（docs/plans/reports/781-interface-decision.md）冻结合同的
// V-01~06 矩阵：真实定位（双 4000 字长段/中文+ASCII）、非连续 key 寻址、
// Init 先发目标/双章换绑、负例族（空key/缺key/越界/重复/跨pane/幽灵句柄）、
// 重排（字号/宽度）、旧 offset 族回归与 managed unsupported。
// 驱动：tests/vm_probe.py（MCP 原生腿）+ tests/vue_probe.mjs（Vue 腿）。

widget App {
    model {
        var main_ctl str = "main-pane"
        var side_ctl str = "side-pane"
        var mgd_ctl str = "mgd-pane"
        var reply str = "-"
        var old_off float = -1.0
        var chapter int = 1
        var narrow bool = false
        var body_style str = "text-sm leading-5"
    }

    msg C { Init, Go(str, str), Query(str, str), SwitchCh, FontL, FontS, SetNarrow, SetWide, OldEnd, OldBy, OldStart, OldProbe }

    on {
        .Init -> {
            let r str = scroll_to_child(.main_ctl, "c3")
        }
        .Go(p, k) -> {
            let r str = scroll_to_child(p, k)
            .reply = r
        }
        .Query(p, k) -> {
            .reply = scroll_anchor_state(p, k)
        }
        .SwitchCh -> {
            .chapter = 3 - .chapter
        }
        .FontL -> {
            .body_style = "text-lg leading-8"
        }
        .FontS -> {
            .body_style = "text-sm leading-5"
        }
        .SetNarrow -> {
            .narrow = true
        }
        .SetWide -> {
            .narrow = false
        }
        .OldEnd -> {
            let ok = scroll_to_end(.main_ctl)
        }
        .OldBy -> {
            let ok = scroll_by(.main_ctl, 320.0)
        }
        .OldStart -> {
            let ok = scroll_to_start(.main_ctl)
        }
        .OldProbe -> {
            let s = scroll_state(.main_ctl)
            .old_off = s.offset_y
        }
    }

    view {
        col (style: "h-screen flex flex-col") {
            col (style: "shrink-0 border-b border-border px-3 py-2 gap-1") {
                row (style: "gap-2 flex-wrap") {
                    button "GoC50" { onclick: .Go(.main_ctl, "c50") }
                    button "GoA80" { onclick: .Go(.main_ctl, "a80") }
                    button "GoC3" { onclick: .Go(.main_ctl, "c3") }
                    button "GoP8" { onclick: .Go(.main_ctl, "p8") }
                    button "GoQ5" { onclick: .Go(.main_ctl, "q5") }
                    button "GoDup" { onclick: .Go(.main_ctl, "dup") }
                    button "GoMiss" { onclick: .Go(.main_ctl, "missing") }
                    button "GoOOB" { onclick: .Go(.main_ctl, "p9999") }
                }
                row (style: "gap-2 flex-wrap") {
                    button "GoEmptyK" { onclick: .Go(.main_ctl, "") }
                    button "GoBadH" { onclick: .Go("", "c3") }
                    button "GoGhost" { onclick: .Go("ghost-pane", "gk") }
                    button "QGhost" { onclick: .Query("ghost-pane", "gk") }
                    button "QC3" { onclick: .Query(.main_ctl, "c3") }
                    button "QC50" { onclick: .Query(.main_ctl, "c50") }
                    button "QQ5" { onclick: .Query(.main_ctl, "q5") }
                    button "QMiss" { onclick: .Query(.main_ctl, "missing") }
                    button "QUnknown" { onclick: .Query(.main_ctl, "never") }
                    button "GoMgd" { onclick: .Go(.mgd_ctl, "any") }
                }
                row (style: "gap-2 flex-wrap") {
                    button "GoSideDup" { onclick: .Go(.side_ctl, "dup") }
                    button "GoSideOnly" { onclick: .Go(.side_ctl, "sideonly") }
                    button "SwitchCh" { onclick: .SwitchCh }
                    button "FontL" { onclick: .FontL }
                    button "FontS" { onclick: .FontS }
                    button "SetNarrow" { onclick: .SetNarrow }
                    button "SetWide" { onclick: .SetWide }
                }
                row (style: "gap-2 flex-wrap") {
                    button "OldEnd" { onclick: .OldEnd }
                    button "OldBy" { onclick: .OldBy }
                    button "OldStart" { onclick: .OldStart }
                    button "OldProbe" { onclick: .OldProbe }
                    text `R=${.reply} old=${.old_off}` { style: "text-xs font-mono text-muted-foreground" }
                }
            }
            row (style: "flex-1 min-h-0 gap-2 px-3 pb-3") {
                if .chapter == 1 {
                    scroll-pane (controller: .main_ctl, style: ["border rounded h-full min-w-0", if .narrow { "w-1/2" } else { "flex-1" }]) {
                        col (style: "px-4") {
                    col {
                        style: "py-2 border-b border-border"
                        scroll-anchor: "c0"
                        text "V03-c0 启动定位短行。" { style: .body_style }
                    }
                    col {
                        style: "py-2 border-b border-border"
                        scroll-anchor: "c1"
                        text "V03-c1 启动定位短行。" { style: .body_style }
                    }
                    col {
                        style: "py-2 border-b border-border"
                        scroll-anchor: "c2"
