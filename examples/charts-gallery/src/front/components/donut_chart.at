// components/donut_chart.at - DonutChart component (Plan 437 Phase 2 ④ → Plan 484 v2 → Plan 498 M3 → Plan 499 M4)
//
// 圆环图(d3-arc 风格:外弧 A → 内弧回程 Z,大弧标志 span>π),角度由
// 数据占比循环累进计算,math.cos/sin 直调。渲染端 v1 = SVG 子树直通。
//
// 484 v2:图例升级为逐行结构(色块 + 名 + 占比)并兼任 hover 命中区
// (扇区弧形无法矩形命中,hover 图例 → tooltip 锚定扇区中角,半径 81 =
// 内外中值);tooltip 锚点/内容 Init 预计算,hovered str 门控显隐。
// props: legend/tooltip/labels(单系列,无 fields/axis/curve)。
// 492 M6:带参 msg 声明恢复(484 时代"裸挂带参 handler"绕开随 Plan 492
// C2 定案——带参 msg 声明双轨正常——退役)。
//
// 499 M4(逐扇区直接命中):svgdoc 静态限制(DOM 事件不可达)经由**代码命中**
// 解除——全图单 mouse-area(coords "260x260" = viewBox 幅面,覆盖层 inset-0
// 随 svg 缩放)→ .PointerMove(x,y) 极坐标测试(rIn²≤dx²+dy²≤rOut² 且
// atan2 归一落累进角区间)→ 复用 498 emphasis(hovDn + e0..3 外移路径);
// 扇区-边命中同源 = 逻辑坐标 + 代码几何测试同一能力(diagram 边后续消费,
// canvas-pointer-events.md §4)。path 级 onmouseenter(VM 轨死事件)退役,
// 双端同一命中代码;图例命中保留(双入口)。tooltip 维持角落锚定。
//
// # Usage
// donut-chart (data: .traffic, index: "l", field: "v") {}

widget DonutChart (data: List, index: str = "l", field: str = "v", colors: List<str> = ["#2563eb", "#16a34a", "#d97706", "#dc2626"], legend: bool = true, labels: List<str> = [], tooltip: bool = true) {
    msg { Init, Hover(int), Toggle(int), PointerMove(float, float), PointerOut }

    model {
        // 每片段路径槽位(d=常驻/e=emphasis 外移)
        d0 str = ""
        e0 str = ""
        d1 str = ""
        e1 str = ""
        d2 str = ""
        e2 str = ""
        d3 str = ""
        e3 str = ""
        hovDn int = 9
        visDn0 bool = true
        visDn1 bool = true
        visDn2 bool = true
        visDn3 bool = true
        // 图例槽位(固定 4 行,R006 规避:行内文本不引用循环变量记录字段)
        legendColor0 str = ""
        legendText0 str = ""
        legendColor1 str = ""
        legendText1 str = ""
        legendColor2 str = ""
        legendText2 str = ""
        legendColor3 str = ""
        legendText3 str = ""
        tipTitles List = []
        tipBodies List = []
        hovered str = "false"
        tipTitle str = ""
        tipBody str = ""
        // 499 M4:扇区累进角端表(a1 绝对角,Init 预落)+ 数据点数
        //(handler 跑根态不可读 prop,P320 单态;498 哨兵纪律 hit=9)
        endsDn List = []
        cntDn int = 0
    }

    on {
        .Init -> {
            // ---- 总量(占比分母) ----
            var total int = 0
            for d in .data {
                var v = d[.field]
                total = total + v
            }
            var totalf float = total
            var cx float = 280.0
            var cy float = 150.0
            var rOut float = 100.0
            var rIn float = 62.0
            var a0 float = -1.5707963267948966
            var outTipTitle List = []
            var outTipBody List = []
            var outEnds List = []
            var cs = .colors
            var ccount int = cs.len()
            var lname = .labels
            var iname = .index
            var k = 0
            for d in .data {
                var vf float = d[.field]
                var span float = 6.283185307179586 * vf / totalf
                var a1 float = a0 + span
                var laf int = 0
                if span > 3.141592653589793 {
                    laf = 1
                }
                var c0 float = math.cos(a0)
                var s0 float = math.sin(a0)
                var c1 float = math.cos(a1)
                var s1 float = math.sin(a1)
                var x0 float = cx + rOut * c0
                var y0 float = cy + rOut * s0
                var x1 float = cx + rOut * c1
                var y1 float = cy + rOut * s1
                var u0 float = cx + rIn * c0
                var v0 float = cy + rIn * s0
                var u1 float = cx + rIn * c1
                var v1 float = cy + rIn * s1
                var dstr = f"M${x0} ${y0} A100 100 0 ${laf} 1 ${x1} ${y1} L${u1} ${v1} A62 62 0 ${laf} 0 ${u0} ${v0} Z"
                // 498 M3:emphasis 外移路径——中角方向 12px 平移六个锦点(弧径不变)
                var mid float = (a0 + a1) / 2.0
                var ox float = math.cos(mid) * 12.0
                var oy float = math.sin(mid) * 12.0
                var estr = f"M${x0 + ox} ${y0 + oy} A100 100 0 ${laf} 1 ${x1 + ox} ${y1 + oy} L${u1 + ox} ${v1 + oy} A62 62 0 ${laf} 0 ${u0 + ox} ${v0 + oy} Z"
                var ci int = k
                if ci >= ccount {
                    ci = ccount - 1
                }
                var color = cs[ci]
                // 图例项:labels[k] 优先回落 index 字段值;占比整数运算;槽位赋值(k<4)
                var lv = d[iname]
                var vi = d[.field]
                var pct int = vi * 100 / total
                var name = lv
                if lname.len() > k {
                    name = lname[k]
                }
                if k == 0 {
                    .d0 = dstr
                    .e0 = estr
                    .legendColor0 = color
                    .legendText0 = name
                }
                if k == 1 {
                    .d1 = dstr
                    .e1 = estr
                    .legendColor1 = color
                    .legendText1 = name
                }
                if k == 2 {
                    .d2 = dstr
                    .e2 = estr
                    .legendColor2 = color
                    .legendText2 = name
                }
                if k == 3 {
                    .d3 = dstr
                    .e3 = estr
                    .legendColor3 = color
                    .legendText3 = name
                }
                outTipTitle.push(name)
                outTipBody.push(f"${lv} ${vi} (${pct}%)")
                outEnds.push(a1)
                a0 = a1
                k = k + 1
            }
            .tipTitles = outTipTitle
            .tipBodies = outTipBody
            .endsDn = outEnds
            .cntDn = k
        }

        .Hover(i) -> {
            .hovered = "true"
            .hovDn = i
            var tt = .tipTitles[i]
            var tb = .tipBodies[i]
            .tipTitle = tt
            .tipBody = tb
        }
        .HoverOut -> {
            .hovered = "false"
            .hovDn = 9
        }
        // 499 M4:极坐标扇区命中。坐标为覆盖层局部(viewBox 幅面 260x260,
        // 原点 = viewBox (150,20)),换算 svg 系后做环带 + 累进角测试;
        // 命中 → 复用 Hover 态(emphasis 外移);未命中(环外/内孔)→ 离焦。
        .PointerMove(x, y) -> {
            var sx float = x + 150.0
            var sy float = y + 20.0
            var dx float = sx - 280.0
            var dy float = sy - 150.0
            var r2 float = dx * dx + dy * dy
            var hit int = 9
            if r2 >= 3844.0 && r2 <= 10000.0 {
                var ang float = math.atan2(dy, dx)
                ang = ang + 1.5707963267948966
                if ang < 0.0 {
                    ang = ang + 6.283185307179586
                }
                var i int = 0
                while i < .cntDn {
                    var e = .endsDn[i]
                    var eb float = e + 1.5707963267948966
                    if ang < eb {
                        if hit == 9 {
                            hit = i
                        }
                    }
                    i = i + 1
                }
            }
            if hit == 9 {
                .hovered = "false"
                .hovDn = 9
            } else {
                .hovered = "true"
                .hovDn = hit
                var tt = .tipTitles[hit]
                var tb = .tipBodies[hit]
                .tipTitle = tt
                .tipBody = tb
            }
        }
        .PointerOut -> {
            .hovered = "false"
            .hovDn = 9
        }
        .Toggle(k) -> {
            if k == 0 {
                .visDn0 = !.visDn0
            }
            if k == 1 {
                .visDn1 = !.visDn1
            }
            if k == 2 {
                .visDn2 = !.visDn2
            }
            if k == 3 {
                .visDn3 = !.visDn3
            }
        }
    }

    style {
        /* 498 M3: emphasis 外移淡入——vue 走 CSS transition(d 形状插值不可过渡,
           仅描边/透明度淡入),VM 直接切换。 */
        path { transition: stroke-width 0.15s ease, fill-opacity 0.15s ease; }
    }

    view {
        col (style: "w-full items-center gap-3") {
            col (style: "relative") {
                svg (viewBox: "150 20 260 260", style: "w-full h-auto max-w-md") {
                    circle (cx: "280", cy: "150", r: "100", fill: "none", stroke: "#f1f5f9", stroke-width: "38") {}
                    if .d0 != "" {
                      if .visDn0 {
                        if .hovDn == 0 {
                            path (key: .e0, d: .e0, fill: .legendColor0, stroke: "#ffffff", stroke-width: "2") {}
                        } else {
                            path (key: .d0, d: .d0, fill: .legendColor0) {}
                        }
                      }
                    }
                    if .d1 != "" {
                      if .visDn1 {
                        if .hovDn == 1 {
                            path (key: .e1, d: .e1, fill: .legendColor1, stroke: "#ffffff", stroke-width: "2") {}
                        } else {
                            path (key: .d1, d: .d1, fill: .legendColor1) {}
                        }
                      }
                    }
                    if .d2 != "" {
                      if .visDn2 {
                        if .hovDn == 2 {
                            path (key: .e2, d: .e2, fill: .legendColor2, stroke: "#ffffff", stroke-width: "2") {}
                        } else {
                            path (key: .d2, d: .d2, fill: .legendColor2) {}
                        }
                      }
                    }
                    if .d3 != "" {
                      if .visDn3 {
                        if .hovDn == 3 {
                            path (key: .e3, d: .e3, fill: .legendColor3, stroke: "#ffffff", stroke-width: "2") {}
                        } else {
                            path (key: .d3, d: .d3, fill: .legendColor3) {}
                        }
                      }
                    }
                }
                // 499 M4:全图命中覆盖层(inset-0 随 svg 容器缩放;coords
                // 归一换算免疫响应式)——双端同一代码命中
                if .tooltip {
                    mouse-area (coords: "260x260", onmousemove: .PointerMove, onmouseleave: .PointerOut, style: "absolute inset-0") {}
                }
                if .tooltip && .hovered == "true" {
                    col (style: "absolute top-[20px] right-[20px] z-50 bg-popover border rounded-md px-2 py-1 shadow-md") {
                        text .tipTitle { style: "text-xs font-semibold text-foreground" }
                        text .tipBody { style: "text-xs text-muted-foreground" }
                    }
                }
            }
            if .legend {
                col (style: "gap-1") {
                    if .legendText0 != "" {
                        mouse-area (onmouseenter: .Hover(0), onmouseleave: .HoverOut, onclick: .Toggle(0)) {
                            row (style: if .visDn0 { "items-center gap-2" } else { "items-center gap-2 opacity-40" }) {
                                svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                    rect (width: "8", height: "8", fill: .legendColor0) {}
                                }
                                text .legendText0 { style: "text-xs text-muted-foreground" }
                            }
                        }
                    }
                    if .legendText1 != "" {
                        mouse-area (onmouseenter: .Hover(1), onmouseleave: .HoverOut, onclick: .Toggle(1)) {
                            row (style: if .visDn1 { "items-center gap-2" } else { "items-center gap-2 opacity-40" }) {
                                svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                    rect (width: "8", height: "8", fill: .legendColor1) {}
                                }
                                text .legendText1 { style: "text-xs text-muted-foreground" }
                            }
                        }
                    }
                    if .legendText2 != "" {
                        mouse-area (onmouseenter: .Hover(2), onmouseleave: .HoverOut, onclick: .Toggle(2)) {
                            row (style: if .visDn2 { "items-center gap-2" } else { "items-center gap-2 opacity-40" }) {
                                svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                    rect (width: "8", height: "8", fill: .legendColor2) {}
                                }
                                text .legendText2 { style: "text-xs text-muted-foreground" }
                            }
                        }
                    }
                    if .legendText3 != "" {
                        mouse-area (onmouseenter: .Hover(3), onmouseleave: .HoverOut, onclick: .Toggle(3)) {
                            row (style: if .visDn3 { "items-center gap-2" } else { "items-center gap-2 opacity-40" }) {
                                svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                    rect (width: "8", height: "8", fill: .legendColor3) {}
                                }
                                text .legendText3 { style: "text-xs text-muted-foreground" }
                            }
                        }
                    }
                }
            }
        }
    }
}
