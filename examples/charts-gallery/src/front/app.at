// front/app.at - Charts Gallery(Plan 484 M3 重建)
//
// 六张图卡与旧 shadcn-vue 版(Plan 238)形状一一对应:
// ① Area 四系列 ② Bar grouped ③ Bar stacked ④ Line monotone
// ⑤ Donut ⑥ Area 自定色。全部经 official 包裸名原语声明
// (line-chart/bar-chart/area-chart/donut-chart),几何全部在
// Auto 组件内完成,view 层零手写 SVG。

widget App {
    use { package: official from "components" }

    model {
        // Area & Line chart data
        monthlyRevenue = [
            { month: "Jan", desktop: 186, mobile: 80, tablet: 45, wearable: 25 },
            { month: "Feb", desktop: 305, mobile: 200, tablet: 60, wearable: 35 },
            { month: "Mar", desktop: 237, mobile: 120, tablet: 55, wearable: 30 },
            { month: "Apr", desktop: 73, mobile: 190, tablet: 40, wearable: 20 },
            { month: "May", desktop: 209, mobile: 130, tablet: 50, wearable: 28 },
            { month: "Jun", desktop: 214, mobile: 140, tablet: 65, wearable: 42 }
        ]

        // Bar chart data
        quarterlySales = [
            { quarter: "Q1", product: 4500, service: 3200, license: 2100, support: 1800 },
            { quarter: "Q2", product: 5200, service: 4100, license: 2300, support: 1950 },
            { quarter: "Q3", product: 4800, service: 3800, license: 2400, support: 2100 },
            { quarter: "Q4", product: 6100, service: 4500, license: 2600, support: 2200 }
        ]

        // Donut chart data
        trafficSource = [
            { source: "Desktop", value: 55 },
            { source: "Mobile", value: 30 },
            { source: "Tablet", value: 15 }
        ]
    }

    view {
        col (style: "min-h-screen w-full bg-slate-50 p-6") {
        col (style: "max-w-5xl mx-auto w-full gap-8") {
            col (style: "gap-1") {
                h1 "Charts Gallery" { style: "text-3xl font-bold tracking-tight" }
                text "官方 Auto 组件族(line-chart/bar-chart/area-chart/donut-chart 裸名原语)——几何全部 Auto 计算,双端 SVG 直通" { style: "text-sm text-slate-500" }
            }

            // Area Chart(四系列)
            col (style: "w-full rounded-lg border bg-card shadow-sm") {
                col (style: "p-6 gap-4") {
                    text "Area Chart — Revenue Overview" { style: "text-lg font-semibold" }
                    area-chart (index: "month") {
                        data: .monthlyRevenue
                        fields: ["desktop", "mobile", "tablet", "wearable"]
                        labels: ["Desktop", "Mobile", "Tablet", "Wearable"]
                    }
                }
            }

            // Bar Chart(grouped)
            col (style: "w-full rounded-lg border bg-card shadow-sm") {
                col (style: "p-6 gap-4") {
                    text "Bar Chart — Quarterly Sales (Grouped)" { style: "text-lg font-semibold" }
                    bar-chart (index: "quarter") {
                        data: .quarterlySales
                        fields: ["product", "service", "license", "support"]
                        labels: ["Product", "Service", "License", "Support"]
                    }
                }
            }

            // Bar Chart(stacked)
            col (style: "w-full rounded-lg border bg-card shadow-sm") {
                col (style: "p-6 gap-4") {
                    text "Bar Chart — Quarterly Sales (Stacked)" { style: "text-lg font-semibold" }
                    bar-chart (index: "quarter") {
                        data: .quarterlySales
                        fields: ["product", "service"]
                        labels: ["Product", "Service"]
                        type: "stacked"
                    }
                }
            }

            // Line Chart(monotone 平滑曲线)
            col (style: "w-full rounded-lg border bg-card shadow-sm") {
                col (style: "p-6 gap-4") {
                    text "Line Chart — Trend Over Time (Monotone)" { style: "text-lg font-semibold" }
                    line-chart (index: "month") {
                        data: .monthlyRevenue
                        fields: ["desktop", "mobile"]
                        labels: ["Desktop", "Mobile"]
                        curve: "monotone"
                    }
                }
            }

            // Donut Chart
            col (style: "w-full rounded-lg border bg-card shadow-sm") {
                col (style: "p-6 gap-4") {
                    text "Donut Chart — Traffic Source" { style: "text-lg font-semibold" }
                    donut-chart (index: "source") {
                        data: .trafficSource
                        field: "value"
                    }
                }
            }

            // Area Chart(自定色)
            col (style: "w-full rounded-lg border bg-card shadow-sm") {
                col (style: "p-6 gap-4") {
                    text "Area Chart — Custom Colors" { style: "text-lg font-semibold" }
                    area-chart (index: "month") {
                        data: .monthlyRevenue
                        fields: ["desktop", "mobile"]
                        colors: ["#8b5cf6", "#f59e0b"]
                        labels: ["Desktop", "Mobile"]
                    }
                }
            }
        }
    }
    }
}
