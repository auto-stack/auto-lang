// app.at — bp-gate 宿主（PLAN-075 T-03；PLAN-665 T-02 增第四单元）。四单元
// 同页固定高度堆叠：
//   unit: status_bar —— layout/status-bar 骨架（fn-free 值 props）
//   unit: row_list   —— data-display/row-list 骨架（fn-free 值 props）
//   unit: filetree   —— navigation/filetree 组合形态（跨文件 fn 携带件，
//                        645 转译；075 G-6 后同文件 fn 通道亦在库）
//   unit: sandwich   —— layout/sandwich 骨架（fn-free slot 形态，PLAN-665；
//                        default 含 sidebar + full 嵌 content 出口的组合形态）
// 单元标记行（"unit: <id>"）在 root 视图——VM 臂 snapshot 可见（F-1：bp
// 子件子树不可见，内容断言走 root 投影字段：sb_*/rl_count/ft_count/sw_*；
// T-00 实证 snapshot v2(rendered) 已可见子树，sandwich 单元另加 slot 填充
// needle 双保险）。
// fixture 刻意四单元互斥词表（playwright 全页 needle 无歧义定位）。
use bps.layout.status_bar.reference.default: StatusBarSkeleton
use bps.data_display.row_list.reference.default: RowListSkeleton
use bps.navigation.filetree.reference.default: FileTree
use bps.navigation.filetree.tree_util: flatten_tree
use bps.layout.sandwich.reference.default: SandwichShell
use bps.layout.sandwich.reference.full: SandwichShellFull
use bps.layout.gallery_shell.reference.default: GalleryShell

widget App {
    msg { Init }

    model {
        // unit: status_bar —— 值 props 形态（desktop 版同款）
        var sb_left str = "3 backlinks"
        var sb_center str = "saved"
        var sb_right str = "1,024 words"

        // unit: row_list —— ASCII 词表（VM 字符串语义纪律 G-2：CJK 域禁索引算术）
        var rl_rows List = [
            { label: "alpha row", badge: "2" },
            { label: "beta row", badge: "" },
            { label: "gamma row", badge: "1" }
        ]
        var rl_count int = 3

        // unit: filetree —— node schema 全键书写（gotcha#3）
        var ft_nodes List = [
            { id: "wiki", label: "wiki", children: [
                { id: "wiki/方法", label: "方法", children: [
                    { id: "wiki/方法/探针.ad", label: "探针.ad", children: [], kind: "file", icon: "", is_leaf: true, badge: "" }
                ], kind: "dir", icon: "", is_leaf: false, badge: "" },
                { id: "wiki/引言.ad", label: "引言.ad", children: [], kind: "file", icon: "", is_leaf: false, badge: "" }
            ], kind: "dir", icon: "", is_leaf: false, badge: "" },
            { id: "另页.ad", label: "另页.ad", children: [], kind: "file", icon: "", is_leaf: true, badge: "" }
        ]
        var ft_expanded List = ["wiki"]
        var ft_rows List = []
        var ft_count int = 0

        // unit: sandwich —— 四口投影（VM 断言面；ASCII 词表纪律 G-2）
        var sw_slots str = "toolbar|sidebar|content|statusbar"
        var sw_content_rows int = 1
        var swf_slots str = "toolbar|content|statusbar"

        // unit: gallery_shell —— PLAN-676 AC-02（三画廊综合骨架；ASCII
        // 互斥词表。主题态归宿主契约#3：壳仅镜像 gs_dark/gs_accent 渲染
        // active 态，翻转经 on_* 上抛落宿主 gs_note 投影）
        var gs_items List = [
            { id: "gs/one", title: "gs title one", category: "form", badge: "" },
            { id: "gs/two", title: "gs title two", category: "layout", badge: "" }
        ]
        var gs_active str = "gs/one"
        var gs_dark bool = true
        var gs_accent str = "indigo"
        var gs_note str = ""
    }

    on {
        .Init -> {
            // VM 臂投影：root 级消费 tree_util 支撑件（组合件内部另有闭包副本，
            // 双处消费互不依赖）——展开态可见行数 = 4。
            .ft_rows = flatten_tree(.ft_nodes, .ft_expanded, true, "")
            .ft_count = .ft_rows.len()
        }
        .GsSelect(id) -> { .gs_active = id; .gs_note = "sel " + id }
        .GsSearch(q) -> { .gs_note = "search " + q }
        .GsTheme(mode) -> {
            if mode == "dark" {
                .gs_dark = true
            }
            if mode == "light" {
                .gs_dark = false
            }
            .gs_note = "theme " + mode
        }
        .GsAccent(name) -> { .gs_accent = name; .gs_note = "accent " + name }
    }

    view {
        col (style: "flex flex-col") {
            col (style: "flex h-52 flex-col justify-end border-b") {
                text "unit: status_bar" { style: "px-3 pt-2 text-xs text-muted-foreground" }
                StatusBarSkeleton (left: .sb_left, center: .sb_center, right: .sb_right) {}
            }
            col (style: "flex h-52 flex-col border-b") {
                text "unit: row_list" { style: "px-3 pt-2 text-xs text-muted-foreground" }
                RowListSkeleton (rows: .rl_rows, empty_text: "No items yet.") {}
            }
            col (style: "flex h-52 flex-col border-b") {
                text "unit: filetree" { style: "px-3 pt-2 text-xs text-muted-foreground" }
                FileTree (nodes: .ft_nodes, default_expanded: .ft_expanded) {}
            }
            // sandwich 单元 416px（=2×208 网格节奏；AC-04 几何断言要求
            // content 弹性区 ≥300px——h-52 单元容不下）。
            col (style: "flex h-[416px] flex-col") {
                text "unit: sandwich" { style: "px-3 pt-2 text-xs text-muted-foreground" }
                SandwichShell {
                    slot(name: "toolbar") {
                        text "sw toolbar" {}
                    }
                    slot(name: "sidebar") {
                        text "sw sidebar" {}
                    }
                    slot(name: "statusbar") {
                        text "sw status" {}
                    }
                    // content 默认出口 = 嵌套 full 变体（组合形态消费：
                    // 双变体同页 + G1 壳内壳证明）
                    SandwichShellFull {
                        slot(name: "toolbar") {
                            text "swf toolbar" {}
                        }
                        slot(name: "statusbar") {
                            text "swf status" {}
                        }
                        text "swf full content" {}
                    }
                }
            }
            // gallery_shell 单元 416px（PLAN-676：header/侧栏/popover 设置
            // 弹层 + on_* 回调契约首证；slot 互斥词表 gs*）。
            col (style: "flex h-[416px] flex-col") {
                text "unit: gallery_shell" { style: "px-3 pt-2 text-xs text-muted-foreground" }
                GalleryShell (items: .gs_items, active_id: .gs_active, dark_mode: .gs_dark, accent_color: .gs_accent, empty_text: "gs empty", on_select: .GsSelect, on_search: .GsSearch, on_set_theme: .GsTheme, on_set_accent: .GsAccent) {
                    slot(name: "brand") {
                        text "gs brand" {}
                    }
                    slot(name: "filters") {
                        row {
                            style: "gap-1 flex-wrap text-xs"
                            button "gs pill one" { style: "px-2 py-0.5 rounded-full border border-border" }
                            button "gs pill two" { style: "px-2 py-0.5 rounded-full border border-border" }
                        }
                    }
                    col {
                        text "gs content body" {}
                    }
                }
            }
        }
    }
}
