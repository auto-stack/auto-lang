// api.at — RealWorld (Conduit) API, stages 1 + 2.
// Stage 1: auth + feed + article detail + comments.
// Stage 2: article CRUD, post/delete comment, follow, favorite, profile.
// All endpoints delegate to db.rs (Plan 399 route B). Response is FLAT
// (not the RealWorld {article:{...}} wrapper).

/// A registered user. `token` is the mock JWT returned by login/register.
pub type User = {
    id: int
    email: str
    username: str
    bio: str
    image: str
    token: str
}

/// An article. `tagList` is comma-separated. Stage 2: slug is client-generated
/// (title→slug in the editor) to avoid server-side String ops (a2r borrow issues).
pub type Article = {
    slug: str
    title: str
    description: str
    body: str
    tagList: str
    author: str
    favoritesCount: int
    createdAt: str
}

/// A comment. `slug` is the article it belongs to.
pub type Comment = {
    id: int
    slug: str
    body: str
    author: str
    createdAt: str
}

/// A follow relationship (who follows whom).
pub type Follow = {
    follower_id: int
    followee_username: str
}

use db

// --- Stage 1: auth ---

#[api(method = "POST", path = "/api/users/login")]
pub fn login(email str, password str) User {
    return db.login(email, password)
}

#[api(method = "POST", path = "/api/users")]
pub fn register(username str, email str, password str) User {
    return db.register(username, email, password)
}

#[api(method = "GET", path = "/api/user")]
pub fn current_user() User {
    return db.current_user()
}

// --- Stage 1: articles (read) ---

#[api(method = "GET", path = "/api/articles")]
pub fn list_articles() []Article {
    return db.list_articles()
}

#[api(method = "GET", path = "/api/articles/:slug")]
pub fn get_article(slug str) ?Article {
    return db.get_article(slug)
}

#[api(method = "GET", path = "/api/articles/:slug/comments")]
pub fn list_comments(slug str) []Comment {
    return db.list_comments(slug)
}

// --- Stage 2: article CRUD ---

/// POST /api/articles — create. slug is supplied by the client (title→slug).
#[api(method = "POST", path = "/api/articles")]
pub fn create_article(slug str, title str, description str, body str, tagList str, author str) Article {
    return db.create_article(slug, title, description, body, tagList, author)
}

/// PUT /api/articles/:slug — edit title/description/body (slug stays; a real
/// impl would regenerate slug from new title, skipped to avoid String ops).
#[api(method = "PUT", path = "/api/articles/:slug")]
pub fn update_article(slug str, title str, description str, body str) Article {
    return db.update_article(slug, title, description, body)
}

/// DELETE /api/articles/:slug — remove an article (and its comments).
#[api(method = "DELETE", path = "/api/articles/:slug")]
pub fn delete_article(slug str) bool {
    return db.delete_article(slug)
}

// --- Stage 2: comments ---

/// POST /api/articles/:slug/comments — add a comment.
#[api(method = "POST", path = "/api/articles/:slug/comments")]
pub fn create_comment(slug str, body str, author str) Comment {
    return db.create_comment(slug, body, author)
}

/// DELETE /api/comments/:id — remove a comment by id. (Single path param: a2r
/// doesn't extract a second path param from /:slug/comments/:id correctly.)
#[api(method = "DELETE", path = "/api/comments/:id")]
pub fn delete_comment(id int) bool {
    return db.delete_comment(id)
}

// --- Stage 2: favorite ---

/// POST /api/articles/:slug/favorite — favorite (favoritesCount + 1).
#[api(method = "POST", path = "/api/articles/:slug/favorite")]
pub fn favorite_article(slug str) Article {
    return db.favorite_article(slug)
}

/// DELETE /api/articles/:slug/favorite — unfavorite (favoritesCount - 1, min 0).
#[api(method = "DELETE", path = "/api/articles/:slug/favorite")]
pub fn unfavorite_article(slug str) Article {
    return db.unfavorite_article(slug)
}

// --- Stage 2: profile + follow ---

/// GET /api/profiles/:username — a user's public profile. Returns empty User
/// (id=0) if not found.
#[api(method = "GET", path = "/api/profiles/:username")]
pub fn get_profile(username str) User {
    return db.get_profile(username)
}

/// POST /api/profiles/:username/follow — follow a user.
#[api(method = "POST", path = "/api/profiles/:username/follow")]
pub fn follow(username str) bool {
    return db.follow(username)
}

/// DELETE /api/profiles/:username/follow — unfollow.
#[api(method = "DELETE", path = "/api/profiles/:username/follow")]
pub fn unfollow(username str) bool {
    return db.unfollow(username)
}

// NOTE: no /api/tags endpoint — tags are derived client-side (a2r has no
// List<str>, and aggregating Strings server-side hits borrow-checker issues).
