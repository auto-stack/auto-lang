// app.at — App shell. Routes + top nav + outlet. Nav adapts to login state
// (.store.me.id != 0 = logged in). Cf. 018 app.at routes{...} + outlet.
use auth_store: AuthStore
use article_store: ArticleStore

widget App {
    routes {
        "/" -> use home
        "/login" -> use login
        "/register" -> use register
        "/article/:slug" -> use article_detail
        "/settings" -> use settings
        "/editor/:slug" -> use editor
        "/profile/:username" -> use profile
    }

    msg Msg { Init, Logout, GoProfile(str) }

    view {
        col {
            style: "min-h-screen font-serif text-gray-800"
            // Top nav
            row {
                style: "w-full border-b border-gray-200 px-4 py-3 max-w-3xl mx-auto items-center gap-4"
                link (to: "/") {
                    text "conduit" { style: "text-brand-green text-xl font-bold no-underline" }
                }
                row {
                    style: "ml-auto gap-4 text-sm"
                    link (to: "/") { text "Home" { style: "text-gray-600" } }
                    if .store.me != nil {
                        if .store.me.id != 0 {
                            link (to: "/editor/new") { text "New Post" { style: "text-gray-600" } }
                            link (to: "/settings") { text "Settings" { style: "text-gray-600" } }
                            text .store.me.username {
                                onclick: .GoProfile(.store.me.username)
                                style: "text-gray-600 cursor-pointer"
                            }
                        } else {
                            link (to: "/login") { text "Sign in" { style: "text-gray-600" } }
                            link (to: "/register") { text "Sign up" { style: "text-gray-600" } }
                        }
                    } else {
                        link (to: "/login") { text "Sign in" { style: "text-gray-600" } }
                        link (to: "/register") { text "Sign up" { style: "text-gray-600" } }
                    }
                }
            }
            // Route outlet
            col {
                outlet
            }
        }
    }

    on {
        .Init -> {
            store.Init()
            store.LoadFeed()
        }
        .Logout -> { store.Logout() }
        .GoProfile(username str) -> { router.push("/profile/" + username) }
    }
}
