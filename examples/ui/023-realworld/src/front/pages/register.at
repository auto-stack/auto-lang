// pages/register.at — register form. Cf. vue-ref Register.vue.
use auth_store: AuthStore

widget register {
    msg Msg { Init, UsernameChanged, EmailChanged, PasswordChanged, Submit }

    model {
        var username str = ""
        var email str = ""
        var password str = ""
        var error str = ""
    }

    view {
        col {
            style: "max-w-md mx-auto px-4 py-8 text-center items-center"
            text "Sign up" { style: "text-4xl font-semibold mb-2" }
            link (to: "/login") { text "Have an account?" { style: "text-brand-green text-sm" } }
            if .error != "" {
                text .error { style: "text-red-500 text-sm my-3 bg-red-50 rounded p-2 w-full" }
            }
            col {
                style: "text-left mt-4 gap-3 w-full"
                input {
                    placeholder: "Username",
                    value: .username,
                    oninput: .UsernameChanged,
                    style: "w-full px-3 py-2 border border-gray-300 rounded text-sm"
                }
                input {
                    placeholder: "Email",
                    value: .email,
                    oninput: .EmailChanged,
                    style: "w-full px-3 py-2 border border-gray-300 rounded text-sm"
                }
                input {
                    placeholder: "Password",
                    type: "password",
                    value: .password,
                    oninput: .PasswordChanged,
                    style: "w-full px-3 py-2 border border-gray-300 rounded text-sm"
                }
                row {
                    style: "justify-end"
                    button "Sign up" {
                        onclick: .Submit,
                        style: "px-5 py-2 rounded bg-brand-green text-white text-sm"
                    }
                }
            }
        }
    }

    on {
        .Init -> { }
        .UsernameChanged -> { .username = .username }
        .EmailChanged -> { .email = .email }
        .PasswordChanged -> { .password = .password }
        .Submit -> {
            if .username != "" {
                if .email != "" {
                    if .password != "" {
                        store.Register(.username, .email, .password)
                        router.push("/")
                    } else {
                        .error = "password is required"
                    }
                } else {
                    .error = "email is required"
                }
            } else {
                .error = "username is required"
            }
        }
    }
}
