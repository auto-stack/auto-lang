# Override parent .gitignore so the vue reference prototype + test manifest commit.
# The repo-root rules `examples/**/vue/` and `*.json` would otherwise swallow
# vue-ref/ and tests/package.json (cf. 018-book-reader/.gitignore).
!vue-ref/
!tests/package.json

# Generated / runtime artifacts (still ignored).
gen/
.auto/
dist/
build/
examples/
.am/
tests/node_modules/
tests/test-results/
tests/playwright-report/
