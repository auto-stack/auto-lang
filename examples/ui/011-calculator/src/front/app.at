// app.at — Calculator (Plan 403: expression engine + grid + multi-mode).
// Plan 504: 桌面化改造 —— 应用内 title bar / settings 面板移除（title/theme/
// accent 上移 pac.at + os-config，宿主 chrome 承接）；外壳改"内容即页面"
// （无 min-h-screen + center 包裹），配合 pac `window: "fit"` 窗口随内容收缩。
// is_digit/pow 等通用函数不再应用内手写 —— 静态分发到 str.is_digit() /
// math.pow()（Vue 端 TS 系统函数，VM 端 Rust 库函数）。
//
// Engine upgrade (需求 1c): the calculator now builds an expression STRING
// (e.g. "2*(3+4)") and evaluates it on "=" with full operator precedence,
// parentheses, and decimal support — via a shunting-yard evaluator (fn eval_expr).
// This replaces the old chained-integer engine (no precedence, no parens, int-only).
//
// Layout (需求 2): grid-based keypad (4-col). Multi-mode (需求 3): Basic /
// Scientific / Programmer layouts selected by a mode switch; the scientific grid
// adds parentheses + sin/cos/sqrt/etc; programmer adds hex/bin (display only).
//
// PLAN-615 T-07: Programmer 模式升格为完整 HEX 计算器——HEX/DEC/OCT/BIN 四基
// 切换 + 随基键盘（A-F）+ 四基实时换算读出 + 位运算六键（AND/OR/XOR/NOT/SHL/
// SHR）+ MOD。int 域即时执行（无表达式/优先级），32 位无符号 wrap；数值以
// 16-bit 肢对存储、肢运算库见 prog_util.at（双端 TS/VM 纯整型精确一致）。

use prog_util: pdigit_val, pdigit_new_lo, pdigit_new_hi, pop_lo, pop_hi, pdiv, pcur_fmt, pline_calc

widget App {
    msg {
        Digit(int),
        Operator(str),
        Paren(str),       // "(" or ")"
        Equals,
        Clear,
        ClearEntry,       // CE: clear current entry only
        Backspace,
        Negate,
        Dot,
        Percent,
        SciFn(str),       // sin, cos, tan, sqrt, etc. (scientific mode)
        SetMode(str),     // "basic" | "scientific" | "programmer"
        // PLAN-615 T-07: Programmer 模式（immediate-execution，32 位无符号域，
        // 16-bit 肢存储——双端 TS/VM 纯整型精确一致，见文件尾肢运算库注释）。
        PDigit(str),      // 数字/十六进制字母键（按当前 pbase 校验，非法忽略）
        POp(str),         // 二元运算键：+ - * / % AND OR XOR SHL SHR
        PNot,             // 一元 NOT（按位取反，立即作用于当前值）
        PEq,              // 等号
        PBack,            // 退格（当前输入）
        PBase(str)        // 基底切换：HEX | DEC | OCT | BIN
    }

    model {
        var dark_mode bool = true
        var accent_color str = "indigo"

        // Expression engine: the full expression being built (e.g. "2*(3+4)").
        var expr str = ""
        // The live display (what the user sees in the big readout).
        var display str = "0"
        // The small expression line above the display ("2 * (3 + 4) =").
        var expr_line str = ""
        // Error message (e.g. "Cannot divide by zero"); empty = OK.
        var error str = ""
        // Calculator mode.
        var mode str = "basic"

        // ── PLAN-615 T-07: Programmer 模式状态 ──
        // 当前基底：HEX | DEC | OCT | BIN。
        var pbase str = "DEC"
        // 32 位无符号累加器与当前输入，各拆 16-bit 肢（hi/lo，恒 < 65536，
        // 双端 int 精确；肢运算库见文件尾）。why 肢：VM `int` 状态存储截断
        // i32（2^31 以上不可存），TS number 与 VM 共同精确域为 < 2^53——
        // 肢化后一切存储 < 2^17、一切表达式中间值 < 2^48，两端零分歧。
        var pacc_hi int = 0
        var pacc_lo int = 0
        var pnum_hi int = 0
        var pnum_lo int = 0
        // 是否在输入数字中（false = 下一个数字键开启新输入）。
        var pentering bool = false
        // 待二元运算符（"" = 无）。+ - * / % AND OR XOR SHL SHR MOD
        var pop str = ""
        // Programmer 错误信息（除零）；空 = OK。
        var perr str = ""
    }

    // PLAN-615 T-07: Programmer 派生显示全部走 computed（模块纯函数，双端
    // 转译；Plan 522 范式）——处理器只写原始状态，视图零函数调用。
    computed {
        pbig => pcur_fmt(.pentering, .pnum_hi, .pnum_lo, .pacc_hi, .pacc_lo, .pbase)
        phex => pcur_fmt(.pentering, .pnum_hi, .pnum_lo, .pacc_hi, .pacc_lo, "HEX")
        pdec => pcur_fmt(.pentering, .pnum_hi, .pnum_lo, .pacc_hi, .pacc_lo, "DEC")
        poct => pcur_fmt(.pentering, .pnum_hi, .pnum_lo, .pacc_hi, .pacc_lo, "OCT")
        pbin => pcur_fmt(.pentering, .pnum_hi, .pnum_lo, .pacc_hi, .pacc_lo, "BIN")
        pline => pline_calc(.pop, .pacc_hi, .pacc_lo, .pnum_hi, .pnum_lo, .pbase)
    }

    view {
        col {
            // ── Display ──
            col {
                        // Mode tabs
                        row {
                            style: "w-full gap-1 p-1"
                            button "Basic" {
                                onclick: .SetMode("basic")
                                style: if .mode == "basic" {
                                    "flex-1 px-2 py-1 text-xs rounded bg-orange-500 text-white font-medium"
                                } else {
                                    if .dark_mode {
                                        "flex-1 px-2 py-1 text-xs rounded bg-zinc-800 text-zinc-300 hover:bg-zinc-700 transition-colors"
                                    } else {
                                        "flex-1 px-2 py-1 text-xs rounded bg-gray-200 text-gray-700 hover:bg-gray-300 transition-colors"
                                    }
                                }
                            }
                            button "Scientific" {
                                onclick: .SetMode("scientific")
                                style: if .mode == "scientific" {
                                    "flex-1 px-2 py-1 text-xs rounded bg-orange-500 text-white font-medium"
                                } else {
                                    if .dark_mode {
                                        "flex-1 px-2 py-1 text-xs rounded bg-zinc-800 text-zinc-300 hover:bg-zinc-700 transition-colors"
                                    } else {
                                        "flex-1 px-2 py-1 text-xs rounded bg-gray-200 text-gray-700 hover:bg-gray-300 transition-colors"
                                    }
                                }
                            }
                            button "Programmer" {
                                onclick: .SetMode("programmer")
                                style: if .mode == "programmer" {
                                    "flex-1 px-2 py-1 text-xs rounded bg-orange-500 text-white font-medium"
                                } else {
                                    if .dark_mode {
                                        "flex-1 px-2 py-1 text-xs rounded bg-zinc-800 text-zinc-300 hover:bg-zinc-700 transition-colors"
                                    } else {
                                        "flex-1 px-2 py-1 text-xs rounded bg-gray-200 text-gray-700 hover:bg-gray-300 transition-colors"
                                    }
                                }
                            }
                        }
                        // Expression + result（programmer 模式换用 pline/pbig——
                        // PLAN-615 T-07：int 域显示与 float 表达式引擎隔离）
                        if .mode == "programmer" {
                            text .pline {
                                style: if .dark_mode {
                                    "text-sm text-zinc-400 text-right w-full truncate"
                                } else {
                                    "text-sm text-gray-500 text-right w-full truncate"
                                }
                            }
                        } else {
                            text .expr_line {
                                style: if .dark_mode {
                                    "text-sm text-zinc-400 text-right w-full truncate"
                                } else {
                                    "text-sm text-gray-500 text-right w-full truncate"
                                }
                            }
                        }
                        if .error != "" {
                            text .error {
                                style: "text-2xl font-light text-red-400 text-right w-full"
                            }
                        } else {
                            if .mode == "programmer" {
                                text .pbig {
                                    style: if .dark_mode {
                                        "text-4xl font-light text-white text-right w-full truncate"
                                    } else {
                                        "text-4xl font-light text-gray-900 text-right w-full truncate"
                                    }
                                }
                            } else {
                                text .display {
                                    style: if .dark_mode {
                                        "text-4xl font-light text-white text-right w-full truncate"
                                    } else {
                                        "text-4xl font-light text-gray-900 text-right w-full truncate"
                                    }
                                }
                            }
                        }
                        // PLAN-615 T-08: 复制结果（剪贴板；VM auto.clipboard
                        // native 2926 / vue navigator.clipboard 双端）
                        row {
                            style: "w-full justify-end"
                            button "⧉ 复制" {
                                onclick: .Copy
                                style: "px-2 py-0.5 text-xs rounded bg-transparent text-muted-foreground hover:text-foreground"
                            }
                        }
                        // PLAN-615 T-07: Programmer 模式面板——基底切换 + 四基实时
                        // 换算读出（当前基高亮；其余行可点击直切）。语义 token 类
                        // （bg-primary/bg-muted/text-foreground…）随主题自动切换，
                        // 与 W3 主题链（T-04/05/06）直连，零手工 dark 分支。
                        if .mode == "programmer" {
                            if .perr == "" {
                                row {
                                    style: "w-full gap-1 pt-1"
                                    button "HEX" {
                                        onclick: .PBase("HEX")
                                        style: if .pbase == "HEX" {
                                            "flex-1 px-1 py-1 text-xs rounded-md bg-primary text-white font-semibold"
                                        } else {
                                            "flex-1 px-1 py-1 text-xs rounded-md bg-muted text-muted-foreground"
                                        }
                                    }
                                    button "DEC" {
                                        onclick: .PBase("DEC")
                                        style: if .pbase == "DEC" {
                                            "flex-1 px-1 py-1 text-xs rounded-md bg-primary text-white font-semibold"
                                        } else {
                                            "flex-1 px-1 py-1 text-xs rounded-md bg-muted text-muted-foreground"
                                        }
                                    }
                                    button "OCT" {
                                        onclick: .PBase("OCT")
                                        style: if .pbase == "OCT" {
                                            "flex-1 px-1 py-1 text-xs rounded-md bg-primary text-white font-semibold"
                                        } else {
                                            "flex-1 px-1 py-1 text-xs rounded-md bg-muted text-muted-foreground"
                                        }
                                    }
                                    button "BIN" {
                                        onclick: .PBase("BIN")
                                        style: if .pbase == "BIN" {
                                            "flex-1 px-1 py-1 text-xs rounded-md bg-primary text-white font-semibold"
                                        } else {
                                            "flex-1 px-1 py-1 text-xs rounded-md bg-muted text-muted-foreground"
                                        }
                                    }
                                }
                                button f"HEX  ${.phex}" {
                                    onclick: .PBase("HEX")
                                    style: if .pbase == "HEX" {
                                        "w-full text-right text-sm font-mono text-foreground bg-transparent px-0"
                                    } else {
                                        "w-full text-right text-sm font-mono text-muted-foreground bg-transparent px-0"
                                    }
                                }
                                button f"DEC  ${.pdec}" {
                                    onclick: .PBase("DEC")
                                    style: if .pbase == "DEC" {
                                        "w-full text-right text-sm font-mono text-foreground bg-transparent px-0"
                                    } else {
                                        "w-full text-right text-sm font-mono text-muted-foreground bg-transparent px-0"
                                    }
                                }
                                button f"OCT  ${.poct}" {
                                    onclick: .PBase("OCT")
                                    style: if .pbase == "OCT" {
                                        "w-full text-right text-sm font-mono text-foreground bg-transparent px-0"
                                    } else {
                                        "w-full text-right text-sm font-mono text-muted-foreground bg-transparent px-0"
                                    }
                                }
                                button f"BIN  ${.pbin}" {
                                    onclick: .PBase("BIN")
                                    style: if .pbase == "BIN" {
                                        "w-full text-right text-sm font-mono text-foreground bg-transparent px-0"
                                    } else {
                                        "w-full text-right text-sm font-mono text-muted-foreground bg-transparent px-0"
                                    }
                                }
                            }
                            if .perr != "" {
                                text .perr {
                                    style: "text-lg font-light text-red-400 text-right w-full"
                                }
                            }
                        }
                        style: if .dark_mode {
                            "w-full p-4 bg-zinc-900 rounded-t-2xl gap-1"
                        } else {
                            "w-full p-4 bg-gray-100 rounded-t-2xl gap-1 border-b border-gray-200"
                        }
                    }

                    // ── Keypad ──
                    // Basic + Scientific share the same grid; Scientific adds a
                    // top block of sci buttons. Programmer shows the basic grid
                    // (bit-logic operations are future work).
                    if .mode == "scientific" {
                        grid {
                            grid-item { button "sin" { onclick: .SciFn("sin"),  style: "w-full bg-indigo-700 text-white rounded-lg p-3 text-sm" } }
                            grid-item { button "cos" { onclick: .SciFn("cos"),  style: "w-full bg-indigo-700 text-white rounded-lg p-3 text-sm" } }
                            grid-item { button "tan" { onclick: .SciFn("tan"),  style: "w-full bg-indigo-700 text-white rounded-lg p-3 text-sm" } }
                            grid-item { button "sqrt" { onclick: .SciFn("sqrt"), style: "w-full bg-indigo-700 text-white rounded-lg p-3 text-sm" } }
                            grid-item { button "^" { onclick: .Operator("^"),    style: "w-full bg-indigo-700 text-white rounded-lg p-3 text-sm" } }
                            grid-item { button "pi" { onclick: .SciFn("pi"),    style: "w-full bg-indigo-700 text-white rounded-lg p-3 text-sm" } }
                            cols: 6
                            gap: 1
                            style: if .dark_mode {
                                "w-full px-2 pt-1 bg-zinc-800"
                            } else {
                                "w-full px-2 pt-1 bg-gray-200"
                            }
                        }
                    }

                    // Main keypad (shared by basic/scientific; PLAN-615 T-07 起
                    // programmer 使用专属 int 键盘，见下方 Programmer 键盘组)。
                    if .mode != "programmer" {
                    grid {
                        grid-item { button "C"   { onclick: .Clear,         style: if .dark_mode { "w-full bg-zinc-700 text-white rounded-lg p-4 text-lg" } else { "w-full bg-gray-300 text-gray-900 rounded-lg p-4 text-lg" } } }
                        grid-item { button "+/-" { onclick: .Negate,        style: if .dark_mode { "w-full bg-zinc-700 text-white rounded-lg p-4 text-lg" } else { "w-full bg-gray-300 text-gray-900 rounded-lg p-4 text-lg" } } }
                        grid-item { button "%"   { onclick: .Percent,       style: if .dark_mode { "w-full bg-zinc-700 text-white rounded-lg p-4 text-lg" } else { "w-full bg-gray-300 text-gray-900 rounded-lg p-4 text-lg" } } }
                        grid-item { button "/"   { onclick: .Operator("/"), style: "w-full bg-orange-500 text-white rounded-lg p-4 text-lg font-bold" } }

                        grid-item { button "7"   { onclick: .Digit(7),      style: if .dark_mode { "w-full bg-zinc-800 text-white rounded-lg p-4 text-lg" } else { "w-full bg-gray-200 text-gray-900 rounded-lg p-4 text-lg" } } }
                        grid-item { button "8"   { onclick: .Digit(8),      style: if .dark_mode { "w-full bg-zinc-800 text-white rounded-lg p-4 text-lg" } else { "w-full bg-gray-200 text-gray-900 rounded-lg p-4 text-lg" } } }
                        grid-item { button "9"   { onclick: .Digit(9),      style: if .dark_mode { "w-full bg-zinc-800 text-white rounded-lg p-4 text-lg" } else { "w-full bg-gray-200 text-gray-900 rounded-lg p-4 text-lg" } } }
                        grid-item { button "*"   { onclick: .Operator("*"), style: "w-full bg-orange-500 text-white rounded-lg p-4 text-lg font-bold" } }

                        grid-item { button "4"   { onclick: .Digit(4),      style: if .dark_mode { "w-full bg-zinc-800 text-white rounded-lg p-4 text-lg" } else { "w-full bg-gray-200 text-gray-900 rounded-lg p-4 text-lg" } } }
                        grid-item { button "5"   { onclick: .Digit(5),      style: if .dark_mode { "w-full bg-zinc-800 text-white rounded-lg p-4 text-lg" } else { "w-full bg-gray-200 text-gray-900 rounded-lg p-4 text-lg" } } }
                        grid-item { button "6"   { onclick: .Digit(6),      style: if .dark_mode { "w-full bg-zinc-800 text-white rounded-lg p-4 text-lg" } else { "w-full bg-gray-200 text-gray-900 rounded-lg p-4 text-lg" } } }
                        grid-item { button "-"   { onclick: .Operator("-"), style: "w-full bg-orange-500 text-white rounded-lg p-4 text-lg font-bold" } }

                        grid-item { button "1"   { onclick: .Digit(1),      style: if .dark_mode { "w-full bg-zinc-800 text-white rounded-lg p-4 text-lg" } else { "w-full bg-gray-200 text-gray-900 rounded-lg p-4 text-lg" } } }
                        grid-item { button "2"   { onclick: .Digit(2),      style: if .dark_mode { "w-full bg-zinc-800 text-white rounded-lg p-4 text-lg" } else { "w-full bg-gray-200 text-gray-900 rounded-lg p-4 text-lg" } } }
                        grid-item { button "3"   { onclick: .Digit(3),      style: if .dark_mode { "w-full bg-zinc-800 text-white rounded-lg p-4 text-lg" } else { "w-full bg-gray-200 text-gray-900 rounded-lg p-4 text-lg" } } }
                        grid-item { button "+"   { onclick: .Operator("+"), style: "w-full bg-orange-500 text-white rounded-lg p-4 text-lg font-bold" } }

                        grid-item { button "("   { onclick: .Paren("("),    style: if .dark_mode { "w-full bg-zinc-800 text-white rounded-lg p-4 text-lg" } else { "w-full bg-gray-200 text-gray-900 rounded-lg p-4 text-lg" } } }
                        grid-item { button "0"   { onclick: .Digit(0),      style: if .dark_mode { "w-full bg-zinc-800 text-white rounded-lg p-4 text-lg" } else { "w-full bg-gray-200 text-gray-900 rounded-lg p-4 text-lg" } } }
                        grid-item { button "."   { onclick: .Dot,           style: if .dark_mode { "w-full bg-zinc-800 text-white rounded-lg p-4 text-lg" } else { "w-full bg-gray-200 text-gray-900 rounded-lg p-4 text-lg" } } }
                        grid-item { button "="   { onclick: .Equals,        style: "w-full bg-orange-500 text-white rounded-lg p-4 text-lg font-bold" } }

                        grid-item { button ")"   { onclick: .Paren(")"),    style: if .dark_mode { "w-full bg-zinc-800 text-white rounded-lg p-4 text-lg" } else { "w-full bg-gray-200 text-gray-900 rounded-lg p-4 text-lg" } } }
                        grid-item { button "⌫"   { onclick: .Backspace,     style: if .dark_mode { "w-full bg-zinc-700 text-white rounded-lg p-4 text-lg" } else { "w-full bg-gray-300 text-gray-900 rounded-lg p-4 text-lg" } } }
                        grid-item { text ""      { style: "bg-transparent" } }
                        grid-item { text ""      { style: "bg-transparent" } }

                        cols: 4
                        gap: 1
                        style: if .dark_mode {
                            "w-full p-2 bg-zinc-800 rounded-b-2xl"
                        } else {
                            "w-full p-2 bg-gray-200 rounded-b-2xl"
                        }
                    }
                    }

                    // ── PLAN-615 T-07: Programmer 专属键盘组（immediate-execution
                    // int 域，32 位无符号）。全部语义 token 类随主题自动切换。
                    if .mode == "programmer" {
                        // 位运算排（AND OR XOR NOT / SHL SHR MOD ÷）
                        grid {
                            grid-item { button "AND" { onclick: .POp("AND"), style: "w-full bg-muted text-primary rounded-lg p-3 text-sm font-semibold" } }
                            grid-item { button "OR"  { onclick: .POp("OR"),  style: "w-full bg-muted text-primary rounded-lg p-3 text-sm font-semibold" } }
                            grid-item { button "XOR" { onclick: .POp("XOR"), style: "w-full bg-muted text-primary rounded-lg p-3 text-sm font-semibold" } }
                            grid-item { button "NOT" { onclick: .PNot,       style: "w-full bg-muted text-primary rounded-lg p-3 text-sm font-semibold" } }
                            grid-item { button "SHL" { onclick: .POp("SHL"), style: "w-full bg-muted text-primary rounded-lg p-3 text-sm font-semibold" } }
                            grid-item { button "SHR" { onclick: .POp("SHR"), style: "w-full bg-muted text-primary rounded-lg p-3 text-sm font-semibold" } }
                            grid-item { button "MOD" { onclick: .POp("MOD"), style: "w-full bg-muted text-primary rounded-lg p-3 text-sm font-semibold" } }
                            grid-item { button "÷"   { onclick: .POp("/"),   style: "w-full bg-muted text-primary rounded-lg p-3 text-sm font-semibold" } }
                            cols: 4
                            gap: 1
                            style: if .dark_mode {
                                "w-full px-2 pt-1 bg-zinc-800"
                            } else {
                                "w-full px-2 pt-1 bg-gray-200"
                            }
                        }
                        // HEX 字母排（非 HEX 基底灰显，处理器端亦忽略非法键）
                        grid {
                            grid-item { button "A" { onclick: .PDigit("A"), style: if .pbase == "HEX" { "w-full bg-card text-foreground rounded-lg p-3 text-base font-mono" } else { "w-full bg-card text-foreground rounded-lg p-3 text-base font-mono opacity-30" } } }
                            grid-item { button "B" { onclick: .PDigit("B"), style: if .pbase == "HEX" { "w-full bg-card text-foreground rounded-lg p-3 text-base font-mono" } else { "w-full bg-card text-foreground rounded-lg p-3 text-base font-mono opacity-30" } } }
                            grid-item { button "C" { onclick: .PDigit("C"), style: if .pbase == "HEX" { "w-full bg-card text-foreground rounded-lg p-3 text-base font-mono" } else { "w-full bg-card text-foreground rounded-lg p-3 text-base font-mono opacity-30" } } }
                            grid-item { button "D" { onclick: .PDigit("D"), style: if .pbase == "HEX" { "w-full bg-card text-foreground rounded-lg p-3 text-base font-mono" } else { "w-full bg-card text-foreground rounded-lg p-3 text-base font-mono opacity-30" } } }
                            grid-item { button "E" { onclick: .PDigit("E"), style: if .pbase == "HEX" { "w-full bg-card text-foreground rounded-lg p-3 text-base font-mono" } else { "w-full bg-card text-foreground rounded-lg p-3 text-base font-mono opacity-30" } } }
                            grid-item { button "F" { onclick: .PDigit("F"), style: if .pbase == "HEX" { "w-full bg-card text-foreground rounded-lg p-3 text-base font-mono" } else { "w-full bg-card text-foreground rounded-lg p-3 text-base font-mono opacity-30" } } }
                            cols: 3
                            gap: 1
                            style: if .dark_mode {
                                "w-full px-2 pt-1 bg-zinc-800"
                            } else {
                                "w-full px-2 pt-1 bg-gray-200"
                            }
                        }
                        // 主 int 键盘（BIN 时 2-9 灰显；OCT 时 8-9 灰显——
                        // 灰显条件用嵌套 if 表达，视图条件不用布尔算符）
                        grid {
                            grid-item { button "C" { onclick: .Clear,       style: "w-full bg-muted text-foreground rounded-lg p-4 text-lg" } }
                            grid-item { button "⌫" { onclick: .PBack,       style: "w-full bg-muted text-foreground rounded-lg p-4 text-lg" } }
                            grid-item { text ""      { style: "bg-transparent" } }
                            grid-item { button "÷" { onclick: .POp("/"),    style: "w-full bg-primary text-white rounded-lg p-4 text-lg font-bold" } }

                            grid-item { button "7" { onclick: .PDigit("7"), style: if .pbase == "BIN" { "w-full bg-card text-foreground rounded-lg p-4 text-lg opacity-30" } else { "w-full bg-card text-foreground rounded-lg p-4 text-lg" } } }
                            grid-item { button "8" { onclick: .PDigit("8"), style: if .pbase == "DEC" { "w-full bg-card text-foreground rounded-lg p-4 text-lg" } else { if .pbase == "HEX" { "w-full bg-card text-foreground rounded-lg p-4 text-lg" } else { "w-full bg-card text-foreground rounded-lg p-4 text-lg opacity-30" } } } }
                            grid-item { button "9" { onclick: .PDigit("9"), style: if .pbase == "DEC" { "w-full bg-card text-foreground rounded-lg p-4 text-lg" } else { if .pbase == "HEX" { "w-full bg-card text-foreground rounded-lg p-4 text-lg" } else { "w-full bg-card text-foreground rounded-lg p-4 text-lg opacity-30" } } } }
                            grid-item { button "×" { onclick: .POp("*"),    style: "w-full bg-primary text-white rounded-lg p-4 text-lg font-bold" } }

                            grid-item { button "4" { onclick: .PDigit("4"), style: if .pbase == "BIN" { "w-full bg-card text-foreground rounded-lg p-4 text-lg opacity-30" } else { "w-full bg-card text-foreground rounded-lg p-4 text-lg" } } }
                            grid-item { button "5" { onclick: .PDigit("5"), style: if .pbase == "BIN" { "w-full bg-card text-foreground rounded-lg p-4 text-lg opacity-30" } else { "w-full bg-card text-foreground rounded-lg p-4 text-lg" } } }
                            grid-item { button "6" { onclick: .PDigit("6"), style: if .pbase == "BIN" { "w-full bg-card text-foreground rounded-lg p-4 text-lg opacity-30" } else { "w-full bg-card text-foreground rounded-lg p-4 text-lg" } } }
                            grid-item { button "−" { onclick: .POp("-"),    style: "w-full bg-primary text-white rounded-lg p-4 text-lg font-bold" } }

                            grid-item { button "1" { onclick: .PDigit("1"), style: "w-full bg-card text-foreground rounded-lg p-4 text-lg" } }
                            grid-item { button "2" { onclick: .PDigit("2"), style: if .pbase == "BIN" { "w-full bg-card text-foreground rounded-lg p-4 text-lg opacity-30" } else { "w-full bg-card text-foreground rounded-lg p-4 text-lg" } } }
                            grid-item { button "3" { onclick: .PDigit("3"), style: if .pbase == "BIN" { "w-full bg-card text-foreground rounded-lg p-4 text-lg opacity-30" } else { "w-full bg-card text-foreground rounded-lg p-4 text-lg" } } }
                            grid-item { button "+" { onclick: .POp("+"),    style: "w-full bg-primary text-white rounded-lg p-4 text-lg font-bold" } }

                            grid-item { button "0" { onclick: .PDigit("0"), style: "w-full bg-card text-foreground rounded-lg p-4 text-lg" } }
                            grid-item { text ""      { style: "bg-transparent" } }
                            grid-item { text ""      { style: "bg-transparent" } }
                            grid-item { button "="   { onclick: .PEq,       style: "w-full bg-primary text-white rounded-lg p-4 text-lg font-bold" } }

                            cols: 4
                            gap: 1
                            style: if .dark_mode {
                                "w-full p-2 bg-zinc-800 rounded-b-2xl"
                            } else {
                                "w-full p-2 bg-gray-200 rounded-b-2xl"
                            }
                        }
                    }

                    style: if .dark_mode {
                        "w-96 bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-2xl"
                    } else {
                        "w-96 bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-xl"
                    }
        }
    }

    bind {
        "Enter" -> .Equals
        "Escape" -> .Clear
        "Backspace" -> .Backspace
        // PLAN-615 T-08: 键盘直输——bind 语法零参（parser.rs parse_bind_block
        // 仅收 .Name），模式路由在 Key 处理器内完成；HEX 字母绑双大小写。
        "0" -> .Key0
        "1" -> .Key1
        "2" -> .Key2
        "3" -> .Key3
        "4" -> .Key4
        "5" -> .Key5
        "6" -> .Key6
        "7" -> .Key7
        "8" -> .Key8
        "9" -> .Key9
        "a" -> .KeyA
        "A" -> .KeyA
        "b" -> .KeyB
        "B" -> .KeyB
        "c" -> .KeyC
        "C" -> .KeyC
        "d" -> .KeyD
        "D" -> .KeyD
        "e" -> .KeyE
        "E" -> .KeyE
        "f" -> .KeyF
        "F" -> .KeyF
        "+" -> .KeyAdd
        "-" -> .KeySub
        "*" -> .KeyMul
        "/" -> .KeyDiv
        "=" -> .Equals
    }

    on {
        // PLAN-615 T-08: 复制当前显示值（programmer 走 pcur_fmt 重算——
        // computed 值不经状态通道）
        .Copy -> {
            if .mode == "programmer" {
                let v str = pcur_fmt(.pentering, .pnum_hi, .pnum_lo, .pacc_hi, .pacc_lo, .pbase)
                dom.copy_text(v)
            } else {
                dom.copy_text(.display)
            }
        }
        // ── PLAN-615 T-08: 零参 Key 处理器族（bind 语法零参约束下的
        // 模式感知路由；肢乘加复用 prog_util.pdigit_new_lo/hi）──
                .Key0 -> {
            if .mode == "programmer" {
                var base int = 10
                if .pbase == "HEX" {
                    base = 16
                }
                if .pbase == "OCT" {
                    base = 8
                }
                if .pbase == "BIN" {
                    base = 2
                }
                var d int = pdigit_val("0", base)
                if d >= 0 {
                    .perr = ""
                    if !.pentering {
                        .pnum_hi = 0
                        .pnum_lo = 0
                        .pentering = true
                    }
                    var nl int = pdigit_new_lo(.pnum_lo, base, d)
                    var nh int = pdigit_new_hi(.pnum_hi, .pnum_lo, base, d)
                    .pnum_lo = nl
                    .pnum_hi = nh
                }
            } else {
                .expr = .expr + "0"
                .display = .expr
                .error = ""
            }
        }
                .Key1 -> {
            if .mode == "programmer" {
                var base int = 10
                if .pbase == "HEX" {
                    base = 16
                }
