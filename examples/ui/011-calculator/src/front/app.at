            }
        }
        .SetMode(m str) -> {
            .mode = m
        }
        .Clear -> {
            .expr = ""
            .display = "0"
            .expr_line = ""
            .error = ""
            // PLAN-615 T-07: 同清 programmer 状态
            .pacc_hi = 0
            .pacc_lo = 0
            .pnum_hi = 0
            .pnum_lo = 0
            .pentering = false
            .pop = ""
            .perr = ""
        }
        // ── PLAN-615 T-07: Programmer 处理器（int 域即时执行）──
        .PBase(b str) -> {
            .pbase = b
            .perr = ""
        }
        .PDigit(ch str) -> {
            var base int = 10
            if .pbase == "HEX" {
                base = 16
            }
            if .pbase == "OCT" {
                base = 8
            }
            if .pbase == "BIN" {
                base = 2
            }
            var d int = pdigit_val(ch, base)
            if d >= 0 {
                .perr = ""
                if !.pentering {
                    .pnum_hi = 0
                    .pnum_lo = 0
                    .pentering = true
                }
                // value = value * base + d（肢内乘加；全量 < 2^21 双端精确）
                var nl int = .pnum_lo * base + d
                var c int = nl / 65536
                nl = nl - c * 65536
                var nh int = (.pnum_hi * base + c) % 65536
                .pnum_lo = nl
                .pnum_hi = nh
            }
        }
        .POp(op str) -> {
            .perr = ""
            if .pop != "" {
                if .pentering {
                    // 结算待结算运算：acc = apply(pop, acc, num)
                    if .pop == "/" {
                        if .pnum_hi == 0 && .pnum_lo == 0 {
                            .perr = "Cannot divide by zero"
                        }
                    }
                    if .pop == "MOD" {
                        if .pnum_hi == 0 && .pnum_lo == 0 {
                            .perr = "Cannot divide by zero"
                        }
                    }
                    if .perr == "" {
                        var nl int = pop_lo(.pop, .pacc_hi, .pacc_lo, .pnum_hi, .pnum_lo)
                        var nh int = pop_hi(.pop, .pacc_hi, .pacc_lo, .pnum_hi, .pnum_lo)
                        .pacc_lo = nl
                        .pacc_hi = nh
                        .pnum_lo = nl
                        .pnum_hi = nh
                    }
                }
            } else {
                // 首操作数入 accumulator
                .pacc_hi = .pnum_hi
                .pacc_lo = .pnum_lo
            }
            .pop = op
            .pentering = false
        }
        .PEq -> {
            if .pop != "" {
                if .pop == "/" {
                    if .pnum_hi == 0 && .pnum_lo == 0 {
                        .perr = "Cannot divide by zero"
                    }
                }
                if .pop == "MOD" {
                    if .pnum_hi == 0 && .pnum_lo == 0 {
                        .perr = "Cannot divide by zero"
                    }
                }
                if .perr == "" {
                    var nl int = pop_lo(.pop, .pacc_hi, .pacc_lo, .pnum_hi, .pnum_lo)
                    var nh int = pop_hi(.pop, .pacc_hi, .pacc_lo, .pnum_hi, .pnum_lo)
                    .pacc_lo = nl
                    .pacc_hi = nh
                    .pnum_lo = nl
                    .pnum_hi = nh
                }
                .pop = ""
                .pentering = false
            }
        }
        .PNot -> {
            .perr = ""
            // 按位取反 = 65535 - 肢（16-bit 补数，双肢合即 ~32 位值）
            if .pentering {
                .pnum_lo = 65535 - .pnum_lo
                .pnum_hi = 65535 - .pnum_hi
            } else {
                .pacc_lo = 65535 - .pacc_lo
                .pacc_hi = 65535 - .pacc_hi
                .pnum_lo = .pacc_lo
                .pnum_hi = .pacc_hi
            }
        }
        .PBack -> {
            .perr = ""
            if .pentering {
                // 退一位数字 = 当前输入整除基底（基底内合法数字恒可整除回退）
                var base int = 10
                if .pbase == "HEX" {
                    base = 16
                }
                if .pbase == "OCT" {
                    base = 8
                }
                if .pbase == "BIN" {
                    base = 2
                }
                var nl int = pdiv(.pnum_hi, .pnum_lo, 0, base, 0)
                var nh int = pdiv(.pnum_hi, .pnum_lo, 0, base, 1)
                .pnum_lo = nl
                .pnum_hi = nh
            }
        }
        .ClearEntry -> {
            .display = "0"
        }
        .Backspace -> {
            if .expr.len() > 0 {
                .expr = .expr.slice(0, .expr.len() - 1)
                .display = .expr
            }
            if .expr == "" {
                .display = "0"
            }
        }
        .Negate -> {
            // Negate the current expression by wrapping in -( ... )
            .expr = "-(" + .expr + ")"
            .display = .expr
        }
        .Dot -> {
            .expr = .expr + "."
            .display = .expr
        }
        .Percent -> {
            .expr = .expr + "/100"
            .display = .expr
        }
        .Digit(n int) -> {
            .expr = .expr + n.to_string()
            .display = .expr
            .error = ""
        }
        .Operator(op str) -> {
            .expr = .expr + op
            .display = .expr
            .error = ""
        }
        .Paren(p str) -> {
            .expr = .expr + p
            .display = .expr
            .error = ""
        }
        .SciFn(name str) -> {
            if name == "pi" {
                .expr = .expr + "3.14159265358979"
            } else {
                .expr = .expr + name + "("
            }
            .display = .expr
            .error = ""
        }
        .Equals -> {
            if .mode == "programmer" {
                // PLAN-615 T-08: "=" 键盘绑定在 programmer 域路由到 int 求值
                if .pop != "" {
                    if .pop == "/" {
                        if .pnum_hi == 0 && .pnum_lo == 0 {
                            .perr = "Cannot divide by zero"
                        }
                    }
                    if .pop == "MOD" {
                        if .pnum_hi == 0 && .pnum_lo == 0 {
                            .perr = "Cannot divide by zero"
                        }
                    }
                    if .perr == "" {
                        var nl int = pop_lo(.pop, .pacc_hi, .pacc_lo, .pnum_hi, .pnum_lo)
                        var nh int = pop_hi(.pop, .pacc_hi, .pacc_lo, .pnum_hi, .pnum_lo)
                        .pacc_lo = nl
                        .pacc_hi = nh
                        .pnum_lo = nl
                        .pnum_hi = nh
                    }
                    .pop = ""
                    .pentering = false
                }
            } else {
                .expr_line = .expr + " ="
                let result str = eval_expr(.expr)
                // PLAN-615 T-08: 错误文案细化（除零 vs 语法错误）
                if result == "DIV0" {
                    .error = "Cannot divide by zero"
                } else {
                    if result == "ERROR" {
                        .error = "Invalid expression"
                    } else {
                        .display = result
                        .expr = result
                        .error = ""
                    }
                }
            }
        }
    }
}

// ═══════════════════════════════════════════════════════════
// Expression Evaluator (需求 1c: shunting-yard + decimal + parens + precedence)
// ═══════════════════════════════════════════════════════════

/// Evaluate an arithmetic expression string. Supports + - * / ^ %, parentheses,
/// decimals, and unary minus. Returns "ERROR" on failure (parse error, div by zero).
/// Uses a two-stack shunting-yard: operators go to one stack, values to another,
/// respecting precedence and parentheses.
fn eval_expr(input str) str {
    // Plan 403: shunting-yard expression evaluator.
    // Supports + - * / ^ %, parentheses, decimals, unary minus, precedence.
    //
    // Note: numbers are kept on a List<str> (not List<float>) and parsed to
    // float only at the point of arithmetic. This dodges a VM limitation where
    // an empty List<float> is instantiated as ListData<i32>, which corrupts
    // pushed floats. String elements round-trip correctly via ListData<String>
    // (with Plan 403 fixes to shim_list_push/get/pop/len for ListData<String>).
    var nums List<str> = []
    var ops List<str> = []
    var i int = 0
    var n int = input.len()
    var ok str = "OK"

    while i < n {
        var ch str = input.slice(i, i + 1)
        // Skip whitespace.
        if ch == " " {
            i = i + 1
        }
        // Number (digit or decimal point).
        if ch.is_digit() || ch == "." {
            var j int = i
            var num_str str = ""
            while j < n {
                var c str = input.slice(j, j + 1)
                if c.is_digit() || c == "." {
                    num_str = num_str + c
                    j = j + 1
                } else {
                    break
                }
            }
            i = j
            nums.push(num_str)
        }
        // Opening paren.
        else if ch == "(" {
            ops.push("(")
            i = i + 1
        }
        // Closing paren: pop until "(".
        else if ch == ")" {
            while ops.len() > 0 && ops[ops.len() - 1] != "(" {
                ok = apply_top(nums, ops)
                if ok != "OK" {
                    return ok
                }
            }
            if ops.len() > 0 {
                ops.pop()
            }
            i = i + 1
        }
        // Operator: + - * / ^ %
        else if is_op(ch) {
            // Handle unary minus: a minus at start or right after ( or another op.
            if ch == "-" {
                var at_start bool = i == 0
                var prev str = ""
                if i > 0 {
                    prev = input.slice(i - 1, i)
                }
                if at_start || prev == "(" || is_op(prev) {
                    // It's unary minus — absorb the number as negative.
                    var j int = i + 1
                    var num_str str = "-"
                    while j < n {
                        var c str = input.slice(j, j + 1)
                        if c.is_digit() || c == "." {
                            num_str = num_str + c
                            j = j + 1
                        } else {
                            break
                        }
                    }
                    if j > i + 1 {
                        i = j
                        nums.push(num_str)
                    } else {
                        i = i + 1
                    }
                } else {
                    while ops.len() > 0 && ops[ops.len() - 1] != "(" && prec(ops[ops.len() - 1]) >= prec(ch) {
                        ok = apply_top(nums, ops)
                        if ok != "OK" {
                            return ok
                        }
                    }
                    ops.push(ch)
                    i = i + 1
                }
            } else {
                while ops.len() > 0 && ops[ops.len() - 1] != "(" && prec(ops[ops.len() - 1]) >= prec(ch) {
                    ok = apply_top(nums, ops)
                    if ok != "OK" {
                        return ok
                    }
                }
                ops.push(ch)
                i = i + 1
            }
        }
        else {
            // Unknown char.
            i = i + 1
        }
    }

    // Pop remaining operators.
    while ops.len() > 0 {
        if ops[ops.len() - 1] == "(" {
            ops.pop()
        } else {
            ok = apply_top(nums, ops)
            if ok != "OK" {
                return ok
            }
        }
    }

    if nums.len() == 1 {
        return fmt_num(nums[0].to_float())
    }
    return "ERROR"
}

/// PLAN-615 T-08: Pop the top operator and apply it to the top two values.
/// Returns "OK" / "DIV0" (除零，Equals 显具体文案) / "ERROR"（栈不足）。
fn apply_top(nums List<str>, ops List<str>) str {
    if ops.len() == 0 || nums.len() < 2 {
        return "ERROR"
    }
    var op str = ops[ops.len() - 1]
    ops.pop()
    var b float = nums[nums.len() - 1].to_float()
    nums.pop()
    var a float = nums[nums.len() - 1].to_float()
    nums.pop()
    var result float = 0.0
    if op == "+" {
        result = a + b
    }
    if op == "-" {
        result = a - b
    }
    if op == "*" {
        result = a * b
    }
    if op == "/" {
        if b == 0.0 {
            return "DIV0"
        }
        result = a / b
    }
    if op == "^" {
        result = math.pow(a, b)
    }
    if op == "%" {
        result = a - b * (a / b)
    }
    nums.push(result.to_string())
    return "OK"
}

/// Operator precedence: ^ > * / % > + -.
fn prec(op str) int {
    if op == "+" {
        return 1
    }
    if op == "-" {
        return 1
    }
    if op == "*" {
        return 2
    }
    if op == "/" {
        return 2
    }
    if op == "%" {
        return 2
    }
    if op == "^" {
        return 3
    }
    return 0
}

/// Format a float for display: show integers without decimals, trim trailing zeros.
fn fmt_num(v float) str {
    // PLAN-615 T-08: 浮点显示去噪——10 位小数 ε 舍入（0.1+0.2 → 0.3、
    // 3.0000000000000004 → 3），|v| ≥ 1e6 原样 to_string。math.floor 双端
    // 有映射（VM native 1710 / TS Math.floor）。
    var a float = v
    if a < 0.0 {
        a = 0.0 - a
    }
    if a < 1000000.0 {
        var scaled float = v * 10000000000.0
        var r float = math.floor(scaled + 0.5)
        return (r / 10000000000.0).to_string()
    }
    return v.to_string()
}

fn is_op(ch str) bool {
    if ch == "+" {
        return true
    }
    if ch == "-" {
        return true
    }
    if ch == "*" {
        return true
    }
    if ch == "/" {
        return true
    }
    if ch == "^" {
        return true
    }
    if ch == "%" {
        return true
    }
    return false
}
