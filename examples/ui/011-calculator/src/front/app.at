                }
            }
        }
                .KeyAdd -> {
            if .mode == "programmer" {
                .perr = ""
                if .pop != "" {
                    if .pentering {
                        if .pop == "/" {
                            if .pnum_hi == 0 && .pnum_lo == 0 {
                                .perr = "Cannot divide by zero"
                            }
                        }
                        if .perr == "" {
                            var nl int = pop_lo(.pop, .pacc_hi, .pacc_lo, .pnum_hi, .pnum_lo)
                            var nh int = pop_hi(.pop, .pacc_hi, .pacc_lo, .pnum_hi, .pnum_lo)
                            .pacc_lo = nl
                            .pacc_hi = nh
                            .pnum_lo = nl
                            .pnum_hi = nh
                        }
                    }
                } else {
                    .pacc_hi = .pnum_hi
                    .pacc_lo = .pnum_lo
                }
                .pop = "+"
                .pentering = false
            } else {
                .expr = .expr + "+"
                .display = .expr
                .error = ""
            }
        }
                .KeySub -> {
