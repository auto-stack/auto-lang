// app.at — Calculator (Plan 403: grid layout + unified handlers).
// Integer-only four-function calculator. The keypad uses a `grid` (CSS grid in
// vue, column-of-rows in iced) instead of nested col/row — one container, no
// per-button flex-1. Digit/operator handlers are unified via parametric
// messages (Digit(int), Operator(str)) to remove ~200 lines of duplication.
widget App {
    msg Msg {
        Digit(int),
        Operator(str),
        Equals,
        Clear,
        Negate,
        Dot,
        Percent
    }

    model {
        var display str = "0"
        var val int = 0
        var prev int = 0
        var op str = ""
        var fresh bool = true
        var expr str = ""
    }

    view {
        center {
            col {
                // Display
                col {
                    text .expr {
                        style: "text-sm text-gray-400 text-right w-full"
                    }
                    text .display {
                        style: "text-4xl font-light text-white text-right w-full"
                    }
                    style: "w-full p-6 bg-gray-900 rounded-t-2xl"
                }

                // Button keypad — a single grid replaces 5 nested row blocks.
                // cols:4 lays out 20 buttons in a 4×5 grid; the last row holds
                // 0/.//= (4 cells). grid-item forwards its child's style.
                grid {
                    grid-item { button "C"   { onclick: .Clear,            style: "bg-gray-600 text-white rounded-lg p-4 text-lg" } }
                    grid-item { button "+/-" { onclick: .Negate,           style: "bg-gray-600 text-white rounded-lg p-4 text-lg" } }
                    grid-item { button "%"   { onclick: .Percent,          style: "bg-gray-600 text-white rounded-lg p-4 text-lg" } }
                    grid-item { button "/"   { onclick: .Operator("/"),    style: "bg-orange-500 text-white rounded-lg p-4 text-lg font-bold" } }

                    grid-item { button "7"   { onclick: .Digit(7),         style: "bg-gray-700 text-white rounded-lg p-4 text-lg" } }
                    grid-item { button "8"   { onclick: .Digit(8),         style: "bg-gray-700 text-white rounded-lg p-4 text-lg" } }
                    grid-item { button "9"   { onclick: .Digit(9),         style: "bg-gray-700 text-white rounded-lg p-4 text-lg" } }
                    grid-item { button "*"   { onclick: .Operator("*"),    style: "bg-orange-500 text-white rounded-lg p-4 text-lg font-bold" } }

                    grid-item { button "4"   { onclick: .Digit(4),         style: "bg-gray-700 text-white rounded-lg p-4 text-lg" } }
                    grid-item { button "5"   { onclick: .Digit(5),         style: "bg-gray-700 text-white rounded-lg p-4 text-lg" } }
                    grid-item { button "6"   { onclick: .Digit(6),         style: "bg-gray-700 text-white rounded-lg p-4 text-lg" } }
                    grid-item { button "-"   { onclick: .Operator("-"),    style: "bg-orange-500 text-white rounded-lg p-4 text-lg font-bold" } }

                    grid-item { button "1"   { onclick: .Digit(1),         style: "bg-gray-700 text-white rounded-lg p-4 text-lg" } }
                    grid-item { button "2"   { onclick: .Digit(2),         style: "bg-gray-700 text-white rounded-lg p-4 text-lg" } }
                    grid-item { button "3"   { onclick: .Digit(3),         style: "bg-gray-700 text-white rounded-lg p-4 text-lg" } }
                    grid-item { button "+"   { onclick: .Operator("+"),    style: "bg-orange-500 text-white rounded-lg p-4 text-lg font-bold" } }

                    grid-item { button "0"   { onclick: .Digit(0),         style: "bg-gray-700 text-white rounded-lg p-4 text-lg" } }
                    grid-item { button "."   { onclick: .Dot,              style: "bg-gray-700 text-white rounded-lg p-4 text-lg" } }
                    grid-item { button "="   { onclick: .Equals,           style: "bg-orange-500 text-white rounded-lg p-4 text-lg font-bold" } }
                    grid-item { text ""      { style: "bg-transparent" } }
                    cols: 4
                    gap: 1
                    style: "w-full p-2 bg-gray-800 rounded-b-2xl"
                }

                style: "w-80 bg-gray-900 rounded-2xl overflow-hidden shadow-xl"
            }
        }
    }

    bind {
        // Note: bind only supports parameter-less messages, so digit/operator
        // keys are driven via button presses (UI click + MCP autoui_action
        // press), not keyboard. Only control keys are bound here.
        "Enter" -> .Equals
        "Escape" -> .Clear
        "Backspace" -> .Clear
    }

    on {
        .Clear -> {
            .display = "0"
            .val = 0
            .prev = 0
            .op = ""
            .fresh = true
            .expr = ""
        }
        .Negate -> {
            .val = 0 - .val
            .display = .val
        }
        .Dot -> {
            // Decimal not supported with int-only math (placeholder for Plan 403 engine upgrade).
        }
        .Percent -> {
            // Percent: divide current value by 100 (e.g. 50 % -> 0).
            .val = .val / 100
            .display = .val
        }
        // Unified digit handler: append digit n to the current value.
        .Digit(n int) -> {
            if .fresh {
                .display = n.to_string()
                .val = n
            } else {
                .display = .display + n.to_string()
                .val = .val * 10 + n
            }
            .fresh = false
        }
        // Unified operator handler: if there's a pending op, compute it first,
        // then install the new operator (chained, left-to-right, no precedence).
        .Operator(new_op str) -> {
            if .op == "+" {
                .val = .prev + .val
            }
            if .op == "-" {
                .val = .prev - .val
            }
            if .op == "*" {
                .val = .prev * .val
            }
            if .op == "/" {
                if .val != 0 {
                    .val = .prev / .val
                }
            }
            if .op != "" {
                .display = .val
            }
            .expr = .display + " " + new_op
            .prev = .val
            .op = new_op
            .fresh = true
        }
        .Equals -> {
            if .op != "" {
                // Build expression BEFORE computing (e.g. "1 + 2 =")
                .expr = .expr + " " + .display + " ="
                // Compute the pending operation
                if .op == "+" {
                    .val = .prev + .val
                }
                if .op == "-" {
                    .val = .prev - .val
                }
                if .op == "*" {
                    .val = .prev * .val
                }
                if .op == "/" {
                    if .val != 0 {
                        .val = .prev / .val
                    }
                }
                .display = .val
                .prev = 0
                .op = ""
                .fresh = true
            }
        }
    }
}
