// src/front/performance.at — Performance monitor view
// Displays mini rail selector, big SVG area curves, per-core sparklines, and system hardware specifications.

use sys_store: SysStore

widget PerformanceView {
    msg {
        SelectPerf(str)
    }

    view {
        col (style: "gap-6") {
            // ---- Master-Detail Layout: Mini Rail on Left + Big Chart & Details on Right ----
            row (style: "gap-6 items-start") {
                // ---- Mini Rail (Left 1/4) ----
                col (style: "w-64 shrink-0 gap-3") {
                    // CPU Card
                    col (onclick: .SelectPerf("cpu"), style: if .store.perf_tab == "cpu" { "p-3 rounded-lg border-2 border-[#2563eb] bg-card cursor-pointer shadow-sm" } else { "p-3 rounded-lg border bg-card/60 hover:bg-card cursor-pointer" }) {
                        row (style: "items-center justify-between") {
                            text "CPU" { style: "text-xs font-semibold text-muted-foreground uppercase" }
                            span (style: "w-2 h-2 rounded-full bg-[#2563eb]") {}
                        }
                        text .store.cpuLabel { style: "text-xl font-bold tracking-tight" }
                        text f"${.store.cpuCount} 核心" { style: "text-xs text-muted-foreground" }
                    }

                    // Memory Card
                    col (onclick: .SelectPerf("mem"), style: if .store.perf_tab == "mem" { "p-3 rounded-lg border-2 border-[#16a34a] bg-card cursor-pointer shadow-sm" } else { "p-3 rounded-lg border bg-card/60 hover:bg-card cursor-pointer" }) {
                        row (style: "items-center justify-between") {
                            text "内存" { style: "text-xs font-semibold text-muted-foreground uppercase" }
                            span (style: "w-2 h-2 rounded-full bg-[#16a34a]") {}
                        }
                        text .store.memLabel { style: "text-xl font-bold tracking-tight" }
                        text f"${.store.memUsedMb} MB 已用" { style: "text-xs text-muted-foreground" }
                    }

                    // Disk Card
                    col (onclick: .SelectPerf("disk"), style: if .store.perf_tab == "disk" { "p-3 rounded-lg border-2 border-[#8b5cf6] bg-card cursor-pointer shadow-sm" } else { "p-3 rounded-lg border bg-card/60 hover:bg-card cursor-pointer" }) {
                        row (style: "items-center justify-between") {
                            text "磁盘" { style: "text-xs font-semibold text-muted-foreground uppercase" }
                            span (style: "w-2 h-2 rounded-full bg-[#8b5cf6]") {}
                        }
                        text .store.diskLabel { style: "text-xl font-bold tracking-tight" }
                        text f"${.store.disks.len()} 个驱动器" { style: "text-xs text-muted-foreground" }
                    }

                    // Network Card
                    col (onclick: .SelectPerf("net"), style: if .store.perf_tab == "net" { "p-3 rounded-lg border-2 border-[#d97706] bg-card cursor-pointer shadow-sm" } else { "p-3 rounded-lg border bg-card/60 hover:bg-card cursor-pointer" }) {
                        row (style: "items-center justify-between") {
                            text "网络" { style: "text-xs font-semibold text-muted-foreground uppercase" }
                            span (style: "w-2 h-2 rounded-full bg-[#d97706]") {}
                        }
                        text .store.netLabel { style: "text-xl font-bold tracking-tight" }
                        text f"↑${.store.netSentKbs} ↓${.store.netRecvKbs}" { style: "text-xs text-muted-foreground" }
                    }
                }

                // ---- Main Performance Chart Panel (Right 3/4) ----
                col (style: "flex-1 gap-4") {
                    col (style: "rounded-lg border bg-card p-5 gap-3 shadow-sm") {
                        // Title header
                        row (style: "items-center justify-between") {
                            if .store.perf_tab == "cpu" {
                                row (style: "items-center gap-2") {
                                    span (style: "w-3 h-3 rounded-sm bg-[#2563eb]") {}
                                    text "CPU 使用率实时曲线" { style: "text-base font-semibold" }
                                    text "0 - 100 % (60秒滑窗)" { style: "text-xs text-muted-foreground" }
                                }
                            }
                            if .store.perf_tab == "mem" {
                                row (style: "items-center gap-2") {
                                    span (style: "w-3 h-3 rounded-sm bg-[#16a34a]") {}
                                    text "内存使用量实时曲线" { style: "text-base font-semibold" }
                                    text f"0 - ${.store.memTotalMb} MB" { style: "text-xs text-muted-foreground" }
                                }
                            }
                            if .store.perf_tab == "disk" {
                                row (style: "items-center gap-2") {
                                    span (style: "w-3 h-3 rounded-sm bg-[#8b5cf6]") {}
                                    text "磁盘总 I/O 速率" { style: "text-base font-semibold" }
                                    text "KB/s (自适应标尺)" { style: "text-xs text-muted-foreground" }
                                }
                            }
                            if .store.perf_tab == "net" {
                                row (style: "items-center gap-2") {
                                    span (style: "w-3 h-3 rounded-sm bg-[#d97706]") {}
                                    text "网络吞吐速率" { style: "text-base font-semibold" }
                                    text "KB/s (自适应标尺)" { style: "text-xs text-muted-foreground" }
                                }
                            }
                        }

                        // Big SVG Chart
                        row (style: "items-stretch") {
                            col (style: "w-10 shrink-0 justify-between items-end pr-1 pt-0 pb-4") {
                                text "100" { style: "text-[10px] text-muted-foreground" }
                                text "75" { style: "text-[10px] text-muted-foreground" }
                                text "50" { style: "text-[10px] text-muted-foreground" }
                                text "25" { style: "text-[10px] text-muted-foreground" }
                                text "0" { style: "text-[10px] text-muted-foreground" }
                            }
                            svg (viewBox: "0 0 560 134", style: "w-full h-44") {
                                path (d: "M30 14 H36 M30 40 H36 M30 67 H36 M30 94 H36", stroke: "#94a3b8", stroke-width: "1") {}
                                path (d: "M36 40 H540 M36 67 H540 M36 94 H540", stroke: "#e2e8f0", stroke-width: "1", stroke-dasharray: "4 4") {}
                                line (x1: "36", y1: "120", x2: "540", y2: "120", stroke: "#94a3b8", stroke-width: "1") {}
                                line (x1: "36", y1: "14", x2: "36", y2: "120", stroke: "#94a3b8", stroke-width: "1") {}

                                if .store.perf_tab == "cpu" {
                                    path (d: .store.cpuArea, fill: "#2563eb", fill-opacity: "0.2") {}
                                    path (d: .store.cpuLine, fill: "none", stroke: "#2563eb", stroke-width: "2.5", stroke-linejoin: "round", stroke-linecap: "round") {}
                                }
                                if .store.perf_tab == "mem" {
                                    path (d: .store.memArea, fill: "#16a34a", fill-opacity: "0.2") {}
                                    path (d: .store.memLine, fill: "none", stroke: "#16a34a", stroke-width: "2.5", stroke-linejoin: "round", stroke-linecap: "round") {}
                                }
                                if .store.perf_tab == "disk" {
                                    path (d: .store.diskArea, fill: "#8b5cf6", fill-opacity: "0.2") {}
                                    path (d: .store.diskLine, fill: "none", stroke: "#8b5cf6", stroke-width: "2.5", stroke-linejoin: "round", stroke-linecap: "round") {}
                                }
                                if .store.perf_tab == "net" {
                                    path (d: .store.netArea, fill: "#d97706", fill-opacity: "0.2") {}
                                    path (d: .store.netLine, fill: "none", stroke: "#d97706", stroke-width: "2.5", stroke-linejoin: "round", stroke-linecap: "round") {}
                                }
                            }
                        }
                    }

                    // Sub-panel based on current perf tab
                    if .store.perf_tab == "cpu" {
                        // Per-Core Sparkline Grid
                        col (style: "rounded-lg border bg-card p-4 gap-3 shadow-sm") {
                            row (style: "items-center justify-between") {
                                text "逻辑核心使用率" { style: "text-sm font-semibold" }
                                badge (text: f"${.store.cpuCount} 核心", variant: "secondary") {}
                            }
                            row (style: "grid grid-cols-4 md:grid-cols-5 gap-2") {
                                for i, core in .store.cores {
                                    col (style: "p-2 rounded border bg-muted/20 gap-1") {
                                        row (style: "items-center justify-between") {
                                            text f"核 ${i}" { style: "text-[11px] text-muted-foreground" }
                                            text f"${core} %" { style: "text-xs font-mono font-semibold" }
                                        }
                                        row (style: "w-full h-1.5 rounded-full bg-muted overflow-hidden") {
                                            span (style: "h-full bg-[#2563eb] block rounded-full w-full") {}
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if .store.perf_tab == "mem" {
                        col (style: "rounded-lg border bg-card p-4 gap-3 shadow-sm") {
                            text "内存构成与详情" { style: "text-sm font-semibold" }
                            row (style: "grid grid-cols-3 gap-4") {
                                col (style: "p-3 rounded border bg-muted/20 gap-1") {
                                    text "总物理内存" { style: "text-xs text-muted-foreground" }
                                    text f"${.store.memTotalMb} MB" { style: "text-lg font-bold font-mono" }
                                }
                                col (style: "p-3 rounded border bg-muted/20 gap-1") {
                                    text "已使用内存" { style: "text-xs text-muted-foreground" }
                                    text f"${.store.memUsedMb} MB" { style: "text-lg font-bold font-mono text-[#16a34a]" }
                                }
                                col (style: "p-3 rounded border bg-muted/20 gap-1") {
                                    text "可用内存" { style: "text-xs text-muted-foreground" }
                                    text f"${.store.memTotalMb - .store.memUsedMb} MB" { style: "text-lg font-bold font-mono text-muted-foreground" }
                                }
                            }
                        }
                    }

                    if .store.perf_tab == "disk" {
                        col (style: "rounded-lg border bg-card p-4 gap-3 shadow-sm") {
                            text "已挂载驱动器列表" { style: "text-sm font-semibold" }
                            row (style: "grid grid-cols-2 gap-3") {
                                for d in .store.disks {
                                    col (style: "p-3 rounded border bg-muted/20 gap-2") {
                                        row (style: "items-center justify-between") {
                                            text f"${d.mount} ${d.name}" { style: "text-sm font-bold" }
                                            badge (text: f"可用 ${d.avail_mb} MB", variant: "secondary") {}
                                        }
                                        text f"总量 ${d.total_mb} MB / 已用 ${d.total_mb - d.avail_mb} MB" { style: "text-xs text-muted-foreground" }
                                        row (style: "w-full h-2 rounded-full bg-muted overflow-hidden") {
                                            span (style: "h-full bg-[#8b5cf6] block rounded-full w-2/3") {}
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if .store.perf_tab == "net" {
                        col (style: "rounded-lg border bg-card p-4 gap-3 shadow-sm") {
                            text "网络接口流量统计" { style: "text-sm font-semibold" }
                            row (style: "grid grid-cols-2 gap-4") {
                                col (style: "p-3 rounded border bg-muted/20 gap-1") {
                                    text "当前上传速率" { style: "text-xs text-muted-foreground" }
                                    text f"${.store.netSentKbs} KB/s" { style: "text-lg font-bold font-mono text-[#d97706]" }
                                }
                                col (style: "p-3 rounded border bg-muted/20 gap-1") {
                                    text "当前下载速率" { style: "text-xs text-muted-foreground" }
                                    text f"${.store.netRecvKbs} KB/s" { style: "text-lg font-bold font-mono text-[#2563eb]" }
                                }
                            }
                        }
                    }

                    // ---- Hardware & System Spec Cards (Always Visible at Bottom) ----
                    col (style: "rounded-lg border bg-card p-4 gap-3 shadow-sm") {
                        text "系统与硬件基础信息" { style: "text-sm font-semibold" }
                        row (style: "grid grid-cols-2 md:grid-cols-3 gap-3") {
                            col (style: "p-2.5 rounded border bg-muted/10 gap-0.5") {
                                text "操作系统" { style: "text-[11px] text-muted-foreground" }
                                text f"${.store.osName} ${.store.osVersion}" { style: "text-xs font-semibold truncate" }
                            }
                            col (style: "p-2.5 rounded border bg-muted/10 gap-0.5") {
                                text "内核版本" { style: "text-[11px] text-muted-foreground" }
                                text .store.kernel { style: "text-xs font-semibold truncate" }
                            }
                            col (style: "p-2.5 rounded border bg-muted/10 gap-0.5") {
                                text "计算机名" { style: "text-[11px] text-muted-foreground" }
                                text .store.hostname { style: "text-xs font-semibold truncate" }
                            }
                            col (style: "p-2.5 rounded border bg-muted/10 gap-0.5") {
                                text "处理器型号" { style: "text-[11px] text-muted-foreground" }
                                text .store.cpuBrand { style: "text-xs font-semibold truncate" }
                            }
                            col (style: "p-2.5 rounded border bg-muted/10 gap-0.5") {
                                text "处理器规格" { style: "text-[11px] text-muted-foreground" }
                                text f"${.store.cpuCount} 个逻辑核心" { style: "text-xs font-semibold truncate" }
                            }
                            col (style: "p-2.5 rounded border bg-muted/10 gap-0.5") {
                                text "系统运行时间" { style: "text-[11px] text-muted-foreground" }
                                text .store.uptimeLabel { style: "text-xs font-semibold truncate" }
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .SelectPerf(tab) -> { store.SelectPerfTab(tab) }
    }
}
