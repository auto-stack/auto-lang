// types.at — PLAN-684：ProcInfo 显示串字段（1 位小数，store 回填）。
type SysSummary {
    cpu float
    cpu_count int
    cpu_brand str
    mem_used_mb int
    mem_total_mb int
    net_sent_kbs float
    net_recv_kbs float
    proc_count int
    os_name str
    os_version str
    kernel str
    hostname str
    uptime_s int
}

type ProcInfo {
    pid int
    name str
    cpu float
    mem_mb int
    disk_kbs float
    net_kbs float
    status str
    cpu_s str
    mem_s str
    disk_s str
    net_s str
}

type DiskInfo {
    name str
    mount str
    total_gb float
    used_gb float
}

type CoreInfo {
    name str
    usage float
}

type UserInfo {
    name str
    proc_count int
    mem_mb int
}

type Snapshot {
    summary ?SysSummary
    procs []ProcInfo
    disks []DiskInfo
    cores []CoreInfo
    users []UserInfo
}
