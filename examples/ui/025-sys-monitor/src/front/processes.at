// src/front/processes.at — Process list. PLAN-684：去选中横幅；右键结束；
// 紧凑表 + 1 位小数显示串；名称窄列。
use sys_store: SysStore

widget ProcessesView {
    msg {
        SelectProc(int), RequestKill, CancelKill, ConfirmKill,
        RowCtx(int), CloseCtx,
        SortName, SortCpu, SortMem, SortDisk, SortNet
    }

    view {
        col (style: "gap-3") {
            row (style: "grid grid-cols-2 md:grid-cols-4 gap-2") {
                col (style: "rounded-lg border bg-card px-3 py-2 gap-0.5 shadow-sm") {
                    row (style: "items-center justify-between") {
                        text "CPU" { style: "text-[10px] font-semibold text-muted-foreground uppercase" }
                        span (style: "w-1.5 h-1.5 rounded-full bg-[#2563eb]") {}
                    }
                    text .store.cpuLabel { style: "text-lg font-bold tabular-nums" }
                    text f"${.store.cpuCount} 核" { style: "text-[10px] text-muted-foreground truncate" }
                }
                col (style: "rounded-lg border bg-card px-3 py-2 gap-0.5 shadow-sm") {
                    row (style: "items-center justify-between") {
                        text "内存" { style: "text-[10px] font-semibold text-muted-foreground uppercase" }
                        span (style: "w-1.5 h-1.5 rounded-full bg-[#16a34a]") {}
                    }
                    text .store.memLabel { style: "text-lg font-bold tabular-nums" }
                    text f"已用 ${.store.memUsedMb} MB" { style: "text-[10px] text-muted-foreground truncate" }
                }
                col (style: "rounded-lg border bg-card px-3 py-2 gap-0.5 shadow-sm") {
                    row (style: "items-center justify-between") {
                        text "磁盘" { style: "text-[10px] font-semibold text-muted-foreground uppercase" }
                        span (style: "w-1.5 h-1.5 rounded-full bg-[#8b5cf6]") {}
                    }
                    text .store.diskLabel { style: "text-lg font-bold tabular-nums" }
                    text f"${.store.disks.len()} 卷" { style: "text-[10px] text-muted-foreground truncate" }
                }
                col (style: "rounded-lg border bg-card px-3 py-2 gap-0.5 shadow-sm") {
                    row (style: "items-center justify-between") {
                        text "网络" { style: "text-[10px] font-semibold text-muted-foreground uppercase" }
                        span (style: "w-1.5 h-1.5 rounded-full bg-[#d97706]") {}
                    }
                    text .store.netLabel { style: "text-lg font-bold tabular-nums" }
                    text f"↑${.store.netSent_s} ↓${.store.netRecv_s}" { style: "text-[10px] text-muted-foreground truncate" }
                }
            }

            alert-dialog (open: .store.kill_dialog_open) {
                alert-dialog-content {
                    alert-dialog-header {
                        alert-dialog-title "结束任务"
                        alert-dialog-description f"确定结束 ${.store.kill_target_name} (PID ${.store.kill_target})？未保存数据可能丢失。"
                    }
                    alert-dialog-footer {
                        alert-dialog-cancel "取消" { onclick: .CancelKill }
                        alert-dialog-action "结束进程" { onclick: .ConfirmKill }
                    }
                }
            }

            if .store.ctx_open {
                col (style: "fixed inset-0 z-40") {
                    onclick: .CloseCtx
                    col {
                        style: "absolute bg-card border rounded-md shadow-lg py-1 min-w-[120px]"
                        style: "left:" + .store.ctx_x.to_string() + "px;top:" + .store.ctx_y.to_string() + "px"
                        row {
                            onclick: .RequestKill
                            style: "px-3 py-1.5 text-xs text-destructive hover:bg-destructive/10 cursor-pointer"
                            text "结束进程" {}
                        }
                    }
                }
            }

            col (style: "rounded-lg border bg-card shadow-sm overflow-hidden") {
                row (style: "items-center justify-between px-3 py-2 border-b") {
                    row (style: "items-center gap-2") {
                        text "进程列表" { style: "text-sm font-semibold" }
                        badge (text: f"${.store.procCount}", variant: "secondary") {}
                    }
                    text "右键结束 · 点表头排序" { style: "text-[10px] text-muted-foreground" }
                }
                table {
                    table-header {
                        table-row (style: "bg-muted/30") {
                            table-head (onclick: .SortName, text: .store.nameH, style: "text-left text-xs text-muted-foreground font-medium px-2 py-1.5 cursor-pointer select-none w-[140px]") {}
                            table-head (onclick: .SortCpu, text: .store.cpuH, style: "text-right text-xs text-muted-foreground font-medium px-2 py-1.5 cursor-pointer select-none tabular-nums") {}
                            table-head (onclick: .SortMem, text: .store.memH, style: "text-right text-xs text-muted-foreground font-medium px-2 py-1.5 cursor-pointer select-none tabular-nums") {}
                            table-head (onclick: .SortDisk, text: .store.diskH, style: "text-right text-xs text-muted-foreground font-medium px-2 py-1.5 cursor-pointer select-none tabular-nums") {}
                            table-head (onclick: .SortNet, text: .store.netH, style: "text-right text-xs text-muted-foreground font-medium px-2 py-1.5 cursor-pointer select-none tabular-nums") {}
                        }
                    }
                    table-body {
                        for p in .store.procsView {
                            table-row (key: p.pid, onclick: .SelectProc(p.pid), oncontextmenu.prevent: .RowCtx(p.pid), style: if p.pid == .store.selected_pid { "bg-accent text-accent-foreground cursor-pointer" } else { "cursor-pointer hover:bg-muted/40" }) {
                                table-cell (text: p.name, style: "text-xs font-medium px-2 py-1 truncate max-w-[140px]") {}
                                table-cell (text: p.cpu_s, style: "text-right text-xs px-2 py-1 tabular-nums") {}
                                table-cell (text: p.mem_s, style: "text-right text-xs px-2 py-1 tabular-nums") {}
                                table-cell (text: p.disk_s, style: "text-right text-xs px-2 py-1 tabular-nums text-muted-foreground") {}
                                table-cell (text: p.net_s, style: "text-right text-xs px-2 py-1 tabular-nums text-muted-foreground") {}
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .SelectProc(pid) -> { store.SelectProc(pid) }
        .RowCtx(pid) -> { store.RowCtx(pid) }
        .CloseCtx -> { store.CloseCtx() }
        .RequestKill -> { store.RequestKill() }
        .CancelKill -> { store.CancelKill() }
        .ConfirmKill -> { store.ConfirmKill() }
        .SortName -> { store.SortName() }
        .SortCpu -> { store.SortCpu() }
        .SortMem -> { store.SortMem() }
        .SortDisk -> { store.SortDisk() }
        .SortNet -> { store.SortNet() }
    }
}
