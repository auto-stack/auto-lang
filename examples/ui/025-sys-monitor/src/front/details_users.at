// src/front/details_users.at — Details and Users view
// Details tab: Full process table with PID column, user column, and process termination.
// Users tab: Per-user aggregation of processes and memory consumption.

use sys_store: SysStore

widget DetailsUsersView {
    msg {
        SelectProc(int), RequestKill, CancelKill, ConfirmKill,
        SortName, SortCpu, SortMem, SortPid
    }

    view {
        col (style: "gap-6") {
            if .store.active_tab == "details" {
                // ---- Details View: Full Process Table with PID ----
                col (style: "gap-4") {
                    // Action Bar
                    row (style: "items-center justify-between bg-card p-3 rounded-lg border shadow-sm") {
                        row (style: "items-center gap-3") {
                            if .store.selected_pid > 0 {
                                badge (text: f"PID: ${.store.selected_pid}", variant: "default") {}
                                text f"${.store.selected_proc_name}" { style: "text-sm font-semibold" }
                            } else {
                                text "详细信息视图 — 支持按 PID 排序与详细属性检索" { style: "text-sm text-muted-foreground" }
                            }
                        }
                        row (style: "items-center gap-2") {
                            if .store.selected_pid > 0 {
                                button "结束任务" {
                                    onclick: .RequestKill,
                                    style: "px-3 py-1.5 text-xs font-medium rounded-md bg-destructive text-destructive-foreground hover:bg-destructive/90 shadow-sm"
                                }
                            } else {
                                button "结束任务" {
                                    style: "px-3 py-1.5 text-xs font-medium rounded-md border bg-muted text-muted-foreground opacity-50 cursor-not-allowed"
                                }
                            }
                        }
                    }

                    // Alert Dialog
                    alert-dialog (open: .store.kill_dialog_open) {
                        alert-dialog-content {
                            alert-dialog-header {
                                alert-dialog-title "结束进程详细确认"
                                alert-dialog-description f"您确定要强制终止进程 ${.store.kill_target_name} (PID: ${.store.kill_target}) 吗？"
                            }
                            alert-dialog-footer {
                                alert-dialog-cancel "取消" { onclick: .CancelKill }
                                alert-dialog-action "强制终止" { onclick: .ConfirmKill }
                            }
                        }
                    }

                    // Table
                    col (style: "rounded-lg border bg-card p-4 gap-3 shadow-sm") {
                        table {
                            table-header {
                                table-row {
                                    table-head (onclick: .SortPid, text: .store.pidH, style: "w-24 cursor-pointer select-none") {}
                                    table-head (onclick: .SortName, text: .store.nameH, style: "cursor-pointer select-none") {}
                                    table-head (text: "状态", style: "w-28 text-center") {}
                                    table-head (text: "运行用户", style: "w-44") {}
                                    table-head (onclick: .SortCpu, text: .store.cpuH, style: "w-28 text-right cursor-pointer select-none") {}
                                    table-head (onclick: .SortMem, text: .store.memH, style: "w-32 text-right cursor-pointer select-none") {}
                                }
                            }
                            table-body {
                                for p in .store.procsView {
                                    table-row (key: p.pid, onclick: .SelectProc(p.pid), style: if p.pid == .store.selected_pid { "bg-accent text-accent-foreground cursor-pointer" } else { "cursor-pointer hover:bg-muted/50" }) {
                                        table-cell (text: f"${p.pid}", style: "font-mono font-medium") {}
                                        table-cell (text: p.name, style: "font-medium") {}
                                        table-cell (style: "text-center") {
                                            if p.status == "running" {
                                                badge (text: "运行中", variant: "default") {}
                                            } else {
                                                badge (text: p.status, variant: "secondary") {}
                                            }
                                        }
                                        table-cell (text: p.user, style: "text-xs text-muted-foreground truncate max-w-[170px]") {}
                                        table-cell (text: f"${p.cpu} %", style: "text-right font-mono") {}
                                        table-cell (text: f"${p.mem_mb} MB", style: "text-right font-mono") {}
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if .store.active_tab == "users" {
                // ---- Users View: Per-user process & resource aggregation ----
                col (style: "gap-4") {
                    row (style: "items-center justify-between") {
                        col (style: "gap-0.5") {
                            text "已登录与系统用户账户" { style: "text-base font-semibold" }
                            text "按系统账户聚合查看运行中的进程与内存使用" { style: "text-xs text-muted-foreground" }
                        }
                        badge (text: f"共 ${.store.users.len()} 个用户", variant: "secondary") {}
                    }

                    row (style: "grid grid-cols-1 md:grid-cols-2 gap-4") {
                        for u in .store.users {
                            col (style: "p-4 rounded-lg border bg-card shadow-sm gap-3") {
                                row (style: "items-center justify-between") {
                                    row (style: "items-center gap-3") {
                                        span (style: "w-9 h-9 rounded-full bg-primary/10 flex items-center justify-center text-base") {
                                            text "👤" {}
                                        }
                                        col (style: "gap-0.5") {
                                            text u { style: "text-sm font-bold" }
                                            text "活动会话" { style: "text-xs text-muted-foreground" }
                                        }
                                    }
                                    badge (text: "正常", variant: "outline") {}
                                }

                                // User processes summary list
                                col (style: "border-t pt-2 gap-1.5") {
                                    text "运行在该账户下的主要进程:" { style: "text-xs font-semibold text-muted-foreground" }
                                    for p in .store.procs {
                                        if p.user == u {
                                            row (style: "items-center justify-between text-xs py-0.5") {
                                                text p.name { style: "font-medium truncate max-w-[200px]" }
                                                row (style: "items-center gap-2 font-mono text-muted-foreground") {
                                                    text f"${p.cpu}%" {}
                                                    text f"${p.mem_mb}MB" {}
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .SelectProc(pid) -> { store.SelectProc(pid) }
        .RequestKill -> { store.RequestKill() }
        .CancelKill -> { store.CancelKill() }
        .ConfirmKill -> { store.ConfirmKill() }
        .SortName -> { store.SortName() }
        .SortCpu -> { store.SortCpu() }
        .SortMem -> { store.SortMem() }
        .SortPid -> { store.SortPid() }
    }
}
