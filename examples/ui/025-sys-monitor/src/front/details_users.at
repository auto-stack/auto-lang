// details_users.at — Details view（用户页已退役，PLAN-684）。
use sys_store: SysStore

widget DetailsUsersView {
    msg {
        SelectProc(int), RequestKill, CancelKill, ConfirmKill,
        RowCtx(int), CloseCtx, SortName, SortCpu, SortMem
    }

    view {
        col (style: "gap-3") {
            alert-dialog (open: .store.kill_dialog_open) {
                alert-dialog-content {
                    alert-dialog-header {
                        alert-dialog-title "结束任务"
                        alert-dialog-description f"确定结束 ${.store.kill_target_name} (PID ${.store.kill_target})？"
                    }
                    alert-dialog-footer {
                        alert-dialog-cancel "取消" { onclick: .CancelKill }
                        alert-dialog-action "结束进程" { onclick: .ConfirmKill }
                    }
                }
            }

            if .store.ctx_open {
                col (style: "fixed inset-0 z-40") {
                    onclick: .CloseCtx
                    col {
                        style: "absolute bg-card border rounded-md shadow-lg py-1 min-w-[120px]"
                        style: "left:" + .store.ctx_x.to_string() + "px;top:" + .store.ctx_y.to_string() + "px"
                        row {
                            onclick: .RequestKill
                            style: "px-3 py-1.5 text-xs text-destructive hover:bg-destructive/10 cursor-pointer"
                            text "结束进程" {}
                        }
                    }
                }
            }

            col (style: "rounded-lg border bg-card shadow-sm overflow-hidden") {
                row (style: "items-center justify-between px-3 py-2 border-b") {
                    text "进程详情" { style: "text-sm font-semibold" }
                    text "右键结束" { style: "text-[10px] text-muted-foreground" }
                }
                table {
                    table-header {
                        table-row (style: "bg-muted/30") {
                            table-head (text: "PID", style: "text-right text-xs text-muted-foreground font-medium px-2 py-1.5 w-16 tabular-nums") {}
                            table-head (onclick: .SortName, text: .store.nameH, style: "text-left text-xs text-muted-foreground font-medium px-2 py-1.5 cursor-pointer select-none w-[140px]") {}
                            table-head (onclick: .SortCpu, text: .store.cpuH, style: "text-right text-xs text-muted-foreground font-medium px-2 py-1.5 cursor-pointer select-none tabular-nums") {}
                            table-head (onclick: .SortMem, text: .store.memH, style: "text-right text-xs text-muted-foreground font-medium px-2 py-1.5 cursor-pointer select-none tabular-nums") {}
                            table-head (text: "状态", style: "text-center text-xs text-muted-foreground font-medium px-2 py-1.5 w-16") {}
                        }
                    }
                    table-body {
                        for p in .store.procsView {
                            table-row (key: p.pid, onclick: .SelectProc(p.pid), oncontextmenu.prevent: .RowCtx(p.pid), style: if p.pid == .store.selected_pid { "bg-accent cursor-pointer" } else { "cursor-pointer hover:bg-muted/40" }) {
                                table-cell (text: f"${p.pid}", style: "text-right text-xs px-2 py-1 tabular-nums text-muted-foreground") {}
                                table-cell (text: p.name, style: "text-xs font-medium px-2 py-1 truncate max-w-[140px]") {}
                                table-cell (text: p.cpu_s, style: "text-right text-xs px-2 py-1 tabular-nums") {}
                                table-cell (text: p.mem_s, style: "text-right text-xs px-2 py-1 tabular-nums") {}
                                table-cell (style: "text-center px-2 py-1") {
                                    if p.status == "running" {
                                        badge (text: "run", variant: "default") {}
                                    } else {
                                        badge (text: p.status, variant: "secondary") {}
                                    }
                                }
                            }
                        }
                    }
                }
            }

            col (style: "rounded-lg border bg-card p-3 gap-2 text-xs") {
                text "系统" { style: "font-semibold" }
                row (style: "gap-4 flex-wrap text-muted-foreground") {
                    text f"${.store.osName} ${.store.osVersion}" {}
                    text f"${.store.hostname}" {}
                    text f"内核 ${.store.kernel}" {}
                    text f"运行 ${.store.uptimeLabel}" {}
                }
            }
        }
    }

    on {
        .SelectProc(pid) -> { store.SelectProc(pid) }
        .RowCtx(pid) -> { store.RowCtx(pid) }
        .CloseCtx -> { store.CloseCtx() }
        .RequestKill -> { store.RequestKill() }
        .CancelKill -> { store.CancelKill() }
        .ConfirmKill -> { store.ConfirmKill() }
        .SortName -> { store.SortName() }
        .SortCpu -> { store.SortCpu() }
        .SortMem -> { store.SortMem() }
    }
}
