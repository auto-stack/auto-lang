// src/front/app.at — System Monitor (Task Manager) application shell
// Holds left navigation rail, top title & interval control bar, and tab router.

use sys_store: SysStore
use processes: ProcessesView
use performance: PerformanceView
use details_users: DetailsUsersView
use back.api: system_snapshot, kill_process

widget App {
    msg {
        Init, Tick, Play, Pause, SetFast, SetNormal, SetSlow, SelectTab(str)
    }

    model {
        interval int = 250
        running str = "false"
        speedDiv int = 4
        subTick int = 0
        tickN int = 0
        dark_mode bool = true
        accent_color str = "indigo"
    }

    on {
        .Init -> {
            store.Init()
            .running = "true"
        }
        .Play -> {
            .running = "true"
            store.Play()
        }
        .Pause -> {
            .running = "false"
            store.Pause()
        }
        .SetFast -> {
            .speedDiv = 1
            store.SetSpeed("fast")
        }
        .SetNormal -> {
            .speedDiv = 4
            store.SetSpeed("normal")
        }
        .SetSlow -> {
            .speedDiv = 10
            store.SetSpeed("slow")
        }
        .SelectTab(tab) -> {
            store.SelectTab(tab)
        }
        .Tick -> {
            if .running == "true" {
                .subTick = .subTick + 1
                if .subTick >= .speedDiv {
                    .subTick = 0
                    .tickN = .tickN + 1
                    store.Refresh()
                }
            }
        }
    }

    view {
        row (style: "min-h-screen bg-background text-foreground") {
            // ---- Left Navigation Rail (Win11 Task Manager style) ----
            col (style: "w-56 border-r bg-card/50 p-4 gap-6 shrink-0 justify-between") {
                col (style: "gap-4") {
                    // App Logo & Brand
                    row (style: "items-center gap-3 px-2 py-1") {
                        span (style: "w-8 h-8 rounded-lg bg-primary flex items-center justify-center text-primary-foreground font-bold shadow-sm") {
                            text "⚡" {}
                        }
                        col (style: "gap-0.5") {
                            text "系统监视器" { style: "text-sm font-bold tracking-tight" }
                            text "Task Manager" { style: "text-[10px] text-muted-foreground" }
                        }
                    }

                    // Navigation Items
                    col (style: "gap-1.5") {
                        // Tab 1: 进程
                        row (onclick: .SelectTab("processes"), style: if .store.active_tab == "processes" { "items-center gap-3 px-3 py-2.5 rounded-lg bg-primary text-primary-foreground cursor-pointer font-medium text-xs shadow-sm" } else { "items-center gap-3 px-3 py-2.5 rounded-lg text-muted-foreground hover:bg-accent hover:text-accent-foreground cursor-pointer text-xs" }) {
                            text "📊" {}
                            text "进程" {}
                        }
                        // Tab 2: 性能
                        row (onclick: .SelectTab("performance"), style: if .store.active_tab == "performance" { "items-center gap-3 px-3 py-2.5 rounded-lg bg-primary text-primary-foreground cursor-pointer font-medium text-xs shadow-sm" } else { "items-center gap-3 px-3 py-2.5 rounded-lg text-muted-foreground hover:bg-accent hover:text-accent-foreground cursor-pointer text-xs" }) {
                            text "📈" {}
                            text "性能" {}
                        }
                        // Tab 3: 详细信息
                        row (onclick: .SelectTab("details"), style: if .store.active_tab == "details" { "items-center gap-3 px-3 py-2.5 rounded-lg bg-primary text-primary-foreground cursor-pointer font-medium text-xs shadow-sm" } else { "items-center gap-3 px-3 py-2.5 rounded-lg text-muted-foreground hover:bg-accent hover:text-accent-foreground cursor-pointer text-xs" }) {
                            text "📋" {}
                            text "详细信息" {}
                        }
                        // Tab 4: 用户
                        row (onclick: .SelectTab("users"), style: if .store.active_tab == "users" { "items-center gap-3 px-3 py-2.5 rounded-lg bg-primary text-primary-foreground cursor-pointer font-medium text-xs shadow-sm" } else { "items-center gap-3 px-3 py-2.5 rounded-lg text-muted-foreground hover:bg-accent hover:text-accent-foreground cursor-pointer text-xs" }) {
                            text "👥" {}
                            text "用户" {}
                        }
                    }
                }

                // Rail Footer (System Status)
                col (style: "p-3 rounded-lg border bg-muted/20 gap-1.5 text-xs") {
                    row (style: "items-center justify-between") {
                        text "运行状态" { style: "text-muted-foreground text-[11px]" }
                        if .store.backend_ok == "true" {
                            span (style: "w-2 h-2 rounded-full bg-green-500") {}
                        } else {
                            span (style: "w-2 h-2 rounded-full bg-red-500") {}
                        }
                    }
                    if .store.backend_ok == "true" {
                        text "后端正常 (sysinfo)" { style: "font-semibold text-green-600 text-[11px]" }
                    } else {
                        text "后端离线" { style: "font-semibold text-red-500 text-[11px]" }
                    }
                }
            }

            // ---- Main Viewport (Right Area) ----
            col (style: "flex-1 min-w-0 p-6 gap-6 overflow-y-auto") {
                // Top Bar: Title + Controls
                row (style: "items-center justify-between") {
                    row (style: "items-center gap-3") {
                        if .store.active_tab == "processes" { h1 "进程" { style: "text-2xl font-bold tracking-tight" } }
                        if .store.active_tab == "performance" { h1 "性能" { style: "text-2xl font-bold tracking-tight" } }
                        if .store.active_tab == "details" { h1 "详细信息" { style: "text-2xl font-bold tracking-tight" } }
                        if .store.active_tab == "users" { h1 "用户" { style: "text-2xl font-bold tracking-tight" } }

                        if .store.backend_ok != "true" {
                            badge (text: "后端离线", variant: "destructive") {}
                        }
                    }

                    // Interval & Play Controls
                    row (style: "items-center gap-2") {
                        if .speedDiv == 1 {
                            button "250ms ●" { onclick: .SetFast, style: "px-2.5 py-1.5 text-xs rounded-md bg-primary text-primary-foreground shadow-sm" }
                        } else {
                            button "250ms" { onclick: .SetFast, style: "px-2.5 py-1.5 text-xs rounded-md border bg-background hover:bg-accent" }
                        }
                        if .speedDiv == 4 {
                            button "1s ●" { onclick: .SetNormal, style: "px-2.5 py-1.5 text-xs rounded-md bg-primary text-primary-foreground shadow-sm" }
                        } else {
                            button "1s" { onclick: .SetNormal, style: "px-2.5 py-1.5 text-xs rounded-md border bg-background hover:bg-accent" }
                        }
                        if .speedDiv == 10 {
                            button "2.5s ●" { onclick: .SetSlow, style: "px-2.5 py-1.5 text-xs rounded-md bg-primary text-primary-foreground shadow-sm" }
                        } else {
                            button "2.5s" { onclick: .SetSlow, style: "px-2.5 py-1.5 text-xs rounded-md border bg-background hover:bg-accent" }
                        }

                        if .running == "true" {
                            button "⏸ 暂停" { onclick: .Pause, style: "px-3 py-1.5 text-xs rounded-md bg-destructive text-destructive-foreground hover:bg-destructive/90 shadow-sm" }
                        } else {
                            button "▶ 继续" { onclick: .Play, style: "px-3 py-1.5 text-xs rounded-md bg-green-600 text-white hover:bg-green-700 shadow-sm" }
                        }
                    }
                }

                // Tab Content Rendering
                if .store.active_tab == "processes" {
                    ProcessesView()
                }
                if .store.active_tab == "performance" {
                    PerformanceView()
                }
                if .store.active_tab == "details" {
                    DetailsUsersView()
                }
                if .store.active_tab == "users" {
                    DetailsUsersView()
                }
            }
        }
    }
}
