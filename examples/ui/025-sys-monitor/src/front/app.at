// src/front/app.at — System Monitor shell. PLAN-684：全高独立 app 框；用户页退役。
use sys_store: SysStore
use processes: ProcessesView
use performance: PerformanceView
use back.api: system_snapshot, kill_process

widget App {
    msg {
        Init, Tick, Play, Pause, SetFast, SetNormal, SetSlow, SelectTab(str)
    }

    model {
        interval int = 250
        running str = "false"
        speedDiv int = 4
        subTick int = 0
        tickN int = 0
        dark_mode bool = true
        accent_color str = "indigo"
    }

    on {
        .Init -> {
            store.Init()
            .running = "true"
        }
        .Play -> {
            .running = "true"
            store.Play()
        }
        .Pause -> {
            .running = "false"
            store.Pause()
        }
        .SetFast -> {
            .speedDiv = 1
            store.SetSpeed("fast")
        }
        .SetNormal -> {
            .speedDiv = 4
            store.SetSpeed("normal")
        }
        .SetSlow -> {
            .speedDiv = 10
            store.SetSpeed("slow")
        }
        .SelectTab(tab) -> {
            store.SelectTab(tab)
        }
        .Tick -> {
            if .running == "true" {
                .subTick = .subTick + 1
                if .subTick >= .speedDiv {
                    .subTick = 0
                    .tickN = .tickN + 1
                    store.Refresh()
                }
            }
        }
    }

    view {
        row (style: "w-full h-full min-h-screen bg-background text-foreground overflow-hidden") {
            col (style: "w-48 border-r bg-card/50 p-3 gap-4 shrink-0 justify-between") {
                col (style: "gap-3") {
                    row (style: "items-center gap-2 px-2 py-1") {
                        span (style: "w-7 h-7 rounded-lg bg-primary flex items-center justify-center text-primary-foreground font-bold shadow-sm") {
                            text "⚡" {}
                        }
                        col (style: "gap-0.5") {
                            text "系统监视器" { style: "text-sm font-bold tracking-tight" }
                            text "Task Manager" { style: "text-[10px] text-muted-foreground" }
                        }
                    }
                    col (style: "gap-1") {
                        row (onclick: .SelectTab("processes"), style: if .store.active_tab == "processes" { "items-center gap-2.5 px-2.5 py-2 rounded-lg bg-primary text-primary-foreground cursor-pointer font-medium text-xs shadow-sm" } else { "items-center gap-2.5 px-2.5 py-2 rounded-lg text-muted-foreground hover:bg-accent hover:text-accent-foreground cursor-pointer text-xs" }) {
                            text "📊" {}
                            text "进程" {}
                        }
                        row (onclick: .SelectTab("performance"), style: if .store.active_tab == "performance" { "items-center gap-2.5 px-2.5 py-2 rounded-lg bg-primary text-primary-foreground cursor-pointer font-medium text-xs shadow-sm" } else { "items-center gap-2.5 px-2.5 py-2 rounded-lg text-muted-foreground hover:bg-accent hover:text-accent-foreground cursor-pointer text-xs" }) {
                            text "📈" {}
                            text "性能" {}
                        }
                    }
                }
                col (style: "p-2.5 rounded-lg border bg-muted/20 gap-1 text-xs") {
                    row (style: "items-center justify-between") {
                        text "运行状态" { style: "text-muted-foreground text-[11px]" }
                        if .store.backend_ok == "true" {
                            span (style: "w-2 h-2 rounded-full bg-green-500") {}
                        } else {
                            span (style: "w-2 h-2 rounded-full bg-red-500") {}
                        }
                    }
                    if .store.backend_ok == "true" {
                        text "后端正常" { style: "font-semibold text-green-600 text-[11px]" }
                    } else {
                        text "后端离线" { style: "font-semibold text-red-500 text-[11px]" }
                    }
                }
            }
            col (style: "flex-1 min-w-0 min-h-0 flex flex-col overflow-hidden") {
                row (style: "items-center justify-between px-4 py-2.5 border-b shrink-0") {
                    row (style: "items-center gap-3") {
                        if .store.active_tab == "processes" { h1 "进程" { style: "text-lg font-bold tracking-tight" } }
                        if .store.active_tab == "performance" { h1 "性能" { style: "text-lg font-bold tracking-tight" } }
                        if .store.backend_ok != "true" {
                            badge (text: "后端离线", variant: "destructive") {}
                        }
                    }
                    row (style: "items-center gap-1.5") {
                        if .speedDiv == 1 {
                            button "250ms ●" { onclick: .SetFast, style: "px-2 py-1 text-xs rounded-md bg-primary text-primary-foreground shadow-sm" }
                        } else {
                            button "250ms" { onclick: .SetFast, style: "px-2 py-1 text-xs rounded-md border bg-background hover:bg-accent" }
                        }
                        if .speedDiv == 4 {
                            button "1s ●" { onclick: .SetNormal, style: "px-2 py-1 text-xs rounded-md bg-primary text-primary-foreground shadow-sm" }
                        } else {
                            button "1s" { onclick: .SetNormal, style: "px-2 py-1 text-xs rounded-md border bg-background hover:bg-accent" }
                        }
                        if .speedDiv == 10 {
                            button "2.5s ●" { onclick: .SetSlow, style: "px-2 py-1 text-xs rounded-md bg-primary text-primary-foreground shadow-sm" }
                        } else {
                            button "2.5s" { onclick: .SetSlow, style: "px-2 py-1 text-xs rounded-md border bg-background hover:bg-accent" }
                        }
                        if .running == "true" {
                            button "⏸" { onclick: .Pause, style: "px-2.5 py-1 text-xs rounded-md bg-destructive text-destructive-foreground shadow-sm" }
                        } else {
                            button "▶" { onclick: .Play, style: "px-2.5 py-1 text-xs rounded-md bg-green-600 text-white shadow-sm" }
                        }
                    }
                }
                col (style: "flex-1 min-h-0 overflow-y-auto p-4") {
                    if .store.active_tab == "processes" {
                        ProcessesView()
                    }
                    if .store.active_tab == "performance" {
                        PerformanceView()
                    }
                }
            }
        }
    }

    view mini {
        col {
            style: "w-full h-full justify-center px-4 gap-2"
            row {
                style: "w-full justify-between items-center"
                text "CPU" { style: "text-xs text-muted-foreground" }
                text .store.cpuLabel { style: "text-sm font-semibold text-foreground tabular-nums" }
            }
            row {
                style: "w-full gap-0.5 items-center"
                for sg in .cpu_segs {
                    if sg.st == "1" {
                        col { style: "w-2 h-2 rounded-sm ${sg.color}" }
                    } else {
                        if sg.st == "2" {
                            col { style: "w-2 h-2 rounded-sm bg-background/70 border" }
                        }
                    }
                }
            }
            row {
                style: "w-full justify-between items-center"
                text "内存" { style: "text-xs text-muted-foreground" }
                text .store.memLabel { style: "text-sm font-semibold text-foreground tabular-nums" }
            }
            row {
                style: "w-full gap-0.5 items-center"
                for sg in .mem_segs {
                    if sg.st == "1" {
                        col { style: "w-2 h-2 rounded-sm ${sg.color}" }
                    } else {
                        if sg.st == "2" {
                            col { style: "w-2 h-2 rounded-sm bg-background/70 border" }
                        }
                    }
                }
            }
            row {
                style: "w-full justify-between items-center"
                text "进程" { style: "text-xs text-muted-foreground" }
                text .store.procLabel { style: "text-sm font-semibold text-foreground tabular-nums" }
            }
        }
    }
}
