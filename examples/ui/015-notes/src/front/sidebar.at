// sidebar.at — NavTree widget (Plan 360: card-based modern UI).
// Plan 367 P2: refactored with view fn + else-if (from 337 lines).
// Plan 482: rebuilt on the nav component family — nav(search:) integrated
// search row, nav-group folder sections, nav-item note entries with built-in
// hover/active states (replaces hand-rolled button + if-style-string items).

use notes_store: NotesStore

// Plan 482: nav-item based note entry — hover/active styling comes from the
// nav contract; desc renders the timestamp as the second line.
view fn NoteNav(note: Note, active: bool) {
    nav-item {
        label: note.title
        desc: note.time
        active: active
        onclick: .SelectNote(i)
        style: "py-1"
    }
}

widget NavTree(active_folder: str, active_id: int, active_tag: str, search: str) {
    msg {
        SelectAll, SelectPinned, SelectRecent,
        SelectTag(str), SelectNote(int),
        NewNote, NewNoteInFolder(str),
        ToggleDarkMode, SetAccent(str), SearchChanged(str)
    }

    view {
        col {
            style: "w-80 bg-card rounded-xl shadow-sm flex flex-col h-full overflow-hidden flex-shrink-0"

            // View mode tabs — segmented control (a filter, not navigation;
            // deliberately kept outside the nav family).
            row {
                style: "gap-1 m-3 mb-2 p-1 bg-muted rounded-lg"
                button "All" {
                    onclick: .SelectAll
                    style: if .active_folder == "all" { "flex-1 px-2 py-1 text-xs font-medium rounded-md bg-card text-card-foreground shadow-sm" } else { "flex-1 px-2 py-1 text-xs rounded-md text-muted-foreground hover:text-foreground transition-colors" }
                }
                button "Pinned" {
                    onclick: .SelectPinned
                    style: if .active_folder == "pinned" { "flex-1 px-2 py-1 text-xs font-medium rounded-md bg-card text-card-foreground shadow-sm" } else { "flex-1 px-2 py-1 text-xs rounded-md text-muted-foreground hover:text-foreground transition-colors" }
                }
                button "Recent" {
                    onclick: .SelectRecent
                    style: if .active_folder == "recent" { "flex-1 px-2 py-1 text-xs font-medium rounded-md bg-card text-card-foreground shadow-sm" } else { "flex-1 px-2 py-1 text-xs rounded-md text-muted-foreground hover:text-foreground transition-colors" }
                }
            }

            // Plan 482: nav container with integrated search row (search: true)
            // + collapsible folder groups + nav-item entries.
            nav (search: true, search_placeholder: "Search notes...",
                 search_value: .search, onsearch: .SearchChanged,
                 style: "flex-1 min-h-0 overflow-y-auto flex flex-col px-2 pb-2") {

                // Tag filters (chips row as a nav child)
                row {
                    style: "flex-wrap gap-1 px-1 mb-1"
                    for t in .store.all_tags {
                        button t {
                            onclick: .SelectTag(t)
                            style: if .store.active_tag == t { "px-2 py-0.5 text-xs rounded-full bg-primary/10 text-primary font-medium" } else { "px-2 py-0.5 text-xs rounded-full bg-muted text-muted-foreground hover:bg-accent transition-colors" }
                        }
                    }
                }

                if .active_folder == "all" {
                    nav-group (label: "Notes") {
                        for i, note in .store.notes {
                            if note.folder == "" {
                                if .store.active_tag == "" {
                                    NoteNav(note: note, active: i == .store.active_id)
                                } else if note.tags.contains(.store.active_tag) {
                                    NoteNav(note: note, active: i == .store.active_id)
                                }
                            }
                        }
                    }
                    nav-group (label: "Work") {
                        for i, note in .store.notes {
                            if note.folder == "work" {
                                if .store.active_tag == "" {
                                    NoteNav(note: note, active: i == .store.active_id)
                                } else if note.tags.contains(.store.active_tag) {
                                    NoteNav(note: note, active: i == .store.active_id)
                                }
                            }
                        }
                    }
                    nav-group (label: "Personal") {
                        for i, note in .store.notes {
                            if note.folder == "personal" {
                                if .store.active_tag == "" {
                                    NoteNav(note: note, active: i == .store.active_id)
                                } else if note.tags.contains(.store.active_tag) {
                                    NoteNav(note: note, active: i == .store.active_id)
                                }
                            }
                        }
                    }
                } else if .active_folder == "pinned" {
                    nav-group (label: "Pinned") {
                        for i, note in .store.notes {
                            if note.pinned {
                                if .store.active_tag == "" {
                                    NoteNav(note: note, active: i == .store.active_id)
                                } else if note.tags.contains(.store.active_tag) {
                                    NoteNav(note: note, active: i == .store.active_id)
                                }
                            }
                        }
                    }
                } else if .active_folder == "recent" {
                    nav-group (label: "Recent") {
                        for i, note in .store.notes {
                            if .store.active_tag == "" {
                                NoteNav(note: note, active: i == .store.active_id)
                            } else if note.tags.contains(.store.active_tag) {
                                NoteNav(note: note, active: i == .store.active_id)
                            }
                        }
                    }
                }
            }

            // Footer: Theme picker + Dark Mode toggle
            separator { style: "border-t border-border" }
            row {
                style: "items-center gap-2 m-3 mb-1"
                text "Theme" { style: "text-xs text-muted-foreground font-medium mr-1" }
                button "" { onclick: .SetAccent("indigo"), style: if .store.accent_color == "indigo" { "w-5 h-5 rounded-full bg-indigo-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-5 h-5 rounded-full bg-indigo-500 hover:scale-110 transition-transform" } }
                button "" { onclick: .SetAccent("coral"), style: if .store.accent_color == "coral" { "w-5 h-5 rounded-full bg-rose-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-5 h-5 rounded-full bg-rose-500 hover:scale-110 transition-transform" } }
                button "" { onclick: .SetAccent("ocean"), style: if .store.accent_color == "ocean" { "w-5 h-5 rounded-full bg-blue-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-5 h-5 rounded-full bg-blue-500 hover:scale-110 transition-transform" } }
                button "" { onclick: .SetAccent("sage"), style: if .store.accent_color == "sage" { "w-5 h-5 rounded-full bg-emerald-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-5 h-5 rounded-full bg-emerald-500 hover:scale-110 transition-transform" } }
                button "" { onclick: .SetAccent("amber"), style: if .store.accent_color == "amber" { "w-5 h-5 rounded-full bg-amber-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-5 h-5 rounded-full bg-amber-500 hover:scale-110 transition-transform" } }
            }
            if .store.dark_mode {
                button "☀ Light" { onclick: .ToggleDarkMode, style: "mx-3 mb-3 px-3 py-1.5 text-xs rounded-lg text-muted-foreground hover:bg-accent transition-colors" }
            } else {
                button "🌙 Dark" { onclick: .ToggleDarkMode, style: "mx-3 mb-3 px-3 py-1.5 text-xs rounded-lg text-muted-foreground hover:bg-accent transition-colors" }
            }
        }
    }

    on {
        .SelectAll -> { store.active_folder = "all"; store.active_tag = "" }
        .SelectPinned -> { store.active_folder = "pinned"; store.active_tag = "" }
        .SelectRecent -> { store.active_folder = "recent"; store.active_tag = "" }
        .SelectTag(t) -> { store.active_tag = t }
        .SelectNote(i) -> { store.active_id = i }
        .NewNote -> { store.NewNote() }
        .NewNoteInFolder(f) -> { store.NewNoteInFolder(f) }
        .ToggleDarkMode -> { store.ToggleDarkMode() }
        .SetAccent(name) -> { store.SetAccent(name) }
        // Plan 482: nav(search:) integrated row wires the previously dead
        // input to the store (search filtering itself remains a store-side
        // follow-up, unchanged from before).
        .SearchChanged(q) -> { store.Search(q) }
    }
}
