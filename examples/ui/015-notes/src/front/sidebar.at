// sidebar.at — NavTree widget (Plan 360: card-based modern UI).
// Plan 367 P2: refactored with view fn + else-if (from 337 lines).
// Plan 482: rebuilt on the nav component family — nav(search:) integrated
// search row, nav-group folder sections, nav-item note entries with built-in
// hover/active states (replaces hand-rolled button + if-style-string items).

use notes_store: NotesStore

// Plan 482: nav-item based note entry — hover/active styling comes from the
// nav contract; desc renders the timestamp as the second line.
view fn NoteNav(note: Note, active: bool) {
    nav-item {
        label: note.title
        desc: note.time
        active: active
        onclick: .SelectNote(i)
        style: "py-1"
    }
}

widget NavTree(active_folder: str, active_id: int, active_tag: str, search: str) {
    msg {
        SelectAll, SelectPinned, SelectRecent,
        SelectTag(str), SelectNote(int),
        NewNote, NewNoteInFolder(str),
        ToggleDarkMode, SetAccent(str), SearchChanged(str),
        ToggleSettings
    }

    model {
        var show_settings bool = false
    }

    view {
        col {
            style: "w-80 bg-card rounded-xl shadow-sm flex flex-col h-full overflow-hidden flex-shrink-0"

            // View mode tabs — segmented control (a filter, not navigation;
            // deliberately kept outside the nav family).
            row {
                style: "gap-1 m-3 mb-2 p-1 bg-muted rounded-lg"
                button "All" {
                    onclick: .SelectAll
                    style: if .store.active_folder == "all" { "flex-1 px-2 py-1 text-xs font-medium rounded-md bg-primary text-primary-foreground shadow-sm" } else { "flex-1 px-2 py-1 text-xs rounded-md text-muted-foreground hover:text-foreground bg-transparent transition-colors" }
                }
                button "Pinned" {
                    onclick: .SelectPinned
                    style: if .store.active_folder == "pinned" { "flex-1 px-2 py-1 text-xs font-medium rounded-md bg-primary text-primary-foreground shadow-sm" } else { "flex-1 px-2 py-1 text-xs rounded-md text-muted-foreground hover:text-foreground bg-transparent transition-colors" }
                }
                button "Recent" {
                    onclick: .SelectRecent
                    style: if .store.active_folder == "recent" { "flex-1 px-2 py-1 text-xs font-medium rounded-md bg-primary text-primary-foreground shadow-sm" } else { "flex-1 px-2 py-1 text-xs rounded-md text-muted-foreground hover:text-foreground bg-transparent transition-colors" }
                }
            }

            // Plan 482: nav container with integrated search row (search: true)
            // + collapsible folder groups + nav-item entries.
            nav (search: true, search_placeholder: "Search notes...",
                 search_value: .search, onsearch: .SearchChanged,
                 style: "flex-1 min-h-0 overflow-y-auto flex flex-col px-2 pb-2") {

                // Tag filters (chips row as a nav child)
                row {
                    style: "flex-wrap gap-1 px-1 mb-1"
                    for t in .store.all_tags {
                        button t {
                            onclick: .SelectTag(t)
                            style: if .store.active_tag == t { "px-2 py-0.5 text-xs rounded-full bg-primary/10 text-primary font-medium" } else { "px-2 py-0.5 text-xs rounded-full bg-muted text-muted-foreground hover:bg-accent transition-colors" }
                        }
                    }
                }

                if .store.active_folder == "all" {
                    nav-group (label: "Notes") {
                        for i, note in .store.notes {
                            if note.folder == "" {
                                if .store.active_tag == "" {
                                    NoteNav(note: note, active: i == .store.active_id)
                                } else if note.tags.contains(.store.active_tag) {
                                    NoteNav(note: note, active: i == .store.active_id)
                                }
                            }
                        }
                    }
                    nav-group (label: "Work") {
                        for i, note in .store.notes {
                            if note.folder == "work" {
                                if .store.active_tag == "" {
                                    NoteNav(note: note, active: i == .store.active_id)
                                } else if note.tags.contains(.store.active_tag) {
                                    NoteNav(note: note, active: i == .store.active_id)
                                }
                            }
                        }
                    }
                    nav-group (label: "Personal") {
                        for i, note in .store.notes {
                            if note.folder == "personal" {
                                if .store.active_tag == "" {
                                    NoteNav(note: note, active: i == .store.active_id)
                                } else if note.tags.contains(.store.active_tag) {
                                    NoteNav(note: note, active: i == .store.active_id)
                                }
                            }
                        }
                    }
                } else if .store.active_folder == "pinned" {
                    nav-group (label: "Pinned") {
                        for i, note in .store.notes {
                            if note.pinned {
                                if .store.active_tag == "" {
                                    NoteNav(note: note, active: i == .store.active_id)
                                } else if note.tags.contains(.store.active_tag) {
                                    NoteNav(note: note, active: i == .store.active_id)
                                }
                            }
                        }
                    }
                } else if .store.active_folder == "recent" {
                    nav-group (label: "Recent") {
                        for i, note in .store.notes {
                            if .store.active_tag == "" {
                                NoteNav(note: note, active: i == .store.active_id)
                            } else if note.tags.contains(.store.active_tag) {
                                NoteNav(note: note, active: i == .store.active_id)
                            }
                        }
                    }
                }
            }

            // Settings popup / panel when toggled
            if .show_settings {
                col {
                    style: "m-3 p-3 bg-card border border-border rounded-xl gap-3 shadow-lg"
                    row {
                        style: "items-center justify-between"
                        text "Settings" { style: "text-xs font-semibold text-foreground uppercase tracking-wider" }
                        button "✕" {
                            onclick: .ToggleSettings
                            style: "text-xs text-muted-foreground hover:text-foreground w-5 h-5 flex items-center justify-center rounded bg-transparent transition-colors"
                        }
                    }
                    col {
                        style: "gap-1.5"
                        text "Theme" { style: "text-xs text-muted-foreground font-medium" }
                        row {
                            style: "gap-1.5"
                            if .store.dark_mode {
                                button "🌙 Dark" {
                                    onclick: .ToggleDarkMode
                                    style: "flex-1 py-1 px-2 text-xs font-medium rounded-md bg-primary text-primary-foreground transition-colors"
                                }
                                button "☀ Light" {
                                    onclick: .ToggleDarkMode
                                    style: "flex-1 py-1 px-2 text-xs font-medium rounded-md text-muted-foreground hover:bg-accent bg-transparent border border-border transition-colors"
                                }
                            } else {
                                button "🌙 Dark" {
                                    onclick: .ToggleDarkMode
                                    style: "flex-1 py-1 px-2 text-xs font-medium rounded-md text-muted-foreground hover:bg-accent bg-transparent border border-border transition-colors"
                                }
                                button "☀ Light" {
                                    onclick: .ToggleDarkMode
                                    style: "flex-1 py-1 px-2 text-xs font-medium rounded-md bg-primary text-primary-foreground transition-colors"
                                }
                            }
                        }
                    }
                    col {
                        style: "gap-1.5"
                        text "Accent Color" { style: "text-xs text-muted-foreground font-medium" }
                        row {
                            style: "items-center gap-2 py-0.5"
                            button "" { onclick: .SetAccent("indigo"), style: if .store.accent_color == "indigo" { "w-5 h-5 p-0 rounded-full bg-indigo-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-5 h-5 p-0 rounded-full bg-indigo-500 hover:scale-110 transition-transform" } }
                            button "" { onclick: .SetAccent("coral"), style: if .store.accent_color == "coral" { "w-5 h-5 p-0 rounded-full bg-rose-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-5 h-5 p-0 rounded-full bg-rose-500 hover:scale-110 transition-transform" } }
                            button "" { onclick: .SetAccent("ocean"), style: if .store.accent_color == "ocean" { "w-5 h-5 p-0 rounded-full bg-sky-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-5 h-5 p-0 rounded-full bg-sky-500 hover:scale-110 transition-transform" } }
                            button "" { onclick: .SetAccent("sage"), style: if .store.accent_color == "sage" { "w-5 h-5 p-0 rounded-full bg-emerald-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-5 h-5 p-0 rounded-full bg-emerald-500 hover:scale-110 transition-transform" } }
                            button "" { onclick: .SetAccent("amber"), style: if .store.accent_color == "amber" { "w-5 h-5 p-0 rounded-full bg-amber-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-5 h-5 p-0 rounded-full bg-amber-500 hover:scale-110 transition-transform" } }
                        }
                    }
                }
            }

            // Footer: Settings button + version
            separator (orientation: "horizontal") { style: "w-full" }
            row {
                style: "items-center justify-between p-3"
                button "⚙ Settings" {
                    onclick: .ToggleSettings
                    style: if .show_settings { "px-2.5 py-1.5 text-xs font-medium rounded-lg bg-accent text-primary transition-colors" } else { "px-2.5 py-1.5 text-xs font-medium rounded-lg text-muted-foreground hover:bg-accent hover:text-foreground bg-transparent transition-colors" }
                }
                text "v1.0" { style: "text-xs text-muted-foreground/60 mr-1" }
            }
        }
    }

    on {
        .SelectAll -> { store.active_folder = "all"; store.active_tag = "" }
        .SelectPinned -> { store.active_folder = "pinned"; store.active_tag = "" }
        .SelectRecent -> { store.active_folder = "recent"; store.active_tag = "" }
        .SelectTag(t) -> { store.active_tag = t }
        .SelectNote(i) -> { store.active_id = i }
        .NewNote -> { store.NewNote() }
        .NewNoteInFolder(f) -> { store.NewNoteInFolder(f) }
        .ToggleDarkMode -> { store.ToggleDarkMode() }
        .SetAccent(name) -> { store.SetAccent(name) }
        .SearchChanged(q) -> { store.Search(q) }
        .ToggleSettings -> { .show_settings = !.show_settings }
    }
}
