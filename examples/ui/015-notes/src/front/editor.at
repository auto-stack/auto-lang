// editor.at — EditorPanel 编辑栏（PLAN-616 清爽化重做）。
//
// 交互模型变化（相对 PLAN-360 的模态编辑）：
//   * **始终可编辑**：标题/正文直接绑 store 草稿（draft_title / draft_body），
//     不再有 Edit / Cancel 模式切换。任何输入置 dirty，Save 按钮此时才出现。
//   * 标题回车 = 保存（input.onenter）。切换笔记/筛选/新建时 store 会先落盘
//     未保存草稿（见 notes_store.at FlushDraft），所以「编辑中被切走」不丢内容。
//   * 删除改两步：先 Arming 出确认，再确认才删。
//   * 置顶走 store.TogglePinActive（落库），视图只用 draft_pinned 这个镜像字段
//     决定按钮态——视图条件不写「下标 + 点路径」（VM 端条件求值对复杂路径不可靠）。
//
// 文本渲染约定：一律 `text <ref>` / `text <prop.field>`；不用 `"${...}"` 插值
// （两端都不解析，见 PLAN-616 §4.2）。

use notes_store: NotesStore

// PLAN-607 style 配方：编辑栏按钮族与标签胶囊。
// `w-auto` 必需：VM 端按钮无显式宽度会按 Fill 撑开（见 app.at 同注）。
style ghost_btn = "h-8 w-auto border-0 flex items-center gap-1.5 px-2.5 rounded-md bg-transparent text-xs text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
style danger_btn = "h-8 w-auto border-0 flex items-center gap-1.5 px-2.5 rounded-md bg-transparent text-xs text-destructive hover:bg-destructive/10 transition-colors"
style save_btn = "h-8 w-auto border-0 flex items-center gap-1.5 px-3 rounded-md bg-primary text-primary-foreground text-xs font-medium shadow-sm hover:bg-primary/90 transition-colors"
style pill_btn = "h-8 w-auto border-0 flex items-center gap-1.5 px-2.5 rounded-full bg-primary/10 text-xs text-primary font-medium hover:bg-primary/20 transition-colors"
style tag_pill = "h-6 w-auto border-0 flex items-center gap-1 pl-2 pr-1 rounded-full bg-primary/10"

// PLAN-637 T-06：共享配方导入（stylekit caption_text ≡ 原字面量，零漂移）。
use stylekit.styles: caption_text

widget EditorPanel() {
    msg {
        EditTitle(str), EditBody(str),
        ShowTagInput, TagInputChanged(str), AddTag, RemoveTag(str),
        SaveDraft, TogglePinActive, DeleteArmed, DeleteCancelled, DeleteConfirmed
    }

    model {
        var tag_input str = ""
        var show_tag_input bool = false
    }

    view {
        col {
            style: "h-full flex-1 flex-col min-h-0 bg-background"

            // ── 编辑头：标题 + 状态 + 动作 ───────────────────────────
            col {
                style: "shrink-0 gap-2 px-8 pt-6 pb-3 border-b border-border"

                row {
                    style: "items-center gap-2"
                    input {
                        value: .store.draft_title
                        oninput: .EditTitle
                        onenter: .SaveDraft
                        placeholder: "Untitled"
                        style: "flex-1 text-2xl font-semibold tracking-tight bg-transparent border-0 outline-none text-foreground"
                    }
                    if .store.dirty {
                        text "Unsaved changes" { style: caption_text }
                        button {
                            onclick: .SaveDraft
                            style: save_btn
                            icon (name: "check", size: 13)
                            text "Save" { style: "text-xs font-medium" }
                        }
                    } else {
                        text "Saved" { style: "text-xs text-muted-foreground/70" }
                    }
                    if .store.draft_pinned {
                        button {
                            onclick: .TogglePinActive
                            style: pill_btn
                            text "Unpin" { style: "text-xs" }
                        }
                    } else {
                        button {
                            onclick: .TogglePinActive
                            style: ghost_btn
                            text "Pin note" { style: "text-xs" }
                        }
                    }
                    if .store.confirm_delete {
                        button {
                            onclick: .DeleteCancelled
                            style: ghost_btn
                            text "Cancel" { style: "text-xs" }
                        }
                        button {
                            onclick: .DeleteConfirmed
                            style: danger_btn
                            text "Delete" { style: "text-xs font-medium" }
                        }
                    } else {
                        // 带文字标签（不是纯图标）：可发现性 + MCP 场景按 label 可寻。
                        button {
                            onclick: .DeleteArmed
                            style: danger_btn
                            icon (name: "trash-2", size: 14)
                            text "Delete" { style: "text-xs" }
                        }
                    }
                }

                // 元信息：更新时间 · 所属文件夹
                row {
                    style: "items-center gap-1.5"
                    icon (name: "clock", size: 12, style: "text-muted-foreground")
                    text .store.draft_time { style: caption_text }
                    if .store.draft_folder != "" {
                        text .store.draft_folder { style: caption_text }
                    }
                }

                // 标签行
                row {
                    style: "items-center gap-1.5"
                    for t in .store.draft_tags {
                        row {
                            style: tag_pill
                            text t { style: "text-xs text-primary font-medium" }
                            button {
                                onclick: .RemoveTag(t)
                                style: "h-4 w-4 border-0 flex items-center justify-center rounded-full bg-transparent hover:bg-destructive/10"
                                icon (name: "x", size: 10, style: "text-primary/70")
                            }
                        }
                    }
                    if .show_tag_input {
                        input {
                            value: .tag_input
                            oninput: .TagInputChanged
                            onenter: .AddTag
                            placeholder: "tag name"
                            style: "h-6 w-28 rounded-full border border-border bg-background px-2 text-xs outline-none text-foreground"
                        }
                        button {
                            onclick: .AddTag
                            style: "h-6 w-6 border-0 flex items-center justify-center rounded-full bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
                            icon (name: "check", size: 12)
                        }
                    } else {
                        button {
                            onclick: .ShowTagInput
                            style: ghost_btn
                            icon (name: "plus", size: 12)
                            text "Tag" { style: "text-xs" }
                        }
                    }
                }
            }

            // ── 正文：无边框 textarea，阅读栏宽 + 舒适行高 ────────────
            col {
                style: "flex-1 min-h-0 px-8 py-4"
                textarea {
                    value: .store.draft_body
                    oninput: .EditBody
                    placeholder: "Start writing..."
                    style: "w-full h-full max-w-2xl text-base leading-7 bg-transparent border-0 outline-none resize-none text-foreground"
                }
            }
        }
    }

    on {
        .EditTitle(v) -> { store.EditTitle(v) }
        .EditBody(v) -> { store.EditBody(v) }
        .ShowTagInput -> { .show_tag_input = true }
        .TagInputChanged(v) -> { .tag_input = v }
        .AddTag -> {
            if .tag_input != "" {
                store.TagAdded(.tag_input)
                .tag_input = ""
                .show_tag_input = false
            }
        }
        .RemoveTag(t) -> { store.TagRemoved(t) }
        .SaveDraft -> { store.SaveDraft() }
        .TogglePinActive -> { store.TogglePinActive() }
        .DeleteArmed -> { store.DeleteArmed() }
        .DeleteCancelled -> { store.DeleteCancelled() }
        .DeleteConfirmed -> { store.DeleteConfirmed() }
    }
}
