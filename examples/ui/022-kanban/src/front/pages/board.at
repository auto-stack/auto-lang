// pages/board.at — the three-column board. Reads cards from the shared store,
// filters by column, and offers add / move / delete (cf. 018 bookshelf.at).
use store: BoardStore

widget board {
    msg Msg { Init, AddCard, TitleChanged, RemoveCard(int), MoveCard(int, str) }

    model {
        var new_title str = ""
    }

    view {
        col {
            style: "p-4 gap-4"
            // Add-card row
            row {
                style: "gap-2 items-center"
                input {
                    placeholder: "Add a card…",
                    value: .new_title,
                    oninput: .TitleChanged,
                    style: "px-3 py-2 border border-gray-300 rounded-lg text-sm w-64"
                }
                button "+ Add Card" {
                    onclick: .AddCard,
                    style: "px-4 py-2 bg-blue-500 text-white rounded-lg text-sm hover:bg-blue-600"
                }
            }
            // Three columns
            row {
                style: "w-full gap-4 items-start"
                // To Do
                col {
                    style: "w-80 bg-gray-100 rounded-xl flex-shrink-0 p-3 gap-2"
                    row {
                        style: "items-center px-1 py-2"
                        text "To Do" { style: "text-sm font-semibold text-gray-700" }
                    }
                    col {
                        style: "gap-2"
                        for card in .store.cards {
                            if card.column == "todo" {
                                row {
                                    key: card.id
                                    style: "w-full items-center bg-white rounded-lg px-3 py-2 shadow-sm"
                                    text card.title { style: "text-sm font-medium text-gray-800 flex-1" }
                                    button ">" {
                                        onclick: .MoveCard(card.id, "doing"),
                                        style: "ml-auto text-xs text-gray-400 hover:text-blue-500"
                                    }
                                    button "×" {
                                        onclick: .RemoveCard(card.id),
                                        style: "ml-2 text-xs text-gray-300 hover:text-red-500"
                                    }
                                }
                            }
                        }
                    }
                }
                // In Progress
                col {
                    style: "w-80 bg-orange-50 rounded-xl flex-shrink-0 p-3 gap-2"
                    row {
                        style: "items-center px-1 py-2"
                        text "In Progress" { style: "text-sm font-semibold text-orange-600" }
                    }
                    col {
                        style: "gap-2"
                        for card in .store.cards {
                            if card.column == "doing" {
                                row {
                                    key: card.id
                                    style: "w-full items-center bg-white rounded-lg px-3 py-2 shadow-sm"
                                    text card.title { style: "text-sm font-medium text-gray-800 flex-1" }
                                    button ">" {
                                        onclick: .MoveCard(card.id, "done"),
                                        style: "ml-auto text-xs text-gray-400 hover:text-green-500"
                                    }
                                    button "×" {
                                        onclick: .RemoveCard(card.id),
                                        style: "ml-2 text-xs text-gray-300 hover:text-red-500"
                                    }
                                }
                            }
                        }
                    }
                }
                // Done
                col {
                    style: "w-80 bg-green-50 rounded-xl flex-shrink-0 p-3 gap-2"
                    row {
                        style: "items-center px-1 py-2"
                        text "Done" { style: "text-sm font-semibold text-green-600" }
                    }
                    col {
                        style: "gap-2"
                        for card in .store.cards {
                            if card.column == "done" {
                                row {
                                    key: card.id
                                    style: "w-full items-center bg-white rounded-lg px-3 py-2 shadow-sm"
                                    text card.title { style: "text-sm font-medium text-gray-800 flex-1" }
                                    button "×" {
                                        onclick: .RemoveCard(card.id),
                                        style: "ml-auto text-xs text-gray-300 hover:text-red-500"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> { store.Init() }
        .TitleChanged -> { }
        .AddCard -> {
            if .new_title != "" {
                store.AddCard(.new_title)
                .new_title = ""
            }
        }
        .RemoveCard(id int) -> { store.RemoveCard(id) }
        .MoveCard(id int, column str) -> { store.MoveCard(id, column) }
    }
}
