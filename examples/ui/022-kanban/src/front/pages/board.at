// pages/board.at — 三列看板。PLAN-684 rev2：语义 token 配色（去 gray/orange/green
// 硬编码底色）+ 全高独立 app 框布局（flex-1 items-stretch，卡片区滚动）。
// 状态身份用色点（双主题安全）；风格锚 Linear / Trello × AutoUI token。
use store: BoardStore

style card_base = "w-full items-center gap-2 bg-card border border-border rounded-lg px-3 py-2 shadow-sm cursor-move hover:border-primary/40 transition-colors"
style card_title = "text-sm font-medium text-foreground flex-1 truncate"
style icon_btn = "ml-auto h-6 w-6 items-center justify-center rounded text-xs text-muted-foreground hover:bg-accent hover:text-foreground transition-colors"
style del_btn = "ml-1 h-6 w-6 items-center justify-center rounded text-xs text-muted-foreground hover:bg-destructive/10 hover:text-destructive transition-colors"
style col_shell = "flex-1 min-w-0 bg-muted/50 border border-border/60 rounded-xl p-3 gap-2 flex flex-col"
style col_head = "items-center gap-2 px-1 py-1 shrink-0"

widget board {
    msg { Init, AddCard, TitleChanged, RemoveCard(int), MoveCard(int, str), DragStart(int), AllowDrop, Drop(str) }

    model {
        var new_title str = ""
        // id of the card currently being dragged (set by DragStart, read by Drop).
        var drag_id int = 0
    }

    view {
        col {
            style: "h-full w-full p-4 gap-3 min-h-0 flex flex-col"

            // ── 工具条：新建卡片 ──
            row {
                style: "gap-2 items-center shrink-0"
                input {
                    placeholder: "Add a card…",
                    value: .new_title,
                    oninput: .TitleChanged,
                    style: "px-3 py-2 bg-card border border-border rounded-lg text-sm text-foreground outline-none focus:border-primary w-64 max-w-full"
                }
                button "+ Add Card" {
                    onclick: .AddCard,
                    style: "px-4 py-2 bg-primary text-primary-foreground rounded-lg text-sm font-medium hover:bg-primary/90 transition-colors"
                }
            }

            // ── 三列：拉满剩余高度 ──
            row {
                style: "flex-1 min-h-0 gap-3 items-stretch w-full"

                // To Do
                col {
                    style: col_shell
                    ondragover.prevent: .AllowDrop
                    ondrop: .Drop("todo")
                    row {
                        style: col_head
                        col {
                            style: "h-2 w-2 rounded-full bg-border shrink-0"
                        }
                        text "To Do" { style: "text-sm font-semibold text-foreground" }
                    }
                    col {
                        style: "flex-1 min-h-0 overflow-y-auto gap-2"
                        for card in .store.cards {
                            if card.column == "todo" {
                                row {
                                    key: card.id
                                    draggable: true
                                    ondragstart: .DragStart(card.id)
                                    style: card_base
                                    text card.title { style: card_title }
                                    button ">" {
                                        onclick: .MoveCard(card.id, "doing"),
                                        style: icon_btn
                                    }
                                    button "×" {
                                        onclick: .RemoveCard(card.id),
                                        style: del_btn
                                    }
                                }
                            }
                        }
                    }
                }

                // In Progress
                col {
                    style: col_shell
                    ondragover.prevent: .AllowDrop
                    ondrop: .Drop("doing")
                    row {
                        style: col_head
                        col {
                            style: "h-2 w-2 rounded-full bg-primary shrink-0"
                        }
                        text "In Progress" { style: "text-sm font-semibold text-foreground" }
                    }
                    col {
                        style: "flex-1 min-h-0 overflow-y-auto gap-2"
                        for card in .store.cards {
                            if card.column == "doing" {
                                row {
                                    key: card.id
                                    draggable: true
                                    ondragstart: .DragStart(card.id)
                                    style: card_base
                                    text card.title { style: card_title }
                                    button ">" {
                                        onclick: .MoveCard(card.id, "done"),
                                        style: icon_btn
                                    }
                                    button "×" {
                                        onclick: .RemoveCard(card.id),
                                        style: del_btn
                                    }
                                }
                            }
                        }
                    }
                }

                // Done
                col {
                    style: col_shell
                    ondragover.prevent: .AllowDrop
                    ondrop: .Drop("done")
                    row {
                        style: col_head
                        col {
                            style: "h-2 w-2 rounded-full bg-emerald-500 shrink-0"
                        }
                        text "Done" { style: "text-sm font-semibold text-foreground" }
                    }
                    col {
                        style: "flex-1 min-h-0 overflow-y-auto gap-2"
                        for card in .store.cards {
                            if card.column == "done" {
                                row {
                                    key: card.id
                                    draggable: true
                                    ondragstart: .DragStart(card.id)
                                    style: card_base
                                    text card.title { style: card_title }
                                    button "×" {
                                        onclick: .RemoveCard(card.id),
                                        style: del_btn
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> { store.Init() }
        .TitleChanged -> { }
        .AddCard -> {
            if .new_title != "" {
                store.AddCard(.new_title)
                .new_title = ""
            }
        }
        .RemoveCard(id int) -> { store.RemoveCard(id) }
        .MoveCard(id int, column str) -> { store.MoveCard(id, column) }
        .DragStart(id int) -> { .drag_id = id }
        .AllowDrop -> { }
        .Drop(column str) -> {
            if .drag_id != 0 {
                store.MoveCard(.drag_id, column)
                .drag_id = 0
            }
        }
    }
}
