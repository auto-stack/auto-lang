// app.at — App shell. Single-page board; routes just render the board page.
// store import at the top (cf. 018 app.at `use book_store: BooksStore`).
use board_store: BoardStore

widget App {
    routes {
        "/" -> use board
    }

    msg Msg { Init }

    view {
        col {
            style: "min-h-screen bg-gray-50 text-gray-900"
            // Header
            row {
                style: "w-full items-center justify-between p-4 border-b border-gray-200 bg-white"
                row {
                    style: "items-center gap-2"
                    text "Project Board" { style: "text-xl font-bold text-gray-800" }
                    text "Kanban" { style: "text-sm text-gray-400" }
                }
            }
            // Route outlet
            col {
                style: "flex-1"
                outlet
            }
        }
    }

    on {
        .Init -> { store.Init() }
    }
}
