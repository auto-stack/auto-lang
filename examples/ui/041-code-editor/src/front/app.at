widget App {
    model {
        var tab int = 0
        var src_main str = "// 预填文本显示测试 — 如果你看到这行字,说明正文渲染正常\nfn add(a int, b int) int {\n    return a + b\n}\n\n// 中文注释:你好世界\nprint(add(1, 2))\n"
        var src_util str = "// 工具模块 — 每个 tab 的编辑状态独立保存\nfn greet(name str) str {\n    return \"hello \" + name\n}\n\nfn farewell(name str) str {\n    return \"bye \" + name\n}\n"
        var path_main str = ""
        var path_util str = ""
        var title_main str = "main.at"
        var title_util str = "util.at"
        var edits int = 0
        var line int = 1
        var col int = 1
        var sel int = 0
        var console_open bool = false
        var console str = ""
        // Plan 422 P3: 右键菜单(contextmenu popover 的坐标锚状态)
        var ctx_open bool = false
        var ctx_x float = 0
        var ctx_y float = 0
    }

    view {
        col (style: "h-full w-full") {

            row (style: "h-8 items-center bg-muted/30 shrink-0 w-full gap-0 px-2") {
                menubar {}
                toolbar (style: "ml-auto") {}
            }
            row (style: "h-8 items-center bg-muted/30 shrink-0 w-full gap-0") {
                if .tab == 0 {
                    row (style: "items-center bg-[#1C1D24]") {
                        button (text: .title_main, variant: "text") {
                            onclick: .TabMain
                            style: "h-8 px-3 text-[12px] text-zinc-200 font-medium"
                        }
                        button (variant: "text") {
                            icon (name: "x", style: "h-3 w-3 text-zinc-500") {}
                            onclick: .CloseTab("main.at")
                            style: "h-7 w-6 px-0 py-0 mr-2"
                        }
                    }
                }
                if .tab != 0 {
                    button (text: .title_main, variant: "text") {
                        onclick: .TabMain
                        style: "h-8 px-3 text-[12px] text-zinc-500"
                    }
                }
                if .tab == 1 {
                    row (style: "items-center bg-[#1C1D24]") {
                        button (text: .title_util, variant: "text") {
                            onclick: .TabUtil
                            style: "h-8 px-3 text-[12px] text-zinc-200 font-medium"
                        }
                        button (variant: "text") {
                            icon (name: "x", style: "h-3 w-3 text-zinc-500") {}
                            onclick: .CloseTab("util.at")
                            style: "h-7 w-6 px-0 py-0 mr-2"
                        }
                    }
                }
                if .tab != 1 {
                    button (text: .title_util, variant: "text") {
                        onclick: .TabUtil
                        style: "h-8 px-3 text-[12px] text-zinc-500"
                    }
                }
            }
            col (style: "h-px w-full bg-border shrink-0")

            if .tab == 0 {
                code_editor (key: "tab-main", lang: "auto", style: "flex-1 w-full") {
                    content: .src_main
                    oninput: .SrcMainChanged
                    oncursor: .CursorMain
                    oncontextmenu: .EditorCtx
                }
            }
            if .tab != 0 {
                code_editor (key: "tab-util", lang: "auto", style: "flex-1 w-full") {
                    content: .src_util
                    oninput: .SrcUtilChanged
                    oncursor: .CursorUtil
                    oncontextmenu: .EditorCtx
                }
            }

            // Plan 422 P3: 坐标锚弹层 —— 右键编辑器时 EditorCtx(x, y) 记录
            // 落点并置开;面板项处理器负责关闭。ondismiss 覆盖点击外部/Esc。
            popover (open: .ctx_open, x: .ctx_x, y: .ctx_y, ondismiss: .CtxClose,
                     class: "w-40 bg-[#16171B] border border-zinc-700 shadow-md py-1") {
                button (text: "剪切", variant: "text") {
                    onclick: .CtxCut
                    style: "h-7 w-full justify-start px-2 text-[12px] text-zinc-200"
                }
                button (text: "复制", variant: "text") {
                    onclick: .CtxCopy
                    style: "h-7 w-full justify-start px-2 text-[12px] text-zinc-200"
                }
                button (text: "全选", variant: "text") {
                    onclick: .CtxSelectAll
                    style: "h-7 w-full justify-start px-2 text-[12px] text-zinc-200"
                }
            }

            if .console_open {
                col (style: "w-full shrink-0") {
                    col (style: "h-px w-full bg-border")
                    row (style: "h-7 items-center bg-muted/30 shrink-0 gap-3 px-2") {
                        text "CONSOLE" {
                            style: "text-[11px] font-bold text-zinc-400"
                        }
                        button (text: "Clear", variant: "text") {
                            onclick: .ConsoleClear
                            style: "text-[11px] h-5 px-1 text-zinc-400"
                        }
                        text "edits: ${.edits}" {
                            style: "text-[11px] text-zinc-500 ml-auto"
                        }
                    }
                    scroll (style: "h-40 w-full bg-muted/10 shrink-0") {
                        col (style: "p-2") {
                            text .console {
                                style: "text-xs font-mono text-zinc-300"
                            }
                        }
                    }
                }
            }

            col (style: "h-px w-full bg-border")
            row (style: "h-6 items-center bg-muted/30 shrink-0 w-full gap-3 px-2") {
                text "Auto" { style: "text-[11px] text-zinc-400" }
                text "UTF-8" { style: "text-[11px] text-zinc-400" }
                text "Spaces: 4" { style: "text-[11px] text-zinc-400" }

                text "${.line}:${.col}" {
                    style: "text-[11px] text-zinc-300 ml-auto"
                }
                if .sel > 0 {
                    text "Sel ${.sel}" { style: "text-[11px] text-zinc-300" }
                }
                if .console_open == false {
                    button (variant: "text") {
                        icon (name: "terminal", style: "h-3.5 w-3.5 text-zinc-400") {}
                        onclick: .ActConsole
                        style: "h-6 w-9 px-0 py-0"
                    }
                }
                if .console_open == true {
                    button (variant: "text") {
                        icon (name: "terminal", style: "h-3.5 w-3.5 text-zinc-200") {}
                        onclick: .ActConsole
                        style: "h-6 w-9 px-0 py-0"
                    }
                }
            }
        }
    }

    on {
        .CloseTab(name) -> {
            console_log("close tab " + name + " (MVP: dummy)")
            .console = console_lines()
        }
        .TabMain -> {
            .tab = 0
            .line = code_editor_cursor_line("tab-main") + 1
            .col = code_editor_cursor_col("tab-main") + 1
            .sel = code_editor_selection_len("tab-main")
            .console = console_lines()
        }
        .TabUtil -> {
            .tab = 1
            .line = code_editor_cursor_line("tab-util") + 1
            .col = code_editor_cursor_col("tab-util") + 1
            .sel = code_editor_selection_len("tab-util")
            .console = console_lines()
        }
        .SrcMainChanged -> {
            .edits = .edits + 1
            console_log(.title_main + " edit #" + .edits.str())
            .console = console_lines()
        }
        .SrcUtilChanged -> {
            .edits = .edits + 1
            console_log(.title_util + " edit #" + .edits.str())
            .console = console_lines()
        }
        .CursorMain -> {
            .line = code_editor_cursor_line("tab-main") + 1
            .col = code_editor_cursor_col("tab-main") + 1
            .sel = code_editor_selection_len("tab-main")
            .console = console_lines()
        }
        .CursorUtil -> {
            .line = code_editor_cursor_line("tab-util") + 1
            .col = code_editor_cursor_col("tab-util") + 1
            .sel = code_editor_selection_len("tab-util")
            .console = console_lines()
        }
        .ConsoleClear -> {
            console_clear()
            .console = ""
        }

        // ---- Plan 422 P3: contextmenu popover ----
        // 编辑器右键:坐标为视口系(renderer 侧已加 widget origin)。
        .EditorCtx(x, y) -> {
            .ctx_x = x
            .ctx_y = y
            .ctx_open = true
            console_log("ctx menu opened")
            .console = console_lines()
        }
        .CtxClose -> {
            .ctx_open = false
        }
        .CtxCut -> {
            .ctx_open = false
            if .tab == 0 {
                code_editor_cut("tab-main")
                .src_main = code_editor_text("tab-main")
            }
            if .tab == 1 {
                code_editor_cut("tab-util")
                .src_util = code_editor_text("tab-util")
            }
            console_log("ctx cut")
            .console = console_lines()
        }
        .CtxCopy -> {
            .ctx_open = false
            if .tab == 0 {
                code_editor_copy("tab-main")
            }
            if .tab == 1 {
                code_editor_copy("tab-util")
            }
            console_log("ctx copy")
            .console = console_lines()
        }
        .CtxSelectAll -> {
            .ctx_open = false
            if .tab == 0 {
                code_editor_select_all("tab-main")
                .sel = code_editor_selection_len("tab-main")
            }
            if .tab == 1 {
                code_editor_select_all("tab-util")
                .sel = code_editor_selection_len("tab-util")
            }
            console_log("ctx select all")
            .console = console_lines()
        }

        // ---- Plan 418: semantic actions (menu / toolbar / shortcut 3-source) ----
        .ActNew -> {
            if .tab == 0 {
                .path_main = ""
                .title_main = "untitled.at"
                code_editor_set_text("tab-main", "")
            }
            if .tab == 1 {
                .path_util = ""
                .title_util = "untitled.at"
                code_editor_set_text("tab-util", "")
            }
            console_log("new: cleared active tab")
            .console = console_lines()
        }
        .ActOpen -> {
            let p = dialog_open(".at, .au, .rs, .txt")
            if p != "" {
                let s = File.read_text(p)
                if .tab == 0 {
                    .path_main = p
                    .title_main = file_basename(p)
                    code_editor_set_text("tab-main", s)
                }
                if .tab == 1 {
                    .path_util = p
                    .title_util = file_basename(p)
                    code_editor_set_text("tab-util", s)
                }
                console_log("open: " + p)
            } else {
                console_log("open: cancelled")
            }
            .console = console_lines()
        }
        .ActSave -> {
            if .tab == 0 {
                if .path_main == "" {
                    let p = dialog_save("untitled.at")
                    if p != "" {
                        .path_main = p
                        .title_main = file_basename(p)
                    }
                }
                if .path_main != "" {
                    File.write_text(.path_main, code_editor_text("tab-main"))
                    console_log("saved: " + .path_main)
                } else {
                    console_log("save: cancelled")
                }
            }
            if .tab == 1 {
                if .path_util == "" {
                    let p = dialog_save("untitled.at")
                    if p != "" {
                        .path_util = p
                        .title_util = file_basename(p)
                    }
                }
                if .path_util != "" {
                    File.write_text(.path_util, code_editor_text("tab-util"))
                    console_log("saved: " + .path_util)
                } else {
                    console_log("save: cancelled")
                }
            }
            .console = console_lines()
        }
        .ActQuit -> {
            console_log("quit")
            Process.exit(0)
        }
        .ActUndo -> {
            if .tab == 0 {
                code_editor_undo("tab-main")
                .src_main = code_editor_text("tab-main")
            }
            if .tab == 1 {
                code_editor_undo("tab-util")
                .src_util = code_editor_text("tab-util")
            }
            console_log("undo")
            .console = console_lines()
        }
        .ActRedo -> {
            if .tab == 0 {
                code_editor_redo("tab-main")
                .src_main = code_editor_text("tab-main")
            }
            if .tab == 1 {
                code_editor_redo("tab-util")
                .src_util = code_editor_text("tab-util")
            }
            console_log("redo")
            .console = console_lines()
        }
        .ActSelectAll -> {
            if .tab == 0 {
                code_editor_select_all("tab-main")
                .line = code_editor_cursor_line("tab-main") + 1
                .col = code_editor_cursor_col("tab-main") + 1
                .sel = code_editor_selection_len("tab-main")
            }
            if .tab == 1 {
                code_editor_select_all("tab-util")
                .line = code_editor_cursor_line("tab-util") + 1
                .col = code_editor_cursor_col("tab-util") + 1
                .sel = code_editor_selection_len("tab-util")
            }
            console_log("select all")
            .console = console_lines()
        }
        .ActCut -> {
            if .tab == 0 {
                code_editor_cut("tab-main")
                .src_main = code_editor_text("tab-main")
            }
            if .tab == 1 {
                code_editor_cut("tab-util")
                .src_util = code_editor_text("tab-util")
            }
            console_log("cut")
            .console = console_lines()
        }
        .ActCopy -> {
            if .tab == 0 {
                code_editor_copy("tab-main")
            }
            if .tab == 1 {
                code_editor_copy("tab-util")
            }
            console_log("copy")
            .console = console_lines()
        }
        .ActPaste -> {
            if .tab == 0 {
                code_editor_paste("tab-main")
                .src_main = code_editor_text("tab-main")
            }
            if .tab == 1 {
                code_editor_paste("tab-util")
                .src_util = code_editor_text("tab-util")
            }
            console_log("paste")
            .console = console_lines()
        }
        .ActConsole -> {
            .console_open = !.console_open
            .console = console_lines()
        }
        .ActSwitchTab -> {
            if .tab == 0 {
                .tab = 1
                .line = code_editor_cursor_line("tab-util") + 1
                .col = code_editor_cursor_col("tab-util") + 1
                .sel = code_editor_selection_len("tab-util")
            } else {
                .tab = 0
                .line = code_editor_cursor_line("tab-main") + 1
                .col = code_editor_cursor_col("tab-main") + 1
                .sel = code_editor_selection_len("tab-main")
            }
            .console = console_lines()
        }
        .ActAbout -> {
            console_log("auto-edit 0.1 — AutoUI playground (plans 413/414/418)")
            .console = console_lines()
        }
    }
}
