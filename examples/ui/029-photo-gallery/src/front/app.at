// app.at — 029-photo-gallery 现代相册（Plan 628 → PLAN-043 Part 1 后端化）
//
// 数据源：后端 photo_service 实时扫描（pac `photo_root:` 声明根目录）——
// Init 拉 /api/photos/scan?dir=<当前目录> 建网格；缩略图走
// /api/photos/thumb/:id（按需渲染 + 磁盘缓存），查看器原图走
// /api/photos/full/:id。目录增删后重启 app 即跟随（Plan 628 离线烘焙链
// 已删，见 pac.at 头注）。
//
// 浏览模型（2026-09-24 用户裁定）：**非递归**——网格只列当前目录直属
// 图片；子目录以导航 chip 呈现（计数 = 该目录直属图片数），点击进入、
// 顶栏返回上一级。收藏跨目录全局（fav 记录带完整 URL，收藏页聚合
// 所有目录的收藏项）。
//
// UI：平板/手机端沉浸式设计——分段相册导航（动态分组：全部/各子目录/
// 收藏）+ 搜索/排序/网格密度工具栏 + 无边框照片网格 + 悬浮胶囊查看器
// （上一张/下一张/收藏）。收藏 id 落 app Storage（photo-gallery.favs），
// 重开保留。

use stylekit.styles: caption_text
style label_xs_medium = "text-xs font-medium"
style emoji_count = "text-[11px] ml-1.5 opacity-60"
style img_fill = "w-full h-full"
style photo_btn = "w-full h-auto p-0 border-0 rounded-none bg-transparent block cursor-pointer"
style meta_trunc = "text-xs font-semibold truncate"
style row_meta = "items-center gap-2.5"
style glass_btn_a = "h-9 px-4 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center gap-1.5 border border-white/10"
style glass_btn_b = "h-9 px-3.5 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center gap-1.5 backdrop-blur-md border border-white/10"
style icon_btn = "h-8 w-8 rounded-lg bg-transparent hover:bg-muted text-muted-foreground hover:text-foreground flex items-center justify-center"
style group_card = "group rounded-2xl overflow-hidden bg-card border border-border/50 hover:border-primary/60 transition-all shadow-sm flex flex-col"
style meta_col = "flex-1 min-w-0 pr-2"

widget App {
    msg {
        Init,
        SelectAlbum(str), SetSearch(str), ApplyFilter,
        NavigateDir(str), GoUp, ReloadDir,
        ToggleSort, SetDensity(int),
        OpenPhoto(str), PrevPhoto, NextPhoto, BackToGrid,
        ToggleFav(str),
        LoadMore,
        ToggleDark, SetAccent(str)
    }

    model {
        // ---- 主题契约变量 ----
        var dark_mode bool = true
        var accent_color str = "indigo"

        // ---- 视图形态 ----
        var mode str = "grid"               // "grid" | "view"

        // ---- 数据源（Init/导航自后端 scan 填充；非递归浏览模型）----
        var photos = []                     // 当前目录直属图片 {id,title,date,meta,fav,thumb,full,sort_key}
        var dirs = []                       // 当前目录的子目录导航 [{name,rel_path,image_count}]
        var dir str = ""                    // 当前目录（根相对路径，"" = 根）
        var dir_badge str = ""              // 页签行目录徽标（"📁 <dir>"，根为空）
        var scan_source_label str = ""      // 信息条扫描源文案
        var fav_records = []                // 收藏全记录（跨目录聚合视图 + Storage 持久化）
        var load_error str = ""             // scan 失败文案（空 = 成功）
        var root_missing bool = false       // 后端根目录缺席诚实态

        // ---- 过滤 / 排序 / 密度 ----
        var album str = "all"               // all | favorites | <album key>
        var search_q str = ""
        var sort_dir str = "desc"           // "desc"=最新在前 | "asc"
        var sort_label str = "最新 ↓"
        var density int = 3                 // 网格列数：2 | 3 | 4
        var album_tabs = []                 // {key,label,count} 动态分组

        // ---- 主列表与视图列表 ----
        var view_list = []
        var view_ids = []
        var has_view bool = false
        // 分批渲染闸（PLAN-043 性能边界）：VM native 渲染器的 image 加载
        // 是渲染线程同步阻塞 HTTP——一次全量渲染 400+ 缩略图会把 UI 冻死
        //（实机：412 张时 screenshot 超时 / 进程失联）。网格只画前
        // render_cap 张，底部「加载更多」分批解锁；查看器单张不受影响。
        var render_cap int = 60
        var render_more_label str = ""
        var render_list = []

        // ---- 计数与文案 ----
        var view_label str = "加载中…"

        // ---- 查看器 ----
        var cur_id str = ""
        var cur_title str = ""
        var cur_meta str = ""
        var cur_full str = ""
        var prev_id str = ""
        var next_id str = ""
        var fav_label str = "♡ 收藏"
        var is_cur_fav bool = false
    }

    view {
        col {
            style: "w-full h-screen flex flex-col bg-background text-foreground overflow-hidden font-sans"

            // ════════════════════════════════════════════════════════
            // 模式 1：网格相册模式 (移动/平板全幅沉浸)
            // ════════════════════════════════════════════════════════
            if .mode == "grid" {
                col {
                    style: "w-full h-full flex flex-col overflow-hidden"

                    // ---- 顶部沉浸式导航栏（Segmented Control + 工具栏） ----
                    row {
                        style: "h-16 shrink-0 items-center justify-between px-6 border-b border-border bg-card/60 backdrop-blur-md gap-4"

                        // App 标题徽标
                        row {
                            style: row_meta
                            text "相册" { style: "text-lg font-bold tracking-tight" }
                            text "Photos" { style: "text-xs px-2 py-0.5 rounded-full bg-primary/10 text-primary font-medium" }
                        }

                        // 分段胶囊控制条（全部/收藏 + 子目录导航 chips）
                        row {
                            style: "items-center p-1 bg-muted/60 rounded-xl border border-border/50 gap-1"
                            if .dir != "" {
                                button {
                                    onclick: .GoUp
                                    style: "h-8 px-3 rounded-lg bg-background text-foreground text-xs font-semibold shadow-sm"
                                    text "← 返回" { style: "text-xs" }
                                }
                                text .dir_badge { style: "text-[11px] text-muted-foreground px-1 max-w-40 truncate" }
                            }
                            for t in .album_tabs {
                                button {
                                    onclick: .SelectAlbum(t.key)
                                    style: if .album == t.key { "h-8 px-4 rounded-lg bg-background text-foreground text-xs font-semibold shadow-sm" } else { "h-8 px-4 rounded-lg bg-transparent text-muted-foreground hover:text-foreground text-xs font-medium" }
                                    text t.label { style: "text-xs" }
                                    text t.count { style: emoji_count }
                                }
                            }
                            for d in .dirs {
                                button {
                                    onclick: .NavigateDir(d.rel_path)
                                    style: "h-8 px-3 rounded-lg bg-transparent text-muted-foreground hover:text-foreground text-xs font-medium border border-border/40"
                                    text d.label { style: "text-xs" }
                                    text d.count { style: emoji_count }
                                }
                            }
                        }

                        // 右侧工具区：搜索、排序、网格密度调节、主题色
                        row {
                            style: row_meta
                            input {
                                value: .search_q
                                oninput: .SetSearch
                                onchange: .SetSearch
                                placeholder: "🔍 搜索照片…"
                                style: "w-44 h-8 text-xs px-3 bg-background border border-border/80 rounded-lg outline-none placeholder:text-muted-foreground focus:border-primary"
                            }
                            button (text: .sort_label, variant: "ghost") {
                                onclick: .ToggleSort
                                style: "h-8 px-2.5 text-xs rounded-lg border border-border text-muted-foreground hover:text-foreground"
                            }
                            // 缩放密度按钮 (2 / 3 / 4 列)
                            row {
                                style: "items-center bg-muted/60 border border-border/60 rounded-lg p-0.5 gap-0.5"
                                button (text: "2", variant: "ghost") {
                                    onclick: .SetDensity(2)
                                    style: if .density == 2 { "h-7 w-7 text-xs rounded-md bg-background text-foreground font-bold shadow-sm" } else { "h-7 w-7 text-xs rounded-md text-muted-foreground hover:text-foreground" }
                                }
                                button (text: "3", variant: "ghost") {
                                    onclick: .SetDensity(3)
                                    style: if .density == 3 { "h-7 w-7 text-xs rounded-md bg-background text-foreground font-bold shadow-sm" } else { "h-7 w-7 text-xs rounded-md text-muted-foreground hover:text-foreground" }
                                }
                                button (text: "4", variant: "ghost") {
                                    onclick: .SetDensity(4)
                                    style: if .density == 4 { "h-7 w-7 text-xs rounded-md bg-background text-foreground font-bold shadow-sm" } else { "h-7 w-7 text-xs rounded-md text-muted-foreground hover:text-foreground" }
                                }
                            }
                            if .dark_mode {
                                button {
                                    onclick: .ToggleDark
                                    style: icon_btn
                                    icon (name: "moon", size: 16)
                                }
                            } else {
                                button {
                                    onclick: .ToggleDark
                                    style: icon_btn
                                    icon (name: "sun", size: 16)
                                }
                            }
                        }
                    }

                    // 信息提示条（计数 + 后端扫描态）
                    row {
                        style: "h-8 shrink-0 items-center justify-between px-6 bg-muted/20 border-b border-border/40"
                        text .view_label { style: caption_text }
                        if .root_missing {
                            text "⚠️ 照片源目录不存在（检查 photo_root）" { style: "text-[11px] text-destructive/80" }
                        } else {
                            text .scan_source_label { style: "text-[11px] text-muted-foreground/60" }
                        }
                    }

                    // 照片网格区 (无缝现代网格设计，纯净呈现图片主体)
                    col {
                        style: "flex-1 min-h-0 overflow-y-auto p-5"
                        if .has_view {
                            if .density == 2 {
                                grid {
                                    cols: 2
                                    gap: 16
                                    for item in .render_list {
                                        col {
                                            style: group_card
                                            // 图片区域（点击直开原图）
                                            button {
                                                onclick: .OpenPhoto(item.id)
                                                style: photo_btn
                                                col {
                                                    style: "h-56 w-full overflow-hidden bg-muted"
                                                    image (src: item.thumb, alt: item.title, fit: "cover") {
                                                        style: img_fill
                                                    }
                                                }
                                            }
                                            // 悬浮信息条（标题 + 拍摄日期 + 收藏）
                                            row {
                                                style: "items-center justify-between px-3.5 py-2.5 bg-card"
                                                col {
                                                    style: meta_col
                                                    text item.title { style: meta_trunc }
                                                    text item.date { style: "text-[11px] text-muted-foreground mt-0.5" }
                                                }
                                                if item.fav {
                                                    button (text: "❤", variant: "ghost") {
                                                        onclick: .ToggleFav(item.id)
                                                        style: "shrink-0 h-7 w-7 p-0 text-sm text-destructive hover:bg-destructive/10 rounded-full"
                                                    }
                                                } else {
                                                    button (text: "♡", variant: "ghost") {
                                                        onclick: .ToggleFav(item.id)
                                                        style: "shrink-0 h-7 w-7 p-0 text-sm text-muted-foreground hover:text-foreground rounded-full"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            } else if .density == 3 {
                                grid {
                                    cols: 3
                                    gap: 14
                                    for item in .render_list {
                                        col {
                                            style: group_card
                                            button {
                                                onclick: .OpenPhoto(item.id)
                                                style: photo_btn
                                                col {
                                                    style: "h-48 w-full overflow-hidden bg-muted"
                                                    image (src: item.thumb, alt: item.title, fit: "cover") {
                                                        style: img_fill
                                                    }
                                                }
                                            }
                                            row {
                                                style: "items-center justify-between px-3 py-2 bg-card"
                                                col {
                                                    style: meta_col
                                                    text item.title { style: meta_trunc }
                                                    text item.date { style: "text-[10px] text-muted-foreground mt-0.5" }
                                                }
                                                if item.fav {
                                                    button (text: "❤", variant: "ghost") {
                                                        onclick: .ToggleFav(item.id)
                                                        style: "shrink-0 h-6 w-6 p-0 text-xs text-destructive hover:bg-destructive/10 rounded-full"
                                                    }
                                                } else {
                                                    button (text: "♡", variant: "ghost") {
                                                        onclick: .ToggleFav(item.id)
                                                        style: "shrink-0 h-6 w-6 p-0 text-xs text-muted-foreground hover:text-foreground rounded-full"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            } else if .density == 4 {
                                grid {
                                    cols: 4
                                    gap: 10
                                    for item in .render_list {
                                        col {
                                            style: "group rounded-xl overflow-hidden bg-card border border-border/50 hover:border-primary/60 transition-all shadow-sm flex flex-col"
                                            button {
                                                onclick: .OpenPhoto(item.id)
                                                style: photo_btn
                                                col {
                                                    style: "h-36 w-full overflow-hidden bg-muted"
                                                    image (src: item.thumb, alt: item.title, fit: "cover") {
                                                        style: img_fill
                                                    }
                                                }
                                            }
                                            row {
                                                style: "items-center justify-between px-2.5 py-1.5 bg-card"
                                                col {
                                                    style: "flex-1 min-w-0 pr-1"
                                                    text item.title { style: "text-[11px] font-medium truncate" }
                                                    text item.date { style: "text-[10px] text-muted-foreground" }
                                                }
                                                if item.fav {
                                                    button (text: "❤", variant: "ghost") {
                                                        onclick: .ToggleFav(item.id)
                                                        style: "shrink-0 h-5 w-5 p-0 text-xs text-destructive rounded-full"
                                                    }
                                                } else {
                                                    button (text: "♡", variant: "ghost") {
                                                        onclick: .ToggleFav(item.id)
                                                        style: "shrink-0 h-5 w-5 p-0 text-xs text-muted-foreground rounded-full"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if .render_more_label != "" {
                            row {
                                style: "w-full items-center justify-center py-6"
                                button (text: .render_more_label, variant: "ghost") {
                                    onclick: .LoadMore
                                    style: "h-9 px-5 text-xs rounded-full border border-border text-muted-foreground hover:text-foreground"
                                }
                            }
                        }
                        if !.has_view {
                            col {
                                style: "w-full flex flex-col items-center justify-center py-24 gap-3"
                                if .load_error != "" {
                                    text "⚠️" { style: "text-5xl opacity-80" }
                                    text .load_error { style: "text-sm font-semibold" }
                                    text "后端启动后重新打开本应用（scan 端点 /api/photos/scan）" { style: caption_text }
                                } else if .root_missing {
                                    text "🖼️" { style: "text-5xl opacity-80" }
                                    text "照片源目录不存在" { style: "text-sm font-semibold" }
                                    text "检查后端 photo_root 配置指向的目录" { style: caption_text }
                                } else {
                                    text "🖼️" { style: "text-5xl opacity-80" }
                                    text "当前相册未找到照片" { style: "text-sm font-semibold" }
                                    text "试着清空搜索关键字，或在上方切换到其他相簿" { style: caption_text }
                                }
                            }
                        }
                    }
                }
            } else {
                // ════════════════════════════════════════════════════════
                // 模式 2：沉浸式原画全屏查看态 (移动/平板 Lightbox)
                // ════════════════════════════════════════════════════════
                col {
                    style: "w-full h-full flex flex-col bg-black text-white relative select-none"

                    // 悬浮顶栏（返回 + 标题与参数 + 收藏）
                    row {
                        style: "h-16 shrink-0 items-center justify-between px-6 bg-gradient-to-b from-black/80 to-transparent z-10 gap-4"
                        button {
                            onclick: .BackToGrid
                            style: glass_btn_b
                            icon (name: "chevron-left", size: 16)
                            text "返回网格" { style: label_xs_medium }
                        }
                        col {
                            style: "items-center text-center"
                            text .cur_title { style: "text-sm font-semibold tracking-wide text-white truncate max-w-md" }
                            text .cur_meta { style: "text-[11px] text-white/60 mt-0.5" }
                        }
                        button {
                            onclick: .ToggleFav(.cur_id)
                            style: glass_btn_b
                            text .fav_label { style: label_xs_medium }
                        }
                    }

                    // 主图展示区（无损原图直显，contain 完整视口呈现）
                    col {
                        style: "flex-1 min-h-0 flex items-center justify-center p-4 relative"
                        image (src: .cur_full, alt: .cur_title, fit: "contain") {
                            style: "max-w-full max-h-full"
                        }
                    }

                    // 移动端风格悬浮胶囊控制底栏 (Floating Navigation Capsule)
                    row {
                        style: "h-20 shrink-0 items-center justify-center px-6 bg-gradient-to-t from-black/80 to-transparent z-10"
                        row {
                            style: "items-center px-4 py-2 rounded-full bg-white/15 backdrop-blur-xl border border-white/15 gap-4 shadow-2xl"
                            button {
                                onclick: .PrevPhoto
                                style: glass_btn_a
                                icon (name: "chevron-left", size: 16)
                                text "上一张" { style: label_xs_medium }
                            }
                            text "•" { style: "text-white/30 text-xs" }
                            button {
                                onclick: .NextPhoto
                                style: glass_btn_a
                                text "下一张" { style: label_xs_medium }
                                icon (name: "chevron-right", size: 16)
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        // ---- Init：收藏恢复（JSON 全记录）→ scan 当前目录 → 建网格 ----
        .Init -> {
            // 收藏恢复：JSON 往返（Storage 字符串 → 解析 list）。勿用逐
            // 字符 CSV 解析——str[i] 索引返回字符码 int，拼接会把字节转
            // 十进制（PLAN-043 实机踩坑，收藏恢复全失效）。
            .fav_records = []
            try {
                let saved = json.to_value(Storage.get("photo-gallery.favs"))
                if saved != null {
                    .fav_records = saved
                }
            } catch {
                .fav_records = []
            }
            .ReloadDir()
        }

        // ---- ReloadDir：scan 当前 .dir（Init 与导航共用臂）----
        .ReloadDir -> {
            try {
                // PLAN-043 Phase 2: UI 路径裸 Http.get_json 编译期自带
                // to_value（PLAN-080 F-2③），直接取解析产物，勿再外包。
                // dir 参数经 query 传递——根为空串时后端归一化。
                let data = Http.get_json("/api/photos/scan?dir=" + .dir)
                .root_missing = data.root_missing ?? false
                .load_error = ""
                var entries = data.entries ?? []
                var dlist = []
                var dd = data.dirs ?? []
                var di int = 0
                while di < dd.len() {
                    let d = dd[di]
                    dlist.push({
                        name: d.name,
                        rel_path: d.rel_path,
                        label: "📂 " + d.name,
                        count: d.image_count.str()
                    })
                    di = di + 1
                }
                .dirs = dlist
                var plist = []
                var i int = 0
                while i < entries.len() {
                    let e = entries[i]
                    // fav 标记：fav_records 命中即真
                    var is_fav bool = false
                    var fi2 int = 0
                    while fi2 < .fav_records.len() {
                        if .fav_records[fi2].id == e.id { is_fav = true }
                        fi2 = fi2 + 1
                    }
                    // meta 串：尺寸缺席（头部解析失败）时只留大小+日期
                    var meta str = e.size_str + " · " + e.date
                    let w int = e.width
                    if w > 0 {
                        meta = w.str() + "×" + e.height.str() + " · " + meta
                    }
                    plist.push({
                        id: e.id,
                        title: e.title,
                        date: e.date,
                        meta: meta,
                        fav: is_fav,
                        thumb: e.thumb_url,
                        full: e.full_url,
                        sort_key: e.sort_key
                    })
                    i = i + 1
                }
                .photos = plist
                // 目录徽标与扫描源文案（text 只接标识符，表达式须预计算）
                if .dir == "" {
                    .dir_badge = ""
                    .scan_source_label = "后端实时扫描 · 根目录"
                } else {
                    .dir_badge = "📁 " + .dir
                    .scan_source_label = "后端实时扫描 · " + .dir
                }
            } catch {
                .photos = []
                .dirs = []
                .root_missing = false
                .load_error = "照片后端未就绪（scan 请求失败）"
            }
            .ApplyFilter()
        }

        // ---- 导航：进入子目录 / 返回上一级 ----
        .NavigateDir(rel) -> {
            .dir = rel
            .album = "all"
            .render_cap = 60
            .ReloadDir()
        }

        .GoUp -> {
            // 去掉末段：a/b/c → a/b；单段 → 根。split + 重组（不用逐字符
            // 索引——str[i] 返回字符码 int，与 str 比较恒假）。
            var parts = .dir.split("/")
            if parts.len() <= 1 {
                .dir = ""
            } else {
                var up str = ""
                var ui int = 0
                while ui < parts.len() - 1 {
                    if ui > 0 { up = up + "/" }
                    up = up + parts[ui]
                    ui = ui + 1
                }
                .dir = up
            }
            .album = "all"
            .render_cap = 60
            .ReloadDir()
        }

        .SelectAlbum(a) -> {
            .album = a
            .render_cap = 60
            .ApplyFilter()
        }

        .SetSearch(q) -> {
            .search_q = q
            .render_cap = 60
            .ApplyFilter()
        }

        // ---- 过滤 + 排序 + 页签计数（all=当前目录 / favorites=全局收藏）----
        .ApplyFilter -> {
            let ql str = .search_q.lower()

            // 数据源：收藏视图聚合 fav_records，其余为当前目录 photos
            var source = .photos
            if .album == "favorites" { source = .fav_records }

            // 过滤：搜索子串（fav 已在两源各自内建）
            var hits = []
            var i int = 0
            var n_all int = source.len()
            while i < n_all {
                let p = source[i]
                let tmatch = (ql == "") || p.title.lower().contains(ql)
                if tmatch {
                    hits.push(i)
                }
                i = i + 1
            }

            // 排序：选择序（sort_key = mtime；desc 最新在前）
            var vlist = []
            var vids = []
            var used = []
            var hn int = hits.len()
            var u int = 0
            while u < hn { used.push(false); u = u + 1 }
            var placed int = 0
            while placed < hn {
                var best int = -1
                var best_key int = 0
                var bi int = 0
                while bi < hn {
                    if !used[bi] {
                        let k int = source[hits[bi]].sort_key
                        var take bool = false
                        if best == -1 { take = true }
                        else {
                            if .sort_dir == "asc" { take = k < best_key }
                            if .sort_dir == "desc" { take = k > best_key }
                        }
                        if take {
                            best = bi
                            best_key = k
                        }
                    }
                    bi = bi + 1
                }
                if best >= 0 {
                    let si = hits[best]
                    vlist.push(source[si])
                    vids.push(source[si].id)
                    used[best] = true
                }
                placed = placed + 1
            }

            .view_list = vlist
            .view_ids = vids
            .has_view = (vids.len() > 0)

            // 分批渲染闸：只画前 render_cap 张（VM native image 同步阻塞
            // 加载的实机性能边界——见 model 注记）。剩余张数进按钮文案。
            var cap int = .render_cap
            if vlist.len() < cap { cap = vlist.len() }
            var rlist = []
            var ri int = 0
            while ri < cap {
                rlist.push(vlist[ri])
                ri = ri + 1
            }
            .render_list = rlist
            if vlist.len() > cap {
                .render_more_label = "还有 " + (vlist.len() - cap).str() + " 张 · 点击加载更多"
            } else {
                .render_more_label = ""
            }

            // 页签：全部（当前目录）+ 收藏（全局）；子目录走独立导航条。
            var c_fav int = .fav_records.len()
            var tabs2 = [{ key: "all", label: "全部照片", count: .photos.len().str() }]
            tabs2.push({ key: "favorites", label: "❤ 收藏", count: c_fav.str() })
            .album_tabs = tabs2

            // 文案
            var cur_label str = "全部"
            if .album == "favorites" { cur_label = "收藏" }
            if .search_q == "" {
                .view_label = vids.len().str() + " 项内容 · " + cur_label
            } else {
                .view_label = vids.len().str() + " 项内容 · 搜索 “" + .search_q + "” · " + cur_label
            }
        }

        .ToggleSort -> {
            if .sort_dir == "desc" {
                .sort_dir = "asc"
                .sort_label = "最早 ↑"
            } else {
                .sort_dir = "desc"
                .sort_label = "最新 ↓"
            }
            .render_cap = 60
            .ApplyFilter()
        }

        .SetDensity(d) -> {
            .density = d
        }

        // ---- 查看器：按 id 定位（view_ids 为当前过滤排序序）----
        .OpenPhoto(pid) -> {
            var pos int = -1
            var n int = .view_ids.len()
            var i int = 0
            while i < n {
                if .view_ids[i] == pid { pos = i }
                i = i + 1
            }
            if pos >= 0 {
                .mode = "view"
                .cur_id = pid
                var prev_pos int = pos - 1
                if prev_pos < 0 { prev_pos = n - 1 }
                var next_pos int = pos + 1
                if next_pos >= n { next_pos = 0 }
                .prev_id = .view_ids[prev_pos]
                .next_id = .view_ids[next_pos]

                var si int = -1
                var j int = 0
                while j < .photos.len() {
                    if .photos[j].id == pid { si = j }
                    j = j + 1
                }
                if si >= 0 {
                    .cur_title = .photos[si].title
                    .cur_full = .photos[si].full
                    .cur_meta = .photos[si].meta
                    .is_cur_fav = .photos[si].fav
                    if .is_cur_fav {
                        .fav_label = "❤ 已收藏"
                    } else {
                        .fav_label = "♡ 收藏"
                    }
                }
            }
        }

        .PrevPhoto -> { .OpenPhoto(.prev_id) }
        .NextPhoto -> { .OpenPhoto(.next_id) }
        .BackToGrid -> { .mode = "grid" }

        // ---- 收藏：photos 翻标 + fav_records 增删（跨目录全局）+ 持久化 ----
        .ToggleFav(pid) -> {
            // 当前目录内翻标
            var i int = 0
            var flipped bool = false
            while i < .photos.len() {
                if .photos[i].id == pid {
                    .photos[i].fav = !.photos[i].fav
                    flipped = .photos[i].fav
                }
                i = i + 1
            }
            // fav_records 同步增删（按 flipped 态；当前目录外的旧记录不动）
            var j int = 0
            var found_at int = -1
            while j < .fav_records.len() {
                if .fav_records[j].id == pid { found_at = j }
                j = j + 1
            }
            if flipped && found_at < 0 {
                // 从 photos 取完整记录补入（当前目录内的收藏）
                var k int = 0
                while k < .photos.len() {
                    if .photos[k].id == pid {
                        .fav_records.push({
                            id: .photos[k].id,
                            title: .photos[k].title,
                            date: .photos[k].date,
                            meta: .photos[k].meta,
                            fav: true,
                            thumb: .photos[k].thumb,
                            full: .photos[k].full,
                            sort_key: .photos[k].sort_key
                        })
                    }
                    k = k + 1
                }
            }
            if !flipped && found_at >= 0 {
                // 移除：重建 list（.at 无按索引删）
                var kept = []
                var m int = 0
                while m < .fav_records.len() {
                    if m != found_at { kept.push(.fav_records[m]) }
                    m = m + 1
                }
                .fav_records = kept
            }
            Storage.set("photo-gallery.favs", json.from_value(.fav_records))

            .ApplyFilter()
            if .mode == "view" && .cur_id == pid {
                var si int = -1
                var j2 int = 0
                while j2 < .photos.len() {
                    if .photos[j2].id == pid { si = j2 }
                    j2 = j2 + 1
                }
                // 收藏视图里查看的照片可能不在当前目录——从 fav_records 取态
                if si < 0 {
                    var j3 int = 0
                    while j3 < .fav_records.len() {
                        if .fav_records[j3].id == pid {
                            .is_cur_fav = true
                            .fav_label = "❤ 已收藏"
                        }
                        j3 = j3 + 1
                    }
                } else {
                    .is_cur_fav = .photos[si].fav
                    if .is_cur_fav {
                        .fav_label = "❤ 已收藏"
                    } else {
                        .fav_label = "♡ 收藏"
                    }
                }
            }
        }

        .LoadMore -> {
            .render_cap = .render_cap + 60
            .ApplyFilter()
        }

        .ToggleDark -> { .dark_mode = !.dark_mode }
        .SetAccent(name) -> { .accent_color = name }
    }
}
