            "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><defs><linearGradient id='g18' x1='0' y1='0' x2='1' y2='1'><stop offset='0%' stop-color='rgb(14,165,233)'/><stop offset='100%' stop-color='rgb(30,41,59)'/></linearGradient></defs><rect width='400' height='300' fill='url(%23g18)'/><line x1='100' y1='0' x2='100' y2='300' stroke='rgb(224,242,254)' stroke-width='2' opacity='0.6'/><line x1='200' y1='0' x2='200' y2='300' stroke='rgb(224,242,254)' stroke-width='2' opacity='0.6'/><line x1='300' y1='0' x2='300' y2='300' stroke='rgb(224,242,254)' stroke-width='2' opacity='0.6'/><line x1='0' y1='80' x2='400' y2='80' stroke='rgb(224,242,254)' stroke-width='2' opacity='0.6'/><line x1='0' y1='160' x2='400' y2='160' stroke='rgb(224,242,254)' stroke-width='2' opacity='0.6'/><line x1='0' y1='240' x2='400' y2='240' stroke='rgb(224,242,254)' stroke-width='2' opacity='0.6'/><polygon points='100,80 200,80 200,160 100,160' fill='rgb(255,255,255)' opacity='0.15'/></svg>",
            "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><defs><linearGradient id='g19' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' stop-color='rgb(76,29,149)'/><stop offset='40%' stop-color='rgb(219,39,119)'/><stop offset='80%' stop-color='rgb(251,146,60)'/><stop offset='100%' stop-color='rgb(254,240,138)'/></linearGradient></defs><rect width='400' height='300' fill='url(%23g19)'/><ellipse cx='200' cy='220' rx='140' ry='12' fill='rgb(253,230,138)' opacity='0.6'/><ellipse cx='120' cy='180' rx='90' ry='8' fill='rgb(244,114,182)' opacity='0.5'/><ellipse cx='280' cy='150' rx='110' ry='10' fill='rgb(192,132,252)' opacity='0.4'/></svg>",
            "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><rect width='400' height='300' fill='rgb(15,23,42)'/><line x1='30' y1='170' x2='170' y2='150' stroke='rgb(255,255,255)' stroke-width='4'/><polygon points='170,90 130,210 230,210' fill='rgb(255,255,255)' opacity='0.25' stroke='rgb(255,255,255)' stroke-width='2'/><polygon points='200,160 370,110 370,220' fill='rgb(239,68,68)' opacity='0.5'/><polygon points='200,165 370,135 370,210' fill='rgb(59,130,246)' opacity='0.5'/><polygon points='200,162 370,122 370,215' fill='rgb(34,197,94)' opacity='0.5'/></svg>",
            "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><defs><linearGradient id='g21' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' stop-color='rgb(20,83,45)'/><stop offset='100%' stop-color='rgb(13,148,136)'/></linearGradient></defs><rect width='400' height='300' fill='url(%23g21)'/><path d='M120,0 Q240,150 160,300' stroke='rgb(56,189,248)' stroke-width='40' fill='none' opacity='0.7'/><path d='M120,0 Q240,150 160,300' stroke='rgb(255,255,255)' stroke-width='10' fill='none' opacity='0.6'/><circle cx='90' cy='120' r='25' fill='rgb(51,65,85)'/><circle cx='260' cy='180' r='30' fill='rgb(51,65,85)'/></svg>",
            "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><defs><linearGradient id='g22' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' stop-color='rgb(68,64,60)'/><stop offset='100%' stop-color='rgb(28,25,23)'/></linearGradient></defs><rect width='400' height='300' fill='url(%23g22)'/><polygon points='60,60 160,110 160,300 60,300' fill='rgb(120,53,15)'/><polygon points='60,130 160,150 140,170 40,150' fill='rgb(239,68,68)'/><polygon points='40,150 140,170 120,190 20,170' fill='rgb(255,255,255)'/><rect x='80' y='180' width='50' height='60' fill='rgb(253,224,71)' opacity='0.85'/></svg>",
            "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><defs><linearGradient id='g23' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' stop-color='rgb(2,132,199)'/><stop offset='100%' stop-color='rgb(125,211,252)'/></linearGradient></defs><rect width='400' height='300' fill='url(%23g23)'/><path d='M40,90 Q120,60 220,100 Q300,70 360,90' stroke='rgb(255,255,255)' stroke-width='16' stroke-linecap='round' fill='none' opacity='0.7'/><path d='M80,160 Q180,130 280,170 Q340,140 380,160' stroke='rgb(255,255,255)' stroke-width='12' stroke-linecap='round' fill='none' opacity='0.6'/><path d='M20,220 Q110,200 200,230 Q280,210 340,220' stroke='rgb(255,255,255)' stroke-width='10' stroke-linecap='round' fill='none' opacity='0.5'/></svg>",
            "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><rect width='400' height='300' fill='rgb(10,15,30)'/><line x1='70' y1='90' x2='160' y2='170' stroke='rgb(56,189,248)' stroke-width='2' opacity='0.6'/><line x1='160' y1='170' x2='260' y2='110' stroke='rgb(56,189,248)' stroke-width='2' opacity='0.6'/><line x1='260' y1='110' x2='330' y2='200' stroke='rgb(234,179,8)' stroke-width='2' opacity='0.6'/><line x1='160' y1='170' x2='210' y2='240' stroke='rgb(168,85,247)' stroke-width='2' opacity='0.6'/><circle cx='70' cy='90' r='6' fill='rgb(56,189,248)'/><circle cx='160' cy='170' r='8' fill='rgb(147,197,253)'/><circle cx='260' cy='110' r='7' fill='rgb(250,204,21)'/><circle cx='330' cy='200' r='6' fill='rgb(251,146,60)'/><circle cx='210' cy='240' r='5' fill='rgb(192,132,252)'/></svg>"
        ]

        // ---- 主列表与视图列表（handler 构建；预置一项使 TS 推导字段类型，
        //      027 files_view 同款）----
        var photos = [
            {
                id: 1,
                title: "晨雾山谷",
                album: "nature",
                seed: "gal-01",
                date: "2026-07-14",
                fav: false,
                thumb: "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><defs><linearGradient id='g1' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' stop-color='rgb(15,23,42)'/><stop offset='60%' stop-color='rgb(30,58,74)'/><stop offset='100%' stop-color='rgb(51,92,86)'/></linearGradient></defs><rect width='400' height='300' fill='url(%23g1)'/><circle cx='200' cy='120' r='45' fill='rgb(254,240,138)' opacity='0.85'/><polygon points='0,300 130,130 260,300' fill='rgb(20,83,45)' opacity='0.9'/><polygon points='140,300 280,110 400,300' fill='rgb(13,148,136)' opacity='0.85'/><polygon points='70,300 210,160 350,300' fill='rgb(34,197,94)' opacity='0.75'/><rect y='220' width='400' height='80' fill='rgb(255,255,255)' opacity='0.18'/></svg>",
                full: "https://picsum.photos/seed/gal-01/1600/1200"
            }
        ]
        var view_list = [
            {
                id: 1,
                title: "晨雾山谷",
                album: "nature",
                seed: "gal-01",
                date: "2026-07-14",
                fav: false,
                thumb: "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><defs><linearGradient id='g1' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' stop-color='rgb(15,23,42)'/><stop offset='60%' stop-color='rgb(30,58,74)'/><stop offset='100%' stop-color='rgb(51,92,86)'/></linearGradient></defs><rect width='400' height='300' fill='url(%23g1)'/><circle cx='200' cy='120' r='45' fill='rgb(254,240,138)' opacity='0.85'/><polygon points='0,300 130,130 260,300' fill='rgb(20,83,45)' opacity='0.9'/><polygon points='140,300 280,110 400,300' fill='rgb(13,148,136)' opacity='0.85'/><polygon points='70,300 210,160 350,300' fill='rgb(34,197,94)' opacity='0.75'/><rect y='220' width='400' height='80' fill='rgb(255,255,255)' opacity='0.18'/></svg>",
                full: "https://picsum.photos/seed/gal-01/1600/1200"
            }
        ]
        // 与 view_list 平行的 id 列表（OpenPhoto 定位 + 循环导航；
        // 字符串/标量列表下标读保真——028 注入形态约束同思路）
        var view_ids = [1]

        // 空态门控（027 has_items 同款；模板不可调 .len()）
        var has_view bool = true

        // accent 五色点（name = 主题契约 accent_color 值；dot = 色点类）
        var accents = [
            { name: "coral", dot: "text-[#fb7185]" },
            { name: "ocean", dot: "text-[#38bdf8]" },
            { name: "sage", dot: "text-[#4ade80]" },
            { name: "amber", dot: "text-[#fbbf24]" },
            { name: "indigo", dot: "text-[#818cf8]" }
        ]

        // ---- 计数与文案（handler 预拼，模板零方法调用）----
        var view_label str = ""
        var cnt_all str = "0"
        var cnt_favorites str = "0"
        var cnt_nature str = "0"
        var cnt_city str = "0"
        var cnt_sky str = "0"
        var cnt_abstract str = "0"

        // ---- 查看器（元信息 handler 预取，模板不做字段链查找）----
        var cur_id int = -1
        var cur_title str = ""
        var cur_meta str = ""
        var cur_full str = ""
        var prev_id int = -1
        var next_id int = -1
        var fav_label str = "♡ 收藏"
    }

    view {
        col {
            style: "w-full h-screen flex bg-background text-foreground overflow-hidden font-sans"

            // ══════════ 网格分支（T3）══════════
            if .mode == "grid" {
                row {
                    style: "w-full h-full flex flex-1 overflow-hidden"

                    // ---- 左侧边栏：标题 + 相册导航（手写展开，保静态图标名）----
                    col {
                        style: "w-56 shrink-0 border-r border-border bg-card/40 flex flex-col py-3"
                        col {
                            style: "px-4 pt-1 pb-3 gap-0.5"
                            text "图库 🖼" { style: "text-base font-bold" }
                            text "Photos" { style: "text-[11px] text-muted-foreground uppercase tracking-wider" }
                        }
                        col {
                            style: "mt-1 px-2 gap-0.5"

                            // 相册图标用 emoji 文本（027 先例）：heart/mountain/
                            // building-2/cloud-sun/sparkles 不在 VM lucide 表
                            // （renderer.rs lucide_svg 84 项闭集），跨端不一致；
                            // icon (name:) 仅用于双端表内名字（sun/moon/chevron-*）。
                            button {
                                onclick: .SelectAlbum("all")
                                style: if .album == "all" { "w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-accent/10 text-accent border-l-2 border-primary" } else { "w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-transparent text-muted-foreground hover:bg-accent/40 border-l-2 border-transparent" }
                                text "🖼️" { style: "text-sm shrink-0" }
                                text "全部照片" { style: "text-sm flex-1 text-left" }
                                text .cnt_all { style: "text-xs text-muted-foreground" }
                            }
                            button {
                                onclick: .SelectAlbum("favorites")
                                style: if .album == "favorites" { "w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-accent/10 text-accent border-l-2 border-primary" } else { "w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-transparent text-muted-foreground hover:bg-accent/40 border-l-2 border-transparent" }
                                text "♡" { style: "text-sm shrink-0" }
                                text "收藏" { style: "text-sm flex-1 text-left" }
                                text .cnt_favorites { style: "text-xs text-muted-foreground" }
                            }
                            button {
                                onclick: .SelectAlbum("nature")
                                style: if .album == "nature" { "w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-accent/10 text-accent border-l-2 border-primary" } else { "w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-transparent text-muted-foreground hover:bg-accent/40 border-l-2 border-transparent" }
                                text "🏔️" { style: "text-sm shrink-0" }
                                text "自然" { style: "text-sm flex-1 text-left" }
                                text .cnt_nature { style: "text-xs text-muted-foreground" }
                            }
                            button {
                                onclick: .SelectAlbum("city")
                                style: if .album == "city" { "w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-accent/10 text-accent border-l-2 border-primary" } else { "w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-transparent text-muted-foreground hover:bg-accent/40 border-l-2 border-transparent" }
                                text "🏙️" { style: "text-sm shrink-0" }
                                text "城市" { style: "text-sm flex-1 text-left" }
                                text .cnt_city { style: "text-xs text-muted-foreground" }
                            }
                            button {
                                onclick: .SelectAlbum("sky")
                                style: if .album == "sky" { "w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-accent/10 text-accent border-l-2 border-primary" } else { "w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-transparent text-muted-foreground hover:bg-accent/40 border-l-2 border-transparent" }
                                text "☁️" { style: "text-sm shrink-0" }
                                text "天空" { style: "text-sm flex-1 text-left" }
                                text .cnt_sky { style: "text-xs text-muted-foreground" }
                            }
                            button {
                                onclick: .SelectAlbum("abstract")
                                style: if .album == "abstract" { "w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-accent/10 text-accent border-l-2 border-primary" } else { "w-full flex items-center gap-2.5 h-9 px-3 rounded-lg bg-transparent text-muted-foreground hover:bg-accent/40 border-l-2 border-transparent" }
                                text "✨" { style: "text-sm shrink-0" }
                                text "抽象" { style: "text-sm flex-1 text-left" }
                                text .cnt_abstract { style: "text-xs text-muted-foreground" }
                            }
                        }
                    }

                    // ---- 主区：工具栏 + 计数条 + 网格 ----
                    col {
                        style: "flex-1 min-w-0 flex flex-col"

                        // 工具栏：搜索 / 排序 / 密度 / 主题
                        row {
                            style: "h-14 shrink-0 items-center gap-2 px-4 border-b border-border"
                            input {
                                value: .search_q
                                oninput: .SetSearch
                                placeholder: "搜索照片…"
                                style: "w-48 h-8 text-sm px-3 bg-card border border-border rounded-lg outline-none placeholder:text-muted-foreground focus:border-primary/50"
                            }
                            button (text: .sort_label, variant: "ghost") {
                                onclick: .ToggleSort
                                style: "h-8 px-2.5 text-xs rounded-lg border border-border text-muted-foreground hover:text-foreground"
                            }
                            row {
                                style: "items-center bg-card border border-border rounded-lg p-0.5 gap-0.5"
                                button (text: "2", variant: "ghost") {
                                    onclick: .SetDensity(2)
                                    style: if .density == 2 { "h-7 w-7 text-xs rounded-md bg-accent text-accent-foreground font-bold" } else { "h-7 w-7 text-xs rounded-md text-muted-foreground hover:text-foreground" }
                                }
                                button (text: "3", variant: "ghost") {
                                    onclick: .SetDensity(3)
                                    style: if .density == 3 { "h-7 w-7 text-xs rounded-md bg-accent text-accent-foreground font-bold" } else { "h-7 w-7 text-xs rounded-md text-muted-foreground hover:text-foreground" }
                                }
                                button (text: "4", variant: "ghost") {
                                    onclick: .SetDensity(4)
                                    style: if .density == 4 { "h-7 w-7 text-xs rounded-md bg-accent text-accent-foreground font-bold" } else { "h-7 w-7 text-xs rounded-md text-muted-foreground hover:text-foreground" }
                                }
                            }
                            spacer { style: "flex-1" }
                            if .dark_mode {
                                button {
                                    onclick: .ToggleDark
                                    style: "h-8 w-8 rounded-lg bg-transparent hover:bg-transparent text-muted-foreground hover:text-foreground flex items-center justify-center"
                                    icon (name: "moon", size: 16)
                                }
                            } else {
                                button {
                                    onclick: .ToggleDark
                                    style: "h-8 w-8 rounded-lg bg-transparent hover:bg-transparent text-muted-foreground hover:text-foreground flex items-center justify-center"
                                    icon (name: "sun", size: 16)
                                }
                            }
                            row {
                                style: "items-center gap-1 ml-1"
                                for a in .accents {
                                    if .accent_color == a.name {
                                        button (text: "●") {
                                            onclick: .SetAccent(a.name)
                                            style: "h-7 w-7 p-0 bg-transparent text-lg ${a.dot}"
                                        }
                                    } else {
                                        button (text: "●") {
                                            onclick: .SetAccent(a.name)
                                            style: "h-7 w-7 p-0 bg-transparent text-lg ${a.dot} opacity-40"
                                        }
                                    }
                                }
                            }
                        }

                        // 计数条（view_label 由 handler 预拼）
                        row {
                            style: "h-8 shrink-0 items-center px-4 border-b border-border"
                            text .view_label { style: "text-xs text-muted-foreground" }
                        }

                        // 网格滚动区
                        col {
                            style: "flex-1 min-h-0 overflow-y-auto p-4"
                            if .has_view {
                                // 密度三臂各用静态语义 grid（028 同款构造）：
                                // cols prop / grid 元素均静态——VM 的 cols/类
                                // 动态绑定双不解析（T7 实测），静态臂双端实证。
                                if .density == 2 {
                                    grid {
                                        cols: 2
                                        gap: 12
                                        for item in .view_list {
                                            col {
                                                style: "rounded-xl overflow-hidden border border-border bg-card hover:border-primary/50 transition-colors"
                                                // 图片区 = 打开点击区（button 子件形态，028 T12 实证）
                                                button {
                                                    onclick: .OpenPhoto(item.id)
                                                    // h-auto 覆盖 button 变体默认 h-10
                                                    // （cn/tailwind-merge 后者覆盖前者），
                                                    // 否则图片溢出按钮盖住信息行。
                                                    style: "w-full h-auto p-0 border-0 rounded-none bg-transparent block cursor-pointer"
                                                    col {
                                                        style: "h-40 w-full overflow-hidden bg-muted"
                                                        image (src: item.thumb, alt: item.title, fit: "cover") {
                                                            style: "w-full h-full"
                                                        }
                                                    }
                                                }
                                                // 信息行：标题点击开图 + 收藏按钮（兄弟节点，
                                                // 无冒泡问题——待澄清①的落地形态）
                                                row {
                                                    style: "items-center gap-1 px-3 py-2"
                                                    button {
                                                        onclick: .OpenPhoto(item.id)
                                                        // text-foreground 压过 button 变体
                                                        // 默认 text-primary-foreground（深底深字）
                                                        style: "flex-1 min-w-0 h-6 py-0 p-0 border-0 bg-transparent justify-start text-foreground"
                                                        text item.title { style: "text-sm font-medium truncate" }
                                                    }
                                                    if item.fav {
                                                        button (text: "❤", variant: "ghost") {
                                                            onclick: .ToggleFav(item.id)
                                                            style: "shrink-0 h-7 w-7 p-0 text-sm text-red-400"
                                                        }
                                                    } else {
                                                        button (text: "♡", variant: "ghost") {
                                                            onclick: .ToggleFav(item.id)
                                                            style: "shrink-0 h-7 w-7 p-0 text-sm text-muted-foreground"
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                } else if .density == 3 {
                                    grid {
                                        cols: 3
                                        gap: 12
                                        for item in .view_list {
                                            col {
                                                style: "rounded-xl overflow-hidden border border-border bg-card hover:border-primary/50 transition-colors"
                                                // 图片区 = 打开点击区（button 子件形态，028 T12 实证）
                                                button {
                                                    onclick: .OpenPhoto(item.id)
                                                    // h-auto 覆盖 button 变体默认 h-10
                                                    // （cn/tailwind-merge 后者覆盖前者），
                                                    // 否则图片溢出按钮盖住信息行。
                                                    style: "w-full h-auto p-0 border-0 rounded-none bg-transparent block cursor-pointer"
                                                    col {
                                                        style: "h-40 w-full overflow-hidden bg-muted"
                                                        image (src: item.thumb, alt: item.title, fit: "cover") {
                                                            style: "w-full h-full"
                                                        }
                                                    }
                                                }
                                                // 信息行：标题点击开图 + 收藏按钮（兄弟节点，
                                                // 无冒泡问题——待澄清①的落地形态）
                                                row {
                                                    style: "items-center gap-1 px-3 py-2"
                                                    button {
                                                        onclick: .OpenPhoto(item.id)
                                                        // text-foreground 压过 button 变体
                                                        // 默认 text-primary-foreground（深底深字）
                                                        style: "flex-1 min-w-0 h-6 py-0 p-0 border-0 bg-transparent justify-start text-foreground"
                                                        text item.title { style: "text-sm font-medium truncate" }
                                                    }
                                                    if item.fav {
                                                        button (text: "❤", variant: "ghost") {
                                                            onclick: .ToggleFav(item.id)
                                                            style: "shrink-0 h-7 w-7 p-0 text-sm text-red-400"
                                                        }
                                                    } else {
                                                        button (text: "♡", variant: "ghost") {
                                                            onclick: .ToggleFav(item.id)
                                                            style: "shrink-0 h-7 w-7 p-0 text-sm text-muted-foreground"
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                } else if .density == 4 {
                                    grid {
                                        cols: 4
                                        gap: 12
                                        for item in .view_list {
                                            col {
                                                style: "rounded-xl overflow-hidden border border-border bg-card hover:border-primary/50 transition-colors"
                                                // 图片区 = 打开点击区（button 子件形态，028 T12 实证）
                                                button {
                                                    onclick: .OpenPhoto(item.id)
                                                    // h-auto 覆盖 button 变体默认 h-10
                                                    // （cn/tailwind-merge 后者覆盖前者），
                                                    // 否则图片溢出按钮盖住信息行。
                                                    style: "w-full h-auto p-0 border-0 rounded-none bg-transparent block cursor-pointer"
                                                    col {
                                                        style: "h-40 w-full overflow-hidden bg-muted"
                                                        image (src: item.thumb, alt: item.title, fit: "cover") {
                                                            style: "w-full h-full"
                                                        }
                                                    }
                                                }
                                                // 信息行：标题点击开图 + 收藏按钮（兄弟节点，
                                                // 无冒泡问题——待澄清①的落地形态）
                                                row {
                                                    style: "items-center gap-1 px-3 py-2"
                                                    button {
                                                        onclick: .OpenPhoto(item.id)
                                                        // text-foreground 压过 button 变体
                                                        // 默认 text-primary-foreground（深底深字）
                                                        style: "flex-1 min-w-0 h-6 py-0 p-0 border-0 bg-transparent justify-start text-foreground"
                                                        text item.title { style: "text-sm font-medium truncate" }
                                                    }
                                                    if item.fav {
                                                        button (text: "❤", variant: "ghost") {
                                                            onclick: .ToggleFav(item.id)
                                                            style: "shrink-0 h-7 w-7 p-0 text-sm text-red-400"
                                                        }
                                                    } else {
                                                        button (text: "♡", variant: "ghost") {
                                                            onclick: .ToggleFav(item.id)
                                                            style: "shrink-0 h-7 w-7 p-0 text-sm text-muted-foreground"
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        }
                                    }
                                } else {
                                    col {
                                        style: "w-full flex flex-col items-center justify-center py-16 gap-2"
                                        text "📷" { style: "text-4xl" }
                                        text "未找到照片" { style: "text-sm text-muted-foreground" }
                                        text "试试清除搜索或切换相册" { style: "text-xs text-muted-foreground/70" }
                                    }
                                }
                        }
                    }
                }
            } else {
                // ══════════ 查看器分支（T4）══════════
                col {
                    style: "w-full h-full flex flex-col bg-background"

                    // 顶栏：返回 + 标题 + 收藏切换
                    row {
                        style: "h-14 shrink-0 items-center gap-3 px-4 border-b border-border"
                        button (text: "← 返回网格", variant: "ghost") {
                            onclick: .BackToGrid
                            style: "h-8 px-2.5 text-xs rounded-lg bg-transparent text-muted-foreground hover:text-foreground"
                        }
                        spacer { style: "flex-1" }
                        text .cur_title { style: "text-sm font-semibold" }
                        spacer { style: "flex-1" }
                        button (text: .fav_label, variant: "ghost") {
                            onclick: .ToggleFav(.cur_id)
                            style: "h-8 px-3 text-xs rounded-lg border border-border bg-transparent text-foreground hover:border-primary/50"
                        }
                    }

                    // 大图区（contain 适配，黑场衬底）
                    col {
                        style: "flex-1 min-h-0 flex items-center justify-center bg-black/80 p-4"
                        image (src: .cur_full, alt: .cur_title, fit: "contain") {
                            style: "max-w-full max-h-full"
                        }
                    }

                    // 底栏：prev/next 循环导航 + 元信息
                    row {
                        style: "h-14 shrink-0 items-center gap-3 px-4 border-t border-border"
                        button {
                            onclick: .PrevPhoto
                            style: "h-9 px-3 rounded-lg border border-border bg-transparent text-muted-foreground hover:text-foreground flex items-center gap-1.5"
                            icon (name: "chevron-left", size: 14)
                            text "上一张" { style: "text-xs" }
                        }
                        button {
                            onclick: .NextPhoto
                            style: "h-9 px-3 rounded-lg border border-border bg-transparent text-muted-foreground hover:text-foreground flex items-center gap-1.5"
                            text "下一张" { style: "text-xs" }
                            icon (name: "chevron-right", size: 14)
                        }
                        spacer { style: "flex-1" }
                        text .cur_meta { style: "text-xs text-muted-foreground" }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            // 构建主列表 photos（完整 struct 列表；URL 已拼好完整串）
            var plist = []
            var i int = 0
            for i < .p_ids.len() {
                var p = {
                    id: .p_ids[i],
                    title: .p_titles[i],
                    album: .p_albums[i],
                    seed: .p_seeds[i],
                    date: .p_dates[i],
                    fav: .p_favs[i],
                    thumb: .p_thumbs[i],
                    full: "https://picsum.photos/seed/" + .p_seeds[i] + "/1600/1200"
                }
                plist.push(p)
                i = i + 1
            }
            .photos = plist
            .ApplyFilter()
        }

        .SelectAlbum(a) -> {
            .album = a
            .ApplyFilter()
        }

        .SetSearch(q) -> {
            .search_q = q
            .ApplyFilter()
        }

        // 核心过滤器：album 过滤 → search_q 子串过滤（预小写域）→
        // p_keys 按 sort_dir 排序 → 写 view_list/view_ids + 计数 + 文案。
        // 被 Init/SelectAlbum/SetSearch/ToggleSort/ToggleFav 复用。
        .ApplyFilter -> {
            // 1) 收集命中下标（种子系下标）
            var hits = []
            var used = []
            let ql str = .search_q.lower()
            var i int = 0
            for i < .p_ids.len() {
                var album_match bool = false
                if .album == "all" { album_match = true }
                if .album == "favorites" { album_match = .p_favs[i] }
                if .album != "all" && .album != "favorites" {
                    album_match = .p_albums[i] == .album
                }
                let tl = .p_tls[i]
                let tmatch = (ql == "") || tl.contains(ql)
                if album_match && tmatch {
                    hits.push(i)
                    used.push(0)
                }
                i = i + 1
            }

            // 2) selection sort + used 标记（028 实证习语），整数键比较
            var vlist = []
            var vids = []
            var n int = hits.len()
            var placed int = 0
            for placed < n {
                var best int = -1
                var best_key int = 0
                var bi int = 0
                for bi < n {
                    if used[bi] == 0 {
                        var k int = .p_keys[hits[bi]]
                        var take bool = false
                        if best == -1 { take = true }
                        else {
                            if .sort_dir == "asc" { take = k < best_key }
                            if .sort_dir == "desc" { take = k > best_key }
                        }
                        if take {
                            best = bi
                            best_key = k
                        }
                    }
                    bi = bi + 1
                }
                if best >= 0 {
                    let si = hits[best]
                    var p = {
                        id: .p_ids[si],
                        title: .p_titles[si],
                        album: .p_albums[si],
                        seed: .p_seeds[si],
                        date: .p_dates[si],
                        fav: .p_favs[si],
                        thumb: .p_thumbs[si],
                        full: "https://picsum.photos/seed/" + .p_seeds[si] + "/1600/1200"
                    }
                    vlist.push(p)
                    vids.push(.p_ids[si])
                    used[best] = 1
                }
                placed = placed + 1
            }

            .view_list = vlist
            .view_ids = vids
            .has_view = (vids.len() > 0)

            // 3) 侧边栏六计数（全种子系统计，收藏数随 ToggleFav 联动）
            var c_all int = 0
            var c_fav int = 0
            var c_nat int = 0
            var c_city int = 0
            var c_sky int = 0
            var c_abs int = 0
            var k int = 0
            for k < .p_ids.len() {
                c_all = c_all + 1
                let alb = .p_albums[k]
                if alb == "nature" { c_nat = c_nat + 1 }
                if alb == "city" { c_city = c_city + 1 }
                if alb == "sky" { c_sky = c_sky + 1 }
                if alb == "abstract" { c_abs = c_abs + 1 }
                if .p_favs[k] { c_fav = c_fav + 1 }
                k = k + 1
            }
            .cnt_all = c_all.str()
            .cnt_favorites = c_fav.str()
            .cnt_nature = c_nat.str()
            .cnt_city = c_city.str()
            .cnt_sky = c_sky.str()
            .cnt_abstract = c_abs.str()

            // 4) 计数条文案（当前相册中文标签预拼）
            var cur_label str = ""
            if .album == "all" { cur_label = "全部" }
            if .album == "favorites" { cur_label = "收藏" }
            if .album == "nature" { cur_label = "自然" }
            if .album == "city" { cur_label = "城市" }
            if .album == "sky" { cur_label = "天空" }
            if .album == "abstract" { cur_label = "抽象" }
            if .search_q == "" {
                .view_label = vids.len().str() + " 张照片 · " + cur_label
            } else {
                .view_label = vids.len().str() + " 张照片 · 搜索 “" + .search_q + "” · " + cur_label
            }
        }

        .ToggleSort -> {
            if .sort_dir == "desc" {
                .sort_dir = "asc"
                .sort_label = "最早 ↑"
            } else {
                .sort_dir = "desc"
                .sort_label = "最新 ↓"
            }
            .ApplyFilter()
        }

        .SetDensity(d) -> {
            .density = d
        }

        .OpenPhoto(pid) -> {
            // 在当前视图内定位（view_ids 平行列表）
            var pos int = -1
            var n int = .view_ids.len()
            var i int = 0
            for i < n {
                if .view_ids[i] == pid { pos = i }
                i = i + 1
            }
            if pos >= 0 {
                .mode = "view"
                .cur_id = pid
                // 循环导航预计算（单元素时 prev=next=自身）
                var prev_pos int = pos - 1
                if prev_pos < 0 { prev_pos = n - 1 }
                var next_pos int = pos + 1
                if next_pos >= n { next_pos = 0 }
                .prev_id = .view_ids[prev_pos]
                .next_id = .view_ids[next_pos]
                // 元信息从种子系预取
                var si int = -1
                var j int = 0
                for j < .p_ids.len() {
                    if .p_ids[j] == pid { si = j }
                    j = j + 1
                }
                if si >= 0 {
                    .cur_title = .p_titles[si]
                    .cur_full = "https://picsum.photos/seed/" + .p_seeds[si] + "/1600/1200"
                    let alb = .p_albums[si]
                    var alb_label str = ""
                    if alb == "nature" { alb_label = "自然" }
                    if alb == "city" { alb_label = "城市" }
                    if alb == "sky" { alb_label = "天空" }
                    if alb == "abstract" { alb_label = "抽象" }
                    .cur_meta = alb_label + " · " + .p_dates[si] + " · 1600×1200 · " + .p_seeds[si]
                    if .p_favs[si] {
                        .fav_label = "❤ 已收藏"
                    } else {
                        .fav_label = "♡ 收藏"
                    }
                }
            }
        }

        .PrevPhoto -> { .OpenPhoto(.prev_id) }
        .NextPhoto -> { .OpenPhoto(.next_id) }
        .BackToGrid -> { .mode = "grid" }

        .ToggleFav(id) -> {
            var i int = 0
            for i < .p_ids.len() {
                if .p_ids[i] == id {
                    .p_favs[i] = !.p_favs[i]
                }
                i = i + 1
            }
            .ApplyFilter()
            // 查看器内收藏时同步按钮文案
            if .mode == "view" && .cur_id == id {
                var si int = -1
                var j int = 0
                for j < .p_ids.len() {
                    if .p_ids[j] == id { si = j }
                    j = j + 1
                }
                if si >= 0 {
                    if .p_favs[si] {
                        .fav_label = "❤ 已收藏"
                    } else {
                        .fav_label = "♡ 收藏"
                    }
                }
            }
        }

        .ToggleDark -> { .dark_mode = !.dark_mode }
        .SetAccent(name) -> { .accent_color = name }
    }
}
