// components/fs_util.at — 文件管理器纯函数工具（PLAN-016 T-05/T-06）。
//
// 大小/类型/日期格式化与隐藏名判定。VM 轨遍历纪律（P614 实证）：本模块
// 全部为标量运算，无列表遍历。epoch→民用时间用 Hinnant civil-from-days
// （仅支持 1970-01-01 起，更早返回 "--"——文件系统 mtime 实际不会早于该值）。

/// 字节数格式化（B/KB/MB/GB，一位小数，int 运算避免 float 噪声）
pub fn format_size(n int) str {
    if n < 0 {
        return "--"
    }
    if n < 1024 {
        return n.str() + " B"
    }
    if n < 1048576 {
        var t int = n * 10 / 1024
        return (t / 10).str() + "." + (t - (t / 10) * 10).str() + " KB"
    }
    if n < 1073741824 {
        var t int = n * 10 / 1048576
        return (t / 10).str() + "." + (t - (t / 10) * 10).str() + " MB"
    }
    var t int = n * 10 / 1073741824
    return (t / 10).str() + "." + (t - (t / 10) * 10).str() + " GB"
}

/// 类型列标签（目录/扩展名分派；未知扩展名 = 大写 + " 文件"）
pub fn type_label(ext str, is_dir bool) str {
    if is_dir {
        return "文件夹"
    }
    if ext == "md" || ext == "txt" || ext == "log" || ext == "pdf" || ext == "doc" || ext == "docx" {
        return "文档"
    }
    if ext == "toml" || ext == "json" || ext == "rs" || ext == "at" || ext == "js" || ext == "ts" || ext == "py" || ext == "sh" || ext == "yaml" || ext == "yml" || ext == "html" || ext == "css" {
        return "代码"
    }
    if ext == "png" || ext == "jpg" || ext == "jpeg" || ext == "gif" || ext == "webp" || ext == "bmp" || ext == "svg" || ext == "ico" {
        return "图像"
    }
    if ext == "zip" || ext == "gz" || ext == "tar" || ext == "rar" || ext == "7z" {
        return "压缩包"
    }
    if ext == "csv" || ext == "xlsx" || ext == "xls" {
        return "表格"
    }
    if ext == "mp3" || ext == "wav" || ext == "flac" || ext == "ogg" {
        return "音频"
    }
    if ext == "mp4" || ext == "mkv" || ext == "avi" || ext == "mov" || ext == "webm" {
        return "视频"
    }
    if ext == "exe" || ext == "msi" || ext == "dll" {
        return "可执行"
    }
    if ext == "" {
        return "文件"
    }
    return ext + " 文件"
}

/// 隐藏名判定（dot-prefix；Windows 隐藏属性 stdlib 不可达，v1 口径）
pub fn hidden_name(name str) bool {
    if name == "" {
        return false
    }
    if name.sub(0, 1) == "." {
        return true
    }
    return false
}

fn pad2(n int) str {
    if n < 10 {
        return "0" + n.str()
    }
    return n.str()
}

/// epoch 秒 → "YYYY-MM-DD HH:MM"（本地时区换算不做——VM 无时区面，
/// 显示 UTC；d-4 残留注记）。t <= 0 → "--"。
pub fn fmt_date(t int) str {
    if t <= 0 {
        return "--"
    }
    var days int = t / 86400
    var secs int = t - days * 86400
    var hh int = secs / 3600
    var mm int = (secs - hh * 3600) / 60
    // civil-from-days（Hinnant 2018；1970+ 全正值，负 era 分支省略）
    var z int = days + 719468
    var era int = z / 146097
    var doe int = z - era * 146097
    var yoe int = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    var y int = yoe + era * 400
    var doy int = doe - (365 * yoe + yoe / 4 - yoe / 100)
    var mp int = (5 * doy + 2) / 153
    var d int = doy - (153 * mp + 2) / 5 + 1
    var m int = mp + 3
    if mp >= 10 {
        m = m - 12
    }
    if m <= 2 {
        y = y + 1
    }
    return y.str() + "-" + pad2(m) + "-" + pad2(d) + " " + pad2(hh) + ":" + pad2(mm)
}

/// PLAN-023：媒体管线可缩略的图片扩展名（image_pipeline supported_media_path
/// 同款白名单：jpg/jpeg/png/webp——gif/bmp/svg/ico 管线解码器不收，照旧
/// FileIcon）。thumb 队列的 app 侧预门，避免排注定失败的活。
pub fn is_image_ext(ext str) bool {
    if ext == "jpg" || ext == "jpeg" || ext == "png" || ext == "webp" {
        return true
    }
    return false
}

// ══════════════════════════════════════════════════════════════
// PLAN-684 rev7：Vue 轨 HTTP 读盘的纯路径/列表工具（双轨同源——fs.parent/
// fs.filename/fs.join 为 __vmOnly，Vue 轨面包屑/上行/扩展名须走本节纯函数；
// tree_util 同款 while+索引纪律，for-in 不触函数参数列表）。
// ══════════════════════════════════════════════════════════════

/// 父路径（"/"与"\"双分隔符；盘根/裸盘/无分隔符 → ""）。
/// "D:/a/b" → "D:/a"；"D:/a" → "D:/"；"D:/" → ""（根哨兵，NavTo 面包屑
/// 父链与 fs.parent 的 ""/self 同判）。
pub fn parent_of(p str) str {
    if p == "" {
        return ""
    }
    var i int = p.len() - 1
    var settled bool = false
    while i >= 0 && !settled {
        let ch str = p.sub(i, i + 1)
        if ch == "/" || ch == "\\" {
            i = i - 1
        } else {
            settled = true
        }
    }
    if i < 0 {
        return ""
    }
    var j int = i
    var sep int = -1
    var found bool = false
    while j >= 0 && !found {
        let ch str = p.sub(j, j + 1)
        if ch == "/" || ch == "\\" {
            sep = j
            found = true
        } else {
            j = j - 1
        }
    }
    if sep <= 0 {
        return ""
    }
    // 盘根保留 "C:/" 形态（fs.parent 同款——drives 列表/再次 parent 到 ""）
    if sep == 2 {
        let c1 str = p.sub(1, 2)
        if c1 == ":" {
            return p.sub(0, 3)
        }
    }
    return p.sub(0, sep)
}

/// 末段名（fs.filename 纯函数版；盘根/裸盘 → ""——面包屑根段回退全路径串）
pub fn base_name(p str) str {
    if p.len() <= 3 && p.sub(1, 2) == ":" {
        return ""
    }
    var i int = p.len() - 1
    var settled bool = false
    while i >= 0 && !settled {
        let ch str = p.sub(i, i + 1)
        if ch == "/" || ch == "\\" {
            i = i - 1
        } else {
            settled = true
        }
    }
    if i < 0 {
        return ""
    }
    var j int = i
    var start int = 0
    var found bool = false
    while j >= 0 && !found {
        let ch str = p.sub(j, j + 1)
        if ch == "/" || ch == "\\" {
            start = j + 1
            found = true
        } else {
            j = j - 1
        }
    }
    return p.sub(start, i + 1)
}

/// 扩展名（fs.ext 纯函数版：末 "." 后小写；无点/点在首位 → ""）
pub fn ext_of(name str) str {
    var j int = name.len() - 1
    var dot int = -1
    var found bool = false
    while j > 0 && !found {
        let ch str = name.sub(j, j + 1)
        if ch == "." {
            dot = j
            found = true
        } else {
            j = j - 1
        }
    }
    if dot <= 0 {
        return ""
    }
    return name.sub(dot + 1, name.len()).lower()
}

/// 面包屑链（叶→根收集后反转；{name, path, is_last, sep}——NavTo 双轨共用，
/// 替换 VM 轨原 inline 父链回走块，guard 40 防环）
pub fn build_crumbs(p str) List {
    var segs List = []
    var cur str = p
    var guard int = 0
    var at_root bool = false
    while !at_root && guard < 40 {
        var nm str = base_name(cur)
        if nm == "" {
            nm = cur
        }
        segs.push({ name: nm, path: cur, is_last: false })
        let up str = parent_of(cur)
        if up == "" || up == cur {
            at_root = true
        } else {
            cur = up
        }
        guard = guard + 1
    }
    var cs List = []
    var tot int = segs.len()
    var k int = 0
    while k < tot {
        let src = segs[tot - 1 - k]
        var sepv str = ""
        if k < tot - 1 {
            sepv = "›"
        }
        cs.push({ name: src.name, path: src.path, is_last: (k == tot - 1), sep: sepv })
        k = k + 1
    }
    return cs
}

/// 条目排序（目录恒先 + 四列字典序/int 序；拷贝入 out 再排——不动入参，
/// tree_util 受控函数式同款）。VM 轨原 inline 选择排序提取至此。
pub fn sort_files(list List, col str, dir str) List {
    var out List = []
    var n int = list.len()
    var c int = 0
    while c < n {
        out.push(list[c])
        c = c + 1
    }
    var i int = 0
    while i < n {
        var best int = i
        var j int = i + 1
        while j < n {
            var take bool = false
            var rankJ int = 1
            var rankB int = 1
            let ej = out[j]
            let eb = out[best]
            if ej.is_dir { rankJ = 0 }
            if eb.is_dir { rankB = 0 }
            if rankJ < rankB {
                take = true
            } else {
                if rankJ == rankB {
                    if col == "name" {
                        if dir == "asc" {
                            if ej.name < eb.name { take = true }
                        } else {
                            if ej.name > eb.name { take = true }
                        }
                    }
                    if col == "size" {
                        if dir == "asc" {
                            if ej.size < eb.size { take = true }
                        } else {
                            if ej.size > eb.size { take = true }
                        }
                    }
                    if col == "date" {
                        if dir == "asc" {
                            if ej.date < eb.date { take = true }
                        } else {
                            if ej.date > eb.date { take = true }
                        }
                    }
                    if col == "type" {
                        if dir == "asc" {
                            if ej.type_name < eb.type_name { take = true }
                        } else {
                            if ej.type_name > eb.type_name { take = true }
                        }
                    }
                }
            }
            if take { best = j }
            j = j + 1
        }
        if best != i {
            let tmp = out[i]
            out[i] = out[best]
            out[best] = tmp
        }
        i = i + 1
    }
    return out
}

/// PLAN-016 T-09：扩展名 → 桌面 open_with 关联（v1 静态表——注册表
/// `opens:` 投影面落地前，027 内置默认关联；与 041/031 pac.at opens
/// 声明保持同源，host 执行臂仍按注册表校验）。无关联返回 ""。
pub fn app_for_ext(ext str) str {
    if ext == "txt" || ext == "md" || ext == "log" || ext == "at" || ext == "rs" || ext == "toml" || ext == "json" || ext == "yaml" || ext == "yml" || ext == "py" || ext == "js" || ext == "ts" || ext == "html" || ext == "css" || ext == "csv" {
        return "041-auto-edit"
    }
    if ext == "jpg" || ext == "jpeg" || ext == "png" || ext == "webp" || ext == "gif" || ext == "bmp" || ext == "svg" || ext == "ico" {
        return "031-image-viewer"
    }
    return ""
}
