// app.at — 027-file-manager 文件管理器（Plan 440·App 轨道填洞 ④；PLAN-016 现代化）
//
// 双栏 Finder/Explorer 形态：
// - 左侧栏：真实快捷访问（主目录 + 桌面/文档/下载/图片/音乐，exists 门控）
// - 顶部栏：前进/后退 + 面包屑导航 + 搜索过滤 + 列表/网格视图切换 + 新建/隐藏开关
// - 内容区：明细列表（表格/可排序列头） vs 图标网格
// - 弹层（PLAN-016 T-03/T-04）：alert-dialog 模态（新建/重命名/删除确认）
//   + 锚定 popover 右键菜单（shell dock 菜单同款）+ 框架 toast()
// - 主题（PLAN-016 T-01）：全语义 token + dark_mode 声明——桌面 SetTheme 回写链
//   即时换肤；vue 轨生成器按 dark_mode 绑根 class
// - 真实文件系统（PLAN-016 T-05/T-06）：VM stdlib（fs/file/env/json）真实目录
//   浏览与文件操作；mock 平行数组退役。改日期列依赖 metadata.modified
//   （PLAN-016 crates 扩展；旧宿主二进制该列显示 "--"）
// - 持久化：storage.get/set 保持视图模式、排序字段、排序方向与隐藏文件状态

use components.fs_util: format_size, type_label, hidden_name, fmt_date
use auto.fs
use auto.file
use auto.json

widget App {
    use { package: official from "./components" }
    msg {
        Init, Tick,
        NavTo(str), GoBack, GoForward, GoUp,
        SetViewMode(str), SortByName, SortBySize, SortByDate, SortByType, ToggleHidden,
        SetSearch(str), SelectItem(int), OpenItem(int),
        StartRename(int), SetEditName(str), CommitRename, CancelRename,
        ItemCtx(int), CtxClose, CtxOpen, CtxRename, CtxCopy, CtxCut, CtxPaste, CtxDelete,
        NewFolderOpen, NewFileOpen, NewModalClose, SetNewName(str), CommitNew,
        ConfirmDelete(int), ExecuteDelete, CancelDelete
    }

    model {
        // PLAN-016 T-01：主题跟随——桌面切主题时宿主对本变量回写（dark_mode
        // 回写链），视图全语义 token 随之换肤；vue 轨按本变量绑根 dark class。
        var dark_mode bool = true

        // Tick 驱动延迟引导（250ms 基准 = 012/025 先例）：Init 只做轻量
        // 恢复，重 FS 活（快捷访问探测 + 首目录 listing）挪到首个 Tick——
        // 避开 iced boot 临界区（PLAN-016 实测：Init 内同步 fs 原生调用与
        // 宿主 GPU/surface 初始化偶发竞态挂起）。
        var interval int = 250
        var booted bool = false

        // ---- 真实文件系统导航状态（T-05）----
        var home str = ""                   // Env USERPROFILE/HOME，Init 解析
        var current_path str = ""
        var history = []
        var history_idx int = -1
        var can_back bool = false
        var can_forward bool = false

        // 面包屑段（父链回走生成）
        var crumbs = []

        // 快捷访问（Init 构建，exists 门控）：{ path: str, label: str, is_home: bool }
        var quick = []

        // ---- 视图与过滤配置 ----
        var view_mode str = "list"          // "list" | "grid"
        var sort_col str = "name"           // "name" | "size" | "date" | "type"
        var sort_dir str = "asc"            // "asc" | "desc"
        var show_hidden bool = false
        var search_q str = ""

        // 选中与重命名
        var selected_id int = -1
        var selected_name str = ""
        var selected_info str = "未选中任何项目"
        var editing_id int = -1
        var edit_name str = ""
        var rename_open bool = false
        var rename_path str = ""            // StartRename 捕获（排序后 id 会漂移）

        // ---- 右键菜单（锚定 popover，open 按 ctx_id 匹配行）----
        var ctx_id int = -1

        // ---- 新建文件/文件夹模态（alert-dialog）----
        var new_modal_open bool = false
        var new_modal_type str = "folder"   // "folder" | "file"
        var new_modal_name str = ""

        // ---- 删除确认模态（alert-dialog）----
        var confirm_del_open bool = false
        var confirm_del_id int = -1
        var confirm_del_path str = ""       // ConfirmDelete 捕获
        var confirm_del_name str = ""
        var confirm_del_desc str = "确定要删除选中的项目吗？"

        // ---- 剪贴板状态（真实路径）----
        var clipboard_op str = ""           // "copy" | "cut" | ""
        var clipboard_path str = ""
        var clipboard_name str = ""
        var clipboard_is_dir bool = false
        var clipboard_label str = ""

        // ---- 状态栏 ----
        var item_count_str str = "0 个项目"
        var total_size_str str = "0 B"
        var has_items bool = false

        // 渲染视图模型（NavTo 从真实目录物化；行 schema 与视图绑定一一对应）
        var files_view = [
            {
                id: 0,
                name: "",
                path: "",
                is_dir: false,
                size: 0,
                size_str: "",
                file_ext: "",
                type_name: "",
                date: "",
                is_hidden: false
            }
        ]
    }

    view {
        col {
            style: "w-full h-screen flex flex-col bg-background text-foreground select-none overflow-hidden font-sans"

            // ══════════════════════════════════════════════════════════════
            // 顶部工具栏与路径条
            // ══════════════════════════════════════════════════════════════
            row {
                style: "h-14 border-b border-border px-4 flex items-center justify-between bg-card/90 shrink-0 gap-3"

                // 历史导航与路径面包屑
                row {
                    style: "items-center gap-1.5 flex-1 min-w-0"

                    // 后退
                    button (variant: "ghost") {
                        onclick: .GoBack
                        style: if .can_back { "h-8 w-8 rounded-lg bg-accent text-foreground hover:bg-accent/70 flex items-center justify-center" } else { "h-8 w-8 rounded-lg bg-accent/40 text-muted-foreground flex items-center justify-center opacity-40" }
                        icon (name: "arrow-left", size: 16) {}
                    }

                    // 前进
                    button (variant: "ghost") {
                        onclick: .GoForward
                        style: if .can_forward { "h-8 w-8 rounded-lg bg-accent text-foreground hover:bg-accent/70 flex items-center justify-center" } else { "h-8 w-8 rounded-lg bg-accent/40 text-muted-foreground flex items-center justify-center opacity-40" }
                        icon (name: "arrow-right", size: 16) {}
                    }

                    // 上一级
                    button (variant: "ghost") {
                        onclick: .GoUp
                        style: if .current_path != "" && .current_path != .home { "h-8 w-8 rounded-lg bg-accent text-foreground hover:bg-accent/70 flex items-center justify-center mr-2" } else { "h-8 w-8 rounded-lg bg-accent/40 text-muted-foreground flex items-center justify-center mr-2 opacity-40" }
                        icon (name: "arrow-up", size: 16) {}
                    }

                    // 面包屑胶囊条
                    row {
                        style: "items-center bg-background/80 border border-border rounded-lg px-2.5 py-1 gap-1 flex-1 max-w-md overflow-x-auto"
                        icon (name: "folder-open", size: 14, style: "mr-1 text-muted-foreground") {}
                        for c in .crumbs {
                            if c.is_last {
                                text c.name { style: "text-xs font-semibold text-foreground px-1 py-0.5 rounded bg-accent/50" }
                            } else {
                                button (text: c.name, variant: "ghost") {
                                    onclick: .NavTo(c.path)
                                    style: "text-xs text-muted-foreground hover:text-foreground hover:bg-accent/40 px-1.5 py-0.5 rounded transition-colors"
                                }
                                text "/" { style: "text-xs text-muted-foreground/50 font-mono" }
                            }
                        }
                    }
                }

                // 右侧操作区：搜索 + 视图切换 + 隐藏开关 + 新建
                row {
                    style: "items-center gap-1.5 shrink-0"

                    // 搜索框
                    input {
                        value: .search_q
                        oninput: .SetSearch
                        placeholder: "搜索当前目录..."
                        style: "w-40 text-xs px-3 py-1.5 bg-background/80 border border-border rounded-lg text-foreground outline-none placeholder:text-muted-foreground focus:border-primary"
                    }

                    // 视图模式切换（List ↔ Grid）
                    row {
                        style: "bg-background/80 border border-border rounded-lg p-0.5 gap-0.5"
                        button (variant: "ghost") {
                            onclick: .SetViewMode("list")
                            style: if .view_mode == "list" { "h-7 w-7 rounded-md bg-accent text-foreground flex items-center justify-center shadow-sm" } else { "h-7 w-7 rounded-md text-muted-foreground hover:text-foreground flex items-center justify-center" }
                            icon (name: "align-justify", size: 14) {}
                        }
                        button (variant: "ghost") {
                            onclick: .SetViewMode("grid")
                            style: if .view_mode == "grid" { "h-7 w-7 rounded-md bg-accent text-foreground flex items-center justify-center shadow-sm" } else { "h-7 w-7 rounded-md text-muted-foreground hover:text-foreground flex items-center justify-center" }
                            icon (name: "layout-grid", size: 14) {}
                        }
                    }

                    // 隐藏文件开关
                    button {
                        onclick: .ToggleHidden
                        style: if .show_hidden { "h-8 px-2.5 rounded-lg bg-accent text-primary font-medium border border-primary/50 flex items-center gap-1.5 whitespace-nowrap shrink-0" } else { "h-8 px-2.5 rounded-lg bg-background/60 text-muted-foreground border border-border hover:text-foreground flex items-center gap-1.5 whitespace-nowrap shrink-0" }
                        if .show_hidden {
                            icon (name: "eye", size: 14) {}
                        } else {
                            icon (name: "eye-off", size: 14) {}
                        }
                        text "隐藏项" { style: "text-xs" }
                    }

                    // 新建文件夹按钮（不标 variant——secondary 变体带 icon+text
                    // 子件时渲染空壳，015-notes 形态 = 无 variant + 显式 style）
                    button {
                        onclick: .NewFolderOpen
                        style: "h-8 px-3 rounded-lg bg-accent text-accent-foreground hover:bg-accent/80 font-medium border border-border shadow-sm flex items-center gap-1.5 whitespace-nowrap shrink-0"
                        icon (name: "folder-plus", size: 14) {}
                        text "+ 文件夹" { style: "text-xs" }
                    }

                    // 新建文件按钮
                    button {
                        onclick: .NewFileOpen
                        style: "h-8 px-3 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 font-medium shadow-sm flex items-center gap-1.5 whitespace-nowrap shrink-0"
                        icon (name: "file-plus", size: 14) {}
                        text "+ 文件" { style: "text-xs" }
                    }
                }
            }

            // ══════════════════════════════════════════════════════════════
            // 主体区：左侧栏 + 右内容区
            // ══════════════════════════════════════════════════════════════
            row {
                style: "flex-1 min-h-0 flex"

                // ---- 左侧导航栏（真实快捷访问）----
                col {
                    style: "w-56 border-r border-border bg-card/40 p-3 flex flex-col shrink-0"

                    col {
                        style: "gap-1 flex-1 min-h-0"
                        text "快速访问" { style: "text-[11px] font-bold text-muted-foreground uppercase tracking-wider px-2 py-1 mb-1" }
                        for q in .quick {
                            button {
                                onclick: .NavTo(q.path)
                                style: if .current_path == q.path { "h-9 w-full justify-start px-2.5 rounded-lg bg-accent text-foreground font-medium flex items-center gap-2" } else { "h-9 w-full justify-start px-2.5 rounded-lg text-muted-foreground hover:bg-accent/40 hover:text-foreground flex items-center gap-2" }
                                if q.is_home {
                                    icon (name: "home", size: 15) {}
                                } else {
                                    icon (name: "folder", size: 15) {}
                                }
                                text q.label { style: "text-xs" }
                            }
                        }
                    }
                }

                // ---- 右侧主要内容区（详细列表 vs 图标网格）----
                col {
                    style: "flex-1 bg-background flex flex-col min-h-0 overflow-y-auto"

                    // 模式 A：详细列表视图
                    if .view_mode == "list" {
                        col {
                            style: "w-full flex-1 min-h-0"

                            // 列表表头（可点击排序）
                            row {
                                style: "h-9 border-b border-border px-4 items-center bg-card/30 text-xs font-medium text-muted-foreground select-none sticky top-0 z-10"
                                button (variant: "ghost") {
                                    onclick: .SortByName
                                    style: "w-1/3 justify-start px-2 text-xs text-foreground/80 hover:text-foreground"
                                    row {
                                        style: "items-center gap-1"
                                        text "名称" { style: "text-xs" }
                                        if .sort_col == "name" {
                                            if .sort_dir == "asc" {
                                                icon (name: "arrow-up", size: 12) {}
                                            } else {
                                                icon (name: "arrow-down", size: 12) {}
                                            }
                                        }
                                    }
                                }
                                button (variant: "ghost") {
                                    onclick: .SortBySize
                                    style: "w-28 justify-end px-2 text-xs text-foreground/80 hover:text-foreground"
                                    row {
                                        style: "items-center gap-1"
                                        text "大小" { style: "text-xs" }
                                        if .sort_col == "size" {
                                            if .sort_dir == "asc" {
                                                icon (name: "arrow-up", size: 12) {}
                                            } else {
                                                icon (name: "arrow-down", size: 12) {}
                                            }
                                        }
                                    }
                                }
                                button (variant: "ghost") {
                                    onclick: .SortByType
                                    style: "w-36 justify-start px-4 text-xs text-foreground/80 hover:text-foreground"
                                    row {
                                        style: "items-center gap-1"
                                        text "类型" { style: "text-xs" }
                                        if .sort_col == "type" {
                                            if .sort_dir == "asc" {
                                                icon (name: "arrow-up", size: 12) {}
                                            } else {
                                                icon (name: "arrow-down", size: 12) {}
                                            }
                                        }
                                    }
                                }
                                button (variant: "ghost") {
                                    onclick: .SortByDate
                                    style: "flex-1 justify-start px-2 text-xs text-foreground/80 hover:text-foreground"
                                    row {
                                        style: "items-center gap-1"
                                        text "修改日期" { style: "text-xs" }
                                        if .sort_col == "date" {
                                            if .sort_dir == "asc" {
                                                icon (name: "arrow-up", size: 12) {}
                                            } else {
                                                icon (name: "arrow-down", size: 12) {}
                                            }
                                        }
                                    }
                                }
                                text "操作" { style: "w-16 text-center text-xs text-muted-foreground" }
                            }

                            // 列表行项目
                            if .has_items {
                                col {
                                    style: "divide-y divide-border"
                                    for item in .files_view {
                                        row {
                                            style: if item.id == .selected_id { "h-11 px-4 items-center bg-accent border-l-2 border-primary transition-colors cursor-pointer" } else { "h-11 px-4 items-center hover:bg-accent/40 transition-colors cursor-pointer" }

                                            // 名称列（图标 + 名称）
                                            row {
                                                style: "w-1/3 items-center gap-2 px-2 min-w-0"
                                                FileIcon (is_dir: item.is_dir, ext: item.file_ext, size: 16) {}
                                                button (text: item.name, variant: "ghost") {
                                                    onclick: .OpenItem(item.id)
                                                    oncontextmenu.prevent: .ItemCtx(item.id)
                                                    style: if item.is_hidden { "justify-start text-xs text-muted-foreground font-medium truncate hover:underline" } else { "justify-start text-xs text-foreground font-medium truncate hover:underline" }
                                                }
                                            }

                                            // 大小列
                                            text item.size_str {
                                                style: "w-28 text-right px-2 text-xs font-mono text-muted-foreground"
                                            }

                                            // 类型列
                                            text item.type_name {
                                                style: "w-36 px-4 text-xs text-muted-foreground truncate"
                                            }

                                            // 修改日期列
                                            text item.date {
                                                style: "flex-1 px-2 text-xs text-muted-foreground font-mono"
                                            }

                                            // 快速操作列（··· 锚定右键菜单）
                                            row {
                                                style: "w-16 justify-center"
                                                button (variant: "ghost") {
                                                    onclick: .ItemCtx(item.id)
                                                    style: "h-7 w-7 text-muted-foreground hover:text-foreground hover:bg-accent rounded-md flex items-center justify-center"
                                                    icon (name: "more-horizontal", size: 16) {}
                                                }
                                                popover (open: .ctx_id == item.id, placement: "bottom-end", ondismiss: .CtxClose,
                                                         class: "w-44 p-1.5 rounded-xl border border-border bg-card shadow-xl z-50") {
                                                    button (variant: "ghost") {
                                                        onclick: .CtxOpen
                                                        style: "h-8 w-full justify-start px-3 text-xs text-foreground hover:bg-accent rounded-md flex items-center gap-2"
                                                        icon (name: "folder-open", size: 14) {}
                                                        text "打开" { style: "text-xs" }
                                                    }
                                                    button (variant: "ghost") {
                                                        onclick: .CtxRename
                                                        style: "h-8 w-full justify-start px-3 text-xs text-foreground hover:bg-accent rounded-md flex items-center gap-2"
                                                        icon (name: "pencil", size: 14) {}
                                                        text "重命名" { style: "text-xs" }
                                                    }
                                                    button (variant: "ghost") {
                                                        onclick: .CtxCopy
                                                        style: "h-8 w-full justify-start px-3 text-xs text-foreground hover:bg-accent rounded-md flex items-center gap-2"
                                                        icon (name: "copy", size: 14) {}
                                                        text "复制" { style: "text-xs" }
                                                    }
                                                    button (variant: "ghost") {
                                                        onclick: .CtxCut
                                                        style: "h-8 w-full justify-start px-3 text-xs text-foreground hover:bg-accent rounded-md flex items-center gap-2"
                                                        icon (name: "scissors", size: 14) {}
                                                        text "剪切" { style: "text-xs" }
                                                    }
                                                    if .clipboard_name != "" {
                                                        button (variant: "ghost") {
                                                            onclick: .CtxPaste
                                                            style: "h-8 w-full justify-start px-3 text-xs text-primary font-semibold hover:bg-accent rounded-md flex items-center gap-2"
                                                            icon (name: "clipboard", size: 14) {}
                                                            text "粘贴到此处" { style: "text-xs" }
                                                        }
                                                    }
                                                    col (style: "h-px w-full bg-border my-1")
                                                    button (variant: "ghost") {
                                                        onclick: .CtxDelete
                                                        style: "h-8 w-full justify-start px-3 text-xs text-destructive hover:bg-accent rounded-md flex items-center gap-2"
                                                        icon (name: "trash-2", size: 14) {}
                                                        text "删除" { style: "text-xs" }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            } else {
                                // 空目录占位
                                col {
                                    style: "flex-1 items-center justify-center p-12 gap-3"
                                    icon (name: "folder-open", size: 44, style: "opacity-30 text-muted-foreground") {}
                                    if .booted {
                                            text "此目录为空" { style: "text-sm text-muted-foreground font-medium" }
                                        } else {
                                            text "正在加载..." { style: "text-sm text-muted-foreground font-medium" }
                                        }
                                }
                            }
                        }
                    }

                    // 模式 B：图标网格视图
                    if .view_mode == "grid" {
                        col {
                            style: "w-full flex-1 p-5 min-h-0"
                            if .has_items {
                                row {
                                    style: "flex-wrap gap-4"
                                    for item in .files_view {
                                        col {
                                            style: if item.id == .selected_id { "w-36 h-36 bg-accent border-2 border-primary rounded-xl p-3 items-center justify-center gap-2 cursor-pointer shadow-lg" } else { "w-36 h-36 bg-card/60 border border-border rounded-xl p-3 items-center justify-center gap-2 cursor-pointer hover:bg-accent/40 transition-colors" }

                                            // 图标
                                            FileIcon (is_dir: item.is_dir, ext: item.file_ext, size: 40) {}

                                            // 名称
                                            button (text: item.name, variant: "ghost") {
                                                onclick: .OpenItem(item.id)
                                                oncontextmenu.prevent: .ItemCtx(item.id)
                                                style: if item.is_hidden { "text-xs text-muted-foreground font-medium truncate w-full text-center" } else { "text-xs text-foreground font-medium truncate w-full text-center" }
                                            }

                                            // 大小/副标
                                            text item.size_str { style: "text-[10px] text-muted-foreground font-mono" }

                                            // 行内锚定菜单（右键/长按落点）
                                            popover (open: .ctx_id == item.id, placement: "bottom-start", ondismiss: .CtxClose,
                                                     class: "w-44 p-1.5 rounded-xl border border-border bg-card shadow-xl z-50") {
                                                button (variant: "ghost") {
                                                    onclick: .CtxOpen
                                                    style: "h-8 w-full justify-start px-3 text-xs text-foreground hover:bg-accent rounded-md flex items-center gap-2"
                                                    icon (name: "folder-open", size: 14) {}
                                                    text "打开" { style: "text-xs" }
                                                }
                                                button (variant: "ghost") {
                                                    onclick: .CtxRename
                                                    style: "h-8 w-full justify-start px-3 text-xs text-foreground hover:bg-accent rounded-md flex items-center gap-2"
                                                    icon (name: "pencil", size: 14) {}
                                                    text "重命名" { style: "text-xs" }
                                                }
                                                button (variant: "ghost") {
                                                    onclick: .CtxCopy
                                                    style: "h-8 w-full justify-start px-3 text-xs text-foreground hover:bg-accent rounded-md flex items-center gap-2"
                                                    icon (name: "copy", size: 14) {}
                                                    text "复制" { style: "text-xs" }
                                                }
                                                button (variant: "ghost") {
                                                    onclick: .CtxCut
                                                    style: "h-8 w-full justify-start px-3 text-xs text-foreground hover:bg-accent rounded-md flex items-center gap-2"
                                                    icon (name: "scissors", size: 14) {}
                                                    text "剪切" { style: "text-xs" }
                                                }
                                                col (style: "h-px w-full bg-border my-1")
                                                button (variant: "ghost") {
                                                    onclick: .CtxDelete
                                                    style: "h-8 w-full justify-start px-3 text-xs text-destructive hover:bg-accent rounded-md flex items-center gap-2"
                                                    icon (name: "trash-2", size: 14) {}
                                                    text "删除" { style: "text-xs" }
                                                }
                                            }
                                        }
                                    }
                                }
                            } else {
                                col {
                                    style: "flex-1 items-center justify-center p-12 gap-3"
                                    icon (name: "folder-open", size: 44, style: "opacity-30 text-muted-foreground") {}
                                    if .booted {
                                            text "此目录为空" { style: "text-sm text-muted-foreground font-medium" }
                                        } else {
                                            text "正在加载..." { style: "text-sm text-muted-foreground font-medium" }
                                        }
                                }
                            }
                        }
                    }
                }
            }

            // ══════════════════════════════════════════════════════════════
            // 底部状态栏
            // ══════════════════════════════════════════════════════════════
            row {
                style: "h-9 border-t border-border px-4 items-center justify-between text-xs text-muted-foreground bg-card/80 shrink-0 select-none"
                row {
                    style: "items-center gap-3"
                    text .item_count_str { style: "font-medium text-foreground" }
                    text "|" { style: "text-border" }
                    text .total_size_str { style: "font-mono" }
                }

                row {
                    style: "items-center gap-3"
                    if .clipboard_name != "" {
                        text .clipboard_label {
                            style: "text-primary font-medium text-[11px]"
                        }
                        button (text: "粘贴到此处", variant: "ghost") {
                            onclick: .CtxPaste
                            style: "text-xs px-2 py-0.5 rounded bg-primary/20 text-primary font-semibold hover:bg-primary/30"
                        }
                        text "|" { style: "text-border" }
                    }
                    text .selected_info { style: "text-foreground" }
                }
            }

            // ══════════════════════════════════════════════════════════════
            // 模态弹层（PLAN-016 T-03：alert-dialog，025-sys-monitor 形态）
            // ══════════════════════════════════════════════════════════════

            // 1. 新建文件/文件夹
            alert-dialog (open: .new_modal_open) {
                alert-dialog-content {
                    alert-dialog-header {
                        if .new_modal_type == "folder" {
                            alert-dialog-title "新建文件夹"
                            alert-dialog-description "在当前目录下创建一个新的子文件夹"
                        } else {
                            alert-dialog-title "新建文件"
                            alert-dialog-description "在当前目录下创建一个新的空文件"
                        }
                    }
                    input {
                        value: .new_modal_name
                        oninput: .SetNewName
                        onenter: .CommitNew
                        placeholder: "请输入名称..."
                        style: "w-full text-xs px-3 py-2 bg-background border border-border rounded-lg text-foreground mb-1 outline-none focus:border-primary"
                    }
                    alert-dialog-footer {
                        alert-dialog-cancel "取消" { onclick: .NewModalClose }
                        alert-dialog-action "创建" { onclick: .CommitNew }
                    }
                }
            }

            // 2. 重命名
            alert-dialog (open: .rename_open) {
                alert-dialog-content {
                    alert-dialog-header {
                        alert-dialog-title "重命名"
                        alert-dialog-description f"将「${.selected_name}」重命名为："
                    }
                    input {
                        value: .edit_name
                        oninput: .SetEditName
                        onenter: .CommitRename
                        placeholder: "请输入新名称..."
                        style: "w-full text-xs px-3 py-2 bg-background border border-border rounded-lg text-foreground mb-1 outline-none focus:border-primary"
                    }
                    alert-dialog-footer {
                        alert-dialog-cancel "取消" { onclick: .CancelRename }
                        alert-dialog-action "重命名" { onclick: .CommitRename }
                    }
                }
            }

            // 3. 删除确认
            alert-dialog (open: .confirm_del_open) {
                alert-dialog-content {
                    alert-dialog-header {
                        alert-dialog-title "确认删除项目？"
                        alert-dialog-description .confirm_del_desc
                    }
                    alert-dialog-footer {
                        alert-dialog-cancel "取消" { onclick: .CancelDelete }
                        alert-dialog-action "确认删除" { onclick: .ExecuteDelete }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            // ---- 真实主目录解析（轻量；重活延后到 Tick）----
            .home = Env.get("USERPROFILE")
            if .home == "" {
                .home = Env.get("HOME")
            }

            // ---- 配置恢复（storage 持久化）----
            let vm = storage.get("fileman.view_mode")
            if vm == "grid" { .view_mode = "grid" }
            if vm == "list" { .view_mode = "list" }

            let sc = storage.get("fileman.sort_col")
            if sc == "name" { .sort_col = "name" }
            if sc == "size" { .sort_col = "size" }
            if sc == "date" { .sort_col = "date" }
            if sc == "type" { .sort_col = "type" }

            let sd = storage.get("fileman.sort_dir")
            if sd == "asc" { .sort_dir = "asc" }
            if sd == "desc" { .sort_dir = "desc" }

            let sh = storage.get("fileman.show_hidden")
            if sh == "true" { .show_hidden = true }
            if sh == "false" { .show_hidden = false }
        }

        // ---- 延迟引导（首个 Tick；重 FS 活不在 Init 临界区内）----
        .Tick -> {
            if !.booted {
                .booted = true
                if .home != "" {
                    .quick.push({ path: .home, label: "主目录", is_home: true })
                    var names = ["桌面", "文档", "下载", "图片", "音乐"]
                    var dirs = ["Desktop", "Documents", "Downloads", "Pictures", "Music"]
                    var i int = 0
                    while i < dirs.len() {
                        let p str = fs.join(.home, dirs[i])
                        if file.exists(p) {
                            if file.is_dir(p) {
                                .quick.push({ path: p, label: names[i], is_home: false })
                            }
                        }
                        i = i + 1
                    }
                    .NavTo(.home)
                } else {
                    toast.error("无法定位主目录（USERPROFILE/HOME 均为空）")
                }
            }
        }

        // ---- 目录导航（真实 FS；T-05）----
        .NavTo(target_path) -> {
            let can str = fs.canonical(target_path)
            if can == "" {
                toast.error("无法打开: " + target_path)
            } else {
                if !file.is_dir(can) {
                    toast.error("不是目录: " + can)
                } else {
                    // 列目录先行（read_dir 失败会中止 handler——把一切状态
                    // 变更放在其后，失败时保留原视图）
                    var names = json.parse(fs.read_dir(can))

                    .current_path = can
                    .selected_id = -1
                    .selected_name = ""
                    .selected_info = "未选中任何项目"
                    .editing_id = -1
                    .ctx_id = -1

                    // 维护历史栈
                    if .history_idx < 0 {
                        .history = [can]
                        .history_idx = 0
                    } else {
                        if .history[.history_idx] != can {
                            var new_hist = []
                            var hi int = 0
                            while hi <= .history_idx {
                                new_hist.push(.history[hi])
                                hi = hi + 1
                            }
                            new_hist.push(can)
                            .history = new_hist
                            .history_idx = .history.len() - 1
                        }
                    }
                    .can_back = (.history_idx > 0)
                    .can_forward = (.history_idx + 1 < .history.len())

                    // 面包屑：父链回走 + 反转（叶→根 push，反转后根→叶）
                    var segs = []
                    var p str = can
                    var guard int = 0
                    var at_root bool = false
                    while !at_root && guard < 40 {
                        let nm str = fs.filename(p)
                        if nm == "" {
                            segs.push({ name: p, path: p, is_last: false })
                        } else {
                            segs.push({ name: nm, path: p, is_last: false })
                        }
                        let up str = fs.parent(p)
                        if up == "" || up == p {
                            at_root = true
                        } else {
                            p = up
                        }
                        guard = guard + 1
                    }
                    var cs = []
                    var tot int = segs.len()
                    var k int = 0
                    while k < tot {
                        let src = segs[tot - 1 - k]
                        cs.push({ name: src.name, path: src.path, is_last: (k == tot - 1) })
                        k = k + 1
                    }
                    .crumbs = cs

                    // 条目物化：过滤（隐藏/搜索）→ 逐条 metadata（cap 500）
                    var out = []
                    var total_bytes int = 0
                    var kept int = 0
                    var truncated bool = false
                    for raw in names {
                        let nm str = "" + raw
                        let hid bool = hidden_name(nm)
                        if .show_hidden || !hid {
                            let matches_q = (.search_q == "") || nm.contains(.search_q)
                            if matches_q {
                                if kept >= 500 {
                                    truncated = true
                                } else {
                                    let pp str = fs.join(can, nm)
                                    // 直连 native 三件套（不走 metadata JSON——
                                    // JsonValue 可选字段在 VM 轨产出 None 级联
                                    // TypeError，PLAN-016 D-3 实证）
                                    let isd bool = file.is_dir(pp)
                                    let sz int = file.size(pp)
                                    let mt int = fs.mtime(pp)
                                    let ext str = fs.ext(nm)
                                    out.push({
                                        id: kept,
                                        name: nm,
                                        path: pp,
                                        is_dir: isd,
                                        size: sz,
                                        size_str: format_size(sz),
                                        file_ext: ext,
                                        type_name: type_label(ext, isd),
                                        date: fmt_date(mt),
                                        is_hidden: hid
                                    })
                                    if !isd {
                                        total_bytes = total_bytes + sz
                                    }
                                    kept = kept + 1
                                }
                            }
                        }
                    }

                    // 排序：目录恒先；marks 选择排序（025 sys_store 同款纪律；
                    // name/date 为字符串键已证 str 比较正确，size 为 int 键）
                    var n int = out.len()
                    var sName = []
                    var sType = []
                    var sDate = []
                    var sSize = []
                    var sDir = []
                    var sPath = []
                    var sExt = []
                    var sHid = []
                    var order = []
                    var oi int = 0
                    while oi < n {
                        sName.push("")
                        sType.push("")
                        sDate.push("")
                        sSize.push(0)
                        sDir.push(false)
                        sPath.push("")
                        sExt.push("")
                        sHid.push(false)
                        order.push(-1)
                        oi = oi + 1
                    }
                    var a int = 0
                    while a < n {
                        let r = out[a]
                        sName[a] = r.name
                        sType[a] = r.type_name
                        sDate[a] = r.date
                        sSize[a] = r.size
                        sDir[a] = r.is_dir
                        sPath[a] = r.path
                        sExt[a] = r.file_ext
                        sHid[a] = r.is_hidden
                        a = a + 1
                    }
                    var filled int = 0
                    while filled < n {
                        var best int = -1
                        var b int = 0
                        while b < n {
                            if order[b] == -1 {
                                if best == -1 {
                                    best = b
                                } else {
                                    var take bool = false
                                    var rankB int = 0
                                    var rankBest int = 0
                                    if !sDir[best] { rankBest = 1 }
                                    if !sDir[b] { rankB = 1 }
                                    if rankB < rankBest {
                                        take = true
                                    } else {
                                        if rankB == rankBest {
                                            if .sort_col == "name" {
                                                if .sort_dir == "asc" {
                                                    if sName[b] < sName[best] { take = true }
                                                } else {
                                                    if sName[b] > sName[best] { take = true }
                                                }
                                            }
                                            if .sort_col == "size" {
                                                if .sort_dir == "asc" {
                                                    if sSize[b] < sSize[best] { take = true }
                                                } else {
                                                    if sSize[b] > sSize[best] { take = true }
                                                }
                                            }
                                            if .sort_col == "date" {
                                                if .sort_dir == "asc" {
                                                    if sDate[b] < sDate[best] { take = true }
                                                } else {
                                                    if sDate[b] > sDate[best] { take = true }
                                                }
                                            }
                                            if .sort_col == "type" {
                                                if .sort_dir == "asc" {
                                                    if sType[b] < sType[best] { take = true }
                                                } else {
                                                    if sType[b] > sType[best] { take = true }
                                                }
                                            }
                                        }
                                    }
                                    if take { best = b }
                                }
                            }
                            b = b + 1
                        }
                        if best >= 0 {
                            order[best] = filled
                            let r2 = out[best]
                            out[filled] = r2
                            // 平行键同步换位（维持后续比较一致性）
                            var tn str = sName[filled]
                            sName[filled] = sName[best]
                            sName[best] = tn
                            var tt str = sType[filled]
                            sType[filled] = sType[best]
                            sType[best] = tt
                            var td str = sDate[filled]
                            sDate[filled] = sDate[best]
                            sDate[best] = td
                            var tsz int = sSize[filled]
                            sSize[filled] = sSize[best]
                            sSize[best] = tsz
                            var td2 bool = sDir[filled]
                            sDir[filled] = sDir[best]
                            sDir[best] = td2
                        }
                        filled = filled + 1
                    }

                    .files_view = out
                    if truncated {
                        .item_count_str = "500+ 个项目（已截断）"
                    } else {
                        .item_count_str = kept.str() + " 个项目"
                    }
                    .has_items = (kept > 0)
                    .total_size_str = format_size(total_bytes)
                }
            }
        }

        .GoBack -> {
            if .history_idx > 0 {
                .history_idx = .history_idx - 1
                let prev_path = .history[.history_idx]
                .can_back = (.history_idx > 0)
                .can_forward = true
                .NavTo(prev_path)
            }
        }

        .GoForward -> {
            if .history_idx + 1 < .history.len() {
                .history_idx = .history_idx + 1
                let next_path = .history[.history_idx]
                .can_back = true
                .can_forward = (.history_idx + 1 < .history.len())
                .NavTo(next_path)
            }
        }

        .GoUp -> {
            let up str = fs.parent(.current_path)
            if up != "" && up != .current_path {
                .NavTo(up)
            }
        }

        // ---- 视图与排序 ----
        .SetViewMode(mode) -> {
            .view_mode = mode
            storage.set("fileman.view_mode", mode)
        }

        .SortByName -> {
            if .sort_col == "name" {
                if .sort_dir == "asc" { .sort_dir = "desc" } else { .sort_dir = "asc" }
            } else {
                .sort_col = "name"
                .sort_dir = "asc"
            }
            storage.set("fileman.sort_col", .sort_col)
            storage.set("fileman.sort_dir", .sort_dir)
            .NavTo(.current_path)
        }

        .SortBySize -> {
            if .sort_col == "size" {
                if .sort_dir == "asc" { .sort_dir = "desc" } else { .sort_dir = "asc" }
            } else {
                .sort_col = "size"
                .sort_dir = "asc"
            }
            storage.set("fileman.sort_col", .sort_col)
            storage.set("fileman.sort_dir", .sort_dir)
            .NavTo(.current_path)
        }

        .SortByDate -> {
            if .sort_col == "date" {
                if .sort_dir == "asc" { .sort_dir = "desc" } else { .sort_dir = "asc" }
            } else {
                .sort_col = "date"
                .sort_dir = "asc"
            }
            storage.set("fileman.sort_col", .sort_col)
            storage.set("fileman.sort_dir", .sort_dir)
            .NavTo(.current_path)
        }

        .SortByType -> {
            if .sort_col == "type" {
                if .sort_dir == "asc" { .sort_dir = "desc" } else { .sort_dir = "asc" }
            } else {
                .sort_col = "type"
                .sort_dir = "asc"
            }
            storage.set("fileman.sort_col", .sort_col)
            storage.set("fileman.sort_dir", .sort_dir)
            .NavTo(.current_path)
        }

        .ToggleHidden -> {
            .show_hidden = !.show_hidden
            storage.set("fileman.show_hidden", if .show_hidden { "true" } else { "false" })
            .NavTo(.current_path)
        }

        .SetSearch(q) -> {
            .search_q = q
            .NavTo(.current_path)
        }

        // ---- 选中与打开 ----
        .SelectItem(id) -> {
            .selected_id = id
            var n int = .files_view.len()
            if id >= 0 && id < n {
                let r = .files_view[id]
                .selected_name = r.name
                .selected_info = "选定: " + r.name + " (" + r.size_str + ")"
            }
        }

        .OpenItem(id) -> {
            .SelectItem(id)
            if id >= 0 && id < .files_view.len() {
                let r = .files_view[id]
                if r.is_dir {
                    .NavTo(r.path)
                } else {
                    // PLAN-016 T-09：文件 → 桌面 open_with 关联打开（接线于 T-09）
                    toast("已选择文件: " + r.name + "（关联打开接线于 T-09）")
                }
            }
        }

        // ---- 重命名（alert-dialog 模态；T-06 真实 fs.rename）----
        .StartRename(id) -> {
            if id >= 0 && id < .files_view.len() {
                let r = .files_view[id]
                .editing_id = id
                .edit_name = r.name
                .rename_path = r.path
                .selected_name = r.name
                .rename_open = true
            }
        }

        .SetEditName(name) -> {
            .edit_name = name
        }

        .CommitRename -> {
            let old_path str = .rename_path
            .rename_open = false
            if .editing_id >= 0 && .edit_name != "" && old_path != "" {
                let new_path str = fs.join(.current_path, .edit_name)
                if new_path == old_path {
                    // 未改名
                } else {
                    if file.exists(new_path) {
                        toast.error("已存在同名项目: " + .edit_name)
                    } else {
                        fs.rename(old_path, new_path)
                        toast.success("已重命名为: " + .edit_name)
                    }
                }
                .editing_id = -1
                .rename_path = ""
                .NavTo(.current_path)
            } else {
                .editing_id = -1
                .rename_path = ""
            }
        }

        .CancelRename -> {
            .editing_id = -1
            .rename_path = ""
            .rename_open = false
        }

        // ---- 右键菜单（锚定 popover）----
        .ItemCtx(id) -> {
            .ctx_id = id
            .SelectItem(id)
        }

        .CtxClose -> {
            .ctx_id = -1
        }

        .CtxOpen -> {
            let target int = .ctx_id
            .ctx_id = -1
            if target >= 0 {
                .OpenItem(target)
            }
        }

        .CtxRename -> {
            let target int = .ctx_id
            .ctx_id = -1
            if target >= 0 {
                .StartRename(target)
            }
        }

        .CtxCopy -> {
            let target int = .ctx_id
            .ctx_id = -1
            if target >= 0 && target < .files_view.len() {
                let r = .files_view[target]
                .clipboard_op = "copy"
                .clipboard_path = r.path
                .clipboard_name = r.name
                .clipboard_is_dir = r.is_dir
                .clipboard_label = "已复制: " + r.name
                toast("已复制: " + r.name)
            }
        }

        .CtxCut -> {
            let target int = .ctx_id
            .ctx_id = -1
            if target >= 0 && target < .files_view.len() {
                let r = .files_view[target]
                .clipboard_op = "cut"
                .clipboard_path = r.path
                .clipboard_name = r.name
                .clipboard_is_dir = r.is_dir
                .clipboard_label = "已剪切: " + r.name
                toast("已剪切: " + r.name)
            }
        }

        .CtxPaste -> {
            .ctx_id = -1
            if .clipboard_path != "" {
                let dst str = fs.join(.current_path, .clipboard_name)
                if file.exists(dst) {
                    toast.error("已存在同名项目: " + .clipboard_name)
                } else {
                    if .clipboard_op == "copy" {
                        // copy 是 .at 关键字（TokenKind::Copy），.copy 不可
                        // 调用——单文件与目录统一走 copy_recursive（native.rs
                        // 对文件分支即 std::fs::copy）
                        fs.copy_recursive(.clipboard_path, dst)
                        toast.success("已粘贴: " + .clipboard_name)
                    } else if .clipboard_op == "cut" {
                        fs.rename(.clipboard_path, dst)
                        toast.success("已移动: " + .clipboard_name)
                        .clipboard_op = ""
                        .clipboard_path = ""
                        .clipboard_name = ""
                        .clipboard_is_dir = false
                        .clipboard_label = ""
                    }
                    .NavTo(.current_path)
                }
            }
        }

        .CtxDelete -> {
            let target int = .ctx_id
            .ctx_id = -1
            if target >= 0 {
                .ConfirmDelete(target)
            }
        }

        // ---- 新建模态（T-06 真实落盘）----
        .NewFolderOpen -> {
            .new_modal_type = "folder"
            .new_modal_name = "新建文件夹"
            .new_modal_open = true
        }

        .NewFileOpen -> {
            .new_modal_type = "file"
            .new_modal_name = "新建文档.txt"
            .new_modal_open = true
        }

        .NewModalClose -> {
            .new_modal_open = false
        }

        .SetNewName(name) -> {
            .new_modal_name = name
        }

        .CommitNew -> {
            let name str = .new_modal_name
            .new_modal_open = false
            if name != "" {
                let p str = fs.join(.current_path, name)
                if file.exists(p) {
                    toast.error("已存在同名项目: " + name)
                } else {
                    if .new_modal_type == "folder" {
                        file.create_dir(p)
                        toast.success("已创建文件夹: " + name)
                    } else {
                        file.write_text(p, "")
                        toast.success("已创建文件: " + name)
                    }
                    .NavTo(.current_path)
                }
            }
        }

        // ---- 删除确认（T-06；D-4 口径：文件 + 空目录，非空目录拒绝）----
        .ConfirmDelete(id) -> {
            if id >= 0 && id < .files_view.len() {
                let r = .files_view[id]
                .confirm_del_id = id
                .confirm_del_path = r.path
                .confirm_del_name = r.name
                .confirm_del_desc = "确定要永久删除「" + r.name + "」吗？此操作不可撤销。"
                .confirm_del_open = true
            }
        }

        .ExecuteDelete -> {
            let del_path str = .confirm_del_path
            let del_name str = .confirm_del_name
            let del_id int = .confirm_del_id
            .confirm_del_open = false
            .confirm_del_id = -1
            .confirm_del_path = ""
            if del_path != "" {
                var is_dir_target bool = false
                if del_id >= 0 && del_id < .files_view.len() {
                    let r = .files_view[del_id]
                    is_dir_target = r.is_dir
                }
                if is_dir_target {
                    // D-4：非空目录拒绝（stdlib 无递归删除；walk 逆序删除有
                    // 误删风险，v1 不做）
                    var kids = json.parse(fs.read_dir(del_path))
                    if kids.len() > 0 {
                        toast.error("目录非空，仅支持删除空目录: " + del_name)
                    } else {
                        file.remove_dir(del_path)
                        toast.success("已删除: " + del_name)
                    }
                } else {
                    file.delete(del_path)
                    toast.success("已删除: " + del_name)
                }
                .SelectItem(-1)
                .selected_info = "未选中任何项目"
                .NavTo(.current_path)
            }
        }

        .CancelDelete -> {
            .confirm_del_open = false
            .confirm_del_id = -1
            .confirm_del_path = ""
        }
    }
}
