use calendar_store: CalendarStore

widget App {
    msg {
        PrevMonth,
        NextMonth,
        Today,
        SelectDay(str),
        ToggleSettings,
        ToggleDarkMode,
        SetTheme(str),
        SetAccent(str),
    }

    model {
        var dark_mode bool = false
        var accent_color str = "indigo"
    }

    view {
        col {
            style: "min-h-screen bg-muted/30 p-4 items-center justify-center"
            col {
                style: "w-[448px] p-6 bg-card border border-border rounded-2xl shadow-lg"

                // Header (Nav + Title)
                row {
                    style: "w-full items-center justify-between"
                    button "<" {
                        onclick: .PrevMonth
                        variant: "ghost"
                        style: "w-10 h-10 rounded-full hover:bg-accent text-foreground font-bold"
                    }
                    col {
                        style: "items-center"
                        text .store.month_label { style: "text-2xl font-bold text-foreground" }
                        text f"${.store.year}" { style: "text-sm text-muted-foreground" }
                    }
                    row {
                        style: "gap-2 items-center"
                        button "Today" {
                            onclick: .Today
                            variant: "ghost"
                            style: "px-3 h-10 rounded-full hover:bg-accent text-foreground text-sm font-semibold"
                        }
                        button ">" {
                            onclick: .NextMonth
                            variant: "ghost"
                            style: "w-10 h-10 rounded-full hover:bg-accent text-foreground font-bold"
                        }
                    }
                }

                // Weekday headers
                grid {
                    cols: 7
                    gap: 0
                    style: "w-full mt-4"
                    grid-item { text "Su" { style: "text-xs font-semibold text-muted-foreground text-center py-2" } }
                    grid-item { text "Mo" { style: "text-xs font-semibold text-muted-foreground text-center py-2" } }
                    grid-item { text "Tu" { style: "text-xs font-semibold text-muted-foreground text-center py-2" } }
                    grid-item { text "We" { style: "text-xs font-semibold text-muted-foreground text-center py-2" } }
                    grid-item { text "Th" { style: "text-xs font-semibold text-muted-foreground text-center py-2" } }
                    grid-item { text "Fr" { style: "text-xs font-semibold text-muted-foreground text-center py-2" } }
                    grid-item { text "Sa" { style: "text-xs font-semibold text-muted-foreground text-center py-2" } }
                }

                // Days Grid
                grid {
                    cols: 7
                    gap: 0
                    style: "w-full mt-2"
                    for cell in .store.days {
                        grid-item {
                            button cell.label { variant: "text", onclick: .SelectDay(cell.date), class: cell.cell_class }
                        }
                    }
                }

                // Settings popup (015-notes style)
                if .store.show_settings {
                    col {
                        style: "mt-4 p-3.5 bg-card border border-border rounded-xl gap-3 shadow-lg"
                        row {
                            style: "items-center justify-between"
                            text "Settings" { style: "text-xs font-semibold text-foreground uppercase tracking-wider" }
                            button "✕" {
                                onclick: .ToggleSettings
                                variant: "ghost"
                                style: "text-xs text-muted-foreground hover:text-foreground w-5 h-5 flex items-center justify-center rounded bg-transparent transition-colors"
                            }
                        }
                        col {
                            style: "gap-1.5"
                            text "Theme" { style: "text-xs text-muted-foreground font-medium" }
                            row {
                                style: "gap-2"
                                if .store.dark_mode {
                                    button "🌙 Dark" {
                                        onclick: .SetTheme("dark")
                                        style: "flex-1 py-1 px-2 text-xs font-medium rounded-md bg-primary text-primary-foreground transition-colors"
                                    }
                                    button "☀ Light" {
                                        onclick: .SetTheme("light")
                                        variant: "ghost"
                                        style: "flex-1 py-1 px-2 text-xs font-medium rounded-md text-muted-foreground hover:bg-accent border border-border bg-transparent transition-colors"
                                    }
                                } else {
                                    button "🌙 Dark" {
                                        onclick: .SetTheme("dark")
                                        variant: "ghost"
                                        style: "flex-1 py-1 px-2 text-xs font-medium rounded-md text-muted-foreground hover:bg-accent border border-border bg-transparent transition-colors"
                                    }
                                    button "☀ Light" {
                                        onclick: .SetTheme("light")
                                        style: "flex-1 py-1 px-2 text-xs font-medium rounded-md bg-primary text-primary-foreground transition-colors"
                                    }
                                }
                            }
                        }
                        col {
                            style: "gap-1.5"
                            text "Accent Color" { style: "text-xs text-muted-foreground font-medium" }
                            row {
                                style: "items-center gap-3 py-1"
                                button "" { onclick: .SetAccent("indigo"), style: if .store.accent_color == "indigo" { "w-6 h-6 p-0 rounded-full bg-indigo-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-6 h-6 p-0 rounded-full bg-indigo-500 hover:scale-110 transition-transform" } }
                                button "" { onclick: .SetAccent("coral"), style: if .store.accent_color == "coral" { "w-6 h-6 p-0 rounded-full bg-rose-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-6 h-6 p-0 rounded-full bg-rose-500 hover:scale-110 transition-transform" } }
                                button "" { onclick: .SetAccent("ocean"), style: if .store.accent_color == "ocean" { "w-6 h-6 p-0 rounded-full bg-sky-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-6 h-6 p-0 rounded-full bg-sky-500 hover:scale-110 transition-transform" } }
                                button "" { onclick: .SetAccent("sage"), style: if .store.accent_color == "sage" { "w-6 h-6 p-0 rounded-full bg-emerald-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-6 h-6 p-0 rounded-full bg-emerald-500 hover:scale-110 transition-transform" } }
                                button "" { onclick: .SetAccent("amber"), style: if .store.accent_color == "amber" { "w-6 h-6 p-0 rounded-full bg-amber-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-6 h-6 p-0 rounded-full bg-amber-500 hover:scale-110 transition-transform" } }
                            }
                        }
                    }
                }

                // Footer: Settings button in bottom-left + selected date display
                row {
                    style: "w-full items-center justify-between mt-4 pt-3 border-t border-border"
                    button "⚙ Settings" {
                        onclick: .ToggleSettings
                        variant: "ghost"
                        style: if .store.show_settings {
                            "px-2.5 py-1.5 text-xs font-medium rounded-lg bg-accent text-primary transition-colors"
                        } else {
                            "px-2.5 py-1.5 text-xs font-medium rounded-lg text-muted-foreground hover:bg-accent hover:text-foreground bg-transparent transition-colors"
                        }
                    }
                    text f"Selected: ${.store.selected_date}" {
                        style: "text-xs text-muted-foreground"
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            store.Init()
            .dark_mode = .store.dark_mode
            .accent_color = .store.accent_color
        }

        .PrevMonth -> {
            store.PrevMonth()
        }

        .NextMonth -> {
            store.NextMonth()
        }

        .Today -> {
            store.Today()
        }

        .SelectDay(date) -> {
            store.SelectDay(date)
        }

        .ToggleSettings -> {
            store.ToggleSettings()
        }

        .ToggleDarkMode -> {
            store.ToggleDarkMode()
            .dark_mode = .store.dark_mode
        }

        .SetTheme(t) -> {
            store.SetTheme(t)
            .dark_mode = .store.dark_mode
        }

        .SetAccent(name) -> {
            store.SetAccent(name)
            .accent_color = .store.accent_color
        }
    }
}
