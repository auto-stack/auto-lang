// Plan 522: month_label / days left the store — they are now WIDGET computed
// in app.at (calling calendar_util's month_name / build_month_grid), so the
// ×4 handler recalc chain (.Init/.PrevMonth/.NextMonth/.Today/.SelectDay →
// self.Rebuild()) is gone: mutating year/month/selected_date re-derives the
// grid automatically on both backends.
store CalendarStore {
    model {
        var year int = 2026
        var month int = 6
        var today str = "2026-06-17"
        var selected_date str = "2026-06-17"
        var dark_mode bool = false
        var accent_color str = "indigo"
        var show_settings bool = false
    }

    msg {
        Init,
        PrevMonth,
        NextMonth,
        Today,
        SelectDay(str),
        ToggleDarkMode,
        SetTheme(str),
        SetAccent(str),
        ToggleSettings,
    }

    on {
        .Init -> {
            .year = 2026
            .month = 6
            .today = "2026-06-17"
            .selected_date = "2026-06-17"
            .dark_mode = false
            .accent_color = "indigo"
        }

        .PrevMonth -> {
            var total = .year * 12 + (.month - 1) - 1
            .year = total / 12
            .month = total % 12 + 1
        }

        .NextMonth -> {
            var total = .year * 12 + (.month - 1) + 1
            .year = total / 12
            .month = total % 12 + 1
        }

        .Today -> {
            .year = 2026
            .month = 6
            .selected_date = .today
        }

        .SelectDay(date) -> {
            .selected_date = date
        }

        .ToggleDarkMode -> {
            .dark_mode = !.dark_mode
        }

        .SetTheme(t) -> {
            if t == "dark" {
                .dark_mode = true
            }
            if t == "light" {
                .dark_mode = false
            }
        }

        .SetAccent(name) -> {
            .accent_color = name
        }

        .ToggleSettings -> {
            .show_settings = !.show_settings
        }
    }
}
