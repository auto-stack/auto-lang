widget App {
    msg { Submit }

    model {
        var email str = ""
        var password str = ""
        var email_error str = ""
        var password_error str = ""
    }

    view {
        col {
            col {
                h2 "Sign In" {
                    style: "text-3xl font-extrabold text-gray-900"
                }

                text "Welcome back! Please enter your credentials." {
                    style: "text-gray-500 mt-3"
                }

                col {
                    text "Email" {
                        style: "text-sm font-medium text-gray-700 mt-6"
                    }
                    input (value: .email) {
                        oninput: () => { if .email != "" { .email_error = "" } }
                        placeholder: "you@example.com"
                        style: "w-full px-3 py-2 border rounded-lg mt-2 text-gray-900"
                    }
                    if .email_error != "" {
                        text .email_error {
                            style: "text-red-500 text-xs mt-1"
                        }
                    }
                }

                col {
                    text "Password" {
                        style: "text-sm font-medium text-gray-700 mt-6"
                    }
                    input (value: .password) {
                        oninput: () => { if .password != "" { .password_error = "" } }
                        placeholder: "Enter your password"
                        type: "password"
                        style: "w-full px-3 py-2 border rounded-lg mt-2 text-gray-900"
                    }
                    if .password_error != "" {
                        text .password_error {
                            style: "text-red-500 text-xs mt-1"
                        }
                    }
                }

                button "Sign In" {
                    onclick: .Submit
                    style: "w-full py-2.5 bg-blue-500 text-white rounded-lg font-semibold mt-6"
                }

                row {
                    text "Don't have an account?" {
                        style: "text-sm text-gray-500 mr-1"
                    }
                    a "Sign up" {
                        style: "text-sm text-blue-500 font-semibold underline"
                    }
                    style: "justify-center items-center mt-4"
                }

                style: "bg-white rounded-xl shadow-lg border border-gray-200 p-8 w-112"
            }
            // Plan 512: fit 迁移——center 居中外壳退役，根 col Shrink 包裹；
            // 卡片固定宽 w-112=448px（原 max-w-md+w-full 满窗语义在 Shrink
            // 根下会塌缩；w-[28rem] rem 任意值 iced 端不支持，用 Tailwind
            // 刻度 112×4px）。
            style: "p-6 items-center"
        }
    }

    on {
        .Submit -> {
            if .email == "" {
                .email_error = "Email is required"
            } else {
                .email_error = ""
            }
            if .password == "" {
                .password_error = "Password is required"
            } else {
                .password_error = ""
            }
        }
    }
}
