// app.at — auto-edit 根组件（Plan 449 组件化重构）。
//
// 结构（vm 渲染已验证能力的边界内，见 README「vm 组件边界」）：
//   editor_store.at   store EditorStore —— 全部状态与业务逻辑（038 形态）
//   status_bar.at     StatusBar 组件（013 形态：读 .store + 直调 store）
//   console_panel.at  ConsolePanel 组件（同上）
//   ctx_menu.at       EditorCtxMenu 组件（右键弹层锚态直读 .store）
//
// App 承担：actions 声明（Plan 451：动作注册表 + menubar/toolbar 经 DSL
// 声明，原 auto-edit.at 外挂配置并入）+ view 组合 + on 薄委托 store.Xxx()
// （事件名与 actions 的 handler 映射一一对应，Action=声明层，Event=执行层；
// handler 在解析期校验命中 on{} 事件）。热重载经 action_config_reload
// 工具或 mtime 轮询重读本文件重新提取。
// 以下交互必须留在根视图（MCP 矩阵的快照定位锚——vm 下组件子树对快照
// 不可见，回调 props 更会使组件整体退化，view fn 片段的参数化条件亦不
// 求值；均为 Plan 449 调查结论，详见 README「vm 组件边界」）：
//   tab 条（x 按钮形状定位、"+" 的 onclick: .ActOpen）、确认弹层
//   （"直接关闭" 文本定位）、编辑区（code_editor 绑定根事件）、空态文本。
// code_editor_* 内建若编译进 store handler 会产出坏字节码（panic），
// 故编辑器写操作（set_text）留在根 handler（见 on 块 .ActNew）。

use editor_store: EditorStore
use status_bar: StatusBar
use console_panel: ConsolePanel
use ctx_menu: EditorCtxMenu

widget App {
    // ---- Plan 451: actions 声明块（原 auto-edit.at，DSL 化）----
    // 三源绑定：shortcut（键盘回退层，DSL onkeydown 之下）、menubar/toolbar
    // （view 中占位标签的配置合成）、MCP 自动化同源。enabled_if/checked_if
    // 为条件表达式字符串，对合并根 state 求值（.tab_count 等，无前缀）。
    // 注意：auto test 的 T10 热重载以 "actions {" / "menubar {" 行首字符串
    // 为插入锚——保持这两个标记。
    actions {
        action (id: "file.new",        handler: .ActNew,        title: "新建",   icon: "file-plus",   shortcut: "Ctrl+N")
        action (id: "file.open",       handler: .ActOpen,       title: "打开…",  icon: "folder-open", shortcut: "Ctrl+O")
        action (id: "file.save",       handler: .ActSave,       title: "保存",   icon: "save",        shortcut: "Ctrl+S",
                enabled_if: ".store.tab_count > 0")
        action (id: "file.quit",       handler: .ActQuit,       title: "退出",   shortcut: "Alt+F4")
        action (id: "edit.undo",       handler: .ActUndo,       title: "撤销",   icon: "undo-2",      shortcut: "Ctrl+Z",
                checked_if: ".store.edits > 0")
        action (id: "edit.redo",       handler: .ActRedo,       title: "重做",   icon: "redo-2",      shortcut: "Ctrl+Y")
        action (id: "edit.cut",        handler: .ActCut,        title: "剪切",   icon: "scissors")
        action (id: "edit.copy",       handler: .ActCopy,       title: "复制",   icon: "copy")
        action (id: "edit.paste",      handler: .ActPaste,      title: "粘贴",   icon: "clipboard")
        action (id: "edit.select-all", handler: .ActSelectAll,  title: "全选",   shortcut: "Ctrl+A")
        action (id: "view.console",    handler: .ActConsole,    title: "切换 Console", icon: "terminal", shortcut: "Ctrl+J",
                checked_if: ".store.console_open")
        // 仅声明层快捷键(验证回退层):Ctrl+D 切换 tab
        action (id: "view.switch-tab", handler: .ActSwitchTab,  title: "切换 Tab", shortcut: "Ctrl+D")
        // Plan 428: 代码折叠(切换激活编辑器第 2 行的 fn 块)
        action (id: "view.fold",       handler: .ActFold,       title: "折叠切换")
        action (id: "help.about",      handler: .ActAbout,      title: "关于 auto-edit")

        menubar {
            menu (id: "file", title: "文件") {
                item (action: "file.new")
                item (action: "file.open")
                item (action: "file.save")
                sep
                item (action: "file.quit")
            }
            menu (id: "edit", title: "编辑") {
                item (action: "edit.undo")
                item (action: "edit.redo")
                sep
                item (action: "edit.cut")
                item (action: "edit.copy")
                item (action: "edit.paste")
                item (action: "edit.select-all")
            }
            menu (id: "view", title: "视图") {
                item (action: "view.console")
                item (action: "view.switch-tab")
                item (action: "view.fold")
            }
            menu (id: "help", title: "帮助") {
                item (action: "help.about")
            }
        }

        toolbar {
            item (action: "file.new")
            item (action: "file.open")
            item (action: "file.save")
            sep
            item (action: "edit.undo")
            item (action: "edit.redo")
            sep
            item (action: "edit.cut")
            item (action: "edit.copy")
            item (action: "edit.paste")
        }
    }

    view {
        col (style: "h-full w-full") {

            row (style: "h-8 items-center bg-muted/30 shrink-0 w-full gap-0 px-2") {
                menubar {}
                toolbar (style: "ml-auto") {}
            }
            row (style: "h-8 items-center bg-muted/30 shrink-0 w-full gap-0") {
                // 激活/非激活双分支保留原形态：view fn 片段的参数化条件
                // （onclick 实参/条件样式/if 分支）在 vm 视图构建中不求值，
                // 尚不可用于此（Plan 449 调查结论，见 README）。
                for i, t in .store.tabs {
                    if i == .store.tab {
                        row (style: "items-center bg-[#1C1D24]") {
                            button (text: t.title, variant: "text") {
                                onclick: .TabActivate(i)
                                style: "h-8 px-3 text-[12px] text-zinc-200 font-medium"
                            }
                            button (variant: "text") {
                                icon (name: "x", style: "h-3 w-3 text-zinc-500") {}
                                onclick: .CloseTab(i)
                                style: "h-7 w-6 px-0 py-0 mr-2"
                            }
                        }
                    }
                    if i != .store.tab {
                        button (text: t.title, variant: "text") {
                            onclick: .TabActivate(i)
                            style: "h-8 px-3 text-[12px] text-zinc-500"
                        }
                    }
                }
                button (variant: "text") {
                    icon (name: "plus", style: "h-3.5 w-3.5 text-zinc-400") {}
                    onclick: .ActOpen
                    style: "h-7 w-7 px-0 py-0 ml-1"
                }
            }
            col (style: "h-px w-full bg-border shrink-0")

            for i, t in .store.tabs {
                if t.key == .store.active_key {
                    code_editor (key: t.key, lang: "auto", style: "flex-1 w-full") {
                        content: t.src
                        oninput: .SrcChanged(i)
                        oncursor: .CursorMoved(i)
                        oncontextmenu: .EditorCtx
                    }
                }
            }
            if .store.tab_count == 0 {
                col (style: "flex-1 w-full items-center justify-center") {
                    text "没有打开的文件 — 点击 + 或「文件 → 打开」" {
                        style: "text-[13px] text-zinc-500"
                    }
                }
            }

            if .store.console_open {
                ConsolePanel()
            }

            // Plan 422 P3: 坐标锚弹层 —— 右键编辑器时 EditorCtx(x, y) 记录
            // 落点并置开；面板本体在 ctx_menu.at 组件。
            EditorCtxMenu()

            // Plan 420 P2: 关闭脏 tab 的确认弹层(固定落点,坐标锚)。
            popover (open: .store.confirm_open, x: 420.0, y: 260.0, ondismiss: .ConfirmCancel,
                     class: "w-64 bg-[#16171B] border border-zinc-700 shadow-md py-2 px-3") {
                text "有未保存的修改" { style: "text-[13px] text-zinc-100 py-1" }
                text "关闭前要保存吗?" { style: "text-[12px] text-zinc-400 pb-2" }
                row (style: "gap-2 justify-end") {
                    button (text: "直接关闭", variant: "text") {
                        onclick: .ConfirmClose
                        style: "h-7 px-2 text-[12px] text-zinc-300"
                    }
                    button (text: "取消", variant: "text") {
                        onclick: .ConfirmCancel
                        style: "h-7 px-2 text-[12px] text-zinc-400"
                    }
                }
            }

            StatusBar()
        }
    }

    on {
        .TabActivate(i) -> { store.TabActivate(i) }
        .SrcChanged(i) -> { store.SrcChanged(i) }
        .CursorMoved(i) -> { store.CursorMoved(i) }
        .CloseTab(i) -> { store.CloseTab(i) }
        .ConfirmClose -> { store.ConfirmClose() }
        .ConfirmCancel -> { store.ConfirmCancel() }
        .EditorCtx(x, y) -> { store.EditorCtx(x, y) }
        // code_editor_* 内建若编译进 store handler 会产出坏字节码（panic），
        // 故编辑器写操作（set_text）留在根 handler；状态操作在 store.ActNew。
        .ActNew -> {
            store.ActNew()
            if .store.tab_count > 0 {
                code_editor_set_text(.store.active_key, "")
            }
        }
        .ActOpen -> { store.ActOpen() }
        .ActSave -> { store.ActSave() }
        .ActQuit -> { store.ActQuit() }
        .ActUndo -> { store.ActUndo() }
        .ActRedo -> { store.ActRedo() }
        .ActSelectAll -> { store.ActSelectAll() }
        .ActCut -> { store.ActCut() }
        .ActCopy -> { store.ActCopy() }
        .ActPaste -> { store.ActPaste() }
        .ActConsole -> { store.ActConsole() }
        .ActSwitchTab -> { store.ActSwitchTab() }
        .ActFold -> { store.ActFold() }
        .ActAbout -> { store.ActAbout() }
    }
}
