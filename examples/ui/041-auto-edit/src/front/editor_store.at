// editor_store.at — auto-edit 的全部状态与业务逻辑（Plan 449 自 app.at 下沉）。
//
// 038-minesweeper / 013-todo 的 store-in-vm 先例：store 字段经 lib.rs 合并进
// 根 state（无前缀），auto-edit.at 的 enabled-if/checked-if 表达式（.tab_count
// 等）按原样继续求值；App 侧 on 薄委托 store.Xxx()，事件名与 auto-edit.at 的
// handler 映射一一对应（Action=声明层，Event=执行层）。
//
// 派生标量（tab/tab_count/line/col/sel 等）仍由各 handler 就地重算——
// VM view 不能调函数（Plan 402 约束），模板只读字段。
// 重复逻辑收口（store handler 间经 store.Xxx() 互调，038/013 先例）：
//   RemoveAt   —— 关闭 tab 的 remove + 索引修补 + 激活态重算
//                 （原 CloseTab/ConfirmClose 各持一份，现合一）
//   SyncCursor —— line/col/sel 三元组读回（原 5 处重复，现 1 处）
use components.tree_util: toggle_id

store EditorStore {
    model {
        // Plan 420 P1: tabs 数组态 —— 每 tab = {key, title, path, dirty, src}。
        // key 唯一(code_editor registry 按它保存实例);src 仅作初值/外部
        // 重置(last_external 相等即 no-op,用户输入不会被 stale 值踩掉)。
        var tabs list = [
            {key: "tab-main", title: "main.at", path: "", dirty: false, src: "// 预填文本显示测试 — 如果你看到这行字,说明正文渲染正常\nfn add(a int, b int) int {\n    return a + b\n}\n\n// 中文注释:你好世界\nprint(add(1, 2))\n"},
            {key: "tab-util", title: "util.at", path: "", dirty: false, src: "// 工具模块 — 每个 tab 的编辑状态独立保存\nfn greet(name str) str {\n    return \"hello \" + name\n}\n\nfn farewell(name str) str {\n    return \"bye \" + name\n}\n"},
        ]
        var active_key str = "tab-main"
        // 派生标量(索引镜像/空态判断/状态栏与矩阵断言面;结构变化时由
        // 各 handler 就地重算,不在模板里调方法)。
        var tab int = 0
        var tab_count int = 2
        var open_count int = 2
        var title_active str = "main.at"
        var path_active str = ""
        var src_active str = "// 预填文本显示测试 — 如果你看到这行字,说明正文渲染正常
fn add(a int, b int) int {
    return a + b
}

// 中文注释:你好世界
print(add(1, 2))
"
        var edits int = 0
        var line int = 1
        var col int = 1
        var sel int = 0
        var console_open bool = false
        var console str = ""
        // Plan 428: 折叠状态读数(隐藏行数;矩阵经 autoui_state 校验)
        var fold_hidden int = 0
        // Plan 422 P3: 右键菜单(contextmenu popover 的坐标锚状态)
        var ctx_open bool = false
        var ctx_x float = 0
        var ctx_y float = 0
        // Plan 420 P2: 关闭脏 tab 的确认弹层状态
        var confirm_open bool = false
        var confirm_idx int = -1
        // Plan 626 T-06: 退出/关窗确认弹层(窗口 X 与「退出」共用入口)。
        var quit_confirm_open bool = false
        // PLAN-618 T-06: 左侧文件浏览器树(TreeView 受控——页面持
        // expanded/selected)。文件节点 id = 相对 workspace 根的路径
        // ('/'分隔),目录节点 id 不与任何文件路径重合,TreeSelect 按
        // fs.join(ws_dir, id) 全路径匹配/读盘。初始表仅 Init 前占位,
        // .Init 经 fs.tree + json.to_value 装载真实目录(Plan 626 T-05)。
        var tree_nodes list = [
            { id: "src", label: "src", children: [
                { id: "src/app.at", label: "app.at", children: [], kind: "file", icon: "file-text", is_leaf: true, badge: "" },
                { id: "src/editor_store.at", label: "editor_store.at", children: [], kind: "file", icon: "file-text", is_leaf: true, badge: "" },
                { id: "src/status_bar.at", label: "status_bar.at", children: [], kind: "file", icon: "file-text", is_leaf: true, badge: "" },
                { id: "src/console_panel.at", label: "console_panel.at", children: [], kind: "file", icon: "file-text", is_leaf: true, badge: "" },
                { id: "src/ctx_menu.at", label: "ctx_menu.at", children: [], kind: "file", icon: "file-text", is_leaf: true, badge: "" }
            ], kind: "dir", icon: "folder", is_leaf: false, badge: "" },
            { id: "docs", label: "docs", children: [
                { id: "README.md", label: "README.md", children: [], kind: "file", icon: "file-text", is_leaf: true, badge: "" }
            ], kind: "dir", icon: "folder", is_leaf: false, badge: "" }
        ]
        var tree_expanded list = ["src", "docs"]
        var tree_sel str = ""
        // Plan 626 T-05: workspace 根(AUTO_PROJECT_DIR 由 auto-man 注入,
        // automan.rs set_var)——Explorer 头部展示名,TreeSelect/保存按它拼全路径。
        var ws_dir str = ""
        var ws_name str = ""
    }

    msg {
        TabActivate(int), SrcChanged(int), CursorMoved(int),
        CloseTab(int), RemoveAt(int),
        ConfirmClose, ConfirmCancel, ConsoleClear, SyncCursor(str),
        EditorCtx(float, float), CtxClose, CtxCut, CtxCopy, CtxSelectAll,
        ActNew, ActOpen, ActSave, ActQuit, ActUndo, ActRedo,
        ActSelectAll, ActCut, ActCopy, ActPaste, ActConsole,
        ActSwitchTab, ActFold, ActAbout,
        TreeToggle(str), TreeSelect(str),
        LoadWorkspace, CloseRequest, QuitDiscard, QuitSaveClose, QuitConfirmCancel,
    }

    on {
        // ---- Plan 626 T-05: 装载真实 workspace 目录树,Explorer 头部展示
        // 名。经 App.Init 薄委托(Init 名保留给根 widget 生命周期,store 侧
        // handler 不得占用——handler_EditorStore_Init 不合成,link 期炸)。
        .LoadWorkspace -> {
            .ws_dir = Env.get("AUTO_PROJECT_DIR")
            if .ws_dir == "" {
                .ws_dir = "."
            }
            .ws_name = file_basename(.ws_dir)
            .tree_nodes = json.to_value(fs.tree(.ws_dir, 4))
            .tree_expanded = ["src"]
            console_log("workspace: " + .ws_dir)
            .console = console_lines()
        }

        // ---- 内部 helper：光标三元组读回 ----
        .SyncCursor(key) -> {
            .line = code_editor_cursor_line(key) + 1
            .col = code_editor_cursor_col(key) + 1
            .sel = code_editor_selection_len(key)
        }

        .TabActivate(i) -> {
            .tab = i
            .active_key = .tabs[i].key
            .title_active = .tabs[i].title
            .path_active = .tabs[i].path
            .src_active = .tabs[i].src
            store.SyncCursor(.tabs[i].key)
            .console = console_lines()
        }
        // Plan 428: 切换激活编辑器第 2 行 fn 块的折叠态并读回隐藏行数。
        .ActFold -> {
            code_editor_fold_toggle(.active_key, 2)
            .fold_hidden = code_editor_fold_hidden_count(.active_key)
            .console = console_lines()
        }
        .SrcChanged(i) -> {
            .edits = .edits + 1
            .tabs[i].dirty = true
            .console = console_lines()
        }
        .CursorMoved(i) -> {
            store.SyncCursor(.tabs[i].key)
            .console = console_lines()
        }

        // ---- 内部 helper：关闭 tab 的 remove + 索引修补 + 激活态重算 ----
        // （原 CloseTab/ConfirmClose 两份重复合一；脏 tab 判定在 CloseTab）
        .RemoveAt(i) -> {
            .tabs.remove(i)
            .tab_count = .tab_count - 1
            if .tab_count > 0 {
                if i == .tab {
                    if i >= .tab_count {
                        .tab = .tab_count - 1
                    }
                }
                if i < .tab {
                    .tab = .tab - 1
                }
                .active_key = .tabs[.tab].key
                .title_active = .tabs[.tab].title
                .path_active = .tabs[.tab].path
                store.SyncCursor(.active_key)
            } else {
                .tab = -1
                .active_key = ""
                .title_active = ""
                .path_active = ""
                .line = 1
                .col = 1
                .sel = 0
            }
        }
        .CloseTab(i) -> {
            if .tabs[i].dirty {
                .confirm_idx = i
                .confirm_open = true
            } else {
                store.RemoveAt(i)
                console_log("closed tab; open=" + .tab_count.str())
            }
            .console = console_lines()
        }
        .ConfirmClose -> {
            .confirm_open = false
            if .confirm_idx >= 0 {
                store.RemoveAt(.confirm_idx)
                console_log("closed dirty tab; open=" + .tab_count.str())
            }
            .confirm_idx = -1
            .console = console_lines()
        }
        .ConfirmCancel -> {
            .confirm_open = false
            .confirm_idx = -1
        }
        .ConsoleClear -> {
            console_clear()
            .console = ""
        }

        // ---- Plan 422 P3: contextmenu popover ----
        // 编辑器右键:坐标为视口系(renderer 侧已加 widget origin)。
        .EditorCtx(x, y) -> {
            .ctx_x = x
            .ctx_y = y
            .ctx_open = true
            console_log("ctx menu opened")
            .console = console_lines()
        }
        .CtxClose -> {
            .ctx_open = false
        }
        .CtxCut -> {
            .ctx_open = false
            if .tab_count > 0 {
                code_editor_cut(.active_key)
                .tabs[.tab].src = code_editor_text(.active_key)
                .src_active = .tabs[.tab].src
                .tabs[.tab].dirty = true
            }
            console_log("ctx cut")
            .console = console_lines()
        }
        .CtxCopy -> {
            .ctx_open = false
            if .tab_count > 0 {
                code_editor_copy(.active_key)
            }
            console_log("ctx copy")
            .console = console_lines()
        }
        .CtxSelectAll -> {
            .ctx_open = false
            if .tab_count > 0 {
                code_editor_select_all(.active_key)
                .sel = code_editor_selection_len(.active_key)
            }
            console_log("ctx select all")
            .console = console_lines()
        }

        // ---- Plan 418: semantic actions (menu / toolbar / shortcut 3-source) ----
        .ActNew -> {
            // code_editor_set_text 编译进 store handler 会产出坏字节码
            // （virt_memory read_i32 越界 panic，Plan 449 调查结论）——该
            // 内建调用留在 App 根 handler（widget 路径已验证），见 app.at。
            if .tab_count > 0 {
                .tabs[.tab].path = ""
                .tabs[.tab].title = "untitled.at"
                .tabs[.tab].dirty = false
                .tabs[.tab].src = ""
                .src_active = ""
                .title_active = "untitled.at"
                .path_active = ""
            }
            console_log("new: cleared active tab")
            .console = console_lines()
        }
        .ActOpen -> {
            // Plan 420 P2: AUTO_OPEN_PATH 环境变量旁路(测试构建语义,prod
            // 忽略)—— 阻塞式 rfd 对话框无法被 MCP 驱动的盲区由此打通。
            var p str = Env.get("AUTO_OPEN_PATH")
            if p == "" {
                p = dialog_open(".at, .au, .rs, .txt")
            }
            if p != "" {
                let s = File.read_text(p)
                .open_count = .open_count + 1
                .tabs.push({key: "tab-" + .open_count.str(), title: file_basename(p), path: p, dirty: false, src: s})
                .tab = .tab_count
                .tab_count = .tab_count + 1
                .active_key = .tabs[.tab].key
                .title_active = .tabs[.tab].title
                .path_active = p
                .src_active = s
                .line = 1
                .col = 1
                .sel = 0
                console_log("open: " + p)
            } else {
                console_log("open: cancelled")
            }
            .console = console_lines()
        }
        .ActSave -> {
            if .tab_count > 0 {
                if .path_active == "" {
                    // Plan 420 P2: AUTO_SAVE_PATH 旁路(与 AUTO_OPEN_PATH 同型)。
                    var p str = Env.get("AUTO_SAVE_PATH")
                    if p == "" {
                        p = dialog_save("untitled.at")
                    }
                    if p != "" {
                        .path_active = p
                        .tabs[.tab].path = p
                        .title_active = file_basename(p)
                        .tabs[.tab].title = file_basename(p)
                    }
                }
                if .path_active != "" {
                    File.write_text(.path_active, code_editor_text(.active_key))
                    .tabs[.tab].dirty = false
                    console_log("saved: " + .path_active)
                } else {
                    console_log("save: cancelled")
                }
            }
            .console = console_lines()
        }
                .ActUndo -> {
            if .tab_count > 0 {
                code_editor_undo(.active_key)
                .tabs[.tab].src = code_editor_text(.active_key)
                .src_active = .tabs[.tab].src
            }
            console_log("undo")
            .console = console_lines()
        }
        .ActRedo -> {
            if .tab_count > 0 {
                code_editor_redo(.active_key)
                .tabs[.tab].src = code_editor_text(.active_key)
                .src_active = .tabs[.tab].src
            }
            console_log("redo")
            .console = console_lines()
        }
        .ActSelectAll -> {
            if .tab_count > 0 {
                code_editor_select_all(.active_key)
                store.SyncCursor(.active_key)
            }
            console_log("select all")
            .console = console_lines()
        }
        .ActCut -> {
            if .tab_count > 0 {
                code_editor_cut(.active_key)
                .tabs[.tab].src = code_editor_text(.active_key)
                .src_active = .tabs[.tab].src
                .tabs[.tab].dirty = true
            }
            console_log("cut")
            .console = console_lines()
        }
        .ActCopy -> {
            if .tab_count > 0 {
                code_editor_copy(.active_key)
            }
            console_log("copy")
            .console = console_lines()
        }
        .ActPaste -> {
            if .tab_count > 0 {
                code_editor_paste(.active_key)
                .tabs[.tab].src = code_editor_text(.active_key)
                .src_active = .tabs[.tab].src
                .tabs[.tab].dirty = true
            }
            console_log("paste")
            .console = console_lines()
        }
        .ActConsole -> {
            .console_open = !.console_open
            .console = console_lines()
        }
        .ActSwitchTab -> {
            if .tab_count > 1 {
                // 两 tab 演示语义保留(Ctrl+D 矩阵断言 0↔1 翻转)。
                .tab = 1 - .tab
                .active_key = .tabs[.tab].key
                .title_active = .tabs[.tab].title
                .path_active = .tabs[.tab].path
                .src_active = .tabs[.tab].src
                store.SyncCursor(.active_key)
            }
            .console = console_lines()
        }
        .ActAbout -> {
            console_log("auto-edit 0.1 — AutoUI playground (plans 413/414/418/420)")
            .console = console_lines()
        }

        // ---- PLAN-618 T-06: 文件浏览器树 ----
        .TreeToggle(id) -> {
            .tree_expanded = toggle_id(.tree_expanded, id)
        }
        // 选中文件 → OpenByPath 语义:同路径 tab 已开则激活,否则读盘构造
        // 新 tab(Plan 626 T-05:静态演示表退役,path 存 fs.join 全路径,
        // 保存/再次匹配都走全路径;目录节点 File.exists 不命中,静默忽略)。
        .TreeSelect(id) -> {
            .tree_sel = id
            var full = fs.join(.ws_dir, id)
            var i int = 0
            var found bool = false
            while i < .tabs.len() {
                if .tabs[i].path == full {
                    found = true
                    store.TabActivate(i)
                }
                i = i + 1
            }
            if !found {
                if File.exists(full) {
                    let s = File.read_text(full)
                    .open_count = .open_count + 1
                    .tabs.push({key: "tab-" + .open_count.str(), title: file_basename(id), path: full, dirty: false, src: s})
                    .tab = .tab_count
                    .tab_count = .tab_count + 1
                    .active_key = .tabs[.tab].key
                    .title_active = .tabs[.tab].title
                    .path_active = full
                    .src_active = s
                    .line = 1
                    .col = 1
                    .sel = 0
                    console_log("open: " + full)
                }
                .console = console_lines()
            }
        }

        // ---- Plan 626 T-06: 退出/关窗确认(有脏 tab 先弹 alert-dialog)----
        // CloseRequest = 窗口 X(渲染器拦截分派)与菜单「退出」共用入口;
        // 无路径脏 tab(untitled)无从自动保存——落盘有路径的,其余放弃。
        .CloseRequest -> {
            var any bool = false
            var i int = 0
            while i < .tabs.len() {
                if .tabs[i].dirty {
                    any = true
                }
                i = i + 1
            }
            if any {
                .quit_confirm_open = true
            } else {
                console_log("quit")
                Process.exit(0)
            }
            .console = console_lines()
        }
        .ActQuit -> { store.CloseRequest() }
        .QuitConfirmCancel -> {
            .quit_confirm_open = false
        }
        .QuitSaveClose -> {
            var i int = 0
            while i < .tabs.len() {
                if .tabs[i].dirty {
                    if .tabs[i].path != "" {
                        File.write_text(.tabs[i].path, code_editor_text(.tabs[i].key))
                        .tabs[i].dirty = false
                    }
                }
                i = i + 1
            }
            console_log("quit: saved & exit")
            Process.exit(0)
        }
        .QuitDiscard -> {
            console_log("quit: discard & exit")
            Process.exit(0)
        }
    }
}
