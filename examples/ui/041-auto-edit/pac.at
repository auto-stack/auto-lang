name: "auto-edit"
version: "1.0.0"
description: "auto-edit — AutoLang 文本编辑器（Plan 413/414/418，原 041-code-editor）"
scene: "ui"
render: "vm"
front_port: 4041
title: "AutoEdit"
title_zh: "编辑器"
desktop: "true"
opens: ".txt,.md,.at,.au,.rs,.json,.toml,.yaml,.yml,.log,.py,.js,.ts,.html,.css,.csv"

dep stylekit {
    path: "../stylekit"
}

// PLAN-070 T-01：共享 filetree bp 依赖（tree_util 支撑件跨包直用；L1 零副本）。
dep bps {
    path: "../../../blueprints"
}
