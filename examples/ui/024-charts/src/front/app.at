// front/app.at - Charts 图表工坊(Plan 445 M1 → Plan 484 M4 组件化迁移)
//
// 806 行内联几何(Init/Reset/.Tick 三份复制)退役,四类图改为 official
// 包裸名原语消费(line-chart/bar-chart/area-chart/donut-chart):几何由
// 组件 Init 派生(纯幂等),父级只维护数据与交互状态。流式滑窗
// (.Tick 追数据点)语义不变:monthly 数据变化 → 子组件 props 重播种 →
// Init 重放 → 几何自动重算(ADR-19)。

widget App {
    use { package: official from "components" }

    msg { Init, SetLine, SetBar, SetArea, SetDonut, ToggleDesktop, ToggleMobile, ToggleTablet, Play, Pause, Reset, SetWin8, SetWin12, SetWin20 }

    model {
        // ---- 状态 ----
        chartType str = "line"
        dVisible bool = true
        mVisible bool = true
        tVisible bool = false

        // ---- 流式:running(str "true"/"false")门控启停(012 惯例) ----
        interval int = 400
        running str = "false"
        windowLen int = 12
        tickN int = 0

        // ---- 数据(双模式):seed 为静态展示源(Reset 的不变式);
        // monthly 为当前展示数据 ----
        seed = [
            { m: "Jan", desktop: 186, mobile: 80,  tablet: 40 },
            { m: "Feb", desktop: 305, mobile: 200, tablet: 90 },
            { m: "Mar", desktop: 237, mobile: 120, tablet: 60 },
            { m: "Apr", desktop: 73,  mobile: 190, tablet: 110 },
            { m: "May", desktop: 209, mobile: 130, tablet: 70 },
            { m: "Jun", desktop: 214, mobile: 140, tablet: 85 }
        ]
        monthly = [
            { m: "Jan", desktop: 186, mobile: 80,  tablet: 40 },
            { m: "Feb", desktop: 305, mobile: 200, tablet: 90 },
            { m: "Mar", desktop: 237, mobile: 120, tablet: 60 },
            { m: "Apr", desktop: 73,  mobile: 190, tablet: 110 },
            { m: "May", desktop: 209, mobile: 130, tablet: 70 },
            { m: "Jun", desktop: 214, mobile: 140, tablet: 85 }
        ]
    }

    on {
        .Init -> { }

        // ---- 类型切换/系列开关:单行 handler ----
        .SetLine -> { .chartType = "line" }
        .SetBar -> { .chartType = "bar" }
        .SetArea -> { .chartType = "area" }
        .SetDonut -> { .chartType = "donut" }
        .ToggleDesktop -> {
            if .dVisible {
                .dVisible = false
            } else {
                .dVisible = true
            }
        }
        .ToggleMobile -> {
            if .mVisible {
                .mVisible = false
            } else {
                .mVisible = true
            }
        }
        .ToggleTablet -> {
            if .tVisible {
                .tVisible = false
            } else {
                .tVisible = true
            }
        }

        // ---- 流式控制 ----
        .Play -> { .running = "true" }
        .Pause -> { .running = "false" }
        .SetWin8 -> { .windowLen = 8 }
        .SetWin12 -> { .windowLen = 12 }
        .SetWin20 -> { .windowLen = 20 }

        // ---- 滑窗:追数据点 + 滑出旧点(几何重算交给组件) ----
        .Tick -> {
            if .running == "true" {
                .tickN = .tickN + 1
                var nd = 150 + (.tickN * 37) % 120
                var nm = 100 + (.tickN * 53) % 130
                var nt = 50 + (.tickN * 29) % 90
                var lbl = f"t${.tickN}"
                var out = []
                var first = true
                var over = .monthly.len() >= .windowLen
                for d in .monthly {
                    if over && first {
                        first = false
                    } else {
                        out.push(d)
                    }
                }
                out.push({ m: lbl, desktop: nd, mobile: nm, tablet: nt })
                .monthly = out
            }
        }

        // ---- Reset:monthly 重建自 seed(不变式) ----
        .Reset -> {
            .running = "false"
            .tickN = 0
            var out = []
            for d in .seed {
                out.push(d)
            }
            .monthly = out
        }
    }

    view {
        col (style: "min-h-screen bg-background p-6 gap-4") {
            col (style: "gap-1") {
                h1 "图表工坊" { style: "text-2xl font-bold tracking-tight" }
                text "切换类型 → 开关系列 → 观察渲染。几何由官方 chart 组件自动计算(484 组件化迁移)。" { style: "text-sm text-muted-foreground" }
            }

            row (style: "gap-6 items-start flex-1") {
                // ---- 左:数据面板 ----
                col (style: "w-72 shrink-0 rounded-lg border p-4 gap-4") {
                    text "Chart type" { style: "text-xs font-semibold text-muted-foreground uppercase tracking-wide" }
                    col (style: "grid grid-cols-2 gap-2") {
                        if .chartType == "line" {
                            button "Line ●" { onclick: .SetLine, style: "px-3 py-2 text-sm rounded-md bg-primary text-primary-foreground" }
                        } else {
                            button "Line" { onclick: .SetLine, style: "px-3 py-2 text-sm rounded-md border bg-background hover:bg-accent" }
                        }
                        if .chartType == "bar" {
                            button "Bar ●" { onclick: .SetBar, style: "px-3 py-2 text-sm rounded-md bg-primary text-primary-foreground" }
                        } else {
                            button "Bar" { onclick: .SetBar, style: "px-3 py-2 text-sm rounded-md border bg-background hover:bg-accent" }
                        }
                        if .chartType == "area" {
                            button "Area ●" { onclick: .SetArea, style: "px-3 py-2 text-sm rounded-md bg-primary text-primary-foreground" }
                        } else {
                            button "Area" { onclick: .SetArea, style: "px-3 py-2 text-sm rounded-md border bg-background hover:bg-accent" }
                        }
                        if .chartType == "donut" {
                            button "Donut ●" { onclick: .SetDonut, style: "px-3 py-2 text-sm rounded-md bg-primary text-primary-foreground" }
                        } else {
                            button "Donut" { onclick: .SetDonut, style: "px-3 py-2 text-sm rounded-md border bg-background hover:bg-accent" }
                        }
                    }

                    text "Series" { style: "text-xs font-semibold text-muted-foreground uppercase tracking-wide" }
                    row (style: "items-center gap-2") {
                        span (style: "w-3 h-3 rounded-sm bg-[#2563eb] shrink-0") {}
                        text "Desktop" { style: "text-sm font-medium flex-1" }
                        checkbox {
                            checked: .dVisible,
                            onclick: .ToggleDesktop
                        }
                    }
                    row (style: "items-center gap-2") {
                        span (style: "w-3 h-3 rounded-sm bg-[#16a34a] shrink-0") {}
                        text "Mobile" { style: "text-sm font-medium flex-1" }
                        checkbox {
                            checked: .mVisible,
                            onclick: .ToggleMobile
                        }
                    }
                    row (style: "items-center gap-2") {
                        span (style: "w-3 h-3 rounded-sm bg-[#d97706] shrink-0") {}
                        text "Tablet" { style: "text-sm font-medium flex-1" }
                        checkbox {
                            checked: .tVisible,
                            onclick: .ToggleTablet
                        }
                    }

                    text "Streaming" { style: "text-xs font-semibold text-muted-foreground uppercase tracking-wide" }
                    row (style: "gap-2") {
                        if .running == "true" {
                            button "⏸ Pause" { onclick: .Pause, style: "px-3 py-2 text-sm rounded-md bg-red-500 text-white flex-1" }
                        } else {
                            button "▶ Play" { onclick: .Play, style: "px-3 py-2 text-sm rounded-md bg-green-600 text-white flex-1" }
                        }
                        button "Reset" { onclick: .Reset, style: "px-3 py-2 text-sm rounded-md border bg-background hover:bg-accent" }
                    }
                    row (style: "gap-2") {
                        if .windowLen == 8 {
                            button "8 ●" { onclick: .SetWin8, style: "px-2 py-1.5 text-xs rounded-md bg-primary text-primary-foreground flex-1" }
                        } else {
                            button "8" { onclick: .SetWin8, style: "px-2 py-1.5 text-xs rounded-md border bg-background flex-1" }
                        }
                        if .windowLen == 12 {
                            button "12 ●" { onclick: .SetWin12, style: "px-2 py-1.5 text-xs rounded-md bg-primary text-primary-foreground flex-1" }
                        } else {
                            button "12" { onclick: .SetWin12, style: "px-2 py-1.5 text-xs rounded-md border bg-background flex-1" }
                        }
                        if .windowLen == 20 {
                            button "20 ●" { onclick: .SetWin20, style: "px-2 py-1.5 text-xs rounded-md bg-primary text-primary-foreground flex-1" }
                        } else {
                            button "20" { onclick: .SetWin20, style: "px-2 py-1.5 text-xs rounded-md border bg-background flex-1" }
                        }
                    }
                    text "双模式:初始/Reset 为静态月度展示;Play 后每 400ms 追加点并滑出旧点。几何由组件自动重算。" { style: "text-xs text-muted-foreground" }
                }

                // ---- 右:图表区(官方组件消费) ----
                col (style: "flex-1 rounded-lg border p-4 gap-2") {
                    if .chartType == "line" {
                        line-chart (data: .monthly, index: "m", fields: ["desktop", "mobile", "tablet"], labels: ["Desktop", "Mobile", "Tablet"]) {}
                    }
                    if .chartType == "bar" {
                        bar-chart (data: .monthly, index: "m", fields: ["desktop", "mobile", "tablet"], labels: ["Desktop", "Mobile", "Tablet"]) {}
                    }
                    if .chartType == "area" {
                        area-chart (data: .monthly, index: "m", fields: ["desktop", "mobile", "tablet"], labels: ["Desktop", "Mobile", "Tablet"]) {}
                    }
                    if .chartType == "donut" {
                        donut-chart (data: .monthly, index: "m", field: "desktop") {}
                    }
                }
            }
        }
    }
}
