// components/line_chart.at - LineChart component (Plan 437 Phase 2 ① → Plan 484 v2 → Plan 492 M6)
//
// 折线图:linear scale + path;curve = "monotone" 走 d3 curveMonotoneX
// (Fritsch-Carlson 单调三次插值,不过冲数据点)。渲染端 v1 = SVG 子树直通
// (vue 442 A4 直通臂 / VM svgdoc 通道)。
//
// 492 M6(绕开摘除,回归直接写法):Init 内直用 prop 字符串比较
// (`if .curve == …`,点前缀形态)选曲线变体,单 segs 存储段;view 无分支;
// 带参 msg 声明恢复(`msg { Init, Hover(int) }`);band 样式 dollar 插值
// (`f"w-[${slot}px] h-full flex-1"`)。484 时代的三大绕开(Init 内两算
// 两存/花括号插值/裸挂 handler)随引擎修复(Plan 492 M1-M5)全部退役。
// 保留纪律:条件引用的局部变量紧邻使用点声明(首个 for 之后)。
//
// # Usage
// use { package: official from "../components" }
// line-chart (data: .series, index: "m", fields: ["v", "w"]) {}

widget LineChart (data: List, index: str = "m", fields: List<str> = ["v"], colors: List<str> = ["#2563eb", "#16a34a", "#d97706", "#dc2626"], axis: str = "auto", grid: bool = true, legend: bool = true, labels: List<str> = [], tooltip: bool = true, curve: str = "linear") {
    msg { Init, Hover(int) }

    model {
        segs List = []
        xlabels str = ""
        xLab0 str = ""
        xLab1 str = ""
        xLab2 str = ""
        xLab3 str = ""
        xLab4 str = ""
        xLab5 str = ""
        xLab6 str = ""
        xLab7 str = ""
        xLab8 str = ""
        xLab9 str = ""
        xLab10 str = ""
        xLab11 str = ""
        xLab12 str = ""
        xLab13 str = ""
        xLab14 str = ""
        xLab15 str = ""
        xLab16 str = ""
        xLab17 str = ""
        xLab18 str = ""
        xLab19 str = ""
        yTick4 str = ""
        yTick3 str = ""
        yTick2 str = ""
        yTick1 str = ""
        yTick0 str = ""
        gridPath str = "M40 200 H550 M40 140 H550 M40 80 H550 M40 20 H550"
        legendColor0 str = ""
        legendText0 str = ""
        legendColor1 str = ""
        legendText1 str = ""
        legendColor2 str = ""
        legendText2 str = ""
        legendColor3 str = ""
        legendText3 str = ""
        bands List = []
        tipTitles List = []
        tipBodies List = []
        hovered str = "false"
        tipTitle str = ""
        tipBody str = ""
    }

    on {
        .Init -> {
            // ---- 全系列共享 y 域 ----
            var vmax int = 0
            for d in .data {
                for f in .fields {
                    var v = d[f]
                    if v > vmax {
                        vmax = v
                    }
                }
            }
            // ---- nice step:int 域 1-2-5 阶梯(退化域 4/1) ----
            var step int = 1
            if vmax > 4 {
                var guard = 0
                while step * 4 < vmax && guard < 12 {
                    var mm = step
                    while mm >= 10 {
                        mm = mm / 10
                    }
                    if mm == 2 {
                        step = step * 5 / 2
                    } else {
                        step = step * 2
                    }
                    guard = guard + 1
                }
            }
            var domain int = step * 4
            if domain < vmax {
                domain = step * 5
            }
            var domainf float = domain
            .yTick4 = f"${step * 4}"
            .yTick3 = f"${step * 3}"
            .yTick2 = f"${step * 2}"
            .yTick1 = f"${step}"
            .yTick0 = "0"

            var left float = 40.0
            var plotTop float = 20.0
            var right float = 550.0
            var bottom float = 260.0
            var n int = .data.len()
            var stepf float = 1.0
            if n > 1 {
                var nf float = n - 1
                stepf = (right - left) / nf
            }
            var cs = .colors
            var ccount int = cs.len()

            // ---- 段记录:curve prop 直接选变体(monotone=FC 标准形) ----
            var outSegs List = []
            var k = 0
            for f in .fields {
                var ys List = []
                for d in .data {
                    var vf float = d[f]
                    var yv float = bottom - vf / domainf * (bottom - plotTop)
                    ys.push(yv)
                }
                var dstr = ""
                if .curve == "monotone" {
                    // 割线表 delta[i] = (y[i+1]-y[i])/h
                    var deltas List = []
                    var di = 0
                    while di < n - 1 {
                        var yA = ys[di]
                        var yB = ys[di + 1]
                        deltas.push((yB - yA) / stepf)
                        di = di + 1
                    }
                    // 切线表 m[i](端点单侧割线,内部均值,异号归零)
                    var ms List = []
                    var zi = 0
                    for d in .data { ms.push(0.0) }
                    if n > 1 {
                        var z0 = deltas[0]
                        ms[0] = z0
                        var zN = deltas[n - 2]
                        ms[n - 1] = zN
                    }
                    var mi = 1
                    while mi < n - 1 {
                        var dA = deltas[mi - 1]
                        var dB = deltas[mi]
                        var mm float = (dA + dB) / 2.0
                        if dA * dB <= 0.0 {
                            mm = 0.0
                        }
                        ms[mi] = mm
                        mi = mi + 1
                    }
                    // 逐段发射:i → i+1,控制点 = 端点 ± h/3·m
                    dstr = f"M ${left} ${ys[0]}"
                    var si = 0
                    while si < n - 1 {
                        var x0 float = left + si * stepf
                        var y0 = ys[si]
                        var x1 float = left + (si + 1) * stepf
                        var y1 = ys[si + 1]
                        var m0 = ms[si]
                        var m1 = ms[si + 1]
                        var c1x float = x0 + stepf / 3.0
                        var c1y float = y0 + m0 * stepf / 3.0
                        var c2x float = x1 - stepf / 3.0
                        var c2y float = y1 - m1 * stepf / 3.0
                        dstr = dstr + f" C ${c1x} ${c1y} ${c2x} ${c2y} ${x1} ${y1}"
                        si = si + 1
                    }
                } else {
                    var i = 0
                    for d in .data {
                        var xf float = left + i * stepf
                        var yf = ys[i]
                        if i == 0 {
                            dstr = f"M ${xf} ${yf}"
                        } else {
                            dstr = dstr + f" L ${xf} ${yf}"
                        }
                        i = i + 1
                    }
                }
                var ci int = k
                if ci >= ccount {
                    ci = ccount - 1
                }
                var color = cs[ci]
                outSegs.push({ d: dstr, c: color })
                var name = f
                var lname = .labels
                if lname.len() > k {
                    name = lname[k]
                }
                if k == 0 {
                    .legendColor0 = color
                    .legendText0 = name
                }
                if k == 1 {
                    .legendColor1 = color
                    .legendText1 = name
                }
                if k == 2 {
                    .legendColor2 = color
                    .legendText2 = name
                }
                if k == 3 {
                    .legendColor3 = color
                    .legendText3 = name
                }
                k = k + 1
            }
            .segs = outSegs

            // ---- x 轴标签:逐数据点槽位(≤20 全量对齐,超出等距抽样) ----
            var iname = .index
            var KL int = n
            if KL > 20 {
                KL = 20
            }
            var den int = 1
            if KL > 1 {
                den = KL - 1
            }
            var outL List = []
            var nxt int = 0
            var i4 = 0
            for d in .data {
                var tgt int = nxt * (n - 1) / den
                if i4 == tgt && nxt < KL {
                    outL.push(d[iname])
                    nxt = nxt + 1
                }
                i4 = i4 + 1
            }
            if KL > 0 {
                var sv0 = outL[0]
                .xLab0 = sv0
            }
            if KL > 1 {
                var sv1 = outL[1]
                .xLab1 = sv1
            }
            if KL > 2 {
                var sv2 = outL[2]
                .xLab2 = sv2
            }
            if KL > 3 {
                var sv3 = outL[3]
                .xLab3 = sv3
            }
            if KL > 4 {
                var sv4 = outL[4]
                .xLab4 = sv4
            }
            if KL > 5 {
                var sv5 = outL[5]
                .xLab5 = sv5
            }
            if KL > 6 {
                var sv6 = outL[6]
                .xLab6 = sv6
            }
            if KL > 7 {
                var sv7 = outL[7]
                .xLab7 = sv7
            }
            if KL > 8 {
                var sv8 = outL[8]
                .xLab8 = sv8
            }
            if KL > 9 {
                var sv9 = outL[9]
                .xLab9 = sv9
            }
            if KL > 10 {
                var sv10 = outL[10]
                .xLab10 = sv10
            }
            if KL > 11 {
                var sv11 = outL[11]
                .xLab11 = sv11
            }
            if KL > 12 {
                var sv12 = outL[12]
                .xLab12 = sv12
            }
            if KL > 13 {
                var sv13 = outL[13]
                .xLab13 = sv13
            }
            if KL > 14 {
                var sv14 = outL[14]
                .xLab14 = sv14
            }
            if KL > 15 {
                var sv15 = outL[15]
                .xLab15 = sv15
            }
            if KL > 16 {
                var sv16 = outL[16]
                .xLab16 = sv16
            }
            if KL > 17 {
                var sv17 = outL[17]
                .xLab17 = sv17
            }
            if KL > 18 {
                var sv18 = outL[18]
                .xLab18 = sv18
            }
            if KL > 19 {
                var sv19 = outL[19]
                .xLab19 = sv19
            }

            // ---- 命中竖带 + tooltip 内容(逐索引预计算) ----
            var nf3 float = n
            var slot float = (right - left) / nf3
            var outBands List = []
            var outTipTitle List = []
            var outTipBody List = []
            var i3 = 0
            for d in .data {
                outBands.push({ i: i3, s: f"w-[${slot}px] h-full flex-1" })
                outTipTitle.push(d[iname])
                var body = ""
                var k2 = 0
                for f2 in .fields {
                    var name2 = f2
                    var lname2 = .labels
                    if lname2.len() > k2 {
                        name2 = lname2[k2]
                    }
                    if body == "" {
                        body = f"${name2} ${d[f2]}"
                    } else {
                        body = body + "\n" + f"${name2} ${d[f2]}"
                    }
                    k2 = k2 + 1
                }
                outTipBody.push(body)
                i3 = i3 + 1
            }
            .bands = outBands
            .tipTitles = outTipTitle
            .tipBodies = outTipBody
        }

        .Hover(i) -> {
            .hovered = "true"
            var tt = .tipTitles[i]
            var tb = .tipBodies[i]
            .tipTitle = tt
            .tipBody = tb
        }
        .HoverOut -> { .hovered = "false" }
    }

    view {
        col (style: "w-full max-w-[560px] mx-auto gap-1") {
            if .legend {
                row (style: "justify-end gap-4 pb-2") {
                    if .legendText0 != "" {
                        row (style: "items-center gap-1") {
                            svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                rect (width: "8", height: "8", fill: .legendColor0) {}
                            }
                            text .legendText0 { style: "text-xs text-muted-foreground" }
                        }
                    }
                    if .legendText1 != "" {
                        row (style: "items-center gap-1") {
                            svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                rect (width: "8", height: "8", fill: .legendColor1) {}
                            }
                            text .legendText1 { style: "text-xs text-muted-foreground" }
                        }
                    }
                    if .legendText2 != "" {
                        row (style: "items-center gap-1") {
                            svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                rect (width: "8", height: "8", fill: .legendColor2) {}
                            }
                            text .legendText2 { style: "text-xs text-muted-foreground" }
                        }
                    }
                    if .legendText3 != "" {
                        row (style: "items-center gap-1") {
                            svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                rect (width: "8", height: "8", fill: .legendColor3) {}
                            }
                            text .legendText3 { style: "text-xs text-muted-foreground" }
                        }
                    }
                }
            }
            row (style: "items-stretch w-full") {
                if .axis == "auto" {
                    col (style: "w-10 shrink-0 justify-between items-end pr-1 pt-[20px] pb-[40px]") {
                        text .yTick4 { style: "text-[10px] text-muted-foreground" }
                        text .yTick3 { style: "text-[10px] text-muted-foreground" }
                        text .yTick2 { style: "text-[10px] text-muted-foreground" }
                        text .yTick1 { style: "text-[10px] text-muted-foreground" }
                        text .yTick0 { style: "text-[10px] text-muted-foreground" }
                    }
                }
                col (style: "flex-1") {
                    col (style: "relative") {
                        svg (viewBox: "0 0 560 300", style: "w-full h-auto") {
                            if .grid {
                                path (d: .gridPath, stroke: "#e2e8f0", stroke-width: "1") {}
                            }
                            line (x1: "40", y1: "260", x2: "550", y2: "260", stroke: "#94a3b8", stroke-width: "1") {}
                            line (x1: "40", y1: "20", x2: "40", y2: "260", stroke: "#94a3b8", stroke-width: "1") {}
                            for seg in .segs {
                                path (key: seg["d"], d: seg["d"], fill: "none", stroke: seg["c"], stroke-width: "2", stroke-linejoin: "round", stroke-linecap: "round", stroke-opacity: "0.85") {}
                            }
                        }
                        if .tooltip {
                            col (style: "absolute top-[20px] left-[40px] z-50 w-[510px] h-[240px]") {
                                row (style: "h-full") {
                                    for b in .bands {
                                        mouse-area (key: b["i"], style: b["s"], onmouseenter: .Hover(b.i), onmouseleave: .HoverOut) {}
                                    }
                                }
                            }
                            if .hovered == "true" {
                                col (style: "absolute top-[28px] right-[60px] z-50 bg-popover border rounded-md px-2 py-1 shadow-md") {
                                    text .tipTitle { style: "text-xs font-semibold text-foreground" }
                                    text .tipBody { style: "text-xs text-muted-foreground whitespace-pre-line" }
                                }
                            }
                        }
                    }
                    if .axis == "auto" {
                        row (style: "justify-between pl-10 pr-2.5 pt-1") {
                                if .xLab0 != "" {
                                    text .xLab0 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab1 != "" {
                                    text .xLab1 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab2 != "" {
                                    text .xLab2 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab3 != "" {
                                    text .xLab3 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab4 != "" {
                                    text .xLab4 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab5 != "" {
                                    text .xLab5 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab6 != "" {
                                    text .xLab6 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab7 != "" {
                                    text .xLab7 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab8 != "" {
                                    text .xLab8 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab9 != "" {
                                    text .xLab9 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab10 != "" {
                                    text .xLab10 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab11 != "" {
                                    text .xLab11 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab12 != "" {
                                    text .xLab12 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab13 != "" {
                                    text .xLab13 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab14 != "" {
                                    text .xLab14 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab15 != "" {
                                    text .xLab15 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab16 != "" {
                                    text .xLab16 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab17 != "" {
                                    text .xLab17 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab18 != "" {
                                    text .xLab18 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab19 != "" {
                                    text .xLab19 { style: "text-[10px] text-muted-foreground" }
                                }
                        }
                    }
                }
            }
        }
    }
}
