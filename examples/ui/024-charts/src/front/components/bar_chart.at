// components/bar_chart.at - BarChart component (Plan 437 Phase 2 ② → Plan 484 v2 → Plan 492 M6 → Plan 498 M2)
//
// 柱形图:band scale(槽宽 = 510/n,grouped 槽内 60% 均分系列;stacked
// 单列前缀和堆叠)。渲染端 v1 = SVG 子树直通(442 A4)。
//
// 492 M6(绕开摘除,回归直接写法):Init 内直用 prop 字符串比较
// (`if .type == "stacked"`)选域/段记录,单 segs + 单 yTick 组,view 无
// 分支;带参 msg 声明恢复;band 样式 dollar 插值;484 时代的成对镜像
// 域字段(Init 内两算两存)与 tooltip 双域锚点残留(ay/cum3 死算)一并
// 退役。
// 保留纪律:条件引用的局部变量紧邻使用点声明。
//
// # Usage
// bar-chart (data: .sales, index: "q", fields: ["a", "b"], type: "stacked") {}

widget BarChart (data: List, index: str = "q", fields: List<str> = ["v"], colors: List<str> = ["#2563eb", "#16a34a", "#d97706", "#dc2626"], axis: str = "auto", grid: bool = true, legend: bool = true, labels: List<str> = [], tooltip: bool = true, type: str = "grouped") {
    msg { Init, Hover(int) }

    model {
        segs0 List = []
        segs1 List = []
        segs2 List = []
        segs3 List = []
        hoverGroup int = 9
        xlabels str = ""
        xLab0 str = ""
        xLab1 str = ""
        xLab2 str = ""
        xLab3 str = ""
        xLab4 str = ""
        xLab5 str = ""
        xLab6 str = ""
        xLab7 str = ""
        xLab8 str = ""
        xLab9 str = ""
        xLab10 str = ""
        xLab11 str = ""
        xLab12 str = ""
        xLab13 str = ""
        xLab14 str = ""
        xLab15 str = ""
        xLab16 str = ""
        xLab17 str = ""
        xLab18 str = ""
        xLab19 str = ""
        yTick4 str = ""
        yTick3 str = ""
        yTick2 str = ""
        yTick1 str = ""
        yTick0 str = ""
        gridPath str = "M40 200 H550 M40 140 H550 M40 80 H550 M40 20 H550"
        legendColor0 str = ""
        legendText0 str = ""
        legendColor1 str = ""
        legendText1 str = ""
        legendColor2 str = ""
        legendText2 str = ""
        legendColor3 str = ""
        legendText3 str = ""
        bands List = []
        tipTitles List = []
        tipBodies List = []
        hovered str = "false"
        tipTitle str = ""
        tipBody str = ""
    }

    on {
        .Init -> {
            // ---- 域:type prop 直接选——stacked 取逐 index 累计和最大,
            //      grouped 取系列值最大 ----
            var vmax int = 0
            if .type == "stacked" {
                for d in .data {
                    var cum int = 0
                    for f in .fields {
                        var v0 = d[f]
                        cum = cum + v0
                    }
                    if cum > vmax {
                        vmax = cum
                    }
                }
            } else {
                for d in .data {
                    for f in .fields {
                        var v = d[f]
                        if v > vmax {
                            vmax = v
                        }
                    }
                }
            }
            // ---- nice step:int 域 1-2-5 阶梯(退化域 4/1) ----
            var step int = 1
            if vmax > 4 {
                var guard = 0
                while step * 4 < vmax && guard < 12 {
                    var mm = step
                    while mm >= 10 {
                        mm = mm / 10
                    }
                    if mm == 2 {
                        step = step * 5 / 2
                    } else {
                        step = step * 2
                    }
                    guard = guard + 1
                }
            }
            var domain int = step * 4
            if domain < vmax {
                domain = step * 5
            }
            var domainf float = domain
            .yTick4 = f"${step * 4}"
            .yTick3 = f"${step * 3}"
            .yTick2 = f"${step * 2}"
            .yTick1 = f"${step}"
            .yTick0 = "0"

            var bottom float = 260.0
            var span float = 240.0
            var n int = .data.len()
            var nf float = n
            var slot float = 510.0 / nf
            var ks int = .fields.len()
            var kf float = ks
            var inner float = slot * 0.6
            var barw float = inner / kf
            var cs = .colors
            var ccount int = cs.len()
            var iname = .index

            // ---- 段记录:type prop 直接选(grouped 槽内并列/stacked 前缀和堆叠);
            //      498 M2:逐柱记录 {d,c,g}(组号 g 驱动分组 emphasis)入逐系列槽位 ----
            var out0 List = []
            var out1 List = []
            var out2 List = []
            var out3 List = []
            var k = 0
            for f in .fields {
                var i = 0
                for d in .data {
                    var xf float = 40.0 + i * slot + slot * 0.2
                    var rstr = ""
                    if .type == "stacked" {
                        // 前缀和底边:前面系列累计抬升
                        var before int = 0
                        var k2 = 0
                        for f2 in .fields {
                            if k2 < k {
                                var v2 = d[f2]
                                before = before + v2
                            }
                            k2 = k2 + 1
                        }
                        var vf float = d[f]
                        var beforef float = before
                        var allf float = vf + beforef
                        var ytopS float = bottom - allf / domainf * span
                        var ybase float = bottom - beforef / domainf * span
                        var hfS float = ybase - ytopS
                        rstr = f"M${xf} ${ytopS} h${inner} v${hfS} h-${inner} Z"
                    } else {
                        var vfg float = d[f]
                        var ytop float = bottom - vfg / domainf * span
                        var hf float = bottom - ytop
                        var xfg float = xf + k * barw
                        rstr = f"M${xfg} ${ytop} h${barw} v${hf} h-${barw} Z"
                    }
                    var ci int = k
                    if ci >= ccount {
                        ci = ccount - 1
                    }
                    var rcol = cs[ci]
                    if k == 0 {
                        out0.push({ d: rstr, c: rcol, g: i })
                    }
                    if k == 1 {
                        out1.push({ d: rstr, c: rcol, g: i })
                    }
                    if k == 2 {
                        out2.push({ d: rstr, c: rcol, g: i })
                    }
                    if k == 3 {
                        out3.push({ d: rstr, c: rcol, g: i })
                    }
                    i = i + 1
                }
                var cik int = k
                if cik >= ccount {
                    cik = ccount - 1
                }
                var color = cs[cik]
                var name = f
                var lname = .labels
                if lname.len() > k {
                    name = lname[k]
                }
                if k == 0 {
                    .legendColor0 = color
                    .legendText0 = name
                }
                if k == 1 {
                    .legendColor1 = color
                    .legendText1 = name
                }
                if k == 2 {
                    .legendColor2 = color
                    .legendText2 = name
                }
                if k == 3 {
                    .legendColor3 = color
                    .legendText3 = name
                }
                k = k + 1
            }
            .segs0 = out0
            .segs1 = out1
            .segs2 = out2
            .segs3 = out3

            // ---- x 轴标签:逐数据点槽位(≤20 全量对齐,超出等距抽样) ----
            var KL int = n
            if KL > 20 {
                KL = 20
            }
            var den int = 1
            if KL > 1 {
                den = KL - 1
            }
            var outL List = []
            var nxt int = 0
            var i4 = 0
            for d in .data {
                var tgt int = nxt * (n - 1) / den
                if i4 == tgt && nxt < KL {
                    outL.push(d[iname])
                    nxt = nxt + 1
                }
                i4 = i4 + 1
            }
            if KL > 0 {
                var sv0 = outL[0]
                .xLab0 = sv0
            }
            if KL > 1 {
                var sv1 = outL[1]
                .xLab1 = sv1
            }
            if KL > 2 {
                var sv2 = outL[2]
                .xLab2 = sv2
            }
            if KL > 3 {
                var sv3 = outL[3]
                .xLab3 = sv3
            }
            if KL > 4 {
                var sv4 = outL[4]
                .xLab4 = sv4
            }
            if KL > 5 {
                var sv5 = outL[5]
                .xLab5 = sv5
            }
            if KL > 6 {
                var sv6 = outL[6]
                .xLab6 = sv6
            }
            if KL > 7 {
                var sv7 = outL[7]
                .xLab7 = sv7
            }
            if KL > 8 {
                var sv8 = outL[8]
                .xLab8 = sv8
            }
            if KL > 9 {
                var sv9 = outL[9]
                .xLab9 = sv9
            }
            if KL > 10 {
                var sv10 = outL[10]
                .xLab10 = sv10
            }
            if KL > 11 {
                var sv11 = outL[11]
                .xLab11 = sv11
            }
            if KL > 12 {
                var sv12 = outL[12]
                .xLab12 = sv12
            }
            if KL > 13 {
                var sv13 = outL[13]
                .xLab13 = sv13
            }
            if KL > 14 {
                var sv14 = outL[14]
                .xLab14 = sv14
            }
            if KL > 15 {
                var sv15 = outL[15]
                .xLab15 = sv15
            }
            if KL > 16 {
                var sv16 = outL[16]
                .xLab16 = sv16
            }
            if KL > 17 {
                var sv17 = outL[17]
                .xLab17 = sv17
            }
            if KL > 18 {
                var sv18 = outL[18]
                .xLab18 = sv18
            }
            if KL > 19 {
                var sv19 = outL[19]
                .xLab19 = sv19
            }

            // ---- 命中竖带 + tooltip 内容(逐索引预计算) ----
            var outBands List = []
            var outTipTitle List = []
            var outTipBody List = []
            var i3 = 0
            for d in .data {
                outBands.push({ i: i3, s: f"w-[${slot}px] h-full flex-1" })
                outTipTitle.push(d[iname])
                var body = ""
                var k3 = 0
                for f5 in .fields {
                    var name2 = f5
                    var lname2 = .labels
                    if lname2.len() > k3 {
                        name2 = lname2[k3]
                    }
                    if body == "" {
                        body = f"${name2} ${d[f5]}"
                    } else {
                        body = body + "\n" + f"${name2} ${d[f5]}"
                    }
                    k3 = k3 + 1
                }
                outTipBody.push(body)
                i3 = i3 + 1
            }
            .bands = outBands
            .tipTitles = outTipTitle
            .tipBodies = outTipBody
        }

        .Hover(i) -> {
            .hovered = "true"
            .hoverGroup = i
            var tt = .tipTitles[i]
            var tb = .tipBodies[i]
            .tipTitle = tt
            .tipBody = tb
        }
        .HoverOut -> {
            .hovered = "false"
            .hoverGroup = 9
        }
    }

    style {
        /* 498 M2: emphasis 淡入——vue 走 CSS transition,VM 直接切换。 */
        path { transition: stroke-width 0.15s ease, fill-opacity 0.15s ease; }
    }

    view {
        col (style: "w-full max-w-[560px] mx-auto gap-1") {
            if .legend {
                row (style: "justify-end gap-4 pb-2") {
                    if .legendText0 != "" {
                        row (style: "items-center gap-1") {
                            svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                rect (width: "8", height: "8", fill: .legendColor0) {}
                            }
                            text .legendText0 { style: "text-xs text-muted-foreground" }
                        }
                    }
                    if .legendText1 != "" {
                        row (style: "items-center gap-1") {
                            svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                rect (width: "8", height: "8", fill: .legendColor1) {}
                            }
                            text .legendText1 { style: "text-xs text-muted-foreground" }
                        }
                    }
                    if .legendText2 != "" {
                        row (style: "items-center gap-1") {
                            svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                rect (width: "8", height: "8", fill: .legendColor2) {}
                            }
                            text .legendText2 { style: "text-xs text-muted-foreground" }
                        }
                    }
                    if .legendText3 != "" {
                        row (style: "items-center gap-1") {
                            svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                rect (width: "8", height: "8", fill: .legendColor3) {}
                            }
                            text .legendText3 { style: "text-xs text-muted-foreground" }
                        }
                    }
                }
            }
            row (style: "items-stretch w-full") {
                if .axis == "auto" {
                    col (style: "w-10 shrink-0 justify-between items-end pr-1 pt-[20px] pb-[40px]") {
                        text .yTick4 { style: "text-[10px] text-muted-foreground" }
                        text .yTick3 { style: "text-[10px] text-muted-foreground" }
                        text .yTick2 { style: "text-[10px] text-muted-foreground" }
                        text .yTick1 { style: "text-[10px] text-muted-foreground" }
                        text .yTick0 { style: "text-[10px] text-muted-foreground" }
                    }
                }
                col (style: "flex-1") {
                    col (style: "relative") {
                        svg (viewBox: "0 0 560 300", style: "w-full h-auto") {
                            if .grid {
                                path (d: .gridPath, stroke: "#e2e8f0", stroke-width: "1") {}
                            }
                            line (x1: "40", y1: "20", x2: "40", y2: "260", stroke: "#94a3b8", stroke-width: "1") {}
                            line (x1: "40", y1: "260", x2: "550", y2: "260", stroke: "#94a3b8", stroke-width: "1") {}
                            if .legendText0 != "" {
                                for seg in .segs0 {
                                    if .hoverGroup == seg.g {
                                        path (key: seg["d"], d: seg["d"], fill: seg["c"], stroke: seg["c"], stroke-width: "1.5") {}
                                    } else {
                                        if .hoverGroup == 9 {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"]) {}
                                        } else {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"], fill-opacity: "0.3") {}
                                        }
                                    }
                                }
                            }
                            if .legendText1 != "" {
                                for seg in .segs1 {
                                    if .hoverGroup == seg.g {
                                        path (key: seg["d"], d: seg["d"], fill: seg["c"], stroke: seg["c"], stroke-width: "1.5") {}
                                    } else {
                                        if .hoverGroup == 9 {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"]) {}
                                        } else {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"], fill-opacity: "0.3") {}
                                        }
                                    }
                                }
                            }
                            if .legendText2 != "" {
                                for seg in .segs2 {
                                    if .hoverGroup == seg.g {
                                        path (key: seg["d"], d: seg["d"], fill: seg["c"], stroke: seg["c"], stroke-width: "1.5") {}
                                    } else {
                                        if .hoverGroup == 9 {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"]) {}
                                        } else {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"], fill-opacity: "0.3") {}
                                        }
                                    }
                                }
                            }
                            if .legendText3 != "" {
                                for seg in .segs3 {
                                    if .hoverGroup == seg.g {
                                        path (key: seg["d"], d: seg["d"], fill: seg["c"], stroke: seg["c"], stroke-width: "1.5") {}
                                    } else {
                                        if .hoverGroup == 9 {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"]) {}
                                        } else {
                                            path (key: seg["d"], d: seg["d"], fill: seg["c"], fill-opacity: "0.3") {}
                                        }
                                    }
                                }
                            }
                        }
                        if .tooltip {
                            col (style: "absolute top-[20px] left-[40px] z-50 w-[510px] h-[240px]") {
                                row (style: "h-full") {
                                    for b in .bands {
                                        mouse-area (key: b["i"], style: b["s"], onmouseenter: .Hover(b.i), onmouseleave: .HoverOut) {}
                                    }
                                }
                            }
                            if .hovered == "true" {
                                col (style: "absolute top-[28px] right-[60px] z-50 bg-popover border rounded-md px-2 py-1 shadow-md") {
                                    text .tipTitle { style: "text-xs font-semibold text-foreground" }
                                    text .tipBody { style: "text-xs text-muted-foreground whitespace-pre-line" }
                                }
                            }
                        }
                    }
                    if .axis == "auto" {
                        row (style: "justify-between pl-10 pr-2.5 pt-1") {
                                if .xLab0 != "" {
                                    text .xLab0 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab1 != "" {
                                    text .xLab1 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab2 != "" {
                                    text .xLab2 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab3 != "" {
                                    text .xLab3 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab4 != "" {
                                    text .xLab4 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab5 != "" {
                                    text .xLab5 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab6 != "" {
                                    text .xLab6 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab7 != "" {
                                    text .xLab7 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab8 != "" {
                                    text .xLab8 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab9 != "" {
                                    text .xLab9 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab10 != "" {
                                    text .xLab10 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab11 != "" {
                                    text .xLab11 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab12 != "" {
                                    text .xLab12 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab13 != "" {
                                    text .xLab13 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab14 != "" {
                                    text .xLab14 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab15 != "" {
                                    text .xLab15 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab16 != "" {
                                    text .xLab16 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab17 != "" {
                                    text .xLab17 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab18 != "" {
                                    text .xLab18 { style: "text-[10px] text-muted-foreground" }
                                }
                                if .xLab19 != "" {
                                    text .xLab19 { style: "text-[10px] text-muted-foreground" }
                                }
                        }
                    }
                }
            }
        }
    }
}
