// app.at — 014-weather 天气仪表盘（PLAN-660 r2）
//
// r1 → r2（用户反馈 2026-09-20）：
//   1. 优先适配网页/桌面横屏；竖屏布局保留为 layout_mode=="portrait" 分支
//      （未来手机版可直接切换/响应式扩展）。
//   2. 滚动一律改用 AutoUI `scroll`（别名 scrollable → Vue ScrollArea / VM
//      iced scrollable），不再手写 overflow-x-auto。
//
// 设计锚点：桌面天气仪表盘（横屏）+ Apple Weather 竖屏（保留）。
// 主题契约：dark_mode / accent_color（Plan 458），变量名勿改。
// 城市选择：pill 芯片（不用 select —— selectitem iced:none）。
// Hero 渐变：view 内按 condition 条件 class（勿把 Tailwind 串绑到 style:，
// 生成器会落到 :style 导致渐变失效）。
//
// r3：选中态（*_on）必须自带 hover 提亮。button 默认 variant 是
// `bg-muted … hover:bg-muted/70`（见 gen/.../button/index.ts）；若 active
// 样式只写 bg-primary 不写 hover，cn 合并后 hover 仍是 muted 底 +
// primary-foreground 字 → 选中项 hover 发白不可读。与未选中对称：
// off → hover:bg-secondary/80，on → hover:bg-primary/90。
//
// r6：外壳对齐 calculator——pac `window: "fit"` + **去掉 min-h-screen**
// （fit 按内容量高，min-h-screen 会把窗口撑满屏）。整 app 套一层 card 框；
// 横向 mx-auto；Hero 压缩并与右栏 items-stretch 对齐底边。

use weather_data: name_for, condition_for, cond_zh_for, icon_for, temp_for, feels_for, humidity_for, wind_for, uv_for, aqi_for, aqi_level_for, pressure_for, visibility_for, hourly_for, daily_for
use stylekit.styles: hint_text

style page = "bg-background text-foreground"
style app_frame = "w-full max-w-4xl mx-auto bg-card border border-border rounded-2xl p-4 gap-4 shadow-lg"
style city_pill_on = "px-3 py-1.5 rounded-full text-xs font-medium bg-primary text-primary-foreground hover:bg-primary/90 shadow-sm shrink-0 transition-colors"
style city_pill_off = "px-3 py-1.5 rounded-full text-xs font-medium bg-secondary text-secondary-foreground hover:bg-secondary/80 shrink-0 transition-colors"
style icon_btn = "w-9 h-9 items-center justify-center rounded-full bg-secondary text-secondary-foreground hover:bg-secondary/80 transition-colors"
style section_title = "text-sm font-semibold text-foreground"
style metric_card = "bg-card border border-border rounded-2xl p-3 gap-1 min-w-0"
style metric_label = "text-[10px] text-muted-foreground uppercase tracking-wider"
style metric_value = "text-sm font-semibold text-foreground"
style hour_card_now = "w-16 shrink-0 items-center gap-1.5 py-3 rounded-2xl bg-primary/15 border border-primary/30"
style hour_card = "w-16 shrink-0 items-center gap-1.5 py-3 rounded-2xl bg-muted/50 border border-border/40"
style day_card_now = "w-16 shrink-0 items-center gap-0.5 py-2.5 rounded-2xl bg-primary/15 border border-primary/30"
style day_card = "w-16 shrink-0 items-center gap-0.5 py-2.5 rounded-2xl bg-muted/50 border border-border/40"
style forecast_card = "bg-muted/40 border border-border/60 rounded-2xl p-3 gap-2"
style fc_tab_on = "h-7 px-3 rounded-full text-xs font-medium bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
style fc_tab_off = "h-7 px-3 rounded-full text-xs font-medium bg-secondary text-secondary-foreground hover:bg-secondary/80 transition-colors"
style day_row = "w-full items-center gap-2 py-2.5 px-1"
style refresh_busy = "h-8 px-3 rounded-full text-xs font-medium bg-muted text-muted-foreground border border-border"
style refresh_idle = "h-8 px-3 rounded-full text-xs font-medium bg-primary text-primary-foreground hover:bg-primary/90 shadow-sm transition-colors"
style layout_btn_on = "h-7 px-2.5 rounded-full text-[11px] font-medium bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
style layout_btn_off = "h-7 px-2.5 rounded-full text-[11px] font-medium bg-secondary text-secondary-foreground hover:bg-secondary/80 transition-colors"
style card_surface = "bg-card border border-border rounded-2xl"
style aqi_good = "text-[10px] px-1.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-600 font-medium"
style aqi_warn = "text-[10px] px-1.5 py-0.5 rounded-full bg-amber-500/15 text-amber-600 font-medium"
style aqi_mid = "text-[10px] px-1.5 py-0.5 rounded-full bg-primary/15 text-primary font-medium"

widget App {
    msg {
        SelectCity(str),
        Refresh,
        ToggleTheme,
        SetTheme(str),
        SetAccent(str),
        SetLayout(str),
        SetForecastTab(str),
        Init
    }

    model {
        var dark_mode bool = true
        var accent_color str = "indigo"
        // landscape = 网页/桌面优先；portrait = 保留的手机版竖屏设计
        var layout_mode str = "landscape"
        // 预报区 Tab：hourly | daily（默认窗口不高，二者互斥显示）
        var forecast_tab str = "hourly"

        var city_id str = "beijing"
        var city_zh str = "北京"
        var condition str = "partly"
        var cond_zh str = "多云"
        var icon str = "⛅"
        var temp str = "23°"
        var feels str = "25°"
        var humidity str = "65%"
        var wind str = "12 km/h"
        var uv str = "中等"
        var aqi str = "68"
        var aqi_level str = "良"
        var pressure str = "1012 hPa"
        var visibility str = "12 km"
        var updated_at str = "14:30"
        var refreshing bool = false

        var cities = [
            { id: "beijing", zh: "北京" },
            { id: "shanghai", zh: "上海" },
            { id: "guangzhou", zh: "广州" },
            { id: "shenzhen", zh: "深圳" },
            { id: "hangzhou", zh: "杭州" },
            { id: "chengdu", zh: "成都" },
            { id: "xian", zh: "西安" },
            { id: "wuhan", zh: "武汉" },
            { id: "harbin", zh: "哈尔滨" },
            { id: "sanya", zh: "三亚" }
        ]

        var hourly = [
            { time: "现在", icon: "⛅", temp: "23°", now: true },
            { time: "15:00", icon: "⛅", temp: "24°", now: false },
            { time: "16:00", icon: "⛅", temp: "24°", now: false },
            { time: "17:00", icon: "☁️", temp: "23°", now: false },
            { time: "18:00", icon: "☁️", temp: "22°", now: false },
            { time: "19:00", icon: "☁️", temp: "21°", now: false },
            { time: "20:00", icon: "☁️", temp: "20°", now: false },
            { time: "21:00", icon: "⛅", temp: "20°", now: false }
        ]
        var daily = [
            { day: "今天", icon: "⛅", cond: "多云", tmin: "18°", tmax: "25°" },
            { day: "周二", icon: "☀️", cond: "晴", tmin: "20°", tmax: "28°" },
            { day: "周三", icon: "☁️", cond: "阴", tmin: "16°", tmax: "22°" },
            { day: "周四", icon: "🌧️", cond: "小雨", tmin: "17°", tmax: "24°" },
            { day: "周五", icon: "⛅", cond: "多云", tmin: "19°", tmax: "27°" }
        ]
    }

    view {
        col {
            style: page
            col {
                style: "w-full max-w-4xl mx-auto p-3 gap-3"
                col {
                    style: app_frame

                // ── Header ──
                row {
                    style: "w-full items-center gap-3"
                    col {
                        style: "gap-0.5 min-w-0"
                        text .city_zh { style: "text-2xl lg:text-3xl font-bold text-foreground tracking-tight" }
                        text f"更新于 ${.updated_at}" { style: hint_text }
                    }
                    row {
                        style: "ml-auto items-center gap-2 shrink-0"
                        // 布局切换：横屏（默认）/ 竖屏（手机版预览）
                        row {
                            style: "items-center gap-1 mr-1"
                            if .layout_mode == "landscape" {
                                button "横屏" { onclick: .SetLayout("landscape"), variant: "primary", style: layout_btn_on }
                            } else {
                                button "横屏" { onclick: .SetLayout("landscape"), variant: "secondary", style: layout_btn_off }
                            }
                            if .layout_mode == "portrait" {
                                button "竖屏" { onclick: .SetLayout("portrait"), variant: "primary", style: layout_btn_on }
                            } else {
                                button "竖屏" { onclick: .SetLayout("portrait"), variant: "secondary", style: layout_btn_off }
                            }
                        }
                        button {
                            onclick: .Refresh
                            variant: "primary"
                            style: if .refreshing { refresh_busy } else { refresh_idle }
                            if .refreshing {
                                text "刷新中…" {}
                            } else {
                                text "刷新" {}
                            }
                        }
                        button {
                            onclick: .ToggleTheme
                            style: icon_btn
                            if .dark_mode {
                                text "☀️" { style: "text-sm" }
                            } else {
                                text "🌙" { style: "text-sm" }
                            }
                        }
                    }
                }

                // ── 城市 pill：AutoUI scroll（ScrollArea）横向 ──
                container (style: "w-full h-11 shrink-0") {
                    scroll (axis: "x", style: "h-full w-full") {
                        row {
                            style: "items-center gap-2 h-full pr-2"
                            for c in .cities {
                                if c.id == .city_id {
                                    button c.zh {
                                        onclick: .SelectCity(c.id)
                                        variant: "primary"
                                        style: city_pill_on
                                    }
                                } else {
                                    button c.zh {
                                        onclick: .SelectCity(c.id)
                                        variant: "secondary"
                                        style: city_pill_off
                                    }
                                }
                            }
                        }
                    }
                }

                // ==================== 横屏布局（网页/桌面优先） ====================
                // r4：24h 上移到右栏顶部（桌面天气 App 常见信息架构）；
                // 小时卡有实体底色；scroll 直接包 row（去掉 container/多余 col，
                // 避免 max-w-7xl 注入与 ScrollArea 视口塌陷导致「只见 5 日」）。
                if .layout_mode == "landscape" {
                    col {
                        style: "w-full gap-3"

                        row {
                            style: "w-full gap-3 items-stretch"

                            // ── Hero 实况（左栏，高度对齐右栏）──
                            col {
                                style: if .condition == "sunny" {
                                    "w-full lg:w-64 shrink-0 bg-gradient-to-br from-amber-400 to-orange-500 rounded-2xl p-4 items-center justify-center gap-1.5 shadow-md"
                                } else if .condition == "rain" {
                                    "w-full lg:w-64 shrink-0 bg-gradient-to-br from-blue-400 to-blue-600 rounded-2xl p-4 items-center justify-center gap-1.5 shadow-md"
                                } else if .condition == "storm" {
                                    "w-full lg:w-64 shrink-0 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl p-4 items-center justify-center gap-1.5 shadow-md"
                                } else if .condition == "snow" {
                                    "w-full lg:w-64 shrink-0 bg-gradient-to-br from-cyan-300 to-sky-500 rounded-2xl p-4 items-center justify-center gap-1.5 shadow-md"
                                } else if .condition == "fog" {
                                    "w-full lg:w-64 shrink-0 bg-gradient-to-br from-gray-300 to-slate-500 rounded-2xl p-4 items-center justify-center gap-1.5 shadow-md"
                                } else if .condition == "cloudy" {
                                    "w-full lg:w-64 shrink-0 bg-gradient-to-br from-slate-400 to-slate-600 rounded-2xl p-4 items-center justify-center gap-1.5 shadow-md"
                                } else {
                                    "w-full lg:w-64 shrink-0 bg-gradient-to-br from-sky-400 to-blue-500 rounded-2xl p-4 items-center justify-center gap-1.5 shadow-md"
                                }
                                text .icon { style: "text-5xl" }
                                text .cond_zh { style: "text-base font-medium text-white" }
                                text .temp { style: "text-6xl font-light text-white leading-none tracking-tight" }
                                row {
                                    style: "items-center gap-2 text-white/90 text-xs mt-1 flex-wrap justify-center"
                                    text f"体感 ${.feels}" {}
                                    text f"湿度 ${.humidity}" {}
                                    text f"风 ${.wind}" {}
                                }
                            }

                            // ── 右栏：预报 Tab（24h/5日 互斥）→ 指标 ──
                            col {
                                style: "flex-1 min-w-0 gap-3"

                                // 预报卡：tab 切换，一次只显示一种
                                col {
                                    style: forecast_card
                                    row {
                                        style: "w-full items-center gap-2"
                                        if .forecast_tab == "hourly" {
                                            button "24小时" { onclick: .SetForecastTab("hourly"), variant: "primary", style: fc_tab_on }
                                        } else {
                                            button "24小时" { onclick: .SetForecastTab("hourly"), variant: "secondary", style: fc_tab_off }
                                        }
                                        if .forecast_tab == "daily" {
                                            button "5日" { onclick: .SetForecastTab("daily"), variant: "primary", style: fc_tab_on }
                                        } else {
                                            button "5日" { onclick: .SetForecastTab("daily"), variant: "secondary", style: fc_tab_off }
                                        }
                                    }

                                    if .forecast_tab == "hourly" {
                                        scroll (axis: "x", style: "w-full h-36") {
                                            row {
                                                style: "items-center gap-2 h-36"
                                                for h in .hourly {
                                                    if h.now {
                                                        col {
                                                            style: hour_card_now
                                                            text h.time { style: "text-[10px] font-semibold text-primary" }
                                                            text h.icon { style: "text-lg" }
                                                            text h.temp { style: "text-sm font-bold text-primary" }
                                                        }
                                                    } else {
                                                        col {
                                                            style: hour_card
                                                            text h.time { style: "text-[10px] text-muted-foreground" }
                                                            text h.icon { style: "text-lg" }
                                                            text h.temp { style: "text-sm font-semibold text-foreground" }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    if .forecast_tab == "daily" {
                                        // 与小时卡同构；温度两行：最高 / 最低
                                        scroll (axis: "x", style: "w-full h-36") {
                                            row {
                                                style: "items-center gap-2 h-36"
                                                for d in .daily {
                                                    if d.day == "今天" {
                                                        col {
                                                            style: day_card_now
                                                            text d.day { style: "text-[10px] font-semibold text-primary" }
                                                            text d.icon { style: "text-lg" }
                                                            text d.tmax { style: "text-sm font-bold text-primary" }
                                                            text d.tmin { style: "text-[10px] text-primary/70" }
                                                        }
                                                    } else {
                                                        col {
                                                            style: day_card
                                                            text d.day { style: "text-[10px] text-muted-foreground" }
                                                            text d.icon { style: "text-lg" }
                                                            text d.tmax { style: "text-sm font-semibold text-foreground" }
                                                            text d.tmin { style: "text-[10px] text-muted-foreground" }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // 当前详情
                                col {
                                    style: "w-full gap-2"
                                    text "当前详情" { style: section_title }
                                    row {
                                        style: "w-full gap-2"
                                        col {
                                            style: metric_card
                                            text "湿度" { style: metric_label }
                                            text .humidity { style: metric_value }
                                        }
                                        col {
                                            style: metric_card
                                            text "风速" { style: metric_label }
                                            text .wind { style: metric_value }
                                        }
                                        col {
                                            style: metric_card
                                            text "体感" { style: metric_label }
                                            text .feels { style: metric_value }
                                        }
                                    }
                                    row {
                                        style: "w-full gap-2"
                                        col {
                                            style: metric_card
                                            text "紫外线" { style: metric_label }
                                            text .uv { style: metric_value }
                                        }
                                        col {
                                            style: metric_card
                                            row {
                                                style: "items-center gap-1"
                                                text "AQI" { style: metric_label }
                                                if .aqi_level == "优" {
                                                    text .aqi_level { style: aqi_good }
                                                } else if .aqi_level == "轻度污染" {
                                                    text .aqi_level { style: aqi_warn }
                                                } else {
                                                    text .aqi_level { style: aqi_mid }
                                                }
                                            }
                                            text .aqi { style: metric_value }
                                        }
                                        col {
                                            style: metric_card
                                            text "能见度" { style: metric_label }
                                            text .visibility { style: metric_value }
                                        }
                                    }
                                    row {
                                        style: "w-full gap-2"
                                        col {
                                            style: metric_card
                                            text "气压" { style: metric_label }
                                            text .pressure { style: metric_value }
                                        }
                                        col {
                                            style: metric_card
                                            text "更新" { style: metric_label }
                                            text .updated_at { style: metric_value }
                                        }
                                        col {
                                            style: metric_card
                                            text "数据" { style: metric_label }
                                            text "演示样本" { style: "text-xs text-muted-foreground" }
                                        }
                                    }
                                }
                            }
                        }

                        text "演示数据 · 非实时气象" { style: "text-center text-[10px] text-muted-foreground/70" }

                        style: "w-full gap-3"
                    }
                }

                // ==================== 竖屏布局（保留：未来手机版） ====================
                if .layout_mode == "portrait" {
                    scroll (axis: "y", style: "w-full max-h-[520px]") {
                        col {
                            style: "w-full max-w-md mx-auto gap-3"

                            // Hero
                            col {
                                style: if .condition == "sunny" {
                                    "bg-gradient-to-br from-amber-400 to-orange-500 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                } else if .condition == "rain" {
                                    "bg-gradient-to-br from-blue-400 to-blue-600 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                } else if .condition == "storm" {
                                    "bg-gradient-to-br from-indigo-500 to-purple-600 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                } else if .condition == "snow" {
                                    "bg-gradient-to-br from-cyan-300 to-sky-500 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                } else if .condition == "fog" {
                                    "bg-gradient-to-br from-gray-300 to-slate-500 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                } else if .condition == "cloudy" {
                                    "bg-gradient-to-br from-slate-400 to-slate-600 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                } else {
                                    "bg-gradient-to-br from-sky-400 to-blue-500 rounded-3xl p-6 items-center gap-2 shadow-lg"
                                }
                                text .icon { style: "text-5xl" }
                                text .cond_zh { style: "text-base font-medium text-white" }
                                text .temp { style: "text-7xl font-light text-white leading-none tracking-tight" }
                                row {
                                    style: "items-center gap-3 text-white/90 text-xs mt-1"
                                    text f"体感 ${.feels}" {}
                                    text f"湿度 ${.humidity}" {}
                                    text f"风 ${.wind}" {}
                                }
                            }

                            // 指标
                            col {
                                style: "w-full gap-2"
                                text "当前详情" { style: section_title }
                                row {
                                    style: "w-full gap-2"
                                    col {
                                        style: metric_card
                                        text "湿度" { style: metric_label }
                                        text .humidity { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text "风速" { style: metric_label }
                                        text .wind { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text "体感" { style: metric_label }
                                        text .feels { style: metric_value }
                                    }
                                }
                                row {
                                    style: "w-full gap-2"
                                    col {
                                        style: metric_card
                                        text "紫外线" { style: metric_label }
                                        text .uv { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        row {
                                            style: "items-center gap-1"
                                            text "AQI" { style: metric_label }
                                            if .aqi_level == "优" {
                                                text .aqi_level { style: aqi_good }
                                            } else if .aqi_level == "轻度污染" {
                                                text .aqi_level { style: aqi_warn }
                                            } else {
                                                text .aqi_level { style: aqi_mid }
                                            }
                                        }
                                        text .aqi { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text "能见度" { style: metric_label }
                                        text .visibility { style: metric_value }
                                    }
                                }
                                row {
                                    style: "w-full gap-2"
                                    col {
                                        style: metric_card
                                        text "气压" { style: metric_label }
                                        text .pressure { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text "更新" { style: metric_label }
                                        text .updated_at { style: metric_value }
                                    }
                                    col {
                                        style: metric_card
                                        text "数据" { style: metric_label }
                                        text "演示样本" { style: "text-xs text-muted-foreground" }
                                    }
                                }
                            }

                            // 预报 Tab（与横屏同构）
                            col {
                                style: forecast_card
                                row {
                                    style: "w-full items-center gap-2"
                                    if .forecast_tab == "hourly" {
                                        button "24小时" { onclick: .SetForecastTab("hourly"), variant: "primary", style: fc_tab_on }
                                    } else {
                                        button "24小时" { onclick: .SetForecastTab("hourly"), variant: "secondary", style: fc_tab_off }
                                    }
                                    if .forecast_tab == "daily" {
                                        button "5日" { onclick: .SetForecastTab("daily"), variant: "primary", style: fc_tab_on }
                                    } else {
                                        button "5日" { onclick: .SetForecastTab("daily"), variant: "secondary", style: fc_tab_off }
                                    }
                                }
                                if .forecast_tab == "hourly" {
                                    scroll (axis: "x", style: "w-full h-36") {
                                        row {
                                            style: "items-center gap-2 h-36"
                                            for h in .hourly {
                                                if h.now {
                                                    col {
                                                        style: hour_card_now
                                                        text h.time { style: "text-[10px] font-semibold text-primary" }
                                                        text h.icon { style: "text-lg" }
                                                        text h.temp { style: "text-sm font-bold text-primary" }
                                                    }
                                                } else {
                                                    col {
                                                        style: hour_card
                                                        text h.time { style: "text-[10px] text-muted-foreground" }
                                                        text h.icon { style: "text-lg" }
                                                        text h.temp { style: "text-sm font-semibold text-foreground" }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if .forecast_tab == "daily" {
                                    scroll (axis: "x", style: "w-full h-36") {
                                        row {
                                            style: "items-center gap-2 h-36"
                                            for d in .daily {
                                                if d.day == "今天" {
                                                    col {
                                                        style: day_card_now
                                                        text d.day { style: "text-[10px] font-semibold text-primary" }
                                                        text d.icon { style: "text-lg" }
                                                        text d.tmax { style: "text-sm font-bold text-primary" }
                                                        text d.tmin { style: "text-[10px] text-primary/70" }
                                                    }
                                                } else {
                                                    col {
                                                        style: day_card
                                                        text d.day { style: "text-[10px] text-muted-foreground" }
                                                        text d.icon { style: "text-lg" }
                                                        text d.tmax { style: "text-sm font-semibold text-foreground" }
                                                        text d.tmin { style: "text-[10px] text-muted-foreground" }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            text "演示数据 · 非实时气象" { style: "text-center text-[10px] text-muted-foreground/70" }

                            style: "w-full max-w-md mx-auto gap-3"
                        }
                    }
                }

                    style: app_frame
                }
                style: "w-full max-w-4xl mx-auto p-3 gap-3"
            }
            style: page
        }
    }

    on {
        .Init -> {
            .layout_mode = "landscape"
            .forecast_tab = "hourly"
            .city_id = "beijing"
            .city_zh = name_for("beijing")
            .condition = condition_for("beijing")
            .cond_zh = cond_zh_for("beijing")
            .icon = icon_for("beijing")
            .temp = temp_for("beijing")
            .feels = feels_for("beijing")
            .humidity = humidity_for("beijing")
            .wind = wind_for("beijing")
            .uv = uv_for("beijing")
            .aqi = aqi_for("beijing")
            .aqi_level = aqi_level_for("beijing")
            .pressure = pressure_for("beijing")
            .visibility = visibility_for("beijing")
            .hourly = hourly_for("beijing")
            .daily = daily_for("beijing")
            .updated_at = "14:30"
        }

        .SetLayout(mode) -> {
            .layout_mode = mode
        }

        .SetForecastTab(tab) -> {
            .forecast_tab = tab
        }

        .SelectCity(id) -> {
            .city_id = id
            .city_zh = name_for(id)
            .condition = condition_for(id)
            .cond_zh = cond_zh_for(id)
            .icon = icon_for(id)
            .temp = temp_for(id)
            .feels = feels_for(id)
            .humidity = humidity_for(id)
            .wind = wind_for(id)
            .uv = uv_for(id)
            .aqi = aqi_for(id)
            .aqi_level = aqi_level_for(id)
            .pressure = pressure_for(id)
            .visibility = visibility_for(id)
            .hourly = hourly_for(id)
            .daily = daily_for(id)
        }

        .Refresh -> {
            .refreshing = true
            var id = .city_id
            .city_zh = name_for(id)
            .condition = condition_for(id)
            .cond_zh = cond_zh_for(id)
            .icon = icon_for(id)
            .temp = temp_for(id)
            .feels = feels_for(id)
            .humidity = humidity_for(id)
            .wind = wind_for(id)
            .uv = uv_for(id)
            .aqi = aqi_for(id)
            .aqi_level = aqi_level_for(id)
            .pressure = pressure_for(id)
            .visibility = visibility_for(id)
            .hourly = hourly_for(id)
            .daily = daily_for(id)
            if .updated_at == "14:30" {
                .updated_at = "14:31"
            } else if .updated_at == "14:31" {
                .updated_at = "14:32"
            } else {
                .updated_at = "14:30"
            }
            .refreshing = false
        }

        .ToggleTheme -> {
            .dark_mode = !.dark_mode
        }

        .SetTheme(t) -> {
            if t == "light" {
                .dark_mode = false
            }
            if t == "dark" {
                .dark_mode = true
            }
        }

        .SetAccent(name) -> {
            .accent_color = name
        }
    }
}
