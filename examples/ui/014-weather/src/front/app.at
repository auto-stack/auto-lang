// PLAN-637 B2 Phase B 映射（2026-09-17）：bg-blue-500/text-white→bg-primary/
// text-primary-foreground；蓝卡上浅字 text-blue-100/white/blue-200→
// text-primary-foreground（/80、/70 降档）；gray-800/700→foreground、gray-400→
// muted-foreground；tab_idle→secondary 族；页底 bg-gray-50→bg-background。
// 豁免：天气卡 from-blue-400/to-blue-600 渐变（装饰性，r2 口径）。

// PLAN-637 B2（A+B 合并）：配方体直接落 Phase B 定案值。
style tab_active = "px-4 py-2 rounded-lg text-sm font-medium bg-primary text-primary-foreground"   // 原 bg-blue-500/text-white
style tab_idle = "px-4 py-2 rounded-lg text-sm font-medium bg-secondary text-secondary-foreground"   // 原 bg-gray-200/text-gray-600
style panel_title = "text-sm font-semibold text-muted-foreground uppercase mt-2"   // 原 gray-400
style panel_body = "text-foreground py-2"   // 原 gray-700

widget App {
    msg { TabDaily, TabHourly, Refresh }

    model {
        var tab str = "daily"
        var city str = "Beijing"
        var temp str = "23°"
        var condition str = "Partly Cloudy"
        var info str = "Humidity: 65% | Wind: 12 km/h"
        var forecast str = "Mon 18~25°  Tue 20~28°  Wed 16~22°  Thu 17~24°  Fri 19~27°"
        var hourly str = "14:00 24°  15:00 25°  16:00 24°  17:00 22°  18:00 20°"
    }

    view {
        center {
            col {
                row {
                    text .city { style: "text-2xl font-bold text-foreground" }
                    button "Refresh" { onclick: .Refresh, style: "ml-auto px-4 py-2 bg-primary text-primary-foreground rounded-lg text-sm" }
                    style: "w-full items-center"
                }
                col {
                    text .condition { style: "text-lg text-primary-foreground/80" }
                    text .temp { style: "text-8xl font-thin text-primary-foreground" }
                    text .info { style: "text-sm text-primary-foreground/70" }
                    style: "bg-gradient-to-br from-blue-400 to-blue-600 rounded-2xl p-6 mt-4 items-center gap-2 py-6"
                }
                row {
                    if .tab == "daily" {
                        button "Daily" { onclick: .TabDaily, style: tab_active }
                    }
                    if .tab != "daily" {
                        button "Daily" { onclick: .TabDaily, style: tab_idle }
                    }
                    if .tab == "hourly" {
                        button "Hourly" { onclick: .TabHourly, style: tab_active }
                    }
                    if .tab != "hourly" {
                        button "Hourly" { onclick: .TabHourly, style: tab_idle }
                    }
                    style: "gap-2 mt-6"
                }
                if .tab == "daily" {
                    col {
                        text "5-Day Forecast" { style: panel_title }
                        divider {}
                        text .forecast { style: panel_body }
                        style: "w-full"
                    }
                }
                if .tab == "hourly" {
                    col {
                        text "Today" { style: panel_title }
                        divider {}
                        text .hourly { style: panel_body }
                        style: "w-full"
                    }
                }
                style: "w-full max-w-md p-6 bg-background min-h-screen"
            }
        }
    }

    on {
        .TabDaily -> { .tab = "daily" }
        .TabHourly -> { .tab = "hourly" }
        .Refresh -> { }
    }
}
