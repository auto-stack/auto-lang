// weather_data.at — 中国主要城市天气 mock 目录（PLAN-660）。
// 纯 Auto 函数，Vue/VM 双端可消费。数据为演示用静态样本，不接真实 API。

pub fn city_ids() []str {
    return ["beijing", "shanghai", "guangzhou", "shenzhen", "hangzhou",
            "chengdu", "xian", "wuhan", "harbin", "sanya"]
}

pub fn city_names() []str {
    return ["北京", "上海", "广州", "深圳", "杭州",
            "成都", "西安", "武汉", "哈尔滨", "三亚"]
}

pub fn name_for(id str) str {
    if id == "beijing" { return "北京" }
    if id == "shanghai" { return "上海" }
    if id == "guangzhou" { return "广州" }
    if id == "shenzhen" { return "深圳" }
    if id == "hangzhou" { return "杭州" }
    if id == "chengdu" { return "成都" }
    if id == "xian" { return "西安" }
    if id == "wuhan" { return "武汉" }
    if id == "harbin" { return "哈尔滨" }
    if id == "sanya" { return "三亚" }
    return "北京"
}

pub fn condition_for(id str) str {
    if id == "shanghai" || id == "hangzhou" { return "rain" }
    if id == "shenzhen" { return "storm" }
    if id == "guangzhou" || id == "xian" || id == "sanya" { return "sunny" }
    if id == "chengdu" { return "fog" }
    if id == "harbin" { return "snow" }
    return "partly"
}

pub fn cond_zh_for(id str) str {
    if id == "shanghai" { return "小雨" }
    if id == "hangzhou" { return "小雨" }
    if id == "shenzhen" { return "雷阵雨" }
    if id == "guangzhou" || id == "sanya" { return "晴" }
    if id == "xian" { return "晴" }
    if id == "chengdu" { return "雾" }
    if id == "harbin" { return "小雪" }
    if id == "wuhan" { return "多云" }
    return "多云"
}

pub fn icon_for(id str) str {
    if id == "shanghai" || id == "hangzhou" { return "🌧️" }
    if id == "shenzhen" { return "⛈️" }
    if id == "guangzhou" || id == "xian" || id == "sanya" { return "☀️" }
    if id == "chengdu" { return "🌫️" }
    if id == "harbin" { return "❄️" }
    return "⛅"
}

pub fn temp_for(id str) str {
    if id == "shanghai" { return "21°" }
    if id == "guangzhou" { return "30°" }
    if id == "shenzhen" { return "28°" }
    if id == "hangzhou" { return "22°" }
    if id == "chengdu" { return "20°" }
    if id == "xian" { return "25°" }
    if id == "wuhan" { return "27°" }
    if id == "harbin" { return "-2°" }
    if id == "sanya" { return "31°" }
    return "23°"
}

pub fn feels_for(id str) str {
    if id == "shanghai" { return "22°" }
    if id == "guangzhou" { return "33°" }
    if id == "shenzhen" { return "31°" }
    if id == "hangzhou" { return "23°" }
    if id == "chengdu" { return "21°" }
    if id == "xian" { return "24°" }
    if id == "wuhan" { return "29°" }
    if id == "harbin" { return "-6°" }
    if id == "sanya" { return "34°" }
    return "25°"
}

pub fn humidity_for(id str) str {
    if id == "shanghai" { return "82%" }
    if id == "guangzhou" { return "70%" }
    if id == "shenzhen" { return "78%" }
    if id == "hangzhou" { return "74%" }
    if id == "chengdu" { return "85%" }
    if id == "xian" { return "48%" }
    if id == "wuhan" { return "66%" }
    if id == "harbin" { return "80%" }
    if id == "sanya" { return "72%" }
    return "65%"
}

pub fn wind_for(id str) str {
    if id == "shanghai" { return "15 km/h" }
    if id == "guangzhou" { return "8 km/h" }
    if id == "shenzhen" { return "18 km/h" }
    if id == "hangzhou" { return "10 km/h" }
    if id == "chengdu" { return "6 km/h" }
    if id == "xian" { return "14 km/h" }
    if id == "wuhan" { return "11 km/h" }
    if id == "harbin" { return "20 km/h" }
    if id == "sanya" { return "16 km/h" }
    return "12 km/h"
}

pub fn uv_for(id str) str {
    if id == "guangzhou" || id == "sanya" || id == "xian" { return "很强" }
    if id == "harbin" || id == "chengdu" { return "弱" }
    return "中等"
}

pub fn aqi_for(id str) str {
    if id == "shanghai" { return "55" }
    if id == "guangzhou" { return "42" }
    if id == "shenzhen" { return "35" }
    if id == "hangzhou" { return "60" }
    if id == "chengdu" { return "95" }
    if id == "xian" { return "78" }
    if id == "wuhan" { return "72" }
    if id == "harbin" { return "50" }
    if id == "sanya" { return "28" }
    return "68"
}

pub fn aqi_level_for(id str) str {
    if id == "guangzhou" || id == "shenzhen" || id == "sanya" { return "优" }
    if id == "chengdu" { return "轻度污染" }
    return "良"
}

pub fn pressure_for(id str) str {
    if id == "harbin" { return "1028 hPa" }
    if id == "sanya" { return "1006 hPa" }
    if id == "chengdu" { return "1008 hPa" }
    return "1012 hPa"
}

pub fn visibility_for(id str) str {
    if id == "chengdu" { return "3 km" }
    if id == "shanghai" || id == "hangzhou" { return "8 km" }
    if id == "harbin" { return "5 km" }
    return "12 km"
}

pub fn updated_at_for(id str) str {
    return "14:30"
}

// 小时预报：每城 8 点，首点为「现在」
