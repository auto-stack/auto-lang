// 5 日预报
pub fn daily_for(id str) List {
    if id == "shanghai" {
        return [
            { day: "今天", icon: "🌧️", cond: "小雨", tmin: "18°", tmax: "23°" },
            { day: "周二", icon: "🌧️", cond: "中雨", tmin: "17°", tmax: "21°" },
            { day: "周三", icon: "☁️", cond: "阴", tmin: "17°", tmax: "22°" },
