        return [
            { time: "现在", icon: "🌧️", temp: "21°", now: true },
            { time: "15:00", icon: "🌧️", temp: "21°", now: false },
            { time: "16:00", icon: "🌧️", temp: "20°", now: false },
            { time: "17:00", icon: "☁️", temp: "20°", now: false },
