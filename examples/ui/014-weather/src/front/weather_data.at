// AQI 等级徽标样式
pub fn aqi_badge_style(level str) str {
    if level == "优" {
        return "text-[10px] px-1.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-600 font-medium"
    }
    if level == "轻度污染" {
        return "text-[10px] px-1.5 py-0.5 rounded-full bg-amber-500/15 text-amber-600 font-medium"
    }
    return "text-[10px] px-1.5 py-0.5 rounded-full bg-primary/15 text-primary font-medium"
}

// 条件 → hero 装饰渐变（PLAN-637 r2 豁免口径：装饰性允许保留具体色）
pub fn hero_grad(condition str) str {
    if condition == "sunny" {
        return "bg-gradient-to-br from-amber-400 to-orange-500 rounded-3xl p-6 items-center gap-2 shadow-lg"
    }
    if condition == "rain" {
        return "bg-gradient-to-br from-blue-400 to-blue-600 rounded-3xl p-6 items-center gap-2 shadow-lg"
    }
    if condition == "storm" {
        return "bg-gradient-to-br from-indigo-500 to-purple-600 rounded-3xl p-6 items-center gap-2 shadow-lg"
    }
    if condition == "snow" {
        return "bg-gradient-to-br from-cyan-300 to-sky-500 rounded-3xl p-6 items-center gap-2 shadow-lg"
    }
    if condition == "fog" {
        return "bg-gradient-to-br from-gray-300 to-slate-500 rounded-3xl p-6 items-center gap-2 shadow-lg"
    }
    if condition == "cloudy" {
        return "bg-gradient-to-br from-slate-400 to-slate-600 rounded-3xl p-6 items-center gap-2 shadow-lg"
    }
    // partly 默认
    return "bg-gradient-to-br from-sky-400 to-blue-500 rounded-3xl p-6 items-center gap-2 shadow-lg"
}
