// Image service seam for 031-image-viewer (Plan 547 Task 29).
// Directory/session/cache behavior is implemented in Tasks 30–32.
use types: ImageEntry, ImageAsset, ViewerSnapshot, ViewRequest
use directory_index: supported_extension, redact_relative_path, cycle_index
use auto.image

pub fn image_service_status() str {
    return "Ready"
}

// Session orchestration is intentionally metadata-only. Every image operation
// is delegated to the shared auto.image registry; this file never carries
// decoded bytes or source filesystem paths in model state.
pub fn open_session(root str) str {
    return image.open_session(root)
}

pub fn navigate_session(session str, delta int) str {
    return image.navigate(session, delta)
}

pub fn request_view(session str, index int, viewport_width int, viewport_height int, quality int) str {
    return image.request_view(session, index, viewport_width, viewport_height, quality)
}

pub fn close_session(session str) bool {
    return image.close_session(session)
}

pub fn image_stats(session str) str {
    return image.session_stats(session)
}
