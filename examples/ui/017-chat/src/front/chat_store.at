// chat_store.at — SharedStore (Plan musk-022 & Plan 544).
// PLAN-043 走查修复（2026-09-24）：`use back.api` 直接导入（含 SSE stream
// 注线）在 VM 轨不可解析（P-15 静默跳过 → 无法启动）——联系人/消息改走
// back HTTP 端点（GET /api/contacts|messages，lazy back 随首次请求孵化）；
// SSE Typing 面保留 handler 但 VM 轨无源（vue codegen 特性），bot_reply
// 改 POST /api/bot_reply 触发。

// TypingEvent: the SSE payload for a typing signal (Plan 399 Phase 12).
// Backend broadcasts {"event":"Typing","name":"<user>"}. The store reads .name.
type TypingEvent { name str }

store ChatStore {
    model {
        var contacts = []
        var messages = []
        var active_contact_id str = "alice"
        var search_query str = ""
        var typing_name str = ""
        var loading bool = false
    }

    msg { Init, SelectContact(str), Search(str), NewMessage(Message), Typing(TypingEvent), RefreshMessages, TriggerBot(str) }

    on {
        .Init -> {
            .loading = true
            .contacts = Http.get_json("/api/contacts")
            .messages = Http.get_json("/api/messages")
            .loading = false
        }
        .SelectContact(id) -> {
            .active_contact_id = id
        }
        .Search(query) -> {
            .search_query = query
        }
        .NewMessage(msg) -> {
            .messages.push(msg)
        }
        .Typing(evt) -> {
            .typing_name = evt.name
        }
        .RefreshMessages -> {
            .messages = Http.get_json("/api/messages")
        }
        .TriggerBot(query) -> {
            try { Http.post("/api/bot_reply", json.from_value({ contact_id: .active_contact_id, query: query })) } catch { }
            .messages = Http.get_json("/api/messages")
        }
    }
}
