// message_thread.at — presentational child widget.
// mine is DERIVED from sender identity (not the persisted field: the generic
// CRUD POST handler sets mine via Default::default(), unreliable). "You" = right.
widget MessageThread(messages: []Message, typing_name: str) {
    view {
        col {
            style: "flex-1 flex-col bg-card rounded-xl shadow-sm overflow-hidden min-h-0"
            row {
                style: "items-center gap-2 px-6 py-3 border-b border-border"
                text "Thread" { style: "text-base font-bold text-foreground" }
                if .typing_name != "" {
                    text f"${.typing_name} is typing…" { style: "text-xs text-muted-foreground italic ml-auto" }
                }
            }
            col {
                style: "flex-1 overflow-y-auto p-6 gap-3"
                if .messages.len() == 0 {
                    col {
                        style: "flex-1 items-center justify-center"
                        text "💬" { style: "text-5xl mb-3 opacity-40" }
                        text "No messages yet" { style: "text-muted-foreground" }
                    }
                }
                for msg in .messages {
                    col {
                        if msg.sender == "You" {
                            row {
                                style: "justify-end"
                                col {
                                    text msg.text { style: "text-sm bg-primary text-primary-foreground px-4 py-2 rounded-2xl rounded-br-sm max-w-md" }
                                    text msg.time { style: "text-xs text-muted-foreground mt-0.5 text-right" }
                                    style: "items-end max-w-[70%]"
                                }
                            }
                        } else {
                            row {
                                style: "justify-start gap-2"
                                col {
                                    text msg.sender { style: "text-xs font-semibold text-muted-foreground mb-0.5" }
                                    text msg.text { style: "text-sm bg-muted text-foreground px-4 py-2 rounded-2xl rounded-bl-sm max-w-md" }
                                    text msg.time { style: "text-xs text-muted-foreground mt-0.5" }
                                    style: "items-start max-w-[70%]"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
