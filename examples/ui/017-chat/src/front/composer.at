// composer.at — enhanced input bar with emoji picker and quick chips.
// DoSend msg avoids name collision with on_send callback (Gotcha U21).
// Input sync via value: .draft two-way binding; on_typing triggered via inline lambda.
widget Composer(on_send: msg, on_typing: msg) {
    msg { DoSend, InsertEmoji(str), SendQuick(str) }
    model { var draft str = "" }
    view {
        col {
            style: "p-3 bg-card rounded-xl shadow-sm border border-border gap-2"
            // Emoji toolbar & quick action chips
            row {
                style: "items-center justify-between gap-2 overflow-x-auto pb-1"
                row {
                    style: "items-center gap-1"
                    button "😀" { onclick: .InsertEmoji("😀"), style: "text-base p-1 bg-transparent hover:scale-125 transition-transform border-0 cursor-pointer select-none" }
                    button "😂" { onclick: .InsertEmoji("😂"), style: "text-base p-1 bg-transparent hover:scale-125 transition-transform border-0 cursor-pointer select-none" }
                    button "👍" { onclick: .InsertEmoji("👍"), style: "text-base p-1 bg-transparent hover:scale-125 transition-transform border-0 cursor-pointer select-none" }
                    button "❤️" { onclick: .InsertEmoji("❤️"), style: "text-base p-1 bg-transparent hover:scale-125 transition-transform border-0 cursor-pointer select-none" }
                    button "🎉" { onclick: .InsertEmoji("🎉"), style: "text-base p-1 bg-transparent hover:scale-125 transition-transform border-0 cursor-pointer select-none" }
                    button "🔥" { onclick: .InsertEmoji("🔥"), style: "text-base p-1 bg-transparent hover:scale-125 transition-transform border-0 cursor-pointer select-none" }
                    button "🚀" { onclick: .InsertEmoji("🚀"), style: "text-base p-1 bg-transparent hover:scale-125 transition-transform border-0 cursor-pointer select-none" }
                    button "🤖" { onclick: .InsertEmoji("🤖"), style: "text-base p-1 bg-transparent hover:scale-125 transition-transform border-0 cursor-pointer select-none" }
                }
                row {
                    style: "items-center gap-1.5 flex-shrink-0"
                    button "Hello! 👋" { onclick: .SendQuick("Hello! 👋"), style: "text-xs px-2.5 py-1 bg-muted hover:bg-muted/80 text-foreground rounded-lg transition-colors border border-border/40 font-medium" }
                    button "Got it! 👍" { onclick: .SendQuick("Got it! 👍"), style: "text-xs px-2.5 py-1 bg-muted hover:bg-muted/80 text-foreground rounded-lg transition-colors border border-border/40 font-medium" }
                }
            }
            // Input row
            row {
                style: "items-center gap-2"
                input {
                    placeholder: "Type a message..."
                    value: .draft
                    oninput: () => { on_typing("You") }
                    onenter: .DoSend
                    style: "flex-1 px-4 py-2 bg-background border border-border rounded-xl text-sm text-foreground outline-none focus:border-primary transition-colors shadow-xs"
                }
                button "Send" {
                    onclick: .DoSend
                    style: "px-5 py-2 bg-primary text-primary-foreground rounded-xl text-sm font-semibold shadow-xs hover:bg-primary/90 transition-colors"
                }
            }
        }
    }
    on {
        .DoSend -> {
            if .draft.trim() != "" {
                on_send(.draft)
                .draft = ""
            }
        }
        .InsertEmoji(emoji) -> {
            .draft = .draft + emoji
        }
        .SendQuick(text) -> {
            on_send(text)
        }
    }
}
