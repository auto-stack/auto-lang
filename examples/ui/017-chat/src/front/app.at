// app.at — Chat shell (Plan musk-022 SSE multi-event end-to-end).
// Plan 051 C7 试点：header 秒表计时器（timer 块 demo，vue/VM 双轨）。
use chat_store: ChatStore
use message_thread: MessageThread
use composer: Composer
use back.api: send_message, list_messages, set_typing

widget App {
    msg { Init, SendMessage(str), Typing(str), ClockTick }
    model {
        var clock_secs int = 0
    }
    timer {
        ClockTick (every_ms: 1000)
    }
    view {
        col {
            style: "w-full h-screen flex-col bg-muted/30 p-3 gap-3"
            row {
                style: "items-center justify-between px-5 py-3 bg-card rounded-xl shadow-sm"
                row {
                    style: "items-center gap-2"
                    text "💬" { style: "text-xl" }
                    h2 "Chat" { style: "text-lg font-bold text-foreground" }
                }
                row {
                    style: "items-center gap-3"
                    if .store.loading {
                        text "Loading…" { style: "text-xs text-muted-foreground" }
                    }
                    text f"⏱ ${.clock_secs}s" { style: "text-xs text-muted-foreground tabular-nums" }
                }
            }
            col {
                style: "flex-1 gap-3 min-h-0"
                MessageThread(messages: .store.messages, typing_name: .store.typing_name)
                Composer(on_send: .SendMessage, on_typing: .Typing)
            }
        }
    }
    on {
        .Init -> { store.Init() }
        // Plan 051 C7: 每秒 +1（timer 拍进既有 msg 流）。
        .ClockTick -> { .clock_secs = .clock_secs + 1 }
        .SendMessage(text) -> {
            send_message("You", text)
            store.messages = list_messages()
        }
        // Plan 399 §6: typing-indicator — fire-and-forget POST /api/typing.
        // The backend broadcasts a Typing SSE event; connected clients' stores
        // receive it via the .Typing(name) handler (chat_store.at).
        .Typing(name) -> {
            set_typing(name)
        }
    }
}
