// db.at — Chat data service (in-memory). SSE broadcast is handled by the
// generated POST handler.

use api: Contact, Message

var contacts List<Contact> = List<Contact>.new([
    Contact { id: "alice", name: "Alice", avatar: "👩‍💼", status: "Online", last_message: "Nice! Does it handle multiple event types?", time: "10:03 AM", unread: 0 },
    Contact { id: "bob", name: "Bob", avatar: "👨‍💻", status: "Online", last_message: "Morning everyone!", time: "9:30 AM", unread: 1 },
    Contact { id: "autobot", name: "AutoBot", avatar: "🤖", status: "AI Assistant", last_message: "Hello! Ask me anything about AutoLang.", time: "Just now", unread: 0 },
    Contact { id: "support", name: "Tech Support", avatar: "🛠️", status: "Service", last_message: "System operational. 0 alerts.", time: "Yesterday", unread: 0 },
])

var messages List<Message> = List<Message>.new([
    Message { id: 0, sender: "Alice", text: "Hey! How is the project going?", time: "10:00 AM", mine: false },
    Message { id: 1, sender: "You", text: "Going well! Just finished the SSE integration.", time: "10:02 AM", mine: true },
    Message { id: 2, sender: "Alice", text: "Nice! Does it handle multiple event types?", time: "10:03 AM", mine: false },
    Message { id: 3, sender: "You", text: "Yes - NewMessage and Typing both dispatch correctly.", time: "10:05 AM", mine: true },
    Message { id: 4, sender: "Bob", text: "Morning everyone!", time: "9:30 AM", mine: false },
])

var nextid int = 5

pub fn all_contacts() []Contact {
    return contacts
}

pub fn all_messages() []Message {
    return messages
}

// Plan 399 §6: typing signal — no persistence needed (transient); the handler
// broadcasts the Typing SSE event. This fn exists so resolve_db_call delegates
// set_typing → crate::db::set_typing (and the void-POST+broadcast path runs).
pub fn set_typing(sender str) {
    return
}

pub fn create_message(sender str, text str) Message {
    let msg = Message {
        id: nextid,
        sender: sender,
        text: text,
        time: "Just now",
        mine: true,
    }
    nextid = nextid + 1
    messages.push(msg)
    return msg
}

pub fn bot_reply(contact_id str, query str) Message {
    let sender_name = if contact_id == "autobot" {
        "AutoBot"
    } else if contact_id == "support" {
        "Tech Support"
    } else if contact_id == "bob" {
        "Bob"
    } else {
        "Alice"
    }
    let reply_text = if contact_id == "autobot" {
        "AutoBot: I received your message! AutoLang supports dual-engine UI and SSE streaming."
    } else if contact_id == "support" {
        "Support: Thanks for contacting us. All systems operational."
    } else if contact_id == "bob" {
        "Bob: Sounds great, let's catch up later today!"
    } else {
        "Alice: Got it! Let's continue testing the chat features."
    }
    let msg = Message {
        id: nextid,
        sender: sender_name,
        text: reply_text,
        time: "Just now",
        mine: false,
    }
    nextid = nextid + 1
    messages.push(msg)
    return msg
}
