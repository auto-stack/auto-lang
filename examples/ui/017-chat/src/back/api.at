// api.at — Chat API (Plan 544: WeChat-style multi-contact & bot enhancements).
// CRUD message endpoints + contacts list + bot reply + SSE stream.

pub type Contact = {
    id: str
    name: str
    avatar: str
    status: str
    last_message: str
    time: str
    unread: int
}

pub type Message = {
    id: int
    sender: str
    text: str
    time: str
    mine: bool
}

// SSE event union. resolve_stream_variants reads this to wire the frontend
// dispatch (new_message -> NewMessage, typing -> Typing).
pub tag ChatEvent {
    NewMessage(Message),
    Typing(str),
}

use db

#[api(method = "GET", path = "/api/contacts")]
pub fn list_contacts() []Contact {
    return db.all_contacts()
}

#[api(method = "GET", path = "/api/messages")]
pub fn list_messages() []Message {
    return db.all_messages()
}

#[api(method = "POST", path = "/api/messages")]
pub fn send_message(sender str, text str) Message {
    return db.create_message(sender, text)
}

#[api(method = "POST", path = "/api/bot_reply")]
pub fn bot_reply(contact_id str, query str) Message {
    return db.bot_reply(contact_id, query)
}

/// POST /api/typing — Plan 399 §6: typing-indicator signal. Void return; the
/// handler broadcasts a Typing event (the sender name) over the SSE bus so all
/// connected clients see "X is typing…". fn name contains "typing" so the
/// codegen broadcasts discriminator "Typing" (broadcast_event_name convention).
#[api(method = "POST", path = "/api/typing")]
pub fn set_typing(sender str) {
    return db.set_typing(sender)
}

/// GET /api/stream — frontend opens EventSource here (codegen-driven).
#[api(method = "GET", path = "/api/stream")]
pub fn stream() ~Stream<ChatEvent> {
    return bus.subscribe()
}
