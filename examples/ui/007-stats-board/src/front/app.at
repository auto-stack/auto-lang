use stylekit.styles: caption_text, section_title

// PLAN-637 B2（Phase A 提取 + Phase B 映射，2026-09-17）：
//   Phase B 映射：text-gray-900→text-foreground；text-gray-500→text-muted-foreground；
//   bg-white→bg-card；border-gray-100→border-border；页面底 bg-gray-50→bg-background。
//   stylekit 消费：hint_sm→caption_text（×12 位点）、stat_value→section_title(text-sm)
//   （×21 位点；Phase B 归一后体序全等）。title_lg（×3）因源串词序（text-lg 在前）
//   与 section_title 输出序不同，字节等价不可达，留本地（词序敏感性未验证不冒险）。
//   豁免：四 stat 图标 chip（bg-{red,blue,green,purple}-100 + 同色 text-*-500）与
//   三 avatar 底色（bg-{blue,green,purple}-100）＝类目装饰色，registry 无对应语义键。
style title_2xl = "text-2xl font-bold text-foreground"   // Phase B: gray-900 → foreground
style title_lg = "text-lg font-semibold text-foreground"   // Phase B: gray-900 → foreground
style stat_value = section_title(size: "text-sm")   // Phase B：归一后消费 stylekit（体 ≡ "font-semibold text-foreground text-sm"）
style stat_label = "text-sm text-muted-foreground"   // Phase B: text-gray-500 → text-muted-foreground
style hint_sm = caption_text                        // Phase B：消费 stylekit caption_text
style stat_card = "bg-card rounded-xl shadow-sm border border-border p-4 flex-1"   // Phase B: bg-white/border-gray-100 → bg-card/border-border
style list_row_lg = "w-full items-center py-3 border-b border-border"   // Phase B
style panel_card = "bg-card rounded-xl shadow-sm border border-border p-5 flex-1 gap-4"   // Phase B: 同 stat_card（Phase A 漏盘 p-5 变体，B 补提取）
style member_stats_row = "gap-4 mt-3"   // Phase A 补提取（截断漏盘）
style list_row_sm = "w-full items-center py-2 border-b border-border"   // Phase B
style row_inline = "gap-0 items-center"
style row_avatar = "gap-3 items-center"

widget App {
    model {
        // Header
        var dashboard_title str = "Dashboard"
        var dashboard_subtitle str = "Campaign Insights"

        // Stat cards
        var stat1_title str = "Campaign Alerts"
        var stat1_value str = "123k"
        var stat2_title str = "System Alerts"
        var stat2_value str = "89k"
        var stat3_title str = "Promotional Offers"
        var stat3_value str = "3k"
        var stat4_title str = "Traffic Distribution"
        var stat4_value str = "175k"

        // Campaign Performance
        var perf_all_traffic str = "14,582"
        var perf_instagram str = "8,421"
        var perf_linkedin str = "3,219"
        var perf_google str = "1,987"
        var perf_x str = "952"

        // Campaign Targets
        var target_progress int = 86
        var target_current str = "8,571"
        var target_goal str = "10,000"
        var kpi1 str = "Revenue Target"
        var kpi1_value str = "$32.5k"
        var kpi2 str = "Active Users"
        var kpi2_value str = "2,450"
        var kpi3 str = "Conversion Rate"
        var kpi3_value str = "5.6%"
        var kpi4 str = "Avg. Order Value"
        var kpi4_value str = "$128"

        // Team Performance
        var member1_name str = "Sarah Johnson"
        var member1_role str = "Marketing Lead"
        var member1_posts str = "142"
        var member1_followers str = "12.5k"
        var member1_engagement str = "4.8%"
        var member2_name str = "Mike Chen"
        var member2_role str = "Content Strategist"
        var member2_posts str = "98"
        var member2_followers str = "8.2k"
        var member2_engagement str = "6.1%"
        var member3_name str = "Emily Davis"
        var member3_role str = "Social Media Manager"
        var member3_posts str = "215"
        var member3_followers str = "15.8k"
        var member3_engagement str = "5.3%"
    }

    view {
        col {
            // Header
            row {
                col {
                    h2 .dashboard_title {
                        style: title_2xl
                    }
                    span .dashboard_subtitle {
                        style: stat_label
                    }
                    style: "gap-1"
                }
                spacer
                style: "w-full items-center justify-between"
            }

            // Stat Cards Row
            row {
                col {
                    row {
                        col {
                            style: "w-12 h-12 rounded-lg bg-red-100 flex items-center justify-center text-red-500 text-xl font-bold"
                        }
                        col {
                            span .stat1_title {
                                style: stat_label
                            }
                            span .stat1_value {
                                style: title_2xl
                            }
                            style: "gap-0"
                        }
                        style: row_avatar
                    }
                    style: stat_card
                }
                col {
                    row {
                        col {
                            style: "w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center text-blue-500 text-xl font-bold"
                        }
                        col {
                            span .stat2_title {
                                style: stat_label
                            }
                            span .stat2_value {
                                style: title_2xl
                            }
                            style: "gap-0"
                        }
                        style: row_avatar
                    }
                    style: stat_card
                }
                col {
                    row {
                        col {
                            style: "w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center text-green-500 text-xl font-bold"
                        }
                        col {
                            span .stat3_title {
                                style: stat_label
                            }
                            span .stat3_value {
                                style: title_2xl
                            }
                            style: "gap-0"
                        }
                        style: row_avatar
                    }
                    style: stat_card
                }
                col {
                    row {
                        col {
                            style: "w-12 h-12 rounded-lg bg-purple-100 flex items-center justify-center text-purple-500 text-xl font-bold"
                        }
                        col {
                            span .stat4_title {
                                style: stat_label
                            }
                            span .stat4_value {
                                style: title_2xl
                            }
                            style: "gap-0"
                        }
                        style: row_avatar
                    }
                    style: stat_card
                }
                style: "gap-4"
            }

            // Middle Row: Campaign Performance + Campaign Targets
            row {
                // Campaign Performance
                col {
                    h3 "Campaign Performance" {
                        style: title_lg
                    }
                    col {
                        row {
                            span "All Traffic" {
                                style: stat_label
                            }
                            spacer
                            span .perf_all_traffic {
                                style: stat_value
                            }
                            style: list_row_lg
                        }
                        row {
                            span "Instagram" {
                                style: stat_label
                            }
                            spacer
                            span .perf_instagram {
                                style: stat_value
                            }
                            style: list_row_lg
                        }
                        row {
                            span "LinkedIn" {
                                style: stat_label
                            }
                            spacer
                            span .perf_linkedin {
                                style: stat_value
                            }
                            style: list_row_lg
                        }
                        row {
                            span "Google" {
                                style: stat_label
                            }
                            spacer
                            span .perf_google {
                                style: stat_value
                            }
                            style: list_row_lg
                        }
                        row {
                            span "X" {
                                style: stat_label
                            }
                            spacer
                            span .perf_x {
                                style: stat_value
                            }
                            style: "w-full items-center py-3"
                        }
                        style: "w-full"
                    }
                    style: panel_card
                }

                // Campaign Targets
                col {
                    h3 "Campaign Targets" {
                        style: title_lg
                    }
                    col {
                        row {
                            span "Overall Progress" {
                                style: stat_label
                            }
                            spacer
                            span "85.7%" {
                                style: "text-sm font-semibold text-foreground"
                            }
                            style: "w-full items-center"
                        }
                        progress (value: .target_progress, max: 100) {
                            style: "mt-2 mb-4"
                        }
                        row {
                            span .target_current
                            span "/"
                            span .target_goal
                            style: "text-sm text-muted-foreground gap-1"
                        }
                        style: "w-full"
                    }
                    divider
                    col {
                        row {
                            span .kpi1 {
                                style: stat_label
                            }
                            spacer
                            span .kpi1_value {
                                style: stat_value
                            }
                            style: list_row_sm
                        }
                        row {
                            span .kpi2 {
                                style: stat_label
                            }
                            spacer
                            span .kpi2_value {
                                style: stat_value
                            }
                            style: list_row_sm
                        }
                        row {
                            span .kpi3 {
                                style: stat_label
                            }
                            spacer
                            span .kpi3_value {
                                style: stat_value
                            }
                            style: list_row_sm
                        }
                        row {
                            span .kpi4 {
                                style: stat_label
                            }
                            spacer
                            span .kpi4_value {
                                style: stat_value
                            }
                            style: "w-full items-center py-2"
                        }
                        style: "w-full"
                    }
                    style: panel_card
                }
                style: "gap-4"
            }

            // Team Performance
            col {
                h3 "Team Performance" {
                    style: title_lg
                }
                row {
                    col {
                        row {
                            avatar {
                                style: "w-10 h-10 rounded-full bg-blue-100"
                            }
                            col {
                                span .member1_name {
                                    style: stat_value
                                }
                                span .member1_role {
                                    style: hint_sm
                                }
                                style: "gap-0"
                            }
                            style: row_avatar
                        }
                        row {
                            col {
                                span "Posts" {
                                    style: hint_sm
                                }
                                span .member1_posts {
                                    style: stat_value
                                }
                                style: row_inline
                            }
                            col {
                                span "Followers" {
                                    style: hint_sm
                                }
                                span .member1_followers {
                                    style: stat_value
                                }
                                style: row_inline
                            }
                            col {
                                span "Engagement" {
                                    style: hint_sm
                                }
                                span .member1_engagement {
                                    style: stat_value
                                }
                                style: row_inline
                            }
                            style: member_stats_row
                        }
                        style: stat_card
                    }
                    col {
                        row {
                            avatar {
                                style: "w-10 h-10 rounded-full bg-green-100"
                            }
                            col {
                                span .member2_name {
                                    style: stat_value
                                }
                                span .member2_role {
                                    style: hint_sm
                                }
                                style: "gap-0"
                            }
                            style: row_avatar
                        }
                        row {
                            col {
                                span "Posts" {
                                    style: hint_sm
                                }
                                span .member2_posts {
                                    style: stat_value
                                }
                                style: row_inline
                            }
                            col {
                                span "Followers" {
                                    style: hint_sm
                                }
                                span .member2_followers {
                                    style: stat_value
                                }
                                style: row_inline
                            }
                            col {
                                span "Engagement" {
                                    style: hint_sm
                                }
                                span .member2_engagement {
                                    style: stat_value
                                }
                                style: row_inline
                            }
                            style: member_stats_row
                        }
                        style: stat_card
                    }
                    col {
                        row {
                            avatar {
                                style: "w-10 h-10 rounded-full bg-purple-100"
                            }
                            col {
                                span .member3_name {
                                    style: stat_value
                                }
                                span .member3_role {
                                    style: hint_sm
                                }
                                style: "gap-0"
                            }
                            style: row_avatar
                        }
                        row {
                            col {
                                span "Posts" {
                                    style: hint_sm
                                }
                                span .member3_posts {
                                    style: stat_value
                                }
                                style: row_inline
                            }
                            col {
                                span "Followers" {
                                    style: hint_sm
                                }
                                span .member3_followers {
                                    style: stat_value
                                }
                                style: row_inline
                            }
                            col {
                                span "Engagement" {
                                    style: hint_sm
                                }
                                span .member3_engagement {
                                    style: stat_value
                                }
                                style: row_inline
                            }
                            style: member_stats_row
                        }
                        style: stat_card
                    }
                    style: "gap-4"
                }
                style: "w-full gap-4"
            }

            style: "w-full p-6 gap-6 bg-background min-h-screen"
        }
    }
}
