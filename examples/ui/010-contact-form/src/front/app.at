// app.at — Contact Form.
// PLAN-637 B2（A+B 合并）：Phase A 提取 field_col ×3；Phase B 映射（2026-09-17）：
// zinc/gray 明暗臂按角色收敛——zinc-100・gray-900/zinc-200→foreground；zinc-400・
// gray-500・gray-600・gray-700（眉标签）→muted-foreground；border-zinc-800・gray-200→
// border-border；卡面 bg-zinc-900・bg-white→bg-card（shadow 差异保留条件）；页根→
// bg-background/text-foreground。豁免：发送成功回执的 emerald 簇 ×5（success 语义
// registry 无键，装饰性状态色豁免，主题系统立项时评估回迁——与 004 状态点同口径）。

// PLAN-637 T-01b（用户裁定：demo 跟随系统）：SettingsPopover 消费面移除，
// 主题控制由 gallery 宿主切换器承接；SetTheme/SetAccent 消息面保留
// （宿主 → 内嵌 demo 主题传播路线的既有通道），本 demo 内无发射方。

style field_col = "gap-1.5 w-full"

widget App {
    msg { Submit, SetTheme(str), SetAccent(str) }

    model {
        var dark_mode bool = true
        var accent_color str = "indigo"   // declared for os-config/env seeding (Plan 504 idiom)

        var name str = ""
        var email str = ""
        var message str = ""
        var submitted bool = false

        // FAQ data (Plan 448 F: list-of-structs + for, replacing the ten
        // hand-unrolled faq1_q..faq5_a scalars; last item drops the border).
        var faqs = [
            { q: "What are your business hours?", a: "Our support team is available Monday through Friday, 9am to 6pm EST. For urgent matters outside these hours, please email urgent@company.com." },
            { q: "How long does it take to get a response?", a: "Our team typically responds to all inquiries within 24 hours during business days." },
            { q: "Do you offer phone support?", a: "Phone support is available for Enterprise plan subscribers. Free and Starter plans receive email and community support." },
            { q: "Can I schedule a demo?", a: "Yes! Contact our sales team using the form and select demo request to schedule a live 30-minute walkthrough." }
        ]
    }

    view {
        col {
            // ── Main Contact Form & FAQ Content ──
            col {
                // Section Header
                col {
                    h1 "How can we help?" {
                        style: "text-3xl font-extrabold text-primary tracking-tight text-center"
                    }
                    span "Check our FAQ for quick answers or send us a message." {
                        style: if .dark_mode {
                            "text-sm text-muted-foreground text-center max-w-xl mt-1"
                        } else {
                            "text-sm text-muted-foreground text-center max-w-xl mt-1"
                        }
                    }
                    style: "gap-1 items-center mb-2"
                }

                // Two-column Layout
                row {
                    // Left Column: FAQ Card
                    col {
                        h3 "Frequently Asked Questions" {
                            style: if .dark_mode {
                                "text-lg font-bold text-foreground mb-2"
                            } else {
                                "text-lg font-bold text-foreground mb-2"
                            }
                        }
                        col {
                            for i, f in .faqs {
                                col {
                                    span f.q {
                                        style: if .dark_mode {
                                            "font-semibold text-foreground text-sm"
                                        } else {
                                            "font-semibold text-foreground text-sm"
                                        }
                                    }
                                    span f.a {
                                        style: if .dark_mode {
                                            "text-sm text-muted-foreground mt-1 leading-relaxed"
                                        } else {
                                            "text-sm text-muted-foreground mt-1 leading-relaxed"
                                        }
                                    }
                                    style: if i < .faqs.len() - 1 {
                                        if .dark_mode {
                                            "py-3 border-b border-border"
                                        } else {
                                            "py-3 border-b border-border"
                                        }
                                    } else {
                                        "py-3"
                                    }
                                }
                            }
                            style: "w-full"
                        }
                        style: if .dark_mode {
                            "flex-1 p-6 rounded-2xl bg-card border border-border shadow-lg gap-3"
                        } else {
                            "flex-1 p-6 rounded-2xl bg-card border border-border shadow-sm gap-3"
                        }
                    }

                    // Right Column: Contact Form Card
                    col {
                        h3 "Still have questions?" {
                            style: if .dark_mode {
                                "text-lg font-bold text-foreground mb-2"
                            } else {
                                "text-lg font-bold text-foreground mb-2"
                            }
                        }
                        col {
                            col {
                                span "Name *" {
                                    style: if .dark_mode {
                                        "text-xs font-semibold text-muted-foreground uppercase tracking-wide"
                                    } else {
                                        "text-xs font-semibold text-muted-foreground uppercase tracking-wide"
                                    }
                                }
                                input { placeholder: "Your name", value: .name }
                                style: field_col
                            }
                            col {
                                span "Email *" {
                                    style: if .dark_mode {
                                        "text-xs font-semibold text-muted-foreground uppercase tracking-wide"
                                    } else {
                                        "text-xs font-semibold text-muted-foreground uppercase tracking-wide"
                                    }
                                }
                                input { placeholder: "you@example.com", value: .email }
                                style: field_col
                            }
                            col {
                                span "Message *" {
                                    style: if .dark_mode {
                                        "text-xs font-semibold text-muted-foreground uppercase tracking-wide"
                                    } else {
                                        "text-xs font-semibold text-muted-foreground uppercase tracking-wide"
                                    }
                                }
                                textarea { placeholder: "How can we help?", value: .message }
                                style: field_col
                            }
                            if .submitted {
                                row {
                                    span "✓" { style: "text-emerald-500 font-bold text-base" }
                                    span "Thank you! Your message has been sent." {
                                        style: if .dark_mode {
                                            "text-sm font-medium text-emerald-400"
                                        } else {
                                            "text-sm font-medium text-emerald-600"
                                        }
                                    }
                                    style: if .dark_mode {
                                        "w-full p-3 rounded-lg bg-emerald-950/50 border border-emerald-800 gap-2 items-center mt-1"
                                    } else {
                                        "w-full p-3 rounded-lg bg-emerald-50 border border-emerald-200 gap-2 items-center mt-1"
                                    }
                                }
                            }
                            button "Send Message" {
                                onclick: .Submit
                                style: "w-full py-2.5 text-sm font-semibold rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 shadow-sm transition-colors cursor-pointer mt-2"
                            }
                            style: "w-full gap-4"
                        }
                        style: if .dark_mode {
                            "flex-1 p-6 rounded-2xl bg-card border border-border shadow-lg gap-3"
                        } else {
                            "flex-1 p-6 rounded-2xl bg-card border border-border shadow-sm gap-3"
                        }
                    }
                    style: "w-full gap-6 items-start"
                }

                style: "w-full flex-1 px-8 py-6 gap-6 items-center justify-start max-w-5xl mx-auto"
            }

            style: if .dark_mode {
                "w-full min-h-screen bg-background text-foreground relative"
            } else {
                "w-full min-h-screen bg-background text-foreground relative"
            }
        }
    }

    on {
        .Submit -> {
            .submitted = true
        }
        .SetTheme(t) -> {
            if t == "light" {
                .dark_mode = false
            }
            if t == "dark" {
                .dark_mode = true
            }
        }
        .SetAccent(name) -> { .accent_color = name }
    }
}
