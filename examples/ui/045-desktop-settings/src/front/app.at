// app.at — 桌面设置（Plan 540 M2：设置窗口 registry App 化）。
//
// 形态：普通虚拟窗（×关闭/拖拽/缩放/z 序由 WM 免费继承——去 modal 化），
// 桌面风格页（bg-card 卡片 + 左列分区导航 + 右列表单）。
//
// 单源读写（~/.config/autoos/apps/desktop/config.at）：
//   读 = 宿主 launch 期 cfg_* 播种（Plan 504 扩展 seed_desktop_config；
//        Vue 端无宿主 = 以下缺省值，与宿主内置默认一致——双端 parity）。
//   写 = `__desktop_cmd` 驱动动词上行（宿主执行臂唯一收口：config 落盘 +
//        热生效——set_dock_position/set_dock_enabled/set_theme/set_wallpaper
//        沿用，set_dock_pinned/set_transparency/set_notes_enabled/
//        set_wallpapers_dir 为 540 新增）。
//
// 系统（501 衔接）：os-config 入口 launch\tos-config——daemon 检活/spawn
// 在宿主 launch 臂；osconfig_state 快照 launch 期播种（unknown/ready/offline）。

widget App {
    msg { Nav(str),
          PickPosition(str), PickEnabled(str), DraftPinned(str), SavePinned,
          PickNotes(str),
          DraftWallpaper(str), SaveWallpaper,
          DraftWallpapersDir(str), SaveWallpapersDir,
          PickTheme(str), PickTransparency(str),
          OpenSystemSettings }

    model {
        var section str = "dock"   // dock | notes | appearance | system | about

        // 上行命令总线（宿主排空执行——set_* 驱动动词唯一出口）
        var __desktop_cmd str = ""

        // ---- 单源快照（宿主播种；缺省 = 宿主内置默认）----
        var cfg_dock_position str = "bottom"   // bottom | top
        var cfg_dock_enabled str = "1"         // 1 | 0
        var cfg_dock_pinned str = "011-calculator,013-todo,015-notes"
        var cfg_wallpaper str = ""             // "" | #hex | builtin: | 路径
        var cfg_wallpapers_dir str = ""
        var cfg_theme str = "dark"             // dark | light
        var cfg_transparency str = "off"       // off | low | high
        var cfg_notes_enabled str = "1"        // 1 | 0

        // ---- 输入草稿 ----
        var pinned_draft str = ""
        var pinned_saved str = "0"
        var wallpaper_draft str = ""
        var wallpaper_saved str = "0"
        var wallpapers_dir_draft str = ""

        // ---- 系统分区（501）：daemon 三态快照 + 关于常量（launch 播种）----
        var osconfig_state str = "unknown"     // unknown | ready | offline
        var osconfig_hint str = ""
        var about_host str = ""
        var about_version str = ""
    }

    view {
        col {
            style: "w-full h-full bg-background flex-col"

            // 标题行
            row {
                style: "items-center gap-2 px-5 py-3 bg-card border-b border-border"
                text "⚙️" { style: "text-lg" }
                text "设置" { style: "text-base font-semibold text-foreground" }
            }

            // 主体：左列分区导航 + 右列内容卡
            row {
                style: "flex-1 min-h-0"

                // 左列导航
                col {
                    style: "w-40 py-3 px-2 gap-1 bg-card border-r border-border"
                    if .section == "dock" {
                        button "Dock" {
                            style: "w-full h-9 px-3 text-sm text-left bg-primary/10 text-primary rounded-lg font-medium"
                        }
                    } else {
                        button "Dock" {
                            onclick: .Nav("dock")
                            style: "w-full h-9 px-3 text-sm text-left text-muted-foreground rounded-lg bg-transparent hover:bg-muted"
                        }
                    }
                    if .section == "notes" {
                        button "通知" {
                            style: "w-full h-9 px-3 text-sm text-left bg-primary/10 text-primary rounded-lg font-medium"
                        }
                    } else {
                        button "通知" {
                            onclick: .Nav("notes")
                            style: "w-full h-9 px-3 text-sm text-left text-muted-foreground rounded-lg bg-transparent hover:bg-muted"
                        }
                    }
                    if .section == "appearance" {
                        button "外观" {
                            style: "w-full h-9 px-3 text-sm text-left bg-primary/10 text-primary rounded-lg font-medium"
                        }
                    } else {
                        button "外观" {
                            onclick: .Nav("appearance")
                            style: "w-full h-9 px-3 text-sm text-left text-muted-foreground rounded-lg bg-transparent hover:bg-muted"
                        }
                    }
                    if .section == "system" {
                        button "系统" {
                            style: "w-full h-9 px-3 text-sm text-left bg-primary/10 text-primary rounded-lg font-medium"
                        }
                    } else {
                        button "系统" {
                            onclick: .Nav("system")
                            style: "w-full h-9 px-3 text-sm text-left text-muted-foreground rounded-lg bg-transparent hover:bg-muted"
                        }
                    }
                    if .section == "about" {
                        button "关于" {
                            style: "w-full h-9 px-3 text-sm text-left bg-primary/10 text-primary rounded-lg font-medium"
                        }
                    } else {
                        button "关于" {
                            onclick: .Nav("about")
                            style: "w-full h-9 px-3 text-sm text-left text-muted-foreground rounded-lg bg-transparent hover:bg-muted"
                        }
                    }
                }

                // 右列内容（滚动面）
                col {
                    style: "flex-1 p-4 gap-3 min-h-0"

                    if .section == "dock" {
                        // ---- Dock：位置 / 开关 / pinned 编辑 ----
                        col {
                            style: "gap-2 p-4 bg-card rounded-xl border border-border"
                            text "位置" { style: "text-sm font-medium text-foreground" }
                            row {
                                style: "gap-2"
                                if .cfg_dock_position == "bottom" {
                                    button "底部" {
                                        style: "h-8 px-4 text-xs bg-primary text-primary-foreground rounded-lg"
                                    }
                                } else {
                                    button "底部" {
                                        onclick: .PickPosition("bottom")
                                        style: "h-8 px-4 text-xs bg-muted text-muted-foreground rounded-lg"
                                    }
                                }
                                if .cfg_dock_position == "top" {
                                    button "顶部" {
                                        style: "h-8 px-4 text-xs bg-primary text-primary-foreground rounded-lg"
                                    }
                                } else {
                                    button "顶部" {
                                        onclick: .PickPosition("top")
                                        style: "h-8 px-4 text-xs bg-muted text-muted-foreground rounded-lg"
                                    }
                                }
                            }
                        }
                        col {
                            style: "gap-2 p-4 bg-card rounded-xl border border-border"
                            text "显示 Dock" { style: "text-sm font-medium text-foreground" }
                            row {
                                style: "gap-2"
                                if .cfg_dock_enabled == "1" {
                                    button "开" {
                                        style: "h-8 px-4 text-xs bg-primary text-primary-foreground rounded-lg"
                                    }
                                } else {
                                    button "开" {
                                        onclick: .PickEnabled("1")
                                        style: "h-8 px-4 text-xs bg-muted text-muted-foreground rounded-lg"
                                    }
                                }
                                if .cfg_dock_enabled == "0" {
                                    button "关" {
                                        style: "h-8 px-4 text-xs bg-primary text-primary-foreground rounded-lg"
                                    }
                                } else {
                                    button "关" {
                                        onclick: .PickEnabled("0")
                                        style: "h-8 px-4 text-xs bg-muted text-muted-foreground rounded-lg"
                                    }
                                }
                            }
                        }
                        col {
                            style: "gap-2 p-4 bg-card rounded-xl border border-border"
                            text "固定应用（逗号分隔 app id）" { style: "text-sm font-medium text-foreground" }
                            input {
                                value: .pinned_draft
                                oninput: .DraftPinned
                                placeholder: "011-calculator,013-todo,015-notes"
                                style: "flex-1 text-sm text-foreground bg-background rounded-lg border border-border px-2"
                            }
                            row {
                                style: "items-center gap-2"
                                button "保存并热同步" {
                                    onclick: .SavePinned
                                    style: "h-8 px-3 text-xs bg-primary text-primary-foreground rounded-lg"
                                }
                                text "空值 = 复位默认三枚；立即生效" { style: "text-xs text-muted-foreground" }
                            }
                            if .pinned_saved == "1" {
                                text "已保存" { style: "text-success text-xs" }
                            } else {
                                text "当前：" { style: "text-xs text-muted-foreground" }
                            }
                        }
                    } else {
                        if .section == "notes" {
                            // ---- 通知：持久化开关 ----
                            col {
                                style: "gap-2 p-4 bg-card rounded-xl border border-border"
                                text "通知中心" { style: "text-sm font-medium text-foreground" }
                                row {
                                    style: "gap-2"
                                    if .cfg_notes_enabled == "1" {
                                        button "开" {
                                            style: "h-8 px-4 text-xs bg-primary text-primary-foreground rounded-lg"
                                        }
                                    } else {
                                        button "开" {
                                            onclick: .PickNotes("1")
                                            style: "h-8 px-4 text-xs bg-muted text-muted-foreground rounded-lg"
                                        }
                                    }
                                    if .cfg_notes_enabled == "0" {
                                        button "关" {
                                            style: "h-8 px-4 text-xs bg-primary text-primary-foreground rounded-lg"
                                        }
                                    } else {
                                        button "关" {
                                            onclick: .PickNotes("0")
                                            style: "h-8 px-4 text-xs bg-muted text-muted-foreground rounded-lg"
                                        }
                                    }
                                }
                                text "关闭后 notify 全链路短路（入史/toast/未读）" { style: "text-xs text-muted-foreground" }
                            }
                        } else {
                            if .section == "appearance" {
                                // ---- 外观：壁纸 / 目录 / 主题 / 透明度 ----
                                col {
                                    style: "gap-2 p-4 bg-card rounded-xl border border-border"
                                    text "壁纸" { style: "text-sm font-medium text-foreground" }
                                    text "图片路径或 #hex 色值；内置宣纸/水墨可填 builtin:ricepaper / builtin:inkwash" { style: "text-xs text-muted-foreground" }
                                    row {
                                        style: "items-center gap-2"
                                        input {
                                            value: .wallpaper_draft
                                            oninput: .DraftWallpaper
                                            placeholder: "D:\\wallpaper.png 或 #243b55"
                                            style: "flex-1 text-sm text-foreground bg-background rounded-lg border border-border px-2"
                                        }
                                        button "保存" {
                                            onclick: .SaveWallpaper
                                            style: "h-8 px-3 text-xs bg-primary text-primary-foreground rounded-lg"
                                        }
                                    }
                                    if .wallpaper_saved == "1" {
                                        text "已保存，即时生效" { style: "text-success text-xs" }
                                    } else {
                                        row {
                                            style: "items-center gap-2"
                                            text "当前：" { style: "text-xs text-muted-foreground" }
                                            text .cfg_wallpaper { style: "text-xs text-foreground" }
                                        }
                                    }
                                    row {
                                        style: "items-center gap-2"
                                        input {
                                            value: .wallpapers_dir_draft
                                            oninput: .DraftWallpapersDir
                                            placeholder: "壁纸目录，如 D:\\wallpapers"
                                            style: "flex-1 text-sm text-foreground bg-background rounded-lg border border-border px-2"
                                        }
                                        button "保存目录" {
                                            onclick: .SaveWallpapersDir
                                            style: "h-8 px-3 text-xs bg-primary text-primary-foreground rounded-lg"
                                        }
                                    }
                                }
                                col {
                                    style: "gap-2 p-4 bg-card rounded-xl border border-border"
                                    text "主题" { style: "text-sm font-medium text-foreground" }
                                    row {
                                        style: "gap-2"
                                        if .cfg_theme == "dark" {
                                            button "深色" {
                                                style: "h-8 px-4 text-xs bg-primary text-primary-foreground rounded-lg"
                                            }
                                        } else {
                                            button "深色" {
                                                onclick: .PickTheme("dark")
                                                style: "h-8 px-4 text-xs bg-muted text-muted-foreground rounded-lg"
                                            }
                                        }
                                        if .cfg_theme == "light" {
                                            button "浅色" {
                                                style: "h-8 px-4 text-xs bg-primary text-primary-foreground rounded-lg"
                                            }
                                        } else {
                                            button "浅色" {
                                                onclick: .PickTheme("light")
                                                style: "h-8 px-4 text-xs bg-muted text-muted-foreground rounded-lg"
                                            }
                                        }
                                    }
                                }
                                col {
                                    style: "gap-2 p-4 bg-card rounded-xl border border-border"
                                    text "窗口透明度" { style: "text-sm font-medium text-foreground" }
                                    row {
                                        style: "gap-2"
                                        if .cfg_transparency == "off" {
                                            button "关" {
                                                style: "h-8 px-4 text-xs bg-primary text-primary-foreground rounded-lg"
                                            }
                                        } else {
                                            button "关" {
                                                onclick: .PickTransparency("off")
                                                style: "h-8 px-4 text-xs bg-muted text-muted-foreground rounded-lg"
                                            }
                                        }
                                        if .cfg_transparency == "low" {
                                            button "低" {
                                                style: "h-8 px-4 text-xs bg-primary text-primary-foreground rounded-lg"
                                            }
                                        } else {
                                            button "低" {
                                                onclick: .PickTransparency("low")
                                                style: "h-8 px-4 text-xs bg-muted text-muted-foreground rounded-lg"
                                            }
                                        }
                                        if .cfg_transparency == "high" {
                                            button "高" {
                                                style: "h-8 px-4 text-xs bg-primary text-primary-foreground rounded-lg"
                                            }
                                        } else {
                                            button "高" {
                                                onclick: .PickTransparency("high")
                                                style: "h-8 px-4 text-xs bg-muted text-muted-foreground rounded-lg"
                                            }
                                        }
                                    }
                                }
                            } else {
                                if .section == "system" {
                                    // ---- 系统：os-config 入口（501 衔接）----
                                    col {
                                        style: "gap-2 p-4 bg-card rounded-xl border border-border"
                                        text "系统设置（全部模块）" { style: "text-sm font-medium text-foreground" }
                                        if .osconfig_state == "ready" {
                                            text "auto-os-config daemon 已就绪" { style: "text-success text-xs" }
                                        } else {
                                            if .osconfig_state == "offline" {
                                                text "daemon 离线" { style: "text-destructive text-xs" }
                                                text .osconfig_hint { style: "text-xs text-muted-foreground" }
                                            } else {
                                                text "daemon 未检活（点击入口自动探测）" { style: "text-xs text-muted-foreground" }
                                            }
                                        }
                                        button "打开 auto-os-config 配置中心" {
                                            onclick: .OpenSystemSettings
                                            style: "h-9 px-4 text-xs bg-primary text-primary-foreground rounded-lg w-fit"
                                        }
                                        text "桌面配置已注册为 os-config 的 desktop 模块——通用编辑器与本页读写同一份 config.at" { style: "text-xs text-muted-foreground" }
                                    }
                                } else {
                                    // ---- 关于 ----
                                    col {
                                        style: "gap-2 p-4 bg-card rounded-xl border border-border"
                                        text "关于" { style: "text-sm font-medium text-foreground" }
                                        row {
                                            style: "items-center gap-2"
                                            text "宿主" { style: "text-xs text-muted-foreground" }
                                            text .about_host { style: "text-xs text-foreground" }
                                        }
                                        row {
                                            style: "items-center gap-2"
                                            text "版本" { style: "text-xs text-muted-foreground" }
                                            text .about_version { style: "text-xs text-foreground" }
                                        }
                                        row {
                                            style: "items-center gap-2"
                                            text "配置单源" { style: "text-xs text-muted-foreground" }
                                            text "~/.config/autoos/apps/desktop/config.at" { style: "text-xs text-foreground" }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .Nav(s) -> { .section = s }

        .PickPosition(v) -> {
            .cfg_dock_position = v
            .__desktop_cmd = "set_dock_position\t" + v
        }

        .PickEnabled(v) -> {
            .cfg_dock_enabled = v
            .__desktop_cmd = "set_dock_enabled\t" + v
        }

        .DraftPinned(v) -> {
            .pinned_draft = v
        }

        .SavePinned -> {
            .cfg_dock_pinned = .pinned_draft
            .__desktop_cmd = "set_dock_pinned\t" + .pinned_draft
            .pinned_saved = "1"
        }

        .PickNotes(v) -> {
            .cfg_notes_enabled = v
            .__desktop_cmd = "set_notes_enabled\t" + v
        }

        .DraftWallpaper(v) -> {
            .wallpaper_draft = v
        }

        .SaveWallpaper -> {
            if .wallpaper_draft != "" {
                .cfg_wallpaper = .wallpaper_draft
                .__desktop_cmd = "set_wallpaper\t" + .wallpaper_draft
                .wallpaper_draft = ""
                .wallpaper_saved = "1"
            }
        }

        .DraftWallpapersDir(v) -> {
            .wallpapers_dir_draft = v
        }

        .SaveWallpapersDir -> {
            if .wallpapers_dir_draft != "" {
                .cfg_wallpapers_dir = .wallpapers_dir_draft
                .__desktop_cmd = "set_wallpapers_dir\t" + .wallpapers_dir_draft
            }
        }

        .PickTheme(v) -> {
            .cfg_theme = v
            .__desktop_cmd = "set_theme\t" + v
        }

        .PickTransparency(v) -> {
            .cfg_transparency = v
            .__desktop_cmd = "set_transparency\t" + v
        }

        .OpenSystemSettings -> {
            .__desktop_cmd = "launch\tos-config"
        }
    }
}
