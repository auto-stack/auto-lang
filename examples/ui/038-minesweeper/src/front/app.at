use minesweeper_store: MinesweeperStore

widget App {
    msg Msg {
        Reveal(int, int),
        Flag(int, int),
        SetDifficulty(str),
        Reset,
        Tick,
        Init,
    }

    model {
        var interval int = 1000
        var mounted int = 0
    }

    view {
        center {
            col {
                // —— 信息栏 ——
                row {
                    col {
                        text .store.mines_label {
                            style: "text-2xl font-bold text-gray-800"
                        }
                        text "mines left" {
                            style: "text-xs text-gray-500 uppercase tracking-wide"
                        }
                        style: "items-center"
                    }
                    col {
                        text .store.timer_label {
                            style: "text-2xl font-bold font-mono text-gray-800"
                        }
                        text "time" {
                            style: "text-xs text-gray-500 uppercase tracking-wide"
                        }
                        style: "items-center"
                    }
                    button "🔄" {
                        onclick: .Reset,
                        style: "text-3xl px-4 py-2 rounded-xl hover:bg-gray-100"
                    }
                    style: "w-full items-center justify-between"
                }

                // —— 难度选择(class 从 store 预存字段读取,VM 视图不能调函数) ——
                row {
                    button "初级 9×9" {
                        onclick: .SetDifficulty("beginner"),
                        class: .store.beginner_class
                    }
                    button "中级 16×16" {
                        onclick: .SetDifficulty("intermediate"),
                        class: .store.intermediate_class
                    }
                    button "高级 30×16" {
                        onclick: .SetDifficulty("expert"),
                        class: .store.expert_class
                    }
                    style: "gap-2 mt-4"
                }

                // —— 棋盘网格 ——
                // 用条件 grid(每档固定字面量 cols),因为两个后端都不支持动态 cols:
                //   vue codegen 的 cols 只接受字面量(→ grid-cols-N Tailwind class)
                //   VM 的 extract_u16 也只接受字面量(→ View::Grid{cols})
                // 且 VM 原生渲染器不解析 CSS grid-template-columns,必须用 grid 元素。
                div {
                    if .store.difficulty == "beginner" {
                        grid {
                            for cell in .store.board {
                                button {
                                    text cell.display {
                                        style: cell.number_class
                                    }
                                    onclick: .Reveal(cell.x, cell.y),
                                    oncontextmenu.prevent: .Flag(cell.x, cell.y),
                                    class: cell.cell_class
                                }
                            }
                            cols: 9
                            gap: 0
                        }
                    }
                    if .store.difficulty == "intermediate" {
                        grid {
                            for cell in .store.board {
                                button {
                                    text cell.display {
                                        style: cell.number_class
                                    }
                                    onclick: .Reveal(cell.x, cell.y),
                                    oncontextmenu.prevent: .Flag(cell.x, cell.y),
                                    class: cell.cell_class
                                }
                            }
                            cols: 16
                            gap: 0
                        }
                    }
                    if .store.difficulty == "expert" {
                        grid {
                            for cell in .store.board {
                                button {
                                    text cell.display {
                                        style: cell.number_class
                                    }
                                    onclick: .Reveal(cell.x, cell.y),
                                    oncontextmenu.prevent: .Flag(cell.x, cell.y),
                                    class: cell.cell_class
                                }
                            }
                            cols: 30
                            gap: 0
                        }
                    }
                    style: "overflow-x-auto w-full mt-6"
                }

                // —— 游戏结束遮罩 ——
                if .store.game_state == "won" {
                    text "🎉 胜利!" {
                        style: "text-3xl font-bold text-green-600 mt-6"
                    }
                }
                if .store.game_state == "lost" {
                    text "💥 踩雷了!点 🔄 重开" {
                        style: "text-2xl font-bold text-red-600 mt-6"
                    }
                }

                style: "w-full max-w-fit p-6 bg-white rounded-2xl shadow-lg items-center mt-8"
            }
        }
    }

    on {
        .Init -> {
            store.Init()
        }

        .Reset -> {
            store.Reset()
        }

        .SetDifficulty(d) -> {
            store.SetDifficulty(d)
        }

        .Reveal(x, y) -> {
            store.Reveal(x, y)
        }

        .Flag(x, y) -> {
            store.Flag(x, y)
        }

        .Tick -> {
            store.Tick()
        }
    }
}
