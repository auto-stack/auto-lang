use minesweeper_store: MinesweeperStore

widget App {
    msg {
        Reveal(int, int),
        Flag(int, int),
        SetDifficulty(str),
        Reset,
        Tick,
        Init,
    }

    model {
        var interval int = 1000
        var mounted int = 0
    }

    // Plan 506: 外壳改"内容即页面"（无 center 包裹，循 011 样板），配合
    // pac `window: "fit"` 窗口随内容收缩（棋盘尺寸随难度档变化，fit 窗
    // 在 launch 时按当帧内容收缩）。
    view {
        col {
                // —— 信息栏 ——
                row {
                    col {
                        text .store.mines_label {
                            style: "text-2xl font-bold text-gray-800"
                        }
                        text "mines left" {
                            style: "text-xs text-gray-500 uppercase tracking-wide"
                        }
                        style: "items-center"
                    }
                    col {
                        text .store.timer_label {
                            style: "text-2xl font-bold font-mono text-gray-800"
                        }
                        text "time" {
                            style: "text-xs text-gray-500 uppercase tracking-wide"
                        }
                        style: "items-center"
                    }
                    button "🔄" {
                        onclick: .Reset,
                        style: "text-3xl px-4 py-2 rounded-xl hover:bg-gray-100"
                    }
                    style: "items-center justify-between"
                }

                // —— 难度选择 ——
                row {
                    button "初级 9×9" {
                        onclick: .SetDifficulty("beginner"),
                        class: .store.beginner_class
                    }
                    button "中级 16×16" {
                        onclick: .SetDifficulty("intermediate"),
                        class: .store.intermediate_class
                    }
                    button "高级 30×16" {
                        onclick: .SetDifficulty("expert"),
                        class: .store.expert_class
                    }
                    style: "gap-2"
                }

                // —— 棋盘网格 ——
                // Plan 448 I: cols 接受动态表达式(store.cols 随难度档 9/16/30),
                // 单块替换原先三份固定字面量条件块。vue 侧发内联
                // grid-template-columns repeat 样式(动态 Tailwind 类名不被
                // JIT 收录);VM 侧重建期求值(→ View::Grid{cols})。
                div {
                    grid {
                        for cell in .store.board {
                            button {
                                text cell.display {
                                    style: cell.number_class
                                }
                                onclick: .Reveal(cell.x, cell.y),
                                oncontextmenu.prevent: .Flag(cell.x, cell.y),
                                class: cell.cell_class
                            }
                        }
                        cols: .store.cols
                        gap: 0
                    }
                    style: "items-center"
                }

                // —— 游戏结束遮罩 ——
                if .store.game_state == "won" {
                    text "🎉 胜利!" {
                        style: "text-3xl font-bold text-green-600 mt-6"
                    }
                }
                if .store.game_state == "lost" {
                    text "💥 踩雷了!点 🔄 重开" {
                        style: "text-2xl font-bold text-red-600 mt-6"
                    }
                }

            style: "max-w-fit p-4 items-center gap-4"
        }
    }

    on {
        .Init -> {
            store.Init()
        }

        .Reset -> {
            store.Reset()
        }

        .SetDifficulty(d) -> {
            store.SetDifficulty(d)
        }

        .Reveal(x, y) -> {
            store.Reveal(x, y)
        }

        .Flag(x, y) -> {
            store.Flag(x, y)
        }

        .Tick -> {
            store.Tick()
        }
    }
}
