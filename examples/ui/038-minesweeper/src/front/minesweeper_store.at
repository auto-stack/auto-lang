// minesweeper_store.at — pure-Autolang minesweeper game logic as a store.
//
// All game logic lives here as store actions (no escape-hatch, no .ts), so the
// same source compiles under BOTH backends: vue (codegen translates actions
// into the store composable) and vm (the interpreter runs actions directly).
// See Plan 402 §12 for the dual-backend rationale.
//
// Cell representation: Obj literals, NOT a `type` record. Each cell carries
// precomputed `number_class` / `cell_class` view strings (and a `display`
// label string) because the VM view-builder cannot call functions (Plan 402
// §12.2 constraint 2) and its extract_children_text ignores Conditional
// nodes: every style/label the view needs is a field read, not a function
// call or inline `if` branch.

store MinesweeperStore {
    model {
        var board = []
        var rows int = 9
        var cols int = 9
        var mine_count int = 10
        var difficulty str = "beginner"
        var game_state str = "ready"
        var elapsed int = 0
        var flags_placed int = 0
        var face_icon str = "🙂"
        // Precomputed view strings (VM view bindings cannot call functions).
        var mines_label str = "💣 10"
        var timer_label str = "⏱ 0s"
        var beginner_class str = ""
        var intermediate_class str = ""
        var expert_class str = ""
    }

    msg {
        Reveal(int, int),
        Flag(int, int),
        SetDifficulty(str),
        Reset,
        Tick,
        Init,
    }

    on {
        // Build a fresh all-empty board for the current difficulty and reset
        // all per-game state. Called on first load and on every reset/difficulty
        // switch. Mines are NOT placed here — that happens on the first click
        // (first-click-safe, see .Reveal).
        .Init -> {
            // Difficulty -> dimensions (inline; no helper fn for vue codegen).
            var r int = 9
            var c int = 9
            var m int = 10
            if .difficulty == "intermediate" {
                r = 16
                c = 16
                m = 40
            }
            if .difficulty == "expert" {
                r = 16
                c = 30
                m = 99
            }
            .rows = r
            .cols = c
            .mine_count = m
            .game_state = "ready"
            .elapsed = 0
            .flags_placed = 0
            .face_icon = "🙂"
            .board = []
            var x int = 0
            for x < .rows {
                var y int = 0
                for y < .cols {
                    .board.push({ x: x, y: y, mine: false, revealed: false, flagged: false, adjacent: 0, number_class: "", cell_class: "w-8 h-8 flex items-center justify-center select-none bg-zinc-700 hover:bg-zinc-600 active:bg-zinc-800 border border-zinc-600 rounded-none text-zinc-100", display: "　" })
                    y = y + 1
                }
                x = x + 1
            }
            .mines_label = "💣 " + .mine_count.to_string()
            .timer_label = "⏱ 0s"
            .beginner_class = "px-3 py-1.5 rounded-lg text-xs font-medium text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800"
            .intermediate_class = "px-3 py-1.5 rounded-lg text-xs font-medium text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800"
            .expert_class = "px-3 py-1.5 rounded-lg text-xs font-medium text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800"
            if .difficulty == "beginner" {
                .beginner_class = "px-3 py-1.5 rounded-lg text-xs font-medium bg-zinc-700 text-white shadow-sm border border-zinc-600/50"
            }
            if .difficulty == "intermediate" {
                .intermediate_class = "px-3 py-1.5 rounded-lg text-xs font-medium bg-zinc-700 text-white shadow-sm border border-zinc-600/50"
            }
            if .difficulty == "expert" {
                .expert_class = "px-3 py-1.5 rounded-lg text-xs font-medium bg-zinc-700 text-white shadow-sm border border-zinc-600/50"
            }
        }

        .Reset -> {
            store.Init()
        }

        .SetDifficulty(d) -> {
            .difficulty = d
            store.Init()
        }

        .Reveal(x, y) -> {
            // Ignore clicks once the game is over.
            if .game_state == "won" {
                return
            }
            if .game_state == "lost" {
                return
            }

            // First click: lay out mines, avoiding the 3x3 zone around (x, y),
            // then compute adjacency counts. Done in-place on .board.
            if .game_state == "ready" {
                var placed int = 0
                var attempts int = 0
                var max_attempts int = .mine_count * 50 + 100
                for placed < .mine_count {
                    if attempts >= max_attempts {
                        break
                    }
                    attempts = attempts + 1
                    // 确定性伪随机(LCG):用小常数避免 i32 溢出。
                    // VM 的 math.random() 有模块占位符 bug,用 LCG 替代。
                    var seed int = (attempts * 31 + 17) % 997
                    if seed < 0 {
                        seed = seed + 997
                    }
                    var rr int = seed % (.rows * .cols)
                    var rx int = rr / .cols
                    var ry int = rr % .cols
                    // Skip the 3x3 safe zone around the first click (x, y).
                    var dx int = rx - x
                    var dy int = ry - y
                    if dx < -1 || dx > 1 || dy < -1 || dy > 1 {
                        // Outside the safe zone — place a mine here if free.
                        var idx int = rx * .cols + ry
                        if .board[idx].mine == false {
                            var old = .board[idx]
                            .board[idx] = { x: old.x, y: old.y, mine: true, revealed: old.revealed, flagged: old.flagged, adjacent: old.adjacent, number_class: old.number_class, cell_class: old.cell_class, display: old.display }
                            placed = placed + 1
                        }
                    }
                }
                // Adjacency counts for every non-mine cell.
                var j int = 0
                for j < .board.len() {
                    if .board[j].mine == false {
                        var cnt int = 0
                        var ddx int = -1
                        for ddx <= 1 {
                            var ddy int = -1
                            for ddy <= 1 {
                                if ddx != 0 || ddy != 0 {
                                    var nx int = .board[j].x + ddx
                                    var ny int = .board[j].y + ddy
                                    if nx >= 0 && nx < .rows && ny >= 0 && ny < .cols {
                                        if .board[nx * .cols + ny].mine {
                                            cnt = cnt + 1
                                        }
                                    }
                                }
                                ddy = ddy + 1
                            }
                            ddx = ddx + 1
                        }
                        var cj = .board[j]
                        .board[j] = { x: cj.x, y: cj.y, mine: cj.mine, revealed: cj.revealed, flagged: cj.flagged, adjacent: cnt, number_class: cj.number_class, cell_class: cj.cell_class, display: "　" }
                    }
                    j = j + 1
                }
                .game_state = "playing"
            }

            // Look up the clicked cell; ignore flagged.
            var tidx int = x * .cols + y
            var target = .board[tidx]
            if target.flagged {
                return
            }

            // Chord: if clicking an already-revealed numbered cell, and flag count matches adjacent count,
            // automatically reveal surrounding unflagged unrevealed cells!
            if target.revealed {
                if target.adjacent > 0 {
                    var flag_count int = 0
                    var cdx int = -1
                    for cdx <= 1 {
                        var cdy int = -1
                        for cdy <= 1 {
                            if cdx != 0 || cdy != 0 {
                                var cnx int = x + cdx
                                var cny int = y + cdy
                                if cnx >= 0 && cnx < .rows && cny >= 0 && cny < .cols {
                                    if .board[cnx * .cols + cny].flagged {
                                        flag_count = flag_count + 1
                                    }
                                }
                            }
                            cdy = cdy + 1
                        }
                        cdx = cdx + 1
                    }
                    if flag_count == target.adjacent {
                        var hit_mine bool = false
                        var ndx int = -1
                        for ndx <= 1 {
                            var ndy int = -1
                            for ndy <= 1 {
                                if ndx != 0 || ndy != 0 {
                                    var nnx int = x + ndx
                                    var nny int = y + ndy
                                    if nnx >= 0 && nnx < .rows && nny >= 0 && nny < .cols {
                                        var nidx int = nnx * .cols + nny
                                        var nc = .board[nidx]
                                        if nc.revealed == false && nc.flagged == false {
                                            if nc.mine {
                                                hit_mine = true
                                            }
                                        }
                                    }
                                }
                                ndy = ndy + 1
                            }
                            ndx = ndx + 1
                        }
                        if hit_mine {
                            var k int = 0
                            for k < .board.len() {
                                if .board[k].mine {
                                    var ck = .board[k]
                                    var c_class str = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800 rounded-none text-base"
                                    if ck.x == x && ck.y == y {
                                        c_class = "w-8 h-8 flex items-center justify-center select-none bg-rose-950 border-2 border-rose-500 rounded-none text-base"
                                    }
                                    .board[k] = { x: ck.x, y: ck.y, mine: true, revealed: true, flagged: ck.flagged, adjacent: ck.adjacent, number_class: "color:#fff;font-weight:700", cell_class: c_class, display: "💣" }
                                }
                                k = k + 1
                            }
                            .game_state = "lost"
                            .face_icon = "😵"
                            return
                        }
                        var stack = []
                        var rdx int = -1
                        for rdx <= 1 {
                            var rdy int = -1
                            for rdy <= 1 {
                                if rdx != 0 || rdy != 0 {
                                    var rnx int = x + rdx
                                    var rny int = y + rdy
                                    if rnx >= 0 && rnx < .rows && rny >= 0 && rny < .cols {
                                        var ridx int = rnx * .cols + rny
                                        var rc = .board[ridx]
                                        if rc.revealed == false && rc.flagged == false {
                                            stack.push(rnx)
                                            stack.push(rny)
                                        }
                                    }
                                }
                                rdy = rdy + 1
                            }
                            rdx = rdx + 1
                        }
                        for stack.len() > 0 {
                            var cy int = stack.pop()
                            var cx int = stack.pop()
                            if cx >= 0 && cx < .rows && cy >= 0 && cy < .cols {
                                var fidx int = cx * .cols + cy
                                var fc = .board[fidx]
                                if fc.revealed == false && fc.flagged == false {
                                    var nclass str = "color:#60a5fa;font-weight:700;font-size:1.125rem"
                                    var cclass str = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800/80 rounded-none font-bold text-base"
                                    if fc.adjacent == 1 {
                                        nclass = "color:#60a5fa;font-weight:700;font-size:1.125rem"
                                        cclass = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800/80 rounded-none text-blue-400 font-bold text-base"
                                    }
                                    if fc.adjacent == 2 {
                                        nclass = "color:#34d399;font-weight:700;font-size:1.125rem"
                                        cclass = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800/80 rounded-none text-emerald-400 font-bold text-base"
                                    }
                                    if fc.adjacent == 3 {
                                        nclass = "color:#f87171;font-weight:700;font-size:1.125rem"
                                        cclass = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800/80 rounded-none text-rose-400 font-bold text-base"
                                    }
                                    if fc.adjacent == 4 {
                                        nclass = "color:#c084fc;font-weight:700;font-size:1.125rem"
                                        cclass = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800/80 rounded-none text-purple-400 font-bold text-base"
                                    }
                                    if fc.adjacent == 5 {
                                        nclass = "color:#fbbf24;font-weight:700;font-size:1.125rem"
                                        cclass = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800/80 rounded-none text-amber-400 font-bold text-base"
                                    }
                                    if fc.adjacent == 6 {
                                        nclass = "color:#22d3ee;font-weight:700;font-size:1.125rem"
                                        cclass = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800/80 rounded-none text-cyan-400 font-bold text-base"
                                    }
                                    if fc.adjacent == 7 {
                                        nclass = "color:#e4e4e7;font-weight:700;font-size:1.125rem"
                                        cclass = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800/80 rounded-none text-zinc-200 font-bold text-base"
                                    }
                                    if fc.adjacent >= 8 {
                                        nclass = "color:#f472b6;font-weight:700;font-size:1.125rem"
                                        cclass = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800/80 rounded-none text-pink-400 font-bold text-base"
                                    }
                                    var dpy str = " "
                                    if fc.adjacent > 0 {
                                        dpy = fc.adjacent.to_string()
                                    }
                                    .board[fidx] = { x: fc.x, y: fc.y, mine: fc.mine, revealed: true, flagged: fc.flagged, adjacent: fc.adjacent, number_class: nclass, cell_class: cclass, display: dpy }
                                    if fc.adjacent == 0 {
                                        var ex int = -1
                                        for ex <= 1 {
                                            var ey int = -1
                                            for ey <= 1 {
                                                if ex != 0 || ey != 0 {
                                                    stack.push(cx + ex)
                                                    stack.push(cy + ey)
                                                }
                                                ey = ey + 1
                                            }
                                            ex = ex + 1
                                        }
                                    }
                                }
                            }
                        }
                        var won bool = true
                        var w int = 0
                        for w < .board.len() {
                            if .board[w].mine == false {
                                if .board[w].revealed == false {
                                    won = false
                                }
                            }
                            w = w + 1
                        }
                        if won {
                            .game_state = "won"
                            .face_icon = "😎"
                        }
                    }
                }
                return
            }

            // Stepped on a mine: reveal every mine, game over.
            if target.mine {
                var k int = 0
                for k < .board.len() {
                    if .board[k].mine {
                        var ck = .board[k]
                        var c_class str = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800 rounded-none text-base"
                        if ck.x == x && ck.y == y {
                            c_class = "w-8 h-8 flex items-center justify-center select-none bg-rose-950 border-2 border-rose-500 rounded-none text-base"
                        }
                        .board[k] = { x: ck.x, y: ck.y, mine: true, revealed: true, flagged: ck.flagged, adjacent: ck.adjacent, number_class: "color:#fff;font-weight:700", cell_class: c_class, display: "💣" }
                    }
                    k = k + 1
                }
                .game_state = "lost"
                .face_icon = "😵"
                return
            }

            // Flood-fill reveal from (x, y) with an explicit stack (no recursion).
            var stack = []
            stack.push(x)
            stack.push(y)
            for stack.len() > 0 {
                var cy int = stack.pop()
                var cx int = stack.pop()
                if cx >= 0 && cx < .rows && cy >= 0 && cy < .cols {
                    var fidx int = cx * .cols + cy
                    var fc = .board[fidx]
                    if fc.revealed == false && fc.flagged == false {
                        // Reveal it with its number color class.
                        var nclass str = "color:#60a5fa;font-weight:700;font-size:1.125rem"
                        var cclass str = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800/80 rounded-none font-bold text-base"
                        if fc.adjacent == 1 {
                            nclass = "color:#60a5fa;font-weight:700;font-size:1.125rem"
                            cclass = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800/80 rounded-none text-blue-400 font-bold text-base"
                        }
                        if fc.adjacent == 2 {
                            nclass = "color:#34d399;font-weight:700;font-size:1.125rem"
                            cclass = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800/80 rounded-none text-emerald-400 font-bold text-base"
                        }
                        if fc.adjacent == 3 {
                            nclass = "color:#f87171;font-weight:700;font-size:1.125rem"
                            cclass = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800/80 rounded-none text-rose-400 font-bold text-base"
                        }
                        if fc.adjacent == 4 {
                            nclass = "color:#c084fc;font-weight:700;font-size:1.125rem"
                            cclass = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800/80 rounded-none text-purple-400 font-bold text-base"
                        }
                        if fc.adjacent == 5 {
                            nclass = "color:#fbbf24;font-weight:700;font-size:1.125rem"
                            cclass = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800/80 rounded-none text-amber-400 font-bold text-base"
                        }
                        if fc.adjacent == 6 {
                            nclass = "color:#22d3ee;font-weight:700;font-size:1.125rem"
                            cclass = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800/80 rounded-none text-cyan-400 font-bold text-base"
                        }
                        if fc.adjacent == 7 {
                            nclass = "color:#e4e4e7;font-weight:700;font-size:1.125rem"
                            cclass = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800/80 rounded-none text-zinc-200 font-bold text-base"
                        }
                        if fc.adjacent >= 8 {
                            nclass = "color:#f472b6;font-weight:700;font-size:1.125rem"
                            cclass = "w-8 h-8 flex items-center justify-center select-none bg-zinc-900 border border-zinc-800/80 rounded-none text-pink-400 font-bold text-base"
                        }
                        var dpy str = " "
                        if fc.adjacent > 0 {
                            dpy = fc.adjacent.to_string()
                        }
                        .board[fidx] = { x: fc.x, y: fc.y, mine: fc.mine, revealed: true, flagged: fc.flagged, adjacent: fc.adjacent, number_class: nclass, cell_class: cclass, display: dpy }
                        // Empty cell: push 8 neighbors to keep flooding.
                        if fc.adjacent == 0 {
                            var ex int = -1
                            for ex <= 1 {
                                var ey int = -1
                                for ey <= 1 {
                                    if ex != 0 || ey != 0 {
                                        stack.push(cx + ex)
                                        stack.push(cy + ey)
                                    }
                                    ey = ey + 1
                                }
                                ex = ex + 1
                            }
                        }
                    }
                }
            }

            // Win check: every non-mine cell revealed.
            var won bool = true
            var w int = 0
            for w < .board.len() {
                if .board[w].mine == false {
                    if .board[w].revealed == false {
                        won = false
                    }
                }
                w = w + 1
            }
            if won {
                .game_state = "won"
                .face_icon = "😎"
            }
        }

        .Flag(x, y) -> {
            if .game_state == "won" {
                return
            }
            if .game_state == "lost" {
                return
            }
            var fidx int = x * .cols + y
            var fc = .board[fidx]
            if fc.revealed == false {
                var new_flag bool = fc.flagged == false
                var new_dpy str = "　"
                var new_class str = "w-8 h-8 flex items-center justify-center select-none bg-zinc-700 hover:bg-zinc-600 active:bg-zinc-800 border border-zinc-600 rounded-none text-zinc-100"
                if new_flag {
                    new_dpy = "🚩"
                    new_class = "w-8 h-8 flex items-center justify-center select-none bg-zinc-700 hover:bg-zinc-600 active:bg-zinc-800 border border-zinc-600 rounded-none text-rose-400 text-base"
                }
                .board[fidx] = { x: fc.x, y: fc.y, mine: fc.mine, revealed: fc.revealed, flagged: new_flag, adjacent: fc.adjacent, number_class: fc.number_class, cell_class: new_class, display: new_dpy }
                if new_flag {
                    .flags_placed = .flags_placed + 1
                } else {
                    .flags_placed = .flags_placed - 1
                }
                .mines_label = "💣 " + (.mine_count - .flags_placed).to_string()
            }
        }

        .Tick -> {
            if .game_state == "playing" {
                .elapsed = .elapsed + 1
                .timer_label = "⏱ " + .elapsed.to_string() + "s"
            }
        }
    }
}
