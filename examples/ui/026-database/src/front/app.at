// front/app.at — Database Studio SQLite 可视化客户端（Plan 439 M1-M3·App 轨道填洞 ③）
//
// 数据库对象树导航 + DataTable 深水区（分页/排序/搜索/类型徽章/万行窗口化）
// + 表结构（Schema/DDL）+ SQL 控制台（执行/耗时/错误反馈）+ 事务级编辑与提交。

widget App {
    msg {
        Init,
        SelectTab(str),
        SelectTable(str),
        SelectView(str),
        SelectIndex(str),
        NextPage,
        PrevPage,
        FirstPage,
        LastPage,
        SetPageSize10,
        SetPageSize25,
        SetPageSize50,
        SortCol(str),
        SearchChanged(str),
        TreeFilterChanged(str),
        SetSql(str),
        RunSql,
        ClearSql,
        PresetSqlCustomers,
        PresetSqlProducts,
        PresetSqlOrders,
        PresetSqlError,
        ToggleNewRowModal,
        InputNameChanged(str),
        InputContactChanged(str),
        InputCityChanged(str),
        InputCountryChanged(str),
        SaveNewRow,
        DeleteRow(int),
        CommitTx,
        RollbackTx,
        ResetDb
    }

    model {
        // ---- 视图与导航状态 ----
        activeTab str = "data"          // "data" | "schema" | "console"
        activeTable str = "customers"   // 当前选中的表名
        activeType str = "table"        // "table" | "view" | "index"
        treeFilter str = ""             // 对象树过滤文本

        // ---- 分页与排序状态 ----
        page int = 1
        pageSize int = 10
        totalPages int = 1
        totalRows int = 91
        filteredCount int = 91
        showingText str = "Showing 1 - 10 of 91 rows"
        searchKw str = ""
        sortCol str = "id"
        sortDir str = "asc"

        // 列头排序指示
        hId str = "ID ↑"
        hCol1 str = "Company Name"
        hCol2 str = "Contact Name"
        hCol3 str = "City"
        hCol4 str = "Country"
        hCol5 str = "Phone"

        // ---- 表结构与 DDL 元数据 ----
        schemaColumns = []
        schemaIndexes = []
        schemaDdl str = ""
        tableStatsText str = "Table: customers · 6 Columns · 91 Records · ~14 KB"

        // ---- 活跃展示的数据切片 ----
        activeRows = []

        // ---- 事务与脏数据状态 ----
        dirtyCount int = 0
        showNewRowModal bool = false
        newName str = ""
        newContact str = ""
        newCity str = ""
        newCountry str = ""
        txStatusMsg str = ""

        // ---- SQL 控制台状态 ----
        sqlInput str = "SELECT * FROM customers LIMIT 20;"
        sqlStatus str = "idle"          // "idle" | "success" | "error"
        sqlDurationMs int = 0
        sqlErrorMsg str = ""
        sqlResultCount int = 0
        sqlResultCols = []
        sqlResultRows = []

        // ---- 原始数据库表数据 ----
        customers = [
