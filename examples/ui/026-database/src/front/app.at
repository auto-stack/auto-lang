            { id: 1007, col1: "2026-09-02 10:25:30", col2: "SCHEMA_INSPECT", col3: "analyst", col4: "192.168.1.110", col5: "200 OK" },
            { id: 1008, col1: "2026-09-02 10:28:44", col2: "EXPLAIN_QUERY", col3: "analyst", col4: "192.168.1.110", col5: "200 OK" },
            { id: 1009, col1: "2026-09-02 10:30:12", col2: "BACKUP_START", col3: "cron", col4: "127.0.0.1", col5: "200 OK" },
