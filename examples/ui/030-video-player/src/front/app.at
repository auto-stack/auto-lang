// app.at — 030-video-player AutoOS 原生视频播放器（Plan 542）
//
// 系统级原生视频播放器（对标 VLC / PotPlayer / IINA / MPC-HC）。
// 沉浸式大视口画布播放 + 自动隐匿 OSD 专业播控条 + 交互式进度寻道 +
// 多档倍速 + 音量调节与静音 + 画幅切换 + 可折叠播放队列抽屉 + 媒体属性弹窗。
//
// 双端契约：
// - dark_mode bool = true
// - accent_color str = "indigo"
// - 模板内零方法调用，文案与字段由 handler 预拼准备

// PLAN-607 declarative style recipes. PLAN-617 §2.2: flat / hairline / three
// control sizes only (icon 28px, transport 36px, text 36px). Semantic tokens
// only — no gradients, no glass, no shadows (all VM-unsupported, see
// docs/style-coverage.md). The ONE primary button per view is the transport
// play/pause key; everything else is the unspecified (UA-equivalent) variant.
style icon_btn = "h-7 w-7 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground cursor-pointer"
style seg_btn  = "h-7 px-2 items-center justify-center rounded text-xs font-mono text-muted-foreground hover:bg-muted hover:text-foreground cursor-pointer"
style ctl_btn  = "w-9 h-9 items-center justify-center rounded-md bg-muted border border-border text-foreground hover:bg-muted/70 cursor-pointer"
style tab_btn  = "h-9 px-3 items-center justify-center rounded-md text-xs font-medium text-muted-foreground hover:bg-muted hover:text-foreground cursor-pointer"

widget App {
    msg {
        Init,
        TogglePlay,
        StepForward,
        StepBackward,
        NextVideo,
        PrevVideo,
        StopPlayback,
        SeekPercent(int),
        VolUp,
        VolDown,
        SetVolume(int),
        ToggleMute,
        CycleSpeed,
        SetSpeed(str),
        ToggleSpeedMenu,
        TogglePlaylist,
        ToggleControls,
        ToggleFullscreen,
        ToggleAspect,
        CycleLoopMode,
        ToggleTimeMode,
        SelectVideo(int),
        ToggleInfoModal,
        DismissToast,
        OpenLocalDemo,
        ToggleDarkMode,
        SetAccent(str)
    }

    model {
        // ---- 主题契约 ----
        var dark_mode bool = true
        var accent_color str = "indigo"

        // ---- 强调色列表 ----
        var accents = [
            { name: "indigo", dot: "text-indigo-500", bg: "bg-indigo-500" },
            { name: "coral",  dot: "text-rose-500",   bg: "bg-rose-500" },
            { name: "ocean",  dot: "text-sky-500",    bg: "bg-sky-500" },
            { name: "sage",   dot: "text-emerald-500",bg: "bg-emerald-500" },
            { name: "amber",  dot: "text-amber-500",  bg: "bg-amber-500" }
        ]

        // ---- 播放状态 ----
        var is_playing bool = true
        var current_id int = 1
        var current_title str = "AutoOS 2026 Keynote & Intro"
        var current_file str = "01_intro.mp4"
        var current_video_url str = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4"
        var current_res str = "1080P"
        var current_codec str = "H.264"
        var current_size str = "48 MB"
        var current_fps str = "60.00 FPS"
        var current_bitrate str = "4.2 Mbps"
        var current_audio str = "AAC Stereo 48kHz"

        var current_time_sec int = 45
        var total_time_sec int = 225
        var current_time_str str = "00:45"
        var total_time_str str = "03:45"
        var time_display_fmt str = "00:45 / 03:45"
        var progress_pct int = 20

        var volume int = 80
        var volume_label str = "80%"
        var is_muted bool = false
        var playback_speed str = "1.0x"
        var aspect_mode str = "16:9"
        var loop_mode str = "list"
        var loop_label str = "列表循环"
        var time_mode str = "elapsed" // "elapsed" | "remaining"

        // ---- 界面与交互状态 ----
        var show_playlist bool = true
        var show_controls bool = true
        var show_speed_menu bool = false
        var show_info_modal bool = false
        var is_fullscreen bool = false

        // ---- 操作反馈 Toast ----
        var toast_msg str = "准备就绪"
        var show_toast bool = true

        // ---- 播放列表 (5 项种子视频) ----
        var playlist = [
            {
                id: 1,
                title: "AutoOS 2026 Keynote & Intro",
                file_name: "01_intro.mp4",
                duration_str: "03:45",
                duration_sec: 225,
                resolution: "1080P",
                codec: "H.264",
                size_str: "48 MB",
                badge_color: "bg-indigo-500/20 text-indigo-400 border-indigo-500/30",
                video_url: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4"
            },
            {
                id: 2,
                title: "Kernel & AutoVM Architecture",
                file_name: "02_architecture.mkv",
                duration_str: "12:20",
                duration_sec: 740,
                resolution: "4K",
                codec: "HEVC",
                size_str: "210 MB",
                badge_color: "bg-blue-500/20 text-blue-400 border-blue-500/30",
                video_url: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4"
            },
            {
                id: 3,
                title: "AutoUI Dual-Backend Engine Demo",
                file_name: "03_ui_engine.mp4",
                duration_str: "08:15",
                duration_sec: 495,
                resolution: "1080P",
                codec: "AV1",
                size_str: "85 MB",
                badge_color: "bg-emerald-500/20 text-emerald-400 border-emerald-500/30",
                video_url: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4"
            },
            {
                id: 4,
                title: "Fullstack Parity & Toolchain",
                file_name: "04_workflow.webm",
                duration_str: "05:30",
                duration_sec: 330,
                resolution: "1080P",
                codec: "VP9",
                size_str: "62 MB",
                badge_color: "bg-amber-500/20 text-amber-400 border-amber-500/30",
                video_url: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4"
            },
            {
                id: 5,
                title: "AutoOS Ambient Desktop Visuals",
                file_name: "05_ambient.mp4",
                duration_str: "01:30",
                duration_sec: 90,
                resolution: "720P",
                codec: "H.264",
                size_str: "24 MB",
                badge_color: "bg-rose-500/20 text-rose-400 border-rose-500/30",
                video_url: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerFun.mp4"
            }
        ]
    }

    view {
        col {
            style: if .dark_mode {
                "min-h-screen w-full bg-zinc-950 text-zinc-100 flex flex-col select-none font-sans"
            } else {
                "min-h-screen w-full bg-slate-100 text-slate-900 flex flex-col select-none font-sans"
            }

            // ══════════════════════════════════════════════════════════════════════
            // 1. 顶栏 (Top Bar) — 扁平发丝线，h-12
            // ══════════════════════════════════════════════════════════════════════
            row {
                style: "h-12 shrink-0 items-center gap-3 px-4 border-b border-border bg-card"

                row {
                    style: "items-center gap-2"
                    icon (name: "monitor", size: 18, style: "text-primary")
                    text "Video Player" { style: "text-sm font-semibold tracking-tight" }
                }

                text .current_file {
                    style: "text-xs text-muted-foreground font-mono truncate max-w-xs hidden md:flex"
                }

                col { style: "flex-1" }

                row {
                    style: "items-center gap-1"

                    // 媒体属性弹窗
                    button {
                        onclick: .ToggleInfoModal
                        style: icon_btn
                        icon (name: "info", size: 16)
                    }
                    // OSD 播控条显隐
                    button {
                        onclick: .ToggleControls
                        style: icon_btn
                        icon (name: "eye", size: 16)
                    }
                    // 深浅主题
                    if .dark_mode {
                        button {
                            onclick: .ToggleDarkMode
                            style: icon_btn
                            icon (name: "moon", size: 16)
                        }
                    } else {
                        button {
                            onclick: .ToggleDarkMode
                            style: icon_btn
                            icon (name: "sun", size: 16)
                        }
                    }
                    // 播放队列抽屉
                    button {
                        onclick: .TogglePlaylist
                        style: icon_btn
                        icon (name: "menu", size: 16)
                    }

                    // 窗口装饰（--- 最小化 / 全屏 / 停止）
                    row {
                        style: "items-center gap-1 ml-2 pl-2 border-l border-border"
                        button {
                            style: icon_btn
                            icon (name: "minus", size: 14)
                        }
                        button {
                            onclick: .ToggleFullscreen
                            style: icon_btn
                            icon (name: "square", size: 14)
                        }
                        button {
                            onclick: .StopPlayback
                            style: icon_btn
                            icon (name: "x", size: 14)
                        }
                    }
                }
            }
            // 操作反馈条（扁平，替代原悬浮 Toast 气泡；不用 absolute/毛玻璃）
            if .show_toast {
                row {
                    style: "h-8 shrink-0 items-center gap-2 px-4 border-b border-border bg-muted"
                    text .toast_msg { style: "text-xs font-medium truncate" }
                    col { style: "flex-1" }
                    button {
                        onclick: .DismissToast
                        style: icon_btn
                        icon (name: "x", size: 12)
                    }
                }
            }

            // ══════════════════════════════════════════════════════════════════════
            // 2. 主体区：视频视口 + 右侧播放队列（发丝线分隔，无卡片/无玻璃）
            // ══════════════════════════════════════════════════════════════════════
            row {
                style: "flex-1 w-full min-h-0 flex-row"

                // ──────────────────────────────────────────────────────────────────
                // 2.1 视频视口 (viewport) —— 上=元信息条 / 中=画面 / 下=状态条
                //     全部走常规流式布局：不使用 absolute / fixed（VM 端降级）
                // ──────────────────────────────────────────────────────────────────
                col {
                    style: "flex-1 min-w-0 flex-col bg-black"

                    // 元信息条：真实已知字段（文件名/大小/扩展名由后端扫描给出）
                    row {
                        style: "h-9 shrink-0 items-center gap-3 px-4"
                        text .current_title {
                            style: "text-xs font-medium text-white truncate max-w-sm"
                        }
                        col { style: "flex-1" }
                        text .current_size { style: "text-xs font-mono text-zinc-400" }
                    }

                    // 画面区：点击切换播放。
                    // 注意：video 在 VM 端是 fallback（零高度），故必须由真实容器 col
                    // 承载 flex-1；直接给 video 加 flex-1 会让高度分配失效、状态条上浮。
                    col {
                        style: "flex-1 w-full min-h-0 items-center justify-center"
                        video {
                            src: .current_video_url
                            class: if .aspect_mode == "铺满" { "w-full h-full object-cover" } else { "w-full h-full object-contain" }
                            onclick: .TogglePlay
                        }
                    }

                    // 状态条：播放状态 + 画幅 + 音频（模拟态；T-08 由 loadedmetadata/timeupdate 回灌）
                    row {
                        style: "h-8 shrink-0 items-center justify-center gap-4 px-4"
                        if .is_playing {
                            text "正在播放" { style: "text-xs text-zinc-400" }
                        } else {
                            text "已暂停 · 点击视口或按空格播放" { style: "text-xs text-zinc-400" }
                        }
                        text "画幅 " + .aspect_mode { style: "text-xs font-mono text-zinc-500" }
                        text "音频 " + .current_audio { style: "text-xs font-mono text-zinc-500" }
                    }
                }
                // ──────────────────────────────────────────────────────────────────
                // 2.2 播放队列 (playlist) — 扁平列表；无渐变封面 / 无阴影 / 无毛玻璃
                //     T-04 接入真实扫描结果并按 rel_dir 分组；T-06 换后端数据
                // ──────────────────────────────────────────────────────────────────
                if .show_playlist {
                    col {
                        style: "w-72 shrink-0 h-full flex-col border-l border-border bg-card min-h-0"

                        row {
                            style: "h-12 shrink-0 items-center justify-between px-4 border-b border-border"
                            text "播放队列" { style: "text-sm font-semibold" }
                            button {
                                onclick: .TogglePlaylist
                                style: icon_btn
                                icon (name: "x", size: 14)
                            }
                        }

                        col {
                            style: "flex-1 min-h-0 overflow-y-auto p-2 gap-1"

                            for item in .playlist {
                                // 扁平列表行：单 col 承载两行文本。
                                // VM 端 `flex-1`/`shrink-0` 不生效（见 docs/style-coverage.md
                                // 的 parsed-only 清单），故不用「图标列 + flex-1 文本列」的
                                // 横向切分——那样两个子列都会塌成 0 宽、行渲染为空条。
                                col {
                                    onclick: .SelectVideo(item.id)
                                    style: if item.id == .current_id {
                                        "w-full px-3 py-2 rounded-md bg-accent border border-primary/40 gap-0.5 cursor-pointer"
                                    } else {
                                        "w-full px-3 py-2 rounded-md border border-transparent hover:bg-muted gap-0.5 cursor-pointer"
                                    }
                                    text item.title { style: "text-xs font-medium" }
                                    text item.size_str { style: "text-xs text-muted-foreground font-mono" }
                                }
                            }
                        }

                        col {
                            style: "p-3 shrink-0 border-t border-border gap-2"
                            button "打开本地视频文件" {
                                onclick: .OpenLocalDemo
                                style: "w-full h-9 items-center justify-center rounded-md bg-muted border border-border text-xs font-medium hover:bg-muted/70 cursor-pointer"
                            }
                            text "快捷键 空格 / 方向键 / P" { style: "text-xs text-muted-foreground" }
                        }
                    }
                }
            }

            // ══════════════════════════════════════════════════════════════════════
            // 3. 播控条 (transport bar) — h-14 发丝线；全视图唯一 primary = 播放/暂停
            //    进度填充当前仍由模拟 progress_pct 分档驱动，T-08 换真实
            //    currentTime/duration 回灌。
            // ══════════════════════════════════════════════════════════════════════
            if .show_controls {
                row {
                    style: "h-16 shrink-0 items-center gap-4 px-4 border-t border-border bg-card"

                    col {
                        style: "flex-1 min-w-0 gap-1"
                        row {
                            style: "items-center gap-2 text-xs font-mono text-muted-foreground"
                            text .current_time_str {}
                            text "/" {}
                            button .total_time_str {
                                onclick: .ToggleTimeMode
                                style: "text-xs font-mono text-muted-foreground hover:text-foreground cursor-pointer"
                            }
                            col { style: "flex-1" }
                            text .time_display_fmt {}
                        }
                        col {
                            style: "h-2 w-full rounded-full bg-muted cursor-pointer"
                            onclick: .StepForward
                            if .progress_pct >= 75 {
                                col { style: "h-2 rounded-full bg-primary w-3/4" }
                            } else if .progress_pct >= 50 {
                                col { style: "h-2 rounded-full bg-primary w-1/2" }
                            } else if .progress_pct >= 25 {
                                col { style: "h-2 rounded-full bg-primary w-1/4" }
                            } else if .progress_pct > 0 {
                                col { style: "h-2 rounded-full bg-primary w-1/12" }
                            }
                        }
                    }

                    row {
                        style: "items-center gap-1 shrink-0"
                        button {
                            onclick: .PrevVideo
                            style: ctl_btn
                            icon (name: "chevron-left", size: 16)
                        }
                        button "-5s" {
                            onclick: .StepBackward
                            style: seg_btn
                        }
                        if .is_playing {
                            button "暂停" {
                                onclick: .TogglePlay
                                style: "h-9 px-4 items-center justify-center rounded-md bg-primary text-primary-foreground text-xs font-semibold hover:bg-primary/90 cursor-pointer"
                            }
                        } else {
                            button "播放" {
                                onclick: .TogglePlay
                                style: "h-9 px-4 items-center justify-center rounded-md bg-primary text-primary-foreground text-xs font-semibold hover:bg-primary/90 cursor-pointer"
                            }
                        }
                        button "+5s" {
                            onclick: .StepForward
                            style: seg_btn
                        }
                        button {
                            onclick: .NextVideo
                            style: ctl_btn
                            icon (name: "chevron-right", size: 16)
                        }
                        button {
                            onclick: .StopPlayback
                            style: ctl_btn
                            icon (name: "square", size: 14)
                        }
                    }

                    row {
                        style: "items-center gap-1 shrink-0 pl-3 border-l border-border"
                        button "静音" {
                            onclick: .ToggleMute
                            style: seg_btn
                        }
                        button "-" {
                            onclick: .VolDown
                            style: seg_btn
                        }
                        text .volume_label { style: "text-xs font-mono text-muted-foreground w-9 text-center" }
                        button "+" {
                            onclick: .VolUp
                            style: seg_btn
                        }
                    }

                    row {
                        style: "items-center gap-1 shrink-0 pl-3 border-l border-border"
                        button .loop_label {
                            onclick: .CycleLoopMode
                            style: tab_btn
                        }
                        button .playback_speed {
                            onclick: .CycleSpeed
                            style: seg_btn
                        }
                        button .aspect_mode {
                            onclick: .ToggleAspect
                            style: tab_btn
                        }
                        button {
                            onclick: .ToggleFullscreen
                            style: ctl_btn
                            icon (name: "frame", size: 16)
                        }
                    }
                }
            }

            // ══════════════════════════════════════════════════════════════════════
            // 4. 媒体属性弹窗 (media info) — 扁平卡片。注意 VM 端 `fixed` 会降级为
            //    常规流位置（docs/style-coverage.md），此处不依赖它做遮挡。
            // ══════════════════════════════════════════════════════════════════════
            if .show_info_modal {
                col {
                    style: "fixed inset-0 bg-black/60 items-center justify-center p-4"
                    col {
                        style: "w-full max-w-md bg-card border border-border rounded-lg p-6 gap-4"

                        row {
                            style: "items-center justify-between pb-3 border-b border-border"
                            row {
                                style: "items-center gap-2"
                                icon (name: "info", size: 16, style: "text-primary")
                                text "媒体属性" { style: "text-sm font-semibold" }
                            }
                            button {
                                onclick: .ToggleInfoModal
                                style: icon_btn
                                icon (name: "x", size: 14)
                            }
                        }

                        col {
                            style: "gap-2 text-xs font-mono"
                            row {
                                style: "justify-between py-1 border-b border-border/50"
                                text "标题" { style: "font-sans text-muted-foreground" }
                                text .current_title { style: "font-sans truncate max-w-[200px]" }
                            }
                            row {
                                style: "justify-between py-1 border-b border-border/50"
                                text "文件名" { style: "font-sans text-muted-foreground" }
                                text .current_file { style: "font-sans truncate max-w-[200px]" }
                            }
                            row {
                                style: "justify-between py-1 border-b border-border/50"
                                text "分辨率" { style: "font-sans text-muted-foreground" }
                                text .current_res { style: "text-primary font-bold" }
                            }
                            row {
                                style: "justify-between py-1 border-b border-border/50"
                                text "编码" { style: "font-sans text-muted-foreground" }
                                text .current_codec {}
                            }
                            row {
                                style: "justify-between py-1 border-b border-border/50"
                                text "帧率" { style: "font-sans text-muted-foreground" }
                                text .current_fps {}
                            }
                            row {
                                style: "justify-between py-1 border-b border-border/50"
                                text "码率" { style: "font-sans text-muted-foreground" }
                                text .current_bitrate {}
                            }
                            row {
                                style: "justify-between py-1 border-b border-border/50"
                                text "音频" { style: "font-sans text-muted-foreground" }
                                text .current_audio {}
                            }
                            row {
                                style: "justify-between py-1"
                                text "文件大小" { style: "font-sans text-muted-foreground" }
                                text .current_size {}
                            }
                        }

                        button "关闭" {
                            onclick: .ToggleInfoModal
                            style: "w-full h-9 items-center justify-center rounded-md bg-muted border border-border text-xs font-medium hover:bg-muted/70 cursor-pointer"
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            .current_time_str = "00:45"
            .total_time_str = "03:45"
            .time_display_fmt = "00:45 / 03:45"
            .progress_pct = 20
            .volume = 80
            .volume_label = "80%"
            .is_playing = true
            .toast_msg = "已载入: 01_intro.mp4 (1080P 60FPS)"
            .show_toast = true
        }

        .TogglePlay -> {
            .is_playing = !.is_playing
            if .is_playing {
                .toast_msg = "播放"
            } else {
                .toast_msg = "暂停"
            }
            .show_toast = true
        }

        .StepForward -> {
            .current_time_sec = .current_time_sec + 5
            if .current_time_sec > .total_time_sec {
                .current_time_sec = .total_time_sec
            }
            let min = .current_time_sec / 60
            let sec = .current_time_sec % 60
            let sec_str = if sec < 10 { "0" + sec.to_string() } else { sec.to_string() }
            let min_str = if min < 10 { "0" + min.to_string() } else { min.to_string() }
            .current_time_str = min_str + ":" + sec_str
            .time_display_fmt = .current_time_str + " / " + .total_time_str
            .progress_pct = (.current_time_sec * 100) / .total_time_sec
            .toast_msg = "快进 +5 秒 (" + .current_time_str + ")"
            .show_toast = true
        }

        .StepBackward -> {
            .current_time_sec = .current_time_sec - 5
            if .current_time_sec < 0 {
                .current_time_sec = 0
            }
            let min = .current_time_sec / 60
            let sec = .current_time_sec % 60
            let sec_str = if sec < 10 { "0" + sec.to_string() } else { sec.to_string() }
            let min_str = if min < 10 { "0" + min.to_string() } else { min.to_string() }
            .current_time_str = min_str + ":" + sec_str
            .time_display_fmt = .current_time_str + " / " + .total_time_str
            .progress_pct = (.current_time_sec * 100) / .total_time_sec
            .toast_msg = "快退 -5 秒 (" + .current_time_str + ")"
            .show_toast = true
        }

        .NextVideo -> {
            .current_id = .current_id + 1
            if .current_id > 5 {
                .current_id = 1
            }
            if .current_id == 1 {
                .current_title = "AutoOS 2026 Keynote & Intro"
                .current_file = "01_intro.mp4"
                .current_video_url = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4"
                .current_res = "1080P"
                .current_codec = "H.264"
                .current_size = "48 MB"
                .total_time_sec = 225
                .total_time_str = "03:45"
            } else if .current_id == 2 {
                .current_title = "Kernel & AutoVM Architecture"
                .current_file = "02_architecture.mkv"
                .current_video_url = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4"
                .current_res = "4K"
                .current_codec = "HEVC"
                .current_size = "210 MB"
                .total_time_sec = 740
                .total_time_str = "12:20"
            } else if .current_id == 3 {
                .current_title = "AutoUI Dual-Backend Engine Demo"
                .current_file = "03_ui_engine.mp4"
                .current_video_url = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4"
                .current_res = "1080P"
                .current_codec = "AV1"
                .current_size = "85 MB"
                .total_time_sec = 495
                .total_time_str = "08:15"
            } else if .current_id == 4 {
                .current_title = "Fullstack Parity & Toolchain"
                .current_file = "04_workflow.webm"
                .current_video_url = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4"
                .current_res = "1080P"
                .current_codec = "VP9"
                .current_size = "62 MB"
                .total_time_sec = 330
                .total_time_str = "05:30"
            } else {
                .current_title = "AutoOS Ambient Desktop Visuals"
                .current_file = "05_ambient.mp4"
                .current_video_url = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerFun.mp4"
                .current_res = "720P"
                .current_codec = "H.264"
                .current_size = "24 MB"
                .total_time_sec = 90
                .total_time_str = "01:30"
            }
            .current_time_sec = 0
            .current_time_str = "00:00"
            .time_display_fmt = "00:00 / " + .total_time_str
            .progress_pct = 0
            .is_playing = true
            .toast_msg = "播放下一集: " + .current_file
            .show_toast = true
        }

        .PrevVideo -> {
            .current_id = .current_id - 1
            if .current_id < 1 {
                .current_id = 5
            }
            if .current_id == 1 {
                .current_title = "AutoOS 2026 Keynote & Intro"
                .current_file = "01_intro.mp4"
                .current_video_url = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4"
                .current_res = "1080P"
                .current_codec = "H.264"
                .current_size = "48 MB"
                .total_time_sec = 225
                .total_time_str = "03:45"
            } else if .current_id == 2 {
                .current_title = "Kernel & AutoVM Architecture"
                .current_file = "02_architecture.mkv"
                .current_video_url = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4"
                .current_res = "4K"
                .current_codec = "HEVC"
                .current_size = "210 MB"
                .total_time_sec = 740
                .total_time_str = "12:20"
            } else if .current_id == 3 {
                .current_title = "AutoUI Dual-Backend Engine Demo"
                .current_file = "03_ui_engine.mp4"
                .current_video_url = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4"
                .current_res = "1080P"
                .current_codec = "AV1"
                .current_size = "85 MB"
                .total_time_sec = 495
                .total_time_str = "08:15"
            } else if .current_id == 4 {
                .current_title = "Fullstack Parity & Toolchain"
                .current_file = "04_workflow.webm"
                .current_video_url = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4"
                .current_res = "1080P"
                .current_codec = "VP9"
                .current_size = "62 MB"
                .total_time_sec = 330
                .total_time_str = "05:30"
            } else {
                .current_title = "AutoOS Ambient Desktop Visuals"
                .current_file = "05_ambient.mp4"
                .current_video_url = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerFun.mp4"
                .current_res = "720P"
                .current_codec = "H.264"
                .current_size = "24 MB"
                .total_time_sec = 90
                .total_time_str = "01:30"
            }
            .current_time_sec = 0
            .current_time_str = "00:00"
            .time_display_fmt = "00:00 / " + .total_time_str
            .progress_pct = 0
            .is_playing = true
            .toast_msg = "播放上一集: " + .current_file
            .show_toast = true
        }

        .StopPlayback -> {
            .is_playing = false
            .current_time_sec = 0
            .current_time_str = "00:00"
            .time_display_fmt = "00:00 / " + .total_time_str
            .progress_pct = 0
            .toast_msg = "已停止播放"
            .show_toast = true
        }

        .SeekPercent(pct int) -> {
            .progress_pct = pct
            .current_time_sec = (.total_time_sec * pct) / 100
            let min = .current_time_sec / 60
            let sec = .current_time_sec % 60
            let sec_str = if sec < 10 { "0" + sec.to_string() } else { sec.to_string() }
            let min_str = if min < 10 { "0" + min.to_string() } else { min.to_string() }
            .current_time_str = min_str + ":" + sec_str
            .time_display_fmt = .current_time_str + " / " + .total_time_str
            .toast_msg = "跳转至 " + pct.to_string() + "% (" + .current_time_str + ")"
            .show_toast = true
        }

        .VolUp -> {
            .volume = .volume + 5
            if .volume > 100 {
                .volume = 100
            }
            .volume_label = .volume.to_string() + "%"
            .is_muted = false
            .toast_msg = "音量 " + .volume_label
            .show_toast = true
        }

        .VolDown -> {
            .volume = .volume - 5
            if .volume < 0 {
                .volume = 0
            }
            .volume_label = .volume.to_string() + "%"
            .is_muted = false
            .toast_msg = "音量 " + .volume_label
            .show_toast = true
        }

        .SetVolume(vol int) -> {
            .volume = vol
            .volume_label = vol.to_string() + "%"
            .is_muted = false
            .toast_msg = "音量 " + .volume_label
            .show_toast = true
        }

        .ToggleMute -> {
            .is_muted = !.is_muted
            if .is_muted {
                .toast_msg = "已静音"
            } else {
                .toast_msg = "取消静音 (" + .volume_label + ")"
            }
            .show_toast = true
        }

        .CycleSpeed -> {
            if .playback_speed == "1.0x" {
                .playback_speed = "1.25x"
            } else if .playback_speed == "1.25x" {
                .playback_speed = "1.5x"
            } else if .playback_speed == "1.5x" {
                .playback_speed = "2.0x"
            } else if .playback_speed == "2.0x" {
                .playback_speed = "0.5x"
            } else if .playback_speed == "0.5x" {
                .playback_speed = "0.75x"
            } else {
                .playback_speed = "1.0x"
            }
            .toast_msg = "倍速 " + .playback_speed
            .show_toast = true
        }

        .SetSpeed(spd str) -> {
            .playback_speed = spd
            .show_speed_menu = false
            .toast_msg = "倍速 " + spd
            .show_toast = true
        }

        .ToggleSpeedMenu -> {
            .show_speed_menu = !.show_speed_menu
        }

        .TogglePlaylist -> {
            .show_playlist = !.show_playlist
        }

        .ToggleControls -> {
            .show_controls = !.show_controls
        }

        .ToggleFullscreen -> {
            .is_fullscreen = !.is_fullscreen
            if .is_fullscreen {
                .toast_msg = "进入全屏视口"
            } else {
                .toast_msg = "退出全屏"
            }
            .show_toast = true
        }

        .ToggleAspect -> {
            if .aspect_mode == "16:9" {
                .aspect_mode = "4:3"
            } else if .aspect_mode == "4:3" {
                .aspect_mode = "铺满"
            } else {
                .aspect_mode = "16:9"
            }
            .toast_msg = "画幅比例: " + .aspect_mode
            .show_toast = true
        }

        .CycleLoopMode -> {
            if .loop_mode == "list" {
                .loop_mode = "single"
                .loop_label = "单曲循环"
                .toast_msg = "模式: 单曲循环"
            } else if .loop_mode == "single" {
                .loop_mode = "shuffle"
                .loop_label = "随机播放"
                .toast_msg = "模式: 随机播放"
            } else {
                .loop_mode = "list"
                .loop_label = "列表循环"
                .toast_msg = "模式: 列表循环"
            }
            .show_toast = true
        }

        .ToggleTimeMode -> {
            if .time_mode == "elapsed" {
                .time_mode = "remaining"
                let rem = .total_time_sec - .current_time_sec
                let min = rem / 60
                let sec = rem % 60
                let sec_str = if sec < 10 { "0" + sec.to_string() } else { sec.to_string() }
                let min_str = if min < 10 { "0" + min.to_string() } else { min.to_string() }
                .total_time_str = "-" + min_str + ":" + sec_str
                .toast_msg = "显示剩余时间"
            } else {
                .time_mode = "elapsed"
                let min = .total_time_sec / 60
                let sec = .total_time_sec % 60
                let sec_str = if sec < 10 { "0" + sec.to_string() } else { sec.to_string() }
                let min_str = if min < 10 { "0" + min.to_string() } else { min.to_string() }
                .total_time_str = min_str + ":" + sec_str
                .toast_msg = "显示总时长"
            }
            .show_toast = true
        }

        .SelectVideo(id int) -> {
            .current_id = id
            if id == 1 {
                .current_title = "AutoOS 2026 Keynote & Intro"
                .current_file = "01_intro.mp4"
                .current_video_url = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4"
                .current_res = "1080P"
                .current_codec = "H.264"
                .current_size = "48 MB"
                .total_time_sec = 225
                .total_time_str = "03:45"
            } else if id == 2 {
                .current_title = "Kernel & AutoVM Architecture"
                .current_file = "02_architecture.mkv"
                .current_video_url = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4"
                .current_res = "4K"
                .current_codec = "HEVC"
                .current_size = "210 MB"
                .total_time_sec = 740
                .total_time_str = "12:20"
            } else if id == 3 {
                .current_title = "AutoUI Dual-Backend Engine Demo"
                .current_file = "03_ui_engine.mp4"
                .current_video_url = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4"
                .current_res = "1080P"
                .current_codec = "AV1"
                .current_size = "85 MB"
                .total_time_sec = 495
                .total_time_str = "08:15"
            } else if id == 4 {
                .current_title = "Fullstack Parity & Toolchain"
                .current_file = "04_workflow.webm"
                .current_video_url = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4"
                .current_res = "1080P"
                .current_codec = "VP9"
                .current_size = "62 MB"
                .total_time_sec = 330
                .total_time_str = "05:30"
            } else {
                .current_title = "AutoOS Ambient Desktop Visuals"
                .current_file = "05_ambient.mp4"
                .current_video_url = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerFun.mp4"
                .current_res = "720P"
                .current_codec = "H.264"
                .current_size = "24 MB"
                .total_time_sec = 90
                .total_time_str = "01:30"
            }
            .current_time_sec = 0
            .current_time_str = "00:00"
            .time_display_fmt = "00:00 / " + .total_time_str
            .progress_pct = 0
            .is_playing = true
            .toast_msg = "开始播放: " + .current_file
            .show_toast = true
        }

        .ToggleInfoModal -> {
            .show_info_modal = !.show_info_modal
        }

        .DismissToast -> {
            .show_toast = false
        }

        .OpenLocalDemo -> {
            .toast_msg = "已模拟关联系统文件管理器 (027-file-manager) 打开媒体"
            .show_toast = true
        }

        .ToggleDarkMode -> {
            .dark_mode = !.dark_mode
        }

        .SetAccent(color str) -> {
            .accent_color = color
            .toast_msg = "强调色已设为 " + color
            .show_toast = true
        }
    }
}
