// app.at — 030-video-player 根组件（PLAN-617 T-03/T-04：单文件 1193 行拆分为
// 四个组件 + 一个 store）。
//
// 结构（§2.2 视觉语言：发丝线扁平布局，无卡片/阴影/毛玻璃/渐变）：
//   h-12 顶栏（标题 + 主题 + 队列开关）
//   中部 row：Viewport（视口，flex-1）+ Playlist（w-72，border-l）
//   h-14 播控条 Controls（border-t）
//
// 状态与业务逻辑全在 player_store.at；三个子组件经 `use player_store` 直读
// `.store.*`，事件由本组件薄转发（041-auto-edit 的既有形态）。
// 视图内不出现 emoji（AC-04），图标名限定在 VM lucide 字形表闭集内。

use player_store: PlayerStore
use viewport: Viewport
use playlist: Playlist
use controls: Controls

widget App {
    msg {
        Init,
        ToggleDarkMode,
        TogglePlaylist
    }

    model {
        // 主题两魔法变量放在**根 widget** 而不是 store 里（Plan 409 §8 的
        // root-App 形态）：生成器的主题运行时（`:class="{dark: ...}"` +
        // 把 dark 类同步到 `<html>` + applyTheme/applyAccent）只在 widget
        // 自己持有 `dark_mode` **且**持有 `accent_color` 时才发射。
        // 放 store 里时，切换只会改根 div 的 class，而 `<html class="dark">`
        // （pac.at 的 theme 经 index.html 注入）仍然在 :root 上给着深色变量，
        // 于是「切浅色没反应」——实测就是这个表现。
        // 界面不再提供强调色选择器（§2.2），但这两个变量名是平台的魔法名，
        // 必须存在于根 widget 才能拿到主题运行时。
        var dark_mode bool = true
        var accent_color str = "indigo"
    }

    view {
        col {
            style: "w-full h-screen flex-col bg-background text-foreground overflow-hidden"

            // ══ 1. 顶栏 h-12 ══
            row {
                style: "w-full h-12 items-center gap-3 px-4 border-b border-border bg-card"

                row {
                    style: "items-center gap-2"
                    icon (name: "film", size: 18, style: "text-primary")
                    text "Video Player" { style: "text-sm font-semibold tracking-tight" }
                }
                if .store.has_current {
                    text .store.current_file {
                        style: "text-xs text-muted-foreground font-mono"
                    }
                }

                col { style: "flex-1" }

                row {
                    style: "items-center gap-1"
                    // 深浅主题
                    if .dark_mode {
                        button {
                            onclick: .ToggleDarkMode
                            style: "theme-toggle w-8 h-7 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground cursor-pointer"
                            icon (name: "sun", size: 15)
                        }
                    } else {
                        button {
                            onclick: .ToggleDarkMode
                            style: "theme-toggle w-8 h-7 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground cursor-pointer"
                            icon (name: "moon", size: 15)
                        }
                    }
                    // 队列显隐
                    button {
                        onclick: .TogglePlaylist
                        style: "theme-toggle w-8 h-7 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground cursor-pointer"
                        // PLAN-621 e2e：state 绑定随 .store.show_playlist 翻转
                        // （on=primary+加重描边 / off=muted），Web/VM 双端同源。
                        icon (name: "panel-left", size: 15, state: .store.show_playlist)
                    }
                }
            }

            // ══ 2. 主体：视口 + 队列栏 ══
            row {
                style: "w-full flex-1 min-h-0"

                col {
                    style: "flex-1 min-w-0 min-h-0"
                    Viewport()
                }
                if .store.show_playlist {
                    Playlist()
                }
            }

            // ══ 3. 播控条 h-14 ══
            Controls()
        }
    }

    on {
        // 唯一的根 handler：真实扫描（内建/原生调用只留在根 handler，§5.6）。
        .Init -> {
            store.Load()
        }
        .ToggleDarkMode -> {
            .dark_mode = !.dark_mode
        }
        .TogglePlaylist -> {
            store.TogglePlaylist()
        }
    }
}
