// controls.at — OSD 播控条（PLAN-617 T-04 / T-08）。
//
// 三段式：左=时间（回灌格式化）+ 进度，中=传输键，右=音量/倍速。
//
// **时间与进度全部由回灌驱动**：`current_time_str`/`duration_str`/`progress_pct`
// 只由 store 的 OnTime/OnDuration 写（见 player_store.at），没有任何预置常量
// ——旧版的 "00:45 / 03:45" 是烘死的假值，这里不再存在（AC-08）。
//
// 进度条的**可点击**形态：10 个各代表 10% 的段，点哪段就 seek 到哪个百分比。
// 不用单条轨道 + 点击坐标换算（那需要 $event 进 handler 体，属于 §2.3 明确
// 绕开的现状限制），也不用 absolute 定位（VM 不支持）；固定像素宽度在双端
// 都有确定几何，VM 端 `flex-1` 失效也不影响。
//
// 按钮纪律（PLAN-571 / AC-02）：只有 1 个 primary（播放/暂停），其余是未指定
// 变体或 ghost；尺寸收敛为 3 档 —— icon `w-8 h-7`、传输 `w-9 h-9`、文本
// `h-9 px-3`。

use player_store: PlayerStore

widget Controls {
    msg {
        TogglePlay,
        SeekPercent(float),
        VolUp,
        VolDown,
        ToggleMute,
        RateUp,
        Next,
        Prev
    }

    view {
        row {
            style: "w-full h-14 items-center gap-4 px-4 border-t border-border bg-card"

            // ── 左：时间 + 进度段 ──
            col {
                style: "flex-1 min-w-0 gap-1"
                row {
                    style: "w-full items-center gap-2 text-xs font-mono text-muted-foreground"
                    text .store.current_time_str {}
                    text "/" {}
                    text .store.duration_str {}
                    col { style: "flex-1" }
                    text .store.status_text {}
                }
                row {
                    style: "items-center gap-0.5"
                    // 双分支形态（041-auto-edit 的既有写法）：`style: if` 与
                    // 标量循环变量同处一个元素时，生成器的 class 臂会与 v-for
                    // 争位（实测产出坏 TS，vue-tsc TS1003）。拆成两个元素后
                    // 属性顺序稳定。
                    for m in .store.seek_marks {
                        if .store.progress_pct >= m {
                            col {
                                onclick: .SeekPercent(m)
                                style: "seek-seg w-6 h-2 rounded-full bg-primary cursor-pointer"
                            }
                        } else {
                            col {
                                onclick: .SeekPercent(m)
                                style: "seek-seg w-6 h-2 rounded-full bg-muted cursor-pointer"
                            }
                        }
                    }
                }
            }

            // ── 中：传输键（唯一 primary = 播放/暂停）──
            row {
                style: "items-center gap-1"
                button {
                    onclick: .Prev
                    style: "transport-prev w-9 h-9 items-center justify-center rounded-md bg-muted border border-border text-foreground hover:bg-muted/70 cursor-pointer"
                    icon (name: "chevron-left", size: 16)
                }
                if .store.is_playing {
                    button "暂停" {
                        onclick: .TogglePlay
                        style: "h-9 px-3 items-center justify-center rounded-md bg-primary text-primary-foreground text-xs font-semibold hover:bg-primary/90 cursor-pointer"
                    }
                } else {
                    button "播放" {
                        onclick: .TogglePlay
                        style: "h-9 px-3 items-center justify-center rounded-md bg-primary text-primary-foreground text-xs font-semibold hover:bg-primary/90 cursor-pointer"
                    }
                }
                button {
                    onclick: .Next
                    style: "transport-next w-9 h-9 items-center justify-center rounded-md bg-muted border border-border text-foreground hover:bg-muted/70 cursor-pointer"
                    icon (name: "chevron-right", size: 16)
                }
            }

            // ── 右：音量 + 倍速 ──
            row {
                style: "items-center gap-1 pl-3 border-l border-border"
                button "静音" {
                    onclick: .ToggleMute
                    style: "h-9 px-3 items-center justify-center rounded text-xs font-mono text-muted-foreground hover:bg-muted hover:text-foreground cursor-pointer"
                }
                button "-" {
                    onclick: .VolDown
                    style: "h-9 px-3 items-center justify-center rounded text-xs font-mono text-muted-foreground hover:bg-muted hover:text-foreground cursor-pointer"
                }
                text .store.volume_label {
                    style: "text-xs font-mono text-muted-foreground w-9 text-center"
                }
                button "+" {
                    onclick: .VolUp
                    style: "h-9 px-3 items-center justify-center rounded text-xs font-mono text-muted-foreground hover:bg-muted hover:text-foreground cursor-pointer"
                }
                button .store.rate_label {
                    onclick: .RateUp
                    style: "h-9 px-3 items-center justify-center rounded text-xs font-mono text-muted-foreground hover:bg-muted hover:text-foreground cursor-pointer"
                }
            }
        }
    }

    on {
        .TogglePlay -> { store.TogglePlay() }
        .SeekPercent(p float) -> { store.SeekPercent(p) }
        .VolUp -> { store.VolUp() }
        .VolDown -> { store.VolDown() }
        .ToggleMute -> { store.ToggleMute() }
        .RateUp -> { store.RateUp() }
        .Next -> { store.Next() }
        .Prev -> { store.Prev() }
    }
}
