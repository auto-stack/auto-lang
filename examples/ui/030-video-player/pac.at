// pac.at — 030-video-player（Plan 542 & Plan 605）
//
// AutoOS 原生视频播放器（对标 VLC / PotPlayer / IINA / MPC-HC）。
// 专注纯粹无干扰的大视口视频播放，自动隐匿 OSD 专业播控条、高精度进度条、
// 多档倍速调节、音量与静音、画幅切换、可折叠播放队列抽屉与全套键盘快捷键。
// 与 019-video-app（Web 流媒体门户）形成清晰的场景区隔。

name: "video-player"
version: "0.1.0"
description: "AutoOS System Video Player - minimal chromeless viewport, OSD controls & playlist (vue/vm)"

scene: "ui"
render: "vue"
api: "rust"
front_port: 3030
back_port: 8330
// PLAN-617 T-11（用户 r2 裁定方案 (a)）：媒体根目录进 pac.at，env 可覆盖 ——
// 解析序 AUTO_MEDIA_ROOT env → 此处 → 无（诚实空库）。生成的媒体服务
// /api/media/scan 由此扫描（递归，白名单见 ui/media_service.rs）。
media_root: "E:\\Video"
icon: "film"
title: "Video Player"
title_zh: "视频播放器"
category: "media"
desktop: "true"
theme: "dark"
accent: "indigo"

dep stylekit {
    path: "../stylekit"
}
