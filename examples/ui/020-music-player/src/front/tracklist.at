// tracklist.at — 020-music-player 本地音乐曲库列表组件。
//
// 视觉：参考 QQ音乐 / Spotify 曲库列表。
// 包含：歌曲总数统计、路径说明、播放全部/随机播放、搜索栏、格式滤镜、曲目表格。

use player_store: PlayerStore

widget Tracklist {
    msg {
        SelectIndex(int),
        PlayAll,
        ShufflePlay,
        Rescan,
        SearchChange(str),
        FilterChange(str)
    }

    view {
        col {
            style: "w-full h-full flex-col p-6 overflow-hidden min-h-0 select-none gap-5"

            // ── 顶部曲库横幅 ──
            row {
                style: "w-full items-center justify-between pb-4 border-b border-border/80 shrink-0"

                row {
                    style: "items-center gap-4"
                    col {
                        style: "w-16 h-16 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-700 items-center justify-center text-white shadow-md shadow-emerald-900/20 shrink-0"
                        icon (name: "folder-music", size: 30)
                    }
                    col {
                        style: "gap-1"
                        row {
                            style: "items-center gap-2"
                            text "本地音乐库" {
                                style: "text-xl font-bold tracking-tight text-foreground"
                            }
                            text "本地仓库" {
                                style: "text-[10px] px-1.5 py-0.5 rounded bg-primary/15 text-primary font-medium"
                            }
                        }
                        text .store.library_summary_label {
                            style: "text-xs text-muted-foreground"
                        }
                    }
                }

                // 头部操作按钮
                row {
                    style: "items-center gap-2.5"
                    button {
                        onclick: .PlayAll
                        style: "h-9 items-center gap-2 px-4 rounded-lg bg-primary text-primary-foreground font-semibold text-xs shadow-sm hover:bg-primary/90 cursor-pointer"
                        icon (name: "play", size: 14)
                        text "播放全部" {}
                    }
                    button {
                        onclick: .ShufflePlay
                        style: "h-9 items-center gap-2 px-3.5 rounded-lg bg-muted border border-border text-foreground font-medium text-xs hover:bg-muted/80 cursor-pointer"
                        icon (name: "shuffle", size: 14)
                        text "随机播放" {}
                    }
                    button {
                        onclick: .Rescan
                        style: "h-9 w-9 items-center justify-center rounded-lg bg-muted border border-border text-muted-foreground hover:text-foreground hover:bg-muted/80 cursor-pointer"
                        icon (name: "refresh-cw", size: 14)
                    }
                }
            }

            // ── 搜索与格式筛选栏 ──
            row {
                style: "w-full items-center justify-between shrink-0"

                row {
                    style: "items-center gap-1.5 bg-muted/50 p-1 rounded-lg border border-border/60"
                    button {
                        onclick: .FilterChange("all")
                        style: if .store.filter_ext == "all" {
                            "h-7 px-3 rounded-md bg-card text-foreground font-medium text-xs shadow-xs cursor-pointer"
                        } else {
                            "h-7 px-3 rounded-md text-muted-foreground hover:text-foreground font-medium text-xs cursor-pointer"
                        }
                        text "全部曲目" {}
                    }
                    button {
                        onclick: .FilterChange("flac")
                        style: if .store.filter_ext == "flac" {
                            "h-7 px-3 rounded-md bg-card text-foreground font-medium text-xs shadow-xs cursor-pointer"
                        } else {
                            "h-7 px-3 rounded-md text-muted-foreground hover:text-foreground font-medium text-xs cursor-pointer"
                        }
                        text "FLAC 无损" {}
                    }
                    button {
                        onclick: .FilterChange("mp3")
                        style: if .store.filter_ext == "mp3" {
                            "h-7 px-3 rounded-md bg-card text-foreground font-medium text-xs shadow-xs cursor-pointer"
                        } else {
                            "h-7 px-3 rounded-md text-muted-foreground hover:text-foreground font-medium text-xs cursor-pointer"
                        }
                        text "MP3" {}
                    }
                    button {
                        onclick: .FilterChange("wav")
                        style: if .store.filter_ext == "wav" {
                            "h-7 px-3 rounded-md bg-card text-foreground font-medium text-xs shadow-xs cursor-pointer"
                        } else {
                            "h-7 px-3 rounded-md text-muted-foreground hover:text-foreground font-medium text-xs cursor-pointer"
                        }
                        text "WAV" {}
                    }
                }

                // 搜索输入框
                row {
                    style: "h-8 items-center gap-2 px-3 rounded-lg bg-muted/50 border border-border/80 w-64 text-xs"
                    icon (name: "search", size: 14, style: "text-muted-foreground shrink-0")
                    input {
                        placeholder: "搜索歌曲、歌手、专辑..."
                        value: .store.search_query
                        onchange: .SearchChange()
                        style: "w-full bg-transparent border-none outline-none text-foreground placeholder:text-muted-foreground/60 text-xs"
                    }
                }
            }

            // ── 曲目列表表头 (对齐汽水音乐 / QQ音乐视觉规范) ──
            row {
                style: "w-full h-9 items-center px-4 text-xs font-semibold text-muted-foreground/70 border-b border-border/60 shrink-0 gap-4"
                text "#" { style: "w-10 text-center" }
                text "" { style: "w-8" }
                text "歌曲" { style: "flex-1 min-w-0" }
                text "歌手" { style: "w-48 truncate" }
                text "专辑" { style: "w-44 truncate" }
                text "大小" { style: "w-20 text-right font-mono" }
                text "" { style: "w-10" }
            }

            // ── 歌曲滚动列表 (挂载 AutoUI ash-scroll 定制细窄圆角滚动条) ──
            col {
                style: "w-full flex-1 overflow-y-auto ash-scroll min-h-0 gap-1.5 pr-2"

                if .store.item_count == 0 {
                    col {
                        style: "w-full items-center justify-center py-20 gap-3"
                        icon (name: "music", size: 36, style: "text-muted-foreground/40")
                        text .store.status_text {
                            style: "text-sm text-muted-foreground"
                        }
                        button {
                            onclick: .Rescan
                            style: "h-8 items-center gap-2 px-3 rounded-md bg-muted text-foreground text-xs cursor-pointer"
                            icon (name: "refresh-cw", size: 13)
                            text "重新扫描 E:\\Music\\" {}
                        }
                    }
                }

                for i, item in .store.playlist {
                    row {
                        onclick: .SelectIndex(i)
                        style: if item.id == .store.current_id {
                            "w-full h-14 items-center px-4 rounded-xl bg-primary/10 border border-primary/30 text-primary cursor-pointer transition-all group gap-4 shadow-xs"
                        } else {
                            "w-full h-14 items-center px-4 rounded-xl border border-transparent hover:bg-muted/40 text-foreground cursor-pointer transition-all group gap-4"
                        }

                        // 序号 / 播放状态
                        row {
                            style: "w-10 items-center justify-center shrink-0"
                            if item.id == .store.current_id && .store.is_playing {
                                icon (name: "play", size: 15, style: "text-primary fill-primary")
                            } else if item.id == .store.current_id {
                                icon (name: "pause", size: 15, style: "text-primary")
                            } else {
                                text item.index_str {
                                    style: "text-xs font-mono text-muted-foreground/60 group-hover:text-foreground/80 font-medium"
                                }
                            }
                        }

                        // 喜爱红心 (汽水音乐标志性红心)
                        row {
                            style: "w-8 items-center justify-center shrink-0"
                            if item.id == .store.current_id && .store.is_current_liked {
                                icon (name: "heart", size: 16, style: "text-rose-500 fill-rose-500")
                            } else {
                                icon (name: "heart", size: 16, style: "text-rose-500/40 hover:text-rose-500 group-hover:opacity-100 opacity-60")
                            }
                        }

                        // 歌曲名 + SQ / HQ / VIP 标签 (汽水音乐 / QQ音乐风)
                        row {
                            style: "flex-1 min-w-0 items-center gap-2.5 pr-2"
                            text item.title {
                                style: if item.id == .store.current_id {
                                    "text-sm font-semibold text-primary truncate"
                                } else {
                                    "text-sm font-medium text-foreground truncate group-hover:text-primary transition-colors"
                                }
                            }
                            if item.extension == "flac" {
                                text "SQ" {
                                    style: "text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 shrink-0 tracking-wider leading-none"
                                }
                            } else if item.extension == "wav" {
                                text "Master" {
                                    style: "text-[10px] font-bold px-1.5 py-0.5 rounded bg-purple-500/15 text-purple-400 border border-purple-500/30 shrink-0 tracking-wider leading-none"
                                }
                            } else {
                                text "VIP" {
                                    style: "text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 shrink-0 tracking-wider leading-none"
                                }
                            }
                        }

                        // 歌手
                        row {
                            style: "w-48 items-center pr-2"
                            text item.artist {
                                style: "text-xs text-muted-foreground/80 truncate font-normal"
                            }
                        }

                        // 专辑
                        row {
                            style: "w-44 items-center pr-2"
                            text item.album {
                                style: "text-xs text-muted-foreground/60 truncate font-normal"
                            }
                        }

                        // 大小
                        row {
                            style: "w-20 items-center justify-end"
                            text item.size_str {
                                style: "text-xs font-mono text-muted-foreground/70"
                            }
                        }

                        // 更多操作 (汽水音乐末尾三个点)
                        row {
                            style: "w-10 items-center justify-center"
                            icon (name: "more-horizontal", size: 16, style: "text-muted-foreground/40 group-hover:text-foreground cursor-pointer shrink-0")
                        }
                    }
                }
            }
        }
    }

    on {
        .SelectIndex(idx int) -> {
            store.SelectIndex(idx)
        }
        .PlayAll -> {
            store.PlayAll()
        }
        .ShufflePlay -> {
            store.ShufflePlay()
        }
        .Rescan -> {
            store.Load()
        }
        .SearchChange(q str) -> {
            store.SetSearch(q)
        }
        .FilterChange(f str) -> {
            store.SetFilter(f)
        }
    }
}
