// app.at — 020-music-player 主入口组件。
//
// 架构：三栏式现代化桌面音乐播放器。
// - Sidebar：左侧导航栏
// - Stage / Tracklist：中央主体视图（黑胶唱片舞台 / 本地曲库表格）
// - QueueDrawer：右侧可折叠待播抽屉
// - Controls：底部一体化全功能播控台
// - Viewport：受控 HTML5 媒体解码视口

use player_store: PlayerStore
use nav_sidebar: NavSidebar
use stage: Stage
use tracklist: Tracklist
use controls: Controls
use queue_drawer: QueueDrawer
use viewport: Viewport

// PLAN-637 B5 Phase B 映射（2026-09-17）：bg-zinc-950→bg-background；轨道 bg-zinc-400/300→
// bg-muted；ring-zinc-800/border-zinc-900→border 系。豁免：封面渐变叠字 text-white ×4、
// rose（红心）与 emerald（播放徽章/封面渐变）= 语义状态与装饰渐变（638 重设计后残余）。
widget App {
    msg {
        Init,
        ToggleDarkMode
    }

    model {
        // 主题魔法变量：保持在根 widget 以驱动生成器深浅色运行时
        var dark_mode bool = true
        var accent_color str = "emerald"
        // PLAN-035 T-07：桌面通知上行总线（notify 词面；孵化会话排空段 =
        // 宿主 drain 扩容）+ 空曲库去重旗标（rescan 结果不变不重发）。
        var __desktop_cmd str = ""
        var empty_notified bool = false
    }

    view {
        col {
            style: "w-full h-screen flex-col bg-background text-foreground overflow-hidden font-sans select-none"

            // ── 主体区域：左边栏 + 中央内容 + 右抽屉 ──
            row {
                style: "w-full flex-1 min-h-0"

                NavSidebar()

                col {
                    style: "flex-1 min-w-0 min-h-0 bg-background/50 relative overflow-hidden"

                    if .store.view_mode == "stage" {
                        Stage()
                    } else {
                        Tracklist()
                    }
                }

                if .store.show_queue {
                    QueueDrawer()
                }
            }

            // ── 底部播控台 ──
            Controls()

            // ── 隐藏的受控媒体宿主 ──
            Viewport()
        }
    }

    // PLAN-024 R19：桌面音乐卡（stella mini-player 设计语言：圆盘 glyph +
    // 曲名/艺人 + 进度时间标签 + ⏮⏯⏭ 控制——face 事件直达本 app 会话，
    // PlayPause 无曲目时自动 SelectIndex(0) 开播）。category=media → 主 tab。
    // PLAN-035 T-07：2×2 网格卡（168×152）紧凑重排——disc 缩小挂左、
    // 曲名/艺人右侧双行 truncate、时间 + ⏮⏯⏭ 横排，全部控件卡内可见
    // （AC-08）；空曲库文案退役（走系统通知，store Load 臂回退占位）。
    view mini {
        col {
            style: "w-full h-full items-center justify-center gap-1.5 px-2"
            row {
                style: "items-center gap-2 w-full px-1"
                col {
                    style: "w-9 h-9 rounded-full bg-primary/15 items-center justify-center"
                    text "♪" {
                        style: "text-base text-primary"
                    }
                }
                col {
                    style: "items-start gap-0 min-w-0"
                    text .store.current_title {
                        style: "text-xs font-semibold text-foreground truncate"
                    }
                    text .store.current_artist {
                        style: "text-[10px] text-muted-foreground truncate"
                    }
                }
            }
            text .store.time_progress_label {
                style: "text-[10px] text-muted-foreground tabular-nums"
            }
            row {
                style: "items-center gap-3"
                button (onclick: .PrevTrack) {
                    text { "⏮" }
                    style: "h-8 w-10 px-0 text-muted-foreground text-sm"
                }
                button (onclick: .PlayPause) {
                    if .store.is_playing {
                        text { "⏸" }
                        style: "h-9 w-11 px-0 text-primary text-lg"
                    } else {
                        text { "▶" }
                        style: "h-9 w-11 px-0 text-primary text-lg"
                    }
                }
                button (onclick: .NextTrack) {
                    text { "⏭" }
                    style: "h-8 w-10 px-0 text-muted-foreground text-sm"
                }
            }
        }
    }

    on {
        // PLAN-035 T-07：空曲库 → 系统通知流（AC-09）——Load 后读 store
        // 计数（calendar Init 读 store 先例），空且未通知过才发 notify
        // （一次性；曲库恢复非空即复位旗标，之后再空可再报）。
        .Init -> {
            store.Load()
            if .store.item_count == 0 {
                if .empty_notified == false {
                    .empty_notified = true
                    .__desktop_cmd = "notify	info	本地曲库为空：E:\\Music\\（FLAC / MP3 / WAV）"
                }
            } else {
                .empty_notified = false
            }
        }
        .ToggleDarkMode -> {
            .dark_mode = !.dark_mode
        }
    }
}
