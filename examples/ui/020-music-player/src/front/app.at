// app.at — 020-music-player 主入口组件。
//
// 架构：三栏式现代化桌面音乐播放器。
// - Sidebar：左侧导航栏
// - Stage / Tracklist：中央主体视图（黑胶唱片舞台 / 本地曲库表格）
// - QueueDrawer：右侧可折叠待播抽屉
// - Controls：底部一体化全功能播控台
// - Viewport：受控 HTML5 媒体解码视口

use player_store: PlayerStore
use nav_sidebar: NavSidebar
use stage: Stage
use tracklist: Tracklist
use controls: Controls
use queue_drawer: QueueDrawer
use viewport: Viewport

// PLAN-637 B5 Phase B 映射（2026-09-17）：bg-zinc-950→bg-background；轨道 bg-zinc-400/300→
// bg-muted；ring-zinc-800/border-zinc-900→border 系。豁免：封面渐变叠字 text-white ×4、
// rose（红心）与 emerald（播放徽章/封面渐变）= 语义状态与装饰渐变（638 重设计后残余）。
widget App {
    msg {
        Init,
        ToggleDarkMode
    }

    model {
        // 主题魔法变量：保持在根 widget 以驱动生成器深浅色运行时
        var dark_mode bool = true
        var accent_color str = "emerald"
    }

    view {
        col {
            style: "w-full h-screen flex-col bg-background text-foreground overflow-hidden font-sans select-none"

            // ── 主体区域：左边栏 + 中央内容 + 右抽屉 ──
            row {
                style: "w-full flex-1 min-h-0"

                NavSidebar()

                col {
                    style: "flex-1 min-w-0 min-h-0 bg-background/50 relative overflow-hidden"

                    if .store.view_mode == "stage" {
                        Stage()
                    } else {
                        Tracklist()
                    }
                }

                if .store.show_queue {
                    QueueDrawer()
                }
            }

            // ── 底部播控台 ──
            Controls()

            // ── 隐藏的受控媒体宿主 ──
            Viewport()
        }
    }

    // PLAN-024 R19：桌面音乐卡（stella mini-player 设计语言：圆盘 glyph +
    // 曲名/艺人居中 + 进度时间标签 + ⏮⏯⏭ 控制——face 事件直达本 app 会话，
    // PlayPause 无曲目时自动 SelectIndex(0) 开播）。category=media → 主 tab。
    view mini {
        col {
            style: "w-full h-full items-center justify-center gap-2 px-4"
            col {
                style: "w-14 h-14 rounded-full bg-primary/15 items-center justify-center"
                text "♪" {
                    style: "text-2xl text-primary"
                }
            }
            text .store.current_title {
                style: "text-sm font-semibold text-foreground text-center"
            }
            text .store.current_artist {
                style: "text-xs text-muted-foreground text-center"
            }
            text .store.time_progress_label {
                style: "text-xs text-muted-foreground tabular-nums"
            }
            row {
                style: "items-center gap-5"
                button (onclick: .PrevTrack) {
                    text { "⏮" }
                    style: "text-muted-foreground text-base"
                }
                button (onclick: .PlayPause) {
                    if .store.is_playing {
                        text { "⏸" }
                        style: "text-primary text-xl"
                    } else {
                        text { "▶" }
                        style: "text-primary text-xl"
                    }
                }
                button (onclick: .NextTrack) {
                    text { "⏭" }
                    style: "text-muted-foreground text-base"
                }
            }
        }
    }

    on {
        .Init -> {
            store.Load()
        }
        .ToggleDarkMode -> {
            .dark_mode = !.dark_mode
        }
    }
}
