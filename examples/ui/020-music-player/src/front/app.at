        .SelectTrack8 -> {
            .current_index = 8
            .current_title = .t8_title
            .current_artist = .t8_artist
            .current_duration = .t8_duration
            .current_tag = .t8_tag
            .current_icon = .t8_icon
            .current_likes_text = .t8_likes
            .total_time = .t8_duration
            .current_time = "00:00"
            .progress_val = 0
            .is_playing = true
        }
        .ToggleShuffle -> {
            .shuffle = !.shuffle
        }
        .CycleRepeat -> {
            if .repeat_mode == "all" {
                .repeat_mode = "one"
            } else if .repeat_mode == "one" {
                .repeat_mode = "off"
            } else {
                .repeat_mode = "all"
            }
        }
        .ToggleLike -> {
            .liked = !.liked
            if .liked {
                .current_likes_text = "1,421 likes"
            } else {
                .current_likes_text = "1,420 likes"
            }
        }
        .SeekStep -> {
            if .progress_val < 90 {
                .progress_val = .progress_val + 10
            } else {
                .progress_val = 0
            }
        }
        .ToggleSettings -> {
            .show_settings = !.show_settings
        }
        .ToggleDarkMode -> {
            .dark_mode = !.dark_mode
        }
        .SetTheme(t) -> {
            if t == "dark" {
                .dark_mode = true
            } else {
                .dark_mode = false
            }
        }
        .SetAccent(a) -> {
            .accent_color = a
        }
    }
}
