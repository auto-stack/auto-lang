                .current_artist = .t5_artist
                .current_duration = .t5_duration
                .current_tag = .t5_tag
                .current_icon = .t5_icon
                .current_likes_text = .t5_likes
                .current_time = "00:00"
                .total_time = .t5_duration
                .progress_val = 0
            } else if .current_index == 5 {
                .current_index = 6
                .current_title = .t6_title
                .current_artist = .t6_artist
                .current_duration = .t6_duration
                .current_tag = .t6_tag
                .current_icon = .t6_icon
                .current_likes_text = .t6_likes
                .current_time = "00:00"
                .total_time = .t6_duration
                .progress_val = 0
            } else if .current_index == 6 {
                .current_index = 7
                .current_title = .t7_title
                .current_artist = .t7_artist
                .current_duration = .t7_duration
                .current_tag = .t7_tag
                .current_icon = .t7_icon
                .current_likes_text = .t7_likes
                .current_time = "00:00"
                .total_time = .t7_duration
                .progress_val = 0
            } else if .current_index == 7 {
                .current_index = 8
                .current_title = .t8_title
                .current_artist = .t8_artist
                .current_duration = .t8_duration
                .current_tag = .t8_tag
                .current_icon = .t8_icon
                .current_likes_text = .t8_likes
                .current_time = "00:00"
                .total_time = .t8_duration
                .progress_val = 0
            } else {
                .current_index = 1
                .current_title = .t1_title
                .current_artist = .t1_artist
                .current_duration = .t1_duration
                .current_tag = .t1_tag
                .current_icon = .t1_icon
                .current_likes_text = .t1_likes
                .current_time = "00:00"
                .total_time = .t1_duration
                .progress_val = 0
            }
        }
        .PrevTrack -> {
            if .current_index == 1 {
                .current_index = 8
                .current_title = .t8_title
                .current_artist = .t8_artist
                .current_duration = .t8_duration
                .current_tag = .t8_tag
                .current_icon = .t8_icon
                .current_likes_text = .t8_likes
                .current_time = "00:00"
                .total_time = .t8_duration
                .progress_val = 0
            } else if .current_index == 2 {
                .current_index = 1
                .current_title = .t1_title
                .current_artist = .t1_artist
                .current_duration = .t1_duration
                .current_tag = .t1_tag
                .current_icon = .t1_icon
                .current_likes_text = .t1_likes
                .current_time = "00:00"
                .total_time = .t1_duration
                .progress_val = 0
            } else if .current_index == 3 {
                .current_index = 2
                .current_title = .t2_title
                .current_artist = .t2_artist
                .current_duration = .t2_duration
                .current_tag = .t2_tag
                .current_icon = .t2_icon
                .current_likes_text = .t2_likes
                .current_time = "00:00"
                .total_time = .t2_duration
                .progress_val = 0
            } else if .current_index == 4 {
                .current_index = 3
                .current_title = .t3_title
                .current_artist = .t3_artist
                .current_duration = .t3_duration
                .current_tag = .t3_tag
                .current_icon = .t3_icon
                .current_likes_text = .t3_likes
                .current_time = "00:00"
                .total_time = .t3_duration
                .progress_val = 0
            } else if .current_index == 5 {
                .current_index = 4
                .current_title = .t4_title
                .current_artist = .t4_artist
                .current_duration = .t4_duration
                .current_tag = .t4_tag
                .current_icon = .t4_icon
                .current_likes_text = .t4_likes
                .current_time = "00:00"
                .total_time = .t5_duration
