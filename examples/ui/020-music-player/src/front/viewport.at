// viewport.at — 020-music-player 受控媒体视口。
//
// 契约：受控 <video> 元素（HTML5 媒体管道原生解码播放 FLAC / MP3 / WAV），
// 并将时间、状态、结束与错误回灌至 PlayerStore。

use player_store: PlayerStore

widget Viewport {
    msg {
        TogglePlay,
        OnTime(float),
        OnDuration(float),
        OnPlayState(bool),
        OnEnded,
        OnMediaError(str)
    }

    view {
        col {
            // VM 渲染约束：0×0 视口会被 iced 渲染遍历裁掉（prepare 不跑 →
            // mpv 引擎不起 → 桌面 VM 无声，2026-10-09 桌面实测定案）；最小
            // 实体 1×1 + absolute + opacity-0 保持视觉隐藏且双端可播。
            style: "w-[1px] h-[1px] overflow-hidden absolute pointer-events-none opacity-0"

            video {
                src: .store.current_url
                // 媒体引擎稳定键（2026-10-10 小组件独立播放配套）：主窗与
                // dashboard mini 卡两个挂载点共享同一 mpv 运行时——升格/降格、
                // 面板反复开关播放无缝交接，不会出现双引擎双声。
                key: "media"
                controls: false
                preload: "auto"
                playsinline: true
                paused: .store.is_playing == false
                position: .store.seek_target
                volume: .store.volume
                muted: .store.is_muted
                rate: 1.0
                class: "w-[1px] h-[1px]"
                ontimeupdate: .OnTime()
                onloadedmetadata: .OnDuration()
                onplaystatechange: .OnPlayState()
                onended: .OnEnded
                onmediaerror: .OnMediaError()
            }
        }
    }

    on {
        .TogglePlay -> {
            store.PlayPause()
        }
        .OnTime(sec float) -> {
            store.OnTime(sec)
        }
        .OnDuration(sec float) -> {
            store.OnDuration(sec)
        }
        .OnPlayState(playing bool) -> {
            store.OnPlayState(playing)
        }
        .OnEnded -> {
            store.OnEnded()
        }
        .OnMediaError(err str) -> {
            store.OnMediaError(err)
        }
    }
}
