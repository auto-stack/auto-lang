// front/todo_list.at — TodoList component.
// Holds filter state, renders todos inline. TodoItem child component in a
// for-loop requires generator fixes (§18.5) — pending. Uses inline rendering
// + centralized editing state for now.

use todo_store: TodoStore

// PLAN-637 Phase B token 化映射（2026-09-17，B1）：filter 选中态 border-red-400→
// border-primary（选中态强调）；hover:border-gray-300→hover:border-border；行分隔
// border-gray-200→border-border；编辑输入 border-gray-400→border-border；✓ 提交
// bg-blue-500/text-white→bg-primary/text-primary-foreground；✕ 取消 text-gray-500→
// text-muted-foreground；完成项 text-gray-400→text-muted-foreground、待办项
// text-gray-800→text-foreground；删除 × hover:text-red-500→hover:text-destructive
// （唯一真 destructive 语义）；页脚 text-gray-600→text-muted-foreground。

// PLAN-607: Declarative style recipes for filter buttons
style filter_btn_active = "px-2 py-1 border border-primary rounded text-xs"
style filter_btn_inactive = "px-2 py-1 border border-transparent rounded text-xs hover:border-border"

widget TodoList() {
    msg { FilterAll, FilterActive, FilterCompleted, ToggleTodo(int), DeleteTodo(int),
              StartEdit(int), CommitEdit, CancelEdit, EditInputChanged(str), ClearCompleted }

    model {
        var filter str = "all"
    }

    view {
        col {
            style: "border-t border-border"

            // Todo items — inline rendering with centralized editing state (§18)
            col {
                style: "list-none m-0 p-0"
                for item in .store.todos {
                    if .filter == "all" || (.filter == "active" && item.done == false) || (.filter == "completed" && item.done == true) {
                        row {
                            style: "flex items-center py-3 px-4 border-b border-border"
                            if .store.editing_id == item.id {
                                input {
                                    value: .store.edit_text
                                    oninput: .EditInputChanged
                                    onenter: .CommitEdit
                                    style: "flex-1 text-lg px-2 py-1 border border-border rounded outline-none"
                                }
                                button "✓" { onclick: .CommitEdit, style: "ml-2 px-3 py-1 text-sm bg-primary text-primary-foreground rounded" }
                                button "✕" { onclick: .CancelEdit, style: "ml-1 px-3 py-1 text-sm text-muted-foreground rounded" }
                            } else {
                                checkbox {
                                    checked: item.done
                                    onclick: .ToggleTodo(item.id)
                                    style: "w-6 h-6 mr-3"
                                }
                                text item.text {
                                    onclick: .StartEdit(item.id)
                                    style: if item.done {
                                        "flex-1 text-lg text-muted-foreground line-through cursor-pointer"
                                    } else {
                                        "flex-1 text-lg text-foreground cursor-pointer"
                                    }
                                }
                                button "×" {
                                    onclick: .DeleteTodo(item.id)
                                    style: "ml-2 w-8 h-8 text-xl text-muted-foreground hover:text-destructive"
                                }
                            }
                        }
                    }
                }
            }

            // Footer with filter buttons + count
            if .store.todos.len() > 0 {
                row {
                    style: "flex items-center justify-between px-4 py-3 border-t border-border text-sm text-muted-foreground"
                    text f"${.store.active_count} items left"

                    row {
                        style: "flex gap-1"
                        if .filter == "all" {
                            button "All" { onclick: .FilterAll, style: filter_btn_active }
                        } else {
                            button "All" { onclick: .FilterAll, style: filter_btn_inactive }
                        }
                        if .filter == "active" {
                            button "Active" { onclick: .FilterActive, style: filter_btn_active }
                        } else {
                            button "Active" { onclick: .FilterActive, style: filter_btn_inactive }
                        }
                        if .filter == "completed" {
                            button "Completed" { onclick: .FilterCompleted, style: filter_btn_active }
                        } else {
                            button "Completed" { onclick: .FilterCompleted, style: filter_btn_inactive }
                        }
                    }

                    button "Clear completed" {
                        onclick: .ClearCompleted
                        style: "text-xs hover:underline"
                    }
                }
            }
        }
    }

    on {
        .FilterAll -> { .filter = "all" }
        .FilterActive -> { .filter = "active" }
        .FilterCompleted -> { .filter = "completed" }

        .ToggleTodo(id) -> {
            store.ToggleTodo(id)
        }

        .DeleteTodo(id) -> {
            store.DeleteTodo(id)
        }

        .StartEdit(id) -> {
            store.StartEdit(id)
        }

        .CommitEdit -> {
            store.CommitEdit()
        }

        .CancelEdit -> {
            store.CancelEdit()
        }

        .EditInputChanged(text) -> {
            store.SetEditText(text)
        }

        .ClearCompleted -> {
            store.ClearCompleted()
        }
    }
}
