// front/app.at — TodoMVC App (multi-component + backend).
//
// Layout: title + input + TodoList child component.
// App holds the store + input state; TodoList renders items + filters.

use todo_store: TodoStore
use todo_list: TodoList

widget App {
    msg Msg {
        Init, AddTodo, EditInputChanged, ToggleAll
    }

    model {
        var input str = ""
    }

    view {
        col {
            style: "flex flex-col items-center min-h-screen bg-gray-100 pt-16"

            // Title
            h1 "todos" {
                style: "text-6xl font-thin text-center text-red-400 mb-4"
            }

            // Main card
            col {
                style: "bg-white w-full max-w-xl shadow-lg rounded-lg overflow-hidden"

                // Input row
                row {
                    style: "flex items-center border-b border-gray-200"
                    checkbox {
                        checked: .store.active_count == 0 && .store.todos.len() > 0
                        onclick: .ToggleAll
                        style: "w-10 h-12 ml-2"
                    }
                    input {
                        value: .input
                        oninput: .EditInputChanged
                        onenter: .AddTodo
                        placeholder: "What needs to be done?"
                        style: "flex-1 text-xl px-2 py-3 outline-none"
                    }
                }

                // Todo list (child component)
                TodoList()
            }

            // Footer hint
            text "Double-click text to edit" {
                style: "mt-8 text-xs text-gray-400"
            }
        }
    }

    on {
        .Init -> {
            store.Init()
        }

        .AddTodo -> {
            store.AddTodo()
        }

        .EditInputChanged -> {
            .input = .input
        }

        .ToggleAll -> {
            store.ToggleAll()
        }
    }
}
