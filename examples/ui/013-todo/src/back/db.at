// back/db.at — Todo Database Service
// In-memory storage with seed data.

use api: Todo

// ═══════════════════════════════════════════════════════════
// In-memory storage (seed data)
// ═══════════════════════════════════════════════════════════

var todos List<Todo> = List<Todo>.new([
    Todo { id: 0, text: "Learn Auto Language", done: true },
    Todo { id: 1, text: "Build a TodoMVC app", done: false },
    Todo { id: 2, text: "Master the a2r transpiler", done: false },
    Todo { id: 3, text: "Write integration tests", done: false },
])

var nextid int = 4

// ═══════════════════════════════════════════════════════════
// CRUD operations
// ═══════════════════════════════════════════════════════════

/// Return all todos
pub fn all_todos() []Todo {
    return todos
}

/// Create a new todo, returns the created todo
pub fn create_todo(text str) Todo {
    let todo = Todo { id: nextid, text: text, done: false }
    nextid = nextid + 1
    todos.push(todo)
    return todo
}

/// Update a todo's text and done status, returns the updated todo
pub fn update_todo(id int, text str, done bool) ?Todo {
    var new_todos List<Todo> = List<Todo>.new([])
    var found ?Todo = None
    for todo in todos {
        if todo.id == id {
            let updated = Todo {
                id: todo.id,
                text: text,
                done: done,
            }
            new_todos.push(updated)
            found = Some(updated)
        } else {
            new_todos.push(todo)
        }
    }
    todos = new_todos
    return found
}

/// Delete a todo by id, returns true if deleted
pub fn delete_todo(id int) bool {
    var new_todos List<Todo> = List<Todo>.new([])
    var found bool = false
    for todo in todos {
        if todo.id != id {
            new_todos.push(todo)
        } else {
            found = true
        }
    }
    todos = new_todos
    return found
}

/// Remove all completed todos, returns true
pub fn remove_completed(done bool) bool {
    var new_todos List<Todo> = List<Todo>.new([])
    for todo in todos {
        if !todo.done {
            new_todos.push(todo)
        }
    }
    todos = new_todos
    return true
}
