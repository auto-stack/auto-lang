// app.at — Blog Viewer root shell.
// Routes (home, detail, editor) + sticky top navbar + outlet.
use store: BlogStore

widget App {
    routes {
        "/" -> use home
        "/post/:id" -> use detail
        "/new" -> use editor
    }

    msg {
        Init,
        GoHome,
        WritePost,
    }

    model {
    }

    view {
        col {
            style: "min-h-screen bg-background text-foreground flex flex-col"

            // Sticky Top Navigation Header
            row {
                style: "w-full h-16 border-b border-border bg-card/90 backdrop-blur items-center justify-between px-6 sticky top-0 z-30 shadow-xs"

                // Brand / Title
                row {
                    onclick: .GoHome
                    style: "items-center gap-2 cursor-pointer select-none"
                    text "✍️" { style: "text-xl" }
                    text "My Blog" { style: "text-xl font-bold tracking-tight text-foreground" }
                }

                // Header right actions: article counter & Write button
                row {
                    style: "items-center gap-4"
                    text f"${.store.articles.len()} articles" {
                        style: "text-sm text-muted-foreground font-medium"
                    }
                    button {
                        onclick: .WritePost
                        style: "inline-flex items-center gap-1.5 px-4 py-2 bg-primary text-primary-foreground rounded-full text-sm font-semibold hover:bg-primary/90 transition-colors shadow-xs cursor-pointer"
                        text "Write" {}
                    }
                }
            }

            // Router outlet for current page
            col {
                style: "flex-1 w-full"
                outlet
            }
        }
    }

    on {
        .Init -> {
            store.Init()
        }
        .GoHome -> {
            router.push("/")
        }
        .WritePost -> {
            router.push("/new")
        }
    }
}
