// app.at — Book Reader shell. Multi-page routes + sidebar nav + outlet.
// Plan 399 018: first example to fuse routes (auto-read architecture) with a
// strong-typed rust backend (015/017 CRUD pattern).
use book_store: BooksStore

style sub_text = "text-sm text-muted-foreground"

widget App {
    routes {
        "/" -> use bookshelf
        "/book/:id" -> use book_detail
        "/book/:id/chapter/:ch" -> use reading
        "/settings" -> use settings
    }

    msg { Init }

    view {
        // PLAN-684 F-1 嵌入安全壳层：禁用 viewport-fixed 铬件。
        // 侧栏/主区都是容器内 flex 兄弟，高度锚定父容器（AppViewport deep
        // 覆盖 .min-h-screen→100%）。此前 `fixed inset-y-0` 相对浏览器视口
        // 定位，gallery 内嵌时侧栏穿出视口卡（P675-D1 ②）。
        row {
            style: "h-full min-h-screen bg-background text-foreground"

            // Sidebar (desktop) — relative flex child, not fixed
            col {
                style: "w-60 shrink-0 h-full border-r border-border bg-card hidden md:flex flex-col"
                row {
                    style: "items-center gap-2 p-5 border-b border-border shrink-0"
                    text "📖" { style: "text-xl" }
                    text "AutoRead" { style: "font-bold text-lg text-foreground" }
                }
                // Plan 562: nav → sidebar 族（nav 退役）。外壳 col 承担
                // w-60 宽度；provider class 覆盖 min-h-svh/w-full 默认。
                sidebar_provider (class: "w-auto min-h-0 flex flex-1 flex-col") {
                    sidebar_menu (style: "p-3 flex-1 overflow-y-auto") {
                        // Plan 548 D2: menu_button(to:) 路由模式 —— Vue hash
                        // URL + 浏览器返回；VM __navigate + router.back() 历史栈。
                        sidebar_menu_item {
                            sidebar_menu_button (to: "/", exact: true) {
                                text "📚" {}
                                text "Library" {}
                            }
                        }
                        sidebar_menu_item {
                            sidebar_menu_button (to: "/settings") {
                                text "⚙️" {}
                                text "Settings" {}
                            }
                        }
                    }
                }
            }

            // Main content
            col {
                style: "flex-1 min-w-0 h-full flex flex-col"
                // Mobile top bar
                row {
                    style: "h-14 border-b border-border bg-card items-center px-4 gap-4 md:hidden shrink-0"
                    text "📖 AutoRead" { style: "font-bold text-foreground" }
                    row { style: "flex-1" }
                    link (to: "/") { text "Library" { style: sub_text } }
                    link (to: "/settings") { text "Settings" { style: sub_text } }
                }
                outlet
            }
        }
    }

    on {
        .Init -> { store.Init() }
    }
}
