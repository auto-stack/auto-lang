// app.at — Book Reader shell. Multi-page routes + sidebar nav + outlet.
// Plan 399 018: first example to fuse routes (auto-read architecture) with a
// strong-typed rust backend (015/017 CRUD pattern).
use book_store: BooksStore

widget App {
    routes {
        "/" -> use bookshelf
        "/book/:id" -> use book_detail
        "/book/:id/chapter/:ch" -> use reading
        "/settings" -> use settings
    }

    msg { Init }

    view {
        row {
            style: "min-h-screen bg-background text-foreground"

            // Sidebar (desktop)
            col {
                style: "w-60 border-r border-border bg-card hidden md:flex flex-col fixed inset-y-0 z-40"
                row {
                    style: "items-center gap-2 p-5 border-b border-border"
                    text "📖" { style: "text-xl" }
                    text "AutoRead" { style: "font-bold text-lg text-foreground" }
                }
                nav {
                    style: "p-3 gap-1 flex-1 flex flex-col"
                    // Plan 482: nav-item(to:) 路由模式 —— Vue hash URL + 浏览器
                    // 返回；VM __navigate + router.back() 历史栈。选中态主色调
                    // 高亮由 to 自动判定（/ 对 /book/1 不误亮——前缀段匹配）。
                    nav-item (to: "/", exact: true, icon: "📚", label: "Library")
                    nav-item (to: "/settings", icon: "⚙️", label: "Settings")
                }
                // Runtime dark/light toggle (handmade ThemeToggle.vue escape hatch).
                row {
                    style: "p-4 border-t border-border justify-end"
                    theme-toggle {}
                }
            }

            // Main content
            col {
                style: "flex-1 md:ml-60"
                // Mobile top bar
                row {
                    style: "h-14 border-b border-border bg-card items-center px-4 gap-4 md:hidden"
                    text "📖 AutoRead" { style: "font-bold text-foreground" }
                    row { style: "flex-1" }
                    link (to: "/") { text "Library" { style: "text-sm text-muted-foreground" } }
                    link (to: "/settings") { text "Settings" { style: "text-sm text-muted-foreground" } }
                    theme-toggle {}
                }
                outlet
            }
        }
    }

    on {
        .Init -> { store.Init() }
    }
}
