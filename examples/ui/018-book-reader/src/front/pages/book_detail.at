// book_detail.at — "/book/:id" 书籍详情 + 章节目录。
use fmt: pct1

/// progress → 当前章（1-based）；与 bookshelf 的同名 fn 去重（T-15：重名定义毒化链接符号表）。
fn detail_chapter_from_progress(progress int, chapter_count int) int {
    if chapter_count <= 0 {
        return 1
    }
    if progress <= 0 {
        return 1
    }
    let computed int = (progress * chapter_count / 100) as int
    if computed < 1 {
        return 1
    }
    if computed > chapter_count {
        return chapter_count
    }
    return computed
}

widget book_detail {
    msg { Init, Back, ReadChapter(int), ContinueReading, OpenChapter(int) }

    model {
        var book_id int = 0
        var book = null
        var has_book bool = false
        var chapters = []
        var chapters_label str = "0 entries"
        var loaded bool = false
        var current_ch int = 1
        var progress_label str = ""
    }

    view {
        col {
            style: "p-6 md:p-10 gap-6 max-w-4xl mx-auto w-full"
            button {
                onclick: .Back
                style: "inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors w-fit shrink-0"
                text "← Library" {}
            }
            if .loaded {
                if .has_book == false {
                    col {
                        style: "items-center justify-center py-20 gap-3 text-muted-foreground"
                        text "📖" { style: "text-5xl opacity-40" }
                        text "Book not found" { style: "font-medium" }
                    }
                } else {
                    col {
                        style: "gap-6"
                        text .book.title { style: "text-2xl font-bold text-foreground" }
                        text .book.author { style: "text-muted-foreground" }
                        text .chapters_label { style: "text-xs text-muted-foreground" }
                        // PLAN-712 r3：章节目录列表——点击进阅读页（此前本页
                        // 只有计数标签，章节入口只能绕 ContinueReading）。
                        col {
                            style: "gap-1"
                            for ch in .chapters {
                                button {
                                    onclick: .OpenChapter(ch.number)
                                    style: "w-full text-left px-3 py-2 rounded-md hover:bg-muted transition-colors cursor-pointer"
                                    text ch.title { style: "text-sm text-foreground" }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            .book_id = router.param("id")
            try {
                .book = Http.get_json("/api/books/" + .book_id.to_string())
                .chapters = Http.get_json("/api/books/" + .book_id.to_string() + "/chapters")
                .has_book = true
                .chapters_label = .chapters.len().to_string() + " entries"
            } catch {
                .has_book = false
                .chapters = []
                .chapters_label = "0 entries"
            }
            if .has_book == true {
                .current_ch = detail_chapter_from_progress(.book.progress, .book.chapter_count)
                .progress_label = pct1(.book.progress) + "%"
            }
            .loaded = true
        }
        .Back -> { router.push("/") }
        // PLAN-712 r3：点章节 → 阅读页（路由 /book/:id/chapter/:ch）。
        .OpenChapter(n int) -> {
            router.push("/book/" + .book_id.to_string() + "/chapter/" + n.to_string())
        }
        .ContinueReading -> {
            var current int = 1
            if .has_book == true {
                current = detail_chapter_from_progress(.book.progress, .book.chapter_count)
            }
            router.push("/book/" + .book_id.to_string() + "/chapter/" + current.to_string())
        }
    }
}
