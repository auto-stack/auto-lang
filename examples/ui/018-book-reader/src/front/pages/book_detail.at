// book_detail.at — "/book/:id" 书籍详情 + 章节目录。
// PLAN-684 F-3：左封面/元信息，右编号 TOC 列表（当前章高亮）；主 CTA =
// Continue/Start。不再用 4 列密网格。
// PLAN-043 走查修复（2026-09-24）：`use back.api` 直接导入 VM 轨不可解析
// ——数据改 Http.get_json 拉（/api/books/:id 与 /chapters，lazy back 随请求
// 孵化）；`?Book`/`[]Chapter` 类型随 use 失效，model 退无类型 + null 语义。
use fmt: pct1

style btn_primary_xl = "mt-3 inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors"
style row_gap1 = "items-center gap-1"

/// progress → 当前章（1-based）。
fn chapter_from_progress(progress int, chapter_count int) int {
    if chapter_count <= 0 {
        return 1
    }
    if progress <= 0 {
        return 1
    }
    let computed int = (progress * chapter_count / 100) as int
    if computed < 1 {
        return 1
    }
    if computed > chapter_count {
        return chapter_count
    }
    return computed
}

widget book_detail {
    msg { Init, Back, ReadChapter(int), ContinueReading }

    model {
        var book_id int = 0
        var book = null
        var chapters = []
        var loaded bool = false
        var current_ch int = 1
        var progress_label str = ""
    }

    view {
        col {
            style: "p-6 md:p-10 gap-6 max-w-4xl mx-auto w-full"

            button {
                onclick: .Back
                style: "inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors w-fit shrink-0"
                text "← Library" {}
            }

            if .loaded {
                if .book == null {
                    col {
                        style: "items-center justify-center py-20 gap-3 text-muted-foreground"
                        text "📖" { style: "text-5xl opacity-40" }
                        text "Book not found" { style: "font-medium" }
                    }
                } else {
                    row {
                        style: "gap-6 flex-col md:flex-row"
                        // Cover + meta
                        col {
                            style: "w-36 h-52 rounded-xl bg-gradient-to-br " + .book.cover_color + " items-center justify-center flex-shrink-0 shadow-lg"
                            text "📖" { style: "text-4xl text-white/70" }
                        }
                        col {
                            style: "gap-2 flex-1 min-w-0"
                            h1 .book.title { style: "text-2xl font-bold text-foreground" }
                            text .book.author { style: "text-muted-foreground" }
                            row {
                                style: "items-center gap-3 text-sm text-muted-foreground flex-wrap mt-1"
                                row {
                                    style: row_gap1
                                    text "📑" {}
                                    text f"${.book.chapter_count} chapters" {}
                                }
                                row {
                                    style: row_gap1
                                    text "📝" {}
                                    text f"${.book.word_count} words" {}
                                }
                                if .book.progress > 0 {
                                    text .progress_label { style: "text-primary font-medium" }
                                }
                            }
                            if .book.progress > 0 {
                                if .book.progress < 100 {
                                    button {
                                        onclick: .ContinueReading
                                        style: btn_primary_xl
                                        text "📖 Continue Reading" {}
                                    }
                                } else {
                                    text "✓ Finished" { style: "mt-3 text-sm font-medium text-emerald-600 dark:text-emerald-400" }
                                }
                            } else {
                                button {
                                    onclick: .ReadChapter(1)
                                    style: btn_primary_xl
                                    text "📖 Start Reading" {}
                                }
                            }
                        }
                    }

                    // Chapter TOC — 编号列表，当前章高亮
                    col {
                        style: "mt-2 gap-2"
                        row {
                            style: "items-baseline justify-between"
                            text "Chapters" { style: "text-lg font-semibold text-foreground" }
                            text f"${.chapters.len()} entries" { style: "text-xs text-muted-foreground" }
                        }
                        col {
                            style: "gap-1"
                            for ch in .chapters {
                                row {
                                    onclick: .ReadChapter(ch.number)
                                    style: ["items-center gap-3 px-3 py-2.5 rounded-lg border transition-colors cursor-pointer",
                                        if ch.number == .current_ch {
                                            "border-primary bg-primary/10"
                                        } else {
                                            "border-transparent hover:bg-accent"
                                        }]
                                    text f"${ch.number}" {
                                        style: "text-xs font-mono text-muted-foreground w-6 shrink-0"
                                    }
                                    text ch.title {
                                        style: ["flex-1 truncate text-sm",
                                            if ch.number == .current_ch {
                                                "font-semibold text-foreground"
                                            } else {
                                                "text-foreground"
                                            }]
                                    }
                                    if ch.number == .current_ch {
                                        text "Reading" { style: "text-xs text-primary shrink-0" }
                                    } else {
                                        text "→" { style: "text-muted-foreground shrink-0" }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            .book_id = router.param("id")
            .book = Http.get_json("/api/books/" + .book_id.to_string())
            .chapters = Http.get_json("/api/books/" + .book_id.to_string() + "/chapters")
            .current_ch = 1
            .progress_label = ""
            if .book != null {
                .current_ch = chapter_from_progress(.book.progress, .book.chapter_count)
                .progress_label = pct1(.book.progress) + "%"
            }
            .loaded = true
        }
        .Back -> { router.push("/") }
        .ReadChapter(n int) -> {
            router.push("/book/" + .book_id.to_string() + "/chapter/" + n.to_string())
        }
        .ContinueReading -> {
            var current int = 1
            if .book != null {
                current = chapter_from_progress(.book.progress, .book.chapter_count)
            }
            router.push("/book/" + .book_id.to_string() + "/chapter/" + current.to_string())
        }
    }
}
