// book_store.at — shared store. Persists the library + reading progress across
// all route pages (k1 pattern). Each page does `use store: BooksStore`.
use back.api: list_books, create_book, delete_book, update_progress

store BooksStore {
    model {
        var books []Book = []
        var loading bool = false
    }

    msg { Init, AddBook(str, str), RemoveBook(int), SetProgress(int, int) }

    on {
        .Init -> {
            // 先清 loading 再拉数：list_books 失败时不留 Loading 死态
            // （gallery 嵌入 back-proxy 500 时仍显示空书架引导）。
            .loading = false
            .books = list_books()
        }
        .AddBook(title str, author str) -> {
            create_book(title, author)
            .books = list_books()
        }
        .RemoveBook(id int) -> {
            delete_book(id)
            .books = list_books()
        }
        .SetProgress(id int, progress int) -> {
            update_progress(id, progress)
            .books = list_books()
        }
    }
}
