// app.at — 019-video-app root shell.
// Routes: "/" (Home) and "/watch/:id" (Watch page).
// Left sidebar navigation with VideoApp logo, Home nav item, and SettingsPanel popup.

use video_store: VideoStore
use settings: SettingsPanel

// PLAN-637 B5 Phase B 映射（tier 收敛，同 008/009 口径）：zinc-100/gray-900→foreground；
// zinc-400/300・gray-500/400→muted-foreground；bg-zinc-800/gray-100→bg-muted；
// bg-zinc-900/white→bg-card；border-zinc-800/700/gray-200→border-border。text-white ×4
// 为视频缩略图叠字（图像上恒白，豁免）。
widget App {
    routes {
        "/" -> use home
        "/watch/:id" -> use watch
    }

    msg {
        Init,
        GoHome,
        ToggleSettings,
        CloseSettings,
        ToggleDarkMode,
        SetPink,
        SetIndigo,
        SetOcean,
        SetSage,
        SetAmber,
    }

    view {
        row {
            style: if .store.dark_mode {
                "w-full min-h-screen bg-background text-foreground flex"
            } else {
                "w-full min-h-screen bg-background text-foreground flex"
            }

            // ── Left Sidebar Navigation ──
            col {
                style: if .store.dark_mode {
                    "w-64 min-h-screen bg-card border-r border-border shrink-0 flex flex-col"
                } else {
                    "w-64 min-h-screen bg-card border-r border-border shrink-0 flex flex-col"
                }

                // Top: Brand Logo & Navigation
                col {
                    style: "flex-1 p-4 gap-4 flex flex-col"

                    // Logo
                    row {
                        onclick: .GoHome
                        style: "items-center gap-2.5 px-2 py-1 cursor-pointer"
                        text "📺" { style: "text-2xl" }
                        text "VideoApp" {
                            style: if .store.accent_color == "pink" {
                                "text-xl font-extrabold text-pink-500 tracking-tight"
                            } else if .store.accent_color == "indigo" {
                                "text-xl font-extrabold text-indigo-500 tracking-tight"
                            } else if .store.accent_color == "ocean" {
                                "text-xl font-extrabold text-sky-500 tracking-tight"
                            } else if .store.accent_color == "sage" {
                                "text-xl font-extrabold text-emerald-500 tracking-tight"
                            } else {
                                "text-xl font-extrabold text-amber-500 tracking-tight"
                            }
                        }
                    }

                    // Navigation items (Plan 562: nav-item → sidebar 族 menu_button)
                    sidebar_provider (class: "w-auto min-h-0 flex flex-col") {
                        sidebar_menu (style: "mt-2") {
                            sidebar_menu_item {
                                sidebar_menu_button (to: "/", exact: true) {
                                    text "🏠" {}
                                    text "Home" {}
                                }
                            }
                        }
                    }
                }

                // Bottom: Settings Popup Panel & Trigger Button
                col {
                    style: if .store.dark_mode {
                        "p-3 gap-2 border-t border-border shrink-0"
                    } else {
                        "p-3 gap-2 border-t border-border shrink-0"
                    }

                    if .store.show_settings {
                        SettingsPanel(
                            dark_mode: .store.dark_mode,
                            accent_color: .store.accent_color,
                            on_close: .CloseSettings,
                            on_toggle_dark: .ToggleDarkMode,
                            on_set_pink: .SetPink,
                            on_set_indigo: .SetIndigo,
                            on_set_ocean: .SetOcean,
                            on_set_sage: .SetSage,
                            on_set_amber: .SetAmber
                        )
                    }

                    row {
                        style: "items-center justify-between"
                        button "⚙ Settings" {
                            onclick: .ToggleSettings
                            style: if .store.show_settings {
                                if .store.dark_mode {
                                    "px-3 py-2 text-xs font-semibold rounded-xl bg-muted text-pink-400 transition-colors cursor-pointer"
                                } else {
                                    "px-3 py-2 text-xs font-semibold rounded-xl bg-pink-50 text-pink-600 transition-colors cursor-pointer"
                                }
                            } else {
                                if .store.dark_mode {
                                    "px-3 py-2 text-xs font-medium rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted/60 bg-transparent transition-colors cursor-pointer"
                                } else {
                                    "px-3 py-2 text-xs font-medium rounded-xl text-foreground hover:text-foreground hover:bg-muted bg-transparent transition-colors cursor-pointer"
                                }
                            }
                        }
                        text "v1.0" {
                            style: if .store.dark_mode {
                                "text-xs text-muted-foreground mr-2"
                            } else {
                                "text-xs text-muted-foreground mr-2"
                            }
                        }
                    }
                }
            }

            // ── Main Content Area ──
            col {
                style: "flex-1 w-full min-h-screen overflow-y-auto flex-col"
                outlet
            }
        }
    }

    on {
        .Init -> { store.Init() }
        .GoHome -> { router.push("/") }
        .ToggleSettings -> { store.ToggleSettings() }
        .CloseSettings -> { store.CloseSettings() }
        .ToggleDarkMode -> { store.ToggleDarkMode() }
        .SetPink -> { store.SetAccent("pink") }
        .SetIndigo -> { store.SetAccent("indigo") }
        .SetOcean -> { store.SetAccent("ocean") }
        .SetSage -> { store.SetAccent("sage") }
        .SetAmber -> { store.SetAccent("amber") }
    }
}
