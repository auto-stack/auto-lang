// home.at — VideoApp Home page ("/" route).
// Category chips, tabs, search bar, and video card grid.

use store: VideoStore

widget home {
    msg {
        Init,
        SelectCategory(str),
        SelectTab(str),
        SearchInput(str),
        SearchSubmit,
        OpenVideo(int),
    }

    model {
        var search_text str = ""
    }

    view {
        col {
            style: "w-full flex-1 flex-col"

            // ── Top Header: Search Bar ──
            row {
                style: if .store.dark_mode {
                    "w-full items-center justify-between px-6 py-3.5 border-b border-zinc-800 bg-zinc-900/60 backdrop-blur shrink-0 gap-4"
                } else {
                    "w-full items-center justify-between px-6 py-3.5 border-b border-gray-200 bg-white/80 backdrop-blur shrink-0 gap-4"
                }

                // Search input container
                row {
                    style: if .store.dark_mode {
                        "flex-1 max-w-xl items-center px-4 py-2 bg-zinc-800/80 border border-zinc-700 rounded-full gap-2 focus-within:border-primary transition-colors"
                    } else {
                        "flex-1 max-w-xl items-center px-4 py-2 bg-gray-100 border border-gray-200 rounded-full gap-2 focus-within:border-primary transition-colors"
                    }
                    text "🔍" { style: "text-xs opacity-60" }
                    input {
                        value: .search_text
                        oninput: .SearchInput
                        placeholder: "Search videos, creators, topics..."
                        style: if .store.dark_mode {
                            "flex-1 bg-transparent text-sm text-zinc-100 outline-none border-none placeholder:text-zinc-500"
                        } else {
                            "flex-1 bg-transparent text-sm text-gray-900 outline-none border-none placeholder:text-gray-400"
                        }
                    }
                }

                // Header right badges
                row {
                    style: "items-center gap-3"
                    text "🔔" { style: "text-sm text-muted-foreground cursor-pointer" }
                    row {
                        style: if .store.dark_mode {
                            "items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-800 border border-zinc-700 cursor-pointer"
                        } else {
                            "items-center gap-2 px-3 py-1.5 rounded-full bg-gray-100 border border-gray-200 cursor-pointer"
                        }
                        text "👤" { style: "text-sm" }
                        text "User" { style: "text-xs font-medium text-foreground" }
                    }
                }
            }

            // ── Navigation Tabs: Recommend / Trending / Following ──
            row {
                style: if .store.dark_mode {
                    "w-full px-6 pt-3 pb-1 gap-6 border-b border-zinc-800/60 items-center"
                } else {
                    "w-full px-6 pt-3 pb-1 gap-6 border-b border-gray-200/60 items-center"
                }

                button {
                    onclick: .SelectTab("recommend")
                    variant: "ghost"
                    style: "p-0 h-auto bg-transparent hover:bg-transparent rounded-none cursor-pointer"
                    col {
                        style: "items-center gap-1.5"
                        text "Recommend" {
                            style: if .store.active_tab == "recommend" {
                                "text-sm font-bold text-primary"
                            } else {
                                "text-sm font-medium text-muted-foreground hover:text-foreground"
                            }
                        }
                        col {
                            style: if .store.active_tab == "recommend" {
                                "w-full h-0.5 bg-primary rounded-full"
                            } else {
                                "w-full h-0.5 bg-transparent"
                            }
                        }
                    }
                }

                button {
                    onclick: .SelectTab("trending")
                    variant: "ghost"
                    style: "p-0 h-auto bg-transparent hover:bg-transparent rounded-none cursor-pointer"
                    col {
                        style: "items-center gap-1.5"
                        text "Trending" {
                            style: if .store.active_tab == "trending" {
                                "text-sm font-bold text-primary"
                            } else {
                                "text-sm font-medium text-muted-foreground hover:text-foreground"
                            }
                        }
                        col {
                            style: if .store.active_tab == "trending" {
                                "w-full h-0.5 bg-primary rounded-full"
                            } else {
                                "w-full h-0.5 bg-transparent"
                            }
                        }
                    }
                }

                button {
                    onclick: .SelectTab("following")
                    variant: "ghost"
                    style: "p-0 h-auto bg-transparent hover:bg-transparent rounded-none cursor-pointer"
                    col {
                        style: "items-center gap-1.5"
                        text "Following" {
                            style: if .store.active_tab == "following" {
                                "text-sm font-bold text-primary"
                            } else {
                                "text-sm font-medium text-muted-foreground hover:text-foreground"
                            }
                        }
                        col {
                            style: if .store.active_tab == "following" {
                                "w-full h-0.5 bg-primary rounded-full"
                            } else {
                                "w-full h-0.5 bg-transparent"
                            }
                        }
                    }
                }
            }

            // ── Category Chips Row ──
            row {
                style: if .store.dark_mode {
                    "w-full gap-2 px-6 py-3 border-b border-zinc-800/80 items-center overflow-x-auto shrink-0"
                } else {
                    "w-full gap-2 px-6 py-3 border-b border-gray-200/80 items-center overflow-x-auto shrink-0"
                }

                button "All" {
                    onclick: .SelectCategory("All")
                    style: if .store.active_category == "All" {
                        "px-4 py-1.5 text-xs font-semibold bg-primary text-primary-foreground rounded-full shadow-sm cursor-pointer transition-colors"
                    } else {
                        if .store.dark_mode {
                            "px-4 py-1.5 text-xs font-medium bg-zinc-800 text-zinc-300 hover:bg-zinc-700 rounded-full cursor-pointer transition-colors"
                        } else {
                            "px-4 py-1.5 text-xs font-medium bg-gray-200 text-gray-700 hover:bg-gray-300 rounded-full cursor-pointer transition-colors"
                        }
                    }
                }

                for cat in .store.all_categories {
                    button cat {
                        onclick: .SelectCategory(cat)
                        style: if .store.active_category == cat {
                            "px-4 py-1.5 text-xs font-semibold bg-primary text-primary-foreground rounded-full shadow-sm cursor-pointer transition-colors"
                        } else {
                            if .store.dark_mode {
                                "px-4 py-1.5 text-xs font-medium bg-zinc-800 text-zinc-300 hover:bg-zinc-700 rounded-full cursor-pointer transition-colors"
                            } else {
                                "px-4 py-1.5 text-xs font-medium bg-gray-200 text-gray-700 hover:bg-gray-300 rounded-full cursor-pointer transition-colors"
                            }
                        }
                    }
                }
            }

            // ── Video Grid ──
            if .store.loading {
                col {
                    style: "w-full items-center justify-center py-24 gap-3 text-muted-foreground"
                    text "Loading videos…" { style: "text-sm" }
                }
            } else {
                if .store.videos.len() == 0 {
                    col {
                        style: "w-full items-center justify-center py-24 gap-3 text-muted-foreground"
                        text "🎬" { style: "text-5xl opacity-40" }
                        text "No videos found" { style: "font-semibold text-foreground text-base" }
                        text "Try selecting another category or clear search filter" { style: "text-sm text-muted-foreground" }
                    }
                } else {
                    grid {
                        cols: 3
                        gap: 24
                        style: "p-6"
                        for video in .store.videos {
                            col {
                                onclick: .OpenVideo(video.id)
                                style: if .store.dark_mode {
                                    "bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden hover:border-zinc-700 transition-all shadow-md group cursor-pointer"
                                } else {
                                    "bg-white border border-gray-200 rounded-2xl overflow-hidden hover:border-gray-300 transition-all shadow-sm group cursor-pointer"
                                }

                                // Thumbnail box
                                col {
                                    class: "w-full h-44 bg-gradient-to-br " + video.cover_color + " items-center justify-center p-3 relative rounded-t-2xl"
                                    text "▶" { style: "text-4xl text-white/80 group-hover:scale-110 transition-transform" }
                                    row {
                                        style: "absolute bottom-2 right-2 bg-black/80 px-2 py-0.5 rounded-md"
                                        text video.duration { style: "text-[11px] font-medium text-white" }
                                    }
                                    row {
                                        style: "absolute top-2 left-2 bg-black/40 backdrop-blur px-2 py-0.5 rounded-md"
                                        text video.category { style: "text-[10px] font-semibold text-white uppercase tracking-wider" }
                                    }
                                }

                                // Info block
                                col {
                                    style: "p-4 gap-1.5"
                                    text video.title {
                                        style: "text-sm font-bold text-foreground leading-snug line-clamp-2"
                                    }
                                    row {
                                        style: "items-center gap-2 text-xs text-muted-foreground"
                                        text video.author { style: "font-medium text-foreground/80" }
                                        text "•" {}
                                        text f"${video.views_fmt} views" {}
                                        text "•" {}
                                        text f"❤️ ${video.likes_fmt}" {}
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> { store.Init() }
        .SelectCategory(cat) -> { store.SetCategory(cat) }
        .SelectTab(tab) -> { store.SetTab(tab) }
        .SearchInput(text) -> {
            .search_text = text
            store.SetQuery(text)
        }
        .SearchSubmit -> { store.SetQuery(.search_text) }
        .OpenVideo(id) -> { router.push("/watch/" + id.to_string()) }
    }
}
