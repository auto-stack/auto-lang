// ═══════════════════════════════════════════════════════════
// Video operations
// ═══════════════════════════════════════════════════════════

pub fn all_categories() []str {
    return ["Gaming", "Music", "Tech", "Food", "Travel"]
}

pub fn all_videos() []Video {
    return videos
}

pub fn find_video(id int) ?Video {
    for v in videos {
        if v.id == id {
            return Some(v)
        }
    }
    return None
}

pub fn format_count(n int) str {
    if n >= 1000000 {
        let m = n / 1000000
        let rem = (n % 1000000) / 100000
        if rem > 0 {
            return m.to_string() + "." + rem.to_string() + "M"
        } else {
            return m.to_string() + "M"
        }
    } else if n >= 1000 {
        let k = n / 1000
        let rem = (n % 1000) / 100
        if rem > 0 && k < 10 {
            return k.to_string() + "." + rem.to_string() + "K"
        } else {
            return k.to_string() + "K"
        }
    } else {
        return n.to_string()
    }
}

pub fn add_view(id int) int {
    var new_videos List<Video> = List<Video>.new([])
    var new_views int = 0
    for v in videos {
        if v.id == id {
            let nv = v.views + 1
            let updated = Video {
                id: v.id,
                title: v.title,
                author: v.author,
                category: v.category,
                duration: v.duration,
                views: nv,
                likes: v.likes,
                views_fmt: format_count(nv),
                likes_fmt: v.likes_fmt,
                desc: v.desc,
                followed: v.followed,
                cover_color: v.cover_color,
            }
            new_views = updated.views
            new_videos.push(updated)
        } else {
            new_videos.push(v)
        }
    }
    videos = new_videos
    return new_views
}

pub fn toggle_like(id int) int {
    var new_videos List<Video> = List<Video>.new([])
    var new_likes int = 0
    for v in videos {
        if v.id == id {
            let nl = v.likes + 1
            let updated = Video {
                id: v.id,
                title: v.title,
                author: v.author,
                category: v.category,
                duration: v.duration,
                views: v.views,
                likes: nl,
                views_fmt: v.views_fmt,
                likes_fmt: format_count(nl),
                desc: v.desc,
                followed: v.followed,
                cover_color: v.cover_color,
            }
            new_likes = updated.likes
            new_videos.push(updated)
        } else {
            new_videos.push(v)
        }
    }
    videos = new_videos
    return new_likes
}

pub fn filter_videos(category str, tab str, q str) []Video {
    var filtered List<Video> = List<Video>.new([])
    for v in videos {
        var ok bool = true
        if category != "" && category != "All" {
            if v.category != category {
                ok = false
            }
        }
        if tab == "following" {
            if !v.followed {
                ok = false
            }
        }
        if q != "" {
            if !v.title.contains(q) && !v.author.contains(q) {
                ok = false
            }
        }
        if ok {
            filtered.push(v)
        }
    }

    if tab == "trending" {
        var n int = filtered.len()
        var i int = 0
        loop {
            if i >= n {
                break
            }
            var j int = i + 1
            loop {
                if j >= n {
                    break
                }
                if filtered[j].views > filtered[i].views {
                    let temp = filtered[i]
                    filtered[i] = filtered[j]
                    filtered[j] = temp
                }
                j = j + 1
            }
            i = i + 1
        }
    }

    return filtered
}
