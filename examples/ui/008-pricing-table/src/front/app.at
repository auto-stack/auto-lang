// app.at — Pricing Table.
// PLAN-637 B2 Phase B 映射（2026-09-17）：zinc/gray 明暗条件对按角色收敛到同 token——
// zinc-100/gray-900→foreground；zinc-400/gray-500→muted-foreground；zinc-300/gray-700
// →foreground（特性行正文）；卡片 bg-zinc-900/bg-white→bg-card、border-zinc-800/gray-200→
// border-border（shadow-lg/sm 差异保留条件）；plan3 按钮 zinc-800/gray-800 系→secondary 族
// （双臂全同）；页根 zinc-950/gray-50→bg-background（双臂全同）。条件结构保留（结构简化
// 不属本计划授权面）。Phase A 提取：feat_check ×12 / feat_check_muted ×6 / feat_list ×3 /
// title_block ×3；Phase B 收敛提取：feat_text ×18 / plan_name ×3 / plan_subtitle ×3 /
// plan_price ×3。

// Plan 506: in-app title bar / Settings panel removed (common header widget
// retired) — title/theme/accent live in pac.at + os-config, host chrome carries them.
// Default theme: Dark mode.
// PLAN-637 B2 Phase A：重复 class 串提取为本地配方（体 ≡ 原字面量，
// 展开后逐字节等价；单类短串（如 items-center）按不过度抽象口径豁免）。
style feat_check = "text-primary font-bold mr-2.5 text-sm"
style feat_check_muted = "text-muted-foreground font-bold mr-2.5 text-sm"   // Phase B: zinc-400 → muted-foreground
style feat_list = "gap-3.5 my-5 flex-1"
style title_block = "gap-1 items-center"
style feat_text = "text-sm text-foreground"   // Phase B：明暗臂收敛（zinc-300/gray-700→foreground）
style plan_name = "text-lg font-bold text-foreground"   // Phase B 收敛提取
style plan_subtitle = "text-xs text-muted-foreground"   // Phase B 收敛提取
style plan_price = "text-4xl font-extrabold text-foreground mt-2"   // Phase B 收敛提取

widget App {
    msg {
        BuyPlan1,
        BuyPlan2,
        BuyPlan3
    }

    model {
        var dark_mode bool = true
        var accent_color str = "indigo"   // declared for os-config/env seeding (Plan 504 idiom)

        // Single Developer
        var plan1_name str = "Single Developer"
        var plan1_subtitle str = "For individual developers"
        var plan1_price str = "$39"
        var plan1_devs str = "1 Developer"
        var plan1_btn str = "Buy Now"

        // Team
        var plan2_name str = "Team"
        var plan2_subtitle str = "For small teams"
        var plan2_price str = "$99"
        var plan2_devs str = "Up to 5 Developers"
        var plan2_btn str = "Buy Now"

        // Enterprise
        var plan3_name str = "Enterprise"
        var plan3_subtitle str = "For larger teams"
        var plan3_deal str = "Exclusive Deals"
        var plan3_devs str = "Unlimited Developers"
        var plan3_btn str = "Contact Us"

        // Shared features
        var feat1 str = "All Marketing + Application UI Blocks"
        var feat2 str = "Figma UI Kit"
        var feat3 str = "Lifetime Support"
        var feat4 str = "Unlimited Updates"
        var feat5 str = "Use on Unlimited Projects"
    }

    view {
        col {
            // ── Main Pricing Content ──
            col {
                // Section Header: Title uses Theme Accent Color
                col {
                    h2 "Pricing Plans" {
                        style: "text-3xl font-extrabold text-primary tracking-tight text-center"
                    }
                    span "Choose the plan that fits your needs" {
                        style: if .dark_mode {
                            "text-sm text-muted-foreground mt-1"
                        } else {
                            "text-sm text-muted-foreground mt-1"
                        }
                    }
                    style: "gap-1 items-center mb-2"
                }

                // 3 Cards Row
                row {
                    // Plan 1: Single Developer
                    col {
                        col {
                            h3 .plan1_name {
                                style: if .dark_mode {
                                    "text-lg font-bold text-foreground"
                                } else {
                                    "text-lg font-bold text-foreground"
                                }
                            }
                            span .plan1_subtitle {
                                style: if .dark_mode {
                                    "text-xs text-muted-foreground"
                                } else {
                                    "text-xs text-muted-foreground"
                                }
                            }
                            span .plan1_price {
                                style: if .dark_mode {
                                    "text-4xl font-extrabold text-foreground mt-2"
                                } else {
                                    "text-4xl font-extrabold text-foreground mt-2"
                                }
                            }
                            style: title_block
                        }
                        col {
                            row {
                                span "✓" { style: feat_check }
                                span .plan1_devs {
                                    style: feat_text
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: feat_check }
                                span .feat1 {
                                    style: feat_text
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: feat_check }
                                span .feat2 {
                                    style: feat_text
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: feat_check }
                                span .feat3 {
                                    style: feat_text
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: feat_check }
                                span .feat4 {
                                    style: feat_text
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: feat_check }
                                span .feat5 {
                                    style: feat_text
                                }
                                style: "items-center"
                            }
                            style: feat_list
                        }
                        button .plan1_btn {
                            onclick: .BuyPlan1
                            style: "w-full py-2.5 bg-primary hover:bg-primary/90 text-primary-foreground rounded-xl font-semibold transition-colors shadow-sm cursor-pointer"
                        }
                        style: if .dark_mode {
                            "bg-card rounded-2xl border border-border p-6 flex-1 max-w-[340px] min-w-[260px] shadow-lg justify-between"
                        } else {
                            "bg-card rounded-2xl border border-border p-6 flex-1 max-w-[340px] min-w-[260px] shadow-sm justify-between"
                        }
                    }

                    // Plan 2: Team (Recommended)
                    col {
                        col {
                            row {
                                span "RECOMMENDED" {
                                    style: "px-2.5 py-0.5 bg-primary text-primary-foreground text-xs font-bold rounded-full tracking-wide mb-1"
                                }
                                style: "justify-center"
                            }
                            h3 .plan2_name {
                                style: if .dark_mode {
                                    "text-lg font-bold text-foreground"
                                } else {
                                    "text-lg font-bold text-foreground"
                                }
                            }
                            span .plan2_subtitle {
                                style: if .dark_mode {
                                    "text-xs text-muted-foreground"
                                } else {
                                    "text-xs text-muted-foreground"
                                }
                            }
                            span .plan2_price {
                                style: if .dark_mode {
                                    "text-4xl font-extrabold text-foreground mt-2"
                                } else {
                                    "text-4xl font-extrabold text-foreground mt-2"
                                }
                            }
                            style: title_block
                        }
                        col {
                            row {
                                span "✓" { style: feat_check }
                                span .plan2_devs {
                                    style: feat_text
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: feat_check }
                                span .feat1 {
                                    style: feat_text
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: feat_check }
                                span .feat2 {
                                    style: feat_text
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: feat_check }
                                span .feat3 {
                                    style: feat_text
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: feat_check }
                                span .feat4 {
                                    style: feat_text
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: feat_check }
                                span .feat5 {
                                    style: feat_text
                                }
                                style: "items-center"
                            }
                            style: feat_list
                        }
                        button .plan2_btn {
                            onclick: .BuyPlan2
                            style: "w-full py-2.5 bg-primary hover:bg-primary/90 text-primary-foreground rounded-xl font-semibold transition-colors shadow-md cursor-pointer"
                        }
                        style: if .dark_mode {
                            "bg-card rounded-2xl border-2 border-primary p-6 flex-1 max-w-[340px] min-w-[260px] shadow-xl justify-between"
                        } else {
                            "bg-card rounded-2xl border-2 border-primary p-6 flex-1 max-w-[340px] min-w-[260px] shadow-md justify-between"
                        }
                    }

                    // Plan 3: Enterprise
                    col {
                        col {
                            h3 .plan3_name {
                                style: if .dark_mode {
                                    "text-lg font-bold text-foreground"
                                } else {
                                    "text-lg font-bold text-foreground"
                                }
                            }
                            span .plan3_subtitle {
                                style: if .dark_mode {
                                    "text-xs text-muted-foreground"
                                } else {
                                    "text-xs text-muted-foreground"
                                }
                            }
                            span .plan3_deal {
                                style: if .dark_mode {
                                    "text-4xl font-extrabold text-foreground mt-2"
                                } else {
                                    "text-4xl font-extrabold text-foreground mt-2"
                                }
                            }
                            style: title_block
                        }
                        col {
                            row {
                                span "✓" { style: feat_check_muted }
                                span .plan3_devs {
                                    style: feat_text
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: feat_check_muted }
                                span .feat1 {
                                    style: feat_text
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: feat_check_muted }
                                span .feat2 {
                                    style: feat_text
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: feat_check_muted }
                                span .feat3 {
                                    style: feat_text
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: feat_check_muted }
                                span .feat4 {
                                    style: feat_text
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: feat_check_muted }
                                span .feat5 {
                                    style: feat_text
                                }
                                style: "items-center"
                            }
                            style: feat_list
                        }
                        button .plan3_btn {
                            onclick: .BuyPlan3
                            style: if .dark_mode {
                                "w-full py-2.5 bg-secondary hover:bg-secondary/80 text-secondary-foreground border border-border rounded-xl font-semibold transition-colors shadow-sm cursor-pointer"
                            } else {
                                "w-full py-2.5 bg-secondary hover:bg-secondary/80 text-secondary-foreground border border-border rounded-xl font-semibold transition-colors shadow-sm cursor-pointer"
                            }
                        }
                        style: if .dark_mode {
                            "bg-card rounded-2xl border border-border p-6 flex-1 max-w-[340px] min-w-[260px] shadow-lg justify-between"
                        } else {
                            "bg-card rounded-2xl border border-border p-6 flex-1 max-w-[340px] min-w-[260px] shadow-sm justify-between"
                        }
                    }
                    style: "gap-6 max-w-5xl w-full items-stretch"
                }
                style: "w-full flex-1 px-8 py-6 gap-4 items-center justify-center max-w-6xl mx-auto"
            }

            style: if .dark_mode {
                "w-full min-h-screen bg-background text-foreground"
            } else {
                "w-full min-h-screen bg-background text-foreground"
            }
        }
    }

    on {
        .BuyPlan1 -> { print("Selected Plan: Single Developer") }
        .BuyPlan2 -> { print("Selected Plan: Team") }
        .BuyPlan3 -> { print("Selected Plan: Enterprise") }
    }
}

