// app.at — Pricing Table.
// Plan 506: in-app title bar / Settings panel removed (ExampleHeader retired)
// — title/theme/accent live in pac.at + os-config, host chrome carries them.
// Default theme: Dark mode.
widget App {
    msg {
        BuyPlan1,
        BuyPlan2,
        BuyPlan3
    }

    model {
        var dark_mode bool = true
        var accent_color str = "indigo"   // declared for os-config/env seeding (Plan 504 idiom)

        // Single Developer
        var plan1_name str = "Single Developer"
        var plan1_subtitle str = "For individual developers"
        var plan1_price str = "$39"
        var plan1_devs str = "1 Developer"
        var plan1_btn str = "Buy Now"

        // Team
        var plan2_name str = "Team"
        var plan2_subtitle str = "For small teams"
        var plan2_price str = "$99"
        var plan2_devs str = "Up to 5 Developers"
        var plan2_btn str = "Buy Now"

        // Enterprise
        var plan3_name str = "Enterprise"
        var plan3_subtitle str = "For larger teams"
        var plan3_deal str = "Exclusive Deals"
        var plan3_devs str = "Unlimited Developers"
        var plan3_btn str = "Contact Us"

        // Shared features
        var feat1 str = "All Marketing + Application UI Blocks"
        var feat2 str = "Figma UI Kit"
        var feat3 str = "Lifetime Support"
        var feat4 str = "Unlimited Updates"
        var feat5 str = "Use on Unlimited Projects"
    }

    view {
        col {
            // ── Main Pricing Content ──
            col {
                // Section Header: Title uses Theme Accent Color
                col {
                    h2 "Pricing Plans" {
                        style: "text-3xl font-extrabold text-primary tracking-tight text-center"
                    }
                    span "Choose the plan that fits your needs" {
                        style: if .dark_mode {
                            "text-sm text-zinc-400 mt-1"
                        } else {
                            "text-sm text-gray-500 mt-1"
                        }
                    }
                    style: "gap-1 items-center mb-2"
                }

                // 3 Cards Row
                row {
                    // Plan 1: Single Developer
                    col {
                        col {
                            h3 .plan1_name {
                                style: if .dark_mode {
                                    "text-lg font-bold text-zinc-100"
                                } else {
                                    "text-lg font-bold text-gray-900"
                                }
                            }
                            span .plan1_subtitle {
                                style: if .dark_mode {
                                    "text-xs text-zinc-400"
                                } else {
                                    "text-xs text-gray-500"
                                }
                            }
                            span .plan1_price {
                                style: if .dark_mode {
                                    "text-4xl font-extrabold text-zinc-100 mt-2"
                                } else {
                                    "text-4xl font-extrabold text-gray-900 mt-2"
                                }
                            }
                            style: "gap-1 items-center"
                        }
                        col {
                            row {
                                span "✓" { style: "text-primary font-bold mr-2.5 text-sm" }
                                span .plan1_devs {
                                    style: if .dark_mode { "text-sm text-zinc-300" } else { "text-sm text-gray-700" }
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: "text-primary font-bold mr-2.5 text-sm" }
                                span .feat1 {
                                    style: if .dark_mode { "text-sm text-zinc-300" } else { "text-sm text-gray-700" }
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: "text-primary font-bold mr-2.5 text-sm" }
                                span .feat2 {
                                    style: if .dark_mode { "text-sm text-zinc-300" } else { "text-sm text-gray-700" }
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: "text-primary font-bold mr-2.5 text-sm" }
                                span .feat3 {
                                    style: if .dark_mode { "text-sm text-zinc-300" } else { "text-sm text-gray-700" }
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: "text-primary font-bold mr-2.5 text-sm" }
                                span .feat4 {
                                    style: if .dark_mode { "text-sm text-zinc-300" } else { "text-sm text-gray-700" }
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: "text-primary font-bold mr-2.5 text-sm" }
                                span .feat5 {
                                    style: if .dark_mode { "text-sm text-zinc-300" } else { "text-sm text-gray-700" }
                                }
                                style: "items-center"
                            }
                            style: "gap-3.5 my-5 flex-1"
                        }
                        button .plan1_btn {
                            onclick: .BuyPlan1
                            style: "w-full py-2.5 bg-primary hover:bg-primary/90 text-primary-foreground rounded-xl font-semibold transition-colors shadow-sm cursor-pointer"
                        }
                        style: if .dark_mode {
                            "bg-zinc-900 rounded-2xl border border-zinc-800 p-6 flex-1 max-w-[340px] min-w-[260px] shadow-lg justify-between"
                        } else {
                            "bg-white rounded-2xl border border-gray-200 p-6 flex-1 max-w-[340px] min-w-[260px] shadow-sm justify-between"
                        }
                    }

                    // Plan 2: Team (Recommended)
                    col {
                        col {
                            row {
                                span "RECOMMENDED" {
                                    style: "px-2.5 py-0.5 bg-primary text-primary-foreground text-xs font-bold rounded-full tracking-wide mb-1"
                                }
                                style: "justify-center"
                            }
                            h3 .plan2_name {
                                style: if .dark_mode {
                                    "text-lg font-bold text-zinc-100"
                                } else {
                                    "text-lg font-bold text-gray-900"
                                }
                            }
                            span .plan2_subtitle {
                                style: if .dark_mode {
                                    "text-xs text-zinc-400"
                                } else {
                                    "text-xs text-gray-500"
                                }
                            }
                            span .plan2_price {
                                style: if .dark_mode {
                                    "text-4xl font-extrabold text-zinc-100 mt-2"
                                } else {
                                    "text-4xl font-extrabold text-gray-900 mt-2"
                                }
                            }
                            style: "gap-1 items-center"
                        }
                        col {
                            row {
                                span "✓" { style: "text-primary font-bold mr-2.5 text-sm" }
                                span .plan2_devs {
                                    style: if .dark_mode { "text-sm text-zinc-300" } else { "text-sm text-gray-700" }
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: "text-primary font-bold mr-2.5 text-sm" }
                                span .feat1 {
                                    style: if .dark_mode { "text-sm text-zinc-300" } else { "text-sm text-gray-700" }
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: "text-primary font-bold mr-2.5 text-sm" }
                                span .feat2 {
                                    style: if .dark_mode { "text-sm text-zinc-300" } else { "text-sm text-gray-700" }
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: "text-primary font-bold mr-2.5 text-sm" }
                                span .feat3 {
                                    style: if .dark_mode { "text-sm text-zinc-300" } else { "text-sm text-gray-700" }
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: "text-primary font-bold mr-2.5 text-sm" }
                                span .feat4 {
                                    style: if .dark_mode { "text-sm text-zinc-300" } else { "text-sm text-gray-700" }
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: "text-primary font-bold mr-2.5 text-sm" }
                                span .feat5 {
                                    style: if .dark_mode { "text-sm text-zinc-300" } else { "text-sm text-gray-700" }
                                }
                                style: "items-center"
                            }
                            style: "gap-3.5 my-5 flex-1"
                        }
                        button .plan2_btn {
                            onclick: .BuyPlan2
                            style: "w-full py-2.5 bg-primary hover:bg-primary/90 text-primary-foreground rounded-xl font-semibold transition-colors shadow-md cursor-pointer"
                        }
                        style: if .dark_mode {
                            "bg-zinc-900 rounded-2xl border-2 border-primary p-6 flex-1 max-w-[340px] min-w-[260px] shadow-xl justify-between"
                        } else {
                            "bg-white rounded-2xl border-2 border-primary p-6 flex-1 max-w-[340px] min-w-[260px] shadow-md justify-between"
                        }
                    }

                    // Plan 3: Enterprise
                    col {
                        col {
                            h3 .plan3_name {
                                style: if .dark_mode {
                                    "text-lg font-bold text-zinc-100"
                                } else {
                                    "text-lg font-bold text-gray-900"
                                }
                            }
                            span .plan3_subtitle {
                                style: if .dark_mode {
                                    "text-xs text-zinc-400"
                                } else {
                                    "text-xs text-gray-500"
                                }
                            }
                            span .plan3_deal {
                                style: if .dark_mode {
                                    "text-4xl font-extrabold text-zinc-100 mt-2"
                                } else {
                                    "text-4xl font-extrabold text-gray-900 mt-2"
                                }
                            }
                            style: "gap-1 items-center"
                        }
                        col {
                            row {
                                span "✓" { style: "text-zinc-400 font-bold mr-2.5 text-sm" }
                                span .plan3_devs {
                                    style: if .dark_mode { "text-sm text-zinc-300" } else { "text-sm text-gray-700" }
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: "text-zinc-400 font-bold mr-2.5 text-sm" }
                                span .feat1 {
                                    style: if .dark_mode { "text-sm text-zinc-300" } else { "text-sm text-gray-700" }
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: "text-zinc-400 font-bold mr-2.5 text-sm" }
                                span .feat2 {
                                    style: if .dark_mode { "text-sm text-zinc-300" } else { "text-sm text-gray-700" }
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: "text-zinc-400 font-bold mr-2.5 text-sm" }
                                span .feat3 {
                                    style: if .dark_mode { "text-sm text-zinc-300" } else { "text-sm text-gray-700" }
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: "text-zinc-400 font-bold mr-2.5 text-sm" }
                                span .feat4 {
                                    style: if .dark_mode { "text-sm text-zinc-300" } else { "text-sm text-gray-700" }
                                }
                                style: "items-center"
                            }
                            row {
                                span "✓" { style: "text-zinc-400 font-bold mr-2.5 text-sm" }
                                span .feat5 {
                                    style: if .dark_mode { "text-sm text-zinc-300" } else { "text-sm text-gray-700" }
                                }
                                style: "items-center"
                            }
                            style: "gap-3.5 my-5 flex-1"
                        }
                        button .plan3_btn {
                            onclick: .BuyPlan3
                            style: if .dark_mode {
                                "w-full py-2.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 border border-zinc-700 rounded-xl font-semibold transition-colors shadow-sm cursor-pointer"
                            } else {
                                "w-full py-2.5 bg-gray-800 hover:bg-gray-900 text-white rounded-xl font-semibold transition-colors shadow-sm cursor-pointer"
                            }
                        }
                        style: if .dark_mode {
                            "bg-zinc-900 rounded-2xl border border-zinc-800 p-6 flex-1 max-w-[340px] min-w-[260px] shadow-lg justify-between"
                        } else {
                            "bg-white rounded-2xl border border-gray-200 p-6 flex-1 max-w-[340px] min-w-[260px] shadow-sm justify-between"
                        }
                    }
                    style: "gap-6 max-w-5xl w-full items-stretch"
                }
                style: "w-full flex-1 px-8 py-6 gap-4 items-center justify-center max-w-6xl mx-auto"
            }

            style: if .dark_mode {
                "w-full min-h-screen bg-zinc-950 text-zinc-100"
            } else {
                "w-full min-h-screen bg-gray-50 text-gray-900"
            }
        }
    }

    on {
        .BuyPlan1 -> { print("Selected Plan: Single Developer") }
        .BuyPlan2 -> { print("Selected Plan: Team") }
        .BuyPlan3 -> { print("Selected Plan: Enterprise") }
    }
}

