// app.at — Article Feed.
// Plan 506: in-app title bar / Settings panel removed (common header widget
// retired) — title/theme/accent live in pac.at + os-config, host chrome carries them.
// Default theme: Dark mode.
// PLAN-637 B2（A+B 合并，小面授权）：Phase A 提取 art_tag/read_more/thumb_emoji/
// content_col 各 ×3；Phase B 映射：zinc-100/gray-900→foreground；zinc-400/gray-500
// /gray-600→muted-foreground；缩略图 bg-zinc-800/80・bg-gray-100→bg-muted、
// border-zinc-700/50・gray-200/50→border-border/50；卡片→bg-card/border-border、
// hover:border-zinc-700・gray-300→hover:border-foreground/20；页根→bg-background。
// 明暗双臂收敛为同串（条件结构保留）。

style art_tag = "text-xs font-semibold px-2.5 py-0.5 rounded-full bg-primary/10 text-primary"
style read_more = "p-0 h-auto text-sm text-primary font-semibold mt-2 hover:underline cursor-pointer"
style thumb_emoji = "text-3xl opacity-60"
style content_col = "gap-1 flex-1"

widget App {
    msg {
        ReadArticle1,
        ReadArticle2,
        ReadArticle3
    }

    model {
        var dark_mode bool = true
        var accent_color str = "indigo"   // declared for os-config/env seeding (Plan 504 idiom)

        // Header
        var header_title str = "Blog Posts"
        var header_subtitle str = "Discover the latest trends, tips, and best practices in modern web development. From UI components to design systems, stay updated with our expert insights."

        // Article 1
        var art1_tag str = "Tutorial"
        var art1_author str = "Sarah Chen"
        var art1_date str = "1 Jan 2024"
        var art1_title str = "Getting Started with shadcn/ui Components"
        var art1_excerpt str = "Learn how to quickly integrate and customize shadcn/ui components in your Next.js projects. Covers installation, theming, and best practices for building modern interfaces."

        // Article 2
        var art2_tag str = "Accessibility"
        var art2_author str = "Marcus Rodriguez"
        var art2_date str = "1 Jan 2024"
        var art2_title str = "Building Accessible Web Applications"
        var art2_excerpt str = "Explore how to create inclusive web experiences using shadcn/ui accessible components. Discover practical tips for implementing ARIA labels, keyboard navigation, and semantic HTML."

        // Article 3
        var art3_tag str = "Design Systems"
        var art3_author str = "Emma Thompson"
        var art3_date str = "1 Jan 2024"
        var art3_title str = "Modern Design Systems with Tailwind CSS"
        var art3_excerpt str = "Dive into creating scalable design systems using Tailwind CSS and shadcn/ui. Learn how to maintain consistency while building flexible and maintainable component libraries."
    }

    view {
        col {
            // ── Main Article Feed Content ──
            col {
                // Section Header
                col {
                    h2 .header_title {
                        style: if .dark_mode {
                            "text-3xl font-extrabold text-foreground tracking-tight text-center"
                        } else {
                            "text-3xl font-extrabold text-foreground tracking-tight text-center"
                        }
                    }
                    span .header_subtitle {
                        style: if .dark_mode {
                            "text-sm text-muted-foreground text-center max-w-xl mt-1"
                        } else {
                            "text-sm text-muted-foreground text-center max-w-xl mt-1"
                        }
                    }
                    style: "gap-1 items-center mb-2"
                }

                // Article 1
                row {
                    col {
                        span "📖" {
                            style: thumb_emoji
                        }
                        style: if .dark_mode {
                            "w-32 h-32 rounded-xl bg-muted border border-border/50 shrink-0 items-center justify-center"
                        } else {
                            "w-32 h-32 rounded-xl bg-muted border border-border/50 shrink-0 items-center justify-center"
                        }
                    }
                    col {
                        row {
                            span .art1_tag {
                                style: art_tag
                            }
                            style: "items-center"
                        }
                        row {
                            span .art1_author
                            span "·"
                            span .art1_date
                            style: if .dark_mode {
                                "text-xs text-muted-foreground gap-1.5 items-center mt-1"
                            } else {
                                "text-xs text-muted-foreground gap-1.5 items-center mt-1"
                            }
                        }
                        h3 .art1_title {
                            style: if .dark_mode {
                                "text-lg font-bold text-foreground mt-1 hover:text-primary transition-colors cursor-pointer"
                            } else {
                                "text-lg font-bold text-foreground mt-1 hover:text-primary transition-colors cursor-pointer"
                            }
                        }
                        span .art1_excerpt {
                            style: if .dark_mode {
                                "text-sm text-muted-foreground mt-1 leading-relaxed"
                            } else {
                                "text-sm text-muted-foreground mt-1 leading-relaxed"
                            }
                        }
                        button "Read more →" {
                            variant: "ghost"
                            onclick: .ReadArticle1
                            style: read_more
                        }
                        style: content_col
                    }
                    style: if .dark_mode {
                        "bg-card rounded-2xl border border-border p-6 gap-6 items-start shadow-lg w-full transition-all hover:border-foreground/20"
                    } else {
                        "bg-card rounded-2xl border border-border p-6 gap-6 items-start shadow-sm w-full transition-all hover:border-foreground/20"
                    }
                }

                // Article 2
                row {
                    col {
                        span "♿" {
                            style: thumb_emoji
                        }
                        style: if .dark_mode {
                            "w-32 h-32 rounded-xl bg-muted border border-border/50 shrink-0 items-center justify-center"
                        } else {
                            "w-32 h-32 rounded-xl bg-muted border border-border/50 shrink-0 items-center justify-center"
                        }
                    }
                    col {
                        row {
                            span .art2_tag {
                                style: art_tag
                            }
                            style: "items-center"
                        }
                        row {
                            span .art2_author
                            span "·"
                            span .art2_date
                            style: if .dark_mode {
                                "text-xs text-muted-foreground gap-1.5 items-center mt-1"
                            } else {
                                "text-xs text-muted-foreground gap-1.5 items-center mt-1"
                            }
                        }
                        h3 .art2_title {
                            style: if .dark_mode {
                                "text-lg font-bold text-foreground mt-1 hover:text-primary transition-colors cursor-pointer"
                            } else {
                                "text-lg font-bold text-foreground mt-1 hover:text-primary transition-colors cursor-pointer"
                            }
                        }
                        span .art2_excerpt {
                            style: if .dark_mode {
                                "text-sm text-muted-foreground mt-1 leading-relaxed"
                            } else {
                                "text-sm text-muted-foreground mt-1 leading-relaxed"
                            }
                        }
                        button "Read more →" {
                            variant: "ghost"
                            onclick: .ReadArticle2
                            style: read_more
                        }
                        style: content_col
                    }
                    style: if .dark_mode {
                        "bg-card rounded-2xl border border-border p-6 gap-6 items-start shadow-lg w-full transition-all hover:border-foreground/20"
                    } else {
                        "bg-card rounded-2xl border border-border p-6 gap-6 items-start shadow-sm w-full transition-all hover:border-foreground/20"
                    }
                }

                // Article 3
                row {
                    col {
                        span "🎨" {
                            style: thumb_emoji
                        }
                        style: if .dark_mode {
                            "w-32 h-32 rounded-xl bg-muted border border-border/50 shrink-0 items-center justify-center"
                        } else {
                            "w-32 h-32 rounded-xl bg-muted border border-border/50 shrink-0 items-center justify-center"
                        }
                    }
                    col {
                        row {
                            span .art3_tag {
                                style: art_tag
                            }
                            style: "items-center"
                        }
                        row {
                            span .art3_author
                            span "·"
                            span .art3_date
                            style: if .dark_mode {
                                "text-xs text-muted-foreground gap-1.5 items-center mt-1"
                            } else {
                                "text-xs text-muted-foreground gap-1.5 items-center mt-1"
                            }
                        }
                        h3 .art3_title {
                            style: if .dark_mode {
                                "text-lg font-bold text-foreground mt-1 hover:text-primary transition-colors cursor-pointer"
                            } else {
                                "text-lg font-bold text-foreground mt-1 hover:text-primary transition-colors cursor-pointer"
                            }
                        }
                        span .art3_excerpt {
                            style: if .dark_mode {
                                "text-sm text-muted-foreground mt-1 leading-relaxed"
                            } else {
                                "text-sm text-muted-foreground mt-1 leading-relaxed"
                            }
                        }
                        button "Read more →" {
                            variant: "ghost"
                            onclick: .ReadArticle3
                            style: read_more
                        }
                        style: content_col
                    }
                    style: if .dark_mode {
                        "bg-card rounded-2xl border border-border p-6 gap-6 items-start shadow-lg w-full transition-all hover:border-foreground/20"
                    } else {
                        "bg-card rounded-2xl border border-border p-6 gap-6 items-start shadow-sm w-full transition-all hover:border-foreground/20"
                    }
                }

                style: "w-full flex-1 px-8 py-6 gap-6 items-center justify-start max-w-4xl mx-auto"
            }

            style: if .dark_mode {
                "w-full min-h-screen bg-background text-foreground"
            } else {
                "w-full min-h-screen bg-background text-foreground"
            }
        }
    }

    on {
        .ReadArticle1 -> { print("Reading article 1") }
        .ReadArticle2 -> { print("Reading article 2") }
        .ReadArticle3 -> { print("Reading article 3") }
    }
}
