// pages/avatar.at - Avatar component documentation page

widget AvatarPage {
    model { activeTab str = "preview" }

    view {
        col {
            h1 "Avatar"
            text "Avatar displays a user's profile image with a text fallback when the image fails to load or is not provided. Ideal for user lists, comment sections, profile cards, and navigation bars. Supports small, medium, and large sizes to fit different UI densities."

            h2 "Installation"
            codeblock (lang: "bash", code: "npx shadcn-vue@latest add avatar") {}

            h2 "Simple"
            preview-card (id: "avatar-basic") {
                row (gap: "4") {
                    avatar (src: "https://github.com/shadcn.png", alt: "@shadcn") {}
                    avatar (fallback: "CN") {}
                }
            }

            h2 "Properties"
            table {
                thead {
                    tr {
                        th "Property"
                        th "Type"
                        th "Default"
                        th "Values"
                        th "Description"
                    }
                }
                tbody {
                    tr {
                        td "src"
                        td "string"
                        td "-"
                        td "-"
                        td "Image source URL"
                    }
                    tr {
                        td "alt"
                        td "string"
                        td "-"
                        td "-"
                        td "Alt text for accessibility"
                    }
                    tr {
                        td "fallback"
                        td "string"
                        td "-"
                        td "-"
                        td "Fallback text when image fails"
                    }
                }
            }
        }
    }
}
