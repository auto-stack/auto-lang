// pages/grid.at — Verify #1: 'grid' is no longer a reserved keyword.
// This page + route name 'grid' would previously fail to parse.
widget GridPage {
    view {
        col {
            style: "space-y-4"
            h2 "Grid (route name fix #1)" { style: "text-xl font-semibold" }
            text "This page's widget is named GridPage and its route is '/grid'. Previously 'grid' was a reserved keyword and caused a parse error." { style: "text-muted-foreground" }
            text "If you can see this page, fix #1 works." { style: "text-sm font-medium" }
        }
    }
}
