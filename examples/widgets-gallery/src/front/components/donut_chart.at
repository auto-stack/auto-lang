// components/donut_chart.at - AutoDonutChart component (Plan 437 Phase 2 ④)
//
// 官方 Auto 实现的圆环图(d3-arc 风格:外弧 A → 内弧回程 Z,大弧标志
// span>π)。角度由数据占比循环累进计算,math.cos/sin 直调(§0.6.H 三层
// 缺陷已修,防御性直线几何按计划指示顺势清理恢复循环形态)。
// 渲染端 v1 = SVG 子树直通(442 A4)。纪律(§0.6.D)同 line_chart.at。

widget AutoDonutChart (data: List, index: str = "l", field: str = "v", colors: List<str> = ["#2563eb", "#16a34a", "#d97706", "#dc2626"]) {
    msg { Init }

    model {
        // 几何输出(Init 计算):每片 { d: path, c: color } 段记录
        segs List = []
        legend str = ""
    }

    on {
        .Init -> {
            // ---- 总量(占比分母) ----
            var total int = 0
            for d in .data {
                var v = d[.field]
                total = total + v
            }
            var totalf float = total
            var cx float = 280.0
            var cy float = 150.0
            var rOut float = 100.0
            var rIn float = 62.0
            var a0 float = -1.5707963267948966
            // ---- 每片:外弧 A → 内弧回程 Z(laf = span > π) ----
            var outSegs List = []
            var cs = .colors
            var ccount int = cs.len()
            var k int = 0
            for d in .data {
                var vf float = d[.field]
                var span float = 6.283185307179586 * vf / totalf
                var a1 float = a0 + span
                var laf int = 0
                if span > 3.141592653589793 {
                    laf = 1
                }
                var c0 float = math.cos(a0)
                var s0 float = math.sin(a0)
                var c1 float = math.cos(a1)
                var s1 float = math.sin(a1)
                var x0 float = cx + rOut * c0
                var y0 float = cy + rOut * s0
                var x1 float = cx + rOut * c1
                var y1 float = cy + rOut * s1
                var u0 float = cx + rIn * c0
                var v0 float = cy + rIn * s0
                var u1 float = cx + rIn * c1
                var v1 float = cy + rIn * s1
                var dstr = f"M${x0} ${y0} A100 100 0 ${laf} 1 ${x1} ${y1} L${u1} ${v1} A62 62 0 ${laf} 0 ${u0} ${v0} Z"
                var ci int = k
                if ci >= ccount {
                    ci = ccount - 1
                }
                var color = cs[ci]
                outSegs.push({ d: dstr, c: color, s: f"inline-block w-3 h-3 rounded-sm bg-[{color}]" })
                a0 = a1
                k = k + 1
            }
            .segs = outSegs
            // ---- 图例(标签 + 占比%) ----
            var iname = .index
            var fname = .field
            var outLegend = ""
            for d in .data {
                var lv = d[fname]
                var vi = d[fname]
                var pct int = vi * 100 / total
                if outLegend == "" {
                    outLegend = f"${lv} ${pct}%"
                } else {
                    outLegend = outLegend + f"   ${lv} ${pct}%"
                }
            }
            .legend = outLegend
        }
    }

    view {
        col (style: "w-full items-center gap-3") {
            svg (viewBox: "0 0 560 300", style: "w-full h-auto max-w-md") {
                circle (cx: "280", cy: "150", r: "100", fill: "none", stroke: "#f1f5f9", stroke-width: "38") {}
                for seg in .segs {
                    path (key: seg["d"], d: seg["d"], fill: seg["c"]) {}
                }
            }
            row (style: "gap-4") {
                for seg in .segs {
                    span (key: seg["c"], style: seg["s"]) {}
                }
            }
            text .legend { style: "text-xs text-muted-foreground" }
        }
    }
}
