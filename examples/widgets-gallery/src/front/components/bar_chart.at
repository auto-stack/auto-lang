// components/bar_chart.at - AutoBarChart component (Plan 437 Phase 2 ②)
//
// 官方 Auto 实现的柱形图(band scale:槽宽 = 内宽/n,槽内 60% 均分给
// 各系列;每柱一个 M/h/v/h/Z 子路径,整系列合成单条 path,fill 填充)。
// 渲染端 v1 = SVG 子树直通(442 A4)。纪律(§0.6.D)同 line_chart.at。

widget AutoBarChart (data: List, index: str = "q", fields: List<str> = ["v"], colors: List<str> = ["#2563eb"]) {
    msg { Init }

    model {
        // 几何输出(Init 计算):每系列 { d: path, c: color } 段记录
        segs List = []
        labels str = ""
    }

    on {
        .Init -> {
            // ---- 全系列共享 y 域 ----
            var vmax int = 0
            for d in .data {
                for f in .fields {
                    var v = d[f]
                    if v > vmax {
                        vmax = v
                    }
                }
            }
            var vmaxf float = vmax
            var bottom float = 260.0
            var span float = 250.0
            // ---- band scale:槽宽 = 510/n,槽内 60% 按系列均分 ----
            var n int = .data.len()
            var nf float = n
            var slot float = 510.0 / nf
            var ks int = .fields.len()
            var kf float = ks
            var inner float = slot * 0.6
            var barw float = inner / kf
            var outSegs List = []
            var cs = .colors
            var ccount int = cs.len()
            var k int = 0
            for f in .fields {
                var dstr = ""
                var i = 0
                for d in .data {
                    var vf float = d[f]
                    var xf float = 40.0 + i * slot + slot * 0.2 + k * barw
                    var yf float = bottom - vf / vmaxf * span
                    var hf float = bottom - yf
                    dstr = dstr + f"M${xf} ${yf} h${barw} v${hf} h-${barw} Z "
                    i = i + 1
                }
                var ci int = k
                if ci >= ccount {
                    ci = ccount - 1
                }
                outSegs.push({ d: dstr, c: cs[ci] })
                k = k + 1
            }
            .segs = outSegs
            // ---- x 轴标签 ----
            var iname = .index
            var outLabels = ""
            for d in .data {
                if outLabels == "" {
                    outLabels = d[iname]
                } else {
                    outLabels = outLabels + "     " + d[iname]
                }
            }
            .labels = outLabels
        }
    }

    view {
        col (style: "w-full") {
            svg (viewBox: "0 0 560 300", style: "w-full h-auto") {
                path (d: "M40 72.5 H550 M40 135 H550 M40 197.5 H550", stroke: "#e2e8f0", stroke-width: "1") {}
                line (x1: "40", y1: "260", x2: "550", y2: "260", stroke: "#94a3b8", stroke-width: "1") {}
                for seg in .segs {
                    path (key: seg["d"], d: seg["d"], fill: seg["c"]) {}
                }
            }
            row (style: "justify-between px-12 pt-1") {
                text .labels { style: "text-xs text-muted-foreground" }
            }
        }
    }
}
