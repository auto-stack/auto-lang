// components/bar_chart.at - BarChart component (Plan 437 Phase 2 ② → Plan 484 v2 → Plan 492 M6)
//
// 柱形图:band scale(槽宽 = 510/n,grouped 槽内 60% 均分系列;stacked
// 单列前缀和堆叠)。渲染端 v1 = SVG 子树直通(442 A4)。
//
// 492 M6(绕开摘除,回归直接写法):Init 内直用 prop 字符串比较
// (`if .type == "stacked"`)选域/段记录,单 segs + 单 yTick 组,view 无
// 分支;带参 msg 声明恢复;band 样式 dollar 插值;484 时代的成对镜像
// 域字段(Init 内两算两存)与 tooltip 双域锚点残留(ay/cum3 死算)一并
// 退役。
// 保留纪律:条件引用的局部变量紧邻使用点声明。
//
// # Usage
// bar-chart (data: .sales, index: "q", fields: ["a", "b"], type: "stacked") {}

widget BarChart (data: List, index: str = "q", fields: List<str> = ["v"], colors: List<str> = ["#2563eb", "#16a34a", "#d97706", "#dc2626"], axis: str = "auto", grid: bool = true, legend: bool = true, labels: List<str> = [], tooltip: bool = true, type: str = "grouped") {
    msg { Init, Hover(int) }

    model {
        segs List = []
        xlabels str = ""
        yTick4 str = ""
        yTick3 str = ""
        yTick2 str = ""
        yTick1 str = ""
        yTick0 str = ""
        gridPath str = "M40 200 H550 M40 140 H550 M40 80 H550 M40 20 H550"
        legendColor0 str = ""
        legendText0 str = ""
        legendColor1 str = ""
        legendText1 str = ""
        legendColor2 str = ""
        legendText2 str = ""
        legendColor3 str = ""
        legendText3 str = ""
        bands List = []
        tipTitles List = []
        tipBodies List = []
        hovered str = "false"
        tipTitle str = ""
        tipBody str = ""
    }

    on {
        .Init -> {
            // ---- 域:type prop 直接选——stacked 取逐 index 累计和最大,
            //      grouped 取系列值最大 ----
            var vmax int = 0
            if .type == "stacked" {
                for d in .data {
                    var cum int = 0
                    for f in .fields {
                        var v0 = d[f]
                        cum = cum + v0
                    }
                    if cum > vmax {
                        vmax = cum
                    }
                }
            } else {
                for d in .data {
                    for f in .fields {
                        var v = d[f]
                        if v > vmax {
                            vmax = v
                        }
                    }
                }
            }
            // ---- nice step:int 域 1-2-5 阶梯(退化域 4/1) ----
            var step int = 1
            if vmax > 4 {
                var guard = 0
                while step * 4 < vmax && guard < 12 {
                    var mm = step
                    while mm >= 10 {
                        mm = mm / 10
                    }
                    if mm == 2 {
                        step = step * 5 / 2
                    } else {
                        step = step * 2
                    }
                    guard = guard + 1
                }
            }
            var domain int = step * 4
            if domain < vmax {
                domain = step * 5
            }
            var domainf float = domain
            .yTick4 = f"${step * 4}"
            .yTick3 = f"${step * 3}"
            .yTick2 = f"${step * 2}"
            .yTick1 = f"${step}"
            .yTick0 = "0"

            var bottom float = 260.0
            var span float = 240.0
            var n int = .data.len()
            var nf float = n
            var slot float = 510.0 / nf
            var ks int = .fields.len()
            var kf float = ks
            var inner float = slot * 0.6
            var barw float = inner / kf
            var cs = .colors
            var ccount int = cs.len()
            var iname = .index

            // ---- 段记录:type prop 直接选(grouped 槽内并列/stacked 前缀和堆叠) ----
            var outSegs List = []
            var k = 0
            for f in .fields {
                var dstr = ""
                var i = 0
                for d in .data {
                    var xf float = 40.0 + i * slot + slot * 0.2
                    if .type == "stacked" {
                        // 前缀和底边:前面系列累计抬升
                        var before int = 0
                        var k2 = 0
                        for f2 in .fields {
                            if k2 < k {
                                var v2 = d[f2]
                                before = before + v2
                            }
                            k2 = k2 + 1
                        }
                        var vf float = d[f]
                        var beforef float = before
                        var allf float = vf + beforef
                        var ytopS float = bottom - allf / domainf * span
                        var ybase float = bottom - beforef / domainf * span
                        var hfS float = ybase - ytopS
                        dstr = dstr + f"M${xf} ${ytopS} h${inner} v${hfS} h-${inner} Z "
                    } else {
                        var vfg float = d[f]
                        var ytop float = bottom - vfg / domainf * span
                        var hf float = bottom - ytop
                        var xfg float = xf + k * barw
                        dstr = dstr + f"M${xfg} ${ytop} h${barw} v${hf} h-${barw} Z "
                    }
                    i = i + 1
                }
                var ci int = k
                if ci >= ccount {
                    ci = ccount - 1
                }
                var color = cs[ci]
                outSegs.push({ d: dstr, c: color })
                var name = f
                var lname = .labels
                if lname.len() > k {
                    name = lname[k]
                }
                if k == 0 {
                    .legendColor0 = color
                    .legendText0 = name
                }
                if k == 1 {
                    .legendColor1 = color
                    .legendText1 = name
                }
                if k == 2 {
                    .legendColor2 = color
                    .legendText2 = name
                }
                if k == 3 {
                    .legendColor3 = color
                    .legendText3 = name
                }
                k = k + 1
            }
            .segs = outSegs

            // ---- x 轴标签(≤8 抽样) ----
            var keep int = 1
            if n > 8 {
                keep = n / 8 + 1
            }
            var outLabels = ""
            var i2 = 0
            for d in .data {
                if i2 % keep == 0 {
                    if outLabels == "" {
                        outLabels = d[iname]
                    } else {
                        outLabels = outLabels + "   " + d[iname]
                    }
                }
                i2 = i2 + 1
            }
            .xlabels = outLabels

            // ---- 命中竖带 + tooltip 内容(逐索引预计算) ----
            var outBands List = []
            var outTipTitle List = []
            var outTipBody List = []
            var i3 = 0
            for d in .data {
                outBands.push({ i: i3, s: f"w-[${slot}px] h-full flex-1" })
                outTipTitle.push(d[iname])
                var body = ""
                var k3 = 0
                for f5 in .fields {
                    var name2 = f5
                    var lname2 = .labels
                    if lname2.len() > k3 {
                        name2 = lname2[k3]
                    }
                    if body == "" {
                        body = f"${name2} ${d[f5]}"
                    } else {
                        body = body + "\n" + f"${name2} ${d[f5]}"
                    }
                    k3 = k3 + 1
                }
                outTipBody.push(body)
                i3 = i3 + 1
            }
            .bands = outBands
            .tipTitles = outTipTitle
            .tipBodies = outTipBody
        }

        .Hover(i) -> {
            .hovered = "true"
            .tipTitle = .tipTitles[i]
            .tipBody = .tipBodies[i]
        }
        .HoverOut -> { .hovered = "false" }
    }

    view {
        col (style: "w-full gap-1") {
            row (style: "items-stretch w-full") {
                if .axis == "auto" {
                    col (style: "w-10 shrink-0 justify-between items-end pr-1 pt-0 pb-8") {
                        text .yTick4 { style: "text-[10px] text-muted-foreground" }
                        text .yTick3 { style: "text-[10px] text-muted-foreground" }
                        text .yTick2 { style: "text-[10px] text-muted-foreground" }
                        text .yTick1 { style: "text-[10px] text-muted-foreground" }
                        text .yTick0 { style: "text-[10px] text-muted-foreground" }
                    }
                }
                col (style: "flex-1") {
                    col (style: "relative") {
                        svg (viewBox: "0 0 560 300", style: "w-full h-auto") {
                            if .grid {
                                path (d: .gridPath, stroke: "#e2e8f0", stroke-width: "1") {}
                            }
                            line (x1: "40", y1: "260", x2: "550", y2: "260", stroke: "#94a3b8", stroke-width: "1") {}
                            for seg in .segs {
                                path (key: seg["d"], d: seg["d"], fill: seg["c"]) {}
                            }
                        }
                        if .tooltip {
                            col (style: "absolute top-[20px] left-[40px] z-50 w-[510px] h-[240px]") {
                                row (style: "h-full") {
                                    for b in .bands {
                                        mouse-area (key: b["i"], style: b["s"], onmouseenter: .Hover(b.i), onmouseleave: .HoverOut) {}
                                    }
                                }
                            }
                            if .hovered == "true" {
                                col (style: "absolute top-[28px] right-[60px] z-50 bg-popover border rounded-md px-2 py-1 shadow-md") {
                                    text .tipTitle { style: "text-xs font-semibold text-foreground" }
                                    text .tipBody { style: "text-xs text-muted-foreground whitespace-pre-line" }
                                }
                            }
                        }
                    }
                    if .axis == "auto" {
                        row (style: "justify-between px-12 pt-1") {
                            text .xlabels { style: "text-xs text-muted-foreground" }
                        }
                    }
                }
            }
            if .legend {
                row (style: "gap-4 pt-1 px-2") {
                    if .legendText0 != "" {
                        row (style: "items-center gap-1") {
                            svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                rect (width: "8", height: "8", fill: .legendColor0) {}
                            }
                            text .legendText0 { style: "text-xs text-muted-foreground" }
                        }
                    }
                    if .legendText1 != "" {
                        row (style: "items-center gap-1") {
                            svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                rect (width: "8", height: "8", fill: .legendColor1) {}
                            }
                            text .legendText1 { style: "text-xs text-muted-foreground" }
                        }
                    }
                    if .legendText2 != "" {
                        row (style: "items-center gap-1") {
                            svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                rect (width: "8", height: "8", fill: .legendColor2) {}
                            }
                            text .legendText2 { style: "text-xs text-muted-foreground" }
                        }
                    }
                    if .legendText3 != "" {
                        row (style: "items-center gap-1") {
                            svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                rect (width: "8", height: "8", fill: .legendColor3) {}
                            }
                            text .legendText3 { style: "text-xs text-muted-foreground" }
                        }
                    }
                }
            }
        }
    }
}
