// components/line_chart.at - AreaChart component (Plan 437 Phase 2 ③ → Plan 484 v2)
//
// 面积图:折线下探底边闭合 Z(fill 0.25 叠加)+ 顶边描边;curve = "monotone" 走 d3 curveMonotoneX
// (Fritsch-Carlson 单调三次插值,不过冲数据点)。渲染端 v1 = SVG 子树直通
// (vue 442 A4 直通臂 / VM svgdoc 通道)。
//
// 484 v2:nice-ticks 刻度/网格线/图例/hover tooltip(x 索引竖带命中)/
// axis/grid/legend/tooltip/labels/curve props。曲线变体在 Init 内双算双存
// (segs/segsM),view 按 curve prop 选择——包组件 Init 内 prop 字符串比较
// 会破坏 codegen(484 实证,详见计划 M1 与 chart-components.md 已知坑)。
// 其他实证纪律:
// - 条件引用的局部变量紧邻使用点声明(首个 for 之后);
// - f-string 内含字面量 [] 时插值必须用 {} 形式,不能用 ${};
// - handler 带参无需 msg 声明(声明带参 msg 反而破坏包子组件编译)。
//
// # Usage
// use { package: official from "../components" }
// area-chart (data: .revenue, index: "month", fields: ["a", "b"]) {}

widget AreaChart (data: List, index: str = "m", fields: List<str> = ["v"], colors: List<str> = ["#2563eb", "#16a34a", "#d97706", "#dc2626"], axis: str = "auto", grid: bool = true, legend: bool = true, labels: List<str> = [], tooltip: bool = true, curve: str = "linear") {
    msg { Init }

    model {
        segs List = []
        segsM List = []
        xlabels str = ""
        yTick4 str = ""
        yTick3 str = ""
        yTick2 str = ""
        yTick1 str = ""
        yTick0 str = ""
        gridPath str = "M40 200 H550 M40 140 H550 M40 80 H550 M40 20 H550"
        legendColor0 str = ""
        legendText0 str = ""
        legendColor1 str = ""
        legendText1 str = ""
        legendColor2 str = ""
        legendText2 str = ""
        legendColor3 str = ""
        legendText3 str = ""
        bands List = []
        tipTitles List = []
        tipBodies List = []
        hovered str = "false"
        tipTitle str = ""
        tipBody str = ""
    }

    on {
        .Init -> {
            // ---- 全系列共享 y 域 ----
            var vmax int = 0
            for d in .data {
                for f in .fields {
                    var v = d[f]
                    if v > vmax {
                        vmax = v
                    }
                }
            }
            // ---- nice step:int 域 1-2-5 阶梯(退化域 4/1) ----
            var step int = 1
            if vmax > 4 {
                var guard = 0
                while step * 4 < vmax && guard < 12 {
                    var mm = step
                    while mm >= 10 {
                        mm = mm / 10
                    }
                    if mm == 2 {
                        step = step * 5 / 2
                    } else {
                        step = step * 2
                    }
                    guard = guard + 1
                }
            }
            var domain int = step * 4
            if domain < vmax {
                domain = step * 5
            }
            var domainf float = domain
            .yTick4 = f"${step * 4}"
            .yTick3 = f"${step * 3}"
            .yTick2 = f"${step * 2}"
            .yTick1 = f"${step}"
            .yTick0 = "0"

            var left float = 40.0
            var plotTop float = 20.0
            var right float = 550.0
            var bottom float = 260.0
            var n int = .data.len()
            var stepf float = 1.0
            if n > 1 {
                var nf float = n - 1
                stepf = (right - left) / nf
            }
            var outLegend List = []
            var cs = .colors
            var ccount int = cs.len()

            // ---- 线性变体 ----
            var outSegs List = []
            var k = 0
            for f in .fields {
                var ys List = []
                for d in .data {
                    var vf float = d[f]
                    var yv float = bottom - vf / domainf * (bottom - plotTop)
                    ys.push(yv)
                }
                var dstr = ""
                var i = 0
                for d in .data {
                    var xf float = left + i * stepf
                    var yf = ys[i]
                    if i == 0 {
                        dstr = f"M ${xf} ${yf}"
                    } else {
                        dstr = dstr + f" L ${xf} ${yf}"
                    }
                    i = i + 1
                }
                // 面积闭合:描边路径 + 末点下探底边 → 回首点 x 的底边 → Z
                var nf2 float = n - 1
                var xlast float = left + nf2 * stepf
                var astr = dstr + f" L${xlast} 260 L40 260 Z"
                var ci int = k
                if ci >= ccount {
                    ci = ccount - 1
                }
                var color = cs[ci]
                outSegs.push({ a: astr, l: dstr, c: color })
                var name = f
                var lname = .labels
                if lname.len() > k {
                    name = lname[k]
                }
                outLegend.push({ c: color, s: f"inline-block w-3 h-3 rounded-sm bg-[{color}]", name: name })
                k = k + 1
            }
            .segs = outSegs
            .legendItems = outLegend

            // ---- monotone 变体(FC 标准形,同 line_chart.at;发射 a/l 双路径) ----
            var outSegsM List = []
            var kM = 0
            for f in .fields {
                var ysM List = []
                for d in .data {
                    var vfM float = d[f]
                    var yvM float = bottom - vfM / domainf * (bottom - plotTop)
                    ysM.push(yvM)
                }
                var deltas List = []
                var di = 0
                while di < n - 1 {
                    var yA = ysM[di]
                    var yB = ysM[di + 1]
                    deltas.push((yB - yA) / stepf)
                    di = di + 1
                }
                var ms List = []
                var zi = 0
                for d in .data { ms.push(0.0) }
                if n > 1 {
                    var z0 = deltas[0]
                    ms[0] = z0
                    var zN = deltas[n - 2]
                    ms[n - 1] = zN
                }
                var mi = 1
                while mi < n - 1 {
                    var dA = deltas[mi - 1]
                    var dB = deltas[mi]
                    var mm float = (dA + dB) / 2.0
                    if dA * dB <= 0.0 {
                        mm = 0.0
                    }
                    ms[mi] = mm
                    mi = mi + 1
                }
                var lstrM = f"M ${left} ${ysM[0]}"
                var si = 0
                while si < n - 1 {
                    var x0 float = left + si * stepf
                    var y0 = ysM[si]
                    var x1 float = left + (si + 1) * stepf
                    var y1 = ysM[si + 1]
                    var m0 = ms[si]
                    var m1 = ms[si + 1]
                    var c1x float = x0 + stepf / 3.0
                    var c1y float = y0 + m0 * stepf / 3.0
                    var c2x float = x1 - stepf / 3.0
                    var c2y float = y1 - m1 * stepf / 3.0
                    lstrM = lstrM + f" C ${c1x} ${c1y} ${c2x} ${c2y} ${x1} ${y1}"
                    si = si + 1
                }
                var nf2M float = n - 1
                var xlastM float = left + nf2M * stepf
                var astrM = lstrM + f" L${xlastM} 260 L40 260 Z"
                var ciM int = kM
                if ciM >= ccount {
                    ciM = ccount - 1
                }
                outSegsM.push({ a: astrM, l: lstrM, c: cs[ciM] })
                kM = kM + 1
            }
            .segsM = outSegsM

            // ---- x 轴标签(≤8 抽样) ----
            var iname = .index
            var keep int = 1
            if n > 8 {
                keep = n / 8 + 1
            }
            var outLabels = ""
            var i2 = 0
            for d in .data {
                if i2 % keep == 0 {
                    if outLabels == "" {
                        outLabels = d[iname]
                    } else {
                        outLabels = outLabels + "   " + d[iname]
                    }
                }
                i2 = i2 + 1
            }
            .xlabels = outLabels

            // ---- 命中竖带 + tooltip 锚点/内容(逐索引预计算) ----
            var nf3 float = n
            var slot float = (right - left) / nf3
            var outBands List = []
            var outTipX List = []
            var outTipY List = []
            var outTipTitle List = []
            var outTipBody List = []
            var i3 = 0
            for d in .data {
                outBands.push({ i: i3, s: "h-full flex-1" })
                outTipTitle.push(d[iname])
                var body = ""
                var k2 = 0
                for f2 in .fields {
                    var name2 = f2
                    var lname2 = .labels
                    if lname2.len() > k2 {
                        name2 = lname2[k2]
                    }
                    if body == "" {
                        body = f"${name2} ${d[f2]}"
                    } else {
                        body = body + "\n" + f"${name2} ${d[f2]}"
                    }
                    k2 = k2 + 1
                }
                outTipBody.push(body)
                i3 = i3 + 1
            }
            .bands = outBands
            .tipTitles = outTipTitle
            .tipBodies = outTipBody
        }

        .Hover(i) -> {
            .hovered = "true"
            .tipTitle = .tipTitles[i]
            .tipBody = .tipBodies[i]
        }
        .HoverOut -> { .hovered = "false" }
    }

    view {
        col (style: "w-full gap-1") {
            row (style: "items-stretch w-full") {
                if .axis == "auto" {
                    col (style: "w-10 shrink-0 justify-between items-end pr-1 pt-0 pb-8") {
                        text .yTick4 { style: "text-[10px] text-muted-foreground" }
                        text .yTick3 { style: "text-[10px] text-muted-foreground" }
                        text .yTick2 { style: "text-[10px] text-muted-foreground" }
                        text .yTick1 { style: "text-[10px] text-muted-foreground" }
                        text .yTick0 { style: "text-[10px] text-muted-foreground" }
                    }
                }
                col (style: "flex-1") {
                    col (style: "relative") {
                        svg (viewBox: "0 0 560 300", style: "w-full h-auto") {
                            if .grid {
                                path (d: .gridPath, stroke: "#e2e8f0", stroke-width: "1") {}
                            }
                            line (x1: "40", y1: "260", x2: "550", y2: "260", stroke: "#94a3b8", stroke-width: "1") {}
                            line (x1: "40", y1: "20", x2: "40", y2: "260", stroke: "#94a3b8", stroke-width: "1") {}
                            if .curve == "monotone" {
                                for seg in .segsM {
                                    path (key: seg["a"], d: seg["a"], fill: seg["c"], fill-opacity: "0.25") {}
                                }
                                for seg in .segsM {
                                    path (key: seg["l"], d: seg["l"], fill: "none", stroke: seg["c"], stroke-width: "2") {}
                                }
                            } else {
                                for seg in .segs {
                                    path (key: seg["a"], d: seg["a"], fill: seg["c"], fill-opacity: "0.25") {}
                                }
                                for seg in .segs {
                                    path (key: seg["l"], d: seg["l"], fill: "none", stroke: seg["c"], stroke-width: "2") {}
                                }
                            }
                        }
                        if .tooltip {
                            col (style: "absolute top-[20px] left-[40px] z-50 w-[510px] h-[240px]") {
                                row (style: "h-full") {
                                    for b in .bands {
                                        mouse-area (key: b["i"], style: b["s"], onmouseenter: .Hover(b.i), onmouseleave: .HoverOut) {}
                                    }
                                }
                            }
                            if .hovered == "true" {
                                col (style: "absolute top-[28px] right-[60px] z-50 bg-popover border rounded-md px-2 py-1 shadow-md") {
                                    text .tipTitle { style: "text-xs font-semibold text-foreground" }
                                    text .tipBody { style: "text-xs text-muted-foreground whitespace-pre-line" }
                                }
                            }
                        }
                    }
                    if .axis == "auto" {
                        row (style: "justify-between px-10 pt-1") {
                            text .xlabels { style: "text-xs text-muted-foreground" }
                        }
                    }
                }
            }
            if .legend {
                row (style: "gap-4 pt-1 px-2") {
                    if .legendText0 != "" {
                        row (style: "items-center gap-1") {
                            svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                rect (width: "8", height: "8", fill: .legendColor0) {}
                            }
                            text .legendText0 { style: "text-xs text-muted-foreground" }
                        }
                    }
                    if .legendText1 != "" {
                        row (style: "items-center gap-1") {
                            svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                rect (width: "8", height: "8", fill: .legendColor1) {}
                            }
                            text .legendText1 { style: "text-xs text-muted-foreground" }
                        }
                    }
                    if .legendText2 != "" {
                        row (style: "items-center gap-1") {
                            svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                rect (width: "8", height: "8", fill: .legendColor2) {}
                            }
                            text .legendText2 { style: "text-xs text-muted-foreground" }
                        }
                    }
                    if .legendText3 != "" {
                        row (style: "items-center gap-1") {
                            svg (viewBox: "0 0 8 8", style: "w-3 h-3 shrink-0") {
                                rect (width: "8", height: "8", fill: .legendColor3) {}
                            }
                            text .legendText3 { style: "text-xs text-muted-foreground" }
                        }
                    }
                }
            }
        }
    }
}
