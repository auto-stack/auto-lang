// components/flow_diagram.at - FlowDiagram component (Plan 502 M2 骨架 → M3 布局核 → M4 边路由/箭头 → M5 标签/hover)
//
// diagram 家族首个组件:流程图(架构图/C4/拓扑同构表达)。数据轨 props
// (nodes/edges record 列表,设计文档 diagram-components.md §5 schema);
// 静态糖(node/edge/group DSL)归 Phase 3,当前以数据轨书写。
//
// M3 布局核(Sugiyama-lite,全 Auto 代码):
//   rank   = DFS 回边检测(灰→灰边剥离开环)+ 剩余 DAG 上最长路径分层
//            (松弛定容);膨胀启发式在"链+环"图会过度剥主干边,故用 DFS;
//   order  = barycenter 双向 2 轮(层降序用上层邻居均值/升序用下层均值,
//            层内稳定插入排序);
//   coord  = 层内等距 + 父居中一趟(下层邻居 x 均值,min-gap 左打包)。
//   direction td/lr 经转置(rank 轴 = y/x)。group 嵌套 v1 平铺忽略
//   (待澄清#1 预案:递归超节点归 Phase 2a)。
// 渲染端 v1 = SVG 直通(484 同通路);标签机制 = svg text 直通(M1 定案)。
//
// 纪律:float 中间量显式 float(chart 几何同款);几何字段以 str 入段记录
// (chart pts 先例,双端 svg 属性同源);段记录按 kind 分桶,view 无分支
// (line_chart 同款);层内成员收集走"pos 值扫描"(避免嵌套 List 别义)。
//
// # Usage
// use { package: official from "../components" }
// flow-diagram (direction: "td") {
//     nodes: .topoNodes
//     edges: .topoEdges
// }

widget FlowDiagram (nodes: List, edges: List, direction: str = "td") {
    msg { Init, HoverNode(int), NodeOut }

    model {
        // render 段记录(按 kind 分桶,view 无分支)
        nodesDg List = []
        edgesDg List = []
        glyphsDg List = []
        vbDg str = "0 0 560 300"
        // M5:hover 状态机(498 三段式——Init 纯派生 + 最小状态写入 +
        // view 状态投影)。哨兵 = -1(498 教训:view 条件对 -1 字面量
        // 恒假,改哨兵值 >= n)。
        hitDg str = ""
        hoverDg int = 999
        tipDgTitle str = ""
        tipDgBody str = ""
        tipDgStyle str = ""
    }

    on {
        .HoverNode(i) -> {
            .hoverDg = i
            var nd = .nodesDg[i]
            .tipDgTitle = nd.label
            .tipDgBody = f"id: ${nd.id}"
            var tx = nd.x
            var ty = nd.y
            .tipDgStyle = f"absolute left-[${tx + 4}px] top-[${ty + 2}px]"
        }
        .NodeOut -> {
            .hoverDg = 999
        }
        .Init -> {
            var n int = .nodes.len()
            var m int = .edges.len()

            var nw float = 120.0
            var nh float = 44.0
            var gx float = 48.0
            var gy float = 64.0
            var mg float = 24.0

            // ---- 边端点索引(id → index 线性查) ----
            var ef List = []
            var et List = []
            var linesArr List = []
            var headsArr List = []
            var tailsArr List = []
            for e in .edges {
                var fa = e["from"]
                var ta = e["to"]
                var fj int = -1
                var tj int = -1
                var k int = 0
                for nd in .nodes {
                    if nd["id"] == fa {
                        fj = k
                    }
                    if nd["id"] == ta {
                        tj = k
                    }
                    k = k + 1
                }
                ef.push(fj)
                et.push(tj)
                linesArr.push(e["line"])
                headsArr.push(e["head"])
                tailsArr.push(e["tail"])
            }

            // ---- M3 rank 趟①: DFS 回边检测(灰→灰边 = 环上回卷点,剥离。
            //      膨胀启发式在"链+环"图上会过度剥主干边——DFS 精确) ----
            var ranks List = []
            var i int = 0
            var ei int = 0
            while i < n {
                ranks.push(0)
                i = i + 1
            }
            var color List = []
            var cursor List = []
            var stack List = []
            var efdb List = []
            i = 0
            while i < n {
                color.push(0)
                cursor.push(0)
                efdb.push(0)
                i = i + 1
            }
            var sv int = 0
            while sv < n {
                if color[sv] == 0 {
                    color[sv] = 1
                    stack.push(sv)
                    while stack.len() > 0 {
                        var v = stack[stack.len() - 1]
                        var found int = -1
                        var eIdx int = cursor[v]
                        var brk bool = false
                        while eIdx < m {
                            if brk {
                                eIdx = m
                            } else {
                                if ef[eIdx] == v {
                                    var w = et[eIdx]
                                    if color[w] == 1 {
                                        efdb[eIdx] = 1
                                    } else {
                                        if color[w] == 0 {
                                            found = w
                                            cursor[v] = eIdx + 1
                                            brk = true
                                        }
                                    }
                                }
                                if !brk {
                                    eIdx = eIdx + 1
                                }
                            }
                        }
                        if found >= 0 {
                            color[found] = 1
                            stack.push(found)
                        } else {
                            cursor[v] = m
                            color[v] = 2
                            stack.pop()
                        }
                    }
                }
                sv = sv + 1
            }
            // ---- M3 rank 趟②: 回边剥离后的 DAG 上最长路径分层(松弛定容) ----
            var round int = 0
            while round < n + 2 {
                ei = 0
                while ei < m {
                    if efdb[ei] == 0 {
                        var rf2 = ranks[ef[ei]]
                        if ranks[et[ei]] <= rf2 {
                            ranks[et[ei]] = rf2 + 1
                        }
                    }
                    ei = ei + 1
                }
                round = round + 1
            }

            var maxRank int = 0
            for r in ranks {
                if r > maxRank {
                    maxRank = r
                }
            }

            // ---- M3 order 趟: 层内序初始化(按索引出现序) ----
            var cnt List = []
            i = 0
            while i <= maxRank {
                cnt.push(0)
                i = i + 1
            }
            for r in ranks {
                cnt[r] = cnt[r] + 1
            }
            var pos List = []
            var cur List = []
            i = 0
            while i <= maxRank {
                cur.push(0)
                i = i + 1
            }
            i = 0
            while i < n {
                pos.push(0)
                i = i + 1
            }
            i = 0
            while i < n {
                var rl = ranks[i]
                pos[i] = cur[rl]
                cur[rl] = cur[rl] + 1
                i = i + 1
            }

            // ---- M3 order 趟: barycenter 双向 2 轮 ----
            // 邻居去重 stamp:平行边(如 a→b 与 b→a)只计一次,均值不失真。
            var mark List = []
            i = 0
            while i < n {
                mark.push(0)
                i = i + 1
            }
            var stamp int = 0
            round = 0
            while round < 2 {
                var pass int = 0
                while pass < 2 {
                    var down bool = true
                    if pass == 1 {
                        down = false
                    }
                    var lr int = 0
                    if !down {
                        lr = maxRank
                    }
                    var moving bool = true
                    if down {
                        moving = lr <= maxRank
                    } else {
                        moving = lr >= 0
                    }
                    while moving {
                        // 收集该层成员(按当前 pos 升序;pos 值扫描)
                        var mem List = []
                        var mp List = []
                        var p int = 0
                        while p < cnt[lr] {
                            var kk int = 0
                            while kk < n {
                                if ranks[kk] == lr {
                                    if pos[kk] == p {
                                        mem.push(kk)
                                    }
                                }
                                kk = kk + 1
                            }
                            p = p + 1
                        }
                        // barycenter(指定方向邻层邻居 pos 均值;stamp 去重
                        // 平行边;无邻居保序)
                        var mi int = 0
                        while mi < mem.len() {
                            var v = mem[mi]
                            var sum float = 0.0
                            var c int = 0
                            stamp = stamp + 1
                            var ei2 int = 0
                            while ei2 < m {
                                var u int = -1
                                if ef[ei2] == v {
                                    u = et[ei2]
                                }
                                if et[ei2] == v {
                                    if ef[ei2] != v {
                                        u = ef[ei2]
                                    }
                                }
                                if u >= 0 {
                                    var take bool = false
                                    if down {
                                        if ranks[u] < lr {
                                            take = true
                                        }
                                    } else {
                                        if ranks[u] > lr {
                                            take = true
                                        }
                                    }
                                    if take {
                                        if mark[u] != stamp {
                                            mark[u] = stamp
                                            var pu float = pos[u]
                                            sum = sum + pu
                                            c = c + 1
                                        }
                                    }
                                }
                                ei2 = ei2 + 1
                            }
                            var bc float = 0.0
                            if c > 0 {
                                var cf float = c
                                bc = sum / cf
                            } else {
                                var mf float = mi
                                bc = mf
                            }
                            mp.push(bc)
                            mi = mi + 1
                        }
                        // 稳定插入排序(严格大于才前移,相等保序)
                        var a int = 1
                        while a < mem.len() {
                            var km = mem[a]
                            var kbc = mp[a]
                            var b int = a - 1
                            while b >= 0 && mp[b] > kbc {
                                mem[b + 1] = mem[b]
                                mp[b + 1] = mp[b]
                                b = b - 1
                            }
                            mem[b + 1] = km
                            mp[b + 1] = kbc
                            a = a + 1
                        }
                        // 回写层内序
                        a = 0
                        while a < mem.len() {
                            pos[mem[a]] = a
                            a = a + 1
                        }
                        // 层指针步进 + 循环条件重算
                        if down {
                            lr = lr + 1
                        } else {
                            lr = lr - 1
                        }
                        if down {
                            moving = lr <= maxRank
                        } else {
                            moving = lr >= 0
                        }
                    }
                    pass = pass + 1
                }
                round = round + 1
            }

            // ---- M3 coord 趟①: 层内等距(轴感知步距/边距,中心坐标保证
            //      bbox 非负) ----
            var inStep float = nw + gx
            var rankStep float = nh + gy
            var inOff float = mg + nw / 2.0
            var rankOff float = mg + nh / 2.0
            if .direction == "lr" {
                inStep = nh + gy
                rankStep = nw + gx
                inOff = mg + nh / 2.0
                rankOff = mg + nw / 2.0
            }
            var xs List = []
            i = 0
            while i < n {
                var pf float = pos[i]
                xs.push(inOff + pf * inStep)
                i = i + 1
            }
            // ---- M3 coord 趟②: 父居中一趟(下层邻居均值 stamp 去重平行边,
            //      min-gap 左打包) ----
            var lr2 int = maxRank - 1
            while lr2 >= 0 {
                var tgt List = []
                i = 0
                while i < n {
                    if ranks[i] == lr2 {
                        var sum2 float = 0.0
                        var c2 int = 0
                        stamp = stamp + 1
                        var ei3 int = 0
                        while ei3 < m {
                            var u2 int = -1
                            if ef[ei3] == i {
                                u2 = et[ei3]
                            }
                            if et[ei3] == i {
                                if ef[ei3] != i {
                                    u2 = ef[ei3]
                                }
                            }
                            if u2 >= 0 {
                                if ranks[u2] > lr2 {
                                    if mark[u2] != stamp {
                                        mark[u2] = stamp
                                        var xu = xs[u2]
                                        sum2 = sum2 + xu
                                        c2 = c2 + 1
                                    }
                                }
                            }
                            ei3 = ei3 + 1
                        }
                        var t = xs[i]
                        if c2 > 0 {
                            var cf2 float = c2
                            t = sum2 / cf2
                        }
                        tgt.push(t)
                    } else {
                        tgt.push(0.0)
                    }
                    i = i + 1
                }
                var p3 int = 0
                var prev float = -1000000.0
                while p3 < cnt[lr2] {
                    var kk2 int = 0
                    while kk2 < n {
                        if ranks[kk2] == lr2 {
                            if pos[kk2] == p3 {
                                var xv = tgt[kk2]
                                if xv < prev + inStep {
                                    xv = prev + inStep
                                }
                                xs[kk2] = xv
                                prev = xv
                            }
                        }
                        kk2 = kk2 + 1
                    }
                    p3 = p3 + 1
                }
                lr2 = lr2 - 1
            }

            // ---- M3 转置: td(rank 轴=y) / lr(rank 轴=x) ----
            var cxs List = []
            var cys List = []
            i = 0
            while i < n {
                var rk float = ranks[i]
                var inC float = xs[i]
                var rankC float = rankOff + rk * rankStep
                var cx float = inC
                var cy float = rankC
                if .direction == "lr" {
                    cx = rankC
                    cy = inC
                }
                cxs.push(cx)
                cys.push(cy)
                i = i + 1
            }

            // ---- 段记录: 节点(bbox)+ 边(中心连线,M4 换 bbox 交点) ----
            var outNodes List = []
            i = 0
            for nd in .nodes {
                var lbl = nd["label"]
                if lbl == "" {
                    lbl = nd["id"]
                }
                var fill = "#dbeafe"
                var stroke = "#93c5fd"
                var shape = nd["shape"]
                if shape == "round" {
                    fill = "#dcfce7"
                    stroke = "#86efac"
                }
                if shape == "diamond" {
                    fill = "#fef9c3"
                    stroke = "#fde047"
                }
                var cx2 = cxs[i]
                var cy2 = cys[i]
                var ivf float = i
                outNodes.push({
                    x: f"${cx2 - nw / 2.0}",
                    y: f"${cy2 - nh / 2.0}",
                    w: f"${nw}",
                    h: f"${nh}",
                    cx: f"${cx2}",
                    cy: f"${cy2}",
                    fill: fill,
                    stroke: stroke,
                    label: lbl,
                    id: nd["id"],
                    hover: false,
                    i: ivf
                })
                i = i + 1
            }
            .nodesDg = outNodes

            // ---- M4 段记录: 边 = bbox 边界交点直线段(轴满偏消除除法
            //      尾差);head/tail 字形(arrow/diamond/circle 实心小多边形,
            //      donut 弧先例);line 样式(dash/thick)。cf-* v1 别名 circle
            //      (Phase 2a 补),字形缺失容忍(缺字段 = Int 0)。
            var outEdges List = []
            var outGlyphs List = []
            ei = 0
            while ei < m {
                var fj2 = ef[ei]
                var tj2 = et[ei]
                if fj2 >= 0 && tj2 >= 0 {
                    var x0 = cxs[fj2]
                    var y0 = cys[fj2]
                    var x1 = cxs[tj2]
                    var y1 = cys[tj2]
                    var sx = x1 - x0
                    var sy = y1 - y0
                    var asx float = sx
                    if asx < 0.0 {
                        asx = -asx
                    }
                    var asy float = sy
                    if asy < 0.0 {
                        asy = -asy
                    }
                    var hwE float = nw / 2.0
                    var hhE float = nh / 2.0
                    var txo float = 1000000.0
                    if asx > 0.0 {
                        txo = hwE / asx
                    }
                    var tyo float = 1000000.0
                    if asy > 0.0 {
                        tyo = hhE / asy
                    }
                    var tOut float = txo
                    var outY bool = false
                    if tyo <= txo {
                        tOut = tyo
                        outY = true
                    }
                    var ax float = x0
                    var ay float = y0
                    var bx float = x1
                    var by float = y1
                    if outY {
                        ay = y0
                        if sy > 0.0 {
                            ay = y0 + hhE
                        }
                        if sy < 0.0 {
                            ay = y0 - hhE
                        }
                        by = y1
                        if sy > 0.0 {
                            by = y1 - hhE
                        }
                        if sy < 0.0 {
                            by = y1 + hhE
                        }
                        ax = x0 + tOut * sx
                        bx = x1 - tOut * sx
                    } else {
                        ax = x0
                        if sx > 0.0 {
                            ax = x0 + hwE
                        }
                        if sx < 0.0 {
                            ax = x0 - hwE
                        }
                        bx = x1
                        if sx > 0.0 {
                            bx = x1 - hwE
                        }
                        if sx < 0.0 {
                            bx = x1 + hwE
                        }
                        ay = y0 + tOut * sy
                        by = y1 - tOut * sy
                    }

                    var lv = linesArr[ei]
                    var dashv = ""
                    var swv = "1.5"
                    if lv == "dash" {
                        dashv = "4 3"
                    }
                    if lv == "thick" {
                        swv = "2.5"
                    }
                    var elv = .edges[ei]
                    var elab = elv["label"]
                    var mx float = (ax + bx) / 2.0
                    var my float = (ay + by) / 2.0
                    outEdges.push({ d: f"M ${ax} ${ay} L ${bx} ${by}", dash: dashv, sw: swv, label: elab, mx: f"${mx}", my: f"${my - 5.0}" })

                    // ---- 字形(方向单位向量 u 与垂向量 v;箭头=三角
                    //      tip-10±5、菱形=四点、圆=双弧,均实心) ----
                    var hv = headsArr[ei]
                    var tv = tailsArr[ei]
                    if sx != 0.0 || sy != 0.0 {
                        var sl float = math.sqrt(sx * sx + sy * sy)
                        var ux float = sx / sl
                        var uy float = sy / sl
                        if hv != "none" {
                            if hv == "diamond" {
                                var d1x = bx - ux * 6.0 - uy * 5.0
                                var d1y = by - uy * 6.0 + ux * 5.0
                                var d2x = bx - ux * 12.0
                                var d2y = by - uy * 12.0
                                var d3x = bx - ux * 6.0 + uy * 5.0
                                var d3y = by - uy * 6.0 - ux * 5.0
                                outGlyphs.push({ d: f"M ${bx} ${by} L ${d1x} ${d1y} L ${d2x} ${d2y} L ${d3x} ${d3y} Z" })
                            } else {
                                if hv == "circle" {
                                    var ccx = bx - ux * 5.0
                                    var ccy = by - uy * 5.0
                                    outGlyphs.push({ d: f"M ${ccx - 5.0} ${ccy} a 5 5 0 1 0 10 0 a 5 5 0 1 0 -10 0 Z" })
                                } else {
                                    var bcx = bx - ux * 10.0
                                    var bcy = by - uy * 10.0
                                    var p1x = bcx - uy * 5.0
                                    var p1y = bcy + ux * 5.0
                                    var p2x = bcx + uy * 5.0
                                    var p2y = bcy - ux * 5.0
                                    outGlyphs.push({ d: f"M ${bx} ${by} L ${p1x} ${p1y} L ${p2x} ${p2y} Z" })
                                }
                            }
                        }
                        if tv != "none" && tv != 0 {
                            var tux float = -ux
                            var tuy float = -uy
                            if tv == "diamond" {
                                var e1x = ax - tux * 6.0 - tuy * 5.0
                                var e1y = ay - tuy * 6.0 + tux * 5.0
                                var e2x = ax - tux * 12.0
                                var e2y = ay - tuy * 12.0
                                var e3x = ax - tux * 6.0 + tuy * 5.0
                                var e3y = ay - tuy * 6.0 - tux * 5.0
                                outGlyphs.push({ d: f"M ${ax} ${ay} L ${e1x} ${e1y} L ${e2x} ${e2y} L ${e3x} ${e3y} Z" })
                            } else {
                                if tv == "circle" {
                                    var tcx = ax - tux * 5.0
                                    var tcy = ay - tuy * 5.0
                                    outGlyphs.push({ d: f"M ${tcx - 5.0} ${tcy} a 5 5 0 1 0 10 0 a 5 5 0 1 0 -10 0 Z" })
                                } else {
                                    var qcx = ax - tux * 10.0
                                    var qcy = ay - tuy * 10.0
                                    var r1x = qcx - tuy * 5.0
                                    var r1y = qcy + tux * 5.0
                                    var r2x = qcx + tuy * 5.0
                                    var r2y = qcy - tux * 5.0
                                    outGlyphs.push({ d: f"M ${ax} ${ay} L ${r1x} ${r1y} L ${r2x} ${r2y} Z" })
                                }
                            }
                        }
                    }
                }
                ei = ei + 1
            }
            .edgesDg = outEdges
            .glyphsDg = outGlyphs

            // ---- viewBox 自适应(实际坐标包络 + 边距) ----
            var wMax float = 0.0
            var hMax float = 0.0
            i = 0
            while i < n {
                var wv = cxs[i] + nw / 2.0
                var hv = cys[i] + nh / 2.0
                if wv > wMax {
                    wMax = wv
                }
                if hv > hMax {
                    hMax = hv
                }
                i = i + 1
            }
            .vbDg = f"0 0 ${wMax + mg} ${hMax + mg}"
            .hitDg = f"${wMax + mg}x${hMax + mg}"
        }
    }

    view {
        col (style: "w-full max-w-xl mx-auto") {
            col (style: "relative") {
                svg (viewBox: .vbDg, style: "w-full h-auto") {
                    for e in .edgesDg {
                        path (d: e.d, stroke: "#94a3b8", fill: "none", stroke-width: e.sw, stroke-dasharray: e.dash) {}
                    }
                    for g in .glyphsDg {
                        path (d: g.d, fill: "#64748b") {}
                    }
                    for e in .edgesDg {
                        if e.label != "" {
                            text e.label { x: e.mx, y: e.my, fill: "#475569", font-size: "10", text-anchor: "middle" }
                        }
                    }
                    // M5:emphasis 双态(平面二态,498 同款)——hover 节点
                    // stroke 加粗 + 他节点降透明(svg 兄弟层 mouse-area
                    // 不经 svgdoc,484 增量先例)
                    for nd in .nodesDg {
                        if .hoverDg == 999 {
                            rect (x: nd.x, y: nd.y, width: nd.w, height: nd.h, rx: "6", fill: nd.fill, stroke: nd.stroke, stroke-width: "1") {}
                            text nd.label { x: nd.cx, y: nd.cy, fill: "#1e293b", font-size: "12", text-anchor: "middle" }
                        }
                    }
                    if .hoverDg != 999 {
                        for nd in .nodesDg {
                            if nd.hover {
                                rect (x: nd.x, y: nd.y, width: nd.w, height: nd.h, rx: "6", fill: nd.fill, stroke: "#2563eb", stroke-width: "2") {}
                                text nd.label { x: nd.cx, y: nd.cy, fill: "#1e293b", font-size: "12", text-anchor: "middle" }
                            }
                        }
                        for nd in .nodesDg {
                            if !nd.hover {
                                rect (x: nd.x, y: nd.y, width: nd.w, height: nd.h, rx: "6", fill: nd.fill, stroke: nd.stroke, stroke-width: "1", fill-opacity: "0.55") {}
                                text nd.label { x: nd.cx, y: nd.cy, fill: "#94a3b8", font-size: "12", text-anchor: "middle" }
                            }
                        }
                    }
                }
                // M5:节点 bbox 绝对定位 mouse-area 兄弟层命中(enter/leave
                // 单行 handler,498 同款;坐标 = viewBox 幅面)
                for nd in .nodesDg {
                    mouse-area (coords: .hitDg, onmouseenter: .HoverNode(nd.i), onmouseleave: .NodeOut, style: f"absolute left-[${nd.x}px] top-[${nd.y}px] w-[${nd.w}px] h-[${nd.h}px]") {}
                }
                if .hoverDg != 999 {
                    col (class: f"${.tipDgStyle} z-50 bg-popover border rounded-md px-2 py-1 shadow-md") {
                        text .tipDgTitle { style: "text-xs font-semibold text-foreground" }
                        text .tipDgBody { style: "text-xs text-muted-foreground" }
                    }
                }
            }
        }
    }
}
