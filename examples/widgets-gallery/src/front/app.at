// src/front/app.at - Widgets Gallery Documentation Site
// Responsive layout with categorized navigation. Based on the comprehensive
// gallery (examples/gallery) with the Plan 408 §9 codegen fixes applied:
// 'grid' is usable as a route name (route /grid), NavLink href maps to
// router-link `to`, Slider/Drawer/Toast/Pagination render with the fixed
// shadcn-vue mappings.

widget App {
    // PLAN-528 W2: SettingsPanel 组件来自 official 包（components/）
    use { package: official from "./components" }

    // Route definitions
    routes {
        "/" -> use index
        "/accordion" -> use accordion
        "/alert" -> use alert
        "/alertdialog" -> use alertdialog
        "/alignment" -> use alignment
        "/absolute" -> use absolute
        "/aspectratio" -> use aspectratio
        "/avatar" -> use avatar
        "/badge" -> use badge
        "/breadcrumb" -> use breadcrumb
        "/center" -> use center
        "/button" -> use button
        "/col" -> use col
        "/calendar" -> use calendar
        "/card" -> use card
        "/carousel" -> use carousel
        "/code-editor" -> use code-editor
        "/checkbox" -> use checkbox
        "/collapsible" -> use collapsible
        "/combobox" -> use combobox
        "/command" -> use command
        "/contextmenu" -> use contextmenu
        "/datatable" -> use datatable
        "/datepicker" -> use datepicker
        "/line-chart" -> use line-chart
        "/bar-chart" -> use bar-chart
        "/area-chart" -> use area-chart
        "/donut-chart" -> use donut-chart
        "/flow-diagram" -> use flow-diagram
        "/dialog" -> use dialog
        "/drawer" -> use drawer
        "/dropdownmenu" -> use dropdownmenu
        "/flex" -> use flex
        "/form" -> use form
        "/grid" -> use grid
        "/grid-span" -> use grid-span
        "/hovercard" -> use hovercard
        "/input" -> use input
        "/kitchen-sink" -> use kitchen-sink
        "/label" -> use label
        "/menubar" -> use menubar
        "/navigationmenu" -> use navigationmenu
        "/pagination" -> use pagination
        "/popover" -> use popover
        "/position" -> use position
        "/progress" -> use progress
        "/radiogroup" -> use radiogroup
        "/responsive" -> use responsive
        "/row" -> use row
        "/scroll" -> use scroll
        "/scrollarea" -> use scrollarea
        "/select" -> use select
        "/separator" -> use separator
        "/sizing" -> use sizing
        "/spacing" -> use spacing
        "/sheet" -> use sheet
        "/sidebar" -> use sidebar
        "/skeleton" -> use skeleton
        "/slider" -> use slider
        "/sonner" -> use sonner
        "/switch" -> use switch
        "/table" -> use table
        "/tabs" -> use tabs
        "/textarea" -> use textarea
        "/toast" -> use toast
        "/toggle" -> use toggle
        "/togglegroup" -> use togglegroup
        "/tooltip" -> use tooltip
    }

    model {
        sidebarOpen bool = false
        searchOpen bool = false
        searchQuery str = ""
        // Plan 409 §8: theme color picker state. accent_color drives the
        // primary color in both vm (iced_adapter ACCENT_NAME) and vue
        // (applyAccent → --primary). Palette: indigo/coral/ocean/sage/amber
        // (aligned with auto-forge).
        themeOpen bool = false
        accent_color str = "indigo"
        // PLAN-528 W2: 深/浅主题切换（Plan 458 约定：声明 dark_mode 即由
        // codegen 生成 html.dark class 翻转 + applyAccent 明暗重校准）
        dark_mode bool = true
    }

    on {
        .openSidebar -> { sidebarOpen = true }
        .closeSidebar -> { sidebarOpen = false }
        .openSearch -> { searchOpen = true }
        .closeSearch -> { searchOpen = false }
        .openThemePicker -> { themeOpen = !themeOpen }
        .closeThemePicker -> { themeOpen = false }
        .SetAccent(name) -> { accent_color = name }
        .SetIndigo -> { accent_color = "indigo" }
        .SetCoral -> { accent_color = "coral" }
        .SetOcean -> { accent_color = "ocean" }
        .SetSage -> { accent_color = "sage" }
        .SetAmber -> { accent_color = "amber" }
        .ToggleDark -> { dark_mode = !dark_mode }
    }

    view {
        col (style: "h-screen overflow-hidden") {
            // Header: responsive with mobile menu and search
            header (style: "sticky top-0 z-40 w-full border-b bg-background/95 backdrop-blur") {
                row (style: "h-14 items-center px-4 md:px-6 w-full gap-3") {
                    // Mobile hamburger (hidden on md+)
                    button (variant: "ghost", style: "md:hidden -ml-2", icon: "menu", onClick: .openSidebar) {}

                    // Logo
                    row (style: "items-center gap-2 mr-4 shrink-0") {
                        icon (name: "layers", style: "h-5 w-5 text-primary") {}
                        text "Auto UI" (style: "font-bold text-lg hidden sm:inline") {}
                    }

                    // Desktop nav
                    row (style: "hidden md:flex items-center gap-1 text-sm") {
                        link (to: "/") {
                            text "Docs" (style: "px-3 py-1.5 rounded-md transition-colors") {}
                        }
                        link (to: "/button") {
                            text "Widgets" (style: "px-3 py-1.5 rounded-md transition-colors") {}
                        }
                    }

                    // Right actions
                    row (style: "ml-auto items-center gap-1") {
                        button (variant: "ghost", style: "hidden md:flex h-9 w-9", icon: "search", onClick: .openSearch) {}
                        // Plan 409 §8: theme color picker toggle (palette icon)
                        button (variant: "ghost", style: "h-9 w-9", icon: "palette", onClick: .openThemePicker) {}
                    }
                }
            }

            // PLAN-528 W2: SettingsPanel 统一主题设置弹层（Theme 明暗切换 +
            // Accent 色点），替换原 Plan 409 §8 裸色点行。PLAN-536 T6:VM 轨
            // absolute+偏移+z 走父容器 Overlay 悬浮层(tracked col/row 臂),
            // 与 vue 的 absolute 浮层语义对齐。
            if .themeOpen {
                col (style: "absolute right-4 top-14 z-50") {
                    SettingsPanel (
                        dark_mode: .dark_mode,
                        accent_color: .accent_color,
                        on_close: .closeThemePicker,
                        on_toggle_dark: .ToggleDark,
                        on_set_indigo: .SetIndigo,
                        on_set_coral: .SetCoral,
                        on_set_ocean: .SetOcean,
                        on_set_sage: .SetSage,
                        on_set_amber: .SetAmber
                    )
                }
            }

            // Search overlay
            drawer (open: .searchOpen, onClose: .closeSearch) {
                // Global search dialog
            }

            // Main layout: sidebar + content
            row (style: "flex-1 overflow-hidden") {
                // Desktop sidebar (hidden on mobile)
                aside (style: "hidden md:flex w-64 lg:w-72 border-r bg-background flex-col shrink-0") {
                    sidebar_provider (class: "w-full min-h-0 flex-1 flex-col") {
                        // 2026-09-05: sidebar_content(内置 overflow-auto 原生
                        // 滚动条) → scroll(AutoUI 组件,Vue=shadcn ScrollArea
                        // 主题化滚动条,VM=Scrollable)——用户裁定。
                        scroll (style: "flex-1 min-h-0 px-3 py-4") {
                        // Overview group
                        sidebar_group {
                            sidebar_group_label { text "Overview" }
                            sidebar_group_content {
                                sidebar_menu {
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/", exact: true) {
                                            icon (name: "home") {}
                                            text "Home" {}
                                        }
                                    }

                                }
                            }
                        }
                        // Layout group (Plan 412: 布局专区,插在 Overview 之后)
                        sidebar_group {
                            sidebar_group_label { text "Layout" }
                            sidebar_group_content {
                                sidebar_menu {
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/row") {
                                            icon (name: "arrow-right") {}
                                            text "Row" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/col") {
                                            icon (name: "arrow-down") {}
                                            text "Column" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/center") {
                                            icon (name: "plus") {}
                                            text "Center" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/flex") {
                                            icon (name: "move-horizontal") {}
                                            text "Flex" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/alignment") {
                                            icon (name: "align-center") {}
                                            text "Alignment" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/absolute") {
                                            icon (name: "move") {}
                                            text "Absolute" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/spacing") {
                                            icon (name: "space") {}
                                            text "Spacing" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/sizing") {
                                            icon (name: "ruler") {}
                                            text "Sizing" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/scroll") {
                                            icon (name: "chevrons-down") {}
                                            text "Scroll" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/position") {
                                            icon (name: "layers") {}
                                            text "Position" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/responsive") {
                                            icon (name: "monitor") {}
                                            text "Responsive" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/grid") {
                                            icon (name: "layout-grid") {}
                                            text "Grid" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/grid-span") {
                                            icon (name: "square-stack") {}
                                            text "GridSpan" {}
                                        }
                                    }

                                }
                            }
                        }
                        // Form group
                        sidebar_group {
                            sidebar_group_label { text "Form" }
                            sidebar_group_content {
                                sidebar_menu {
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/button") {
                                            icon (name: "mouse-pointer-click") {}
                                            text "Button" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/calendar") {
                                            icon (name: "layout-grid") {}
                                            text "Calendar" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/checkbox") {
                                            icon (name: "square-stack") {}
                                            text "Checkbox" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/code-editor") {
                                            icon (name: "type") {}
                                            text "CodeEditor" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/combobox") {
                                            icon (name: "command") {}
                                            text "Combobox" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/datepicker") {
                                            icon (name: "layout-grid") {}
                                            text "DatePicker" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/form") {
                                            icon (name: "layout-grid") {}
                                            text "Form" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/input") {
                                            icon (name: "type") {}
                                            text "Input" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/label") {
                                            icon (name: "type") {}
                                            text "Label" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/radiogroup") {
                                            icon (name: "layout-grid") {}
                                            text "RadioGroup" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/select") {
                                            icon (name: "layout-grid") {}
                                            text "Select" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/slider") {
                                            icon (name: "layout-grid") {}
                                            text "Slider" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/switch") {
                                            icon (name: "square-stack") {}
                                            text "Switch" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/textarea") {
                                            icon (name: "type") {}
                                            text "Textarea" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/toggle") {
                                            icon (name: "square-stack") {}
                                            text "Toggle" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/togglegroup") {
                                            icon (name: "layout-grid") {}
                                            text "ToggleGroup" {}
                                        }
                                    }

                                }
                            }
                        }
                        // Charts group (Plan 437)
                        sidebar_group {
                            sidebar_group_label { text "Charts" }
                            sidebar_group_content {
                                sidebar_menu {
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/line-chart") {
                                            icon (name: "activity") {}
                                            text "LineChart" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/bar-chart") {
                                            icon (name: "bar-chart-3") {}
                                            text "BarChart" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/area-chart") {
                                            icon (name: "area-chart") {}
                                            text "AreaChart" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/donut-chart") {
                                            icon (name: "circle") {}
                                            text "DonutChart" {}
                                        }
                                    }

                                }
                            }
                        }
                        // Diagrams group (Plan 502)
                        sidebar_group {
                            sidebar_group_label { text "Diagrams" }
                            sidebar_group_content {
                                sidebar_menu {
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/flow-diagram") {
                                            icon (name: "git-branch") {}
                                            text "FlowDiagram" {}
                                        }
                                    }

                                }
                            }
                        }
                        // Display group
                        sidebar_group {
                            sidebar_group_label { text "Display" }
                            sidebar_group_content {
                                sidebar_menu {
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/aspectratio") {
                                            icon (name: "image") {}
                                            text "AspectRatio" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/avatar") {
                                            icon (name: "image") {}
                                            text "Avatar" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/badge") {
                                            icon (name: "bell") {}
                                            text "Badge" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/card") {
                                            icon (name: "square-stack") {}
                                            text "Card" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/carousel") {
                                            icon (name: "layout-grid") {}
                                            text "Carousel" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/datatable") {
                                            icon (name: "layout-grid") {}
                                            text "DataTable" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/skeleton") {
                                            icon (name: "layout-grid") {}
                                            text "Skeleton" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/table") {
                                            icon (name: "layout-grid") {}
                                            text "Table" {}
                                        }
                                    }

                                }
                            }
                        }
                        // Feedback group
                        sidebar_group {
                            sidebar_group_label { text "Feedback" }
                            sidebar_group_content {
                                sidebar_menu {
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/alert") {
                                            icon (name: "bell") {}
                                            text "Alert" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/progress") {
                                            icon (name: "layout-grid") {}
                                            text "Progress" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/sonner") {
                                            icon (name: "bell") {}
                                            text "Sonner" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/toast") {
                                            icon (name: "bell") {}
                                            text "Toast" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/tooltip") {
                                            icon (name: "bell") {}
                                            text "Tooltip" {}
                                        }
                                    }

                                }
                            }
                        }
                        // Navigation group
                        sidebar_group {
                            sidebar_group_label { text "Navigation" }
                            sidebar_group_content {
                                sidebar_menu {
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/breadcrumb") {
                                            icon (name: "navigation") {}
                                            text "Breadcrumb" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/command") {
                                            icon (name: "command") {}
                                            text "Command" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/menubar") {
                                            icon (name: "layout-grid") {}
                                            text "Menubar" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/navigationmenu") {
                                            icon (name: "navigation") {}
                                            text "NavigationMenu" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/pagination") {
                                            icon (name: "layout-grid") {}
                                            text "Pagination" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/scrollarea") {
                                            icon (name: "layout-grid") {}
                                            text "ScrollArea" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/separator") {
                                            icon (name: "layout-grid") {}
                                            text "Separator" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/sidebar") {
                                            icon (name: "layout-grid") {}
                                            text "Sidebar" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/tabs") {
                                            icon (name: "layout-grid") {}
                                            text "Tabs" {}
                                        }
                                    }

                                }
                            }
                        }
                        // Overlay group
                        sidebar_group {
                            sidebar_group_label { text "Overlay" }
                            sidebar_group_content {
                                sidebar_menu {
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/accordion") {
                                            icon (name: "layout-grid") {}
                                            text "Accordion" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/alertdialog") {
                                            icon (name: "bell") {}
                                            text "AlertDialog" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/collapsible") {
                                            icon (name: "layout-grid") {}
                                            text "Collapsible" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/contextmenu") {
                                            icon (name: "layout-grid") {}
                                            text "ContextMenu" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/dialog") {
                                            icon (name: "square-stack") {}
                                            text "Dialog" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/drawer") {
                                            icon (name: "layout-grid") {}
                                            text "Drawer" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/dropdownmenu") {
                                            icon (name: "layout-grid") {}
                                            text "DropdownMenu" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/hovercard") {
                                            icon (name: "layout-grid") {}
                                            text "HoverCard" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/popover") {
                                            icon (name: "layout-grid") {}
                                            text "Popover" {}
                                        }
                                    }
                                    sidebar_menu_item {
                                        sidebar_menu_button (to: "/sheet") {
                                            icon (name: "square-stack") {}
                                            text "Sheet" {}
                                        }
                                    }
                            }
                        }
                    }
                        }
                    }
                }

                // Mobile sidebar drawer
                drawer (open: .sidebarOpen, onClose: .closeSidebar) {
                    // Mobile navigation
                }

                // Main content
                main (style: "flex-1 overflow-hidden") {
                    sidebar_provider (class: "w-full min-h-0 flex-1 flex-col") {
                        sidebar_content (style: "h-full") {
                        div (style: "p-4 md:p-8 lg:p-10 max-w-5xl mx-auto pb-32 md:pb-20") {
                            outlet
                        }
                        }
                    }
                }
            }

            // Mobile bottom nav (hidden on md+)
            row (style: "md:hidden fixed bottom-0 left-0 right-0 h-16 bg-background/95 backdrop-blur border-t z-40 items-center justify-around") {
                link (to: "/") {
                    col (style: "items-center gap-0.5 py-2 px-3") {
                        icon (name: "home", style: "h-5 w-5") {}
                        text "Home" (style: "text-[10px]") {}
                    }
                }
                button (variant: "ghost", onClick: .openSidebar) {
                    col (style: "items-center gap-0.5 py-2 px-3") {
                        icon (name: "layout-grid", style: "h-5 w-5") {}
                        text "Widgets" (style: "text-[10px]") {}
                    }
                }
                button (variant: "ghost", onClick: .openSearch) {
                    col (style: "items-center gap-0.5 py-2 px-3") {
                        icon (name: "search", style: "h-5 w-5") {}
                        text "Search" (style: "text-[10px]") {}
                    }
                }
            }
        }
    }
}
