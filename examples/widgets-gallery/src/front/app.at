// src/front/app.at - Widgets Gallery Documentation Site
// Responsive layout with categorized navigation. Based on the comprehensive
// gallery (examples/gallery) with the Plan 408 §9 codegen fixes applied:
// 'grid' is usable as a route name (route /grid), NavLink href maps to
// router-link `to`, Slider/Drawer/Toast/Pagination render with the fixed
// shadcn-vue mappings.

widget App {
    // Route definitions
    routes {
        "/" -> use index
        "/accordion" -> use accordion
        "/alert" -> use alert
        "/alertdialog" -> use alertdialog
        "/alignment" -> use alignment
        "/aspectratio" -> use aspectratio
        "/avatar" -> use avatar
        "/badge" -> use badge
        "/breadcrumb" -> use breadcrumb
        "/center" -> use center
        "/button" -> use button
        "/col" -> use col
        "/calendar" -> use calendar
        "/card" -> use card
        "/carousel" -> use carousel
        "/code-editor" -> use code-editor
        "/checkbox" -> use checkbox
        "/collapsible" -> use collapsible
        "/combobox" -> use combobox
        "/command" -> use command
        "/contextmenu" -> use contextmenu
        "/datatable" -> use datatable
        "/datepicker" -> use datepicker
        "/line-chart" -> use line-chart
        "/bar-chart" -> use bar-chart
        "/area-chart" -> use area-chart
        "/donut-chart" -> use donut-chart
        "/dialog" -> use dialog
        "/drawer" -> use drawer
        "/dropdownmenu" -> use dropdownmenu
        "/flex" -> use flex
        "/form" -> use form
        "/grid" -> use grid
        "/grid-span" -> use grid-span
        "/hovercard" -> use hovercard
        "/input" -> use input
        "/kitchen-sink" -> use kitchen-sink
        "/label" -> use label
        "/menubar" -> use menubar
        "/navigationmenu" -> use navigationmenu
        "/navlink" -> use navlink
        "/navitem" -> use navitem
        "/pagination" -> use pagination
        "/popover" -> use popover
        "/position" -> use position
        "/progress" -> use progress
        "/radiogroup" -> use radiogroup
        "/responsive" -> use responsive
        "/row" -> use row
        "/scroll" -> use scroll
        "/scrollarea" -> use scrollarea
        "/select" -> use select
        "/separator" -> use separator
        "/sizing" -> use sizing
        "/spacing" -> use spacing
        "/sheet" -> use sheet
        "/sidebar" -> use sidebar
        "/skeleton" -> use skeleton
        "/slider" -> use slider
        "/sonner" -> use sonner
        "/switch" -> use switch
        "/table" -> use table
        "/tabs" -> use tabs
        "/textarea" -> use textarea
        "/toast" -> use toast
        "/toggle" -> use toggle
        "/togglegroup" -> use togglegroup
        "/tooltip" -> use tooltip
    }

    model {
        sidebarOpen bool = false
        searchOpen bool = false
        searchQuery str = ""
        // Plan 409 §8: theme color picker state. accent_color drives the
        // primary color in both vm (iced_adapter ACCENT_NAME) and vue
        // (applyAccent → --primary). Palette: indigo/coral/ocean/sage/amber
        // (aligned with auto-forge).
        themeOpen bool = false
        accent_color str = "indigo"
    }

    on {
        .openSidebar -> { sidebarOpen = true }
        .closeSidebar -> { sidebarOpen = false }
        .openSearch -> { searchOpen = true }
        .closeSearch -> { searchOpen = false }
        .openThemePicker -> { themeOpen = !themeOpen }
        .SetAccent(name) -> { accent_color = name }
    }

    view {
        col (style: "h-screen overflow-hidden") {
            // Header: responsive with mobile menu and search
            header (style: "sticky top-0 z-40 w-full border-b bg-background/95 backdrop-blur") {
                row (style: "h-14 items-center px-4 md:px-6 w-full gap-3") {
                    // Mobile hamburger (hidden on md+)
                    button (variant: "ghost", style: "md:hidden -ml-2", icon: "menu", onClick: .openSidebar) {}

                    // Logo
                    row (style: "items-center gap-2 mr-4 shrink-0") {
                        icon (name: "layers", style: "h-5 w-5 text-primary") {}
                        text "Auto UI" (style: "font-bold text-lg hidden sm:inline") {}
                    }

                    // Desktop nav
                    row (style: "hidden md:flex items-center gap-1 text-sm") {
                        link (to: "/") {
                            text "Docs" (style: "px-3 py-1.5 rounded-md transition-colors") {}
                        }
                        link (to: "/button") {
                            text "Widgets" (style: "px-3 py-1.5 rounded-md transition-colors") {}
                        }
                    }

                    // Right actions
                    row (style: "ml-auto items-center gap-1") {
                        button (variant: "ghost", style: "hidden md:flex h-9 w-9", icon: "search", onClick: .openSearch) {}
                        // Plan 409 §8: theme color picker toggle (palette icon)
                        button (variant: "ghost", style: "h-9 w-9", icon: "palette", onClick: .openThemePicker) {}
                    }
                }
            }

            // Plan 409 §8: theme color picker panel. VM ignores `absolute`
            // (iced limitation) so it renders inline below the header; vue
            // uses absolute positioning for a floating popover.
            if .themeOpen {
                row (style: "absolute right-4 top-14 z-50 items-center gap-1.5 rounded-lg border bg-popover p-2 shadow-lg") {
                    button (onClick: .SetAccent("indigo"), style: if .accent_color == "indigo" { "h-5 w-5 rounded-full bg-indigo-500 ring-2 ring-offset-2 ring-offset-popover ring-primary" } else { "h-5 w-5 rounded-full bg-indigo-500 hover:scale-110 transition-transform" }) {}
                    button (onClick: .SetAccent("coral"), style: if .accent_color == "coral" { "h-5 w-5 rounded-full bg-rose-500 ring-2 ring-offset-2 ring-offset-popover ring-primary" } else { "h-5 w-5 rounded-full bg-rose-500 hover:scale-110 transition-transform" }) {}
                    button (onClick: .SetAccent("ocean"), style: if .accent_color == "ocean" { "h-5 w-5 rounded-full bg-blue-500 ring-2 ring-offset-2 ring-offset-popover ring-primary" } else { "h-5 w-5 rounded-full bg-blue-500 hover:scale-110 transition-transform" }) {}
                    button (onClick: .SetAccent("sage"), style: if .accent_color == "sage" { "h-5 w-5 rounded-full bg-emerald-500 ring-2 ring-offset-2 ring-offset-popover ring-primary" } else { "h-5 w-5 rounded-full bg-emerald-500 hover:scale-110 transition-transform" }) {}
                    button (onClick: .SetAccent("amber"), style: if .accent_color == "amber" { "h-5 w-5 rounded-full bg-amber-500 ring-2 ring-offset-2 ring-offset-popover ring-primary" } else { "h-5 w-5 rounded-full bg-amber-500 hover:scale-110 transition-transform" }) {}
                }
            }

            // Search overlay
            drawer (open: .searchOpen, onClose: .closeSearch) {
                // Global search dialog
            }

            // Main layout: sidebar + content
            row (style: "flex-1 overflow-hidden") {
                // Desktop sidebar (hidden on mobile)
                aside (style: "hidden md:flex w-64 lg:w-72 border-r bg-background flex-col shrink-0") {
                    scroll (style: "flex-1 px-3 py-4") {
                        // Overview group
                        text "Overview" (style: "mb-1.5 px-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground") {}
                        nav-item (to: "/", icon: "home", label: "Home")

                        // Layout group (Plan 412: 布局专区,插在 Overview 之后)
                        text "Layout" (style: "mt-4 mb-1.5 px-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground") {}
                        nav-item (to: "/row", icon: "arrow-right", label: "Row")
                        nav-item (to: "/col", icon: "arrow-down", label: "Column")
                        nav-item (to: "/center", icon: "plus", label: "Center")
                        nav-item (to: "/flex", icon: "move-horizontal", label: "Flex")
                        nav-item (to: "/alignment", icon: "align-center", label: "Alignment")
                        nav-item (to: "/spacing", icon: "space", label: "Spacing")
                        nav-item (to: "/sizing", icon: "ruler", label: "Sizing")
                        nav-item (to: "/scroll", icon: "chevrons-down", label: "Scroll")
                        nav-item (to: "/position", icon: "layers", label: "Position")
                        nav-item (to: "/responsive", icon: "monitor", label: "Responsive")
                        nav-item (to: "/grid", icon: "layout-grid", label: "Grid")
                        nav-item (to: "/grid-span", icon: "square-stack", label: "GridSpan")

                        // Form group
                        text "Form" (style: "mt-4 mb-1.5 px-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground") {}
                        nav-item (to: "/button", icon: "mouse-pointer-click", label: "Button")
                        nav-item (to: "/calendar", icon: "layout-grid", label: "Calendar")
                        nav-item (to: "/checkbox", icon: "square-stack", label: "Checkbox")
                        nav-item (to: "/code-editor", icon: "type", label: "CodeEditor")
                        nav-item (to: "/combobox", icon: "command", label: "Combobox")
                        nav-item (to: "/datepicker", icon: "layout-grid", label: "DatePicker")
                        nav-item (to: "/form", icon: "layout-grid", label: "Form")
                        nav-item (to: "/input", icon: "type", label: "Input")
                        nav-item (to: "/label", icon: "type", label: "Label")
                        nav-item (to: "/radiogroup", icon: "layout-grid", label: "RadioGroup")
                        nav-item (to: "/select", icon: "layout-grid", label: "Select")
                        nav-item (to: "/slider", icon: "layout-grid", label: "Slider")
                        nav-item (to: "/switch", icon: "square-stack", label: "Switch")
                        nav-item (to: "/textarea", icon: "type", label: "Textarea")
                        nav-item (to: "/toggle", icon: "square-stack", label: "Toggle")
                        nav-item (to: "/togglegroup", icon: "layout-grid", label: "ToggleGroup")

                        // Charts group (Plan 437)
                        text "Charts" (style: "mt-4 mb-1.5 px-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground") {}
                        nav-item (to: "/line-chart", icon: "activity", label: "LineChart")
                        nav-item (to: "/bar-chart", icon: "bar-chart-3", label: "BarChart")
                        nav-item (to: "/area-chart", icon: "area-chart", label: "AreaChart")
                        nav-item (to: "/donut-chart", icon: "circle", label: "DonutChart")

                        // Display group
                        text "Display" (style: "mt-4 mb-1.5 px-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground") {}
                        nav-item (to: "/aspectratio", icon: "image", label: "AspectRatio")
                        nav-item (to: "/avatar", icon: "image", label: "Avatar")
                        nav-item (to: "/badge", icon: "bell", label: "Badge")
                        nav-item (to: "/card", icon: "square-stack", label: "Card")
                        nav-item (to: "/carousel", icon: "layout-grid", label: "Carousel")
                        nav-item (to: "/datatable", icon: "layout-grid", label: "DataTable")
                        nav-item (to: "/skeleton", icon: "layout-grid", label: "Skeleton")
                        nav-item (to: "/table", icon: "layout-grid", label: "Table")

                        // Feedback group
                        text "Feedback" (style: "mt-4 mb-1.5 px-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground") {}
                        nav-item (to: "/alert", icon: "bell", label: "Alert")
                        nav-item (to: "/progress", icon: "layout-grid", label: "Progress")
                        nav-item (to: "/sonner", icon: "bell", label: "Sonner")
                        nav-item (to: "/toast", icon: "bell", label: "Toast")
                        nav-item (to: "/tooltip", icon: "bell", label: "Tooltip")

                        // Navigation group
                        text "Navigation" (style: "mt-4 mb-1.5 px-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground") {}
                        nav-item (to: "/breadcrumb", icon: "navigation", label: "Breadcrumb")
                        nav-item (to: "/command", icon: "command", label: "Command")
                        nav-item (to: "/menubar", icon: "layout-grid", label: "Menubar")
                        nav-item (to: "/navigationmenu", icon: "navigation", label: "NavigationMenu")
                        nav-item (to: "/navlink", icon: "navigation", label: "NavLink")
                        nav-item (to: "/navitem", icon: "mouse-pointer-click", label: "NavItem")
                        nav-item (to: "/pagination", icon: "layout-grid", label: "Pagination")
                        nav-item (to: "/scrollarea", icon: "layout-grid", label: "ScrollArea")
                        nav-item (to: "/separator", icon: "layout-grid", label: "Separator")
                        nav-item (to: "/sidebar", icon: "layout-grid", label: "Sidebar")
                        nav-item (to: "/tabs", icon: "layout-grid", label: "Tabs")

                        // Overlay group
                        text "Overlay" (style: "mt-4 mb-1.5 px-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground") {}
                        nav-item (to: "/accordion", icon: "layout-grid", label: "Accordion")
                        nav-item (to: "/alertdialog", icon: "bell", label: "AlertDialog")
                        nav-item (to: "/collapsible", icon: "layout-grid", label: "Collapsible")
                        nav-item (to: "/contextmenu", icon: "layout-grid", label: "ContextMenu")
                        nav-item (to: "/dialog", icon: "square-stack", label: "Dialog")
                        nav-item (to: "/drawer", icon: "layout-grid", label: "Drawer")
                        nav-item (to: "/dropdownmenu", icon: "layout-grid", label: "DropdownMenu")
                        nav-item (to: "/hovercard", icon: "layout-grid", label: "HoverCard")
                        nav-item (to: "/popover", icon: "layout-grid", label: "Popover")
                        nav-item (to: "/sheet", icon: "square-stack", label: "Sheet")
                    }
                }

                // Mobile sidebar drawer
                drawer (open: .sidebarOpen, onClose: .closeSidebar) {
                    // Mobile navigation
                }

                // Main content
                main (style: "flex-1 overflow-hidden") {
                    scroll (style: "h-full") {
                        div (style: "p-4 md:p-8 lg:p-10 max-w-5xl mx-auto pb-32 md:pb-20") {
                            outlet
                        }
                    }
                }
            }

            // Mobile bottom nav (hidden on md+)
            row (style: "md:hidden fixed bottom-0 left-0 right-0 h-16 bg-background/95 backdrop-blur border-t z-40 items-center justify-around") {
                link (to: "/") {
                    col (style: "items-center gap-0.5 py-2 px-3") {
                        icon (name: "home", style: "h-5 w-5") {}
                        text "Home" (style: "text-[10px]") {}
                    }
                }
                button (variant: "ghost", onClick: .openSidebar) {
                    col (style: "items-center gap-0.5 py-2 px-3") {
                        icon (name: "layout-grid", style: "h-5 w-5") {}
                        text "Widgets" (style: "text-[10px]") {}
                    }
                }
                button (variant: "ghost", onClick: .openSearch) {
                    col (style: "items-center gap-0.5 py-2 px-3") {
                        icon (name: "search", style: "h-5 w-5") {}
                        text "Search" (style: "text-[10px]") {}
                    }
                }
            }
        }
    }
}
