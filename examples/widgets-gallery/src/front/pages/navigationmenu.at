// pages/navigationmenu.at - NavigationMenu component documentation page

widget NavigationmenuPage {
    model { activeTab str = "preview" }

    view {
        col {
            h1 "NavigationMenu"
            text "NavigationMenu is a horizontal navigation bar with support for dropdown panels that reveal categorized links. Each top-level item can be a simple link or a trigger that opens a content panel. Ideal for site headers, documentation navigation, and multi-level product menus."

            h2 "Installation"
            codeblock (lang: "bash", code: "npx shadcn-vue@latest add navigation-menu") {}

            h2 "Simple"
            preview-card (id: "navigationmenu-basic") {
                row (style: "gap-4") {
                    navigation-menu {}
                }
            }

            h2 "Properties"
            table {
                thead {
                    tr {
                        th "Property"
                        th "Type"
                        th "Default"
                        th "Values"
                        th "Description"
                    }
                }
                tbody {
                    tr {
                        td "text"
                        td "string"
                        td "-"
                        td "-"
                        td "Link text"
                    }
                    tr {
                        td "href"
                        td "string"
                        td "-"
                        td "-"
                        td "Link destination"
                    }
                }
            }
        }
    }
}
