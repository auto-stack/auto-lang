// pages/menubar.at - Menubar component documentation page

widget MenubarPage {
    model { activeTab str = "preview" }

    view {
        col {
            h1 "Menubar"
            text "Menubar is a horizontal menu bar with dropdown menus, mimicking the classic desktop application menu (File, Edit, View, etc.). Each menu contains a trigger button and a dropdown with items, separators, and checkbox items. Ideal for tool-heavy applications, editors, and dashboards with many actions."

            h2 "Installation"
            codeblock (lang: "bash", code: "npx shadcn-vue@latest add menubar") {}

            h2 "Simple"
            preview-card (id: "menubar-basic") {
                row (gap: "4") {
                    menubar {}
                }
            }

            h2 "Properties"
            table {
                thead {
                    tr {
                        th "Property"
                        th "Type"
                        th "Default"
                        th "Values"
                        th "Description"
                    }
                }
                tbody {
                    tr {
                        td "text"
                        td "string"
                        td "-"
                        td "-"
                        td "Menu label text"
                    }
                    tr {
                        td "disabled"
                        td "boolean"
                        td "false"
                        td "true, false"
                        td "Disables the menu item"
                    }
                }
            }
        }
    }
}
