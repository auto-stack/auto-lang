// pages/togglegroup.at - ToggleGroup component documentation page

widget TogglegroupPage {
    model {
        activeTab str = "preview"
        alignment str = "center"
    }

    view {
        col {
            h1 "ToggleGroup"
            text "ToggleGroup coordinates a set of Toggle buttons for single-select or multi-select behavior. In single mode, pressing one toggle releases the others (like a RadioGroup with button styling). In multiple mode, any number can be active simultaneously. Ideal for alignment controls, view mode switches, and filter groups."

            h2 "Installation"
            codeblock (lang: "bash", code: "npx shadcn-vue@latest add toggle-group") {}

            h2 "Multiple"
            preview-card (id: "togglegroup-basic") {
                // PLAN-528 W8: 连体样式——root 注入 gap-0 + 相邻 -ml-px 边框
                // 叠压 + 首尾圆角,把旧脚手架的 gap-1 分离观感合并成整块
                togglegroup (type: "multiple", variant: "outline", class: "gap-0 [&>*+*]:-ml-px [&>*:first-child]:rounded-l-md [&>*:first-child]:rounded-r-none [&>*:last-child]:rounded-r-md [&>*:last-child]:rounded-l-none [&>*:not(:first-child):not(:last-child)]:rounded-none") {
                    togglegroup-item (value: "bold", aria-label: "Toggle bold") {
                        text "B"
                    }
                    togglegroup-item (value: "italic", aria-label: "Toggle italic") {
                        text "I"
                    }
                    togglegroup-item (value: "underline", aria-label: "Toggle underline") {
                        text "U"
                    }
                }
            }

            h2 "Single (alignment)"
            preview-card (id: "togglegroup-single") {
                col (style: "gap-2 items-center") {
                    togglegroup (type: "single", variant: "outline", value: .alignment, class: "gap-0 [&>*+*]:-ml-px [&>*:first-child]:rounded-l-md [&>*:first-child]:rounded-r-none [&>*:last-child]:rounded-r-md [&>*:last-child]:rounded-l-none [&>*:not(:first-child):not(:last-child)]:rounded-none") {
                        togglegroup-item (value: "left", aria-label: "Align left") {
                            text "Left"
                        }
                        togglegroup-item (value: "center", aria-label: "Align center") {
                            text "Center"
                        }
                        togglegroup-item (value: "right", aria-label: "Align right") {
                            text "Right"
                        }
                    }
                    text f"Selected: ${.alignment}" { style: "text-sm text-muted-foreground" }
                }
            }

            h2 "Properties"
            table {
                thead {
                    tr {
                        th "Property"
                        th "Type"
                        th "Default"
                        th "Values"
                        th "Description"
                    }
                }
                tbody {
                    tr {
                        td "type"
                        td "string"
                        td (text: "\"single\"") {}
                        td (text: "\"single\", \"multiple\"") {}
                        td "Selection type"
                    }
                    tr {
                        td "variant"
                        td "string"
                        td (text: "\"default\"") {}
                        td (text: "\"default\", \"outline\"") {}
                        td "Toggle style variant"
                    }
                    tr {
                        td "size"
                        td "string"
                        td (text: "\"default\"") {}
                        td (text: "\"default\", \"sm\", \"lg\"") {}
                        td "Toggle size"
                    }
                    tr {
                        td "disabled"
                        td "boolean"
                        td "false"
                        td "true, false"
                        td "Disables the group"
                    }
                }
            }
        }
    }
}
