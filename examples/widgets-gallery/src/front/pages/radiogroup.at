// pages/radiogroup.at - RadioGroup component documentation page

widget RadiogroupPage {
    model { activeTab str = "preview" }

    view {
        col {
            h1 "RadioGroup"
            text "RadioGroup is a set of mutually exclusive options where selecting one automatically deselects the others. Use it when the user must choose exactly one item from a known set — payment methods, shipping options, or preference settings. Unlike Checkbox (multi-select), RadioGroup enforces a single selection."

            h2 "Installation"
            codeblock (lang: "bash", code: "npx shadcn-vue@latest add radio-group") {}

            h2 "Simple"
            preview-card (id: "radiogroup-basic") {
                radiogroup (default: "option-one") {
                    row (style: "gap-2 items-center") {
                        radioitem (value: "option-one", id: "option-one") {}
                        label (text: "Option One", for: "option-one") {}
                    }
                    row (style: "gap-2 items-center") {
                        radioitem (value: "option-two", id: "option-two") {}
                        label (text: "Option Two", for: "option-two") {}
                    }
                }
            }

            h2 "Properties"
            table {
                thead {
                    tr {
                        th "Property"
                        th "Type"
                        th "Default"
                        th "Values"
                        th "Description"
                    }
                }
                tbody {
                    tr {
                        td "value"
                        td "string"
                        td "-"
                        td "Selected radio value"
                        td "disabled"
                        td "boolean"
                        td "false"
                        td "true, false"
                        td "Disables the group"
                    }
                }
            }
        }
    }
}
