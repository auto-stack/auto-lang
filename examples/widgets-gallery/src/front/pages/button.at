// pages/button.at - Button component documentation page

widget ButtonPage {
    model { activeTab str = "preview" }

    on {
        .showClickToast -> { toast("You Clicked Me!") }
    }

    view {
        col {
            h1 "Button"
            text "Button triggers an action or event — submitting a form, opening a dialog, navigating to a page, or toggling a state. Six variants (default, secondary, destructive, outline, ghost, link) and three sizes (sm, default, lg) cover most interaction patterns. Use the disabled state to prevent interaction during loading or when prerequisites are unmet."

            h2 "Installation"
            codeblock (lang: "bash", code: "npx shadcn-vue@latest add button") {}

            h2 "Simple"
            preview-card (id: "button-basic") {
                button "Button"
            }

            h2 "Variants"
            preview-card (id: "button-variants") {
                row (style: "gap-2") {
                    button "Default"
                    button (text: "Secondary", variant: "secondary") {}
                    button (text: "Destructive", variant: "destructive") {}
                    button (text: "Outline", variant: "outline") {}
                    button (text: "Ghost", variant: "ghost") {}
                    button (text: "Link", variant: "link") {}
                }
            }

            h2 "Sizes"
            preview-card (id: "button-sizes") {
                row (style: "gap-2") {
                    button (text: "Small", size: "sm") {}
                    button "Default"
                    button (text: "Large", size: "lg") {}
                }
            }

            h2 "Events"
            preview-card (id: "button-events") {
                col (style: "gap-3") {
                    button (text: "Click Me", onClick: .showClickToast) {}
                    text "Click the button to fire a toast via the onClick handler." { style: "text-sm text-muted-foreground" }
                    toast-provider {}
                }
            }

            h2 "Properties"
            table {
                thead {
                    tr {
                        th "Property"
                        th "Type"
                        th "Default"
                        th "Values"
                        th "Description"
                    }
                }
                tbody {
                    tr {
                        td "text"
                        td "string"
                        td "-"
                        td "-"
                        td "Button label text (slot content)"
                    }
                    tr {
                        td "variant"
                        td "string"
                        td "default"
                        td "default, secondary, destructive, outline, ghost, link"
                        td "Visual style variant"
                    }
                    tr {
                        td "size"
                        td "string"
                        td "default"
                        td "sm, default, lg, icon"
                        td "Button size"
                    }
                    tr {
                        td "disabled"
                        td "boolean"
                        td "false"
                        td "true, false"
                        td "Disables the button"
                    }
                }
            }
        }
    }
}
