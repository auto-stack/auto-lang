// pages/hovercard.at - HoverCard component documentation page

widget HovercardPage {
    model { activeTab str = "preview" }

    view {
        col {
            h1 "HoverCard"
            text "HoverCard displays a rich content preview — such as a user profile or link summary — when the user hovers over a trigger element. Unlike Tooltip (which shows brief text hints), HoverCard can contain images, buttons, and structured layouts. Ideal for social previews, link cards, and contextual detail popovers."

            h2 "Installation"
            codeblock (lang: "bash", code: "npx shadcn-vue@latest add hover-card") {}

            h2 "Simple"
            preview-card (id: "hovercard-basic") {
                row (style: "gap-4") {
                    hovercard {
                        hover-card-trigger {
                            avatar {
                                avatar-image (src: "https://github.com/shadcn.png") {}
                                avatar-fallback "SC"
                            }
                        }
                        hover-card-content {
                            col (style: "gap-3 w-80") {
                                row (style: "gap-4") {
                                    avatar {
                                        avatar-image (src: "https://github.com/shadcn.png") {}
                                        avatar-fallback "SC"
                                    }
                                    col (style: "gap-1") {
                                        h4 "@shadcn"
                                        text "Vue component library"
                                    }
                                }
                            }
                        }
                    }
                }
            }

            h2 "Properties"
            table {
                thead {
                    tr {
                        th "Property"
                        th "Type"
                        th "Default"
                        th "Values"
                        th "Description"
                    }
                }
                tbody {
                    tr {
                        td "open-delay"
                        td "number"
                        td "700"
                        td "-"
                        td "Delay before opening (ms)"
                    }
                    tr {
                        td "close-delay"
                        td "number"
                        td "300"
                        td "-"
                        td "Delay before closing (ms)"
                    }
                    tr {
                        td "open"
                        td "boolean"
                        td "false"
                        td "true, false"
                        td "Controls the open state"
                    }
                }
            }
        }
    }
}
