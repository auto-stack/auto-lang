// pages/aspectratio.at - AspectRatio component documentation page

widget AspectratioPage {
    model { activeTab str = "preview" }

    view {
        col {
            h1 "AspectRatio"
            text "AspectRatio maintains a consistent width-to-height ratio for its children, preventing layout shift as images and videos load. Essential for responsive media galleries, video players, and card thumbnails where maintaining proportions across screen sizes matters. Common ratios include 16:9 for video, 4:3 for photos, and 1:1 for avatars."

            h2 "Installation"
            codeblock (lang: "bash", code: "npx shadcn-vue@latest add aspect-ratio") {}

            h2 "Example"
            preview-card (id: "aspectratio-basic") {
                div (style: "w-[450px] bg-muted rounded-md overflow-hidden border") {
                    aspect-ratio (ratio: 1.777) {
                        img (src: "https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=800&dpr=2&q=80", alt: "Photo by Drew Beamer", style: "object-cover w-full h-full") {}
                    }
                }
            }

            h2 "Common Ratios"
            preview-card (id: "aspectratio-ratios") {
                row (style: "gap-4 flex-wrap") {
                    col (style: "gap-2 w-[150px]") {
                        div (style: "bg-muted rounded-md overflow-hidden") {
                            aspect-ratio (ratio: 1.0) {
                                div (style: "flex items-center justify-center w-full h-full bg-primary/10") {
                                    text "1:1"
                                }
                            }
                        }
                        text (text: "Square (1:1)", style: "text-sm text-muted-foreground") {}
                    }
                    col (style: "gap-2 w-[150px]") {
                        div (style: "bg-muted rounded-md overflow-hidden") {
                            aspect-ratio (ratio: 1.777) {
                                div (style: "flex items-center justify-center w-full h-full bg-primary/10") {
                                    text "16:9"
                                }
                            }
                        }
                        text (text: "Widescreen (16:9)", style: "text-sm text-muted-foreground") {}
                    }
                    col (style: "gap-2 w-[150px]") {
                        div (style: "bg-muted rounded-md overflow-hidden") {
                            aspect-ratio (ratio: 0.5625) {
                                div (style: "flex items-center justify-center w-full h-full bg-primary/10") {
                                    text "9:16"
                                }
                            }
                        }
                        text (text: "Portrait (9:16)", style: "text-sm text-muted-foreground") {}
                    }
                    col (style: "gap-2 w-[150px]") {
                        div (style: "bg-muted rounded-md overflow-hidden") {
                            aspect-ratio (ratio: 1.333) {
                                div (style: "flex items-center justify-center w-full h-full bg-primary/10") {
                                    text "4:3"
                                }
                            }
                        }
                        text (text: "Standard (4:3)", style: "text-sm text-muted-foreground") {}
                    }
                }
            }

            h2 "Properties"
            table {
                thead {
                    tr {
                        th "Property"
                        th "Type"
                        th "Default"
                        th "Values"
                        th "Description"
                    }
                }
                tbody {
                    tr {
                        td "ratio"
                        td "number"
                        td "1"
                        td "-"
                        td "The aspect ratio (width/height)"
                    }
                }
            }
        }
    }
}
