// pages/alignment.at - items × justify matrix documentation (Plan 412 Layout gallery)

widget AlignmentPage {
    model { activeTab str = "preview" }

    view {
        col {
            h1 "Alignment"
            text "The items-* × justify-* matrix. items-* controls the cross axis, justify-* the main axis. This page shows every combination in one fixed-height grid: 3 items values × 4 justify values."

            h2 "items × justify Matrix (3 × 4)"
            preview-card (id: "alignment-matrix") {
                div (style: "grid grid-cols-4 gap-2 w-full") {
                    col (style: "rounded-md border bg-card p-1") {
                        text "start / start" (style: "text-[10px] text-muted-foreground text-center mb-1") {}
                        row (style: "items-start justify-start gap-1 h-16") {
                            square (color: "blue", size: 8, text: "1") {}
                            square (color: "blue", h: 12, w: 6, text: "2") {}
                            square (color: "blue", h: 6, w: 10, text: "3") {}
                        }
                    }
                    col (style: "rounded-md border bg-card p-1") {
                        text "start / center" (style: "text-[10px] text-muted-foreground text-center mb-1") {}
                        row (style: "items-start justify-center gap-1 h-16") {
                            square (color: "emerald", size: 8, text: "1") {}
                            square (color: "emerald", h: 12, w: 6, text: "2") {}
                            square (color: "emerald", h: 6, w: 10, text: "3") {}
                        }
                    }
                    col (style: "rounded-md border bg-card p-1") {
                        text "start / end" (style: "text-[10px] text-muted-foreground text-center mb-1") {}
                        row (style: "items-start justify-end gap-1 h-16") {
                            square (color: "amber", size: 8, text: "1") {}
                            square (color: "amber", h: 12, w: 6, text: "2") {}
                            square (color: "amber", h: 6, w: 10, text: "3") {}
                        }
                    }
                    col (style: "rounded-md border bg-card p-1") {
                        text "start / between" (style: "text-[10px] text-muted-foreground text-center mb-1") {}
                        row (style: "items-start justify-between h-16") {
                            square (color: "purple", size: 8, text: "1") {}
                            square (color: "purple", h: 12, w: 6, text: "2") {}
                            square (color: "purple", h: 6, w: 10, text: "3") {}
                        }
                    }
                    col (style: "rounded-md border bg-card p-1") {
                        text "center / start" (style: "text-[10px] text-muted-foreground text-center mb-1") {}
                        row (style: "items-center justify-start gap-1 h-16") {
                            square (color: "blue", size: 8, text: "1") {}
                            square (color: "blue", h: 12, w: 6, text: "2") {}
                            square (color: "blue", h: 6, w: 10, text: "3") {}
                        }
                    }
                    col (style: "rounded-md border bg-card p-1") {
                        text "center / center" (style: "text-[10px] text-muted-foreground text-center mb-1") {}
                        row (style: "items-center justify-center gap-1 h-16") {
                            square (color: "emerald", size: 8, text: "1") {}
                            square (color: "emerald", h: 12, w: 6, text: "2") {}
                            square (color: "emerald", h: 6, w: 10, text: "3") {}
                        }
                    }
                    col (style: "rounded-md border bg-card p-1") {
                        text "center / end" (style: "text-[10px] text-muted-foreground text-center mb-1") {}
                        row (style: "items-center justify-end gap-1 h-16") {
                            square (color: "amber", size: 8, text: "1") {}
                            square (color: "amber", h: 12, w: 6, text: "2") {}
                            square (color: "amber", h: 6, w: 10, text: "3") {}
                        }
                    }
                    col (style: "rounded-md border bg-card p-1") {
                        text "center / between" (style: "text-[10px] text-muted-foreground text-center mb-1") {}
                        row (style: "items-center justify-between h-16") {
                            square (color: "purple", size: 8, text: "1") {}
                            square (color: "purple", h: 12, w: 6, text: "2") {}
                            square (color: "purple", h: 6, w: 10, text: "3") {}
                        }
                    }
                    col (style: "rounded-md border bg-card p-1") {
                        text "end / start" (style: "text-[10px] text-muted-foreground text-center mb-1") {}
                        row (style: "items-end justify-start gap-1 h-16") {
                            square (color: "blue", size: 8, text: "1") {}
                            square (color: "blue", h: 12, w: 6, text: "2") {}
                            square (color: "blue", h: 6, w: 10, text: "3") {}
                        }
                    }
                    col (style: "rounded-md border bg-card p-1") {
                        text "end / center" (style: "text-[10px] text-muted-foreground text-center mb-1") {}
                        row (style: "items-end justify-center gap-1 h-16") {
                            square (color: "emerald", size: 8, text: "1") {}
                            square (color: "emerald", h: 12, w: 6, text: "2") {}
                            square (color: "emerald", h: 6, w: 10, text: "3") {}
                        }
                    }
                    col (style: "rounded-md border bg-card p-1") {
                        text "end / end" (style: "text-[10px] text-muted-foreground text-center mb-1") {}
                        row (style: "items-end justify-end gap-1 h-16") {
                            square (color: "amber", size: 8, text: "1") {}
                            square (color: "amber", h: 12, w: 6, text: "2") {}
                            square (color: "amber", h: 6, w: 10, text: "3") {}
                        }
                    }
                    col (style: "rounded-md border bg-card p-1") {
                        text "end / between" (style: "text-[10px] text-muted-foreground text-center mb-1") {}
                        row (style: "items-end justify-between h-16") {
                            square (color: "purple", size: 8, text: "1") {}
                            square (color: "purple", h: 12, w: 6, text: "2") {}
                            square (color: "purple", h: 6, w: 10, text: "3") {}
                        }
                    }
                }
            }

            h2 "justify-around / justify-evenly"
            preview-card (id: "alignment-around-evenly") {
                col (style: "gap-3 w-full") {
                    row (style: "justify-around border rounded-md p-2") {
                        square (color: "blue", size: 8, text: "1") {}
                        square (color: "blue", size: 8, text: "2") {}
                        square (color: "blue", size: 8, text: "3") {}
                    }
                    row (style: "justify-evenly border rounded-md p-2") {
                        square (color: "emerald", size: 8, text: "1") {}
                        square (color: "emerald", size: 8, text: "2") {}
                        square (color: "emerald", size: 8, text: "3") {}
                    }
                }
            }

            h2 "Properties"
            table {
                thead {
                    tr {
                        th "Class"
                        th "Values"
                        th "Description"
                    }
                }
                tbody {
                    tr { td "items-{...}" td "start | center | end | stretch" td "Cross-axis alignment of all children" }
                    tr { td "justify-{...}" td "start | center | end | between | around | evenly" td "Main-axis distribution" }
                    tr { td "self-{...}" td "start | center | end | stretch" td "Per-child override (vue only — vm degrades to items-*)" }
                }
            }
        }
    }
}
