// pages/popover.at - Popover component documentation page

widget PopoverPage {
    model { activeTab str = "preview" }

    view {
        col {
            h1 "Popover"
            text "Popover displays floating content — forms, menus, or rich panels — anchored to a trigger element. It appears on click and closes when the user clicks outside or presses Escape. Ideal for quick configuration panels, color pickers, and contextual toolbars without the weight of a full Dialog."
            text "vm/iced 模式(Plan 422):popover-trigger/popover-content 由原生弹层原语驱动 —— 点击触发器开合,点击面板外/Esc 关闭,无需应用态。"

            h2 "Installation"
            codeblock (lang: "bash", code: "npx shadcn-vue@latest add popover") {}

            h2 "Simple"
            preview-card (id: "popover-basic") {
                row (style: "gap-4") {
                    popover {
                        popover-trigger {
                            button (text: "Open Popover", variant: "outline") {}
                        }
                        popover-content {
                            col (style: "gap-4") {
                                h4 (text: "Dimensions", style: "font-medium") {}
                                text "Set the dimensions for the layer."
                            }
                        }
                    }
                }
            }

            h2 "Properties"
            table {
                thead {
                    tr {
                        th "Property"
                        th "Type"
                        th "Default"
                        th "Values"
                        th "Description"
                    }
                }
                tbody {
                    tr {
                        td "side"
                        td "string"
                        td (text: "\"bottom\"") {}
                        td (text: "\"top\", \"right\", \"bottom\", \"left\"") {}
                        td "Preferred side of the trigger"
                    }
                    tr {
                        td "align"
                        td "string"
                        td (text: "\"center\"") {}
                        td (text: "\"start\", \"center\", \"end\"") {}
                        td "Preferred alignment"
                    }
                    tr {
                        td "open"
                        td "boolean"
                        td "false"
                        td "true, false"
                        td "Controls the open state"
                    }
                }
            }
        }
    }
}
