// pages/drawer.at - Drawer component documentation page

widget DrawerPage {
    model { activeTab str = "preview" }

    view {
        col {
            h1 "Drawer"
            text "Drawer is a panel that slides in from the edge of the screen, typically from the bottom on mobile. Ideal for mobile-friendly menus, filter panels, and quick-access actions. Unlike Dialog (centered modal), Drawer occupies the side or bottom edge, leaving part of the page visible for context."

            h2 "Installation"
            codeblock (lang: "bash", code: "npx shadcn-vue@latest add drawer") {}

            h2 "Simple"
            preview-card (id: "drawer-basic") {
                row (style: "gap-4") {
                    drawer {
                        drawer-trigger "Open Drawer"
                        drawer-content {
                            drawer-header {
                                drawer-title "Edit Profile"
                                drawer-description "Make changes to your profile here."
                            }
                        }
                    }
                }
            }

            h2 "Properties"
            table {
                thead {
                    tr {
                        th "Property"
                        th "Type"
                        th "Default"
                        th "Values"
                        th "Description"
                    }
                }
                tbody {
                    tr {
                        td "open"
                        td "boolean"
                        td "false"
                        td "true, false"
                        td "Controls drawer visibility"
                    }
                    tr {
                        td "direction"
                        td "string"
                        td "right"
                        td "left, right, top, bottom"
                        td "Drawer slide direction"
                    }
                    tr {
                        td "title"
                        td "string"
                        td "-"
                        td "-"
                        td "Drawer title"
                    }
                }
            }
        }
    }
}
