// pages/flow-diagram.at — FlowDiagram 页(Plan 502 M2 起步;M6 补全双端验证/golden)
//
// diagram 家族首个组件页(设计文档 diagram-components.md §4.1/§5)。
// 数据轨书写(静态糖 node/edge/group 归 Phase 3);组件
// components/flow_diagram.at——布局/几何/标签全部 Auto 代码,
// 渲染端 v1 = SVG 直通(484 同通路),标签 = svg text 直通(M1 定案)。

widget FlowDiagramPage {
    use { package: official from "../components" }

    model {
        // 顺序流:开始 → 判定 → (yes)执行 / (no)重试回环 → 汇入结束
        flowNodes = [
            { id: "start", label: "开始", shape: "round" },
            { id: "check", label: "就绪?", shape: "diamond" },
            { id: "run",   label: "执行任务" },
            { id: "retry", label: "重试", shape: "round" },
            { id: "done",  label: "结束", shape: "round" }
        ]
        flowEdges = [
            { from: "start", to: "check" },
            { from: "check", to: "run",   label: "yes" },
            { from: "run",   to: "done" },
            { from: "check", to: "retry", label: "no" },
            { from: "retry", to: "check" }
        ]
    }

    view {
        col {
            h1 "FlowDiagram"
            text "diagram 家族首个组件——流程图(架构图/C4/拓扑同构表达)。分层布局与几何全部在 FlowDiagram 组件内用 Auto 完成(Sugiyama-lite:rank/order/coord);渲染端走 SVG 直通,标签 = svg text 直通(随 viewBox 缩放)。数据轨 props:nodes/edges record 列表 + direction。"

            h2 "Basic (direction: td)"
            preview-card (id: "flow-diagram-basic") {
                flow-diagram {
                    nodes: .flowNodes
                    edges: .flowEdges
                }
            }

            h2 "Component source"
            codeblock (lang: "auto", code: "widget FlowDiagram (nodes: List, edges: List, direction: str = \"td\") {\n    model { nodesDg List = []  edgesDg List = []  vbDg str = \"0 0 560 300\" }\n    on { .Init -> { /* rank/order/coord 分层布局 + 段记录 */ } }\n    view { svg (viewBox: .vbDg) { for e in .edgesDg { path (d: e.d) {} } for nd in .nodesDg { rect (x: nd.x, …) {} } } }\n}\n// 完整源码见 components/flow_diagram.at") {}

            h2 "Props(FlowDiagram 组件)"
            table {
                table-header {
                    table-row {
                        table-head "Prop" {}
                        table-head "Shape" {}
                        table-head "Description" {}
                    }
                }
                table-body {
                    table-row {
                        table-cell "nodes" {}
                        table-cell "List of record" {}
                        table-cell "节点表 { id, label, shape, group, x, y }(x/y≥0 钉住位,v1 恒 -1)" {}
                    }
                    table-row {
                        table-cell "edges" {}
                        table-cell "List of record" {}
                        table-cell "边表 { from, to, label, line, head, tail }" {}
                    }
                    table-row {
                        table-cell "direction" {}
                        table-cell "str" {}
                        table-cell "布局方向 td(默认)/ lr" {}
                    }
                }
            }
        }
    }
}
