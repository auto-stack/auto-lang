// pages/bar-chart.at — BarChart 页（Plan 437 Charts 分组 ②）
//
// Phase 2（2026-08-28）：几何已提取为官方 Auto 组件
// components/bar_chart.at（BarChart，band scale + 每柱 M/h/v/h/Z
// 子路径合单 path，分组多系列槽内偏移分色）。本页只持 demo 数据 +
// 消费组件，v1 内联几何形态退役。

widget BarChartPage {
    use { package: official from "../components" }

    model {
        quarterly = [
            { q: "Q1", sales: 155, cost: 90 },
            { q: "Q2", sales: 210, cost: 120 },
            { q: "Q3", sales: 180, cost: 110 },
            { q: "Q4", sales: 260, cost: 150 }
        ]
        single = [
            { q: "Mon", v: 30 },
            { q: "Tue", v: 80 },
            { q: "Wed", v: 10 },
            { q: "Thu", v: 55 },
            { q: "Fri", v: 95 }
        ]
    }

    view {
        col {
            h1 "BarChart"
            text "官方 Auto 实现的柱形图——band scale + 每柱一个子路径合成单条 path（fill 填充），分组多系列按槽内偏移分色。几何全部在 BarChart 组件内用 Auto 完成；渲染端 SVG 直通：vue 轨直通臂，VM 轨 svgdoc 通道。"

            h2 "Basic"
            preview-card (id: "bar-chart-basic") {
                bar-chart (data: .single, index: "q", fields: ["v"], colors: ["#2563eb"]) {}
            }

            h2 "Grouped"
            preview-card (id: "bar-chart-grouped") {
                bar-chart (data: .quarterly, index: "q", fields: ["sales", "cost"], colors: ["#2563eb", "#16a34a"]) {}
            }

            h2 "Props（BarChart 组件）"
            table {
                table-header {
                    table-row {
                        table-head "Prop" {}
                        table-head "Shape" {}
                        table-head "Description" {}
                    }
                }
                table-body {
                    table-row {
                        table-cell "data" {}
                        table-cell "List of record" {}
                        table-cell "数据记录列表(index 字段 + 各数值字段)" {}
                    }
                    table-row {
                        table-cell "index" {}
                        table-cell "str" {}
                        table-cell "x 轴标签字段名(默认 q)" {}
                    }
                    table-row {
                        table-cell "fields" {}
                        table-cell "List<str>" {}
                        table-cell "数值系列字段名(槽内 60% 按系列均分)" {}
                    }
                    table-row {
                        table-cell "colors" {}
                        table-cell "List<str>" {}
                        table-cell "每系列填充色(不足时复用末色)" {}
                    }
                }
            }
        }
    }
}
