// pages/sonner.at - Sonner component documentation page

widget SonnerPage {
    model { activeTab str = "preview" }

    on {
        .showToast -> { toast("Event has been created") }
        .showSuccess -> { toast.success("Event created successfully") }
    }

    view {
        col {
            h1 "Sonner"
            text "Sonner is the underlying toast component library (vue-sonner) that renders toasts on the vue side; the native vm draws the same floating layer itself. For the Auto DSL toast API — toast(), toast.success(), position / duration options and live demos — see the Toast page. This page documents the library wrapper: installation, Toaster placement and library-level options."

            h2 "Installation"
            codeblock (lang: "bash", code: "npx shadcn-vue@latest add sonner") {}

            h2 "Simple"
            preview-card (id: "sonner-basic") {
                col (style: "gap-4") {
                    row (style: "gap-2") {
                        button (text: "Show Toast", variant: "outline", onClick: .showToast) {}
                        button (text: "Show Success", variant: "outline", onClick: .showSuccess) {}
                    }
                    // Plan 408 fix #5: toast-provider maps to the shadcn-vue
                    // <Toaster/> (ui/sonner), which triggers the sonner
                    // scaffolding so the toasts can actually display.
                    toast-provider {}
                }
            }

            h2 "Usage"
            codeblock (lang: "typescript", code: "import { toast } from 'vue-sonner'\ntoast('Event has been created')\ntoast.success('Event created successfully')\ntoast.error('Failed to create event')") {}

            h2 "Properties"
            table {
                thead {
                    tr {
                        th "Property"
                        th "Type"
                        th "Default"
                        th "Values"
                        th "Description"
                    }
                }
                tbody {
                    tr {
                        td "position"
                        td "string"
                        td (text: "\"bottom-right\"") {}
                        td (text: "\"top-left\", \"top-center\", \"top-right\", \"bottom-left\", \"bottom-center\", \"bottom-right\"") {}
                        td "Toast position"
                    }
                    tr {
                        td "richColors"
                        td "boolean"
                        td "false"
                        td "true, false"
                        td "Enable rich colors"
                    }
                    tr {
                        td "expand"
                        td "boolean"
                        td "false"
                        td "true, false"
                        td "Expand toasts on hover"
                    }
                }
            }
        }
    }
}
