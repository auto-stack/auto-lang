// pages/code-editor.at - CodeEditor widget page (Plan 413)
// VM 模式试金石:语法高亮 / 行号 / 软换行开关 / vi 模式 / 中文 IME。

widget CodeEditorPage {
    model {
        activeTab str = "preview"
        source str = "// 在这里编辑 Rust 代码 — 支持语法高亮、行号、IME。\nfn fibonacci(n: u32) -> u32 {\n    match n {\n        0 => 0,\n        1 => 1,\n        _ => fibonacci(n - 1) + fibonacci(n - 2),\n    }\n}\n\nfn main() {\n    let greeting = \"你好,世界\";\n    for i in 0..10 {\n        println!(\"{i}: {greeting}\");\n    }\n}\n"
        wrap bool = false
        vi bool = false
        edits int = 0
    }

    view {
        col {
            h1 "CodeEditor"
            text "Native code editor with syntax highlighting (syntect/two-face), line numbers, current-line highlight, soft wrap, undo/redo, vi mode and IME input. Cross-platform (Windows/Linux) on the iced backend; the vue backend degrades to a textarea until the CodeMirror shell lands."

            h2 "Editable"
            preview-card (id: "code-editor-basic") {
                col (style: "gap-2 w-full") {
                    row (style: "gap-2 items-center") {
                        button (text: "Toggle Wrap") { onclick: .ToggleWrap }
                        button (text: "Toggle Vi Mode") { onclick: .ToggleVi }
                        text "edits: {edits}"
                        style: "gap-2"
                    }
                    code_editor (key: "gallery-editor", lang: "rust", wrap: .wrap, vi: .vi, style: "h-72 w-full rounded border font-mono") {
                        content: .source
                        oninput: .SourceChanged
                        oncursor: .CursorMoved
                    }
                    text "Shortcuts: Ctrl+Z undo, Ctrl+Y redo, Ctrl+A select all, Ctrl+Left/Right word motion, Shift+click / Shift+arrows select, triple-click line select, drag scrollbars."
                    style: "gap-1.5"
                }
            }

            h2 "AutoLang Source"
            preview-card (id: "code-editor-auto") {
                code_editor (key: "gallery-auto", lang: "auto", style: "h-56 w-full rounded border font-mono") {
                    content: "widget Hello {\n    model { name str = \"world\" }\n    view {\n        col {\n            text f\"Hello, {name}!\"\n            input (value: .name) { oninput: .Changed }\n        }\n    }\n    on {\n        .Changed -> { }\n    }\n}\n"
                }
            }

            h2 "Properties"
            table {
                thead {
                    tr {
                        th "Property"
                        th "Type"
                        th "Default"
                        th "Values"
                        th "Description"
                    }
                }
                tbody {
                    tr {
                        td "key"
                        td "string"
                        td "-"
                        td "-"
                        td "Stable state key (required for value persistence)"
                    }
                    tr {
                        td "content"
                        td "string"
                        td "-"
                        td "-"
                        td "External value; only rewritten on diff"
                    }
                    tr {
                        td "lang"
                        td "string"
                        td "none"
                        td "rust, python, auto, none, ..."
                        td "Syntax highlighting language"
                    }
                    tr {
                        td "line_numbers"
                        td "boolean"
                        td "true"
                        td "true, false"
                        td "Show the line-number gutter"
                    }
                    tr {
                        td "wrap"
                        td "boolean"
                        td "false"
                        td "true, false"
                        td "Soft wrap long lines"
                    }
                    tr {
                        td "vi"
                        td "boolean"
                        td "false"
                        td "true, false"
                        td "Vi mode (ViEditor passthrough off)"
                    }
                    tr {
                        td "tab_width"
                        td "int"
                        td "4"
                        td "-"
                        td "Tab width in columns"
                    }
                }
            }

            style: "gap-4"
        }
    }

    on {
        .SourceChanged -> {
            .edits = .edits + 1
        }
        .CursorMoved -> { }
        .ToggleWrap -> {
            .wrap = !.wrap
        }
        .ToggleVi -> {
            .vi = !.vi
        }
    }
}
