// pages/switch.at - Switch component documentation page

widget SwitchPage {
    model { activeTab str = "preview" }

    view {
        col {
            h1 "Switch"
            text "Switch is a toggle that represents an on/off state — airplane mode, Wi-Fi, dark mode, notifications. Unlike Checkbox (which confirms a choice in a form), Switch represents a live setting that takes effect immediately. Supports checked, unchecked, and disabled states."

            h2 "Installation"
            codeblock (lang: "bash", code: "npx shadcn-vue@latest add switch") {}

            h2 "Simple"
            preview-card (id: "switch-basic") {
                switch {}
            }

            h2 "With Label"
            preview-card (id: "switch-label") {
                row (gap: "2", style: "items-center") {
                    switch (id: "airplane-mode") {}
                    label (text: "Airplane Mode", for: "airplane-mode") {}
                }
            }

            h2 "Disabled"
            preview-card (id: "switch-disabled") {
                switch (disabled: "true") {}
            }

            h2 "Properties"
            table {
                thead {
                    tr {
                        th "Property"
                        th "Type"
                        th "Default"
                        th "Values"
                        th "Description"
                    }
                }
                tbody {
                    tr {
                        td "checked"
                        td "boolean"
                        td "false"
                        td "true, false"
                        td "Switch state"
                        td "Disables the switch"
                    }
                }
            }
        }
    }
}
