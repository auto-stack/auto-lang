// pages/donut-chart.at — DonutChart 页（Plan 437 Charts 分组 ④·四类图收尾）
//
// Phase 2（2026-08-28）：几何已提取为官方 Auto 组件
// components/donut_chart.at（AutoDonutChart，d3-arc 风格外弧 A + 内弧
// 回程 Z，角度由数据占比循环累进，math.cos/sin 直调——§0.6.H 三层
// 缺陷已修，页面防御性直线几何按计划指示顺势退役）。

widget DonutChartPage {
    use { package: official from "../components" }

    model {
        traffic = [
            { l: "Desktop", v: 55 },
            { l: "Mobile", v: 25 },
            { l: "Tablet", v: 12 },
            { l: "Wearable", v: 8 }
        ]
    }

    view {
        col {
            h1 "DonutChart"
            text "官方 Auto 实现的圆环图——d3-arc 风格路径（外弧 A 命令 + 内弧回程 + Z 闭合），角度由数据占比循环累进计算，math.cos/sin 直调（§0.6.H 根因已修），大弧标志 span>π。几何全部在 AutoDonutChart 组件内用 Auto 完成；渲染端 SVG 直通：vue 轨直通臂，VM 轨 svgdoc 通道。"

            h2 "Basic"
            preview-card (id: "donut-chart-basic") {
                auto-donut-chart (data: .traffic, index: "l", field: "v") {}
            }

            h2 "Props（AutoDonutChart 组件）"
            table {
                table-header {
                    table-row {
                        table-head "Prop" {}
                        table-head "Shape" {}
                        table-head "Description" {}
                    }
                }
                table-body {
                    table-row {
                        table-cell "data" {}
                        table-cell "List of record" {}
                        table-cell "数据记录列表(标签字段 + 数值字段)" {}
                    }
                    table-row {
                        table-cell "index" {}
                        table-cell "str" {}
                        table-cell "弧标签字段名(默认 l)" {}
                    }
                    table-row {
                        table-cell "field" {}
                        table-cell "str" {}
                        table-cell "数值字段名(默认 v)" {}
                    }
                    table-row {
                        table-cell "colors" {}
                        table-cell "List<str>" {}
                        table-cell "每片填充色(默认四色调色板,不足时复用末色)" {}
                    }
                }
            }
        }
    }
}
