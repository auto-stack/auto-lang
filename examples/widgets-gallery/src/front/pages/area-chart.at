// pages/area-chart.at — AreaChart 页（Plan 437 Charts 分组 ③）
//
// Phase 2（2026-08-28）：几何已提取为官方 Auto 组件
// components/area_chart.at（AreaChart，linear scale + 折线下探底边
// 闭合 Z 路径，fill 半透明叠加；顶边另发描边 path）。本页只持 demo
// 数据 + 消费组件，v1 内联几何形态退役。

widget AreaChartPage {
    use { package: official from "../components" }

    model {
        monthly = [
            { m: "Jan", desktop: 186, mobile: 80 },
            { m: "Feb", desktop: 305, mobile: 200 },
            { m: "Mar", desktop: 237, mobile: 120 },
            { m: "Apr", desktop: 73,  mobile: 190 },
            { m: "May", desktop: 209, mobile: 130 },
            { m: "Jun", desktop: 214, mobile: 140 }
        ]
    }

    view {
        col {
            h1 "AreaChart"
            text "官方 Auto 实现的面积图——折线路径下探底边闭合（fill 半透明叠加），顶边另发描边 path 保持轮廓清晰。几何全部在 AreaChart 组件内用 Auto 完成；渲染端 SVG 直通：vue 轨直通臂，VM 轨 svgdoc 通道。"

            h2 "Overlay"
            preview-card (id: "area-chart-overlay") {
                area-chart (data: .monthly, index: "m", fields: ["desktop", "mobile"], colors: ["#2563eb", "#16a34a"]) {}
            }

            h2 "Props（AreaChart 组件）"
            table {
                table-header {
                    table-row {
                        table-head "Prop" {}
                        table-head "Shape" {}
                        table-head "Description" {}
                    }
                }
                table-body {
                    table-row {
                        table-cell "data" {}
                        table-cell "List of record" {}
                        table-cell "数据记录列表(index 字段 + 各数值字段)" {}
                    }
                    table-row {
                        table-cell "index" {}
                        table-cell "str" {}
                        table-cell "x 轴标签字段名(默认 m)" {}
                    }
                    table-row {
                        table-cell "fields" {}
                        table-cell "List<str>" {}
                        table-cell "数值系列字段名(多系列共享 y 域)" {}
                    }
                    table-row {
                        table-cell "colors" {}
                        table-cell "List<str>" {}
                        table-cell "每系列填充/描边色(不足时复用末色)" {}
                    }
                }
            }
        }
    }
}
