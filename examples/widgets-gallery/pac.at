// pac.at - Auto 实现的 UI widgets gallery workspace config
// AutoUI Widgets Gallery — 组件库文档站点（全部 shadcn widgets 示例 + 文档）

name: "widgets-gallery"
version: "1.0.0"
description: "AutoUI Widgets Gallery - Auto-implemented UI widgets gallery (vue/vm/rust)"

scene: "ui"

// Supported backends: Vue (web), VM, and Rust (desktop). Vue is the current
// fully-working target; the workspace layout below keeps the structure open
// for the other backends.
backend: ["vue"]

// Workspace structure
workspace: {
    front: "./source/front"
}

// Build targets
targets: {
    // `auto.exe vue` generates Vue documentation site
    vue: {
        frontend: "vue"
        backend: "none"
    }
}

// Development server port (matches the docs-site dev flow)
front_port: 3024

// Development commands
scripts: {
    dev: "npm run dev"
    build: "npm run build"
    preview: "npm run preview"
}
