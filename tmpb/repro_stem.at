use.rust std::path::{Path, PathBuf}

fn project_name(path PathBuf) str {
    var name str = "project"
    let stem_opt = path.file_stem()
    is stem_opt {
        Some(s) -> {
            let s_str = s.to_str()
            is s_str {
                Some(t) -> { name = t.to_string() },
                None -> {}
            }
        },
        None -> {}
    }
    return name
}
