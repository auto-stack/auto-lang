// L3(Plan 511):D1——下标复合赋值与宿主同文本拒绝(错误文本以宿主为规范)
#[test]
fn t_d1_index_compound_reject() {
    assert_eq(ev_run("fn main() {\n    let a = [1, 2]\n    a[0] += 5\n}"), "CODEGEN-ERROR:Compound assignment requires a variable on left side")
}

#[test]
fn t_d1_field_compound_reject() {
    assert_eq(ev_run("type P {\n    x int\n}\n\nfn main() {\n    let p = P { x: 1 }\n    p.x += 5\n}"), "CODEGEN-ERROR:Compound assignment requires a variable on left side")
}
