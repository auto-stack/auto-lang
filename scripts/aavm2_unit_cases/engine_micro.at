// L3(Plan 511):引擎微行为单测——ev_run 输出形态/全局缺省/迭代器零迭代
#[test]
fn t_ev_run_no_trailing_newline() {
    assert_eq(ev_run("print(6*7)"), "42")
}

#[test]
fn t_ev_run_multiline_join() {
    assert_eq(ev_run("fn main() {\n    print(1)\n    print(2)\n}"), "1\n2")
}

#[test]
fn t_global_default_zero() {
    assert_eq(ev_run("var g int = 9\n\nfn main() {\n    print(g)\n}"), "9")
}

#[test]
// Plan 525 W1 期望翻转:宿主 for-in 对裸 List(fn Call 源)已按元素迭代
// (b38 live 实证 14/16/18;旧 "0" 零迭代断言编码 511 期宿主形态,随
// VBool 落地双侧对拍收口)——宿主为规范,期望同步 "2"。
fn t_iter_raw_array_iterates() {
    assert_eq(ev_run("fn mk() {\n    return [1, 2]\n}\n\nfn main() {\n    var n int = 0\n    for w in mk() {\n        n = n + 1\n    }\n    print(n)\n}"), "2")
}

// Plan 525 W1:VBool 载体断言——print(bool)/比较/逻辑结果/fstr 插值
// 全走 true/false 显示形态(宿主 print tag==3 臂镜像)
#[test]
fn t_vbool_print_true() {
    assert_eq(ev_run("print(true)"), "true")
}

#[test]
fn t_vbool_print_false() {
    assert_eq(ev_run("print(false)"), "false")
}

#[test]
fn t_vbool_cmp_result() {
    assert_eq(ev_run("print(1 == 2)"), "false")
    assert_eq(ev_run("print(3 > 2)"), "true")
}

#[test]
fn t_vbool_logic_not() {
    assert_eq(ev_run("print(!true)"), "false")
    assert_eq(ev_run("print(true && false)"), "false")
    assert_eq(ev_run("print(true || false)"), "true")
}

#[test]
fn t_vbool_fstr() {
    assert_eq(ev_run("print(f\"flag=${true}\")"), "flag=true")
    assert_eq(ev_run("print(f\"cmp=${1 == 1}\")"), "cmp=true")
}
