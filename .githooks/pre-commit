#!/bin/sh
# 大文件入库门禁(2026-10-28 用户裁定:防二进制/大日志/大量截图误入跟踪)
# 规则:单个暂存文件 >5MB 拒绝;单次提交暂存总量 >100MB 仅警告(证据批量沉淀合法)。
# 豁免:AUTO_LANG_ALLOW_LARGE=1 git commit(须在 plan 中记录理由);或 --no-verify(同上)。
# fail-closed(2026-10-28 实测教训):测量管线任何瞬时故障(wc/文件占用/管道截断)
# 都拒绝提交而非静默放行——误拦重试即可,误放行无法挽回。NUL 流必须落临时文件,
# 不得经 shell 变量中转(命令替换会丢弃 NUL)。
[ -n "$AUTO_LANG_ALLOW_LARGE" ] && exit 0

MAX_FILE=5242880        # 5MB
WARN_TOTAL=104857600    # 100MB

tmp=$(mktemp) || exit 1
trap 'rm -f "$tmp"' EXIT

if ! git diff --cached --name-only --diff-filter=d -z > "$tmp"; then
  echo "pre-commit 拒绝:git diff --cached 失败(fail-closed),请重试提交。" >&2
  exit 1
fi
[ -s "$tmp" ] || exit 0   # 无暂存文件(或仅删除),放行

# 复审证据路径门禁(2026-10-28 用户裁定):attachments 下仅 *.md 入库。
# 覆盖 gitignore 之外的强制路径(add -f / 已跟踪文件再暂存同样拦截)。
if [ -z "$AUTO_LANG_ALLOW_EVIDENCE" ]; then
  evbad=$(tr '\0' '\n' < "$tmp" | grep '^docs/plans/attachments/' | grep -v '\.md$' | grep -v '^docs/plans/attachments/\.gitignore$' | head -5)
  if [ -n "$evbad" ]; then
    echo "pre-commit 拒绝:复审证据不入库(2026-10-28 用户裁定),以下暂存路径非 *.md:" >&2
    printf '%s\n' "$evbad" >&2
    echo "证据留本地 attachments(gitignore 已排除),摘要写入 plan 文件;确需入库用" >&2
    echo "AUTO_LANG_ALLOW_EVIDENCE=1 git commit,并在对应 plan 记录理由。" >&2
    exit 1
  fi
fi

want=$(tr -cd '\0' < "$tmp" | wc -c | tr -d ' ')
measured=$(xargs -0 -r wc -c < "$tmp" 2>/dev/null)
if [ -z "$measured" ]; then
  echo "pre-commit 拒绝:暂存文件大小测量失败(fail-closed),检查文件占用后重试提交。" >&2
  exit 1
fi

total=0
got=0
blocked=''
while IFS= read -r line; do
  case "$line" in *" total") continue ;; esac    # 批量 wc 的合计行
  # wc 多文件输出带对齐前导空格;set -- 按空白分词天然消化,path 仅为展示用重组
  set -- $line
  sz=$1
  shift
  path=$*
  case "$sz" in ''|*[!0-9]*) continue ;; esac
  got=$((got + 1))
  total=$((total + sz))
  if [ "$sz" -gt "$MAX_FILE" ]; then
    blocked="$blocked$sz  $path
"
  fi
done <<EOF
$measured
EOF

if [ "$got" -ne "$want" ]; then
  echo "pre-commit 拒绝:仅测到 $got/$want 个暂存文件(测量不完整,fail-closed),请重试提交。" >&2
  exit 1
fi

if [ -n "$blocked" ]; then
  echo "pre-commit 拒绝:以下暂存文件超过 5MB(字节  路径):" >&2
  printf '%s' "$blocked" >&2
  echo "证据请提交截断/摘要(attachments/.gitignore 2026-10-21 裁定);确需大文件请用" >&2
  echo "AUTO_LANG_ALLOW_LARGE=1 git commit,并在对应 plan 中记录豁免理由。" >&2
  exit 1
fi

if [ "$total" -gt "$WARN_TOTAL" ]; then
  echo "pre-commit 提示:本次提交暂存总量 $((total / 1024 / 1024))MB(>100MB)。继续前确认符合证据政策。" >&2
fi
exit 0
