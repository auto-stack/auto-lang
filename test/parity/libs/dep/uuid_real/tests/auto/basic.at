// uuid_real 绿面——非白名单真三方 pack 面勘测（PLAN-591 T9）。
dep uuid(version: "=1.24.0")
use.rs uuid::{Uuid}

fn tap_ok(n int, name str) {
    print("ok " + n.to(str) + " - " + name)
}

fn main() {
    let zero = Uuid.parse_str("00000000-0000-0000-0000-000000000000").unwrap()
    if zero.is_nil() {
        tap_ok(1, "parse_nil_is_nil")
    } else {
        print("not ok 1 - parse_nil_is_nil")
    }

    let v4 = Uuid.parse_str("67e55044-10b1-426f-9247-bb680e5fe0c8").unwrap()
    let ver = v4.get_version_num()
    if ver == 4 {
        tap_ok(2, "parse_v4_version_num")
    } else {
        print("not ok 2 - parse_v4_version_num")
    }

    print(v4)
    tap_ok(3, "parse_display_print")
}
