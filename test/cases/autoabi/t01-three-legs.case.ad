# PLAN-797 T-01 first AutoABI interop legs (AutoDown manifest).

# Status at T-01 (plan §5.5): the .case.ad files enter version control
# from the first leg, but AutoDown EXECUTION is pending until D-796 and
# D-788 — the runner registration happens in T-06 through PLAN-796's
# public probe/run contract. Until then these manifests are declarations
# with their expected observable outcomes; the actually-executed
# equivalents are the Rust native tests in
# experimental/auto-abi-probe/tests/t01_feasibility.rs (same legs, same
# oracles). File existence here is NOT a pass claim.

```test-case
case {
  schema: "autolang.case/1"
  id: "autoabi.t01.leg_a_autoabi_to_autoabi"
  tags: ["plan797", "autoabi", "native-interop"]
  files: [
    { path: "callee.decl", producer: "auto-abi-probe emit (Cranelift, declaration IR)" },
    { path: "caller.decl", producer: "auto-abi-probe emit (separate ObjectModule)" }
  ]
  entry: { mode: "pe", entry_symbol: "p797_entry" }
  checks: [
    { id: "run", adapter: "autoabi-probe", action: "build-link-run", tier: "native-interop",
      options: {
        profile: "autoabi.win-x64.v0.1-candidate",
        target: "x86_64-pc-windows-msvc",
        inputs: { a: 7, b: -3, c: 100, d: 5, e: 1000000007, f: 1.5, g: 11, h: -2.25 },
        expected: 2000001876
      },
      expect: { completion: "success", exit_code: 0 } }
  ]
}
```

```test-case
case {
  schema: "autolang.case/1"
  id: "autoabi.t01.leg_b_autoabi_calls_c"
  tags: ["plan797", "autoabi", "native-interop", "c-side"]
  files: [
    { path: "caller.decl", producer: "auto-abi-probe emit (Cranelift)" },
    { path: "callee_mix.c", producer: "hand-written C (cside/callee_mix.c)" }
  ]
  entry: { mode: "pe", entry_symbol: "p797_entry" }
  checks: [
    { id: "compile-c", adapter: "autoabi-probe", action: "cl-compile", tier: "native-interop",
      options: { tool: "msvc-cl", flags: "-c -nologo -GS- -Zl -W4 -WX -O2" },
      expect: { completion: "success" } }
    { id: "run", adapter: "autoabi-probe", action: "build-link-run", tier: "native-interop",
      options: {
        profile: "autoabi.win-x64.v0.1-candidate",
        target: "x86_64-pc-windows-msvc",
        inputs: { a: 7, b: -3, c: 100, d: 5, e: 1000000007, f: 1.5, g: 11, h: -2.25 },
        expected: 2000001876
      },
      expect: { completion: "success", exit_code: 0 } }
  ]
}
```

