// p781-scroll-geometry — PLAN-781 阶段A几何oracle + 阶段B锚点原生验证 fixture。
// 静态 120 容器行（T-11）+ controller pane + 行级 scroll-anchor + Go/Query
// 按钮（T-03：经生产 handler 调 scroll_to_child/scroll_anchor_state）。
widget App {
    msg { Init, Go(str), Query(str) }
    model {
        var rsc str = "ag-pane"
        var reply str = "-"
    }
    view {
        col {
            style: "h-screen flex flex-col"
            row {
                style: "h-12 items-center gap-2 px-4 border-b border-border shrink-0"
                text "P781-SCROLL-GEOMETRY-FIXTURE" { style: "font-bold text-foreground" }
                button {
                    onclick: .Go("p40")
                    style: "px-2 py-1 text-sm rounded hover:bg-accent"
                    text "GoP40" { style: "text-sm" }
                }
                button {
                    onclick: .Go("p115")
                    style: "px-2 py-1 text-sm rounded hover:bg-accent"
                    text "GoP115" { style: "text-sm" }
                }
                button {
                    onclick: .Go("missing")
                    style: "px-2 py-1 text-sm rounded hover:bg-accent"
                    text "GoMissing" { style: "text-sm" }
                }
                button {
                    onclick: .Query("p40")
                    style: "px-2 py-1 text-sm rounded hover:bg-accent"
                    text "Q40" { style: "text-sm" }
                }
                button {
                    onclick: .Query("missing")
                    style: "px-2 py-1 text-sm rounded hover:bg-accent"
                    text "QMiss" { style: "text-sm" }
                }
                text .reply { style: "text-xs text-muted-foreground font-mono" }
            }
            scroll-pane (controller: .rsc, style: "flex-1 min-h-0 w-full") {
                col {
                    style: "gap-1 p-4"
                    col {
                        style: "py-3 border-b border-border"
                        scroll-anchor: "p0"
                        text "¶0 P781SG 第0行 几何探针正文内容行。" {}
                    }
                    col {
                        style: "py-3 border-b border-border"
                        scroll-anchor: "p1"
                        text "¶1 P781SG 第1行 几何探针正文内容行。" {}
