// p781-save-restore — PLAN-781 阶段A保存/冷恢复链路的框架正对照（T-12）。
// 均匀 ASCII 书（120 段）+ 真实保存链（press -> handler -> HTTP POST ->
// 后端校验+落盘+读回）+ 冷恢复流（Init 读进度 -> 逐字锚点 -> 溢出滚动 +
// OnScroll 占比精化，Reader reading.at 同构生产原语）。
// 正文刻意 ASCII（VM HTTP 请求体多字节损坏规避，reading.at real_payload
// 注记）；多字节锚点归 READER-001 复验域。
/// /api/progress 响应二次解析（双层编码）；无记录（""）或解析失败回 null。
fn parse_progress(text str) JsonValue? {
    var out JsonValue? = null
    if text != "" {
        let v = json.parse(text)
        if v != null {
            var s2 str = "" + v
            if s2 != "" {
                let v2 = json.parse(s2)
                if v2 != null {
                    out = v2
                }
            }
        }
    }
    return out
}

