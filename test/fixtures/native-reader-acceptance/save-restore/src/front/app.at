        ]
        var loaded bool = false
        var cur_paragraph int = -1
        var cur_text str = ""
        var restored_note str = ""
        var font_size str = "medium"
        var body_style str = "text-foreground text-base leading-relaxed"
        var rsc str = "p781-pane"
        var restore_pi int = -1
        var restore_cum int = 0
        var restore_total int = 0
    }

    view {
        col {
            style: "h-screen flex flex-col"
            row {
                style: "h-12 items-center gap-2 px-4 border-b border-border shrink-0"
                text "P781-SAVE-RESTORE-FIXTURE" { style: "font-bold text-foreground" }
                button {
                    onclick: .SetFont("small")
                    style: "px-2 py-1 text-sm rounded hover:bg-accent"
                    text "A-" { style: "text-sm" }
                }
                button {
                    onclick: .SetFont("large")
                    style: "px-2 py-1 text-sm rounded hover:bg-accent"
                    text "A+" { style: "text-sm" }
                }
                text .font_size { style: "text-xs text-muted-foreground" }
            }
            if .restored_note != "" {
                text .restored_note { style: "px-4 py-1 text-sm text-primary bg-primary/10 shrink-0" }
            }
            scroll-pane (controller: .rsc, style: "flex-1 min-h-0 w-full", onscroll: .OnScroll) {
                if .loaded {
                    col {
                        style: "max-w-2xl mx-auto px-6 py-10 gap-4"
                        for p in .paragraphs {
                            col {
                                onclick: .Tap(p.idx)
                                style: ["px-3 py-2 rounded-lg cursor-pointer border-l-4",
                                    if p.idx == .cur_paragraph {
                                        "bg-primary/10 border-primary"
                                    } else {
                                        "border-transparent hover:bg-muted"
                                    }]
                                text f"¶${p.idx}" { style: "text-xs text-muted-foreground font-mono" }
                                text p.text { style: .body_style }
                            }
                        }
                    }
                } else {
                    col {
                        style: "items-center justify-center py-20"
                        text "Loading…" { style: "text-muted-foreground" }
                    }
                }
            }
        }
    }


    on {
        .Init -> {
            .loaded = true
            let pr = parse_progress(Http.get_json("/api/progress"))
            if pr != null {
                let fsv str = "" + pr.font_size
                if fsv == "small" {
                    .font_size = "small"
                    .body_style = "text-foreground text-sm leading-relaxed"
                }
                if fsv == "large" {
                    .font_size = "large"
                    .body_style = "text-foreground text-lg leading-relaxed"
                }
                let pi int = pr.paragraph_index
                var txt str = "" + pr.paragraph_text
                var matched bool = false
                var i int = 0
                while i < .paragraphs.len() {
                    let p = .paragraphs[i]
                    if p.idx == pi {
                        if "" + p.text == txt {
                            matched = true
                        }
                        i = .paragraphs.len()
                    }
                    i = i + 1
                }
                if matched {
                    .cur_paragraph = pi
                    .restored_note = "已恢复上次位置（点任意段落可更新）"
                    .restore_pi = pi
                    var total int = 0
                    var cum int = 0
                    var seen int = 0
                    var k int = 0
                    while k < .paragraphs.len() {
                        let p2 = .paragraphs[k]
                        let tl int = ("" + p2.text).len() + 1
                        total = total + tl
                        if p2.idx == pi {
                            seen = 1
                        } else {
                            if seen == 0 {
                                cum = cum + tl
                            }
                        }
                        k = k + 1
                    }
                    .restore_cum = cum
                    .restore_total = total
                    let warm = scroll_to(.rsc, 0.0, 100000000.0)
                } else {
                    .restored_note = "上次保存的段落内容已变化，请重新点选位置"
                }
            }
        }
        .Tap(idx int) -> {
            .cur_paragraph = idx
            var i int = 0
            while i < .paragraphs.len() {
                let p = .paragraphs[i]
                if p.idx == idx {
                    .cur_text = "" + p.text
                    i = .paragraphs.len()
                }
                i = i + 1
            }
            var save_ok bool = false
            var resp_debug str = "EXC"
            try {
                var body str = "{\"paragraph_index\":"
                body = body + idx.to_string()
                body = body + ",\"paragraph_text\":\""
                body = body + .cur_text
                body = body + "\",\"font_size\":\""
                body = body + .font_size
                body = body + "\"}"
                let resp str = Http.post("/api/progress", body)
                resp_debug = resp
                if resp.find("SAVED") >= 0 {
                    save_ok = true
                }
            } catch { }
            if save_ok {
                .restored_note = f"已记录位置：第 ${idx} 段"
            } else {
                .restored_note = "保存失败resp=" + resp_debug
            }
        }
        .SetFont(s str) -> {
            .font_size = s
            if s == "small" {
                .body_style = "text-foreground text-sm leading-relaxed"
            }
            if s == "large" {
                .body_style = "text-foreground text-lg leading-relaxed"
            }
        }
        .OnScroll(ox, oy, vw, vh, cw, chh, px, py) -> {
            if .restore_pi >= 0 {
                if .restore_total > 0 {
                    if chh > vh {
                        let cf float = 0.0 + .restore_cum
                        let tf float = 0.0 + .restore_total
                        let ratio float = cf / tf
                        let span float = chh - vh
                        let target float = ratio * span
                        let ok2 = scroll_to(.rsc, 0.0, target)
                    }
                }
                .restore_pi = -1
            }
        }
    }
}
