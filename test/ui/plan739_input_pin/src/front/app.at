// app.at — PLAN-739 金样语料：编辑回声→换页视面跟随（F-037-R1 回归载体）。
// 形态对齐 jade-edit src/front/app.at:1643-1647 消费面：autodown_editor
// `oninput: .Edit`（handler 形态，非 state 字段绑定——该形态不入
// input_state_map，F-037-R1 根因前提）+ content: .doc（state 回写应用）。
// 换页单口 .GoP2 同 jade TabActivate 投影语义：key 与 content 同帧换装。
widget App {
    model {
        var page str = "p1"
        var doc str = "第一页正文。"
        var p2body str = "第二页正文。"
    }

    on {
        .Edit(t) -> {
            .doc = t
        }
        .GoP2 -> {
            .page = "p2"
            .doc = .p2body
        }
    }

    view {
        col {
            autodown_editor (key: .page, final: true) {
                content: .doc
                oninput: .Edit
            }
            button "go2" {
                onclick: .GoP2
            }
        }
    }
}
