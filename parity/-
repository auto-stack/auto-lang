    if k == "Ident" {
        let mut n = p_text(p.clone());
        p_next(&mut *p);
        return E { kind: "name".to_string(), word: n.to_string(), name: n.to_string(), args: "".to_string(), dump: format!("{}{}", format!("{}{}", "(name ", n), ")").to_string(), ity: p_lookup(p.clone(), n.as_str()).to_string() };
    }
    if k == "Nil" {
        p_next(&mut *p);
        return E { kind: "nil".to_string(), word: "".to_string(), name: "".to_string(), args: "".to_string(), dump: "(nil)".to_string(), ity: "".to_string() };
    }
    if k == "Null" {
        p_next(&mut *p);
        return E { kind: "null".to_string(), word: "".to_string(), name: "".to_string(), args: "".to_string(), dump: "(null)".to_string(), ity: "".to_string() };
    }
    p_err(&mut *p, "expected term, got ");
    return bad_e();
}

fn parse_args(mut p: &mut P) -> String {
    p_expect(&mut *p, "LParen");
    skip_empty_lines(&mut *p);
    let mut out: String = "(args".to_string();
    while p.err == "" && p_kind(p.clone()) != "EOF" && p_kind(p.clone()) != "RParen" {
        let mut a = expr_pratt(&mut *p, 0);
        if a.kind.to_string() == "pair" {
            p_err(&mut *p, "v2 unsupported: named call arg ");
            return "".to_string();
        }
        out = format!("{}{}", format!("{}{}", out, " "), a.dump);
        
        let mut k = p_kind(p.clone());
        if k == "Comma" || k == "Newline" {
            p_next(&mut *p);
            skip_empty_lines(&mut *p);
        } else if k != "RParen" {
            p_err(&mut *p, "expected argument separator, got ");
            return "".to_string();
        }
    }
    p_expect(&mut *p, "RParen");
    return format!("{}{}", out, ")");
}

fn parse_array(mut p: &mut P) -> E {
    p_expect(&mut *p, "LSquare");
    skip_empty_lines(&mut *p);
    let mut elems: Vec<String> = Vec::new();
    let mut first_ity: String = "".to_string();
    while p.err == "" && p_kind(p.clone()) != "EOF" && p_kind(p.clone()) != "RSquare" {
        let mut e = expr_pratt(&mut *p, 0);
        if (elems.len() as i64) == 0 {
            first_ity = e.ity;
        }
        elems.push(e.dump);
        
        let mut has_sep: bool = false;
        while p_kind(p.clone()) == "Comma" || p_kind(p.clone()) == "Newline" {
            has_sep = true;
            p_next(&mut *p);
        }
        if p_kind(p.clone()) != "RSquare" && !(has_sep) {
            p_err(&mut *p, "expected array separator, got ");
        }
    }
    p_expect(&mut *p, "RSquare");
    let mut dump: String = "(array ".to_string();
    let mut i: i64 = 0;
    while i < elems.len() as i64 {
        if i > 0 {
            dump = format!("{}{}", dump, " ");
        }
        dump = format!("{}{}", dump, elems[(i) as usize].clone());
        i = i + 1;
    }
    let mut ity: String = "".to_string();
    if (elems.len() as i64) > 0 {
        ity = format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", "(array-type (elem ", first_ity), ") (len "), (elems.len() as i64).to_string()), "))");
    }
    return E { kind: "array".to_string(), word: "".to_string(), name: "".to_string(), args: "".to_string(), dump: format!("{}{}", dump, ")").to_string(), ity: ity.to_string() };
}

fn parse_key(p: &mut P) -> String {
    let mut k = p_kind(p.clone());
    if k == "Ident" || k == "Type" || k == "Tag" || k == "Task" {
        let mut n = p_text(p.clone());
        p_next(&mut *p);
        return format!("{}{}", format!("{}{}", "(name ", n), ")");
    }
    if k == "Int" {
        let mut v = int_val(p_text(p.clone()).as_str()).to_string();
        p_next(&mut *p);
        return v;
    }
    if k == "True" {
        p_next(&mut *p);
        return "true".to_string();
    }
    if k == "False" {
        p_next(&mut *p);
        return "false".to_string();
    }
    if k == "Str" {
        let mut s = p_text(p.clone());
        p_next(&mut *p);
        return format!("{}{}", format!("{}{}", "\"", s), "\"");
    }
    p_err(&mut *p, "expected key, got ");
    return "".to_string();
}

fn parse_object(mut p: &mut P) -> E {
    p_expect(&mut *p, "LBrace");
    skip_empty_lines(&mut *p);
    let mut dump: String = "(object ".to_string();
    let mut i: i64 = 0;
    while p.err == "" && p_kind(p.clone()) != "EOF" && p_kind(p.clone()) != "RBrace" {
        if i > 0 {
            dump = format!("{}{}", dump, " ");
        }
        let mut key = parse_key(&mut *p);
        p_expect(&mut *p, "Colon");
        let mut val = expr_pratt(&mut *p, 0);
        dump = format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", dump, "(pair "), key), " "), val.dump), ")");
        i = i + 1;
        
        let mut k = p_kind(p.clone());
        if k == "Comma" || k == "Newline" {
            p_next(&mut *p);
            skip_empty_lines(&mut *p);
        } else if k != "RBrace" {
            p_err(&mut *p, "expected pair separator, got ");
        }
    }
    p_expect(&mut *p, "RBrace");
    return E { kind: "object".to_string(), word: "".to_string(), name: "".to_string(), args: "".to_string(), dump: format!("{}{}", dump, ")").to_string(), ity: "".to_string() };
}

fn join_dump_list(parts: Vec<String>, sep: &str) -> String {
    let mut out: String = "".to_string();
    let mut i: i64 = 0;
    while i < parts.len() as i64 {
        if i > 0 {
            out = format!("{}{}", out, sep);
        }
        out = format!("{}{}", out, parts[(i) as usize].clone());
        i = i + 1;
    }
    return out;
}

fn tuple_rest(p: &mut P, first: E) -> E {
    let mut dumps: Vec<String> = Vec::new();
    let mut itys: Vec<String> = Vec::new();
    dumps.push(first.dump);
    itys.push(first.ity);
    while p_kind(p.clone()) == "Comma" {
        p_next(&mut *p);
        let mut e = expr_pratt(&mut *p, 0);
        dumps.push(e.dump);
        itys.push(e.ity);
    }
    p_expect(&mut *p, "RParen");
    return E { kind: "tuple".to_string(), word: "".to_string(), name: "".to_string(), args: "".to_string(), dump: format!("{}{}", format!("{}{}", "(tuple ", join_dump_list(dumps, " ")), ")").to_string(), ity: format!("{}{}", format!("{}{}", "(", join_dump_list(itys, ", ")), ")").to_string() };
}

fn paren_prefix(p: &mut P) -> E {
    let mut k1 = p_peek(p.clone(), 1);
    if k1 == "RParen" {
        let mut k2 = p_peek(p.clone(), 2);
        if k2 == "DoubleArrow" {
            p_err(&mut *p, "v2 unsupported: zero-param closure ");
            return bad_e();
        }        

        p_next(&mut *p);
        p_next(&mut *p);
        return E { kind: "tuple".to_string(), word: "".to_string(), name: "".to_string(), args: "".to_string(), dump: "(tuple )".to_string(), ity: "()".to_string() };
    }
    if k1 == "Ident" {
        

        let mut found_comma: bool = false;
        let mut found_arrow: bool = false;
        let mut depth: i64 = 1;
        let mut i: i64 = p.pos + 1;
        let mut scanning: bool = true;
        while scanning && i < p.toks.len() as i64 {
            let mut tk = p.toks[(i) as usize].clone().kind;
            if tk == "LParen" || tk == "LSquare" || tk == "LBrace" {
                depth = depth + 1;
            } else if tk == "RParen" || tk == "RSquare" || tk == "RBrace" {
                depth = depth - 1;
                if depth == 0 {
                    if i + 1 < (p.toks.len() as i64) && p.toks[(i + 1) as usize].clone().kind.to_string() == "DoubleArrow" {
                        found_arrow = true;
                    }                    scanning = false;
                }            } else if tk == "Comma" && depth == 1 {
                found_comma = true;
            } else if tk == "EOF" {
                scanning = false;
            }
            i = i + 1;
        }
        if found_arrow {
            p_err(&mut *p, "v2 unsupported: multi-param closure ");
            return bad_e();
        }        if found_comma {
            

            p_next(&mut *p);
            let mut first = expr_pratt(&mut *p, 0);
            return tuple_rest(&mut *p, first.clone());
        }        

        p_next(&mut *p);
        let mut inner = expr_pratt(&mut *p, 0);
        p_expect(&mut *p, "RParen");
        return inner;
    }

    p_next(&mut *p);
    let mut first2 = expr_pratt(&mut *p, 0);
    if p_kind(p.clone()) == "Comma" {
        return tuple_rest(&mut *p, first2.clone());
    }
    p_expect(&mut *p, "RParen");
    return first2;
}

fn expr_pratt(p: &mut P, min: i64) -> E {
    if p.err != "" {
        return bad_e();
    }
    let mut k = p_kind(p.clone());
    let mut lhs = bad_e();
    if k == "If" {
        

        let mut d = if_contents(&mut *p);
        lhs = E { kind: "other".to_string(), word: "".to_string(), name: "".to_string(), args: "".to_string(), dump: d.to_string(), ity: "".to_string() };
    } else if k == "Add" || k == "Sub" || k == "Not" || k == "Star" {
        let mut pow = prefix_power(k.as_str());
        p_next(&mut *p);
        let mut operand = expr_pratt(&mut *p, pow);
        let mut ity: String = "".to_string();
        if k == "Not" {
            ity = "bool".to_string();
        } else {
            ity = operand.ity;
        }
        lhs = E { kind: "una".to_string(), word: k.to_string(), name: "".to_string(), args: "".to_string(), dump: format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", "(una (op ", op_display(k.as_str())), ") "), operand.dump), ")").to_string(), ity: ity.to_string() };
    } else if k == "LParen" {
        lhs = paren_prefix(&mut *p);
    } else if k == "LSquare" {
        lhs = parse_array(&mut *p);
    } else if k == "LBrace" {
        lhs = parse_object(&mut *p);
    } else if k == "FStrStart" {
        p_err(&mut *p, "v2 unsupported: f-string ");
        lhs = bad_e();
    } else {
        lhs = expr_atom(&mut *p);
    }

    return expr_with_left(&mut *p, lhs.clone(), min);
}

fn expr_with_left(mut p: &mut P, mut lhs: E, min: i64) -> E {
    if p.err != "" {
        return lhs;
    }

    if lhs.kind.to_string() == "name" && p_kind(p.clone()) == "DoubleArrow" {
        p_err(&mut *p, "v2 unsupported: single-param closure ");
        return lhs;
    }
    let mut cur: E = lhs.clone();
    while p.err == "" {
        let mut k = p_kind(p.clone());
        if k == "EOF" || k == "Newline" || k == "Semi" || k == "LBrace" || k == "RBrace" || k == "Comma" || k == "Arrow" || k == "DoubleArrow" || k == "VBar" || k == "RSquare" || k == "RParen" {
            break;
        }
        if !(is_op_kind(k.as_str())) {
            p_err(&mut *p, "expected infix operator, got ");
            break;
        }
        let mut op = k.clone();
        let mut post = postfix_power(op.as_str());
        if post > 0 {
            if post < min {
                break;
            }            if op == "LSquare" {
                

                p_next(&mut *p);
                let mut idx = expr_pratt(&mut *p, 18);
                p_expect(&mut *p, "RSquare");
                cur = E { kind: "index".to_string(), word: "".to_string(), name: "".to_string(), args: "".to_string(), dump: format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", "(index ", cur.dump), " "), idx.dump), ")").to_string(), ity: "".to_string() };
            } else if op == "LParen" {
                

                let mut args = parse_args(&mut *p);
                let mut word: String = "".to_string();
                if cur.kind.to_string() == "name" {
                    word = cur.word;
                }                let mut d: String = format!("{}{}", "(call ", cur.dump);
                if args != "(args)" {
                    d = format!("{}{}", format!("{}{}", d, " "), args);
                }                cur = E { kind: "call".to_string(), word: word.to_string(), name: cur.dump.to_string(), args: args.to_string(), dump: format!("{}{}", d, ")").to_string(), ity: "".to_string() };
            } else if op == "Colon" {
                

                p_next(&mut *p);
                let mut key: String = "".to_string();
                if cur.kind.to_string() == "name" {
                    key = format!("{}{}", format!("{}{}", "(name ", cur.word), ")");
                } else if cur.kind.to_string() == "int" || cur.kind.to_string() == "uint" || cur.kind.to_string() == "bool" {
                    key = cur.name;
                } else if cur.kind.to_string() == "str" {
                    key = format!("{}{}", format!("{}{}", "\"", cur.name), "\"");
                } else {
                    p_err(&mut *p, "invalid pair key ");
                    break;
                }
                let mut val = expr_pratt(&mut *p, 0);
                return E { kind: "pair".to_string(), word: "".to_string(), name: "".to_string(), args: "".to_string(), dump: format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", "(pair ", key), " "), val.dump), ")").to_string(), ity: "".to_string() };
            } else {
                

                p_err(&mut *p, "v2 unsupported: postfix bang ");
                break;
            }
        } else {
            let mut l = infix_l(op.as_str());
            if l == 0 || l < min {
                break;
            }            p_next(&mut *p);
            

            if op == "Or" || op == "And" {
                skip_empty_lines(&mut *p);
            }            let mut rhs = expr_pratt(&mut *p, infix_r(op.as_str()));
            if op == "Range" {
                cur = E { kind: "range".to_string(), word: "".to_string(), name: "".to_string(), args: "".to_string(), dump: format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", "(range (start ", cur.dump), ") (end "), rhs.dump), ") (eq false))").to_string(), ity: "".to_string() };
            } else if op == "RangeEq" {
                cur = E { kind: "range".to_string(), word: "".to_string(), name: "".to_string(), args: "".to_string(), dump: format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", "(range (start ", cur.dump), ") (end "), rhs.dump), ") (eq true))").to_string(), ity: "".to_string() };
            } else if op == "Dot" {
                if rhs.kind.to_string() == "name" {
                    cur = E { kind: "dot".to_string(), word: rhs.word.to_string(), name: "".to_string(), args: "".to_string(), dump: format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", "(dot ", cur.dump), "."), rhs.word), ")").to_string(), ity: "".to_string() };
                } else if rhs.kind.to_string() == "int" || rhs.kind.to_string() == "uint" {
                    cur = E { kind: "dot".to_string(), word: rhs.name.to_string(), name: "".to_string(), args: "".to_string(), dump: format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", "(dot ", cur.dump), "."), rhs.name), ")").to_string(), ity: "".to_string() };
                } else if rhs.kind.to_string() == "call" {
                    

                    let mut d2: String = format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", "(call (dot ", cur.dump), "."), rhs.word), ")");
                    if rhs.args != "(args)" {
                        d2 = format!("{}{}", format!("{}{}", d2, " "), rhs.args);
                    }                    cur = E { kind: "call".to_string(), word: rhs.word.to_string(), name: format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", "(dot ", cur.dump), "."), rhs.word), ")").to_string(), args: rhs.args.to_string(), dump: format!("{}{}", d2, ")").to_string(), ity: "".to_string() };
                } else {
                    p_err(&mut *p, "invalid field name after dot ");
                    break;
                }
            } else if op == "QuestionQuestion" {
                cur = E { kind: "other".to_string(), word: "".to_string(), name: "".to_string(), args: "".to_string(), dump: format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", "(?? ", cur.dump), " "), rhs.dump), ")").to_string(), ity: "".to_string() };
            } else {
                cur = E { kind: "bina".to_string(), word: op.to_string(), name: "".to_string(), args: "".to_string(), dump: format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", "(bina ", cur.dump), " (op "), op_display(op.as_str())), ") "), rhs.dump), ")").to_string(), ity: binop_result(op.as_str(), cur.ity.as_str(), rhs.ity.as_str()).to_string() };
            }
        }

    }
    return cur;
}

fn store_kw_name(kw: &str) -> String {
    if kw == "Var" {
        return "var".to_string();
    }
    if kw == "Const" {
        return "const".to_string();
    }
    if kw == "Shared" {
        return "shared".to_string();
    }
    return "let".to_string();
}

fn parse_store(p: &mut P, kw: &str) -> String {
    p_next(&mut *p);

    if p_kind(p.clone()) == "LParen" {
        p_next(&mut *p);
        let mut names: String = "".to_string();
        if p_kind(p.clone()) != "RParen" {
            names = p_text(p.clone());
            p_next(&mut *p);
            while p_kind(p.clone()) == "Comma" {
                p_next(&mut *p);
                names = format!("{}{}", format!("{}{}", names, " "), p_text(p.clone()));
                p_next(&mut *p);
            }
        }        p_expect(&mut *p, "RParen");
        p_expect(&mut *p, "Asn");
        let mut de = expr_pratt(&mut *p, 0);
        return format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", "(destr (", names), ") "), de.dump), ")");
    }
    let mut name = p_text(p.clone());
    p_next(&mut *p);
    let mut ty: String = "".to_string();
    if is_type_name(&mut *p) {
        ty = parse_type(&mut *p);
    }
    let mut init = E { kind: "nil".to_string(), word: "".to_string(), name: "".to_string(), args: "".to_string(), dump: "(nil)".to_string(), ity: "".to_string() };
    if p_kind(p.clone()) == "Asn" {
        p_next(&mut *p);
        init = expr_pratt(&mut *p, 0);
        if ty == "" {
            ty = init.ity;
        }    } else if ty == "" {
        p_err(&mut *p, format!("{}{}", "store must have type annotation or initializer: ", name).as_str());
        return "".to_string();
    }
    p_bind(&mut *p, name.as_str(), ty.as_str());
    if kw == "Var" {
        return format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", "(var (name ", name), ") "), init.dump), ")");
    }
    if ty == "" {
        return format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", "(", store_kw_name(kw)), " (name "), name), ") "), init.dump), ")");
    }
    return format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", "(", store_kw_name(kw)), " (name "), name), ") (type "), ty), ") "), init.dump), ")");
}

fn parse_fn_params(mut p: &mut P) -> String {
    let mut out: String = "".to_string();
    let mut count: i64 = 0;
    skip_empty_lines(&mut *p);
    let mut running: bool = true;
    while running && p.err == "" {
        let mut mode: String = "view".to_string();
        let mut k = p_kind(p.clone());
        if k == "View" {
            p_next(&mut *p);
        } else if k == "Mut" {
            mode = "mut".to_string();
            p_next(&mut *p);
        } else if k == "Move" {
            mode = "move".to_string();
            p_next(&mut *p);
        } else if k == "Take" {
            mode = "move".to_string();
            p_next(&mut *p);
        } else if k == "Copy" {
            mode = "move".to_string();
            p_next(&mut *p);
        }
        if p_kind(p.clone()) != "Ident" {
            if mode != "view" {
                p_err(&mut *p, "expected parameter name after mode ");
            }            running = false;
        } else {
            let mut pname = p_text(p.clone());
            p_next(&mut *p);
            let mut ty: String = "int".to_string();
            if p_kind(p.clone()) == "Colon" {
                p_next(&mut *p);
            }            if is_type_name(&mut *p) {
                ty = parse_type(&mut *p);
            }            let mut pdump: String = format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", format!("{}{}", "(param (name ", pname), ") (type "), ty), ") (mode "), mode), ")");
            if p_kind(p.clone()) == "Asn" {
                p_next(&mut *p);
                let mut def = expr_pratt(&mut *p, 0);
                pdump = format!("{}{}", format!("{}{}", format!("{}{}", pdump, " (default "), def.dump), ")");
            }            pdump = format!("{}{}", pdump, ")");
            if count > 0 {
                out = format!("{}{}", out, " ");
            }            out = format!("{}{}", out, pdump);
            count = count + 1;
            p_bind(&mut *p, pname.as_str(), ty.as_str());
            if p_kind(p.clone()) == "Comma" {
                p_next(&mut *p);
            } else {
                running = false;
            }
        }

    }
    return out;
}

fn parse_fn(p: &mut P) -> String {
    p_next(&mut *p);
    if p_kind(p.clone()) == "Dot" {
        p_err(&mut *p, "v2 unsupported: fn.c/fn.vm ");
        return "".to_string();
    }
    if p_kind(p.clone()) != "Ident" {
        p_err(&mut *p, "expected fn name, got ");
        return "".to_string();
    }
    let mut name = p_text(p.clone());
    p_next(&mut *p);
    if p_kind(p.clone()) == "Dot" {
        p_err(&mut *p, "v2 unsupported: dotted fn name ");
        return "".to_string();
    }
    if p_kind(p.clone()) == "Lt" {
        p_err(&mut *p, "v2 unsupported: fn generic params ");
        return "".to_string();
    }
    push_scope(&mut *p);
    p_expect(&mut *p, "LParen");
    let mut params = parse_fn_params(&mut *p);
    p_expect(&mut *p, "RParen");
    let mut ret: String = "".to_string();
    if p_kind(p.clone()) == "Arrow" {
        p_next(&mut *p);
        ret = parse_type(&mut *p);
        skip_empty_lines(&mut *p);
    } else if is_type_name(&mut *p) {
        ret = parse_type(&mut *p);
        skip_empty_lines(&mut *p);
    } else if p_kind(p.clone()) == "LBrace" || p_kind(p.clone()) == "Semi" {
        ret = "void".to_string();
    }
    let mut body: String = "(body )".to_string();
    if p_kind(p.clone()) == "Semi" {
        p_next(&mut *p);
    } else {
        body = parse_body(&mut *p);
