        lhs = t_binop_result(opk.as_str(), lhs.as_str(), rhs.as_str());
    }
    return lhs;
}

fn t_join_types(parts: Vec<String>) -> String {
    let mut out: String = "(".to_string();
    let mut i: i64 = 0;
    while i < parts.len() as i64 {
        if i > 0 {
            out = format!("{}{}", out, ", ");
        }
        out = format!("{}{}", out, parts[(i) as usize].clone());
        i = i + 1;
    }
    return format!("{}{}", out, ")");
}

fn t_fn_ret(fns: Vec<TFnSig>, name: &str) -> String {
    let mut i: i64 = (fns.len() as i64) - 1;
    while i >= 0 {
        if fns[(i) as usize].clone().name == name {
            return fns[(i) as usize].clone().ret;
        }
        i = i - 1;
    }
    return "".to_string();
}

fn typecheck_dump(source: &str) -> String {
    let mut toks = tokenize(source);
    let mut p = parse_new(toks);
    let mut fns: Vec<TFnSig> = Vec::new();
    let mut out: Vec<String> = Vec::new();
    skip_empty_lines(&mut p);
    while p.err == "" && p_kind(p.clone()) != "EOF" {
        t_stmt_walk(&mut p, &mut fns, &mut out);
        if p.err == "" {
            let mut has_sep: bool = false;
            while p_kind(p.clone()) == "Semi" || p_kind(p.clone()) == "Newline" || p_kind(p.clone()) == "Comma" {
                has_sep = true;
                p_next(&mut p);
            }
            if p_kind(p.clone()) != "EOF" && !(has_sep) {
                p_err(&mut p, "typeinfo: expected end of statement ");
            }        }
    }
    if p.err != "" {
        return p.err;
    }
    let mut s: String = "".to_string();
    let mut i: i64 = 0;
    while i < out.len() as i64 {
        if i > 0 {
            s = format!("{}{}", s, "\n");
        }
        s = format!("{}{}", s, out[(i) as usize].clone());
        i = i + 1;
    }
    return s;
}
