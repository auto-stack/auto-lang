/// c_process_app — CLI 参数解析消费者应用。
///
/// 演示"Auto 消费 `auto.process.args` 能力做 CLI 应用"的核心：把 argv 串
/// 解析成参数个数 / 第 N 个参数。
///
/// Plan 368 workaround 消除：VM 运行时 bug 已修（R-W4 bare-name fallback,
/// i64 FFI marshalling, loop-return 非 bug, print("") 非 bug），
/// 现在使用自然的 split + 循环 return + 空串返回。

/// 数 args 串里的参数个数（按空格切分，连续空格只算一个分隔，空串=0）。
fn parse_count(args_str str) int {
    var parts = args_str.split(" ")
    var count = 0
    for p in parts {
        if p.len() > 0 {
            count = count + 1
        }
    }
    return count
}

/// 取第 n 个非空参数（0-based）。命中返回该词；未命中返回空串。
fn parse_nth(args_str str, n int) str {
    var parts = args_str.split(" ")
    var idx = 0
    for p in parts {
        if p.len() > 0 {
            if idx == n {
                return "" + p
            }
            idx = idx + 1
        }
    }
    return ""
}
