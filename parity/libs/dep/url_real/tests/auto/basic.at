/// url_real 绿面——真三方 url 动态加载（PLAN-594）。
dep url(version: "2.5.4")
use.rs url::Url

fn tap_ok(n int, name str) {
    print("ok " + n.to(str) + " - " + name)
}

fn main() {
    let u = Url.parse("https://example.com/x").unwrap()
    let sc = u.scheme()
    if sc == "https" {
        tap_ok(1, "parse_scheme")
    } else {
        print("not ok 1 - parse_scheme")
    }
    let h = u.host_str().unwrap()
    if h == "example.com" {
        tap_ok(2, "host_str_unwrap")
    } else {
        print("not ok 2 - host_str_unwrap")
    }
    let p = u.path()
    if p == "/x" {
        tap_ok(3, "parse_path")
    } else {
        print("not ok 3 - parse_path")
    }
    // DIV-DEP-8 翻绿（PLAN-596 T-07）：to(str) == 全文本三轨一致。
    let full = u.to(str)
    if full == "https://example.com/x" {
        tap_ok(4, "display_to_str")
    } else {
        print("not ok 4 - display_to_str")
    }
}
