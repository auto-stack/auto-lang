/// c_crawler 测试驱动。
use auto.c_crawler: crawl_page1_body, crawl_page2_body, crawl_status, crawl_file

fn tap_ok(n int, name str) { print("ok " + n.to(str) + " - " + name) }
fn tap_not_ok(n int, name str) { print("not ok " + n.to(str) + " - " + name) }

fn check_str(n int, name str, actual str, expected str) {
    if actual == expected { tap_ok(n, name) } else { tap_not_ok(n, name) }
}

fn check_int(n int, name str, actual int, expected int) {
    if actual == expected { tap_ok(n, name) } else { tap_not_ok(n, name) }
}

fn main() {
    var base = "http://127.0.0.1:18080"

    check_str(1, "test_crawl_page1", crawl_page1_body(base + "/page1"), "{\"page\":1,\"links\":[\"/page2\"]}")
    check_str(2, "test_crawl_page2", crawl_page2_body(base + "/page2"), "{\"page\":2,\"content\":\"done\"}")
    check_int(3, "test_crawl_200", crawl_status(base + "/"), 200)
    check_int(4, "test_crawl_404", crawl_status(base + "/missing"), 404)
    check_str(5, "test_crawl_file", crawl_file(base + "/file.txt"), "hello wget")
}
