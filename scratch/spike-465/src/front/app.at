// Plan 465 T2 containment spike
widget App {
    msg Msg { OnKey }

    model {
        var dlg bool = false
        var keys int = 0
    }

    view {
        col {
            style: "w-full h-full gap-2 p-4 bg-card"
            button "Open Dialog" { onclick: () => {.dlg = true} }
            text `document keydowns: ${.keys}`
            on "keydown".document: .OnKey($event)
            dialog (open: .dlg) {
                dialogcontent {
                    dialogheader {
                        dialogtitle { text "Spike Dialog" }
                    }
                    text "PORTAL-PROBE-CONTENT"
                }
            }
            teleport (to: "body") {
                text "TELEPORT-MARKER"
            }
        }
    }

    on {
        .OnKey(e) -> { .keys = .keys + 1 }
    }
}
