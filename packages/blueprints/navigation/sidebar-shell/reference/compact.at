// reference/compact.at — SidebarShell blueprint, "compact" variant.
// Icon-rail sidebar: labels collapse to icons (tooltips preserved via
// title attributes). Same frame as default otherwise.

widget SidebarShellCompact {
    msg {
        NavSelected,
        MenuSignOut
    }

    model {
        var active_nav str = ""
        var badge_counts map = []
        var user_name str = ""  // prop: user.name
        var user_email str = "" // prop: user.email
    }

    view {
        col {
            header {
                row {
                    // ── EDIT: logo ──
                    text "A" { style: "text-sm font-semibold px-2" }
                    dropdown-menu {
                        dropdown-menu-trigger {
                            avatar {
                                src: ""
                                alt: f"${.user_name}"
                                style: "w-7 h-7 rounded-full"
                            }
                        }
                        dropdown-menu-content {
                            dropdown-menu-item "Profile"
                            dropdown-menu-item "Settings"
                            dropdown-menu-separator {}
                            dropdown-menu-item "Sign out" { onclick: .MenuSignOut }
                        }
                    }
                    style: "w-full items-center gap-2"
                }
                style: "w-full h-12 border-b px-3"
            }

            row {
                sidebar {
                    col {
                        // ── EDIT: nav_items (icon rail; title = tooltip) ──
                        col {
                            button "⌂" {
                                title: "Home"
                                onclick: .NavSelected
                                variant: "default"
                                style: "w-9 h-9 rounded-lg"
                            }
                            button "▦" {
                                title: "Projects"
                                onclick: .NavSelected
                                variant: "ghost"
                                style: "w-9 h-9 rounded-lg"
                            }
                            button "⚙" {
                                title: "Settings"
                                onclick: .NavSelected
                                variant: "ghost"
                                style: "w-9 h-9 rounded-lg"
                            }
                            style: "gap-1 items-center"
                        }
                        style: "w-14 border-r p-2 gap-2 items-center"
                    }
                }

                // ── EDIT: content (routed app surface; single slot —
                //    route-level loading/error states belong to the routed
                //    bp, not to this shell) ──
                col {
                    text "App content mounts here" {
                        style: "text-sm text-gray-400"
                    }
                    style: "flex-1 items-center justify-center"
                }

                style: "flex-1 min-h-0"
            }

            style: "w-full h-screen"
        }
    }

    on {
        .NavSelected(id) -> {
            .active_nav = id
        }
        .MenuSignOut -> {
            // actions.sign_out
        }
    }
}
