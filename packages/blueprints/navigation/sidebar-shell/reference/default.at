// reference/default.at — SidebarShell blueprint, "default" variant.
// Interactive app frame: a full-height three-section sidebar rendered as TWO
// mutually exclusive panes — the wide pane (icon + title per nav item) and
// the rail pane (icon-only, one size larger) — beside a content column that
// owns the header (brand + user menu). Consumer fills nav_tree/user props and
// owns actions.sign_out. EDIT regions mark where per-app customization is
// expected.
//
// PLAN-657 参数化修整（reference 实现对齐 frontmatter 契约面，frontmatter
// 零改动）：nav_tree/user props 经 widget 参数接入（047-bp-admin 首次多包
// L1 直连消费；PLAN-689 该样板迁出为 examples/bp-admin 独立示例）；actions.sign_out 经 `on_sign_out: msg` 回调上抛（契约 Q2
// action 点，k2/k3 回调契约形态）；dataSource.counts 无 L1 逆向调用通道，
// 由消费方烘焙进 nav_tree 节点的 badge 字段（组装摩擦记录于 PLAN-657）。
// content EDIT 区为 slot 出口（fallback 保留原占位文案——裸实例化
// 渲染形态不变，plan649 t09 锚兼容）。
//
// PLAN-688 交互化（r2，用户走查裁定 2026-09-22）：双 pane 形态——
// - 收缩 rail 与展开宽栏是两棵独立子树，互斥可见（非逐元素 label 面切换）：
//     宽栏 pane 根: style: if .collapsed {"hidden"}
//                       else {"hidden lg:block w-56 ..."}   ← 可见 = ¬collapsed ∧ ≥1024
//     rail  pane 根: style: if .collapsed {"w-14 ..."}
//                       else {"lg:hidden w-14 ..."}         ← 可见 = collapsed ∨ <1024
//   **rail pane 根禁带任何 display 类**（flex/lg:flex 会以 display 覆盖语义
//   压过 Hidden 永显，`flex lg:hidden` 不可隐藏——is_hidden 的 Plan 409 §10
//   语义）；列向布局 col 本身即栈式，无需 flex 类（gotchas #5）。
// - 宽栏 pane：每个 nav item 是单颗按钮（icon 与标题一体，
//   `f"{node.icon}  {node.label}"` 内联字形，compact.at 字形先例）；
//   rail pane：icon-only 且比宽栏大一号（text-lg w-10 h-10 vs text-sm）。
// - bp-private `collapsed` 态 + `ToggleCollapsed`（`!` 取反，form/login
//   ToggleRemember 先例）；宽栏 ◂/rail ▲ 同一消息。
// - 平板竖屏（<1024）自动 rail：纯 `lg:` 断点门控，不依赖手动态；
//   resize→view 重建→重解析实时生效（Plan 527 T7 回路，实机证实）。
// - rail 态 icon 按钮带 `title:` tooltip（PLAN-053 批4 EE03 接线）。
// - nav 节点全键 {id, label, badge, icon}（catalog.at 纪律：VM 缺键访问
//   =硬错）；icon 为文本字形，空串时 rail 钮为空块——首字符回退属消费方
//   烘焙，bp 不做切片逻辑。

widget SidebarShell (nav_tree: List, user_name: str, user_email: str, on_nav: msg, on_sign_out: msg) {
    msg {
        NavSelected(str),
        MenuSignOut,
        ToggleCollapsed,
        Nav(str),
        SignOut
    }

    model {
        var active_nav str = "" // bp-private selected nav node id
        var collapsed bool = false // bp-private rail collapse state
    }

    view {
        col {
            row {
                // ── sidebar: two mutually exclusive panes ──
                sidebar {
                    // ── 宽栏 pane（展开态）────────────────────────────
                    col {
                        // ── 上段：logo + 标题 + 收缩钮 ──
                        row {
                            // ── EDIT: logo ──
                            button "▲" {
                                onclick: .ToggleCollapsed
                                title: "Toggle sidebar"
                                variant: "ghost"
                                style: "w-8 h-8 rounded-lg text-sm shrink-0"
                            }
                            text "Acme" {
                                style: "text-sm font-semibold px-2"
                            }
                            button "◂" {
                                onclick: .ToggleCollapsed
                                title: "Collapse sidebar"
                                variant: "ghost"
                                style: "w-8 h-8 rounded-lg text-muted-foreground hover:bg-muted ml-auto shrink-0"
                            }
                            style: "items-center gap-1 w-full"
                        }

                        // ── EDIT: nav_items (over props.nav_tree; icon 与
                        //    标题一体单按钮；badge counts baked by the
                        //    consumer from dataSource.counts; overflow 归
                        //    本层——Plan 656 scroll 语义) ──
                        col {
                            for node in .nav_tree {
                                row (key: node.id) {
                                    button f"${node.icon}  ${node.label}" {
                                        onclick: .NavSelected(node.id)
                                        variant: if .active_nav == node.id { "secondary" } else { "ghost" }
                                        style: "flex-1 justify-start px-3 py-2 rounded-lg text-sm hover:bg-muted"
                                    }
                                    if node.badge != "" {
                                        badge f"${node.badge}" {
                                            variant: "outline"
                                        }
                                    }
                                    style: "gap-2 items-center w-full"
                                }
                            }
                            style: "gap-1 w-full overflow-y-auto flex-1 min-h-0"
                        }

                        // ── EDIT: footer（settings + 附加 nav 项示例，纯
                        //    reference 样例无业务语义）──
                        col {
                            separator {}
                            row {
                                button "⚙  Settings" {
                                    variant: "ghost"
                                    style: "flex-1 justify-start px-3 py-2 rounded-lg text-sm hover:bg-muted"
                                }
                                style: "w-full"
                            }
                            row {
                                button "▤  Workspace" {
                                    variant: "ghost"
                                    style: "flex-1 justify-start px-3 py-2 rounded-lg text-sm hover:bg-muted"
                                }
                                style: "w-full"
                            }
                            text "v0.1" {
                                style: "text-xs text-gray-400 px-3"
                            }
                            style: "gap-1 pt-2 w-full"
                        }

                        style: if .collapsed { "hidden" } else { "hidden lg:block w-56 shrink-0 border-r p-2 gap-2" }
                    }

                    // ── rail pane（收缩态；icon 比宽栏大一号）──────────
                    col {
                        // ── 上段：大 logo icon（点击回宽栏）──
                        button "▲" {
                            onclick: .ToggleCollapsed
                            title: "Expand sidebar"
                            variant: "ghost"
                            style: "w-10 h-10 rounded-lg text-xl font-bold"
                        }

                        // ── EDIT: nav_items (icon-only rail; title = tooltip;
                        //    badge 收纳属消费方升级面，v1 不显) ──
                        col {
                            for rnode in .nav_tree {
                                row (key: rnode.id) {
                                    button f"${rnode.icon}" {
                                        onclick: .NavSelected(rnode.id)
                                        title: f"${rnode.label}"
                                        variant: if .active_nav == rnode.id { "secondary" } else { "ghost" }
                                        style: "w-10 h-10 rounded-lg text-lg"
                                    }
                                }
                            }
                            style: "gap-1 items-center flex-1 min-h-0 overflow-y-auto w-full"
                        }

                        // ── EDIT: footer（icon-only，同宽栏语义）──
                        col {
                            separator {}
                            button "⚙" {
                                title: "Settings"
                                variant: "ghost"
                                style: "w-10 h-10 rounded-lg text-lg"
                            }
                            button "▤" {
                                title: "Workspace"
                                variant: "ghost"
                                style: "w-10 h-10 rounded-lg text-lg"
                            }
                            style: "gap-1 items-center pt-2 w-full"
                        }

                        style: if .collapsed { "w-14 shrink-0 border-r p-2 gap-2 items-center" } else { "lg:hidden w-14 shrink-0 border-r p-2 gap-2 items-center" }
                    }
                }

                // ── content 侧：header 属内容列（sidebar 满高三段）──
                col {
                    // ── header: brand + user menu ──
                    header {
                        row {
                            // ── EDIT: logo ──
                            text "Acme" { style: "text-sm font-semibold px-2" }

                            dropdown-menu {
                                dropdown-menu-trigger {
                                    avatar {
                                        src: "" // prop: user.avatar_url (avatar 未接线——见 gotchas)
                                        alt: f"${.user_email}"
                                        style: "w-7 h-7 rounded-full"
                                    }
                                }
                                dropdown-menu-content {
                                    dropdown-menu-item f"${.user_name}"
                                    dropdown-menu-separator {}
                                    dropdown-menu-item "Sign out" { onclick: .MenuSignOut }
                                }
                            }
                            style: "w-full items-center gap-2"
                        }
                        style: "w-full h-12 border-b px-3"
                    }

                    // ── EDIT: content (routed app surface; single slot —
                    //    route-level loading/error states belong to the routed
                    //    bp, not to this shell. Slot children land here;
                    //    fallback keeps the bare-mount placeholder) ──
                    col {
                        style: "flex-1 min-h-0"
                        slot {
                            col {
                                style: "flex-1 items-center justify-center"
                                text "App content mounts here" {
                                    style: "text-sm text-gray-400"
                                }
                            }
                        }
                    }

                    style: "flex-1 min-h-0"
                }

                style: "flex-1 min-h-0"
            }

            style: "w-full h-screen"
        }
    }

    on {
        .NavSelected(id) -> {
            .active_nav = id
            on_nav(id) // consumer routes to the node; refresh dataSource.counts()
        }
        .MenuSignOut -> {
            on_sign_out() // actions.sign_out: consumer ends the session + navigates
        }
        .ToggleCollapsed -> {
            .collapsed = !.collapsed // 宽栏 ↔ icon rail；竖屏(<1024)下 rail 恒定，视觉无操作
        }
        .Nav(id) -> {}
        .SignOut -> {}
    }
}
