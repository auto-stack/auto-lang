// reference/first_use.at — EmptyState blueprint, "first_use" variant.
// Nothing here yet: invite the user's first creation. Consumer wires
// actions.primary (the create affordance) and supplies copy + illustration.
//
// PLAN-657 参数化修整（reference 实现对齐 frontmatter 契约面，frontmatter
// 零改动）：illustration props 经 widget 参数接入（缺省 ""——frontmatter
// 声明的默认值，裸实例化渲染形态不变）；actions.primary 经 on_primary
// 回调上抛（契约 Q2 action 点）。

widget EmptyStateFirstUse (illustration: str = "", on_primary: msg) {
    msg {
        PrimaryClicked
    }

    view {
        col {
            // ── EDIT: media (illustration prop, text-marker fallback) ──
            if .illustration != "" {
                image {
                    src: .illustration
                    alt: "No items yet"
                    style: "w-40 h-40 object-contain"
                }
            } else {
                text "◎" { style: "text-4xl text-gray-300" }
            }

            // ── EDIT: headline ──
            col {
                text "Nothing here yet" { style: "text-lg font-semibold" }
                text "Create your first item to get started." {
                    style: "text-sm text-gray-500"
                }
                style: "gap-1 items-center"
            }

            separator { style: "w-16 my-2" }

            // ── EDIT: actions ──
            button "New item" {
                onclick: .PrimaryClicked
                style: "px-4 py-2 bg-blue-600 text-white rounded-lg"
            }

            style: "items-center justify-center gap-3 py-16"
        }
    }

    on {
        .PrimaryClicked -> {
            on_primary() // actions.primary: consumer opens the create surface
        }
    }
}
