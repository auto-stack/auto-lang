// blueprints/layout/gallery-shell/reference/default.at — GalleryShell 骨架
// （PLAN-676 T-01；donor=auto-os ui-gallery app.at（header/搜索/popover
// 设置/双行卡，PLAN-625 形态）+ widgets-gallery（header 骨架 z/边框）+
// charts-gallery（内容卡），三画廊框架综合，用户裁定 2026-09-21。）
//
// 骨架收敛：header（brand slot + 搜索框 + header_actions slot + 设置
// popover）/ 左侧栏（aside w-72 h-full：filters slot + scroll 条目列表，
// active 态随 active_id）/ content 默认出口（内建 scroll）。零应用侧
// 文案；动作经 on_* msg-ref props 上抛宿主（TreeView PLAN-037 T3 /
// SettingsPanel PLAN-528 W2 回调契约同款）；主题态归宿主（契约 #3），
// bp 仅镜像渲染 active 态。
//
// item schema（全键书写——缺键字段访问 = VM 硬错，filetree gotcha#3 同型）：
// { id: str, title: str, category: str, badge: str }（badge 空串 = 不渲染）
//
// # Usage
// （消费方）use bps.layout.gallery_shell.reference.default: GalleryShell
// GalleryShell (items: .my_items, active_id: .selected_id,
//               dark_mode: .dark_mode, accent_color: .accent_color,
//               on_select: .Select, on_search: .Search,
//               on_set_theme: .SetTheme, on_set_accent: .SetAccent) {
//     slot(name: "brand") { text "My Gallery" {} }
//     slot(name: "filters") { ... }
//     col { ... }   // 裸子 → content 默认出口
// }

widget GalleryShell (items: List = [], active_id: str = "", dark_mode: bool = true, accent_color: str = "indigo", empty_text: str = "No entries.", on_select: msg, on_search: msg, on_set_theme: msg, on_set_accent: msg) {
    msg {
        Select(str),
        Search(str),
        SetTheme(str),
        SetAccent(str),
    }

    model {
        var search_query str = ""
    }

    view {
        col (style: "w-full h-full bg-background text-foreground overflow-hidden") {
            // ── header：brand slot + 搜索 + header_actions slot + 设置 popover
            header (style: "h-14 border-b border-border px-6 flex items-center justify-between shrink-0 bg-card/60 backdrop-blur relative z-20") {
                row (style: "items-center gap-3 min-w-0") {
                    slot(name: "brand") {}
                }

                row (style: "items-center gap-3") {
                    input (value: .search_query) {
                        oninput: .Search
                        placeholder: "Search..."
                        style: "w-64 h-8 text-xs rounded-md bg-muted/50 border-input px-3"
                    }

                    slot(name: "header_actions") {}

                    popover {
                        popover-trigger {
                            // 非受控形态（ui-gallery donor 同款）：开合由
                            // popover-trigger 原生管理，不绑 onclick/open。
                            button "Settings" {
                                style: "h-8 px-3 text-xs rounded-md border border-input hover:bg-muted font-medium"
                            }
                        }
                        popover-content (align: "end", style: "w-64 p-3.5 bg-card border border-border rounded-xl gap-3 shadow-lg") {
                            // ── EDIT: theme —— 主题模式（镜像宿主 dark_mode）
                            col (style: "gap-1.5") {
                                text "Theme" (style: "text-xs text-muted-foreground font-medium") {}
                                row (style: "gap-2") {
                                    if .dark_mode {
                                        button "Dark" {
                                            onclick: .SetTheme("light")
                                            style: "flex-1 py-1 px-2 text-xs font-medium rounded-md bg-primary text-primary-foreground transition-colors"
                                        }
                                        button "Light" {
                                            onclick: .SetTheme("light")
                                            variant: "ghost"
                                            style: "flex-1 py-1 px-2 text-xs font-medium rounded-md text-muted-foreground hover:bg-accent border border-border bg-transparent transition-colors"
                                        }
                                    } else {
                                        button "Dark" {
                                            onclick: .SetTheme("dark")
                                            variant: "ghost"
                                            style: "flex-1 py-1 px-2 text-xs font-medium rounded-md text-muted-foreground hover:bg-accent border border-border bg-transparent transition-colors"
                                        }
                                        button "Light" {
                                            onclick: .SetTheme("light")
                                            style: "flex-1 py-1 px-2 text-xs font-medium rounded-md bg-primary text-primary-foreground transition-colors"
                                        }
                                    }
                                }
                            }

                            // ── EDIT: accent —— 五色板（Plan 409 §8 约定）
                            col (style: "gap-1.5") {
                                text "Accent" (style: "text-xs text-muted-foreground font-medium") {}
                                row (style: "items-center gap-3 py-1") {
                                    button "" {
                                        onclick: .SetAccent("indigo")
                                        style: if .accent_color == "indigo" { "w-6 h-6 p-0 rounded-full bg-indigo-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-6 h-6 p-0 rounded-full bg-indigo-500 hover:scale-110 transition-transform" }
                                    }
                                    button "" {
                                        onclick: .SetAccent("coral")
                                        style: if .accent_color == "coral" { "w-6 h-6 p-0 rounded-full bg-rose-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-6 h-6 p-0 rounded-full bg-rose-500 hover:scale-110 transition-transform" }
                                    }
                                    button "" {
                                        onclick: .SetAccent("ocean")
                                        style: if .accent_color == "ocean" { "w-6 h-6 p-0 rounded-full bg-sky-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-6 h-6 p-0 rounded-full bg-sky-500 hover:scale-110 transition-transform" }
                                    }
                                    button "" {
                                        onclick: .SetAccent("sage")
                                        style: if .accent_color == "sage" { "w-6 h-6 p-0 rounded-full bg-emerald-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-6 h-6 p-0 rounded-full bg-emerald-500 hover:scale-110 transition-transform" }
                                    }
                                    button "" {
                                        onclick: .SetAccent("amber")
                                        style: if .accent_color == "amber" { "w-6 h-6 p-0 rounded-full bg-amber-500 ring-2 ring-offset-2 ring-offset-card ring-primary" } else { "w-6 h-6 p-0 rounded-full bg-amber-500 hover:scale-110 transition-transform" }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── 主区：aside w-72 + content（ui-gallery donor 同款分栏）
            row (style: "flex-1 overflow-hidden") {
                // h-full 必写——aside 无显式高度类时 provider 的 h-full 在
                // iced 布局塌缩为 0（PLAN-625 T-04 实证，gotchas#1）。
                aside (style: "w-72 h-full border-r border-border bg-card/40 flex flex-col shrink-0 min-h-0") {
                    sidebar_provider (class: "w-full min-h-0 flex-1 flex-col") {
                        sidebar_header (style: "px-3 pt-4") {
                            // ── EDIT: filters —— 筛选 pills（分类轴归消费方）
                            slot(name: "filters") {}
                        }

                        scroll (style: "flex-1 min-h-0 px-3 py-4") {
                            sidebar_menu {
                                // ── EDIT: items —— 双行卡列表（主行 id+badge、
                                // 副行 title；循环变量事件用 msg 带参形式，
                                // lambda 捕获循环变量是 handler 合成不支持形态）
                                for item in .items {
                                    sidebar_menu_item {
                                        sidebar_menu_button {
                                            active: .active_id == item.id
                                            onclick: .Select(item.id)
                                            style: "h-auto py-1.5"

                                            col (style: "flex-1 min-w-0 items-start gap-1") {
                                                row (style: "items-center justify-between w-full") {
                                                    text item.id (style: "text-xs font-semibold truncate flex-1") {}
                                                    if item.badge != "" {
                                                        badge {
                                                            text: item.badge
                                                            variant: "outline"
                                                            style: "text-[10px]"
                                                        }
                                                    }
                                                }
                                                text item.title (style: "text-[11px] text-muted-foreground line-clamp-1") {}
                                            }
                                        }
                                    }
                                }
                            }

                            // ── EDIT: empty —— 空态显式分支（row-list 同款）
                            if .items.len() == 0 {
                                text .empty_text (style: "px-3 py-6 text-center text-xs text-muted-foreground") {}
                            }
                        }
                    }
                }

                // ── content 默认出口：内建 scroll 双界（flex-1 min-h-0），
                // 消费方 slot 内自行 max-width 包裹
                scroll (style: "flex-1 min-h-0 p-6") {
                    col (style: "w-full gap-6 pb-8") {
                        slot {}
                    }
                }
            }
        }
    }

    on {
        .Select(id) -> { on_select(id) }
        .Search(q) -> { .search_query = q; on_search(q) }
        .SetTheme(mode) -> { on_set_theme(mode) }
        .SetAccent(name) -> { on_set_accent(name) }
    }
}
