// reference/default.at — SidebarShell blueprint, "default" variant.
// Interactive app frame: full-height three-section sidebar (top brand +
// collapse toggle / mid nav tree / bottom settings footer) beside a content
// column that owns the header (brand + user menu). Consumer fills
// nav_tree/user props and owns actions.sign_out. EDIT regions mark where
// per-app customization is expected.
//
// PLAN-657 参数化修整（reference 实现对齐 frontmatter 契约面，frontmatter
// 零改动）：nav_tree/user props 经 widget 参数接入（047-bp-admin 首次多包
// L1 直连消费；PLAN-689 该样板迁出为 examples/bp-admin 独立示例）；actions.sign_out 经 `on_sign_out: msg` 回调上抛（契约 Q2
// action 点，k2/k3 回调契约形态）；dataSource.counts 无 L1 逆向调用通道，
// 由消费方烘焙进 nav_tree 节点的 badge 字段（组装摩擦记录于 PLAN-657）。
// content EDIT 区为 slot 出口（fallback 保留原占位文案——裸实例化
// 渲染形态不变，plan649 t09 锚兼容）。
//
// PLAN-688 交互化（首个"交互态 BP"，SD-01 惯例锚例）：
// - bp-private `collapsed` 态 + `ToggleCollapsed` 消息（`!` 取反切换，
//   form/login ToggleRemember 先例）驱动宽栏 ↔ icon rail 双形态。
// - 形态组合走 D1 单树 class 组合，零新增 VM 原语：
//     label 面（文字/chevron/badge）: style: if .collapsed {"hidden"}
//       else {"hidden lg:flex"} —— 可见 = ¬collapsed ∧ 窗宽 ≥1024；
//     sidebar 列宽: style: if .collapsed {"w-14 ..."} else
//       {"w-14 ... lg:w-56"} —— 响应类按声明序进 base，后声明胜。
// - 平板竖屏（<1024）自动 rail：纯 `lg:` 断点门控，不依赖手动态；
//   resize→view 重建→重解析实时生效（Plan 527 T7 回路）。
// - rail 态 icon 按钮带 `title:` tooltip（PLAN-053 批4 EE03 接线，
//   renderer Button 臂剥离 EE03 尾段包 iced tooltip）。
// - nav 节点全键 {id, label, badge, icon}（catalog.at 纪律：VM 缺键
//   访问=硬错）；icon 为文本字形（compact.at "⌂▦⚙" 先例），空串时
//   icon 钮为空块——首字符回退属消费方烘焙，bp 不做切片逻辑。

widget SidebarShell (nav_tree: List, user_name: str, user_email: str, on_nav: msg, on_sign_out: msg) {
    msg {
        NavSelected(str),
        MenuSignOut,
        ToggleCollapsed,
        Nav(str),
        SignOut
    }

    model {
        var active_nav str = "" // bp-private selected nav node id
        var collapsed bool = false // bp-private rail collapse state
    }

    view {
        col {
            row {
                // ── sidebar: three sections, collapse-aware ──
                sidebar {
                    col {
                        // ── 上段：标题 icon + 收缩钮（rail 态点标题 icon 回宽栏）──
                        row {
                            button "▲" {
                                onclick: .ToggleCollapsed
                                title: "Toggle sidebar"
                                variant: "ghost"
                                style: "w-9 h-9 rounded-lg text-sm font-bold"
                            }
                            // ── EDIT: logo（标题文字，label 面）──
                            text "Acme" {
                                style: if .collapsed { "hidden" } else { "hidden lg:block text-sm font-semibold truncate" }
                            }
                            button "◂" {
                                onclick: .ToggleCollapsed
                                title: "Collapse sidebar"
                                variant: "ghost"
                                style: if .collapsed { "hidden" } else { "hidden lg:flex w-9 h-9 rounded-lg text-muted-foreground hover:bg-muted" }
                            }
                            style: "items-center gap-1 w-full"
                        }

                        // ── EDIT: nav_items (over props.nav_tree; badge counts
                        //    baked by the consumer from dataSource.counts;
                        //    overflow 归本层——Plan 656 scroll 语义) ──
                        col {
                            for node in .nav_tree {
                                row (key: node.id) {
                                    button f"${node.icon}" {
                                        onclick: .NavSelected(node.id)
                                        title: f"${node.label}"
                                        variant: if .active_nav == node.id { "secondary" } else { "ghost" }
                                        style: "w-9 h-9 rounded-lg text-sm"
                                    }
                                    button f"${node.label}" {
                                        onclick: .NavSelected(node.id)
                                        variant: if .active_nav == node.id { "secondary" } else { "ghost" }
                                        style: if .collapsed { "hidden" } else { "hidden lg:flex flex-1 justify-start px-3 py-2 rounded-lg text-sm hover:bg-muted" }
                                    }
                                    if node.badge != "" {
                                        badge f"${node.badge}" {
                                            variant: "outline"
                                            style: if .collapsed { "hidden" } else { "hidden lg:flex" }
                                        }
                                    }
                                    style: "gap-2 items-center"
                                }
                            }
                            style: "gap-1"
                        }

                        // ── EDIT: footer（settings + 附加 nav 项示例，纯
                        //    reference 样例无业务语义）──
                        col {
                            separator {}
                            row {
                                button "⚙" {
                                    title: "Settings"
                                    variant: "ghost"
                                    style: "w-9 h-9 rounded-lg text-sm"
                                }
                                button "Settings" {
                                    variant: "ghost"
                                    style: if .collapsed { "hidden" } else { "hidden lg:flex flex-1 justify-start px-3 py-2 rounded-lg text-sm hover:bg-muted" }
                                }
                                style: "gap-2 items-center"
                            }
                            row {
                                button "▤" {
                                    title: "Workspace"
                                    variant: "ghost"
                                    style: "w-9 h-9 rounded-lg text-sm"
                                }
                                button "Workspace" {
                                    variant: "ghost"
                                    style: if .collapsed { "hidden" } else { "hidden lg:flex flex-1 justify-start px-3 py-2 rounded-lg text-sm hover:bg-muted" }
                                }
                                style: "gap-2 items-center"
                            }
                            text "v0.1" {
                                style: if .collapsed { "hidden" } else { "hidden lg:block text-xs text-gray-400" }
                            }
                            style: "gap-1 pt-2"
                        }

                        style: if .collapsed { "w-14 shrink-0 items-center border-r p-2 gap-2" } else { "w-14 lg:w-56 shrink-0 items-center border-r p-2 gap-2" }
                    }
                }

                // ── content 侧：header 属内容列（sidebar 满高三段）──
                col {
                    // ── header: brand + user menu ──
                    header {
                        row {
                            // ── EDIT: logo ──
                            text "Acme" { style: "text-sm font-semibold px-2" }

                            dropdown-menu {
                                dropdown-menu-trigger {
                                    avatar {
                                        src: "" // prop: user.avatar_url (avatar 未接线——见 gotchas)
                                        alt: f"${.user_email}"
                                        style: "w-7 h-7 rounded-full"
                                    }
                                }
                                dropdown-menu-content {
                                    dropdown-menu-item f"${.user_name}"
                                    dropdown-menu-separator {}
                                    dropdown-menu-item "Sign out" { onclick: .MenuSignOut }
                                }
                            }
                            style: "w-full items-center gap-2"
                        }
                        style: "w-full h-12 border-b px-3"
                    }

                    // ── EDIT: content (routed app surface; single slot —
                    //    route-level loading/error states belong to the routed
                    //    bp, not to this shell. Slot children land here;
                    //    fallback keeps the bare-mount placeholder) ──
                    col {
                        style: "flex-1 min-h-0"
                        slot {
                            col {
                                style: "flex-1 items-center justify-center"
                                text "App content mounts here" {
                                    style: "text-sm text-gray-400"
                                }
                            }
                        }
                    }

                    style: "flex-1 min-h-0"
                }

                style: "flex-1 min-h-0"
            }

            style: "w-full h-screen"
        }
    }

    on {
        .NavSelected(id) -> {
            .active_nav = id
            on_nav(id) // consumer routes to the node; refresh dataSource.counts()
        }
        .MenuSignOut -> {
            on_sign_out() // actions.sign_out: consumer ends the session + navigates
        }
        .ToggleCollapsed -> {
            .collapsed = !.collapsed // 宽栏 ↔ icon rail；竖屏(<1024)下 rail 恒定，视觉无操作
        }
        .Nav(id) -> {}
        .SignOut -> {}
    }
}
