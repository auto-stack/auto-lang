// Byte Encoding — Hex, Base64, and byte manipulation
//
// Auto supports byte-level operations via use.rs imports.
// This example shows the concept.

fn main() {
    print("Byte operations available via use.rs:")
    print("  hex encoding: use.rs hex::encode")
    print("  base64: use.rs base64::encode")
    print("  SHA256: use.rs sha2::Sha256")
    print("Use b\"...\" for byte string literals")
}
