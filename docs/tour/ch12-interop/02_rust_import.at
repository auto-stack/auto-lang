// Rust Import — Using Rust crates
//
// Use `use.rs` to import Rust crates and call Rust functions.

// Import Rust standard library components
use.rs std::fs
use.rs std::collections::HashMap

fn main() {
    // After importing, Rust types and functions are available
    print("Rust imports enable access to the Rust ecosystem")
    print("Syntax: use.rs crate::module::Symbol")

    // File operations via Rust FFI
    print("Read files: use.rs std::fs: read_to_string")
    print("Collections: use.rs std::collections: HashMap")
}
