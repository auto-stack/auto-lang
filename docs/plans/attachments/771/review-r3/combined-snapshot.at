type Q { v int; ok bool }
type Box { q Q }
type P { a Q; b int }
fn bump(mut q Q) int { q.v = q.v + 1; return q.v }
fn make(mut q Q) P { return P { a: q, b: bump(q.mut) } }
fn main() int {
 var q = Q(7,true)
 let p = make(q.mut)
 if p.a.v != 7 { return 11 }
 if q.v != 8 { return 12 }
 if p.a.ok == false { return 13 }
 var box = Box(q)
 let r = P { a: box.q, b: bump(q.mut) }
 if r.a.v != 8 { return 14 }
 if q.v != 9 { return 15 }
 var n = 0
 loop {
  let s = P { a: q, b: bump(q.mut) }
  if s.a.v != (9 + n) { return 16 }
  if q.v != (10 + n) { return 17 }
  n = n + 1
  if n == 3 { break }
 }
 return 0
}

