type T { s Str; n int }
fn yes() bool { return true }
fn cond(i int) bool { return i == 0 }
fn check(t T) bool { return t.n > 0 }
fn main() int {
 let a T = T { s: "abc", n: 1 }
 var i int = 0
 loop {
  if yes() && (cond(i) || check(a.clone())) { i = i + 1 } else { i = i + 1 }
  if i == 2 { break }
 }
 return a.s.len()
}
