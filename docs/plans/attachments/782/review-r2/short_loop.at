type Tok { text Str; kind int }
fn check(t Tok) bool { return t.kind > 0 }
fn cond(i int) bool { return i == 0 }
fn main() int {
 let a Tok = Tok { text: "a", kind: 1 }
 var i int = 0
 loop {
  if cond(i) && check(a.clone()) { i = i + 1 } else { i = i + 1 }
  if i == 2 { break }
 }
 return a.text.len()
}
