fn lhs(v bool) bool { let a = mark_a()
return v }
fn rhs(v bool) bool { let b = mark_b()
return v }
fn combine(x bool, y bool) int { if x && y { return 1 }
return 0 }
fn main() int {
    let x = lhs(false) || (rhs(true) && lhs(false))
    let y = lhs(true) && (rhs(false) || lhs(true))
    let z = combine(y: lhs(false) || rhs(true), x: lhs(true) && rhs(false))
    var i = 0
    for i < 3 && lhs(true) && (rhs(false) || lhs(true)) {
        i = i + 1
        if i == 2 { continue }
    }
    for false && rhs(true) { return 9 }
    if x { return 1 }
    if !y { return 2 }
    if z != 0 { return 3 }
    if i != 3 { return 4 }
    return 0
}
