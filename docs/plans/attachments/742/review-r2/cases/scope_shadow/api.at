pub type Probe = { text: str }
#[api(method = "GET", path = "/api/echo")]
pub fn echo() Probe {
    var n int = repository.ping()
    if false {
        var repository str = "local"
        var size int = repository.len()
    }
    if n == 7 { return Probe { text: "ok" } }
    return Probe { text: "bad" }
}
