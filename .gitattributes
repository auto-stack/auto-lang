# Shell scripts must keep LF line endings: a CRLF would make the Linux kernel
# read the shebang as "/bin/sh\r" and fail with ENOENT when cargo execve's it.
scripts/*.sh text eol=lf
scripts/**/*.sh text eol=lf

# Catalog hashes bind the exact serialized bytes, also after Git checkout.
scripts/test-governance/modules.json text eol=lf
scripts/test-governance/catalog/*.json text eol=lf

# ACE migration preserves frozen input bytes, including deliberate CRLF cases.
# New paths must not be normalized when first added or checked out.
experimental/ace/**/fixtures/** -text
experimental/ace/**/*.at -text
experimental/ace/**/*.ad -text
experimental/ace/**/*.bin -text
experimental/ace/**/*.json -text

# PLAN-941: copied original contract inputs are byte identities. In particular,
# scalar CRLF cases must preserve their intentional CRLF bytes in fresh trees.
crates/auto-lang/test/cases/ace-m1-expanded/scalar-src/*.at -text
crates/auto-lang/test/cases/ace-m1-expanded/composite-src/*.at -text
crates/auto-lang/test/cases/ace-m1-expanded/composite-reference/*.c -text
crates/auto-lang/test/cases/ace-m1-expanded/text-reference/*.c -text
crates/auto-lang/test/cases/ace-m1-expanded/text-reference/*.rs -text
crates/auto-lang/test/cases/ace-m1-expanded/cte-reference/*.c -text
crates/auto-lang/test/cases/ace-m1-expanded/cte-reference/*.rs -text

# PLAN-1025 (F-1025-01): the whole frozen test-case corpus binds byte
# identities in every materialization (core.autocrlf=input or true). No EOL
# conversion in either direction; intentional CRLF fixtures keep their bytes.
crates/auto-lang/test/cases/** -text

# PLAN-1025: admission-chain controlled text is LF in the Git objects and in
# every checkout; the strict readers hash exactly these bytes. The root-level
# contracts/tables/registry of the expanded suite (no nested .json/.tsv
# exists below it), the governance oracle table, the fixed-group config, the
# frozen scenario-oracle spec, and every pinned compiled evidence parent.
